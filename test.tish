import { defaultParamsForGeneratorId } from './src/generators/Registry.tish'

export fn test() {
  let ch = { generatorId: "acid303", generatorParams: null }
  let id = ch.generatorId
  if (!ch.generatorParams) {
    ch.generatorParams = defaultParamsForGeneratorId(id)
  }
  let p = ch.generatorParams
  console.log("p is", p)
  console.log("p.waveform is", p.waveform)
}
test()
