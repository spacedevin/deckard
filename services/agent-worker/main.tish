// Co-DJ worker (Tish): connect to gateway, handle direct + playing stream. Actor + skills only.
// Run: tish run services/agent-worker/main.tish   (capabilities default on; omit --feature)
//
// Primary contribution = a DECK PRESET on this actor's lane: on a styled direct ("play nebula") or
// on auto-jam, it loads one of the 15 deck sets (src/model/DeckSets.tish), prefixes every track id
// with the actor id so the preset is owned by this lane (→ Deck B), and streams it as one tpl.block.
// A fine single-element direct ("add a hihat") still produces a single LLM/demo track. Skill-gating
// (src/codj/Skills.tish) is a denylist: only master-scope lines (bpm/tpl/auto/session_*/clip) need
// master_mixer — so presets (gen/macro/patch/fx/eq/step_pitch/steps/note) apply on the receiver.
import { WebSocket } from "tish:ws"
import { process } from "tish:process"
import { fetch } from "http"
import { deckSetCatalog, deckSetTplById } from "../../src/model/DeckSets.tish"

// `undefined` is a JS global the app (JS target) relies on, but native `tish run` does NOT define it, so
// every `x !== undefined` here would throw "Undefined variable: undefined" the moment a received message hits
// the (un-try/caught) processing path — the worker "stops right after connecting". Define it = null so the
// codebase's `x === null || x === undefined` absence checks work natively, same as in the browser build.
let undefined = null

let actorId = "actor-1"
let hub = "ws://127.0.0.1:35987"
let session = "default"
let argv = typeof process !== "undefined" && process.argv ? process.argv : []
let ai = 0
while (ai < argv.length) {
  if (ai + 1 < argv.length && argv[ai] === "--actor-id") {
    actorId = argv[ai + 1]
    ai = ai + 2
    continue
  }
  if (ai + 1 < argv.length && argv[ai] === "--lane") {
    actorId = "actor-" + argv[ai + 1]
    ai = ai + 2
    continue
  }
  if (ai + 1 < argv.length && argv[ai] === "--hub") {
    hub = argv[ai + 1]
    ai = ai + 2
    continue
  }
  if (ai + 1 < argv.length && argv[ai] === "--session") {
    session = argv[ai + 1]
    ai = ai + 2
    continue
  }
  ai = ai + 1
}

let DO_BASE = "https://inference.do-ai.run/v1"
if (typeof process !== "undefined" && process.env && "DO_INFERENCE_BASE" in process.env) {
  DO_BASE = process.env["DO_INFERENCE_BASE"]
}
if (DO_BASE.endsWith("/")) { DO_BASE = DO_BASE.substring(0, DO_BASE.length - 1) }
let DO_MODEL = "llama3-8b-instruct"
if (typeof process !== "undefined" && process.env && "DO_MODEL" in process.env) {
  DO_MODEL = process.env["DO_MODEL"]
}
let GRADIENT_MODEL_ACCESS_KEY = ""
if (typeof process !== "undefined" && process.env) {
  if ("GRADIENT_MODEL_ACCESS_KEY" in process.env) { GRADIENT_MODEL_ACCESS_KEY = process.env["GRADIENT_MODEL_ACCESS_KEY"] }
  else if ("MODEL_ACCESS_KEY" in process.env) { GRADIENT_MODEL_ACCESS_KEY = process.env["MODEL_ACCESS_KEY"] }
}

// Full TPL vocabulary a co-DJ LANE may emit (everything here is non-master per src/codj/Skills.tish, so it
// applies on the receiver). Keep in lockstep with docs/TPL_AGENT_GRAMMAR.md and the Skills.tish denylist.
let SYSTEM_PROMPT =
  "You are a Co-DJ actor in Deckard. Output ONLY valid TPL lines — no markdown, no prose.\n" +
  "Prefix EVERY track id with \"" + actorId + "_\" (e.g. " + actorId + "_hat). Indent track-body lines by 2 spaces.\n" +
  "\n" +
  "TRACK header:  track <Name> id " + actorId + "_<x> gen <generator> [* <bars>]   (* N = multi-bar pattern)\n" +
  "\n" +
  "GENERATORS (use `gen <id>` — pick by role; don't default everything to noise_burst+fm):\n" +
  "  kick:   kick_edm kick_deep kick_distorted        perc/hat: drumSynth clap cymbal noise_burst\n" +
  "  bass:   acid303 sub808 reeseBass bass_reese_punch bass_reese_sc bass_wobble\n" +
  "  lead:   basic_osc fm aether syncLead obSync laserSync     keys/mallet: tine halo bell\n" +
  "  pad/texture: pad noise_burst    strings: guitar arco      vocal: formantVocal ttsVocal meSpeakVocal syncChoir\n" +
  "  chip:   chiptune nes2a03 gameBoyDmg c64sid ym2612 sn76489 spc700 gbaDirectSound\n" +
  "  modular (advanced): matrixFm patch  (prefer the named generators above over hand-rolled graphs)\n" +
  "\n" +
  "GENERATOR PARAMS (indented):\n" +
  "  noise_burst: noise attack <s> decay <s> tone <0..1> pitch_follow <0..1>\n" +
  "  fm:          fm ratio <n> mod_index <n> carrier <sine|square> mod <sine|square>\n" +
  "  basic_osc:   osc waveform <sine|square|saw|triangle>\n" +
  "  any other:   gen <param> <value> ...   (0..1 designer knobs, e.g. `gen tone 0.5 swell 0.4`)\n" +
  "  envelope:    adsr a <s> d <s> s <0..1> r <s>\n" +
  "\n" +
  "PATTERN (one per track):\n" +
  "  steps <16 tokens, x=hit .=rest>   |   steps euclid <hits> 16        (drum/step pattern)\n" +
  "  step_pitch <midi>                  (pitch for step hits; default 36)\n" +
  "  note <midi> <startBeat> <durBeats> v <vel> [p <prob 0..1>] [r <ratchet 1..8>] [n <nudge -0.5..0.5>]   (melodic; one per line; beats are quarter-notes, step i = beat i*0.25)\n" +
  "\n" +
  "PER-STEP LOCKS (16 tokens each, parallel lanes under `steps` — this is how you humanize/groove):\n" +
  "  step_vel <1..127 x16>   step_prob <0..1 x16>   step_ratchet <1..8 x16>   step_nudge <-0.5..0.5 x16>\n" +
  "\n" +
  "VOICE (chords/arps for melodic parts):\n" +
  "  voice octave <-2..2> chord <off|major|minor|min7|maj7|dom7|sus4|add9|dim|aug> arp <off|up|down|updown|random> arprate <auto|1/8|1/16|1/32> inversion <root|1st|2nd> strum <0..150>\n" +
  "\n" +
  "MIX / FX (per track):\n" +
  "  mix gain <0..1> pan <-1..1> eq_lo <dB> eq_mid <dB> eq_hi <dB>\n" +
  "  fx cutoff <hz> res <0..1> drive <0..1> reverb_send <0..1> filter_type <lowpass|highpass|bandpass|notch>\n" +
  "\n" +
  "DO NOT emit (master-only — skipped for your lane): bpm, tpl, auto, transpose, scale, swing, master_mix, actor_mix, session_*, clip, @ directives.\n" +
  "NEVER emit `remove_track` — you add complementary parts, you do not delete tracks.\n" +
  "GOAL: complement the project — add the MISSING parts (hats, perc, bass, chords, melody), match the tempo, leave space; don't double what already plays."

let SKILL_IDS = ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix"]

fn buildDemoPatch(text) {
  let lower = text.toLowerCase()
  if (lower.indexOf("euclid") >= 0 || lower.indexOf("hat") >= 0 || lower.indexOf("hihat") >= 0) {
    return "tpl 1\ntrack Hat id " + actorId + "_hat gen noise_burst\n  noise attack 0.001 decay 0.04 tone 0.9 pitch_follow 0.1\n  steps euclid 5 16"
  }
  if (lower.indexOf("bass") >= 0 || lower.indexOf("fm") >= 0) {
    return "tpl 1\ntrack Bass id " + actorId + "_bass gen fm\n  fm ratio 2 mod_index 5 carrier sine mod square\n  adsr a 0.01 d 0.1 s 0.3 r 0.15\n  steps x . x . x . x . x . x . x . x ."
  }
  return null
}

// ---- Deck presets: the agent's main contribution is a full preset on its own lane ----
let deckSetRotation = 0

// Prefix every `track <name> id <id> …` so the streamed set is OWNED by this actor (lands on its deck).
fn prefixTrackIds(tpl, prefix) {
  let lines = tpl.split("\n")
  let out = []
  let i = 0
  while (i < lines.length) {
    let line = lines[i]
    if (line.trim().indexOf("track ") === 0) {
      let idx = line.indexOf(" id ")
      if (idx >= 0) {
        let before = line.substring(0, idx + 4)
        let rest = line.substring(idx + 4)
        let sp = rest.indexOf(" ")
        let idTok = sp >= 0 ? rest.substring(0, sp) : rest
        let after = sp >= 0 ? rest.substring(sp) : ""
        line = before + prefix + "_" + idTok + after
      }
    }
    out.push(line)
    i = i + 1
  }
  return out
}

// Keyword/name match against the catalog (no rotation). Returns an id or null.
fn matchDeckSetId(text) {
  let cat = deckSetCatalog()
  if (!cat || cat.length === 0) return null
  let lower = String(text || "").toLowerCase()
  let i = 0
  while (i < cat.length) {
    let id = String(cat[i].id).toLowerCase()
    if (lower.indexOf(id) >= 0 || lower.indexOf(id.split("_").join(" ")) >= 0) return cat[i].id
    let nm = String(cat[i].name || cat[i].label || "").toLowerCase()
    let words = nm.split(" ")
    let w = 0
    while (w < words.length) {
      if (words[w].length >= 4 && lower.indexOf(words[w]) >= 0) return cat[i].id
      w = w + 1
    }
    i = i + 1
  }
  return null
}

// Next preset in rotation (varies the agent's auto-jam each time).
fn rotateDeckSetId() {
  let cat = deckSetCatalog()
  if (!cat || cat.length === 0) return null
  let pick = cat[deckSetRotation % cat.length].id
  deckSetRotation = deckSetRotation + 1
  return pick
}

// Optional: let the LLM pick the best-fitting preset by id (graceful fallback to deterministic).
fn llmPickDeckSetId(text) {
  if (!GRADIENT_MODEL_ACCESS_KEY || GRADIENT_MODEL_ACCESS_KEY === "") return null
  let cat = deckSetCatalog()
  if (!cat || cat.length === 0) return null
  let list = ""
  let i = 0
  while (i < cat.length) {
    list = list + "- " + cat[i].id + ": " + String(cat[i].name || cat[i].id) + "\n"
    i = i + 1
  }
  let sys = "You pick a music preset. Reply with ONLY one preset id from the list, nothing else."
  let prompt = "Presets (id: name):\n" + list + "\nDJ direction: " + String(text || "(free jam)") + "\nBest-fitting preset id:"
  let raw = await callLLMRaw(prompt, sys)
  if (!raw) return null
  let cleaned = String(raw).trim().toLowerCase()
  let j = 0
  while (j < cat.length) {
    if (cleaned.indexOf(String(cat[j].id).toLowerCase()) >= 0) return cat[j].id
    j = j + 1
  }
  return null
}

// Resolve a preset for the given direction → { id, lines } (track ids prefixed), or null.
fn deckSetLinesForLane(text, allowRotate) {
  let id = matchDeckSetId(text)
  if ((id === null || id === undefined)) {
    let llmId = await llmPickDeckSetId(text)
    if (llmId !== null && llmId !== undefined) {
      id = llmId
    } else if (allowRotate) {
      id = rotateDeckSetId()
    }
  }
  if ((id === null || id === undefined)) return null
  let set = deckSetTplById(id)
  if (!set || !set.tpl) return null
  return { id: id, lines: prefixTrackIds(set.tpl, actorId) }
}

// Single-element requests ("add a hihat") stay fine-grained; everything else gets a full preset.
fn looksLikeSingleElement(text) {
  let lower = String(text || "").toLowerCase()
  if (lower.split(" ").length > 5) return false
  let singles = ["hat", "hihat", "bass", "kick", "snare", "clap", "perc", "pluck", "lead", "stab"]
  let i = 0
  while (i < singles.length) {
    if (lower.indexOf(singles[i]) >= 0) return true
    i = i + 1
  }
  return false
}

// Send a tpl.block directly (no slow char-by-char stream) — presets are large.
fn sendBlockOnly(ws, lines, perfStep) {
  if (!ws || !ws.send) return
  let blockPayload = JSON.stringify({
    type: "tpl.block",
    actorId: actorId,
    authorId: actorId,
    lines: lines,
    effectivePerfStep: perfStep,
    asap: true
  })
  ws.send(blockPayload)
  console.log("[worker] OUTPUT deck-set tpl.block (" + String(lines.length) + " lines)")
}

fn lineStartsWithSpace(l) {
  let c = l.charAt(0)
  return c === " " || c === "\t"
}
fn lineStartsWithTplKeyword(t) {
  let prefixes = ["noise ", "fm ", "osc ", "adsr ", "steps ", "note ", "mix "]
  let i = 0
  while (i < prefixes.length) {
    if (t.indexOf(prefixes[i]) === 0) return true
    i = i + 1
  }
  return false
}

/** Extract TPL lines from LLM output. Strips markdown, keeps valid TPL. */
fn extractTplFromResponse(raw) {
  let s = String(raw || "").trim()
  let codeBlock = RegExp("```(?:[a-zA-Z0-9_]*)\\n?([\\s\\S]*?)```")
  let m = s.match(codeBlock)
  if (m !== null && m !== undefined && m.length > 1) s = m[1].trim()
  let all = s.split("\n")
  let out = []
  let i = 0
  while (i < all.length) {
    let l = all[i]
    let t = l.trim()
    if (!t || t.charAt(0) === "#" || t.indexOf("Here") === 0 || t.toLowerCase().indexOf("sure") === 0) {
      i = i + 1
      continue
    }
    let norm = l.split("\t").join("  ")
    if (t.indexOf("tpl ") === 0 || t.indexOf("track ") === 0 || t.indexOf("bpm ") === 0 || t.indexOf("auto ") === 0) {
      out.push(norm)
    } else if (lineStartsWithSpace(l) && t) {
      out.push(norm)
    } else if (out.length > 0 && lineStartsWithTplKeyword(t)) {
      out.push("  " + t)
    }
    i = i + 1
  }
  if (out.length === 0) return null
  let first = out[0].trim()
  if (first.indexOf("tpl ") !== 0 && first.indexOf("track ") !== 0) return null
  if (first.indexOf("tpl ") !== 0) {
    let newOut = ["tpl 1"]
    let j = 0
    while (j < out.length) {
      newOut.push(out[j])
      j = j + 1
    }
    out = newOut
  }
  return out
}

// Raw LLM call — returns the assistant's text content (or null). systemPrompt overrides the default.
fn callLLMRaw(userPrompt, systemPrompt) {
  if (!GRADIENT_MODEL_ACCESS_KEY || GRADIENT_MODEL_ACCESS_KEY === "") return null
  let sys = (systemPrompt !== null && systemPrompt !== undefined && systemPrompt !== "") ? systemPrompt : SYSTEM_PROMPT
  try {
    let url = DO_BASE + "/chat/completions"
    let bodyObj = {
      model: DO_MODEL,
      messages: [
        { role: "system", content: sys },
        { role: "user", content: userPrompt }
      ],
      max_tokens: 1024,
      temperature: 0.7
    }
    let bodyStr = JSON.stringify(bodyObj)
    let headersObj = {}
    headersObj["Content-Type"] = "application/json"
    headersObj["Authorization"] = "Bearer " + GRADIENT_MODEL_ACCESS_KEY
    let opts = {
      method: "POST",
      headers: headersObj,
      body: bodyStr
    }
    let resp = await fetch(url, opts)
    if (!resp || !resp.ok) {
      let errText = ""
      try {
        let errData = await resp.text()
        errText = errData
      } catch (e) {
        errText = String(resp.status || "unknown")
      }
      console.error("[worker] LLM error:", errText)
      return null
    }
    let data = await resp.json()
    if (!data || typeof data !== "object") return null
    let choices = data.choices
    if (!choices || !Array.isArray(choices) || choices.length === 0) return null
    let msg = choices[0].message
    if (!msg || typeof msg !== "object") return null
    let content = msg.content
    if (!content) return null
    return content
  } catch (e) {
    console.error("[worker] LLM fetch failed:", String(e))
    return null
  }
}

fn callLLM(userPrompt) {
  let content = await callLLMRaw(userPrompt, null)
  if (!content) return null
  return extractTplFromResponse(content)
}

let activeWs = null

// Playing stream: buffer tpl.line from playing actor; after debounce snapshot buffer → LLM.
let playingActorId = null
let tplLineBuffer = []
let lastLineAt = 0
let respondedSincePlay = false
let DEBOUNCE_MS = 1300
let BUFFER_MAX_LINES = 400

fn pushContextLine(line) {
  if (typeof line !== "string") {
    return
  }
  tplLineBuffer.push(line)
  if (tplLineBuffer.length > BUFFER_MAX_LINES) {
    tplLineBuffer = tplLineBuffer.slice(tplLineBuffer.length - BUFFER_MAX_LINES)
  }
}

// Snapshot the rolling buffer into one prompt — the ONLY place the human stream is collapsed
// for the provider (per the co-DJ streaming principle). Returns LLM TPL lines or null.
fn llmLinesFrom(directive) {
  if (!GRADIENT_MODEL_ACCESS_KEY || GRADIENT_MODEL_ACCESS_KEY === "") {
    return null
  }
  let ctx = tplLineBuffer.length > 0 ? tplLineBuffer.join("\n") : "(empty)"
  let prompt = directive + "\n\nCurrent session TPL (other actors, read-only context):\n" + ctx
  let llm = callLLM(prompt)
  if (llm && llm.length > 0) {
    return llm
  }
  return null
}

fn handleDirect(ws, msg) {
  let text = msg.text || "add hi-hat"
  let ps = (msg.perfStep !== null && msg.perfStep !== undefined && typeof msg.perfStep === "number") ? msg.perfStep : 0
  // A fine-grained single-element request stays a single track; anything else loads a full preset.
  if (!looksLikeSingleElement(text)) {
    let ds = await deckSetLinesForLane(text, true)
    if (ds !== null && ds !== undefined && ds.lines && ds.lines.length > 0 && ws && ws.send) {
      sendBlockOnly(ws, ds.lines, ps)
      console.log("[worker] direct '" + text + "' -> deck preset '" + ds.id + "' (" + String(ds.lines.length) + " lines)")
      return
    }
  }
  let lines = llmLinesFrom("DJ direction: " + text + ". Output ONE complementary track on your lane as TPL.")
  if (!lines) {
    let demo = buildDemoPatch(text)
    lines = demo ? demo.split("\n") : null
  }
  if (!lines || lines.length === 0 || !ws || !ws.send) { return }
  streamChunkThenBlock(ws, lines, ps)
  console.log("[worker] got direct:", text, "-> streamed tpl.block (" + String(lines.length) + " lines)")
}

fn streamChunkThenBlock(ws, lines, perfStep) {
  if (!ws || !ws.send) { return }
  let text = lines.join("\n")
  let i = 0
  while (i < text.length) {
    let chunkPayload = JSON.stringify({ type: "tpl.stream_chunk", actorId: actorId, authorId: actorId, chunk: text.substring(i, i + 1) })
    if (i < 3 || i % 50 === 0) { console.log("[worker] OUTPUT wsSend stream_chunk:", chunkPayload) }
    ws.send(chunkPayload)
    i = i + 1
    let _d = 0
    while (_d < 80000) { _d = _d + 1 }
  }
  if (ws && ws.send) {
    let blockPayload = JSON.stringify({
      type: "tpl.block",
      actorId: actorId,
      authorId: actorId,
      lines: lines,
      effectivePerfStep: perfStep,
      asap: true
    })
    console.log("[worker] OUTPUT wsSend tpl.block:", blockPayload.substring(0, 300) + (blockPayload.length > 300 ? "..." : ""))
    ws.send(blockPayload)
  }
}

fn handlePlayingStream(ws, perfStep) {
  // Auto-jam: drop a full preset on the agent's lane (rotating for variety), so collaborators get a
  // rich deck set blended on Deck B rather than a one-line demo. Falls back to LLM/demo if needed.
  let ctx = tplLineBuffer.length > 0 ? tplLineBuffer.join(" ") : ""
  let ds = await deckSetLinesForLane(ctx, true)
  if (ds !== null && ds !== undefined && ds.lines && ds.lines.length > 0) {
    console.log("[worker] play response: deck preset '" + ds.id + "' (" + String(ds.lines.length) + " lines) -> " + (playingActorId || "?"))
    sendBlockOnly(ws, ds.lines, perfStep)
    return
  }
  let lines = llmLinesFrom(
    "Listen to the session below and add ONE complementary track on your lane (id prefix " +
      actorId +
      "_) as TPL — fill gaps, complement density."
  )
  let src = "LLM"
  if (!lines) {
    let demo = buildDemoPatch("euclid hi-hat")
    lines = demo ? demo.split("\n") : null
    src = "demo"
  }
  if (!lines || lines.length === 0) return
  console.log("[worker] play response (" + src + "): streaming", String(lines.length), "lines ->", playingActorId || "?")
  streamChunkThenBlock(ws, lines, perfStep)
  console.log("[worker] sent tpl.stream_chunk + tpl.block")
}

fn connectHub() {
  let url = hub
  if (url.endsWith("/")) { url = url.substring(0, url.length - 1) }
  let ws = null
  let tries = 0
  while (tries < 10) {
    console.log("[worker] connecting to " + url)
    ws = WebSocket(url)
    if (ws !== null) { break }
    tries = tries + 1
    console.warn("[worker] connect failed, retry in 2s", url, "attempt", tries)
    let _w = 0
    while (_w < 2000000) { _w = _w + 1 }
  }
  if (ws === null) {
    console.warn("[worker] connect failed after retries", url)
    return null
  }
  activeWs = ws
  console.log("[worker] WebSocket connected (handshake OK), sending join")
  let joinPayload = JSON.stringify({
    type: "join",
    sessionId: session,
    actorId: actorId,
    channelIds: ["default"],
    skillIds: SKILL_IDS
  })
  console.log("[worker] OUTPUT wsSend join:", joinPayload)
  ws.send(joinPayload)
  console.log("[worker] joined " + session + " as " + actorId)
  return ws
}

fn run() {
  let ws = connectHub()
  if (ws === null) {
    process.exit(1)
  }
  console.log("[worker] enter receive loop")
  let joinedLogged = false
  while (true) {
    let msgObj = null
    try {
      msgObj = ws.receiveTimeout(500)
    } catch (e) {
      console.warn("[worker] loop error", e)
    }
    if (msgObj === null) { }
    else {
      let raw = (msgObj !== null && msgObj !== undefined && msgObj.data !== null && msgObj.data !== undefined) ? msgObj.data : null
      if (!raw) { }
      else {
        console.log("[worker] INPUT raw:", raw.length > 300 ? (raw.substring(0, 300) + "...") : raw)
        let msg = null
        try {
          msg = JSON.parse(raw)
        } catch (e) {
        }
        if (msg !== null && msg !== undefined) {
          console.log("[worker] INPUT parsed type=" + (msg.type || "?") + " keys=" + JSON.stringify(Object.keys(msg)))
        }
        if (msg !== null && msg !== undefined && msg.type === "direct") {
          let tgt = msg.targetActorId
          if (tgt === actorId || ((tgt === null || tgt === undefined) && msg.laneId === actorId)) {
            console.log("[worker] got direct: " + (msg.text || ""))
            handleDirect(ws, msg)
            console.log("[worker] sent tpl.block")
          }
        }
        else if (msg !== null && msg !== undefined && msg.type === "control") {
          let op = msg.op || ""
          if (op === "playing_start") {
            playingActorId = msg.actorId || msg.authorId || null
            respondedSincePlay = false
            tplLineBuffer = []
            lastLineAt = Date.now()
            console.log("[worker] playing_start, buffering tpl.line from " + (playingActorId || "?"))
          }
          else if (op === "playing_stop") {
            playingActorId = null
            tplLineBuffer = []
            respondedSincePlay = false
            console.log("[worker] playing_stop")
          }
        }
        else if (msg !== null && msg !== undefined && msg.type === "tpl.line") {
          let from = msg.actorId || msg.authorId || msg.laneId || ""
          if (playingActorId !== null && playingActorId !== undefined && (from === playingActorId || (playingActorId === "" && from !== actorId))) {
            let line = msg.line
            if (typeof line === "string") {
              pushContextLine(line)
              lastLineAt = Date.now()
            }
          }
        }
        else if (msg !== null && msg !== undefined && msg.type === "tpl.block") {
          // Fold other actors' committed patches into context so responses are aware of them.
          let bfrom = msg.actorId || msg.authorId || ""
          if (bfrom !== actorId && Array.isArray(msg.lines)) {
            let bi = 0
            while (bi < msg.lines.length) {
              pushContextLine(msg.lines[bi])
              bi = bi + 1
            }
          }
        }
        else if (msg !== null && msg !== undefined && msg.type === "presence") {
          let al = msg.actors ? msg.actors : []
          console.log("[worker] presence: actors=" + JSON.stringify(al))
        }
        else if (msg !== null && msg !== undefined && msg.type === "joined" && !joinedLogged) {
          joinedLogged = true
          console.log("[worker] received joined, ready")
        }
      }
    }
    if (playingActorId !== null && playingActorId !== undefined && !respondedSincePlay && tplLineBuffer.length > 0) {
      let elapsed = Date.now() - lastLineAt
      if (elapsed >= DEBOUNCE_MS) {
        respondedSincePlay = true
        let ps = 0
        handlePlayingStream(ws, ps)
      }
    }
  }
}

run()
