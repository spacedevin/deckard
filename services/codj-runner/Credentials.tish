// CLI sign-in for headless co-DJs: a native-app OAuth login (RFC 8252 loopback redirect + PKCE) and a 0600
// credentials file at ~/.deckard/credentials.json (override with DECKARD_CREDENTIALS). The access token is
// refreshed 5 minutes before it expires, so a long-running runner/MCP server stays signed in.
//
// The Hypery app must list `http://127.0.0.1/callback` as a redirect URI — Hypery matches loopback IP literals on
// any port, so the CLI can listen on whatever port is free.

import { hyperyConfig, hyperyExchangeCode, hyperyRefresh, hyperyUserInfo, hyperyTokenFresh } from '../../src/auth/Hypery.tish'
import { nodeModule, nodeFs, nodePath, nodeOs, env } from './NodeHost.tish'

export fn credentialsPath() {
  let p = env("DECKARD_CREDENTIALS")
  if (p !== null) {
    return p
  }
  return nodePath().join(nodeOs().homedir(), ".deckard", "credentials.json")
}

/** Hypery config for the CLI (HYPERY_URL / DECKARD_HYPERY_CLIENT_ID override the defaults). */
export fn cliHyperyConfig() {
  return hyperyConfig({ gatewayUrl: env("HYPERY_URL"), clientId: env("DECKARD_HYPERY_CLIENT_ID") })
}

export fn readCredentials() {
  try {
    let raw = nodeFs().readFileSync(credentialsPath(), "utf8")
    return JSON.parse(String(raw))
  } catch (e) {
    return null
  }
}

export fn writeCredentials(c) {
  let fs = nodeFs()
  let file = credentialsPath()
  fs.mkdirSync(nodePath().dirname(file), { recursive: true, mode: 448 })
  fs.writeFileSync(file, JSON.stringify(c, null, 2), { mode: 384 })
  fs.chmodSync(file, 384)
}

export fn deleteCredentials() {
  try {
    nodeFs().unlinkSync(credentialsPath())
    return true
  } catch (e) {
    return false
  }
}

let LOGIN_TIMEOUT_MS = 300000

fn page(title, body) {
  return "<!doctype html><meta charset=utf-8><title>" + title + "</title><body style=\"font:16px system-ui;padding:3em;background:#111;color:#eee\"><h2>" + title + "</h2><p>" + body + "</p></body>"
}

fn openBrowser(url) {
  let cp = nodeModule("node:child_process")
  let plat = globalThis.process.platform
  let cmd = plat === "darwin" ? "open" : (plat === "win32" ? "cmd" : "xdg-open")
  let args = plat === "win32" ? ["/c", "start", "", url] : [url]
  try {
    let child = cp.spawn(cmd, args, { detached: true, stdio: "ignore" })
    child.on("error", (e) => {})
    child.unref()
  } catch (e) {}
}

/** Listen on a free loopback port and resolve with the authorization `code` Hypery redirects back with. */
fn awaitRedirect(server, expectState) {
  return new Promise((resolve, reject) => {
    let timer = setTimeout(() => reject(new Error("sign-in timed out — run login again")), LOGIN_TIMEOUT_MS)
    server.on("request", (req, res) => {
      let u = new URL(String(req.url), "http://127.0.0.1")
      if (u.pathname !== "/callback") {
        res.writeHead(404)
        res.end()
        return
      }
      let err = u.searchParams.get("error")
      let code = u.searchParams.get("code")
      let state = u.searchParams.get("state")
      res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" })
      if (err) {
        let why = u.searchParams.get("error_description") ? u.searchParams.get("error_description") : err
        res.end(page("Sign-in failed", why))
        clearTimeout(timer)
        reject(new Error("Hypery sign-in failed: " + why))
      } else if (!code || state !== expectState) {
        res.end(page("Sign-in failed", "The response didn't match this login. Run login again."))
        clearTimeout(timer)
        reject(new Error("Hypery sign-in state mismatch — run login again"))
      } else {
        res.end(page("Signed in to Deckard", "You can close this tab and go back to the terminal."))
        clearTimeout(timer)
        resolve(code)
      }
    })
  })
}

/**
 * Browser login for the CLI. `say(line)` prints instructions. Resolves with the stored credentials
 * { gatewayUrl, clientId, accessToken, refreshToken, expiresAt, user }.
 */
export async fn browserLogin(say) {
  let cfg = cliHyperyConfig()
  let crypto = nodeModule("node:crypto")
  let verifier = crypto.randomBytes(32).toString("base64url")
  let challenge = crypto.createHash("sha256").update(verifier).digest("base64url")
  let state = crypto.randomBytes(16).toString("hex")
  let server = nodeModule("node:http").createServer()
  await new Promise((resolve, reject) => {
    server.once("error", reject)
    server.listen(0, "127.0.0.1", () => resolve(null))
  })
  let redirectUri = "http://127.0.0.1:" + String(server.address().port) + "/callback"
  let url = cfg.gatewayUrl + "/api/oauth/authorize?client_id=" + encodeURIComponent(cfg.clientId) +
    "&response_type=code" +
    "&redirect_uri=" + encodeURIComponent(redirectUri) +
    "&scope=" + encodeURIComponent(cfg.scopes.join(" ")) +
    "&code_challenge=" + encodeURIComponent(challenge) +
    "&code_challenge_method=S256" +
    "&state=" + encodeURIComponent(state)
  say("")
  say("  Sign in to Hypery in your browser to let this co-DJ act as you.")
  say("  If it didn't open, visit:")
  say("    " + url)
  say("")
  openBrowser(url)
  let code = null
  try {
    code = await awaitRedirect(server, state)
  } finally {
    server.close()
  }
  let tokens = await hyperyExchangeCode(cfg, code, verifier, redirectUri)
  let user = await hyperyUserInfo(cfg, tokens.accessToken)
  let creds = {
    gatewayUrl: cfg.gatewayUrl,
    clientId: cfg.clientId,
    accessToken: tokens.accessToken,
    refreshToken: tokens.refreshToken,
    expiresAt: tokens.expiresAt,
    user: user
  }
  writeCredentials(creds)
  return creds
}

/**
 * A valid access token for the stored login (refreshing if needed), or the HYPERY_TOKEN env var, or null.
 * A refreshed token set is written back so the next process starts fresh.
 */
export async fn cliAccessToken() {
  let fromEnv = env("HYPERY_TOKEN")
  if (fromEnv !== null) {
    return fromEnv
  }
  let c = readCredentials()
  if (c === null || !c.accessToken) {
    return null
  }
  if (hyperyTokenFresh(c, 300000)) {
    return c.accessToken
  }
  if (!c.refreshToken) {
    return null
  }
  let cfg = hyperyConfig({ gatewayUrl: c.gatewayUrl, clientId: c.clientId })
  let t = await hyperyRefresh(cfg, c.refreshToken)
  c.accessToken = t.accessToken
  c.refreshToken = t.refreshToken ? t.refreshToken : c.refreshToken
  c.expiresAt = t.expiresAt
  writeCredentials(c)
  return c.accessToken
}
