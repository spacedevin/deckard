// Deckard MCP server — the co-DJ command registry as MCP tools, for Cursor / Claude (stdio JSON-RPC).
// It is a full co-DJ peer: a co-DJ runtime (mirror of the room + gated writes) and a script host, so an external
// agent gets the same surface as the built-in one — read the room, edit tracks, and (the intended loop) write a
// co-DJ SCRIPT that keeps playing after the conversation ends.
//
// Build + run:  pnpm run mcp           (→ node services/mcp/mcp.mjs)
// Env: CODJ_GATEWAY (ws://127.0.0.1:35987) · CODJ_SESSION_ID (default) · CODJ_NAME (MCP) · CODJ_SCRIPT (a script file to
//      host + hot-reload; write_script writes it) · CODJ_ANON=1 (no sign-in; gateway must allow anon).
// Identity: `pnpm run codj:login` once (Hypery browser login); the gateway binds this peer to your account.
// stdout is the RPC channel — every log goes to stderr.

import { createCoDjRuntime } from '../../src/agentkit/Runtime.tish'
import { createScriptHost, vmEngine } from '../../src/agentkit/ScriptHost.tish'
import { toolSpecs, runTool } from '../../src/agentkit/Commands.tish'
import { wsTransport } from '../../src/agentkit/Transport.tish'
import { promptAssets } from '../../src/agentkit/PromptAssets.tish'
import { cliAccessToken } from '../codj-runner/Credentials.tish'
import { nodeFs, nodePath, nodeVm, env, readTextOr } from '../codj-runner/NodeHost.tish'

let P = globalThis.process

fn elog(s) {
  console.error("[deckard-mcp] " + String(s))
}

let anon = env("CODJ_ANON") === "1"
let name = env("CODJ_NAME") !== null ? env("CODJ_NAME") : "MCP"
let scriptFile = env("CODJ_SCRIPT") !== null ? nodePath().resolve(env("CODJ_SCRIPT")) : null

let runtime = createCoDjRuntime({
  transport: wsTransport(env("CODJ_GATEWAY") !== null ? env("CODJ_GATEWAY") : (env("CODJ_HUB_URL") !== null ? env("CODJ_HUB_URL") : "ws://127.0.0.1:35987"), null),
  actorId: "agent-" + name.toLowerCase(),
  skillIds: ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix"],
  displayName: name,
  kind: "agent",
  role: "client",
  sessionId: env("CODJ_SESSION_ID") !== null ? env("CODJ_SESSION_ID") : "default",
  token: async () => (anon ? null : await cliAccessToken()),
  grammar: () => promptAssets().grammar,
  log: elog
})
let vm = nodeVm()
let host = createScriptHost({ runtime: runtime, engine: vmEngine(vm, 50, scriptFile !== null ? scriptFile : "mcp-script.js") })
host.onLog((l) => elog("[script] " + l))
let lastWritten = null

if (scriptFile !== null) {
  let src0 = readTextOr(scriptFile, null)
  if (src0 !== null) {
    host.load(src0)
  }
  nodeFs().watchFile(scriptFile, { interval: 300 }, () => {
    let now = readTextOr(scriptFile, null)
    if (now !== null && now !== lastWritten && now !== host.source()) {
      let r = host.load(now)
      elog(r.ok ? "reloaded " + scriptFile : "kept the running script — " + String(r.error))
    }
  })
}

let chatLog = []
runtime.on((ev) => {
  if (ev.type === "chat") {
    chatLog.push(ev.fromName + (ev.to ? " → " + runtime.nameOf(ev.to) : "") + ": " + ev.text)
    if (chatLog.length > 50) {
      chatLog.shift()
    }
  } else if (ev.type === "error") {
    elog("gateway: " + ev.message)
  }
})

fn evalSnippet(code) {
  let src = String(code)
  let wrapped = null
  try {
    new vm.Script("(function(){ return (" + src + "\n) })")
    wrapped = "(function(){ \"use strict\"; return (" + src + "\n) })()"
  } catch (e) {
    wrapped = "(function(){ \"use strict\";\n" + src + "\n})()"
  }
  return vm.runInNewContext(wrapped, { codj: host.codj, console: { log: elog }, JSON: JSON, Math: Math }, { timeout: 1000 })
}

// Script + conversation tools on top of the registry (the registry's own tools come from toolSpecs()).
let EXTRA = [
  {
    name: "write_script",
    description: "Replace this peer's co-DJ script (JS exporting setup/onBar/onBeat/onMessage/onEvent hooks over the codj API — see the codj_api tool). Hot-reloads; rejected (old one kept) if it fails to compile or setup throws. Persists to CODJ_SCRIPT when set.",
    inputSchema: { type: "object", properties: { source: { type: "string" } }, required: ["source"] },
    run: (a) => {
      let r = host.load(String(a.source))
      if (r.ok && scriptFile !== null) {
        lastWritten = String(a.source)
        nodeFs().writeFileSync(scriptFile, lastWritten)
      }
      return { ok: r.ok, error: r.error !== null ? r.error : null, logs: host.logs().slice(-8) }
    }
  },
  {
    name: "read_script",
    description: "The current co-DJ script source.",
    inputSchema: { type: "object", properties: {}, required: [] },
    run: (a) => ({ source: host.source(), file: scriptFile })
  },
  {
    name: "run_script",
    description: "Run a JS snippet with `codj` in scope and return its value (an expression, or statements with `return`). The fastest way to inspect the room or make several edits at once.",
    inputSchema: { type: "object", properties: { code: { type: "string" } }, required: ["code"] },
    run: (a) => ({ value: evalSnippet(a.code) })
  },
  {
    name: "script_logs",
    description: "The co-DJ script's recent log lines, last error and run status.",
    inputSchema: { type: "object", properties: { lines: { type: "number" } }, required: [] },
    run: (a) => ({ logs: host.logs().slice(-(a.lines ? Math.floor(Number(a.lines)) : 30)), lastError: host.lastError(), status: host.status() })
  },
  {
    name: "codj_api",
    description: "The codj script API as TypeScript declarations (what scripts and run_script can call).",
    inputSchema: { type: "object", properties: {}, required: [] },
    run: (a) => promptAssets().dts
  },
  {
    name: "read_chat",
    description: "Recent room chat (who said what, and to whom).",
    inputSchema: { type: "object", properties: {}, required: [] },
    run: (a) => chatLog.slice()
  },
  // Legacy names (pre-registry MCP) — kept so existing configs/prompts keep working.
  {
    name: "get_session_deck",
    description: "Legacy alias of get_deck.",
    inputSchema: { type: "object", properties: {}, required: [] },
    run: (a) => runTool(runtime.kit, "get_deck", {})
  },
  {
    name: "send_deck_block",
    description: "Legacy alias of send_deck (deckLines: string[]).",
    inputSchema: { type: "object", properties: { deckLines: { type: "array", items: { type: "string" } } }, required: ["deckLines"] },
    run: (a) => runTool(runtime.kit, "send_deck", { text: (Array.isArray(a.deckLines) ? a.deckLines : [String(a.deckLines)]).join("\n"), opts: { at: "now" } })
  },
  {
    name: "send_direct",
    description: "Send an instruction to one co-DJ in the room (a targeted chat). `to` = its display name or actorId; omitted = everyone.",
    inputSchema: { type: "object", properties: { instruction: { type: "string" }, to: { type: "string" } }, required: ["instruction"] },
    run: (a) => {
      runtime.say(String(a.instruction), a.to ? String(a.to) : null)
      return "sent"
    }
  }
]

fn allTools() {
  let reg = toolSpecs().map((t) => ({ name: t.name, description: t.description, inputSchema: t.inputSchema }))
  return reg.concat(EXTRA.map((t) => ({ name: t.name, description: t.description, inputSchema: t.inputSchema })))
}

fn sendRpc(obj) {
  P.stdout.write(JSON.stringify(obj) + "\n")
}

fn textResult(v) {
  let s = typeof v === "string" ? v : JSON.stringify(v, null, 2)
  return { content: [{ type: "text", text: s === null ? "null" : s }] }
}

fn handleRequest(req) {
  let method = req.method
  let params = req.params ? req.params : {}
  if (method === "initialize") {
    sendRpc({ jsonrpc: "2.0", id: req.id, result: { protocolVersion: "2024-11-05", capabilities: { tools: {} }, serverInfo: { name: "deckard-mcp", version: "2.0.0" } } })
    return
  }
  if (method === "notifications/initialized" || method === "notifications/cancelled") {
    return
  }
  if (method === "ping") {
    sendRpc({ jsonrpc: "2.0", id: req.id, result: {} })
    return
  }
  if (method === "tools/list") {
    sendRpc({ jsonrpc: "2.0", id: req.id, result: { tools: allTools() } })
    return
  }
  if (method === "tools/call") {
    let toolName = String(params.name)
    let args = params.arguments ? params.arguments : {}
    let offline = toolName === "codj_api" || toolName === "get_grammar" || toolName === "list_instruments" || toolName === "read_script"
    if (!offline && !runtime.joined()) {
      sendRpc({ jsonrpc: "2.0", id: req.id, result: { content: [{ type: "text", text: "Not connected to the Deckard room yet (is the gateway running? signed in with `pnpm run codj:login`?)." }], isError: true } })
      return
    }
    try {
      let extra = EXTRA.find((t) => t.name === toolName)
      let out = extra ? extra.run(args) : runTool(runtime.kit, toolName, args)
      sendRpc({ jsonrpc: "2.0", id: req.id, result: textResult(out) })
    } catch (e) {
      sendRpc({ jsonrpc: "2.0", id: req.id, result: { content: [{ type: "text", text: "Error: " + String(e && e.message ? e.message : e) }], isError: true } })
    }
    return
  }
  if (req.id !== null) {
    sendRpc({ jsonrpc: "2.0", id: req.id, error: { code: -32601, message: "Method not found" } })
  }
}

let stdinBuffer = ""
P.stdin.setEncoding("utf8")
P.stdin.on("data", (chunk) => {
  stdinBuffer = stdinBuffer + chunk
  let n = stdinBuffer.indexOf("\n")
  while (n >= 0) {
    let line = stdinBuffer.substring(0, n)
    stdinBuffer = stdinBuffer.substring(n + 1)
    if (line.trim().length > 0) {
      let msg = null
      try {
        msg = JSON.parse(line)
      } catch (e) {
        msg = null
      }
      if (msg !== null) {
        handleRequest(msg)
      }
    }
    n = stdinBuffer.indexOf("\n")
  }
})
P.stdin.on("end", () => {
  runtime.close()
  P.exit(0)
})
