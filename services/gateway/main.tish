// Co-DJ gateway (Tish): one room per sessionId, fanout JSON, per-actor seq.
// Connect to ws://host:35987 (or CODJ_HUB_PORT) — first message must be join with sessionId, actorId, channelIds, skillIds.
// Node.js ws-compatible API: Server.clients
// wsBroadcast does send in Rust — avoids Tish Call opcode for method/native in loop
import { Server, wsSend, wsBroadcast } from "tish:ws"
import { process } from "tish:process"

// Port: CODJ_HUB_PORT (explicit override) wins, else PORT (App Platform / generic PaaS injects it),
// else the local default 35987. So `tish run` locally stays on 35987; a DO service listens on $PORT.
let port = 35987
if (process !== null && process.env) {
  let v = null
  if ("CODJ_HUB_PORT" in process.env) v = process.env["CODJ_HUB_PORT"]
  else if ("PORT" in process.env) v = process.env["PORT"]
  if (v) port = parseInt(v, 10)
}
if (!(port >= 1 && port <= 65535)) port = 35987

let server = Server({ port })
if (server === null) {
  console.error("gateway: failed to listen on port", port)
  process.exit(1)
}

console.log("[gateway] listening ws://0.0.0.0:" + port + " — first message: join with sessionId, actorId")
console.log("[gateway] (If worker gets HTTP 200, ensure only this process uses the port: lsof -i :" + port + ")")

// rooms: array of { id, conns, seq }; seq per actorId (dynamic keys)
let rooms = []
let allConns = []

fn getRoom(sessionId) {
  let i = 0
  while (i < rooms.length) {
    if (rooms[i].id === sessionId) return rooms[i]
    i = i + 1
  }
  let r = { id: sessionId, conns: [], seq: {}, hostActorId: null, hostSnapshot: null, hostOwners: null, hostGen: 0 }
  rooms.push(r)
  return r
}

// Find the joined conn for an actorId in a room (or null).
fn connForActor(room, actorId) {
  let i = 0
  while (i < room.conns.length) {
    if (room.conns[i].actorId === actorId) return room.conns[i]
    i = i + 1
  }
  return null
}

fn skillsHaveMaster(skillIds) {
  if (!Array.isArray(skillIds)) return false
  let i = 0
  while (i < skillIds.length) {
    if (skillIds[i] === "master_mixer") return true
    i = i + 1
  }
  return false
}

fn collectActors(room) {
  let out = []
  let i = 0
  while (i < room.conns.length) {
    let c = room.conns[i]
    let aid = c.actorId
    if (aid && out.indexOf(aid) === -1) out.push(aid)
    i = i + 1
  }
  return out.sort()
}

fn nextSeq(room, actorId) {
  if (actorId === null || actorId === "") actorId = "unknown"
  if (room.seq[actorId] === null) room.seq[actorId] = 0
  room.seq[actorId] = room.seq[actorId] + 1
  return room.seq[actorId]
}

// Send to all conns in room except sender. Build array of raw ws objects for wsBroadcast.
fn broadcast(room, msg, except) {
  let s = typeof msg === "string" ? msg : JSON.stringify(msg)
  console.log("[gateway] OUTPUT broadcast " + (msg !== null && typeof msg === "object" ? msg.type : "?") + ":", s.length > 200 ? (s.substring(0, 200) + "...") : s)
  let wsArray = []
  let exceptWs = null
  if (except !== null && except.ws !== null) {
    exceptWs = except.ws
  }
  let i = 0
  while (i < room.conns.length) {
    let c = room.conns[i]
    if (c.ws !== null) {
      if (c !== except) {
        wsArray.push(c.ws)
        console.log("[gateway] broadcast: adding conn[" + String(i) + "] actorId=" + (c.actorId || "?") + " ws=ok")
      } else {
        console.log("[gateway] broadcast: skipping conn[" + String(i) + "] actorId=" + (c.actorId || "?") + " (sender)")
      }
    }
    i = i + 1
  }
  console.log("[gateway] broadcast: wsArray.length=" + String(wsArray.length) + " room.conns.length=" + String(room.conns.length))
  let n = wsBroadcast(wsArray, exceptWs, s)
  console.log("[gateway] wsBroadcast returned n=" + String(n))
  if (msg !== null && typeof msg === "object") {
    if (msg.type === "presence") {
      console.log("[gateway] broadcast presence -> " + String(n) + " recipients (room has " + String(room.conns.length) + " conns)")
    } else if (msg.type === "tpl.block" || msg.type === "tpl.line") {
      console.log("[gateway] broadcast " + msg.type + " -> " + String(n) + " recipients")
    }
  }
}

fn clientId() {
  return "tish-" + Date.now() + "-" + (Math.random() * 1000000000 | 0)
}

// Message types that get fanned out to the room. A function (fresh bool per call) rather than a reused
// `let` so the AOT native backend doesn't trip its move-checker on a boomeranged boolean.
fn isFanoutType(mt) {
  if (mt === "deck.put") return true
  if (mt === "tpl.block") return true
  if (mt === "tpl.stream_chunk") return true
  if (mt === "control") return true
  if (mt === "tpl.line") return true
  if (mt === "direct") return true
  return false
}

// wsSend returns false once a connection is closed — use it to prune dead conns. A closed conn that
// lingers would keep "occupying" a player slot / room-cap seat and (if it was the host) freeze the
// room on a dead source of truth. Ping each conn; drop the ones that fail; reassign host if it died.
fn pruneDeadConns() {
  let survivors = []
  let deadRooms = {}
  let hostDiedRooms = {}
  let i = 0
  while (i < allConns.length) {
    let c = allConns[i]
    let ok = c.ws !== null && wsSend(c.ws, "{\"type\":\"ping\"}")
    if (ok) {
      survivors.push(c)
    } else {
      console.log("[gateway] pruned dead conn actorId=" + (c.actorId || "?") + " session=" + (c.sessionId || "?"))
      if (c.joined && c.sessionId !== null) {
        let room = getRoom(c.sessionId)
        let rc = []
        let j = 0
        while (j < room.conns.length) {
          if (room.conns[j] !== c) {
            rc.push(room.conns[j])
          }
          j = j + 1
        }
        room.conns = rc
        deadRooms[c.sessionId] = true
        if (c.actorId === room.hostActorId) {
          hostDiedRooms[c.sessionId] = true
        }
      }
    }
    i = i + 1
  }
  allConns = survivors
  let ri = 0
  while (ri < rooms.length) {
    let room = rooms[ri]
    if (deadRooms[room.id] === true) {
      if (hostDiedRooms[room.id] === true) {
        room.hostActorId = null
        room.hostSnapshot = null
        room.hostOwners = null
        room.hostGen = 0
        let hi = 0
        while (hi < room.conns.length) {
          if (skillsHaveMaster(room.conns[hi].skillIds)) {
            room.hostActorId = room.conns[hi].actorId
            hi = room.conns.length
          } else {
            hi = hi + 1
          }
        }
        console.log("[gateway] host reassigned to " + (room.hostActorId || "(none)") + " session=" + room.id)
        if (room.hostActorId !== null) {
          let nh = connForActor(room, room.hostActorId)
          if (nh !== null && nh.ws !== null) {
            wsSend(nh.ws, JSON.stringify({ type: "request.snapshot", sessionId: room.id }))
          }
        }
      }
      broadcast(room, { type: "presence", sessionId: room.id, actors: collectActors(room), hostActorId: room.hostActorId }, null)
    }
    ri = ri + 1
  }
}

let lastPrune = Date.now()

// Single loop: accept, then poll each conn with short timeout so we service all quickly
while (true) {
  let ws = server.acceptTimeout(server, 50)
  if (ws !== null) {
    console.log("[gateway] WS connection accepted (handshake OK), awaiting join")
    allConns.push({ ws, sessionId: null, actorId: null, channelIds: [], skillIds: [], clientId: null, joined: false })
  }

  if (Date.now() - lastPrune > 2500) {
    pruneDeadConns()
    lastPrune = Date.now()
  }

  let ci = 0
  while (ci < allConns.length) {
    let conn = allConns[ci]
    let msgObj = conn.ws.receiveTimeout ? conn.ws.receiveTimeout(50) : conn.ws.receive()
    let raw = null
    if (msgObj !== null) {
      if (msgObj.data !== null) raw = msgObj.data
    }
    if (raw !== null) {
      let rawPreview = raw.length > 120 ? (raw.substring(0, 120) + "... (" + String(raw.length) + " bytes)") : raw
      console.log("[gateway] INPUT raw preview:", rawPreview)
      let msg = null
      try {
        msg = JSON.parse(raw)
      } catch (e) {
        let errPayload = JSON.stringify({ type: "error", code: "BAD_JSON", message: "invalid JSON" })
        console.log("[gateway] OUTPUT wsSend error:", errPayload)
        if (conn.ws !== null) wsSend(conn.ws, errPayload)
      }
      if (msg !== null) {
        let mt = msg.type !== null ? String(msg.type) : "?"
        console.log("[gateway] INPUT parsed type=" + mt + " from conn actorId=" + (conn.actorId || "?") + " joined=" + String(conn.joined))
        if (!conn.joined) {
          if (msg.type === "join") {
            let aid = null
            if ("actorId" in msg) {
              let v = msg["actorId"]
              if (typeof v === "string" && v !== "") aid = v
            }
            if (!aid) {
              let errPayload = JSON.stringify({ type: "error", code: "JOIN_BAD", message: "actorId required" })
              console.log("[gateway] OUTPUT wsSend error:", errPayload)
              if (conn.ws !== null) wsSend(conn.ws, errPayload)
            } else {
              let sid = (typeof msg.sessionId === "string" && msg.sessionId !== "") ? msg.sessionId : "default"
              let roomPre = getRoom(sid)
              let existingActors = collectActors(roomPre)
              let alreadyIn = existingActors.indexOf(aid) >= 0
              if (!alreadyIn && existingActors.length >= 4) {
                // Max 4 players per room.
                let fullPayload = JSON.stringify({ type: "error", code: "ROOM_FULL", message: "room is full (max 4 players)" })
                console.log("[gateway] ROOM_FULL reject " + aid + " session=" + sid)
                if (conn.ws !== null) wsSend(conn.ws, fullPayload)
              } else {
              conn.joined = true
              conn.sessionId = sid
              conn.actorId = aid
              conn.channelIds = ("channelIds" in msg && Array.isArray(msg["channelIds"]) && msg["channelIds"].length > 0) ? msg["channelIds"] : ["default"]
              conn.skillIds = ("skillIds" in msg && Array.isArray(msg["skillIds"])) ? msg["skillIds"] : []
              conn.clientId = clientId()
              let room = getRoom(conn.sessionId)
              if (room !== null) {
                room.conns.push(conn)
                console.log("[gateway] joined session=" + conn.sessionId + " actorId=" + conn.actorId)
                // Host = source of truth: the first joiner carrying master_mixer becomes the room host.
                if (room.hostActorId === null && skillsHaveMaster(conn.skillIds)) {
                  room.hostActorId = conn.actorId
                  console.log("[gateway] host designated: " + conn.actorId + " session=" + conn.sessionId)
                }
                let actors = collectActors(room)
                if (conn.ws !== null) {
                  let joinedPayload = JSON.stringify({
                    type: "joined",
                    sessionId: conn.sessionId,
                    you: { actorId: conn.actorId, clientId: conn.clientId, channelIds: conn.channelIds },
                    actors,
                    hostActorId: room.hostActorId,
                    replay: []
                  })
                  console.log("[gateway] OUTPUT wsSend joined:", joinedPayload.substring(0, 200) + (joinedPayload.length > 200 ? "..." : ""))
                  wsSend(conn.ws, joinedPayload)
                }
                console.log("[gateway] presence update: actors=" + JSON.stringify(actors) + " session=" + conn.sessionId)
                broadcast(room, { type: "presence", sessionId: conn.sessionId, actors, hostActorId: room.hostActorId }, null)
                // A joining FOLLOWER gets the host's authoritative state: deliver the cached snapshot
                // now (if any) and ask the host to push a fresh one so the joiner's default is clobbered.
                if (conn.actorId !== room.hostActorId) {
                  if (room.hostSnapshot !== null && conn.ws !== null) {
                    // Carry the per-track ownership map with the cached snapshot. WITHOUT it the joiner can't
                    // tell host tracks from its own → every track defaults to "human" → channelPlayerIndex's
                    // "human"→host remap collapses EVERYTHING (incl. the joiner's own contribution) onto
                    // Deck A. The owners map is what keeps each contributor on its own deck.
                    let snapPayload = JSON.stringify({ type: "state.snapshot", sessionId: conn.sessionId, fromHost: room.hostActorId, lines: room.hostSnapshot, owners: room.hostOwners, gen: room.hostGen })
                    console.log("[gateway] OUTPUT wsSend cached state.snapshot -> " + conn.actorId + " (" + String(room.hostSnapshot.length) + " lines)")
                    wsSend(conn.ws, snapPayload)
                  }
                  if (room.hostActorId !== null) {
                    let hostConn = connForActor(room, room.hostActorId)
                    if (hostConn !== null && hostConn.ws !== null) {
                      let reqPayload = JSON.stringify({ type: "request.snapshot", sessionId: conn.sessionId, forActorId: conn.actorId })
                      console.log("[gateway] OUTPUT wsSend request.snapshot -> host " + room.hostActorId + " (for " + conn.actorId + ")")
                      wsSend(hostConn.ws, reqPayload)
                    }
                  }
                }
              }
              }
            }
          } else {
            let errPayload = JSON.stringify({ type: "error", code: "JOIN_FIRST", message: "send join first" })
            console.log("[gateway] OUTPUT wsSend error:", errPayload)
            if (conn.ws !== null) wsSend(conn.ws, errPayload)
          }
        } else {
          let actorId = conn.actorId
          let room = getRoom(conn.sessionId)
          if (room !== null) {
            let mt0 = msg.type !== null ? String(msg.type) : ""
            // Host pushes its authoritative project as state.snapshot: cache it (so future joiners get
            // it) and fan it out to current followers so they clobber their local state.
            if (mt0 === "state.snapshot" && Array.isArray(msg.lines)) {
              // Monotonic generation: only accept a snapshot at or beyond the cached gen, so an out-of-order
              // stale push can never clobber a newer one. Followers also discard by gen (newer-wins).
              let sg = (typeof msg.gen === "number") ? Math.floor(msg.gen) : 0
              if ((room.hostActorId === null || actorId === room.hostActorId) && sg >= room.hostGen) {
                room.hostSnapshot = msg.lines
                // Cache + relay the ownership map alongside the lines (missing key reads as null natively).
                // Dropping it is the "guests merge into Deck A" bug — see the cached-send note above.
                room.hostOwners = msg.owners
                room.hostGen = sg
                console.log("[gateway] cached host snapshot from " + actorId + " (" + String(msg.lines.length) + " lines, gen " + String(sg) + ")")
                broadcast(room, { type: "state.snapshot", sessionId: conn.sessionId, fromHost: actorId, lines: msg.lines, owners: msg.owners, gen: sg }, conn)
              }
            }
            let mt = msg.type !== null ? String(msg.type) : ""
            let n = 0
            let bi = 0
            while (bi < room.conns.length) {
              if (room.conns[bi] !== conn) n = n + 1
              bi = bi + 1
            }
            console.log(
              "[gateway] recv " +
                mt +
                " from " +
                actorId +
                " session=" +
                conn.sessionId +
                " -> " +
                String(n) +
                " peer(s), room " +
                String(room.conns.length) +
                " conn(s), broadcast=" +
                String(isFanoutType(mt))
            )
            if (isFanoutType(mt) && n === 0 && (mt === "tpl.block" || mt === "tpl.line")) {
              console.log("[gateway] note: 0 peers — only sender in room; open another client on same sessionId to receive")
            }
            let seq = nextSeq(room, actorId)
            let out = {}
            let keys = Object.keys(msg)
            let ki = 0
            while (ki < keys.length) {
              let k = keys[ki]
              out[k] = msg[k]
              ki = ki + 1
            }
            out.seq = seq
            out.sessionId = conn.sessionId
            out.actorId = actorId
            // Stamp the sender's declared skills so receivers can enforce skill-gating on apply.
            if (out.skillIds === null) {
              out.skillIds = conn.skillIds
            }
            if (isFanoutType(mt)) {
              broadcast(room, out, conn)
            }
          }
        }
      }
    }
    ci = ci + 1
  }
}
