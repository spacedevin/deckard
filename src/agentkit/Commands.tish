// THE co-DJ command registry — one `defineCommand` per capability, and everything else is derived from it:
//   • the script API      `codj.<name>(…)`           (scriptApi — what a co-DJ script calls, positional args)
//   • LLM / MCP tools     `<tool>` + JSON schema      (toolSpecs / runTool — named args)
//   • docs + types        docs/CODJ_API.md, public/codj.d.ts  (apiMarkdown / apiDts, via scripts/gen-codj-api.mjs)
// Add a capability here and it shows up in all four places; the generator's --check fails CI if the checked-in
// docs drift from this file.
//
// A command runs against a `kit` the runtime provides:
//   kit.mirror                the headless fold (Mirror.tish)
//   kit.write(src, opts)      gate-report + fold locally + send as deck.block → {sent, at, accepted, rejected}
//   kit.say(text, to)         chat to the room (to = actorId / display name, optional)
//   kit.grammar()             the agent deck grammar text

import { generatorCatalog } from '@spacedevin/deck-synths'
import { emitProject, generatorIdToTpl } from '../deckfile/Emit.tish'
import { findChannelById } from '../deckfile/Apply.tish'
import { fragmentForEdit } from '../core/Edit.tish'
import { coDjGateReport } from '../codj/Gate.tish'
import { applyCoDjTplSource, laneCanMaster } from '../codj/Merge.tish'
import { fxDirective, transportPlayDirective } from '../codj/Launch.tish'
import { macroCatalog, macroParamControls } from '../model/MacroVoice.tish'
import { channelDeck } from '../model/DeckRouting.tish'
import { expandSpec, libraryEntry, libraryIndex } from './Library.tish'
import { camelToSnake, snakeToCamel } from '@spacedevin/deck'
import { defaultParamsForGeneratorId } from '@spacedevin/deck-synths'

let COMMANDS = []

/**
 * spec: {
 *   name, tool, description, readOnly,
 *   params: [{ name, ts, schema, description, optional }],   ts = TypeScript type, schema = JSON schema
 *   returns: TypeScript type, example: one-line script usage,
 *   run(kit, args) → result
 * }
 */
export fn defineCommand(spec) {
  COMMANDS.push(spec)
  return spec
}

export fn commands() {
  return COMMANDS
}

export fn findCommand(nameOrTool) {
  let i = 0
  while (i < COMMANDS.length) {
    if (COMMANDS[i].name === nameOrTool || COMMANDS[i].tool === nameOrTool) {
      return COMMANDS[i]
    }
    i = i + 1
  }
  return null
}

// ---- helpers over the fold -------------------------------------------------------------------------------------

fn ownerOf(p, id) {
  let m = p.coDjMeta && p.coDjMeta.tracks ? p.coDjMeta.tracks[id] : null
  return m && m.ownerActorId ? String(m.ownerActorId) : null
}

/** The page-load demo: the only tracks are the starter ids (Kick c0, Snare c1, HiHat c2, Bass c3).
 *  The room stamps those as the local user, so ownership is not the signal — an extra id is. */
fn isStarterId(id) {
  return id === "c0" || id === "c1" || id === "c2" || id === "c3"
}

// The page-load starter is still up: some of c0–c3 are there, and every other track is this co-DJ's own.
fn isPageStarter(p, me) {
  let chs = p && p.channels ? p.channels : []
  let starters = 0
  let i = 0
  while (i < chs.length) {
    let id = String(chs[i].id)
    if (isStarterId(id)) {
      starters = starters + 1
    } else if (ownerOf(p, id) !== me) {
      return false
    }
    i = i + 1
  }
  return starters > 0
}

fn stepOn(s) {
  return s === true || (s && s.on === true)
}

fn stepsString(ch) {
  let out = ""
  let i = 0
  while (i < 16) {
    let s = ch.steps && i < ch.steps.length ? ch.steps[i] : null
    out = out + (stepOn(s) ? "x" : ".")
    i = i + 1
  }
  return out
}

fn genToken(ch) {
  return ch.macroName !== null ? String(ch.macroName) : generatorIdToTpl(ch.generatorId ? ch.generatorId : "basicOsc")
}

fn trackSummary(p, ch, me) {
  let owner = ownerOf(p, ch.id)
  return {
    id: String(ch.id),
    name: String(ch.name),
    gen: genToken(ch),
    owner: owner,
    mine: owner !== null && owner === me,
    gain: ch.gain !== null ? ch.gain : 0.85,
    pan: ch.pan !== null ? ch.pan : 0,
    mute: ch.mute === true,
    solo: ch.solo === true,
    steps: stepsString(ch),
    notes: Array.isArray(ch.pianoNotes) ? ch.pianoNotes.length : 0,
    bars: ch.patternBars !== null ? Math.floor(Number(ch.patternBars)) : 1,
    onDeck: channelDeck(p, ch)
  }
}

/** id → the track's block lines (header + indented body) from a deck text. */
fn trackBlocks(deckText) {
  let out = {}
  let cur = null
  let lines = String(deckText).split("\n")
  let i = 0
  while (i < lines.length) {
    let ln = lines[i]
    let indented = ln.length > 0 && (ln.charAt(0) === " " || ln.charAt(0) === "\t")
    if (!indented) {
      cur = null
      let tr = ln.trim()
      if (tr.indexOf("track ") === 0) {
        let gi = tr.indexOf(" gen ")
        let head = gi >= 0 ? tr.substring(0, gi) : tr
        let ii = head.lastIndexOf(" id ")
        if (ii >= 0) {
          cur = head.substring(ii + 4).trim()
          out[cur] = [ln]
        }
      }
    } else if (cur !== null) {
      out[cur].push(ln)
    }
    i = i + 1
  }
  return out
}

fn requireTrack(kit, id) {
  let ch = findChannelById(kit.mirror.project(), String(id))
  if (!ch) {
    throw new Error("no track with id '" + String(id) + "' — call tracks() for ids")
  }
  return ch
}

/** "x..x" / "x . x ." / [true, 0, 1, …] / "euclid 5" → 16 booleans (or {euclid}). */
fn parsePattern(pat) {
  if (Array.isArray(pat)) {
    let a = []
    let i = 0
    while (i < 16) {
      let v = i < pat.length ? pat[i] : false
      a.push(v === true || v === 1 || v === "x" || (v && v.on === true))
      i = i + 1
    }
    return { steps: a }
  }
  let s = String(pat).trim()
  if (s.indexOf("euclid") === 0) {
    let n = Math.floor(Number(s.substring(6).trim()))
    return { euclid: n === n ? n : 4 }
  }
  let chars = s.split(" ").join("")
  let out = []
  let k = 0
  while (k < 16) {
    let c = k < chars.length ? chars.charAt(k) : "."
    out.push(c === "x" || c === "X" || c === "1" || c === "o")
    k = k + 1
  }
  return { steps: out }
}

fn stepsLineFor(pat) {
  let pp = parsePattern(pat)
  if (pp.euclid !== null) {
    return "  steps euclid " + String(pp.euclid) + " 16"
  }
  let s = "  steps"
  let i = 0
  while (i < 16) {
    s = s + (pp.steps[i] ? " x" : " .")
    i = i + 1
  }
  return s
}

fn noteObj(n) {
  return {
    pitch: Math.floor(Number(n.pitch !== null ? n.pitch : 60)),
    startBeat: Number(n.start !== null ? n.start : (n.startBeat !== null ? n.startBeat : 0)),
    durBeats: Number(n.dur !== null ? n.dur : (n.durBeats !== null ? n.durBeats : 0.25)),
    vel: Math.floor(Number(n.vel !== null ? n.vel : 100))
  }
}

fn genTokenFor(g) {
  let s = String(g)
  let cat = generatorCatalog()
  let i = 0
  while (i < cat.length) {
    if (cat[i].id === s) {
      return generatorIdToTpl(s)
    }
    i = i + 1
  }
  return s
}

fn slug(s) {
  let out = ""
  let lower = String(s).toLowerCase()
  let i = 0
  while (i < lower.length && out.length < 24) {
    let c = lower.charAt(i)
    let ok = (c >= "a" && c <= "z") || (c >= "0" && c <= "9")
    out = out + (ok ? c : "_")
    i = i + 1
  }
  return out.length > 0 ? out : "track"
}

/** A track id unique to this actor (the convention: `<actorId>_<slug>`). */
fn ownId(kit, name) {
  let me = kit.mirror.me().actorId
  let base = slug(me) + "_" + slug(name)
  let id = base
  let n = 2
  while (findChannelById(kit.mirror.project(), id)) {
    id = base + "_" + String(n)
    n = n + 1
  }
  return id
}

fn deepClone(o) {
  return JSON.parse(JSON.stringify(o))
}

fn optWrite(kit, src, opts) {
  return kit.write(src, opts !== null ? opts : {})
}

fn slugToken(v) {
  let s = String(v)
  let out = ""
  let i = 0
  while (i < s.length) {
    let c = s.charAt(i)
    let ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c === "_"
    out = out + (ok ? c : "_")
    i = i + 1
  }
  return out.length > 0 ? out : "clip"
}

fn numOr(v, fallback) {
  if (v === null || typeof v === "undefined") {
    return fallback
  }
  let n = Number(v)
  return n === n ? n : fallback
}

// ---- reads ------------------------------------------------------------------------------------------------------

defineCommand({
  name: "deck", tool: "get_deck", readOnly: true,
  description: "The whole session as deck text (the room's shared document, exactly as the host would save it).",
  params: [], returns: "string", example: "const text = codj.deck()",
  run: (kit, a) => emitProject(kit.mirror.project())
})

defineCommand({
  name: "tracks", tool: "list_tracks", readOnly: true,
  description: "Every track: id, name, gen, owner, mine, mix, a 16-char step string ('x' = hit), note count, bars, and onDeck (the deck letter it plays on).",
  params: [], returns: "TrackSummary[]", example: "codj.tracks().filter(t => !t.mine)",
  run: (kit, a) => {
    let p = kit.mirror.project()
    let me = kit.mirror.me().actorId
    return p.channels.map((ch) => trackSummary(p, ch, me))
  }
})

defineCommand({
  name: "track", tool: "get_track", readOnly: true,
  description: "One track in full: its summary + deck block text + generator params + piano notes.",
  params: [{ name: "id", ts: "string", schema: { type: "string" }, description: "track id" }],
  returns: "TrackDetail", example: "codj.track('c0').deck",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.id)
    let p = kit.mirror.project()
    let s = trackSummary(p, ch, kit.mirror.me().actorId)
    let blocks = trackBlocks(emitProject(p))
    s.deck = blocks[String(ch.id)] ? blocks[String(ch.id)].join("\n") : ""
    s.params = ch.generatorParams ? deepClone(ch.generatorParams) : {}
    s.pianoNotes = Array.isArray(ch.pianoNotes) ? ch.pianoNotes.map((n) => ({ pitch: n.pitch, start: n.startBeat, dur: n.durBeats, vel: n.vel })) : []
    return s
  }
})

defineCommand({
  name: "owned", tool: "list_owned", readOnly: true,
  description: "Ids of the tracks this co-DJ owns (the only tracks it may edit).",
  params: [], returns: "string[]", example: "codj.owned().length",
  run: (kit, a) => {
    let p = kit.mirror.project()
    let me = kit.mirror.me().actorId
    return p.channels.filter((ch) => ownerOf(p, ch.id) === me).map((ch) => String(ch.id))
  }
})

defineCommand({
  name: "clock", tool: "get_clock", readOnly: true,
  description: "The shared playhead: perfStep (16ths since play), bar, beat (0-3), step (0-15), bpm, playing.",
  params: [], returns: "Clock", example: "codj.clock().bar % 8 === 0",
  run: (kit, a) => kit.mirror.clock()
})

defineCommand({
  name: "room", tool: "get_room", readOnly: true,
  description: "Who is here: me ({actorId, displayName, skillIds, isHost}), host actorId, roster, what the host is focused on.",
  params: [], returns: "Room", example: "codj.room().roster.map(r => r.displayName)",
  run: (kit, a) => {
    let me = kit.mirror.me()
    let r = kit.mirror.room()
    return {
      me: { actorId: me.actorId, displayName: me.displayName, skillIds: me.skillIds, isHost: r.hostActorId === me.actorId },
      host: r.hostActorId,
      roster: r.roster,
      focus: r.focus,
      sessionId: r.sessionId
    }
  }
})

defineCommand({
  name: "instruments", tool: "list_instruments", readOnly: true,
  description: "Every `gen` you can put on a track: the fixed generators and the macro voices, with descriptions.",
  params: [], returns: "Instrument[]", example: "codj.instruments().map(i => i.gen)",
  run: (kit, a) => {
    let out = generatorCatalog().map((g) => ({ gen: generatorIdToTpl(g.id), label: g.label, kind: "generator", description: g.description ? g.description : "" }))
    let mc = macroCatalog()
    let i = 0
    while (i < mc.length) {
      out.push({ gen: mc[i].name, label: mc[i].label, kind: "macro", description: mc[i].kind + " macro voice" })
      i = i + 1
    }
    return out
  }
})

defineCommand({
  name: "grammar", tool: "get_grammar", readOnly: true,
  description: "The deck lines a co-DJ may write (track blocks, generator params, what is master-only).",
  params: [], returns: "string", example: "codj.grammar()",
  run: (kit, a) => kit.grammar()
})

defineCommand({
  name: "preview", tool: "preview_deck", readOnly: true,
  description: "Dry-run deck text: which lines the host's gate would accept/reject (and why) and which tracks it would add/edit/remove. Nothing is sent.",
  params: [{ name: "text", ts: "string", schema: { type: "string" }, description: "deck lines (no `deck 1` header needed)" }],
  returns: "Preview", example: "codj.preview('track Hat id x_hat gen noise_burst\\n  steps euclid 7 16')",
  run: (kit, a) => {
    let p = kit.mirror.project()
    let me = kit.mirror.me()
    let report = coDjGateReport(p, String(a.text), me.actorId, me.skillIds)
    let before = trackBlocks(emitProject(p))
    let clone = deepClone(p)
    applyCoDjTplSource(clone, "deck 1\n" + String(a.text) + "\n", me.actorId, me.actorId, kit.mirror.clock().perfStep, me.skillIds)
    let after = trackBlocks(emitProject(clone))
    let changes = []
    let ak = Object.keys(after)
    let i = 0
    while (i < ak.length) {
      let id = ak[i]
      if (!before[id]) {
        changes.push({ trackId: id, change: "add" })
      } else if (before[id].join("\n") !== after[id].join("\n")) {
        changes.push({ trackId: id, change: "edit" })
      }
      i = i + 1
    }
    let bk = Object.keys(before)
    let j = 0
    while (j < bk.length) {
      if (!after[bk[j]]) {
        changes.push({ trackId: bk[j], change: "remove" })
      }
      j = j + 1
    }
    return { accepted: report.accepted, rejected: report.rejected, changes: changes }
  }
})

// ---- writes -----------------------------------------------------------------------------------------------------

let AT_PARAM = { name: "opts", ts: "WriteOpts", schema: { type: "object", properties: { at: { description: "'now' | 'beat' | 'bar' (default while playing) | an absolute perfStep" } } }, description: "when it lands", optional: true }

defineCommand({
  name: "send", tool: "send_deck", readOnly: false,
  description: "Send raw deck lines to the room (the general write — everything below is sugar over it). Lands at the next bar while playing.",
  params: [{ name: "text", ts: "string", schema: { type: "string" }, description: "deck lines" }, AT_PARAM],
  returns: "WriteResult", example: "codj.send('track Hat id me_hat gen noise_burst\\n  steps euclid 7 16')",
  run: (kit, a) => optWrite(kit, String(a.text), a.opts)
})

defineCommand({
  name: "library", tool: "library", readOnly: true,
  description: "The reference library: factory instruments, drum beats, melodic sequences, and full kits. Each row is {id, kind, role, name, about}. kind filters to 'instrument' | 'beat' | 'sequence' | 'kit'. Pass an id to codj.preset, or put preset/beat/sequence on an arrange track.",
  params: [{ name: "kind", ts: "string", schema: { type: "string" }, description: "instrument | beat | sequence | kit", optional: true }],
  returns: "LibraryRow[]", example: "codj.library('kit')",
  run: (kit, a) => libraryIndex(a.kind !== null ? a.kind : null)
})

defineCommand({
  name: "preset", tool: "preset", readOnly: true,
  description: "One library entry. An instrument has gen + params (the knobs — pass them through, or codj.set(id, 'gen/<knob>', value)). A beat has steps and accent lanes. A sequence has events in semitones above defaultRoot. A kit has .parts, which is an arrange() argument: codj.arrange(codj.preset('house-loop').parts).",
  params: [{ name: "id", ts: "string", schema: { type: "string" }, description: "library id" }],
  returns: "LibraryEntry", example: "codj.preset('factory_acid_squelch')",
  run: (kit, a) => {
    let e = libraryEntry(a.id)
    if (e === null) {
      throw new Error("unknown library id '" + String(a.id) + "' — codj.library()")
    }
    return e
  }
})

defineCommand({
  name: "addTrack", tool: "add_track", readOnly: false,
  description: "Add a track you own. spec: {name, gen, id?, preset?, beat?, sequence?, root?, steps?, notes?, gain?, pan?, params?, bars?}. preset/beat/sequence pull from the library (codj.library). Returns the new id.",
  params: [{ name: "spec", ts: "TrackSpec", schema: { type: "object", properties: { name: { type: "string" }, gen: { type: "string" }, id: { type: "string" }, steps: { description: "'x...x...' or 16 booleans or 'euclid N'" }, notes: { type: "array", items: { type: "object" } }, gain: { type: "number" }, pan: { type: "number" }, params: { type: "object" }, bars: { type: "number" } }, required: ["name", "gen"] }, description: "the track" }, AT_PARAM],
  returns: "WriteResult & { id: string }", example: "codj.addTrack({ name: 'Hat', gen: 'noise_burst', steps: '..x...x...x...x.' })",
  run: (kit, a) => {
    let s = expandSpec(a.spec !== null ? a.spec : {})
    let name = s.name ? String(s.name) : "Track"
    let id = s.id ? String(s.id) : ownId(kit, name)
    let hdr = "track " + name + " id " + id + " gen " + genTokenFor(s.gen ? s.gen : "basic_osc")
    let bars = s.bars !== null ? Math.floor(Number(s.bars)) : 1
    if (bars >= 2) {
      hdr = hdr + " * " + String(bars)
    }
    let lines = [hdr, "  mix gain " + String(s.gain !== null ? Number(s.gain) : 0.75) + " pan " + String(s.pan !== null ? Number(s.pan) : 0)]
    if (s.params) {
      let ks = Object.keys(s.params)
      if (ks.length > 0) {
        lines.push("  gen " + ks.map((k) => k + " " + String(s.params[k])).join(" "))
      }
    }
    if (s.steps !== null) {
      lines.push(stepsLineFor(s.steps))
    }
    if (Array.isArray(s.notes)) {
      let i = 0
      while (i < s.notes.length) {
        let n = noteObj(s.notes[i])
        lines.push("  note " + String(n.pitch) + " " + String(n.startBeat) + " " + String(n.durBeats) + " v " + String(n.vel))
        i = i + 1
      }
    }
    let r = optWrite(kit, lines.join("\n"), a.opts)
    r.id = id
    return r
  }
})

// One spec → the deck lines for one track, or an error string. Shared by addTrack and arrange.
fn trackBlockLines(kit, s, id) {
  if (!s || typeof s !== "object" || Array.isArray(s)) {
    return "a track spec must be an object"
  }
  let name = s.name ? String(s.name) : "Track"
  let hdr = "track " + name + " id " + id + " gen " + genTokenFor(s.gen ? s.gen : "basic_osc")
  let bars = s.bars !== null ? Math.floor(Number(s.bars)) : 1
  if (bars >= 2) {
    hdr = hdr + " * " + String(bars)
  }
  let lines = [hdr]
  let mix = "  mix gain " + String(s.gain !== null ? Number(s.gain) : 0.75) + " pan " + String(s.pan !== null ? Number(s.pan) : 0)
  let ek = ["eq_lo", "eq_mid", "eq_hi"]
  let ei = 0
  while (ei < ek.length) {
    if (s[ek[ei]] !== null) {
      mix = mix + " " + ek[ei] + " " + String(Number(s[ek[ei]]))
    }
    ei = ei + 1
  }
  lines.push(mix)
  if (s.params && typeof s.params === "object") {
    let ks = Object.keys(s.params)
    if (ks.length > 0) {
      lines.push("  gen " + ks.map((k) => k + " " + String(s.params[k])).join(" "))
    }
  }
  if (s.adsr && typeof s.adsr === "object") {
    lines.push("  adsr a " + String(Number(s.adsr.a !== null ? s.adsr.a : 0.01)) + " d " + String(Number(s.adsr.d !== null ? s.adsr.d : 0.1)) + " s " + String(Number(s.adsr.s !== null ? s.adsr.s : 0.6)) + " r " + String(Number(s.adsr.r !== null ? s.adsr.r : 0.2)))
  }
  if (s.fx && typeof s.fx === "object") {
    let fk = Object.keys(s.fx)
    if (fk.length > 0) {
      lines.push("  fx " + fk.map((k) => k + " " + String(s.fx[k])).join(" "))
    }
  }
  if (s.voice && typeof s.voice === "object") {
    let vk = Object.keys(s.voice)
    if (vk.length > 0) {
      lines.push("  voice " + vk.map((k) => k + " " + String(s.voice[k])).join(" "))
    }
  }
  if (s.step_pitch !== null) {
    lines.push("  step_pitch " + String(Math.floor(Number(s.step_pitch))))
  }
  if (s.steps !== null) {
    lines.push(stepsLineFor(s.steps))
  }
  let lanes = [["step_vel", 0], ["step_prob", 1], ["step_ratchet", 1], ["step_nudge", 0]]
  let li = 0
  while (li < lanes.length) {
    let lane = s[lanes[li][0]]
    if (Array.isArray(lane) && lane.length > 0) {
      let row = "  " + lanes[li][0]
      let k = 0
      while (k < 16) {
        let v = k < lane.length && lane[k] !== null ? Number(lane[k]) : lanes[li][1]
        row = row + " " + String(v)
        k = k + 1
      }
      lines.push(row)
    }
    li = li + 1
  }
  if (Array.isArray(s.notes)) {
    let i = 0
    while (i < s.notes.length) {
      let n = noteObj(s.notes[i])
      let row = "  note " + String(n.pitch) + " " + String(n.startBeat) + " " + String(n.durBeats) + " v " + String(n.vel)
      if (s.notes[i].p !== null) {
        row = row + " p " + String(Number(s.notes[i].p))
      }
      if (s.notes[i].r !== null) {
        row = row + " r " + String(Math.floor(Number(s.notes[i].r)))
      }
      if (s.notes[i].n !== null) {
        row = row + " n " + String(Number(s.notes[i].n))
      }
      if (s.notes[i].bar !== null) {
        row = row + " bar " + String(s.notes[i].bar)
      }
      lines.push(row)
      i = i + 1
    }
  }
  return lines
}

// The pattern half of a track block (steps, locks, notes) — what a session clip stores. The instrument,
// mixer and channel strip stay on the track and are ridden live.
fn patternLines(s) {
  let all = trackBlockLines(null, s, "clip")
  if (typeof all === "string") {
    return all
  }
  let out = []
  let i = 0
  while (i < all.length) {
    let t = all[i].trim()
    if (t.indexOf("steps") === 0 || t.indexOf("step_") === 0 || t.indexOf("note ") === 0) {
      out.push(all[i])
    }
    i = i + 1
  }
  return out
}

defineCommand({
  name: "arrange", tool: "arrange", readOnly: false,
  description: "Replace your whole arrangement in one call: removes EVERY track you own, then adds every track in the spec. A second arrange() deletes what the first one built — put the whole set in one call, and use addTrack to add one more part. With opts.deck ('A'..'D') it builds a song on that deck: only your tracks on that deck are replaced, the new tracks are placed there, and the ids are kept in codj.state.decks[deck] (codj.state.ids keeps pointing at the song on the other deck) — this is how you load the next song on a free deck (codj.session().free) while the current one plays. A track: {id?, name, gen, preset?, beat?, sequence?, root?, bars?, gain?, pan?, eq_lo?, eq_mid?, eq_hi?, params?, adsr?: {a,d,s,r}, fx?: {cutoff, res, drive, reverb_send, filter_type}, voice?: {octave, chord, arp, arprate, inversion, strum}, step_pitch?, steps?: 'x..x' | 16 booleans | 'euclid N', step_vel?, step_prob?, step_ratchet?, step_nudge? (16 numbers each), notes?: [{pitch, start, dur, vel, p?, r?, n?, bar?}]}. preset/beat/sequence expand from the library; fields you set win. Notes span the phrase: start runs 0..bars*4 beats. Returns {ids} mapping each spec id to its real track id (also stored on codj.state.ids).",
  params: [{ name: "tracks", ts: "TrackSpec[]", schema: { type: "array", items: { type: "object" } }, description: "the arrangement" }, AT_PARAM],
  returns: "WriteResult & { ids: Record<string, string> }", example: "codj.arrange([{ id: 'kick', name: 'Kick', gen: 'kick_edm', steps: 'x...x...x...x...' }, { id: 'bass', name: 'Bass', gen: 'sub808', bars: 4, notes: [{ pitch: 33, start: 0, dur: 1, vel: 110 }] }])",
  run: (kit, a) => {
    let specs = Array.isArray(a.tracks) ? a.tracks : []
    if (specs.length === 0) {
      throw new Error("arrange needs at least one track")
    }
    let deck = a.opts && a.opts.deck ? deckLetter(a.opts.deck) : null
    let blocks = []
    let ids = {}
    let taken = []
    let me = kit.mirror.me()
    let i = 0
    while (i < specs.length) {
      let s = expandSpec(specs[i])
      let key = s && s.id ? String(s.id) : (s && s.name ? String(s.name) : "track" + String(i + 1))
      // A fresh id every time: the fold applies `remove_track` AFTER the new blocks, so re-adding under an id
      // this same write removes would delete the track it just created.
      let id = ownId(kit, key)
      while (taken.indexOf(id) >= 0) {
        id = id + "_" + String(taken.length)
      }
      taken.push(id)
      let lines = trackBlockLines(kit, s, id)
      if (typeof lines === "string") {
        throw new Error("arrange track " + String(i + 1) + ": " + lines)
      }
      if (deck !== null) {
        lines.splice(1, 0, "  deck " + deck + " slot " + String(deckIndexOf(deck)))
      }
      blocks.push(lines.join("\n"))
      ids[key] = id
      i = i + 1
    }
    let removes = []
    let owned = deck !== null ? ownedOnDeck(kit, deck) : runTool(kit, "list_owned", {})
    let j = 0
    while (j < owned.length) {
      removes.push("remove_track " + owned[j])
      j = j + 1
    }
    let src = removes.concat(blocks).join("\n")
    let pre = coDjGateReport(kit.mirror.project(), src, me.actorId, me.skillIds)
    if (pre.rejected.length > 0) {
      return { sent: false, ok: false, accepted: pre.accepted, rejected: pre.rejected, ids: {} }
    }
    let r = optWrite(kit, src, a.opts)
    r.ids = ids
    r.replaced = owned
    if (r.sent !== false && kit.state && typeof kit.state === "object") {
      let keepIds = false
      if (deck !== null && kit.state.ids && typeof kit.state.ids === "object") {
        let pp = kit.mirror.project()
        let prev = Object.keys(kit.state.ids).map((k) => kit.state.ids[k])
        keepIds = prev.some((id) => {
          let pc = findChannelById(pp, id)
          return pc ? channelDeck(pp, pc) !== deck : false
        })
      }
      if (!keepIds) {
        kit.state.ids = ids
      }
      if (deck !== null) {
        if (!kit.state.decks || typeof kit.state.decks !== "object") {
          kit.state.decks = {}
        }
        kit.state.decks[deck] = ids
      }
    }
    return r
  }
})

fn deckIndexOf(d) {
  return d === "B" ? 1 : (d === "C" ? 2 : (d === "D" ? 3 : 0))
}

fn ownedOnDeck(kit, deck) {
  let p = kit.mirror.project()
  let me = kit.mirror.me().actorId
  return p.channels.filter((ch) => ownerOf(p, ch.id) === me && channelDeck(p, ch) === deck).map((ch) => String(ch.id))
}

defineCommand({
  name: "setSteps", tool: "set_steps", readOnly: false,
  description: "Replace a track's 16-step pattern: 'x...x...x...x...' (spaces ok), 16 booleans, or 'euclid N'. A track plays either steps or notes, so this clears any piano notes.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, { name: "pattern", ts: "string | boolean[]", schema: { description: "pattern" }, description: "the pattern" }, AT_PARAM],
  returns: "WriteResult", example: "codj.setSteps('me_hat', 'x.x.x.x.x.x.x.xx')",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let pp = parsePattern(a.pattern)
    let src = pp.euclid !== null ? fragmentForEdit(kit.mirror.project(), "track/" + ch.id + "/mix/gain", ch.gain !== null ? ch.gain : 0.85) + "\n" + stepsLineFor(a.pattern) : fragmentForEdit(kit.mirror.project(), "track/" + ch.id + "/steps", pp.steps)
    if (Array.isArray(ch.pianoNotes) && ch.pianoNotes.length > 0) {
      let parts = src.split("\n")
      parts.splice(1, 0, "  notes_clear")
      src = parts.join("\n")
    }
    return optWrite(kit, src, a.opts)
  }
})

defineCommand({
  name: "setNotes", tool: "set_notes", readOnly: false,
  description: "Replace a track's piano notes: [{pitch (MIDI), start (beats), dur (beats), vel (0-127)}]. [] clears.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, { name: "notes", ts: "Note[]", schema: { type: "array", items: { type: "object", properties: { pitch: { type: "number" }, start: { type: "number" }, dur: { type: "number" }, vel: { type: "number" } } } }, description: "notes" }, AT_PARAM],
  returns: "WriteResult", example: "codj.setNotes('me_bass', [{ pitch: 36, start: 0, dur: 0.5, vel: 110 }])",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let ns = Array.isArray(a.notes) ? a.notes.map(noteObj) : []
    return optWrite(kit, fragmentForEdit(kit.mirror.project(), "track/" + ch.id + "/notes", ns), a.opts)
  }
})

defineCommand({
  name: "mix", tool: "set_mix", readOnly: false,
  description: "Set a track's mixer fields: {gain 0-1, pan -1..1, mute, solo, eq_lo/eq_mid/eq_hi dB}. Unset fields keep their value.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, { name: "mix", ts: "MixSpec", schema: { type: "object" }, description: "fields to change" }, AT_PARAM],
  returns: "WriteResult", example: "codj.mix('me_hat', { gain: 0.6, pan: -0.3 })",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let m = a.mix !== null ? a.mix : {}
    let clone = deepClone(ch)
    let keys = Object.keys(m)
    let i = 0
    let line = ""
    while (i < keys.length) {
      let k = keys[i]
      let field = k === "eq_lo" ? "eqLo" : (k === "eq_mid" ? "eqMid" : (k === "eq_hi" ? "eqHi" : k))
      clone[field] = m[k]
      i = i + 1
    }
    let tmp = { channels: [clone] }
    line = fragmentForEdit(tmp, "track/" + ch.id + "/mix/gain", clone.gain !== null ? clone.gain : 0.85)
    return optWrite(kit, line, a.opts)
  }
})

// The deck text for one track field edit. A macro voice (kick_edm, bass_reese, …) keeps its knobs on the track
// header (`gen kick_edm pitch 120 decay 0.6`), so its 'gen/<knob>' re-emits the header with every knob it has.
fn paramEditSource(p, ch, addr, value) {
  let parts = String(addr).split("/")
  if (ch.macroName && parts[0] === "gen" && parts.length === 2) {
    let clone = deepClone(ch)
    if (!clone.macroParams) {
      clone.macroParams = {}
    }
    clone.macroParams[parts[1]] = value
    return fragmentForEdit({ channels: [clone] }, "track/" + ch.id + "/name", clone.name)
  }
  return fragmentForEdit(p, "track/" + ch.id + "/" + String(addr), value)
}

defineCommand({
  name: "set", tool: "set_param", readOnly: false,
  description: "Set one addressed field on a track. Channel strip: 'fx/cutoff' (Hz) | 'fx/res' (0..1) | 'fx/drive' | 'fx/reverb' | 'fx/filter_type' (lowpass|highpass|bandpass|notch) | 'fx/lfo_rate' | 'fx/lfo_depth'. Instrument: 'gen/<knob>' — knob names are the keys of codj.preset(id).params, different for every generator. Also 'voice/arp' | 'voice/chord' | 'voice/octave' | 'adsr' ({a,d,s,r}) | 'name' | 'gen_type'.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, { name: "address", ts: "string", schema: { type: "string" }, description: "field address" }, { name: "value", ts: "unknown", schema: {}, description: "new value" }, AT_PARAM],
  returns: "WriteResult", example: "codj.set('me_bass', 'fx/cutoff', 900)",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let src = paramEditSource(kit.mirror.project(), ch, a.address, a.value)
    if (src.length === 0) {
      throw new Error("unknown address '" + String(a.address) + "'")
    }
    return optWrite(kit, src, a.opts)
  }
})

// The generator id behind a deck `gen` token ('sub808' → 'sub808', 'kick_edm' → 'drumSynth', …), or null.
fn generatorIdForToken(tok) {
  let cat = generatorCatalog()
  let i = 0
  while (i < cat.length) {
    if (generatorIdToTpl(cat[i].id) === String(tok) || cat[i].id === String(tok)) {
      return cat[i].id
    }
    i = i + 1
  }
  return null
}

let WAVES = ["sine", "triangle", "sawtooth", "square"]

// A knob's useful range, from its name and its default (the instrument panels use the same conventions:
// times in seconds, 0..1 amounts, Hz for filters, semitones for pitch).
fn knobRange(key, value, def) {
  let k = String(key).toLowerCase()
  let v = typeof def === "number" ? def : (typeof value === "number" ? value : 0)
  if (k.indexOf("cutoff") >= 0 || k.indexOf("hp") >= 0 || k.indexOf("highpass") >= 0 || k.indexOf("lowpass") >= 0 || k.indexOf("freq") >= 0 || k === "body" || v >= 100) {
    return { min: 20, max: 18000, unit: "Hz" }
  }
  if (k.indexOf("attack") >= 0 || k.indexOf("release") >= 0 || k.indexOf("decay") >= 0 || k.indexOf("time") >= 0 || k.indexOf("dec") === k.length - 3) {
    return { min: 0.001, max: k.indexOf("release") >= 0 ? 4 : 2, unit: "s" }
  }
  if (k.indexOf("detune") >= 0 || k.indexOf("cent") >= 0) {
    return { min: 0, max: 50, unit: "cents" }
  }
  if (k.indexOf("pitch") >= 0 || k.indexOf("semi") >= 0 || k.indexOf("drop") >= 0 || k.indexOf("env") >= 0) {
    return { min: v < 0 ? -48 : 0, max: 60, unit: "st" }
  }
  if (k.indexOf("ratio") >= 0 || k.indexOf("partial") >= 0) {
    return { min: 0.25, max: 16, unit: "x" }
  }
  if (k.indexOf("index") >= 0) {
    return { min: 0, max: 48, unit: "" }
  }
  if (k.indexOf("rate") >= 0 || k.indexOf("hz") >= 0) {
    return { min: 0, max: 20, unit: "Hz" }
  }
  if (v > 1) {
    return { min: 0, max: Math.max(1, Math.ceil(v * 4)), unit: "" }
  }
  return { min: 0, max: 1, unit: "" }
}

defineCommand({
  name: "knobs", tool: "get_knobs", readOnly: true,
  description: "Every knob on a live track, so you can play the instrument: {gen, knobs: [{knob, value, base (the instrument's default), min, max, unit, options?}], fx: {cutoff, res, drive, reverb, filter_type}, adsr}. Each knob is codj.set(trackId, 'gen/' + knob, value) (or codj.ride to sweep it). Knobs change the sound in real time while the pattern keeps playing — a filter opening, a decay getting longer, an FM index rising.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }],
  returns: "Knobs", example: "codj.knobs(codj.state.ids.bass).knobs.map(k => k.knob)",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let fx = { cutoff: ch.filterCutoff, res: ch.res, drive: ch.drive, reverb: ch.reverbSend, filter_type: ch.filterType }
    if (ch.macroName) {
      let p = kit.mirror.project()
      let ctl = macroParamControls(ch.macroName, ch.macroParams, p.macros ? p.macros : {})
      return {
        trackId: String(ch.id),
        gen: String(ch.macroName),
        knobs: ctl.map((c) => ({ knob: c.key, value: c.value, min: c.min, max: c.max, label: c.label })),
        fx: fx,
        adsr: null
      }
    }
    let gid = ch.generatorId ? String(ch.generatorId) : "basicOsc"
    let defs = defaultParamsForGeneratorId(gid)
    if (!defs) {
      defs = {}
    }
    let cur = ch.generatorParams ? ch.generatorParams : {}
    let keys = Object.keys(defs)
    let ck = Object.keys(cur)
    let i = 0
    while (i < ck.length) {
      if (keys.indexOf(ck[i]) < 0) {
        keys.push(ck[i])
      }
      i = i + 1
    }
    let knobs = []
    let j = 0
    while (j < keys.length) {
      let key = keys[j]
      let value = cur[key] !== null && cur[key] !== undefined ? cur[key] : defs[key]
      let d = defs[key] !== null && defs[key] !== undefined ? defs[key] : value
      if (typeof value === "number" || typeof value === "string" || typeof value === "boolean") {
        let row = { knob: camelToSnake(key), value: value, base: d }
        if (typeof value === "number") {
          let r = knobRange(key, value, d)
          row.min = r.min
          row.max = r.max
          row.unit = r.unit
        } else if (typeof value === "string" && WAVES.indexOf(value) >= 0) {
          row.options = WAVES.slice()
        }
        knobs.push(row)
      }
      j = j + 1
    }
    return {
      trackId: String(ch.id),
      gen: ch.macroName ? String(ch.macroName) : generatorIdToTpl(gid),
      knobs: knobs,
      fx: fx,
      adsr: cur.attack !== undefined ? { a: cur.attack, d: cur.decay, s: cur.sustain, r: cur.release } : null
    }
  }
})

defineCommand({
  name: "swap", tool: "swap_instrument", readOnly: false,
  description: "Change the instrument a track plays, keeping its pattern, notes, mix and channel FX — the part carries on with a new sound (a pluck becomes a pad, an 808 becomes a reese). instrument: a gen from codj.instruments() ('pad', 'sub808', 'acid', …) or a library instrument id from codj.library('instrument') — a preset brings its knob settings. params overrides knobs after the swap.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, { name: "instrument", ts: "string", schema: { type: "string" }, description: "gen token or library instrument id" }, { name: "params", ts: "Record<string, number | string>", schema: { type: "object" }, description: "knob overrides", optional: true }, AT_PARAM],
  returns: "WriteResult & { gen: string }", example: "codj.swap(codj.state.ids.hook, 'factory_acid_squelch')",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let want = String(a.instrument)
    let preset = libraryEntry(want)
    let gen = want
    let knobs = {}
    if (preset !== null && preset.kind === "instrument") {
      gen = String(preset.gen)
      knobs = preset.params ? deepClone(preset.params) : {}
    } else if (generatorIdForToken(want) === null && macroCatalog().filter((m) => m.name === want).length === 0) {
      throw new Error("unknown instrument '" + want + "' — codj.instruments() for gens, codj.library('instrument') for presets")
    }
    if (a.params) {
      let pk = Object.keys(a.params)
      let i = 0
      while (i < pk.length) {
        knobs[pk[i]] = a.params[pk[i]]
        i = i + 1
      }
    }
    let lines = ["track " + String(ch.name) + " id " + String(ch.id) + " gen " + gen]
    let kk = Object.keys(knobs)
    let j = 0
    while (j < kk.length) {
      let v = knobs[kk[j]]
      if (typeof v === "number" || typeof v === "string") {
        lines.push("  gen " + camelToSnake(kk[j]) + " " + String(v))
      }
      j = j + 1
    }
    let res = optWrite(kit, lines.join("\n"), a.opts)
    res.gen = gen
    return res
  }
})

defineCommand({
  name: "ride", tool: "ride_param", readOnly: false,
  description: "Sweep one track field from where it is to `to` over the next bars, the way a hand rides a knob: a filter opening into a drop, a decay stretching across a breakdown, an FM index climbing, reverb swelling. address is any codj.set address ('gen/<knob>' from codj.knobs, 'fx/cutoff', 'fx/reverb', 'fx/drive', 'mix/gain', …). opts: {bars (default 4), from?, steps (moves per bar, default 2; at most 8 moves per ride), curve: 'linear' | 'exp' (exp suits Hz)}. While stopped it jumps straight to `to`. One ride at a time per track — each move re-applies the track for everyone listening.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, { name: "address", ts: "string", schema: { type: "string" }, description: "field address" }, { name: "to", ts: "number", schema: { type: "number" }, description: "target value" }, { name: "opts", ts: "{ bars?: number; from?: number; steps?: number; curve?: 'linear' | 'exp' }", schema: { type: "object" }, description: "shape", optional: true }],
  returns: "{ writes: number; from: number; to: number; endsAt: number | null }", example: "codj.ride(codj.state.ids.bass, 'fx/cutoff', 6000, { bars: 8, curve: 'exp' })",
  run: (kit, a) => {
    let ch = requireTrack(kit, a.trackId)
    let o = a.opts ? a.opts : {}
    let addr = String(a.address)
    let to = Number(a.to)
    if (to !== to) {
      throw new Error("ride needs a numeric `to`")
    }
    let from = numOr(o.from, null)
    if (from === null) {
      let parts = addr.split("/")
      let key = parts.length > 1 ? parts[1] : parts[0]
      let camel = snakeToCamel(key)
      let gp = ch.generatorParams ? ch.generatorParams : {}
      let fxMap = { cutoff: ch.filterCutoff, res: ch.res, drive: ch.drive, reverb: ch.reverbSend, reverb_send: ch.reverbSend, gain: ch.gain, pan: ch.pan }
      let cur = parts[0] === "gen" ? gp[camel] : fxMap[key]
      if (parts[0] === "gen" && ch.macroName) {
        let mc = macroParamControls(ch.macroName, ch.macroParams, {}).filter((c) => c.key === key)[0]
        cur = mc ? mc.value : null
      } else if (parts[0] === "gen" && (cur === undefined || cur === null)) {
        let defs = defaultParamsForGeneratorId(ch.generatorId ? String(ch.generatorId) : "basicOsc")
        cur = defs ? defs[camel] : null
      }
      from = typeof cur === "number" ? cur : to
    }
    let clock = kit.mirror.clock()
    if (!clock.playing) {
      let src = paramEditSource(kit.mirror.project(), ch, addr, to)
      if (src.length === 0) {
        throw new Error("unknown address '" + addr + "'")
      }
      optWrite(kit, src, { at: "now" })
      return { writes: 1, from: from, to: to, endsAt: null }
    }
    let bars = Math.max(1, Math.min(32, numOr(o.bars, 4)))
    let per = Math.max(1, Math.min(4, Math.floor(numOr(o.steps, 2))))
    // Every write re-applies the track on every listener, so a sweep is at most 8 moves.
    let n = Math.max(1, Math.min(8, Math.floor(bars * per)))
    let stride = Math.max(4, Math.floor((bars * 16) / n))
    let start = (Math.floor(clock.perfStep / stride) + 1) * stride
    let exp = o.curve === "exp" && from > 0 && to > 0
    let k = 1
    let last = start
    let prev = null
    while (k <= n) {
      let t = k / n
      let v = exp ? from * Math.pow(to / from, t) : from + (to - from) * t
      let rv = Math.abs(v) >= 100 ? Math.round(v) : Math.round(v * 1000) / 1000
      if (rv !== prev) {
        let src2 = paramEditSource(kit.mirror.project(), ch, addr, rv)
        if (src2.length === 0) {
          throw new Error("unknown address '" + addr + "'")
        }
        last = start + (k - 1) * stride
        optWrite(kit, src2, { at: last })
        prev = rv
      }
      k = k + 1
    }
    return { writes: n, from: from, to: to, endsAt: last }
  }
})

defineCommand({
  name: "setGlobal", tool: "set_global", readOnly: false,
  description: "Master-scope edit (needs the master_mixer skill, i.e. a host): 'bpm' | 'swing' | 'scale' ({root 0-11, mode}) | 'xfade' ({x, y} — prefer codj.crossfade) | 'master/eq_lo' | 'master/eq_mid' | 'master/eq_hi' | 'master/comp' | 'master/reverb' | 'actor/<lane>/gain' | 'auto/<trackId>/<knob>' (16 step values).",
  params: [{ name: "address", ts: "string", schema: { type: "string" }, description: "global address" }, { name: "value", ts: "unknown", schema: {}, description: "new value" }, AT_PARAM],
  returns: "WriteResult", example: "codj.setGlobal('bpm', 128)",
  run: (kit, a) => {
    let src = fragmentForEdit(kit.mirror.project(), String(a.address), a.value)
    if (src.length === 0) {
      throw new Error("unknown address '" + String(a.address) + "'")
    }
    return optWrite(kit, src, a.opts)
  }
})

defineCommand({
  name: "removeTrack", tool: "remove_track", readOnly: false,
  description: "Remove one track. A host may remove any track, including the page-load starter (c0 Kick, c1 Snare, c2 HiHat, c3 Bass). A client may remove only a track it owns.",
  params: [{ name: "trackId", ts: "string", schema: { type: "string" }, description: "track id" }, AT_PARAM],
  returns: "WriteResult", example: "codj.removeTrack('c0')",
  run: (kit, a) => optWrite(kit, "remove_track " + String(a.trackId), a.opts)
