    { id: "edm-pluck", kind: "sequence", role: "lead", tags: ["edm"], name: "Pluck hook", about: "Two-bar trance pluck. Short notes, a rest, then the same shape up a fifth. Wants factory_edm_pluck.", bars: 2, defaultRoot: 76, events: [{ deg: 0, start: 0, dur: 0.2, vel: 104 }, { deg: 3, start: 0.5, dur: 0.2, vel: 90 }, { deg: 7, start: 1, dur: 0.35, vel: 110 }, { deg: 12, start: 2, dur: 0.25, vel: 100 }, { deg: 7, start: 4, dur: 0.2, vel: 104 }, { deg: 10, start: 4.5, dur: 0.2, vel: 90 }, { deg: 14, start: 5, dur: 0.5, vel: 114 }, { deg: 12, start: 6.5, dur: 0.7, vel: 108 }] },
    { id: "edm-rise", kind: "sequence", role: "lead", tags: ["edm"], name: "Minor rise", about: "Two bars climbing the minor scale. A build line — mute it on the drop or hand it to the supersaw.", bars: 2, defaultRoot: 60, events: [{ deg: 0, start: 0, dur: 0.4, vel: 80 }, { deg: 2, start: 1, dur: 0.4, vel: 84 }, { deg: 3, start: 2, dur: 0.4, vel: 90 }, { deg: 5, start: 3, dur: 0.4, vel: 96 }, { deg: 7, start: 4, dur: 0.4, vel: 102 }, { deg: 8, start: 5, dur: 0.4, vel: 106 }, { deg: 10, start: 6, dur: 0.4, vel: 112 }, { deg: 12, start: 7, dur: 0.8, vel: 120 }] }
  ]
}

fn kits() {
  return [
    { id: "house-loop", kind: "kit", role: "house", tags: ["house"], name: "House loop", about: "126-feel house: four-on-the-floor, offbeat hats, backbeat clap, root-fifth sub, minor-axis pad. arrange(preset('house-loop').parts), then change the root.", parts: [
      { id: "kick", name: "Kick", gen: "kick_edm", beat: "four-on-the-floor", gain: 0.9 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.04, tone: 0.85, pitch_follow: 0.1 }, beat: "offbeat-hat", gain: 0.42, pan: 0.28 },
      { id: "clap", name: "Clap", preset: "factory_clap_tight", beat: "backbeat-clap", gain: 0.66 },
      { id: "bass", name: "Bass", preset: "factory_808_long", sequence: "root-fifth", root: 33, gain: 0.8 },
      { id: "pad", name: "Pad", preset: "factory_pad_warm", sequence: "axis-min7", root: 57, gain: 0.3 }
    ] },
    { id: "halftime-kit", kind: "kit", role: "halftime", tags: ["edm"], name: "Halftime kit", about: "Halftime kick, trap hats, a break snare and a two-bar minor bass. Darker and slower-feeling than house-loop at the same bpm.", parts: [
      { id: "kick", name: "Kick", gen: "kick_deep", beat: "halftime-kick", gain: 0.9 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.03, tone: 0.8, pitch_follow: 0.05 }, beat: "trap-hat", gain: 0.4, pan: 0.2 },
      { id: "snare", name: "Snare", preset: "factory_drum_boombap", beat: "break-snare", gain: 0.72 },
      { id: "bass", name: "Bass", preset: "factory_reese_minimal", sequence: "minor-walk", root: 31, gain: 0.74 }
    ] },
    { id: "acid-bar", kind: "kit", role: "acid", tags: ["acid"], name: "Acid bar", about: "303 sixteenths over a dry kick and sixteenth hats. Move the cutoff from onBar; a static acid line is dead.", parts: [
      { id: "kick", name: "Kick", gen: "kick_edm", beat: "four-on-the-floor", gain: 0.88 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.025, tone: 0.9, pitch_follow: 0 }, beat: "sixteenth-hat", gain: 0.36, pan: -0.2 },
      { id: "acid", name: "Acid", preset: "factory_acid_squelch", sequence: "acid-16", root: 36, gain: 0.7 }
    ] },
    { id: "lofi-beat", kind: "kit", role: "lofi", tags: ["lofi"], name: "Lofi beat", about: "Dusty kick, swung hats, a late snare, a soft sub and min7 Rhodes changes. About 80–90 bpm. Change the chord root together.", parts: [
      { id: "kick", name: "Kick", preset: "factory_lofi_kick", beat: "lofi-kick", gain: 0.84 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.002, decay: 0.05, tone: 0.45, pitch_follow: 0.05 }, beat: "lofi-hat", gain: 0.3, pan: 0.32 },
      { id: "snare", name: "Snare", preset: "factory_lofi_snare", beat: "lofi-snare", gain: 0.58 },
      { id: "bass", name: "Bass", preset: "factory_lofi_sub", sequence: "lofi-bass", root: 41, gain: 0.68 },
      { id: "keys", name: "Keys", preset: "factory_lofi_rhodes", sequence: "lofi-chords", root: 60, gain: 0.4 }
    ] },
    { id: "house-deep", kind: "kit", role: "house", tags: ["house"], name: "Deep house", about: "Longer bass, an open hat, a warm pad on the minor axis, and a short stab. Slower and wider than house-loop.", parts: [
      { id: "kick", name: "Kick", preset: "factory_house_kick", beat: "four-on-the-floor", gain: 0.9 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.035, tone: 0.8, pitch_follow: 0.08 }, beat: "offbeat-hat", gain: 0.38, pan: 0.25 },
      { id: "open", name: "Open", gen: "noise_burst", params: { attack: 0.002, decay: 0.18, tone: 0.7, pitch_follow: 0.15 }, beat: "house-open-hat", gain: 0.28, pan: -0.22 },
      { id: "bass", name: "Bass", preset: "factory_house_bass", sequence: "house-deep-bass", root: 31, gain: 0.76 },
      { id: "pad", name: "Pad", preset: "factory_house_pad", sequence: "axis-min7", root: 57, gain: 0.28 },
      { id: "stab", name: "Stab", preset: "factory_house_stab", sequence: "offbeat-stab", root: 60, gain: 0.38 }
    ] },
    { id: "house-garage", kind: "kit", role: "house", tags: ["house"], name: "UK garage", about: "Skippy kick and hats, a clap on 2 and 4, and a pumping bass. Around 132 bpm.", parts: [
      { id: "kick", name: "Kick", preset: "factory_house_kick", beat: "garage-kick", gain: 0.88 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.03, tone: 0.88, pitch_follow: 0.1 }, beat: "garage-hat", gain: 0.36, pan: 0.3 },
      { id: "clap", name: "Clap", preset: "factory_house_clap", beat: "backbeat-clap", gain: 0.62 },
      { id: "bass", name: "Bass", preset: "factory_house_bass", sequence: "house-pump-bass", root: 35, gain: 0.78 }
    ] },
    { id: "acid-scream", kind: "kit", role: "acid", tags: ["acid"], name: "Acid scream", about: "A two-bar octave 303 over a dry kick and sixteenth hats. Ride gen/cutoff on the acid track or the line sits still.", parts: [
      { id: "kick", name: "Kick", preset: "factory_house_kick", beat: "four-on-the-floor", gain: 0.86 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.022, tone: 0.92, pitch_follow: 0 }, beat: "sixteenth-hat", gain: 0.32, pan: -0.18 },
      { id: "acid", name: "Acid", preset: "factory_acid_scream", sequence: "acid-octave", root: 36, gain: 0.68 }
    ] },
    { id: "edm-drop", kind: "kit", role: "edm", tags: ["edm"], name: "EDM drop", about: "Drop kick, sixteenth hats, clap, octave sub, a supersaw on the minor axis, and a pluck hook. Open the filter across the 8 bars before you call it finished.", parts: [
      { id: "kick", name: "Kick", preset: "factory_edm_kick", beat: "four-on-the-floor", gain: 0.92 },
      { id: "hat", name: "Hat", gen: "noise_burst", params: { attack: 0.001, decay: 0.028, tone: 0.9, pitch_follow: 0.05 }, beat: "sixteenth-hat", gain: 0.34, pan: 0.22 },
      { id: "clap", name: "Clap", preset: "factory_house_clap", beat: "backbeat-clap", gain: 0.64 },
      { id: "bass", name: "Bass", preset: "factory_edm_sub", sequence: "edm-octave-bass", root: 33, gain: 0.78 },
      { id: "saw", name: "Saw", preset: "factory_edm_supersaw", sequence: "axis-min7", root: 57, gain: 0.32 },
      { id: "pluck", name: "Pluck", preset: "factory_edm_pluck", sequence: "edm-pluck", root: 76, gain: 0.4 }
    ] }
  ]
}

fn catalog() {
  if (cached !== null) {
    return cached
  }
  let all = []
  let factory = generatorFactoryPresets()
  let i = 0
  while (i < factory.length) {
    let p = factory[i]
    all.push({ id: String(p.presetId), kind: "instrument", role: generatorIdToTpl(p.generatorId), tags: tagsFor(p.presetId, p.genre ? [p.genre] : null), name: String(p.name), about: String(p.name) + " — factory preset, gen " + generatorIdToTpl(p.generatorId) + ".", gen: generatorIdToTpl(p.generatorId), params: snakeParams(p.params) })
    i = i + 1
  }
  let groups = [beats(), sequences(), kits(), packInstruments(), packBeats(), packSequences(), packKits()]
  let g = 0
  while (g < groups.length) {
    let j = 0
    while (j < groups[g].length) {
      let row = groups[g][j]
      if (!row.tags) {
        row.tags = tagsFor(row.id, null)
      }
      all.push(row)
      j = j + 1
    }
    g = g + 1
  }
  cached = all
  return all
}

fn clone(v) {
  return JSON.parse(JSON.stringify(v))
}

/** Index rows: { id, kind, role, name, about }. kind filters to instrument | beat | sequence | kit. */
export fn libraryIndex(kind) {
  let all = catalog()
  let out = []
  let i = 0
  while (i < all.length) {
    let e = all[i]
    if (kind === null || typeof kind === "undefined" || kind === "" || e.kind === kind) {
      out.push({ id: e.id, kind: e.kind, role: e.role, tags: e.tags ? e.tags : [], name: e.name, about: e.about })
    }
    i = i + 1
  }
  return out
}

/** One library entry by id, or null. */
export fn libraryEntry(id) {
  let want = String(id)
  let all = catalog()
  let i = 0
  while (i < all.length) {
    if (all[i].id === want) {
      return clone(all[i])
    }
    i = i + 1
  }
  return null
}

fn overlay(base, extra) {
  let out = base ? clone(base) : {}
  if (!extra) {
    return out
  }
  let ks = Object.keys(extra)
  let i = 0
  while (i < ks.length) {
    out[ks[i]] = extra[ks[i]]
    i = i + 1
  }
  return out
}

/**
 * A track spec with `preset` / `beat` / `sequence` filled in from the library. Explicit fields on the spec
 * win. Throws on an unknown id, so a script finds out immediately.
 */
export fn expandSpec(spec) {
  let s = spec ? clone(spec) : {}
  if (s.preset !== null && s.preset !== undefined) {
    let e = libraryEntry(s.preset)
    if (e === null || e.kind !== "instrument") {
      throw new Error("unknown instrument preset '" + String(s.preset) + "' — codj.library('instrument')")
    }
    if (s.gen === null || s.gen === undefined) {
      s.gen = e.gen
    }
    s.params = overlay(e.params, s.params)
  }
  if (s.beat !== null && s.beat !== undefined) {
    let b = libraryEntry(s.beat)
    if (b === null || b.kind !== "beat") {
      throw new Error("unknown beat '" + String(s.beat) + "' — codj.library('beat')")
    }
    let lanes = ["steps", "step_vel", "step_prob", "step_ratchet", "step_nudge", "step_pitch"]
    let i = 0
    while (i < lanes.length) {
      if ((s[lanes[i]] === null || s[lanes[i]] === undefined) && b[lanes[i]] !== null && b[lanes[i]] !== undefined) {
        s[lanes[i]] = b[lanes[i]]
      }
      i = i + 1
    }
  }
  if (s.sequence !== null && s.sequence !== undefined) {
    let q = libraryEntry(s.sequence)
    if (q === null || q.kind !== "sequence") {
      throw new Error("unknown sequence '" + String(s.sequence) + "' — codj.library('sequence')")
    }
    if (s.bars === null || s.bars === undefined) {
      s.bars = q.bars
    }
    if (s.notes === null || s.notes === undefined) {
      let root = s.root !== null && s.root !== undefined ? Math.floor(Number(s.root)) : q.defaultRoot
      let notes = []
      let i = 0
      while (i < q.events.length) {
        let ev = q.events[i]
        notes.push({ pitch: root + ev.deg, start: ev.start, dur: ev.dur, vel: ev.vel })
        i = i + 1
      }
      s.notes = notes
    }
    if (q.chord && (s.voice === null || s.voice === undefined)) {
      s.voice = { chord: q.chord }
      if (q.octave !== null && q.octave !== undefined) {
        s.voice.octave = q.octave
      }
    }
  }
  return s
}

fn stepChar(s) {
  return s === true || s === 1 || (s && s.on === true)
}

fn stepsDeck(steps) {
  if (typeof steps === "string") {
    return "  steps " + steps
  }
  let o = "  steps"
  let i = 0
  let n = steps ? steps.length : 0
  while (i < n) {
    o = o + (stepChar(steps[i]) ? " x" : " .")
    i = i + 1
  }
  return o
}

fn laneDeck(name, arr) {
  if (!arr || arr.length === 0) {
    return ""
  }
  let o = "  " + name
  let i = 0
  while (i < arr.length) {
    o = o + " " + String(arr[i])
    i = i + 1
  }
  return o
}

fn paramsDeck(params) {
  if (!params) {
    return ""
  }
  let ks = Object.keys(params)
  if (ks.length === 0) {
    return ""
  }
  let o = "  gen"
  let i = 0
  while (i < ks.length) {
    o = o + " " + ks[i] + " " + String(params[ks[i]])
    i = i + 1
  }
  return o
}

fn notesDeck(notes) {
  let lines = []
  if (!notes) {
    return lines
  }
  let i = 0
  while (i < notes.length) {
    let n = notes[i]
    lines.push("  note " + String(n.pitch) + " " + String(n.start) + " " + String(n.dur) + " v " + String(n.vel))
    i = i + 1
  }
  return lines
}

fn voiceDeck(voice) {
  if (!voice) {
    return ""
  }
  let o = "  voice"
  if (voice.octave !== null && voice.octave !== undefined) {
    o = o + " octave " + String(voice.octave)
  }
  if (voice.chord) {
    o = o + " chord " + String(voice.chord)
  }
  return o === "  voice" ? "" : o
}

fn pushLine(lines, line) {
  if (line && line.length > 0) {
    lines.push(line)
  }
}

fn genOfChannel(ch) {
  if (ch && ch.macroName) {
    return String(ch.macroName)
  }
  return generatorIdToTpl(ch && ch.generatorId ? ch.generatorId : "basicOsc")
}

/** Deck text that loads one library entry onto an existing channel. Instrument swaps the sound and keeps the
 *  pattern. A beat replaces the steps. A sequence replaces the notes. */
export fn channelLoadSource(ch, entry, root) {
  let kind = entry.kind
  let gen = kind === "instrument" ? entry.gen : genOfChannel(ch)
  let name = ch && ch.name ? String(ch.name) : "Track"
  let id = ch && ch.id ? String(ch.id) : "c0"
  let lines = []
  if (kind === "instrument") {
    lines.push("track " + name + " id " + id + " gen " + gen)
    pushLine(lines, paramsDeck(entry.params))
    return lines.join("\n")
  }
  if (kind === "beat") {
    let s = expandSpec({ beat: entry.id })
    lines.push("track " + name + " id " + id + " gen " + gen)
    pushLine(lines, stepsDeck(s.steps))
    pushLine(lines, laneDeck("step_vel", s.step_vel))
    pushLine(lines, laneDeck("step_prob", s.step_prob))
    pushLine(lines, laneDeck("step_ratchet", s.step_ratchet))
    pushLine(lines, laneDeck("step_nudge", s.step_nudge))
    return lines.join("\n")
  }
  let spec = { sequence: entry.id }
  if (root !== null && root !== undefined && root === root) {
    spec.root = root
  }
  let s = expandSpec(spec)
  let hdr = "track " + name + " id " + id + " gen " + gen
  if (s.bars !== null && s.bars >= 2) {
    hdr = hdr + " * " + String(Math.floor(Number(s.bars)))
  }
  lines.push(hdr)
  pushLine(lines, voiceDeck(s.voice))
  let notes = notesDeck(s.notes)
  let i = 0
  while (i < notes.length) {
    lines.push(notes[i])
    i = i + 1
  }
  return lines.join("\n")
}

fn trackFromSpec(s, id, deck) {
  let gen = s.gen ? s.gen : "basic_osc"
  let name = s.name ? String(s.name) : "Track"
  let hdr = "track " + name + " id " + id + " gen " + gen
  if (s.bars !== null && s.bars >= 2) {
    hdr = hdr + " * " + String(Math.floor(Number(s.bars)))
  }
  let lines = [hdr]
  let mix = "  mix gain " + String(s.gain !== null && s.gain !== undefined ? Number(s.gain) : 0.75) + " pan " + String(s.pan !== null && s.pan !== undefined ? Number(s.pan) : 0)
  lines.push(mix)
  pushLine(lines, paramsDeck(s.params))
  pushLine(lines, voiceDeck(s.voice))
  if (s.steps) {
    pushLine(lines, stepsDeck(s.steps))
    pushLine(lines, laneDeck("step_vel", s.step_vel))
    pushLine(lines, laneDeck("step_prob", s.step_prob))
    pushLine(lines, laneDeck("step_ratchet", s.step_ratchet))
    pushLine(lines, laneDeck("step_nudge", s.step_nudge))
  }
  let notes = notesDeck(s.notes)
  let i = 0
  while (i < notes.length) {
    lines.push(notes[i])
    i = i + 1
  }
  if (deck) {
    lines.push(deckPlaceLine(deck))
  }
  return lines.join("\n")
}

/** `deck B slot 1` — the slot is the deck index. Slot 0 is always deck A, so a letter alone is not enough. */
export fn deckPlaceLine(deck) {
  let letter = String(deck)
  let slot = 0
  if (letter === "B") {
    slot = 1
  } else if (letter === "C") {
    slot = 2
  } else if (letter === "D") {
    slot = 3
  }
  return "  deck " + letter + " slot " + String(slot)
}

/** Deck text for a kit: one new track per part. `ids` is parallel to parts. `deck` (A–D) places them when
 *  the session is solo; pass null in a live room so ownership routes the tracks. */
export fn kitLoadSource(entry, ids, deck) {
  let parts = entry.parts ? entry.parts : []
  let blocks = []
  let i = 0
  while (i < parts.length) {
    let s = expandSpec(parts[i])
    let id = ids && i < ids.length ? ids[i] : ("kit_" + String(i))
    blocks.push(trackFromSpec(s, id, deck))
    i = i + 1
  }
  return blocks.join("\n")
}
