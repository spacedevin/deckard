// The co-DJ reference library. Agents start from these instead of inventing a kick pattern or a pad timbre
// from nothing: factory instrument presets (the same ones the picker saves), named drum beats, scale-degree
// sequences, and a few whole kits. codj.library() is the index; codj.preset(id) is one entry; arrange() and
// clip() expand `preset` / `beat` / `sequence` on a track spec into gen, params, steps and notes.

import { generatorFactoryPresets } from '../model/GeneratorPresets.tish'
import { generatorIdToTpl } from '../deckfile/Emit.tish'
import { packInstruments, packBeats, packSequences, packKits } from './LibraryPacks.tish'

fn snake(key) {
  let s = String(key)
  let out = ""
  let i = 0
  while (i < s.length) {
    let c = s.charAt(i)
    let upper = c >= "A" && c <= "Z"
    out = out + (upper ? "_" + c.toLowerCase() : c)
    i = i + 1
  }
  return out
}

fn snakeParams(params) {
  let out = {}
  if (!params) {
    return out
  }
  let ks = Object.keys(params)
  let i = 0
  while (i < ks.length) {
    let v = params[ks[i]]
    if (typeof v !== "boolean") {
      out[snake(ks[i])] = v
    }
    i = i + 1
  }
  return out
}

let cached = null

fn tagsFor(id, explicit) {
  if (explicit && explicit.length > 0) {
    return explicit
  }
  let s = String(id)
  let tags = []
  if (s.indexOf("lofi") >= 0) {
    tags.push("lofi")
  }
  if (s.indexOf("acid") >= 0) {
    tags.push("acid")
  }
  if (s.indexOf("house") >= 0 || s.indexOf("garage") >= 0) {
    tags.push("house")
  }
  if (s.indexOf("edm") >= 0 || s.indexOf("halftime") >= 0) {
    tags.push("edm")
  }
  return tags
}

