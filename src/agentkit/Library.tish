    { id: "lofi-bass", kind: "sequence", role: "bass", tags: ["lofi"], name: "Lofi bass", about: "Two bars, behind the beat. Root, flat-7, minor third, then a short 4. Long notes, lots of air. Wants factory_lofi_sub.", bars: 2, defaultRoot: 41, events: [{ deg: 0, start: 0.12, dur: 1.5, vel: 94 }, { deg: 10, start: 2.3, dur: 0.8, vel: 82 }, { deg: 3, start: 4.15, dur: 1.3, vel: 90 }, { deg: 0, start: 6.4, dur: 0.7, vel: 86 }, { deg: 5, start: 7.3, dur: 0.45, vel: 74 }] },
