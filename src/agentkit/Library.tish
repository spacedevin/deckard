    { id: "lofi-hook", kind: "sequence", role: "lead", tags: ["lofi"], name: "Lofi hook", about: "Two bars of pentatonic fragments with rests. Hummable, never busy. Wants factory_lofi_pluck or factory_lofi_ep.", bars: 2, defaultRoot: 72, events: [{ deg: 0, start: 0.5, dur: 0.6, vel: 88 }, { deg: 3, start: 1.4, dur: 0.3, vel: 74 }, { deg: 7, start: 2.1, dur: 1.2, vel: 96 }, { deg: 10, start: 4.6, dur: 0.5, vel: 80 }, { deg: 7, start: 5.6, dur: 0.7, vel: 76 }, { deg: 12, start: 6.8, dur: 0.9, vel: 98 }] },
    { id: "house-pump-bass", kind: "sequence", role: "bass", tags: ["house"], name: "Pump bass", about: "One bar house bass: root on the downbeats, octave ghosts on the offs. Wants factory_house_bass.", bars: 1, defaultRoot: 33, events: [{ deg: 0, start: 0, dur: 0.4, vel: 116 }, { deg: 12, start: 1, dur: 0.18, vel: 78 }, { deg: 0, start: 1.5, dur: 0.35, vel: 104 }, { deg: 7, start: 2, dur: 0.4, vel: 110 }, { deg: 12, start: 3, dur: 0.18, vel: 76 }, { deg: 0, start: 3.5, dur: 0.3, vel: 100 }] },
    { id: "house-deep-bass", kind: "sequence", role: "bass", tags: ["house"], name: "Deep bass", about: "Two bars, fewer notes, longer holds. Sits under a pad instead of pumping the offbeats.", bars: 2, defaultRoot: 31, events: [{ deg: 0, start: 0, dur: 1.5, vel: 112 }, { deg: 0, start: 2, dur: 0.7, vel: 96 }, { deg: 7, start: 3, dur: 0.6, vel: 100 }, { deg: 3, start: 4, dur: 1.4, vel: 110 }, { deg: 0, start: 6, dur: 1.2, vel: 104 }] },
