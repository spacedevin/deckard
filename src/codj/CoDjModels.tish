// Models for an AI co-DJ, on the Hypery gateway (the ids createHyperyModel sends). Two jobs:
// the producer calls tools and writes the JavaScript script; the director (no tools) makes the creative calls.
// Defaults are the strongest models while the agent is being shaped; the cheap ones stay in the menus.

let CHOICES = [
  { id: "anthropic/claude-sonnet-5.5", label: "Claude Sonnet 5.5 — best producer" },
  { id: "anthropic/claude-opus-5.5", label: "Claude Opus 5.5 — strongest, slower" },
  { id: "openai/gpt-5.6-sol", label: "GPT-5.6 Sol" },
  { id: "google/gemini-3.8-flash", label: "Gemini 3.8 Flash — fast" },
  { id: "moonshotai/kimi-k3", label: "Kimi K3" },
  { id: "anthropic/claude-haiku-5.5", label: "Claude Haiku 5.5 — cheap" },
  { id: "openai/gpt-4.1-mini", label: "GPT-4.1 mini — cheap" },
  { id: "deepseek/deepseek-v4-flash", label: "DeepSeek V4 Flash — cheap" },
  { id: "alibaba/qwen3-coder-next", label: "Qwen3 Coder Next — cheap" },
  { id: "google/gemini-3.1-flash-lite", label: "Gemini 3.1 Flash Lite — cheapest" },
  { id: "openai/gpt-4.1-nano", label: "GPT-4.1 nano — cheapest" }
]

let DIRECTOR_CHOICES = [
  { id: "anthropic/claude-opus-5.5", label: "Director: Claude Opus 5.5" },
  { id: "anthropic/claude-fable-5.1", label: "Director: Claude Fable 5.1" },
  { id: "openai/gpt-5.6-sol", label: "Director: GPT-5.6 Sol" },
  { id: "anthropic/claude-sonnet-5.5", label: "Director: Claude Sonnet 5.5" },
  { id: "google/gemini-3.8-flash", label: "Director: Gemini 3.8 Flash" },
  { id: "moonshotai/kimi-k3", label: "Director: Kimi K3" },
  { id: "anthropic/claude-haiku-5.5", label: "Director: Claude Haiku 5.5 — cheap" },
  { id: "off", label: "Director: off" }
]

let STORE_KEY = "deckard.codjModel.v2"
let DIRECTOR_KEY = "deckard.codjDirectorModel"

fn storage() {
  try {
    return globalThis.localStorage
  } catch (e) {
    return null
  }
}

fn known(list, id) {
  return list.some((c) => c.id === id)
}

fn remember(key, list, id) {
  let store = storage()
  if (!store || !known(list, String(id))) {
    return
  }
  try {
    store.setItem(key, String(id))
  } catch (e) {
    return
  }
}

fn load(key, list) {
  let store = storage()
  if (store) {
    try {
      let existing = store.getItem(key)
      if (existing !== null && known(list, String(existing).trim())) {
        return String(existing).trim()
      }
    } catch (e) {
      return list[0].id
    }
  }
  return list[0].id
}

/** The producer model used when the menu has not been changed. */
export fn codjDefaultModel() {
  return CHOICES[0].id
}

/** Dropdown rows: { id, label }. */
export fn codjModelChoices() {
  return CHOICES
}

/** Remember the producer model this browser offers next time. */
export fn rememberCoDjModel(id) {
  remember(STORE_KEY, CHOICES, id)
}

/** The saved producer model, or the default. */
export fn loadCoDjModel() {
  return load(STORE_KEY, CHOICES)
}

/** The director model used when the menu has not been changed ("off" turns the director off). */
export fn codjDefaultDirectorModel() {
  return DIRECTOR_CHOICES[0].id
}

export fn codjDirectorChoices() {
  return DIRECTOR_CHOICES
}

export fn rememberCoDjDirectorModel(id) {
  remember(DIRECTOR_KEY, DIRECTOR_CHOICES, id)
}

export fn loadCoDjDirectorModel() {
  return load(DIRECTOR_KEY, DIRECTOR_CHOICES)
}
