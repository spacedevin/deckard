// Shared transport clock for the co-DJ session. The HOST is the clock master: while it plays it
// broadcasts its playhead (perfStep + song scene) once per bar. FOLLOWERS slave their local transport
// tick to the host so every player is on the same bar/step — the foundation of "everyone hears and sees
// the same thing." Pure logic here (no DOM / ws); App.tish + CoDjPanel.tish do the wiring.

/** Build the per-bar clock control payload the host broadcasts. Carries the host's play MODE so a
 *  follower starting from a clock plays the same thing (sequence = rack, song = session clips). */
export fn coDjClockPayload(actorId, perfStep, scene, bpm, playMode) {
  return {
    type: "control",
    op: "clock",
    actorId: actorId,
    authorId: actorId,
    perfStep: Math.floor(Number(perfStep)),
    scene: scene !== null ? Math.floor(Number(scene)) : null,
    bpm: bpm !== null ? Number(bpm) : null,
    playMode: playMode === "sequence" ? "sequence" : "song"
  }
}

/** True when `rt` should slave its transport to a host clock: it's a follower (not the host) and the
 *  user hasn't switched to independent mode (rt.coDjFollowTransport === false). */
export fn coDjShouldFollow(rt) {
  if (!rt) {
    return false
  }
  if (rt.coDjIsHost === true) {
    return false
  }
  return rt.coDjFollowTransport !== false
}

/** True when this client is a CONNECTED co-DJ follower (in a live session, not the host). Followers don't
 *  drive the shared transport — the host is the clock master; a follower auto-follows it (coDjFollowStart)
 *  and can only Preview privately. So Play/Stop is host-only. */
export fn coDjIsFollower(rt) {
  if (!rt) {
    return false
  }
  if (rt.coDjIsHost === true) {
    return false
  }
  // Fail SAFE toward host: until the gateway resolves our role (a joined/presence frame sets coDjHostActorId),
  // do NOT classify an open socket as a follower. Otherwise the real host — whose coDjIsHost is not yet true in
  // the connect window (or went stale across a reconnect) — would be downgraded to Preview-only and would never
  // broadcast playing_start/stop, silently breaking the WHOLE room's transport. An unresolved client has no
  // followers to disturb, so the safe direction is "not a follower" (drive + broadcast normally). Once joined
  // resolves coDjHostActorId, a true follower (coDjIsHost false) correctly reports as a follower below.
  if (rt.coDjHostActorId === null) {
    return false
  }
  return rt.coDjWs !== null && rt.coDjWs.readyState === 1
}

/** True when this client is in a LIVE co-DJ session (the WS is connected). Read straight off the runtime, so
 *  it's reliable the instant we connect — no dependence on a roster being synced onto a particular project ref. */
export fn coDjConnected(rt) {
  return rt !== null && rt.coDjWs !== null && rt.coDjWs.readyState === 1
}

/** The LOCAL player's own deck letter (A/B/C/D) while in a connected session, else null (solo = unrestricted).
 *  Built from the LIVE runtime roster (host first, then sorted other actors — mirrors syncPlayerRoster), so it
 *  does NOT depend on project.coDjPlayers having been synced onto the exact project ref a component received.
 *  This is the ONLY deck a player may load a song onto in a session. */
export fn coDjOwnDeckLetter(rt) {
  if (!coDjConnected(rt)) {
    return null
  }
  let host = rt.coDjHostActorId !== null ? String(rt.coDjHostActorId) : ""
  let actors = Array.isArray(rt.coDjActors) ? rt.coDjActors : []
  let players = []
  if (host.length > 0) {
    players.push(host)
  }
  let sorted = actors.slice().sort()
  let i = 0
  while (i < sorted.length && players.length < 4) {
    if (String(sorted[i]) !== host) {
      players.push(String(sorted[i]))
    }
    i = i + 1
  }
  let self = rt.coDjActorId !== null ? String(rt.coDjActorId) : ""
  let j = 0
  while (j < players.length && j < 4) {
    if (players[j] === self) {
      return j === 1 ? "B" : (j === 2 ? "C" : (j === 3 ? "D" : "A"))
    }
    j = j + 1
  }
  // Connected but not yet placed in the roster (mid-join): default to the host deck so we still restrict.
  return "A"
}

/**
 * Decide the tick a follower should adopt given its own `localTick` and the host's reported `hostTick`.
 * Small drift is left alone (avoids audible micro-snapping every bar); drift beyond `threshold` snaps to
 * the host. Returns an integer tick. The host keeps advancing during message latency, so on a snap we
 * nudge one step past the reported value to land closer to where the host actually is.
 */
export fn coDjClockAlign(localTick, hostTick, threshold) {
  let lt = Math.floor(Number(localTick))
  let ht = Math.floor(Number(hostTick))
  let th = threshold !== null && Math.floor(Number(threshold)) >= 0 ? Math.floor(Number(threshold)) : 1
  if (Math.abs(lt - ht) > th) {
    return ht + 1
  }
  return lt
}
