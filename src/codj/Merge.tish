// Apply TPL from an actor with ownership / master-lock rules.

import { makeChannel, defaultParamsForGeneratorId } from '../model/Project.tish'
import { parseProgram } from '../tpl/Parser.tish'
import {
  applyTrackBody,
  applyAutos,
  applySessionClipBlocks,
  applySessionGrid
} from '../tpl/Apply.tish'
import { ensureProjectSession, normalizeSongEntries } from '../model/Session.tish'
import { tplLoopResetChannel } from '../tpl/LoopState.tish'
import { findChannelById } from '../tpl/Apply.tish'
import { ensureCoDjMeta, setTrackOwner, setTrackTouched } from './CoDjMeta.tish'
import { skillIdsAllowMaster } from './Skills.tish'

export fn actorMayEditTrack(project, channelId, actorId, isNewTrack) {
  ensureCoDjMeta(project)
  let t = project.coDjMeta.tracks[channelId]
  if (!t) {
    return isNewTrack
  }
  if (t.masterLock) {
    return false
  }
  if (t.ownerActorId === actorId) {
    return true
  }
  return false
}

/**
 * True if this lane carries master rights (bpm / autos / scenes / clips).
 * Prefer the actor's declared skillIds; fall back to the legacy actorId substring check
 * only when skillIds are absent (e.g. a message that predates skill stamping).
 */
export fn laneCanMaster(actorId, skillIds) {
  if (Array.isArray(skillIds)) {
    return skillIdsAllowMaster(skillIds)
  }
  if (!actorId || typeof actorId !== "string") return false
  return actorId.indexOf("human") >= 0
}

export fn applyCoDjTplSource(project, source, actorId, authorId, currentPerfStep, skillIds) {
  ensureCoDjMeta(project)
  let perfStep = currentPerfStep
  if (perfStep === undefined || perfStep === null) {
    perfStep = 0
  }
  let canMaster = laneCanMaster(actorId, skillIds)
  let parsed = parseProgram(source)
  let errs = parsed.errors
  if (canMaster && parsed.bpm !== null && parsed.bpm >= 40 && parsed.bpm <= 300) {
    project.bpm = parsed.bpm
  }
  if (canMaster && parsed.launchQuant !== null && parsed.launchQuant !== undefined) {
    let lq = Math.floor(Number(parsed.launchQuant))
    if (lq >= 1 && lq <= 256 && lq === lq) {
      project.launchQuant = lq
    }
  }
  let ti = 0
  while (ti < parsed.tracks.length) {
    let tb = parsed.tracks[ti]
    let ch = findChannelById(project, tb.id)
    let isNew = ch === null
    if (!actorMayEditTrack(project, tb.id, actorId, isNew)) {
      ti = ti + 1
      continue
    }
    if (!ch) {
      ch = makeChannel(tb.id, tb.name, 36, tb.generatorId)
      project.channels.push(ch)
      setTrackOwner(project, tb.id, actorId, authorId)
    } else {
      ch.name = tb.name
      if (ch.generatorId !== tb.generatorId) {
        ch.generatorId = tb.generatorId
        ch.generatorParams = defaultParamsForGeneratorId(tb.generatorId)
      }
      if (canMaster) {
        setTrackOwner(project, tb.id, actorId, authorId)
      }
    }
    setTrackTouched(project, tb.id, perfStep)
    let hdrLoop = tb.loopBars
    if (hdrLoop === undefined) {
      hdrLoop = null
    }
    applyTrackBody(project, ch, tb.body, tb.genBlocks, errs, hdrLoop)
    tplLoopResetChannel(tb.id)
    ti = ti + 1
  }
  if (canMaster) {
    applySessionClipBlocks(project, parsed.clipBlocks ? parsed.clipBlocks : [], errs)
    applySessionGrid(project, parsed.sessionSceneCount, parsed.sessionSlots ? parsed.sessionSlots : [])
    ensureProjectSession(project)
    if (parsed.song !== null && parsed.song !== undefined) {
      project.session.song = normalizeSongEntries(project, parsed.song)
    }
    applyAutos(project, parsed.autos)
  }
  return { errors: errs, applied: true }
}
