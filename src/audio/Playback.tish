import { sixteenthSeconds, automationAt } from '../schedule/Engine.tish'
import { playHitAt, channelAudible, updateMixerFromProject } from './Engine.tish'
import { generatorChannelAtBeat } from './ParamAtBeat.tish'
import { expandTriggerNotes } from './NoteExpand.tish'
import { tplLoopOnBarBoundary, tplLoopSkipsChannel } from '../tpl/LoopState.tish'
import { playbackClipForChannel, clipPatternSpanSteps } from '../model/Session.tish'
import { channelDeck } from '../model/DeckRouting.tish'

/**
 * PURE note selection: which notes fire at `globalStep`, given ONLY the fold (project) + the performance
 * runtime (rt: arp state, armed clips, tpl-loop state). No audio / no store. Returns a list of
 * { busIndex, pitch, vel, durSec, beat } — the musical content of this step. This is the single source of
 * truth for "what sounds": transportTick maps it to playHitAt, and tests compare it across peers to prove
 * a host and guest hear EXACTLY the same thing (identical fold + step ⇒ identical triggers). It advances
 * rt.arpState / tpl-loop state exactly like playback, so callers must invoke it once per played step.
 */
export fn stepTriggers(project, rt, globalStep) {
  tplLoopOnBarBoundary(project, globalStep, rt)
  let out = []
  let bi = 0
  while (bi < project.channels.length) {
    if (!channelAudible(project, bi, rt ? rt.cuedDecks : null)) {
      bi = bi + 1
      continue
    }
    if (tplLoopSkipsChannel(project, bi, rt)) {
      bi = bi + 1
      continue
    }
    let ch = project.channels[bi]
    let pclip = playbackClipForChannel(project, rt, bi)
    if (pclip && pclip.silent) {
      bi = bi + 1
      continue
    }
    let useSteps = ch.steps
    let usePiano = ch.pianoNotes
    // Bar count of the active pattern (channel patternBars in rack mode, or the clip's). Drives the
    // melodic span and the per-bar step pitch — NOT the step-rhythm length (see below).
    let nbars = ch.patternBars != null && Math.floor(Number(ch.patternBars)) >= 1 ? Math.floor(Number(ch.patternBars)) : 1
    let patSpan = nbars * 16
    if (pclip && !pclip.silent) {
      useSteps = pclip.steps
      usePiano = pclip.pianoNotes
      patSpan = clipPatternSpanSteps(pclip)
      if (patSpan >= 16) {
        nbars = Math.floor(patSpan / 16)
      }
    }
    if (usePiano && usePiano.length > 0) {
      // Melodic: notes are positioned by ABSOLUTE beat across all bars (bar-selected notes are expanded
      // to absolute notes at apply time). span = full pattern length, so bars 2+ are NOT skipped.
      let stepInSpan = globalStep % patSpan
      let pi = 0
      while (pi < usePiano.length) {
        let n = usePiano[pi]
        let noteStep = Math.floor(n.startBeat * 4 + 0.0001)
        if (noteStep >= 0 && noteStep < patSpan && stepInSpan === noteStep) {
          let sec = (n.durBeats * 60) / project.bpm
          let notes = expandTriggerNotes(ch, n.pitch, sec)
          let pk = 0
          while (pk < notes.length) {
            out.push({ busIndex: bi, pitch: notes[pk].pitch, vel: n.vel, durSec: notes[pk].dur, beat: n.startBeat, noteOffset: notes[pk].offset })
            pk = pk + 1
          }
        }
        pi = pi + 1
      }
    } else {
      // Steps: the rhythm LOOPS over its own array length — a 16-step pattern repeats every bar (the
      // common case, e.g. a bass groove), while a captured N*16 array plays distinct per-bar steps. The
      // per-bar step pitch (step_pitch … bar <sel> → stepPitchByBar) is chosen by the GLOBAL bar index, so
      // multi-bar pitch progressions actually change across bars (the old code used the wrong index and
      // either pinned bar-1's pitch or, with the naive span fix, silenced bars 2+ entirely).
      let rlen = (useSteps && useSteps.length >= 1) ? useSteps.length : 16
      let stepInRhythm = globalStep % rlen
      if (useSteps && stepInRhythm < useSteps.length && useSteps[stepInRhythm].on) {
        let dur = sixteenthSeconds(project.bpm) * 0.85
        let basePitch = ch.stepPitch
        if (ch.stepPitchByBar) {
          let barIdx = Math.floor(globalStep / 16) % nbars
          if (barIdx >= 0 && barIdx < ch.stepPitchByBar.length) {
            basePitch = ch.stepPitchByBar[barIdx]
          }
        }
        let notes = expandTriggerNotes(ch, basePitch, dur)
        let pk = 0
        while (pk < notes.length) {
          out.push({ busIndex: bi, pitch: notes[pk].pitch, vel: useSteps[stepInRhythm].vel, durSec: notes[pk].dur, beat: globalStep * 0.25, noteOffset: notes[pk].offset })
          pk = pk + 1
        }
      }
    }
    bi = bi + 1
  }
  return out
}

/**
 * Render ONE deck's pattern loop to a mono Float32Array OFFLINE — this is the scratch source, so scratching
 * manipulates the DECK's actual music (not a one-shot voice layered on top). We reuse the real sequencer:
 * `stepTriggers` with `cuedDecks:{[deck]:true}` makes that deck's channels audible regardless of the
 * crossfader/main-deck (the PFL path), and we keep only triggers whose channel is ON this deck — so the
 * buffer is exactly what that deck plays for `bars` bars, ready to be wrapped/scratched as a loop.
 * Returns Promise<{data, sampleRate}>|null (null = no audio engine, or the deck is empty).
 */
export fn renderDeckLoopToBuffer(project, deck, bars) {
  if (typeof OfflineAudioContext === "undefined" || !project || !project.channels) {
    return null
  }
  let bpm = project.bpm != null && project.bpm > 0 ? project.bpm : 120
  let stepSec = 60 / bpm / 4
  let nbars = bars != null && Math.floor(Number(bars)) >= 1 ? Math.floor(Number(bars)) : 1
  let totalSteps = nbars * 16
  let sr = 44100
  let tailSec = 0.55
  let len = Math.floor(sr * (totalSteps * stepSec + tailSec))
  if (len < 2) {
    return null
  }
  // Which channels belong to this deck → an offline bus each (all summed into the mono destination).
  let buses = {}
  let any = false
  let octx = new OfflineAudioContext(1, len, sr)
  let ci = 0
  while (ci < project.channels.length) {
    if (channelDeck(project, project.channels[ci]) === deck) {
      buses[ci] = { input: octx.destination, reverbSend: null }
      any = true
    }
    ci = ci + 1
  }
  if (!any) {
    return null
  }
  // Cue THIS deck so its channels fire regardless of the crossfader / main-deck gate.
  let cd = { A: false, B: false, C: false, D: false }
  cd[deck] = true
  let rrt = { playMode: "sequence", cuedDecks: cd }
  let s = 0
  while (s < totalSteps) {
    let trigs = stepTriggers(project, rrt, s)
    let t = s * stepSec
    let k = 0
    while (k < trigs.length) {
      let tr = trigs[k]
      let bus = buses[tr.busIndex]
      if (bus != null) {
        let ch = project.channels[tr.busIndex]
        let gch = generatorChannelAtBeat(project, ch, tr.beat)
        let tWhen = tr.noteOffset != null ? t + tr.noteOffset : t
        playHitAt(octx, bus, tWhen, tr.pitch, tr.vel, tr.durSec, gch, 0)
      }
      k = k + 1
    }
    s = s + 1
  }
  return octx.startRendering().then((rendered) => {
    return { data: rendered.getChannelData(0), sampleRate: sr }
  }, (e) => {
    return null
  })
}

export fn transportTick(project, store, globalStep, rt, whenSec) {
  if (!store.ctx) {
    return
  }
  let beat = globalStep * 0.25
  updateMixerFromProject(project, store, beat)
  let ctx = store.ctx
  // Lookahead scheduler passes the EXACT audio-clock time this step should sound; legacy callers omit it
  // and fall back to a small fixed lookahead from "now".
  let t = whenSec != null ? Number(whenSec) : ctx.currentTime + 0.04
  let bend = 0
  if (project.automation && project.automation.pitchBend && project.automation.pitchBend.length > 0) {
    let stepInBar = globalStep % 16
    bend = automationAt(project.automation.pitchBend, stepInBar * 0.25)
  }
  // Selection (pure) → audio (the only difference between a real client and a headless one).
  // RECORD/REPLAY (the "Set" = what actually PLAYED): during a replay we FIRE the recorded triggers for
  // this step instead of recomputing them from the project (so the ghost re-plays the exact performance);
  // during a normal play we record stepTriggers' output — that note stream IS the performance.
  let triggers
  if (rt && rt.tplReplaying && rt.tplReplayTriggers) {
    let rel = Math.floor(globalStep) - Math.floor(rt.tplReplayStartStep != null ? rt.tplReplayStartStep : 0)
    triggers = rt.tplReplayTriggers[rel] != null ? rt.tplReplayTriggers[rel] : []
    // Re-apply the taped performance controls for this step (4-way crossfader + per-deck FLT) — the ghost
    // reproduces the filter sweep + fader blend, not just the notes.
    if (rt.applyReplayControls) {
      rt.applyReplayControls(rel)
    }
  } else {
    triggers = stepTriggers(project, rt, globalStep)
    if (rt && rt.recordPlayedStep) {
      rt.recordPlayedStep(globalStep, triggers)
    }
  }
  let i = 0
  while (i < triggers.length) {
    let tr = triggers[i]
    let ch = project.channels[tr.busIndex]
    let bus = store.buses[tr.busIndex]
    // A replayed trigger can reference a channel the current project no longer has (e.g. the recording
    // owns more channels than the loaded header) — skip it rather than crash on a missing channel/bus.
    if (ch != null && bus != null) {
      let gch = generatorChannelAtBeat(project, ch, tr.beat)
      // Chord notes can be offset in time (strum) or rippled (arpeggio); offset is seconds after the step.
      let tWhen = tr.noteOffset != null ? t + tr.noteOffset : t
      playHitAt(ctx, bus, tWhen, tr.pitch, tr.vel, tr.durSec, gch, bend)
    }
    i = i + 1
  }
}
