// Web Audio: track (EQ + trim + pan) → actor bus (EQ + trim) → master (EQ + gain) → analyser.

import { automationAt } from '../schedule/Engine.tish'
import { mixerAutomationAt } from './MixerAutomation.tish'
import { coDjEffectiveGain } from '../codj/Overlay.tish'
import { dispatchPlayNote } from '../generators/Dispatch.tish'
import {
  channelActorLane,
  collectActorLanes,
  ensureActorMixerEntries,
  ensureMasterMixer,
  actorLaneAudible
} from '../model/MixerRouting.tish'
import { channelHeardOnMainDeck, deckMainOutGainMultiplier, channelDeck } from '../model/DeckRouting.tish'

fn makeDriveCurve(ctx, amount) {
  let k = amount * 120
  let n = 1024
  let curve = new Float32Array(n)
  let i = 0
  while (i < n) {
    let x = (i * 2) / n - 1
    curve[i] = ((3 + k) * x * 0.5) / (Math.PI + k * Math.abs(x))
    i = i + 1
  }
  return curve
}

// Smooth synthetic convolution-reverb impulse (noise burst with an exponential decay tail) — a real
// room/hall wash, NOT a feedback delay (which slaps/pops on transients).
fn makeReverbImpulse(ctx, duration, decay) {
  let len = Math.floor(ctx.sampleRate * duration)
  if (len < 1) {
    len = 1
  }
  let impulse = ctx.createBuffer(2, len, ctx.sampleRate)
  let c = 0
  while (c < 2) {
    let data = impulse.getChannelData(c)
    let j = 0
    while (j < len) {
      data[j] = (Math.random() * 2 - 1) * Math.pow(1 - j / len, decay)
      j = j + 1
    }
    c = c + 1
  }
  return impulse
}

// Soft-clip curve (tanh): nearly linear at low level, saturates gracefully toward ±1 so a transient
// overshoot bends instead of hard-clipping into a click/pop. Inputs beyond ±1 clamp to the rounded top.
fn makeSoftClipCurve() {
  // tanh(x): unity slope at 0 (transparent at low level), gently saturating toward the rails so a
  // peak bends instead of clipping. NOT normalized — normalizing would add ~2x low-level makeup gain.
  let n = 1024
  let curve = new Float32Array(n)
  let i = 0
  while (i < n) {
    let x = (i * 2) / (n - 1) - 1
    curve[i] = Math.tanh(x)
    i = i + 1
  }
  return curve
}

fn makeShelf(ctx, t, freq, q) {
  let f = ctx.createBiquadFilter()
  f.type = t
  f.frequency.value = freq
  f.Q.value = q
  f.gain.value = 0
  return f
}

fn connectTrackEq(ctx, filt, ch, gainAfterEq) {
  let tLo = makeShelf(ctx, "lowshelf", 220, 0.85)
  let tMid = ctx.createBiquadFilter()
  tMid.type = "peaking"
  tMid.frequency.value = 1400
  tMid.Q.value = 0.85
  tMid.gain.value = ch.eqMid != null ? ch.eqMid : 0
  let tHi = makeShelf(ctx, "highshelf", 5200, 0.7)
  tLo.gain.value = ch.eqLo != null ? ch.eqLo : 0
  tHi.gain.value = ch.eqHi != null ? ch.eqHi : 0
  filt.connect(tLo)
  tLo.connect(tMid)
  tMid.connect(tHi)
  tHi.connect(gainAfterEq)
  return { lo: tLo, mid: tMid, hi: tHi }
}

/** Per-channel bus: filter → 3-band EQ → trim → pan → actor summing node (+ reverb send). */
export fn buildChannelBus(ctx, ch, actorSummingGain, reverbIn, cueSum) {
  let pan = ctx.createStereoPanner()
  pan.pan.value = ch.pan
  let g = ctx.createGain()
  g.gain.value = ch.gain != null ? ch.gain : 0.85
  let filt = ctx.createBiquadFilter()
  filt.type = "lowpass"
  // Default OPEN (20 kHz ≈ transparent): the channel filter is an opt-in effect, not an always-on dulling
  // insert. A null/unset cutoff must never collapse the filter to silence.
  filt.frequency.value = ch.filterCutoff != null ? ch.filterCutoff : 20000
  filt.Q.value = ch.filterQ != null ? ch.filterQ : 0.7
  // Per-channel drive (waveshaper) feeding the filter — saturation/warmth for any generator.
  let drive = ctx.createWaveShaper()
  drive.oversample = "2x"
  if (ch.drive != null && ch.drive > 0) {
    drive.curve = makeDriveCurve(ctx, ch.drive)
  }
  drive.connect(filt)
  // Per-channel LFO modulating the filter cutoff — movement / wobble.
  let lfo = ctx.createOscillator()
  lfo.type = "sine"
  lfo.frequency.value = ch.lfoRate != null ? ch.lfoRate : 0
  let lfoGain = ctx.createGain()
  lfoGain.gain.value = ch.lfoDepth != null ? ch.lfoDepth : 0
  lfo.connect(lfoGain)
  lfoGain.connect(filt.frequency)
  lfo.start()
  let teq = connectTrackEq(ctx, filt, ch, g)
  g.connect(pan)
  pan.connect(actorSummingGain)
  // CUE send (DJ pre-fader listen): taps POST-EQ, PRE-fader so a deck can be auditioned in the headphones
  // regardless of the channel fader OR the crossfader (deck gain). Off (gain 0) until its deck is cued.
  let cueSend = ctx.createGain()
  cueSend.gain.value = 0
  teq.hi.connect(cueSend)
  if (cueSum) {
    cueSend.connect(cueSum)
  }
  // Passive analyser tap (post gain/pan) for the per-stem waveform thumbnails.
  let analyser = ctx.createAnalyser()
  analyser.fftSize = 128
  pan.connect(analyser)
  // Reverb aux send (post gain/pan) into the shared reverb bus.
  let revSend = ctx.createGain()
  revSend.gain.value = ch.reverbSend != null ? ch.reverbSend : 0
  pan.connect(revSend)
  if (reverbIn) {
    revSend.connect(reverbIn)
  }
  return {
    input: drive,
    gainNode: g,
    panNode: pan,
    filterNode: filt,
    eqLo: teq.lo,
    eqMid: teq.mid,
    eqHi: teq.hi,
    analyser: analyser,
    reverbSend: revSend,
    cueSend: cueSend,
    driveNode: drive,
    driveCached: ch.drive != null ? ch.drive : 0,
    lfo: lfo,
    lfoGain: lfoGain
  }
}

fn connectActorEq(ctx, summingGain, am, trimGain, masterSum) {
  let aLo = makeShelf(ctx, "lowshelf", 220, 0.85)
  let aMid = ctx.createBiquadFilter()
  aMid.type = "peaking"
  aMid.frequency.value = 1400
  aMid.Q.value = 0.85
  let aHi = makeShelf(ctx, "highshelf", 5200, 0.7)
  if (am) {
    aLo.gain.value = am.eqLo != null ? am.eqLo : 0
    aMid.gain.value = am.eqMid != null ? am.eqMid : 0
    aHi.gain.value = am.eqHi != null ? am.eqHi : 0
  }
  summingGain.connect(aLo)
  aLo.connect(aMid)
  aMid.connect(aHi)
  aHi.connect(trimGain)
  trimGain.connect(masterSum)
  return { lo: aLo, mid: aMid, hi: aHi }
}

/** Actor lane: all track pans sum into summingGain → EQ → trim → master sum. */
export fn buildActorBus(ctx, project, lane, masterSum) {
  ensureActorMixerEntries(project)
  let am = project.actorMixer[lane]
  let summingGain = ctx.createGain()
  summingGain.gain.value = 1
  let trimGain = ctx.createGain()
  trimGain.gain.value = am && am.gain != null ? am.gain : 1
  let eq = connectActorEq(ctx, summingGain, am, trimGain, masterSum)
  return {
    lane: lane,
    summingGain: summingGain,
    trimGain: trimGain,
    eqLo: eq.lo,
    eqMid: eq.mid,
    eqHi: eq.hi
  }
}

fn ensureActorBus(project, store, lane) {
  if (!store.ctx || !store.masterSum) {
    return
  }
  if (!store.actorBuses) {
    store.actorBuses = {}
  }
  if (store.actorBuses[lane]) {
    return
  }
  ensureActorMixerEntries(project)
  store.actorBuses[lane] = buildActorBus(store.ctx, project, lane, store.masterSum)
}

export fn ensureAudio(project, store) {
  if (store.ctx) {
    return store
  }
  ensureMasterMixer(project)
  ensureActorMixerEntries(project)
  let ctx = new AudioContext()
  let masterGain = ctx.createGain()
  let mg = [{ beat: 0, value: 1 }]
  if (project.automation && project.automation.masterGain && project.automation.masterGain.length > 0) {
    mg = project.automation.masterGain
  }
  masterGain.gain.value = automationAt(mg, 0)
  let mLo = makeShelf(ctx, "lowshelf", 220, 0.85)
  let mMid = ctx.createBiquadFilter()
  mMid.type = "peaking"
  mMid.frequency.value = 1400
  mMid.Q.value = 0.85
  let mHi = makeShelf(ctx, "highshelf", 5200, 0.7)
  if (project.masterMixer) {
    mLo.gain.value = project.masterMixer.eqLo != null ? project.masterMixer.eqLo : 0
    mMid.gain.value = project.masterMixer.eqMid != null ? project.masterMixer.eqMid : 0
    mHi.gain.value = project.masterMixer.eqHi != null ? project.masterMixer.eqHi : 0
  }
  let masterSum = ctx.createGain()
  masterSum.gain.value = 1
  masterSum.connect(mLo)
  mLo.connect(mMid)
  mMid.connect(mHi)
  mHi.connect(masterGain)
  // Master glue compressor (makes the mix sit together; COMPRESSOR: ACTIVE is now real).
  let comp = ctx.createDynamicsCompressor()
  comp.threshold.value = -14
  comp.knee.value = 28
  comp.ratio.value = 3.5
  comp.attack.value = 0.005
  comp.release.value = 0.12
  // Soft-clip limiter after the glue compressor: catches any residual overshoot from summed stems /
  // resonant transients so the output saturates smoothly instead of hard-clipping into a pop.
  let softClip = ctx.createWaveShaper()
  softClip.curve = makeSoftClipCurve()
  softClip.oversample = "4x"
  let analyser = ctx.createAnalyser()
  analyser.fftSize = 512
  masterGain.connect(comp)
  comp.connect(softClip)
  softClip.connect(analyser)
  // ---- Output: the MAIN mix stays on the NATIVE ctx.destination (low-latency render thread — routing it
  // through a MediaStream/<audio> element pitches it down + lags under load). The speakers device is chosen
  // with AudioContext.setSinkId (Chrome/Edge). The CUE (headphones) bus is the only thing that uses the
  // MediaStreamDestination → <audio> path, and it's built LAZILY (first time a deck is cued / a headphone
  // device is picked) so the default no-cue case has ZERO extra audio overhead.
  analyser.connect(ctx.destination)
  let mkStreamDest = null
  if (typeof ctx.createMediaStreamDestination === "function") {
    mkStreamDest = () => ctx.createMediaStreamDestination()
  } else if (typeof ctx.createMediaStreamAudioDestination === "function") {
    mkStreamDest = () => ctx.createMediaStreamAudioDestination()
  }
  let canSinkEl = false
  if (typeof Audio !== "undefined") {
    let testEl = new Audio()
    canSinkEl = typeof testEl.setSinkId === "function"
  }
  store.mkStreamDest = mkStreamDest
  store.canDualOut = mkStreamDest != null && canSinkEl
  store.ctxCanSink = typeof ctx.setSinkId === "function"
  store.cueSum = null
  store.cueDest = null
  store.cueEl = null
  store.cueLevel = 0.9
  store.dualOut = store.canDualOut || store.ctxCanSink
  store.masterComp = comp
  store.analyser = analyser
  store.ctx = ctx
  // Audio-thread clock: an AudioWorklet that pumps ~20ms ticks immune to main-thread/background-tab
  // throttling. Loads async; until ready (or if unavailable) the scheduler uses a setTimeout fallback.
  store.clockNode = null
  if (typeof ctx.audioWorklet !== "undefined" && ctx.audioWorklet && ctx.audioWorklet.addModule) {
    let pmod = ctx.audioWorklet.addModule("/clock-worklet.js")
    if (pmod && pmod.then) {
      pmod.then(() => {
        let node = new AudioWorkletNode(ctx, "deckard-clock")
        node.connect(ctx.destination)
        store.clockNode = node
        if (store.onClockReady) {
          store.onClockReady()
        }
      }, (e) => {
        if (typeof console !== "undefined" && console.warn) {
          console.warn("[Deckard] clock worklet unavailable, using setTimeout fallback", e)
        }
      })
    }
  }
  store.master = masterGain
  store.masterSum = masterSum
  store.masterEq = { lo: mLo, mid: mMid, hi: mHi }
  // Shared reverb send bus (the REVERB_BUS): a smooth convolution reverb (synthetic hall impulse),
  // gently high-passed so the tail doesn't muddy the low end, into the master sum.
  let revIn = ctx.createGain()
  revIn.gain.value = 0.85
  let revHp = ctx.createBiquadFilter()
  revHp.type = "highpass"
  revHp.frequency.value = 350
  let revConv = ctx.createConvolver()
  revConv.buffer = makeReverbImpulse(ctx, 2.6, 2.2)
  let revWet = ctx.createGain()
  revWet.gain.value = 0.9
  revIn.connect(revHp)
  revHp.connect(revConv)
  revConv.connect(revWet)
  revWet.connect(masterSum)
  store.reverbIn = revIn
  store.actorBuses = {}
  let lanes = collectActorLanes(project)
  let li = 0
  while (li < lanes.length) {
    let L = lanes[li]
    store.actorBuses[L] = buildActorBus(ctx, project, L, masterSum)
    li = li + 1
  }
  let buses = []
  let ci = 0
  while (ci < project.channels.length) {
    let lane = channelActorLane(project.channels[ci], project)
    let ab = store.actorBuses[lane]
    buses.push(buildChannelBus(ctx, project.channels[ci], ab.summingGain, store.reverbIn, store.cueSum))
    ci = ci + 1
  }
  store.buses = buses
  return store
}

export fn syncChannelBuses(project, store) {
  if (!store.ctx || !store.master || !store.buses) {
    return
  }
  let ctx = store.ctx
  while (store.buses.length < project.channels.length) {
    let idx = store.buses.length
    let ch = project.channels[idx]
    let lane = channelActorLane(ch, project)
    ensureActorBus(project, store, lane)
    let ab = store.actorBuses[lane]
    store.buses.push(buildChannelBus(ctx, ch, ab.summingGain, store.reverbIn, store.cueSum))
  }
}

/** Rebuild ALL channel buses for the current project.channels on the live context (deck-set hot-swap). */
export fn resyncAllChannelBuses(project, store) {
  if (!store.ctx) {
    return
  }
  ensureActorMixerEntries(project)
  if (!store.actorBuses) {
    store.actorBuses = {}
  }
  if (store.buses) {
    let i = 0
    while (i < store.buses.length) {
      let b = store.buses[i]
      if (b) {
        if (b.panNode) {
          try { b.panNode.disconnect() } catch (e) {}
        }
        if (b.driveNode) {
          try { b.driveNode.disconnect() } catch (e) {}
        }
        if (b.lfo) {
          try { b.lfo.stop() } catch (e) {}
        }
      }
      i = i + 1
    }
  }
  store.buses = []
  let ci = 0
  while (ci < project.channels.length) {
    let lane = channelActorLane(project.channels[ci], project)
    ensureActorBus(project, store, lane)
    let ab = store.actorBuses[lane]
    store.buses.push(buildChannelBus(store.ctx, project.channels[ci], ab.summingGain, store.reverbIn, store.cueSum))
    ci = ci + 1
  }
  // Re-apply cue sends after a full bus rebuild (deck-set hot-swap) — rare path, not the per-emit hot path.
  if (store.cueSum) {
    applyCueRouting(project, store)
  }
}

export fn removeChannelBusAt(store, index) {
  if (!store.buses || index < 0 || index >= store.buses.length) {
    return
  }
  let bus = store.buses[index]
  if (bus && bus.panNode) {
    try {
      bus.panNode.disconnect()
    } catch (e) {}
  }
  store.buses.splice(index, 1)
}

export fn updateMixerFromProject(project, store, atBeat) {
  if (!store.buses) {
    return
  }
  ensureMasterMixer(project)
  ensureActorMixerEntries(project)
  syncChannelBuses(project, store)
  let live = typeof atBeat === "number"
  let gainBeat = 0
  if (live) {
    gainBeat = atBeat
  }
  let mg2 = [{ beat: 0, value: 1 }]
  if (project.automation && project.automation.masterGain && project.automation.masterGain.length > 0) {
    mg2 = project.automation.masterGain
  }
  if (store.master) {
    store.master.gain.value = automationAt(mg2, gainBeat)
  }
  let mi = 0
  while (mi < project.channels.length) {
    let ch = project.channels[mi]
    let b = store.buses[mi]
    let gFall = coDjEffectiveGain(project, mi)
    let pFall = ch.pan != null ? ch.pan : 0
    let loFall = ch.eqLo != null ? ch.eqLo : 0
    let midFall = ch.eqMid != null ? ch.eqMid : 0
    let hiFall = ch.eqHi != null ? ch.eqHi : 0
    let deckMul = deckMainOutGainMultiplier(project, ch)
    if (live) {
      b.gainNode.gain.value =
        mixerAutomationAt(project, "channel", ch.id, "gain", atBeat, gFall) * deckMul
      b.panNode.pan.value = mixerAutomationAt(project, "channel", ch.id, "pan", atBeat, pFall)
      b.eqLo.gain.value = mixerAutomationAt(project, "channel", ch.id, "eqLo", atBeat, loFall)
      b.eqMid.gain.value = mixerAutomationAt(project, "channel", ch.id, "eqMid", atBeat, midFall)
      b.eqHi.gain.value = mixerAutomationAt(project, "channel", ch.id, "eqHi", atBeat, hiFall)
    } else {
      b.gainNode.gain.value = gFall * deckMul
      b.panNode.pan.value = pFall
      b.eqLo.gain.value = loFall
      b.eqMid.gain.value = midFall
      b.eqHi.gain.value = hiFall
    }
    b.filterNode.frequency.value = ch.filterCutoff != null ? ch.filterCutoff : 20000
    if (b.reverbSend) {
      b.reverbSend.gain.value = ch.reverbSend != null ? ch.reverbSend : 0
    }
    if (b.driveNode) {
      let dv = ch.drive != null ? ch.drive : 0
      if (b.driveCached !== dv) {
        b.driveNode.curve = dv > 0 ? makeDriveCurve(store.ctx, dv) : null
        b.driveCached = dv
      }
    }
    if (b.lfo) {
      b.lfo.frequency.value = ch.lfoRate != null ? ch.lfoRate : 0
    }
    if (b.lfoGain) {
      b.lfoGain.gain.value = ch.lfoDepth != null ? ch.lfoDepth : 0
    }
    mi = mi + 1
  }
  if (store.masterEq && project.masterMixer) {
    let m = project.masterMixer
    if (live) {
      store.masterEq.lo.gain.value = mixerAutomationAt(project, "master", "", "eqLo", atBeat, m.eqLo != null ? m.eqLo : 0)
      store.masterEq.mid.gain.value = mixerAutomationAt(project, "master", "", "eqMid", atBeat, m.eqMid != null ? m.eqMid : 0)
      store.masterEq.hi.gain.value = mixerAutomationAt(project, "master", "", "eqHi", atBeat, m.eqHi != null ? m.eqHi : 0)
    } else {
      store.masterEq.lo.gain.value = m.eqLo != null ? m.eqLo : 0
      store.masterEq.mid.gain.value = m.eqMid != null ? m.eqMid : 0
      store.masterEq.hi.gain.value = m.eqHi != null ? m.eqHi : 0
    }
  }
  // Master glue compressor toggle: ratio 1 + threshold 0 makes the DynamicsCompressor a transparent
  // pass-through (no gain reduction), so disabling is a real audible bypass; re-enabling restores the
  // glue settings from buildAudioGraph. The COMPRESSOR readout (comp.reduction) then reads ~0 when off.
  if (store.masterComp && project.masterMixer) {
    let compOn = project.masterMixer.compEnabled !== false
    store.masterComp.ratio.value = compOn ? 3.5 : 1
    store.masterComp.threshold.value = compOn ? -14 : 0
  }
  // Reverb send bus toggle: mute the bus input so no channel send reaches the convolver.
  if (store.reverbIn && project.masterMixer) {
    store.reverbIn.gain.value = project.masterMixer.reverbEnabled === false ? 0 : 0.85
  }
  if (store.actorBuses && project.actorMixer) {
    let lanes = collectActorLanes(project)
    let ai = 0
    while (ai < lanes.length) {
      let L = lanes[ai]
      let ab = store.actorBuses[L]
      let am = project.actorMixer[L]
      if (ab && am) {
        if (live) {
          ab.eqLo.gain.value = mixerAutomationAt(project, "actor", L, "eqLo", atBeat, am.eqLo != null ? am.eqLo : 0)
          ab.eqMid.gain.value = mixerAutomationAt(project, "actor", L, "eqMid", atBeat, am.eqMid != null ? am.eqMid : 0)
          ab.eqHi.gain.value = mixerAutomationAt(project, "actor", L, "eqHi", atBeat, am.eqHi != null ? am.eqHi : 0)
          let trimBase = am.gain != null ? am.gain : 1
          let trim = mixerAutomationAt(project, "actor", L, "gain", atBeat, trimBase)
          if (!actorLaneAudible(project, L)) {
            trim = 0
          }
          ab.trimGain.gain.value = trim
        } else {
          ab.eqLo.gain.value = am.eqLo != null ? am.eqLo : 0
          ab.eqMid.gain.value = am.eqMid != null ? am.eqMid : 0
          ab.eqHi.gain.value = am.eqHi != null ? am.eqHi : 0
          let trim2 = am.gain != null ? am.gain : 1
          if (!actorLaneAudible(project, L)) {
            trim2 = 0
          }
          ab.trimGain.gain.value = trim2
        }
      }
      ai = ai + 1
    }
  }
  // NOTE: cue routing is reconciled by onCueToggle / on play / on bus rebuild — NOT here. updateMixerFromProject
  // runs on every emit (each crossfader pixel), so a second per-channel loop here would starve the audio thread.
}

/**
 * Lazily build the CUE (headphones) output the first time it's needed: a cue summing bus → a
 * MediaStreamDestination → a second <audio> element (its setSinkId picks the headphone device). Until then
 * the default no-cue session pays ZERO MediaStream/audio-element overhead. Wires existing channel cueSends in.
 */
export fn ensureCueOutput(store) {
  if (!store || store.cueSum) {
    return store ? store.cueSum : null
  }
  if (!store.canDualOut || !store.ctx || !store.mkStreamDest) {
    return null
  }
  let ctx = store.ctx
  let cueDest = store.mkStreamDest()
  let cueSum = ctx.createGain()
  cueSum.gain.value = store.cueLevel != null ? store.cueLevel : 0.9
  cueSum.connect(cueDest)
  let cueEl = new Audio()
  cueEl.autoplay = true
  cueEl.srcObject = cueDest.stream
  let p = cueEl.play()
  if (p && p.then) {
    p.then(() => {}, (e) => {})
  }
  store.cueDest = cueDest
  store.cueSum = cueSum
  store.cueEl = cueEl
  if (store.buses) {
    let i = 0
    while (i < store.buses.length) {
      let b = store.buses[i]
      if (b && b.cueSend) {
        b.cueSend.connect(cueSum)
      }
      i = i + 1
    }
  }
  return cueSum
}

/**
 * Reconcile the per-channel CUE sends from store.cuedDecks: a channel sends to the headphones bus iff its
 * deck is cued. Pre-fader (PFL) at store.cueLevel, so a cued deck is heard regardless of the crossfader.
 * Called on cue toggle / play / bus rebuild — never in the per-emit mixer hot path.
 */
export fn applyCueRouting(project, store) {
  if (!store || !store.buses) {
    return
  }
  let cued = store.cuedDecks != null ? store.cuedDecks : {}
  // First time anything is cued, build the headphone output path on demand.
  if (!store.cueSum) {
    if (cued.A === true || cued.B === true || cued.C === true || cued.D === true) {
      ensureCueOutput(store)
    }
    if (!store.cueSum) {
      return
    }
  }
  let level = store.cueLevel != null ? store.cueLevel : 0.9
  let i = 0
  while (i < project.channels.length && i < store.buses.length) {
    let b = store.buses[i]
    if (b && b.cueSend) {
      let dk = channelDeck(project, project.channels[i])
      b.cueSend.gain.value = cued[dk] === true ? level : 0
    }
    i = i + 1
  }
}

/** Pin the MAIN mix to the speakers device (native, via ctx.setSinkId) and the CUE bus to the headphones
 *  device. Empty id = system default. Builds the cue path lazily when a headphone device is first chosen. */
export fn applyOutputDevices(store, speakersId, headphonesId) {
  if (!store) {
    return
  }
  // MAIN: reroute the whole context's hardware output (low-latency) — NOT through a MediaStream element.
  if (store.ctx && typeof store.ctx.setSinkId === "function") {
    let p = store.ctx.setSinkId(speakersId != null ? String(speakersId) : "")
    if (p && p.then) {
      p.then(() => {}, (e) => {})
    }
  }
  // HEADPHONES: build the cue path on first selection, then pin it to the chosen device.
  let hp = headphonesId != null ? String(headphonesId) : ""
  if (hp.length > 0 && !store.cueSum) {
    ensureCueOutput(store)
  }
  if (store.cueEl && store.cueEl.setSinkId) {
    let p2 = store.cueEl.setSinkId(hp)
    if (p2 && p2.then) {
      p2.then(() => {}, (e) => {})
    }
  }
}

/** Headphone cue level (0..~1.2) on the cue summing bus. */
export fn setCueLevel(store, v) {
  if (!store) {
    return
  }
  let lv = Number(v)
  if (lv !== lv) {
    lv = 0.9
  }
  store.cueLevel = lv
  if (store.cueSum) {
    store.cueSum.gain.value = lv
  }
}

export fn playHitAt(ctx, bus, t, midi, vel, durSec, ch, bendSemis) {
  dispatchPlayNote(ctx, bus, t, midi, vel, durSec, ch, bendSemis)
}

export fn anySolo(project) {
  let i = 0
  while (i < project.channels.length) {
    if (project.channels[i].solo) {
      return true
    }
    i = i + 1
  }
  return false
}

export fn channelAudible(project, idx) {
  let ch = project.channels[idx]
  if (!ch) {
    return false
  }
  if (ch.mute) {
    return false
  }
  let lane = channelActorLane(ch, project)
  if (!actorLaneAudible(project, lane)) {
    return false
  }
  if (anySolo(project)) {
    return ch.solo
  }
  if (!channelHeardOnMainDeck(project, ch)) {
    return false
  }
  return true
}
