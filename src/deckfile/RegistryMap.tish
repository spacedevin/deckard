// deck generator ids and param aliases → project camelCase.

export fn normalizeGeneratorId(tplId) {
  let s = tplId
  if (s === "noise_burst" || s === "noiseburst") {
    return "noiseBurst"
  }
  if (s === "fm" || s === "fm_tone" || s === "fmtone") {
    return "fmTone"
  }
  if (s === "basic_osc" || s === "basicosc" || s === "osc") {
    return "basicOsc"
  }
  if (s === "matrix_fm" || s === "matrixfm") {
    return "matrixFm"
  }
  if (s === "drum" || s === "drum_synth" || s === "drumsynth") {
    return "drumSynth"
  }
  if (s === "patch" || s === "modular" || s === "synth") {
    return "patch"
  }
  return s
}

export fn snakeToCamel(s) {
  let parts = String(s).split("_")
  let out = parts[0]
  let i = 1
  while (i < parts.length) {
    let p = parts[i]
    if (p.length > 0) {
      out = out + p.charAt(0).toUpperCase() + p.substring(1)
    }
    i = i + 1
  }
  return out
}

export fn camelToSnake(s) {
  let out = ""
  let i = 0
  while (i < String(s).length) {
    let c = String(s).charAt(i)
    if (c >= "A" && c <= "Z") {
      out = out + "_" + c.toLowerCase()
    } else {
      out = out + c
    }
    i = i + 1
  }
  return out
}

export fn paramKeyToCamel(key) {
  if (key === "pitch_follow") {
    return "pitchFollow"
  }
  if (key === "mod_index") {
    return "modIndex"
  }
  if (key === "carrier_wave") {
    return "carrierWave"
  }
  if (key === "mod_wave") {
    return "modWave"
  }
  if (key === "filter_cutoff") {
    return "filterCutoff"
  }
  return key
}
