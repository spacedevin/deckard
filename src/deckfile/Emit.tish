import {
  formatTplBeat,
  formatTplFloat,
  camelToSnake,
  generatorIdToDeck
} from '@spacedevin/deck'
import { mixParamToTpl } from '../audio/MixerAutomation.tish'
import { collectActorLanes } from '../model/MixerRouting.tish'
import { syncAllMainClipsFromChannels, ensureProjectSession, playbackClipForChannel } from '../model/Session.tish'
import { scaleRootNames } from '../model/Scale.tish'

// Emit a per-step LANE (step_vel/step_prob/step_ratchet/step_nudge) only when SOME step deviates from the
// default — a plain pattern stays terse. Ints emit floored; floats via formatTplFloat (trimmed, signed).
// One `note` deck line with the per-note p-locks appended ONLY when non-default (so plain melodies round-trip
// byte-identical). Shared by the track-note emit, the clip-note emit, and the track/<id>/notes edit door so
// the format can't drift. Caller adds any trailing `bar <sel>` (that lives only in the live channel emit).
export fn noteLine(n) {
  let o = "  note " + String(n.pitch) + " " + String(n.startBeat) + " " + String(n.durBeats) + " v " + String(n.vel)
  let prob = n.prob !== null && n.prob !== undefined ? Number(n.prob) : 1
  if (prob < 0.999) {
    o = o + " p " + formatTplFloat(prob)
  }
  let ratchet = n.ratchet !== null && n.ratchet !== undefined ? Math.floor(Number(n.ratchet)) : 1
  if (ratchet > 1) {
    o = o + " r " + String(ratchet)
  }
  let nudge = n.nudge !== null && n.nudge !== undefined ? Number(n.nudge) : 0
  if (nudge > 0.0005 || nudge < -0.0005) {
    o = o + " n " + formatTplFloat(nudge)
  }
  if (n.lyric !== null && n.lyric !== undefined && n.lyric !== "") {
    o = o + " l " + n.lyric
  }
  return o
}

export fn stepLaneLine(steps, label, field, dflt, isInt) {
  if (!steps) {
    return ""
  }
  let any = false
  let i = 0
  while (i < 16) {
    let v = (steps[i] && (steps[i][field] !== null && steps[i][field] !== undefined)) ? Number(steps[i][field]) : dflt
    if (isInt) {
      if (Math.floor(v) !== Math.floor(dflt)) {
        any = true
      }
    } else {
      if (Math.abs(v - dflt) > 0.0005) {
        any = true
      }
    }
    i = i + 1
  }
  if (!any) {
    return ""
  }
  let o = "  " + label
  let j = 0
  while (j < 16) {
    let v = (steps[j] && (steps[j][field] !== null && steps[j][field] !== undefined)) ? Number(steps[j][field]) : dflt
    if (isInt) {
      o = o + " " + String(Math.floor(v))
    } else {
      o = o + " " + formatTplFloat(v)
    }
    j = j + 1
  }
  return o + "\n"
}

export fn stepLyricLaneLine(steps) {
  if (!steps) {
    return ""
  }
  let any = false
  let i = 0
  while (i < 16) {
    if (steps[i] && steps[i].lyric !== null && steps[i].lyric !== undefined && steps[i].lyric !== "") {
      any = true
    }
    i = i + 1
  }
  if (!any) {
    return ""
  }
  let o = "  step_lyric"
  let j = 0
  while (j < 16) {
    let l = (steps[j] && steps[j].lyric !== null && steps[j].lyric !== undefined && steps[j].lyric !== "") ? steps[j].lyric : "."
    o = o + " " + l
    j = j + 1
  }
  return o + "\n"
}

export fn generatorIdToTpl(id) {
  return generatorIdToDeck(id)
}

export fn emitProject(project) {
  return emitProjectInner(project, false)
}

// The deck line for one deck's booth EQ + volume (project.deckEq[deck] = {hi,mid,lo,flt,vol}). Returns "" when
// the deck is at defaults {0,0,0,0,1} so the round-trip stays minimal. Shared by emitProject (host snapshot)
// and CoDjPanel sendDeckPut (a follower contributing its OWN deck's booth), so both produce identical lines.
export fn deckMixLine(project, deck) {
  if (!project || !project.deckEq) {
    return ""
  }
  let de = project.deckEq[deck]
  if (!de) {
    return ""
  }
  let hi = typeof de.hi === "number" ? de.hi : 0
  let mid = typeof de.mid === "number" ? de.mid : 0
  let lo = typeof de.lo === "number" ? de.lo : 0
  let flt = typeof de.flt === "number" ? de.flt : 0
  let vol = typeof de.vol === "number" ? de.vol : 1
  let off = Math.abs(hi) > 0.0001 || Math.abs(mid) > 0.0001 || Math.abs(lo) > 0.0001 || Math.abs(flt) > 0.0001 || Math.abs(vol - 1) > 0.0001
  if (!off) {
    return ""
  }
  return "deck_mix " + deck + " hi " + formatTplFloat(hi) + " mid " + formatTplFloat(mid) + " lo " + formatTplFloat(lo) + " flt " + formatTplFloat(flt) + " vol " + formatTplFloat(vol)
}

export fn emitProjectInner(project, skipSync) {
  if (!skipSync) {
    syncAllMainClipsFromChannels(project)
  }
  ensureProjectSession(project)
  let o = "deck 1\n"
  o = o + "bpm " + formatTplFloat(project.bpm) + "\n"
  if (project.launchQuant !== null && project.launchQuant !== undefined && Math.floor(Number(project.launchQuant)) >= 1) {
    o = o + "launch_quant " + String(Math.floor(Number(project.launchQuant))) + "\n"
  }
  if (project.songSeed !== null && project.songSeed !== undefined && Math.floor(Number(project.songSeed)) === Math.floor(Number(project.songSeed))) {
    o = o + "song_seed " + String(Math.floor(Number(project.songSeed))) + "\n"
  }
  // Transport routing scalars — emitted only when off their defaults (keeps round-trip minimal & stable).
  let cfx = project.transportCrossfade !== null && project.transportCrossfade !== undefined ? Number(project.transportCrossfade) : 0.5
  let cfy = project.transportCrossfadeY !== null && project.transportCrossfadeY !== undefined ? Number(project.transportCrossfadeY) : 0.5
  if (Math.abs(cfx - 0.5) > 0.0001 || Math.abs(cfy - 0.5) > 0.0001) {
    o = o + "xfade " + formatTplFloat(cfx) + " " + formatTplFloat(cfy) + "\n"
  }
  if (project.transportMainDeck === "local") {
    o = o + "main_deck local\n"
  }
  if (project.swing !== null && project.swing !== undefined && Number(project.swing) > 0.0001) {
    o = o + "swing " + formatTplFloat(project.swing) + "\n"
  }
  // Scale lock (global key constraint) — root pitch-class name + mode.
  if (project.scaleRoot !== null && project.scaleRoot !== undefined && project.scaleMode !== null && project.scaleMode !== undefined && project.scaleMode !== "" && project.scaleMode !== "off") {
    let rn = scaleRootNames()
    let pc = Math.floor(Number(project.scaleRoot))
    if (pc >= 0 && pc <= 11) {
      o = o + "scale " + rn[pc] + " " + String(project.scaleMode) + "\n"
    }
  }
  // Per-deck booth EQ + volume (the centre DJ-mixer strip). Only off-default decks emit a line.
  let dmDecks = ["A", "B", "C", "D"]
  let dmi = 0
  while (dmi < dmDecks.length) {
    let dml = deckMixLine(project, dmDecks[dmi])
    if (dml.length > 0) {
      o = o + dml + "\n"
    }
    dmi = dmi + 1
  }
  o = o + "\n"

  let ci = 0
  while (ci < project.channels.length) {
    let ch = project.channels[ci]
    let gid = ch.generatorId
    if (!gid) {
      gid = "basicOsc"
    }
    // A macro-backed channel round-trips as `gen <macroName> [overrides]` (the macro re-expands on load).
    let genTok = (ch.macroName !== null && ch.macroName !== undefined) ? ch.macroName : generatorIdToTpl(gid)
    o = o + "track " + ch.name + " id " + ch.id + " gen " + genTok
    let pb = ch.patternBars
    if (pb !== null && pb !== undefined) {
      let pn = Math.floor(Number(pb))
      if (pn >= 2 && pn === pn) {
        o = o + " * " + String(pn)
      }
    }
    if (ch.macroName !== null && ch.macroName !== undefined && ch.macroParams) {
      let mk = Object.keys(ch.macroParams)
      let mki = 0
      while (mki < mk.length) {
        o = o + " " + mk[mki] + " " + String(ch.macroParams[mk[mki]])
        mki = mki + 1
      }
    }
    o = o + "\n"
    // Finite loop cap (play N bars then go silent) — distinct from pattern length above.
    let tlb = ch.tplLoopBars
    if (tlb !== null && tlb !== undefined) {
      let tn = Math.floor(Number(tlb))
      if (tn >= 1 && tn === tn) {
        o = o + "  loops " + String(tn) + "\n"
      }
    }
    o = o + "  mix gain " + formatTplFloat(ch.gain) + " pan " + formatTplFloat(ch.pan)
    if (ch.mute) {
      o = o + " mute 1"
    }
    if (ch.solo) {
      o = o + " solo 1"
    }
    let loV = ch.eqLo !== null && ch.eqLo !== undefined ? ch.eqLo : 0
    let midV = ch.eqMid !== null && ch.eqMid !== undefined ? ch.eqMid : 0
    let hiV = ch.eqHi !== null && ch.eqHi !== undefined ? ch.eqHi : 0
    o = o + " eq_lo " + formatTplFloat(loV) + " eq_mid " + formatTplFloat(midV) + " eq_hi " + formatTplFloat(hiV)
    o = o + "\n"
    if (ch.stepPitchByBar && ch.stepPitchByBar.length > 0) {
      let sbi = 0
      while (sbi < ch.stepPitchByBar.length) {
        o = o + "  step_pitch " + String(Math.floor(ch.stepPitchByBar[sbi])) + " bar " + String(sbi) + "\n"
        sbi = sbi + 1
      }
    } else {
      if (ch.stepPitch !== null && ch.stepPitch !== undefined && ch.stepPitch !== 36) {
        o = o + "  step_pitch " + String(Math.floor(ch.stepPitch)) + "\n"
      }
    }

    let p = ch.generatorParams
    if (!p) {
      p = {}
    }
    if (gid === "noiseBurst") {
      o =
        o +
        "  noise attack " +
        formatTplFloat(p.attack) +
        " decay " +
        formatTplFloat(p.decay) +
        " tone " +
        formatTplFloat(p.tone) +
        " pitch_follow " +
        formatTplFloat(p.pitchFollow) +
        "\n"
    }
    if (gid === "fmTone") {
      o =
        o +
        "  fm ratio " +
        formatTplFloat(p.ratio) +
        " mod_index " +
        formatTplFloat(p.modIndex) +
        " carrier " +
        String(p.carrierWave) +
        " mod " +
        String(p.modWave) +
        "\n"
      o =
        o +
        "  adsr a " +
        formatTplFloat(p.attack) +
        " d " +
        formatTplFloat(p.decay) +
        " s " +
        formatTplFloat(p.sustain) +
        " r " +
        formatTplFloat(p.release) +
        "\n"
    }
    if (gid === "basicOsc") {
      o = o + "  osc waveform " + String(p.waveform) + "\n"
      o =
        o +
        "  adsr a " +
        formatTplFloat(p.attack) +
        " d " +
        formatTplFloat(p.decay) +
        " s " +
        formatTplFloat(p.sustain) +
        " r " +
        formatTplFloat(p.release) +
        "\n"
    }
    if (gid !== "basicOsc" && gid !== "noiseBurst" && gid !== "fmTone" && gid !== "patch" && gid !== "matrixFm") {
      let keys = Object.keys(p)
      if (keys.length > 0) {
        o = o + "  gen"
        let gk = 0
        while (gk < keys.length) {
          let key = keys[gk]
          let val = p[key]
          let vstr = typeof val === "number" ? formatTplFloat(val) : String(val)
          o = o + " " + camelToSnake(key) + " " + vstr
          gk = gk + 1
        }
        o = o + "\n"
      }
    }

    let fxParts = ""
    if (ch.filterType !== null && ch.filterType !== undefined && ch.filterType !== "lowpass") {
      fxParts = fxParts + " filter_type " + String(ch.filterType)
    }
    if (ch.reverbSend !== null && ch.reverbSend !== undefined && ch.reverbSend > 0.0001) {
      fxParts = fxParts + " reverb_send " + formatTplFloat(ch.reverbSend)
    }
    if (ch.drive !== null && ch.drive !== undefined && ch.drive > 0.0001) {
      fxParts = fxParts + " drive " + formatTplFloat(ch.drive)
    }
    if (ch.lfoRate !== null && ch.lfoRate !== undefined && ch.lfoRate > 0.0001) {
      fxParts = fxParts + " lfo_rate " + formatTplFloat(ch.lfoRate)
    }
    if (ch.lfoDepth !== null && ch.lfoDepth !== undefined && ch.lfoDepth > 0.0001) {
      fxParts = fxParts + " lfo_depth " + formatTplFloat(ch.lfoDepth)
    }
    if (ch.filterCutoff !== null && ch.filterCutoff !== undefined && ch.filterCutoff < 20000) {
      fxParts = fxParts + " cutoff " + formatTplFloat(ch.filterCutoff)
    }
    if (ch.filterQ !== null && ch.filterQ !== undefined && Math.abs(ch.filterQ - 0.7) > 0.001) {
      fxParts = fxParts + " res " + formatTplFloat(ch.filterQ)
    }
    if (fxParts.length > 0) {
      o = o + "  fx" + fxParts + "\n"
    }

    let voiceParts = ""
    if (ch.octave !== null && ch.octave !== undefined && ch.octave !== 0) {
      voiceParts = voiceParts + " octave " + String(Math.floor(ch.octave))
    }
    if (ch.arp !== null && ch.arp !== undefined && ch.arp !== "" && ch.arp !== "off") {
      voiceParts = voiceParts + " arp " + String(ch.arp)
    }
    if (ch.chord !== null && ch.chord !== undefined && ch.chord !== "" && ch.chord !== "off") {
      voiceParts = voiceParts + " chord " + String(ch.chord)
    }
    if (ch.arpRate !== null && ch.arpRate !== undefined && ch.arpRate !== "auto") {
      voiceParts = voiceParts + " arprate " + String(ch.arpRate)
    }
    if (ch.inversion !== null && ch.inversion !== undefined && ch.inversion !== "root") {
      voiceParts = voiceParts + " inversion " + String(ch.inversion)
    }
    if (ch.strum !== null && ch.strum !== undefined) {
      let s = ch.strum
      let sStr = String(Math.round(s * 1000) / 1000)
      voiceParts = voiceParts + " strum " + sStr
    }
    if (voiceParts.length > 0) {
      o = o + "  voice" + voiceParts + "\n"
    }

    // Deck routing — emitted when the channel carries a deck assignment: an explicit deck SLOT (the
    // canonical, shared routing field — channelPlayerIndex reads deckSlot first) and/or a non-default deck
    // letter. The slot MUST round-trip even when ch.deck is still "live": graftRackOntoDeck parks B/C/D
    // channels on ch.deck="live" with the real deck living only in deckSlot, so gating on the letter alone
    // would silently drop multi-deck routing on save/load.
    let hasDeckSlot = ch.deckSlot !== null && ch.deckSlot !== undefined && Math.floor(Number(ch.deckSlot)) === Math.floor(Number(ch.deckSlot))
    if (hasDeckSlot || (ch.deck !== null && ch.deck !== undefined && ch.deck !== "live")) {
      o = o + "  deck " + String(ch.deck !== null && ch.deck !== undefined ? ch.deck : "live")
      if (hasDeckSlot) {
        o = o + " slot " + String(Math.floor(Number(ch.deckSlot)))
      }
      o = o + "\n"
    }

    let pianoNotes = ch.pianoNotes
    if (!pianoNotes) {
      pianoNotes = []
    }
    if (pianoNotes.length === 0) {
      o = o + "  steps"
      let si = 0
      while (si < 16) {
        if (ch.steps[si].on) {
          o = o + " x"
        } else {
          o = o + " ."
        }
        si = si + 1
      }
      o = o + "\n"
      // Per-step parameter locks ride parallel lanes right after `steps` (each omitted if all-default).
      o = o + stepLaneLine(ch.steps, "step_vel", "vel", 100, true)
      o = o + stepLaneLine(ch.steps, "step_prob", "prob", 1, false)
      o = o + stepLaneLine(ch.steps, "step_ratchet", "ratchet", 1, true)
      o = o + stepLaneLine(ch.steps, "step_nudge", "nudge", 0, false)
      o = o + stepLyricLaneLine(ch.steps)
    }

    let ni = 0
    while (ni < pianoNotes.length) {
      o = o + noteLine(pianoNotes[ni]) + "\n"
      ni = ni + 1
    }

    // Macro-backed channels emit `gen <macro>` above instead of the expanded patch graph.
    let isMacroChan = ch.macroName !== null && ch.macroName !== undefined
    if (!isMacroChan && ch.generatorSpec && ch.generatorSpec.raw) {
      let gk = ch.generatorSpec.tplHeaderId
      if (!gk && ch.generatorSpec.kind === "matrixFm") {
        gk = "matrix_fm"
      }
      if (!gk) {
        gk = ch.generatorSpec.kind
      }
      if (!gk) {
        gk = "plugin"
      }
      o = o + "  gen_block " + gk + "\n"
      let gri = 0
      while (gri < ch.generatorSpec.raw.length) {
        o = o + "    " + ch.generatorSpec.raw[gri] + "\n"
        gri = gri + 1
      }
      o = o + "  end gen_block\n"
    }

    o = o + "\n"
    ci = ci + 1
  }

  o = o + "session_scenes " + String(Math.floor(Number(project.session.sceneCount))) + "\n"
  let sti = 0
  while (sti < project.channels.length) {
    let scj = 0
    while (scj < project.session.sceneCount) {
      let slotId = ""
      if (project.session.slots[sti] && project.session.slots[sti][scj] !== undefined) {
        slotId = project.session.slots[sti][scj]
      }
      if (slotId === undefined || slotId === null) {
        slotId = ""
      }
      o =
        o +
        "session_slot " +
        project.channels[sti].id +
        " " +
        String(scj) +
        " " +
        (slotId === "" ? "-" : slotId) +
        "\n"
      scj = scj + 1
    }
    sti = sti + 1
  }
  o = o + "\n"
  // Explicit song arrangement (optional): `song` then one `P<n> [xN]` per entry. Absent = derived order.
  if (project.session.song && project.session.song.length > 0) {
    o = o + "song\n"
    let sgi = 0
    while (sgi < project.session.song.length) {
      let e = project.session.song[sgi]
      let rep = e.repeat !== null && e.repeat !== undefined ? Math.floor(Number(e.repeat)) : 1
      if (rep < 1) {
        rep = 1
      }
      o = o + "  P" + String(Math.floor(Number(e.scene)) + 1)
      if (rep > 1) {
        o = o + " x" + String(rep)
      }
      o = o + "\n"
      sgi = sgi + 1
    }
    o = o + "\n"
  }
  // Per-scene follow actions (optional): `follow` then `P<n> <a> <wa> [<b> <wb>]` per configured scene.
  if (project.session.follow && project.session.follow.length > 0) {
    let anyFollow = false
    let fck = 0
    while (fck < project.session.follow.length) {
      if (project.session.follow[fck] !== null && project.session.follow[fck] !== undefined) {
        anyFollow = true
      }
      fck = fck + 1
    }
    if (anyFollow) {
      o = o + "follow\n"
      let fgi = 0
      while (fgi < project.session.follow.length) {
        let fe = project.session.follow[fgi]
        if (fe !== null && fe !== undefined) {
          o = o + "  P" + String(fgi + 1) + " " + String(fe.a) + " " + formatTplFloat(fe.wa !== null && fe.wa !== undefined ? fe.wa : 1)
          if (fe.b !== null && fe.b !== undefined) {
            o = o + " " + String(fe.b) + " " + formatTplFloat(fe.wb !== null && fe.wb !== undefined ? fe.wb : 0)
          }
          o = o + "\n"
        }
        fgi = fgi + 1
      }
      o = o + "\n"
    }
  }
  let eci = 0
  while (eci < project.channels.length) {
    let ech = project.channels[eci]
    if (ech.sessionClips) {
      let cx = 0
      while (cx < ech.sessionClips.length) {
        let cl = ech.sessionClips[cx]
        o = o + "clip " + cl.id + " channel " + ech.id + " bars " + String(Math.floor(Number(cl.bars)))
        if (cl.name && String(cl.name).length > 0) {
          o = o + " name " + String(cl.name)
        }
        o = o + "\n"
        let pn = cl.pianoNotes
        if (pn && pn.length > 0) {
          let nk = 0
          while (nk < pn.length) {
            o = o + noteLine(pn[nk]) + "\n"
            nk = nk + 1
          }
        } else {
          o = o + "  steps "
          let sk = 0
          while (cl.steps && sk < cl.steps.length) {
            if (sk > 0) {
              o = o + " "
            }
            o = o + (cl.steps[sk].on ? "x" : ".")
            sk = sk + 1
          }
          o = o + "\n"
        }
        if (cl.tplLoopBars !== undefined && cl.tplLoopBars !== null) {
          let tn = Math.floor(Number(cl.tplLoopBars))
          if (tn >= 1 && tn === tn) {
            o = o + "  loops " + String(tn) + "\n"
          }
        }
        o = o + "\n"
        cx = cx + 1
      }
    }
    eci = eci + 1
  }

  if (project.masterMixer) {
    let mm = project.masterMixer
    o =
      o +
      "master_mix eq_lo " +
      formatTplFloat(mm.eqLo !== null && mm.eqLo !== undefined ? mm.eqLo : 0) +
      " eq_mid " +
      formatTplFloat(mm.eqMid !== null && mm.eqMid !== undefined ? mm.eqMid : 0) +
      " eq_hi " +
      formatTplFloat(mm.eqHi !== null && mm.eqHi !== undefined ? mm.eqHi : 0) +
      " comp " +
      (mm.compEnabled === false ? "0" : "1") +
      " reverb " +
      (mm.reverbEnabled === false ? "0" : "1") +
      "\n\n"
  }
  let mixLanes = collectActorLanes(project)
  let lix = 0
  while (lix < mixLanes.length) {
    let Ln = mixLanes[lix]
    if (project.actorMixer && project.actorMixer[Ln]) {
      let amx = project.actorMixer[Ln]
      o = o + "actor_mix " + Ln + " gain " + formatTplFloat(amx.gain !== null && amx.gain !== undefined ? amx.gain : 1)
      o =
        o +
        " eq_lo " +
        formatTplFloat(amx.eqLo !== null && amx.eqLo !== undefined ? amx.eqLo : 0) +
        " eq_mid " +
        formatTplFloat(amx.eqMid !== null && amx.eqMid !== undefined ? amx.eqMid : 0) +
        " eq_hi " +
        formatTplFloat(amx.eqHi !== null && amx.eqHi !== undefined ? amx.eqHi : 0)
      if (amx.mute) {
        o = o + " mute 1"
      }
      if (amx.solo) {
        o = o + " solo 1"
      }
      o = o + "\n"
    }
    lix = lix + 1
  }
  if (mixLanes.length > 0) {
    o = o + "\n"
  }

  if (project.automation && project.automation.masterGain && project.automation.masterGain.length > 0) {
    o = o + "auto master_gain\n"
    let mi = 0
    while (mi < project.automation.masterGain.length) {
      let pt = project.automation.masterGain[mi]
      o = o + "  " + formatTplBeat(pt.beat) + " " + formatTplFloat(pt.value) + "\n"
      mi = mi + 1
    }
    o = o + "\n"
  }

  if (project.paramAutomations && project.paramAutomations.length > 0) {
    let pai = 0
    while (pai < project.paramAutomations.length) {
      let pa = project.paramAutomations[pai]
      let pkey = pa.param
      if (pkey === "pitchFollow") {
        pkey = "pitch_follow"
      }
      if (pkey === "modIndex") {
        pkey = "mod_index"
      }
      o = o + "auto " + pa.channelId + " gen " + pkey + "\n"
      let qi = 0
      while (qi < pa.points.length) {
        let q = pa.points[qi]
        o = o + "  " + formatTplBeat(q.beat) + " " + formatTplFloat(q.value) + "\n"
        qi = qi + 1
      }
      o = o + "\n"
      pai = pai + 1
    }
  }

  if (project.mixerAutomations && project.mixerAutomations.length > 0) {
    let mxi = 0
    while (mxi < project.mixerAutomations.length) {
      let mx = project.mixerAutomations[mxi]
      let pkey = mixParamToTpl(mx.param)
      if (mx.target === "master") {
        o = o + "auto master mix " + pkey + "\n"
      } else {
        if (mx.target === "actor") {
          o = o + "auto actor " + mx.lane + " mix " + pkey + "\n"
        } else {
          o = o + "auto " + mx.channelId + " mix " + pkey + "\n"
        }
      }
      let mqj = 0
      while (mqj < mx.points.length) {
        let qm = mx.points[mqj]
        o = o + "  " + formatTplBeat(qm.beat) + " " + formatTplFloat(qm.value) + "\n"
        mqj = mqj + 1
      }
      o = o + "\n"
      mxi = mxi + 1
    }
  }

  return o
}

/**
 * Emit the project as deck reflecting what is ACTUALLY PLAYING right now, not the rack you are editing.
 * In song mode each channel's body becomes its currently-armed session clip (honouring per-track
 * overrides); a track armed to silence emits an empty bar; in sequence mode it falls back to the rack.
 * This is what a co-DJ streams so collaborators hear your launches, not your edit buffer. The channel
 * pattern fields are swapped in place, emitted, then restored — and main-clip sync is skipped so the
 * saved clips are never clobbered by the temporary swap.
 */
export fn emitLivePlayback(project, rt) {
  if (!project || !project.channels) {
    return emitProject(project)
  }
  let saved = []
  let i = 0
  while (i < project.channels.length) {
    let ch = project.channels[i]
    saved.push({
      steps: ch.steps,
      pianoNotes: ch.pianoNotes,
      patternBars: ch.patternBars,
      stepPitchByBar: ch.stepPitchByBar
    })
    let clip = playbackClipForChannel(project, rt, i)
    if (clip && clip.silent) {
      let empty = []
      let z = 0
      while (z < 16) {
        empty.push({ on: false, vel: 100 })
        z = z + 1
      }
      ch.steps = empty
      ch.pianoNotes = []
      ch.patternBars = 1
      ch.stepPitchByBar = null
    } else if (clip) {
      ch.steps = clip.steps
      ch.pianoNotes = clip.pianoNotes
      ch.patternBars = clip.bars !== null && clip.bars !== undefined ? clip.bars : 1
      ch.stepPitchByBar = clip.stepPitchByBar !== null && clip.stepPitchByBar !== undefined ? clip.stepPitchByBar : null
    }
    i = i + 1
  }
  let out = emitProjectInner(project, true)
  let j = 0
  while (j < project.channels.length) {
    let ch = project.channels[j]
    let s = saved[j]
    ch.steps = s.steps
    ch.pianoNotes = s.pianoNotes
    ch.patternBars = s.patternBars
    ch.stepPitchByBar = s.stepPitchByBar
    j = j + 1
  }
  return out
}
