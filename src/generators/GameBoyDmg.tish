// Game Boy DMG Emulator (100% Hardware Parity)
// Exact wavetables, pulse widths, and DMG LFSR noise.

fn getDmgPulseBuffer(ctx, duty) {
  let cacheKey = "dmgPulse_" + duty
  if (ctx[cacheKey]) return ctx[cacheKey]
  
  let buf = ctx.createBuffer(1, 8, ctx.sampleRate)
  let data = buf.getChannelData(0)
  
  // Game Boy duty cycles: 12.5%, 25%, 50%, 75%
  let seq = [0, 0, 0, 0, 0, 0, 0, 0]
  if (duty === "12_5") seq = [0, 1, 0, 0, 0, 0, 0, 0]
  if (duty === "25")   seq = [0, 1, 1, 0, 0, 0, 0, 0]
  if (duty === "50")   seq = [0, 1, 1, 1, 1, 0, 0, 0]
  if (duty === "75")   seq = [0, 1, 1, 1, 1, 1, 1, 0]
  
  let i = 0
  while (i < 8) {
    data[i] = (seq[i] === 1) ? 1.0 : -1.0
    i = i + 1
  }
  
  ctx[cacheKey] = buf
  return buf
}

fn getDmgWavetableBuffer(ctx, shape) {
  let cacheKey = "dmgWavetable_" + shape
  if (ctx[cacheKey]) return ctx[cacheKey]
  
  let buf = ctx.createBuffer(1, 32, ctx.sampleRate)
  let data = buf.getChannelData(0)
  
  // 32-sample 4-bit wave RAM shapes
  let i = 0
  while (i < 32) {
    let val = 0 // 0 to 15
    if (shape === "sawtooth") {
      val = Math.floor(i / 2) // 0 to 15
    } else if (shape === "square") {
      val = i < 16 ? 15 : 0
    } else if (shape === "sine") {
      // 4-bit sine wave
      let s = Math.sin((i / 32) * Math.PI * 2)
      val = Math.round((s + 1) * 7.5)
    } else {
      // Default to sawtooth
      val = Math.floor(i / 2)
    }
    
    // Scale 0-15 to -1.0 to 1.0
    data[i] = (val / 7.5) - 1.0
    i = i + 1
  }
  
  ctx[cacheKey] = buf
  return buf
}

fn getDmgLfsrBuffer(ctx, mode) {
  let cacheKey = "dmgLfsr_" + mode
  if (ctx[cacheKey]) return ctx[cacheKey]
  
  let steps = mode === 15 ? 32767 : 127
  let buf = ctx.createBuffer(1, steps, ctx.sampleRate)
  let data = buf.getChannelData(0)
  
  let reg = 0x7FFF
  let i = 0
  while (i < steps) {
    let bit0 = reg & 1
    let bit1 = (reg >> 1) & 1
    let feedback = bit0 ^ bit1
    
    // Shift right
    reg = reg >> 1
    
    // DMG inserts feedback at bit 14
    reg = reg | (feedback << 14)
    
    // If 7-bit mode, DMG ALSO inserts feedback at bit 6
    if (mode === 7) {
      // clear bit 6, then set it to feedback
      reg = (reg & ~(1 << 6)) | (feedback << 6)
    }
    
    // Output is bit 0, inverted
    data[i] = (reg & 1) === 0 ? 1.0 : -1.0
    i = i + 1
  }
  
  ctx[cacheKey] = buf
  return buf
}

export fn playGameBoyDmg(ctx, bus, t, midi, vel, durSec, ch, bendSemis) {
  let gp = ch.generatorParams ? ch.generatorParams : {}
  let channel = gp.channel ? gp.channel : "pulse_50" 
  // Modes: pulse_12_5, pulse_25, pulse_50, pulse_75, wavetable, noise_15, noise_7
  
  let waveShape = gp.waveShape ? gp.waveShape : "sawtooth" // for wavetable
  let decay = gp.decay != null ? gp.decay : 0.2
  let sweep = gp.sweep != null ? gp.sweep : 0 // Pitch sweep semitones
  
  let f0 = 440 * Math.pow(2, (midi + bendSemis - 69) / 12)
  let f1 = f0 * Math.pow(2, sweep / 12)
  
  let v = vel / 127
  if (v < 0) v = 0
  if (v > 1) v = 1

  let totalTime = durSec + 0.1
  let stopTime = t + totalTime
  let disconnects = []

  let src = ctx.createBufferSource()
  src.loop = true
  
  let isNoise = false

  if (channel === "noise_15") {
    src.buffer = getDmgLfsrBuffer(ctx, 15)
    isNoise = true
  } else if (channel === "noise_7") {
    src.buffer = getDmgLfsrBuffer(ctx, 7)
    isNoise = true
  } else if (channel === "wavetable") {
    src.buffer = getDmgWavetableBuffer(ctx, waveShape)
  } else {
    let duty = "50"
    if (channel === "pulse_12_5") duty = "12_5"
    if (channel === "pulse_25") duty = "25"
    if (channel === "pulse_75") duty = "75"
    src.buffer = getDmgPulseBuffer(ctx, duty)
  }

  // Set playback rate to match frequency
  if (isNoise) {
    src.playbackRate.setValueAtTime(f0 / 440, t)
    if (sweep !== 0) {
      src.playbackRate.linearRampToValueAtTime(f1 / 440, t + decay)
    }
  } else {
    let bufLen = src.buffer.length
    let rate0 = (f0 * bufLen) / ctx.sampleRate
    let rate1 = (f1 * bufLen) / ctx.sampleRate
    src.playbackRate.setValueAtTime(rate0, t)
    if (sweep !== 0) {
      src.playbackRate.linearRampToValueAtTime(rate1, t + decay)
    }
  }

  src.start(t)
  src.stop(stopTime)
  disconnects.push(src)

  let finalGain = ctx.createGain()
  
  finalGain.gain.setValueAtTime(0, t)
  finalGain.gain.linearRampToValueAtTime(v * 0.8, t + 0.005)
  
  // Hardware linear decay envelope
  let decTime = decay
  if (decTime < 0.01) decTime = 0.01
  finalGain.gain.linearRampToValueAtTime(0, t + 0.005 + decTime)
  
  // Hard cutoff
  finalGain.gain.setValueAtTime(0, t + durSec + 0.01)

  src.connect(finalGain)
  finalGain.connect(bus.input)
  disconnects.push(finalGain)

  setTimeout(() => {
    let di = 0
    while (di < disconnects.length) {
      disconnects[di].disconnect()
      di = di + 1
    }
  }, totalTime * 1000)
}
