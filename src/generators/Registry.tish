      label: "Guitar",
      description: "Karplus-Strong plucked electric guitar — string model + palm mute + drive + body. Pairs with the chord voice for strums."
    },
    {
      id: "clap",
      label: "Clap",
      description: "The Clap — handclap engine: hand count, timing spread, hand size, brightness, room tail, and clusters (single / double / many-hand crowd)."
    },
    {
