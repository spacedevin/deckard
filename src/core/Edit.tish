// emit/edit — the UI convenience over ingest (Plan: "emit reads the owning statement's current values
// from the fold and re-emits it with the single changed field"). TPL statements are coarse (one `mix`
// line carries gain+pan+eq+mute+solo), so a single-field UI change re-emits that whole statement with
// current values for the untouched fields. The result is one minimal TPL fragment fed to ingest — the
// same door peers and the agent use. This is how "the UI is just a TPL client" becomes literal.

import { formatTplFloat } from '../tpl/Format.tish'
import { generatorIdToTpl, stepLaneLine, noteLine } from '../tpl/Emit.tish'
import { findChannelById } from '../tpl/Apply.tish'
import { scaleRootNames } from '../model/Scale.tish'
import { camelToSnake, paramKeyToCamel } from '../tpl/RegistryMap.tish'

fn f(v) {
  return formatTplFloat(Number(v))
}

fn trackHeader(ch) {
  let gid = ch.generatorId ? ch.generatorId : "basicOsc"
  let genTok = (ch.macroName != null) ? ch.macroName : generatorIdToTpl(gid)
  let s = "track " + ch.name + " id " + ch.id + " gen " + genTok
  // Preserve the pattern length (`* N`) — applyTrackBody re-reads it on every body apply and would otherwise
  // reset a multi-bar channel to 1 bar on ANY incremental edit (mix/fx/pattern). Mirrors emitProject's order
  // (loop count before macro overrides).
  if (ch.patternBars != null) {
    let pn = Math.floor(Number(ch.patternBars))
    if (pn >= 2 && pn === pn) {
      s = s + " * " + String(pn)
    }
  }
  // CRITICAL: a macro re-expands from this header on apply, so the overrides MUST ride along — otherwise
  // any fx/voice/mix edit re-emits a bare `gen <macro>` and resets the macro to its defaults (the
  // "change cutoff → bass becomes unrecognizable, no way back" bug).
  if (ch.macroName != null && ch.macroParams) {
    let mk = Object.keys(ch.macroParams)
    let i = 0
    while (i < mk.length) {
      s = s + " " + mk[i] + " " + String(ch.macroParams[mk[i]])
      i = i + 1
    }
  }
  return s
}

fn mixLine(ch, param, value) {
  let gain = ch.gain != null ? ch.gain : 0.85
  let pan = ch.pan != null ? ch.pan : 0
  let mute = ch.mute ? 1 : 0
  let solo = ch.solo ? 1 : 0
  let lo = ch.eqLo != null ? ch.eqLo : 0
  let mid = ch.eqMid != null ? ch.eqMid : 0
  let hi = ch.eqHi != null ? ch.eqHi : 0
  if (param === "gain") { gain = Number(value) }
  else if (param === "pan") { pan = Number(value) }
  else if (param === "mute") { mute = value ? 1 : 0 }
  else if (param === "solo") { solo = value ? 1 : 0 }
  else if (param === "eq_lo") { lo = Number(value) }
  else if (param === "eq_mid") { mid = Number(value) }
  else if (param === "eq_hi") { hi = Number(value) }
  return "  mix gain " + f(gain) + " pan " + f(pan) + " mute " + String(mute) + " solo " + String(solo) + " eq_lo " + f(lo) + " eq_mid " + f(mid) + " eq_hi " + f(hi)
}

fn fxLine(ch, param, value) {
  let rev = ch.reverbSend != null ? ch.reverbSend : 0
  let drive = ch.drive != null ? ch.drive : 0
  let lfor = ch.lfoRate != null ? ch.lfoRate : 0
  let lfod = ch.lfoDepth != null ? ch.lfoDepth : 0
  let cut = ch.filterCutoff != null ? ch.filterCutoff : 8000
  let res = ch.filterQ != null ? ch.filterQ : 1
  if (param === "reverb" || param === "reverb_send") { rev = Number(value) }
  else if (param === "drive") { drive = Number(value) }
  else if (param === "lfo_rate") { lfor = Number(value) }
  else if (param === "lfo_depth") { lfod = Number(value) }
  else if (param === "cutoff") { cut = Number(value) }
  else if (param === "res") { res = Number(value) }
  return "  fx reverb_send " + f(rev) + " drive " + f(drive) + " lfo_rate " + f(lfor) + " lfo_depth " + f(lfod) + " cutoff " + f(cut) + " res " + f(res)
}

fn voiceLine(ch, param, value) {
  let oct = ch.octave != null ? Math.floor(ch.octave) : 0
  let arp = (ch.arp != null && ch.arp !== "") ? ch.arp : "off"
  let chord = (ch.chord != null && ch.chord !== "") ? ch.chord : "off"
  let arpRate = (ch.arpRate != null && ch.arpRate !== "") ? ch.arpRate : "auto"
  let inversion = (ch.inversion != null && ch.inversion !== "") ? ch.inversion : "root"
  let strum = ch.strum != null ? ch.strum : 0
  if (param === "octave") { oct = Math.floor(Number(value)) }
  else if (param === "arp") { arp = String(value) }
  else if (param === "chord") { chord = String(value) }
  else if (param === "arprate") { arpRate = String(value) }
  else if (param === "inversion") { inversion = String(value) }
  else if (param === "strum") { strum = Number(value) }
  // ALWAYS emit every voice field, even at its default. This `voice` fragment is the authoritative edit, and
  // applyTrackBody only SETS the fields whose token is present — it never resets an absent one. Omitting a
  // defaulted field (inversion=root, arprate=auto, strum=0) made it impossible to turn a knob BACK to its
  // default: the value stuck at the last non-default (the "Inv knob locks at 1st/2nd, can't return to root" bug).
  let line = "  voice octave " + String(oct) + " arp " + arp + " chord " + chord
  line = line + " arprate " + arpRate
  line = line + " inversion " + inversion
  line = line + " strum " + String(Math.round(strum * 1000) / 1000)
  return line
}

fn stepsLine(value) {
  let o = "  steps"
  let i = 0
  while (i < 16) {
    let s = value && i < value.length ? value[i] : null
    let on = false
    if (s === true) {
      on = true
    } else if (s && s.on) {
      on = true
    }
    o = o + (on ? " x" : " .")
    i = i + 1
  }
  return o
}

fn masterMixLine(project, param, value) {
  let mm = project.masterMixer ? project.masterMixer : {}
  let lo = mm.eqLo != null ? mm.eqLo : 0
  let mid = mm.eqMid != null ? mm.eqMid : 0
  let hi = mm.eqHi != null ? mm.eqHi : 0
  let comp = mm.compEnabled === false ? 0 : 1
  let reverb = mm.reverbEnabled === false ? 0 : 1
  if (param === "eq_lo") { lo = Number(value) }
  else if (param === "eq_mid") { mid = Number(value) }
  else if (param === "eq_hi") { hi = Number(value) }
  else if (param === "comp") { comp = value ? 1 : 0 }
  else if (param === "reverb") { reverb = value ? 1 : 0 }
  return "master_mix eq_lo " + f(lo) + " eq_mid " + f(mid) + " eq_hi " + f(hi) + " comp " + String(comp) + " reverb " + String(reverb)
}

fn actorMixLine(project, lane, param, value) {
  let am = (project.actorMixer && project.actorMixer[lane]) ? project.actorMixer[lane] : {}
  let gain = am.gain != null ? am.gain : 1
  let lo = am.eqLo != null ? am.eqLo : 0
  let mid = am.eqMid != null ? am.eqMid : 0
  let hi = am.eqHi != null ? am.eqHi : 0
  let mute = am.mute ? 1 : 0
  let solo = am.solo ? 1 : 0
  if (param === "gain") { gain = Number(value) }
  else if (param === "eq_lo") { lo = Number(value) }
  else if (param === "eq_mid") { mid = Number(value) }
  else if (param === "eq_hi") { hi = Number(value) }
  else if (param === "mute") { mute = value ? 1 : 0 }
  else if (param === "solo") { solo = value ? 1 : 0 }
  let o = "actor_mix " + lane + " gain " + f(gain) + " eq_lo " + f(lo) + " eq_mid " + f(mid) + " eq_hi " + f(hi)
  if (mute === 1) { o = o + " mute 1" }
  if (solo === 1) { o = o + " solo 1" }
  return o
}

/**
 * Build the minimal TPL fragment for an addressed edit. Addresses (value type):
 *   bpm | launch_quant | swing                     (number)
 *   xfade                                           ([x,y] or {x,y})
 *   main_deck                                       ("live"|"local")
 *   master/<eq_lo|eq_mid|eq_hi>                     (number)
 *   master/<comp|reverb>                            (bool — master glue compressor / reverb send bus on/off)
 *   actor/<lane>/<gain|eq_lo|eq_mid|eq_hi|mute|solo>(number|bool)
 *   track/<id>/mix/<gain|pan|mute|solo|eq_*>        (number|bool)
 *   track/<id>/fx/<reverb|drive|cutoff|res|lfo_*>   (number)
 *   track/<id>/voice/<octave|arp|chord>             (number|string)
 *   track/<id>/gen/<param>                          (number|string)  // param in TPL snake_case
 *   track/<id>/deck                                 ({deck,slot})
 *   track/<id>/steps                                (array of bool/{on})
 * Returns "" for unknown/invalid addresses (caller can ignore — no-op edit).
 */
export fn fragmentForEdit(project, address, value) {
  let parts = String(address).split("/")
  let head = parts[0]

  if (head === "bpm" || head === "launch_quant" || head === "swing") {
    return head + " " + (head === "launch_quant" ? String(Math.floor(Number(value))) : f(value))
  }
  if (head === "main_deck") {
    return "main_deck " + (value === "local" ? "local" : "live")
  }
  // Drawable param automation: address auto/<channelId>/<camelParam>, value = 16 step-aligned values
  // (beats 0,0.25,…,3.75). Emits a top-level `auto <id> gen <snake_param>` block — applyAutos merges/replaces
  // that one param's curve (master-gated, like all `auto`). The lane re-emits the whole 16-point curve.
  if (head === "auto" && parts.length >= 3) {
    let cid = parts[1]
    let prm = camelToSnake(parts[2])
    let vals = Array.isArray(value) ? value : []
    let o = "auto " + cid + " gen " + prm
    let ai = 0
    while (ai < 16) {
      let av = ai < vals.length ? Number(vals[ai]) : 0
      o = o + "\n  " + f(ai * 0.25) + " " + f(av)
      ai = ai + 1
    }
    return o
  }
  // Scale lock: value = {root: 0..11, mode: name} to set, or "off"/null to clear.
  if (head === "scale") {
    if (value == null || value === "off" || (value && (value.mode === "off" || value.root == null))) {
      return "scale off"
    }
    let rn = scaleRootNames()
    let pc = Math.floor(Number(value.root))
    if (pc < 0 || pc > 11 || pc !== pc) {
      return "scale off"
    }
    return "scale " + rn[pc] + " " + String(value.mode)
  }
  if (head === "xfade") {
    let x = 0.5
    let y = 0.5
    if (Array.isArray(value)) {
      x = Number(value[0])
      y = value.length > 1 ? Number(value[1]) : 0.5
    } else if (value) {
      x = Number(value.x)
      y = value.y != null ? Number(value.y) : 0.5
    }
    return "xfade " + f(x) + " " + f(y)
  }
  if (head === "master" && parts.length >= 2) {
    return masterMixLine(project, parts[1], value)
  }
  if (head === "actor" && parts.length >= 3) {
    return actorMixLine(project, parts[1], parts[2], value)
  }
  if (head === "track" && parts.length >= 3) {
    let ch = findChannelById(project, parts[1])
    if (!ch) {
      return ""
    }
    let section = parts[2]
    let param = parts.length >= 4 ? parts[3] : null
    let hdr = trackHeader(ch)
    if (section === "name") {
      let gid = ch.generatorId ? ch.generatorId : "basicOsc"
      let genTok = (ch.macroName != null) ? ch.macroName : generatorIdToTpl(gid)
      let s = "track " + String(value) + " id " + ch.id + " gen " + genTok
      if (ch.patternBars != null) {
        let pn = Math.floor(Number(ch.patternBars))
        if (pn >= 2 && pn === pn) {
          s = s + " * " + String(pn)
        }
      }
      if (ch.macroName != null && ch.macroParams) {
        let mk = Object.keys(ch.macroParams)
        let i = 0
        while (i < mk.length) {
          s = s + " " + mk[i] + " " + String(ch.macroParams[mk[i]])
          i = i + 1
        }
      }
      return s
    }
    if (section === "mix") {
      return hdr + "\n" + mixLine(ch, param, value)
    }
    if (section === "fx") {
      return hdr + "\n" + fxLine(ch, param, value)
    }
    if (section === "voice") {
      return hdr + "\n" + voiceLine(ch, param, value)
    }
    if (section === "gen" && param != null) {
      return hdr + "\n" + "  gen " + param + " " + (typeof value === "number" ? f(value) : String(value))
    }
    // Generator TYPE change (resets params on apply): re-emit the track header with the new gen token.
    if (section === "gen_type") {
      return "track " + ch.name + " id " + ch.id + " gen " + generatorIdToTpl(String(value))
    }
    // ADSR envelope as one statement (value = {a,d,s,r}).
    if (section === "adsr") {
      let a = value && value.a != null ? value.a : 0.01
      let d = value && value.d != null ? value.d : 0.1
      let s = value && value.s != null ? value.s : 0.7
      let r = value && value.r != null ? value.r : 0.2
      return hdr + "\n" + "  adsr a " + f(a) + " d " + f(d) + " s " + f(s) + " r " + f(r)
    }
    if (section === "deck") {
      let dl = value && value.deck ? value.deck : "live"
      let line = hdr + "\n" + "  deck " + String(dl)
      if (value && value.slot != null && Math.floor(Number(value.slot)) === Math.floor(Number(value.slot))) {
        line = line + " slot " + String(Math.floor(Number(value.slot)))
      }
      return line
    }
    if (section === "steps") {
      return hdr + "\n" + stepsLine(value)
    }
    // The WHOLE pattern as one statement: on/off + the 4 per-step parameter-lock lanes. `value` is the
    // channel's full steps array ({on,vel,prob,ratchet,nudge}). Used by the step grid's live lock editing
    // (velocity drag, prob/ratchet/nudge lanes) so a single cell change re-emits a complete, gated,
    // broadcast, round-trip-safe pattern — no direct model mutation (the UI stays a pure TPL client).
    if (section === "pattern") {
      let o = hdr + "\n" + stepsLine(value) + "\n"
      o = o + stepLaneLine(value, "step_vel", "vel", 100, true)
      o = o + stepLaneLine(value, "step_prob", "prob", 1, false)
      o = o + stepLaneLine(value, "step_ratchet", "ratchet", 1, true)
      o = o + stepLaneLine(value, "step_nudge", "nudge", 0, false)
      return o
    }
    // The WHOLE pianoNotes array as one statement (analogous to `pattern` for steps): the track header + one
    // `note … [p][r][n]` line per note. applyTrackBody replaces ch.pianoNotes wholesale from these lines, so a
    // full-array re-emit is the right semantics. Used by the piano grid's note edits + lock lanes so they
    // broadcast to peers + round-trip (today's piano edits mutate locally and never reach ingest).
    if (section === "notes") {
      let o = hdr
      let arr = Array.isArray(value) ? value : []
      if (arr.length === 0) {
        // Explicit "no notes" — else an empty note set reads as a mix-only edit and apply leaves notes intact
        // (so deleting the last note would be a no-op). `notes_clear` forces ch.pianoNotes = [].
        return o + "\n  notes_clear"
      }
      let i = 0
      while (i < arr.length) {
        o = o + "\n" + noteLine(arr[i])
        i = i + 1
      }
      return o
    }
  }
  return ""
}

/**
 * Read the CURRENT scalar at an undoable address (the same fields fragmentForEdit re-emits), so the inverse
 * of an edit is `fragmentForEdit(project, address, readAddr(...))` — the owning statement as it stands now.
 * Covers the reversible scalar addresses (mix/fx/voice/gen/master/actor/bpm/swing/scale/xfade). Returns
 * `undefined` for addresses that aren't cleanly reversible (deck/steps/launch_quant/patch+matrix directives/…) —
 * those are simply not pushed onto the undo stack ("undo only in places").
 */
export fn readAddr(project, address) {
  let parts = String(address).split("/")
  let head = parts[0]
  if (head === "bpm") {
    return project.bpm != null ? project.bpm : 120
  }
  if (head === "swing") {
    return project.swing != null ? project.swing : 0
  }
  if (head === "scale") {
    if (project.scaleRoot == null || project.scaleMode == null) {
      return "off"
    }
    return { root: project.scaleRoot, mode: project.scaleMode }
  }
  if (head === "xfade") {
    let x = project.transportCrossfade != null ? project.transportCrossfade : 0.5
    let y = project.transportCrossfadeY != null ? project.transportCrossfadeY : 0.5
    return [x, y]
  }
  if (head === "launch_quant") {
    return project.launchQuant != null ? Math.floor(project.launchQuant) : undefined
  }
  if (head === "main_deck") {
    return project.transportMainDeck === "local" ? "local" : "live"
  }
  if (head === "master" && parts.length >= 2) {
    let mm = project.masterMixer ? project.masterMixer : {}
    let p = parts[1]
    if (p === "eq_lo") { return mm.eqLo != null ? mm.eqLo : 0 }
    if (p === "eq_mid") { return mm.eqMid != null ? mm.eqMid : 0 }
    if (p === "eq_hi") { return mm.eqHi != null ? mm.eqHi : 0 }
    if (p === "comp") { return mm.compEnabled !== false }
    if (p === "reverb") { return mm.reverbEnabled !== false }
    return undefined
  }
  if (head === "actor" && parts.length >= 3) {
    let am = (project.actorMixer && project.actorMixer[parts[1]]) ? project.actorMixer[parts[1]] : {}
    let p = parts[2]
    if (p === "gain") { return am.gain != null ? am.gain : 1 }
    if (p === "eq_lo") { return am.eqLo != null ? am.eqLo : 0 }
    if (p === "eq_mid") { return am.eqMid != null ? am.eqMid : 0 }
    if (p === "eq_hi") { return am.eqHi != null ? am.eqHi : 0 }
    if (p === "mute") { return am.mute === true }
    if (p === "solo") { return am.solo === true }
    return undefined
  }
  if (head === "track" && parts.length >= 3) {
    let ch = findChannelById(project, parts[1])
    if (!ch) {
      return undefined
    }
    let section = parts[2]
    // mix/fx/voice/gen carry a 4th param part; steps/pattern/notes/deck are section-only (3 parts).
    let p = parts.length >= 4 ? parts[3] : null
    if (section === "name") {
      return ch.name
    }
    if (section === "mix") {
      if (p === "gain") { return ch.gain != null ? ch.gain : 0.85 }
      if (p === "pan") { return ch.pan != null ? ch.pan : 0 }
      if (p === "mute") { return ch.mute === true }
      if (p === "solo") { return ch.solo === true }
      if (p === "eq_lo") { return ch.eqLo != null ? ch.eqLo : 0 }
      if (p === "eq_mid") { return ch.eqMid != null ? ch.eqMid : 0 }
      if (p === "eq_hi") { return ch.eqHi != null ? ch.eqHi : 0 }
    }
    if (section === "fx") {
      if (p === "reverb" || p === "reverb_send") { return ch.reverbSend != null ? ch.reverbSend : 0 }
      if (p === "drive") { return ch.drive != null ? ch.drive : 0 }
      if (p === "lfo_rate") { return ch.lfoRate != null ? ch.lfoRate : 0 }
      if (p === "lfo_depth") { return ch.lfoDepth != null ? ch.lfoDepth : 0 }
      if (p === "cutoff") { return ch.filterCutoff != null ? ch.filterCutoff : 8000 }
      if (p === "res") { return ch.filterQ != null ? ch.filterQ : 1 }
    }
    if (section === "voice") {
      if (p === "octave") { return ch.octave != null ? Math.floor(ch.octave) : 0 }
      if (p === "arp") { return (ch.arp != null && ch.arp !== "") ? ch.arp : "off" }
      if (p === "chord") { return (ch.chord != null && ch.chord !== "") ? ch.chord : "off" }
      if (p === "arprate") { return (ch.arpRate != null && ch.arpRate !== "") ? ch.arpRate : "auto" }
      if (p === "inversion") { return (ch.inversion != null && ch.inversion !== "") ? ch.inversion : "root" }
      if (p === "strum") { return ch.strum != null ? ch.strum : 0 }
    }
    // Generator params (every instrument knob: waveform/ratio/cutoff/attack/decay/sustain/release/…) — the
    // current value lives in ch.generatorParams keyed CAMEL-case; the address param is TPL snake_case. Returning
    // it makes instrument adjustments undoable (they emit through gen/<param> like a fader, but weren't reversible
    // before). undefined (param never set) just isn't pushed — the panel seeds defaults so it's normally present.
    if (section === "gen") {
      if (!ch.generatorParams) {
        return undefined
      }
      let cur = ch.generatorParams[paramKeyToCamel(p)]
      // Return ONLY a real number or non-empty string. A param the generator doesn't have reads back as a
      // missing key — NOT reversible, so it must not be pushed (else the inverse is a bogus `gen <p> undefined`).
      // The `typeof` guard is deliberate: lattish's null/undefined equality is unreliable for a missing key, so
      // returning the raw value (or testing it with ==/=== null) leaks the missing param onto the undo stack.
      if (typeof cur === "number" && cur === cur) {
        return cur
      }
      if (typeof cur === "string" && cur.length > 0) {
        return cur
      }
      return undefined
    }
    // Sequencer steps + the whole pattern (steps + the 4 lock lanes): value is the channel's steps array, so the
    // inverse is the pre-edit array re-emitted. These ARE undoable now (they emit through the pattern/steps door
    // but readAddr was missing them, so step toggles / velocity drags weren't being captured).
    if (section === "steps" || section === "pattern") {
      return Array.isArray(ch.steps) ? ch.steps : undefined
    }
    // Piano-roll notes: value is the whole pianoNotes array (empty → notes_clear). [] is a valid inverse.
    if (section === "notes") {
      return Array.isArray(ch.pianoNotes) ? ch.pianoNotes : []
    }
    // Deck routing ({deck, slot}).
    if (section === "deck") {
      let dk = { deck: ch.deck != null ? ch.deck : "live" }
      if (ch.deckSlot != null) {
        dk.slot = ch.deckSlot
      }
      return dk
    }
    return undefined
  }
  return undefined
}

/**
 * Bind fragmentForEdit + ingest into the UI's write verbs:
 *   emit(address, value)  — addressed document edit (captured for undo when the address is reversible)
 *   directive(line)       — a raw `@ …` control line (cue/throw/transport/launch); NOT undoable (live perf)
 *   undo() / redo()       — re-ingest the inverse / forward fragment through the SAME gated door, so undo
 *                           is ownership-checked, broadcast, and round-trip-safe (never a side-channel).
 * Consecutive edits to the SAME address coalesce into one undo step (a fader drag = a single undo).
 * `ctxProvider()` returns the local actor ctx {actorId, skillIds, …}.
 */
export fn createEditor(store, ingest, ctxProvider) {
  let undoStack = []
  let redoStack = []
  let MAX_UNDO = 200
  fn record(address, inverse, forward) {
    let n = undoStack.length
    if (n > 0 && undoStack[n - 1].address === address) {
      // Same control edited consecutively (e.g. a drag) — keep the original inverse, move the destination.
      undoStack[n - 1].forward = forward
    } else {
      undoStack.push({ address: address, inverse: inverse, forward: forward })
      if (undoStack.length > MAX_UNDO) {
        undoStack.shift()
      }
    }
    redoStack = []
  }
  fn emit(address, value) {
    let frag = fragmentForEdit(store.project, address, value)
    if (frag === "") {
      return null
    }
    // Capture the inverse (the owning line as it stands now) BEFORE applying — only for reversible addresses.
    // `!= null` (loose) skips BOTH null and undefined: readAddr returns nothing for non-reversible addresses,
    // and in lattish a `return undefined` reads back as null (and a missing object key is null too), so a
    // strict `!== undefined` would wrongly record a bogus inverse for those.
    let old = readAddr(store.project, address)
    if (old != null) {
      let inverse = fragmentForEdit(store.project, address, old)
      if (inverse !== "" && inverse !== frag) {
        record(address, inverse, frag)
      }
    }
    return ingest(frag, ctxProvider ? ctxProvider() : null)
  }
  fn directive(line) {
    return ingest(String(line), ctxProvider ? ctxProvider() : null)
  }
  // Like directive(), but RECORDS an undo step: forward = the line to ingest now, inverse = the same statement
  // as it stood BEFORE this edit (the caller captures it, since a coarse directive — e.g. a whole gen_block —
  // has no readAddr inverse). Consecutive edits sharing coalesceAddr collapse to one undo step (a knob drag).
  // Used by the patch / matrix editors so module edits broadcast AND undo, just like a fader.
  fn directiveUndoable(forwardLine, inverseLine, coalesceAddr) {
    let fwd = String(forwardLine)
    if (inverseLine != null) {
      let inv = String(inverseLine)
      if (inv !== "" && inv !== fwd) {
        record(coalesceAddr != null ? coalesceAddr : "directive", inv, fwd)
      }
    }
    return ingest(fwd, ctxProvider ? ctxProvider() : null)
  }
  fn undo() {
    if (undoStack.length === 0) {
      return false
    }
    let e = undoStack.pop()
    redoStack.push(e)
    ingest(e.inverse, ctxProvider ? ctxProvider() : null)
    return true
  }
  fn redo() {
    if (redoStack.length === 0) {
      return false
    }
    let e = redoStack.pop()
    undoStack.push(e)
    ingest(e.forward, ctxProvider ? ctxProvider() : null)
    return true
  }
  fn canUndo() {
    return undoStack.length > 0
  }
  fn canRedo() {
    return redoStack.length > 0
  }
  return { emit: emit, directive: directive, directiveUndoable: directiveUndoable, undo: undo, redo: redo, canUndo: canUndo, canRedo: canRedo }
}
