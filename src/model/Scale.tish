// Host scale lock: snap pitches at play time. Language vocab lives in @spacedevin/deck.
import {
  scaleIntervals,
  scaleRootNames,
  scaleModeNames,
  parseScaleRoot
} from '@spacedevin/deck'

export { scaleIntervals, scaleRootNames, scaleModeNames, parseScaleRoot }

// Snap one MIDI pitch onto the scale (nearest degree; ties round down so the key's character holds). A pitch
// already in the scale is returned unchanged; octaves are preserved.
export fn snapToScale(pitch, root, mode) {
  if (root === null) {
    return pitch
  }
  let ivs = scaleIntervals(mode)
  if (ivs.length >= 12) {
    return pitch
  }
  let p = Math.round(pitch)
  let rel = ((p - root) % 12 + 12) % 12
  let i = 0
  while (i < ivs.length) {
    if (ivs[i] === rel) {
      return p
    }
    i = i + 1
  }
  let best = ivs[0]
  let bestDist = 99
  let j = 0
  while (j < ivs.length) {
    let d0 = Math.abs(ivs[j] - rel)
    let d1 = Math.abs(ivs[j] - rel + 12)
    let d2 = Math.abs(ivs[j] - rel - 12)
    let d = d0 < d1 ? d0 : d1
    if (d2 < d) {
      d = d2
    }
    if (d < bestDist) {
      bestDist = d
      best = ivs[j]
    }
    j = j + 1
  }
  let snapped = p - rel + best
  if (snapped - p > 6) {
    snapped = snapped - 12
  }
  if (p - snapped > 6) {
    snapped = snapped + 12
  }
  return snapped
}

export fn projectScaleActive(project) {
  return (project !== null) && (project.scaleRoot !== null) && (project.scaleMode !== null) && project.scaleMode !== "" && project.scaleMode !== "off"
}

export fn projectSnapPitch(project, pitch) {
  if (!projectScaleActive(project)) {
    return pitch
  }
  return snapToScale(pitch, project.scaleRoot, project.scaleMode)
}
