// DJ-style deck split by PLAYER: Deck A = the host (local lane), Deck B = the connected client
// (any remote / agent lane). Each player owns a deck — Deck B only populates when a client/agent is
// connected and owns channels, which makes the connection visible. (More decks later for >2 players.)
// The crossfader (project.transportCrossfade, 0..1) equal-power blends the two decks into main out.

import { channelActorLane } from './MixerRouting.tish'

export fn normalizeMainDeck(project) {
  if (!project) {
    return "live"
  }
  let md = project.transportMainDeck
  if (md === "local") {
    return "local"
  }
  return "live"
}

/** "A" = host deck (local lane); "B" = client deck (any non-local / agent lane). */
export fn channelDeck(project, ch) {
  if (!ch) {
    return "A"
  }
  if (channelActorLane(ch, project) === "local") {
    return "A"
  }
  return "B"
}

/** Crossfader position 0..1 (0 = Deck A / host, 1 = Deck B / client). */
export fn crossfadeValue(project) {
  if (!project) {
    return 0.5
  }
  let x = project.transportCrossfade
  if (typeof x !== "number" || x !== x) {
    return normalizeMainDeck(project) === "live" ? 1 : 0
  }
  if (x < 0) {
    x = 0
  }
  if (x > 1) {
    x = 1
  }
  return x
}

/** Equal-power gain multiplier for this channel given the crossfader position. */
export fn deckMainOutGainMultiplier(project, ch) {
  let x = crossfadeValue(project)
  let gA = Math.cos((x * Math.PI) / 2)
  let gB = Math.sin((x * Math.PI) / 2)
  if (channelDeck(project, ch) === "B") {
    return gB
  }
  return gA
}

/** True if this channel's deck still has audible crossfader gain (drives note triggering). */
export fn channelHeardOnMainDeck(project, ch) {
  if (!ch) {
    return false
  }
  return deckMainOutGainMultiplier(project, ch) > 0.0015
}
