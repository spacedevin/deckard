// Session / clip launcher: named patterns per track, grid of scenes (columns).
// Channel rack + piano still edit ch.steps / ch.pianoNotes; main clip mirrors for emit + playback.

import { makeStep, cloneStep, clonePianoNote } from './Project.tish'
import { promoteChannelToBars } from './Edits.tish'
import { deepCloneParams } from './InstrumentPresets.tish'

// ---- Per-clip instrument snapshot ("store" mode) ----
// When ch.clipInstrMode === "store", saving a scene also captures the full instrument.

/// Snapshot every sound-relevant field from a channel into a plain object.
fn snapshotInstrument(ch) {
  let snap = {
    generatorId: ch.generatorId,
    generatorParams: deepCloneParams(ch.generatorParams)
  }
  if (ch.generatorSpec) {
    snap.generatorSpec = deepCloneParams(ch.generatorSpec)
  }
  if (ch.macroName !== null && ch.macroName !== undefined) {
    snap.macroName = ch.macroName
  }
  if (ch.macroParams) {
    snap.macroParams = deepCloneParams(ch.macroParams)
  }
  snap.fx = {
    reverbSend: ch.reverbSend,
    drive: ch.drive,
    filterCutoff: ch.filterCutoff,
    filterQ: ch.filterQ,
    lfoRate: ch.lfoRate,
    lfoDepth: ch.lfoDepth
  }
  snap.voice = {
    octave: ch.octave,
    arp: ch.arp,
    chord: ch.chord
  }
  return snap
}

/// Apply a previously-snapshotted instrument back onto a channel.
fn applyInstrument(ch, snap) {
  if (!snap) {
    return
  }
  ch.generatorId = snap.generatorId
  ch.generatorParams = deepCloneParams(snap.generatorParams)
  if (snap.generatorSpec) {
    ch.generatorSpec = deepCloneParams(snap.generatorSpec)
  } else {
    ch.generatorSpec = null
  }
  ch.macroName = snap.macroName !== null && snap.macroName !== undefined ? snap.macroName : null
  ch.macroParams = snap.macroParams ? deepCloneParams(snap.macroParams) : null
  let fx = snap.fx ? snap.fx : {}
  ch.reverbSend = fx.reverbSend !== null && fx.reverbSend !== undefined ? fx.reverbSend : 0
  ch.drive = fx.drive !== null && fx.drive !== undefined ? fx.drive : 0
  ch.filterCutoff = fx.filterCutoff !== null && fx.filterCutoff !== undefined ? fx.filterCutoff : 20000
  ch.filterQ = fx.filterQ !== null && fx.filterQ !== undefined ? fx.filterQ : 0.7
  ch.lfoRate = fx.lfoRate !== null && fx.lfoRate !== undefined ? fx.lfoRate : 0
  ch.lfoDepth = fx.lfoDepth !== null && fx.lfoDepth !== undefined ? fx.lfoDepth : 0
  let voice = snap.voice ? snap.voice : {}
  ch.octave = voice.octave !== null && voice.octave !== undefined ? voice.octave : 0
  ch.arp = voice.arp !== null && voice.arp !== undefined ? voice.arp : "off"
  ch.chord = voice.chord !== null && voice.chord !== undefined ? voice.chord : "off"
}

// --- single-bar copy helpers (for "load/save 1 bar" into the currently-viewed bar) ---
fn barOfBeat(beat) {
  return Math.floor(beat / 4 + 0.0001)
}

// Notes that OVERLAP `bar` (not just start in it — a held bass note starting earlier still sounds in
// this bar), clipped to the bar and returned relative to bar 0. Used by LOAD-1-bar.
fn notesClippedToBar(notes, bar) {
  let out = []
  if (!notes) {
    return out
  }
  let barStart = bar * 4
  let barEnd = barStart + 4
  let i = 0
  while (i < notes.length) {
    let n = notes[i]
    let ns = n.startBeat
    let ne = n.startBeat + n.durBeats
    if (ne > barStart + 0.0001 && ns < barEnd - 0.0001) {
      let cs = ns < barStart ? barStart : ns
      let ce = ne > barEnd ? barEnd : ne
      let dur = ce - cs
      if (dur > 0.0001) {
        let cn = clonePianoNote(n)
        cn.startBeat = cs - barStart
        cn.durBeats = dur
        out.push(cn)
      }
    }
    i = i + 1
  }
  return out
}

// Notes that START inside `bar`, returned relative to bar 0 and clipped to the bar length. This mirrors
// exactly what the sequencer's piano roll DRAWS for that bar (it renders a note only where the note
// begins) — so SAVE-1-bar captures the bar you SEE, not held-over notes from earlier bars. A sustained
// chord that begins in bar 0 therefore saves only from VIEW 1, and VIEW 2+ save an empty row, matching
// the rack.
fn notesStartingInBar(notes, bar) {
  let out = []
  if (!notes) {
    return out
  }
  let barStart = bar * 4
  let barEnd = barStart + 4
  let i = 0
  while (i < notes.length) {
    let n = notes[i]
    let ns = n.startBeat
    if (ns >= barStart - 0.0001 && ns < barEnd - 0.0001) {
      let ce = ns + n.durBeats
      if (ce > barEnd) {
        ce = barEnd
      }
      let dur = ce - ns
      if (dur > 0.0001) {
        let cn = clonePianoNote(n)
        cn.startBeat = ns - barStart
        cn.durBeats = dur
        out.push(cn)
      }
    }
    i = i + 1
  }
  return out
}

fn copyBarSteps(destSteps, destBar, srcSteps, srcBar) {
  // A pattern may store fewer step-bars than patternBars (a 1-bar pattern tiled across N bars), so
  // wrap the source index — reading "bar 1" of a 16-step pattern reads bar 0 again, not out of range.
  let srcLen = srcSteps ? srcSteps.length : 0
  let i = 0
  while (i < 16) {
    let s = srcLen > 0 ? srcSteps[(srcBar * 16 + i) % srcLen] : null
    destSteps[destBar * 16 + i] = cloneStep(s)
    i = i + 1
  }
}

// Replace destNotes' notes in destBar with srcNotes overlapping srcBar (clipped, shifted to destBar).
fn spliceBarNotes(destNotes, destBar, srcNotes, srcBar) {
  let out = []
  let i = 0
  while (i < destNotes.length) {
    if (barOfBeat(destNotes[i].startBeat) !== destBar) {
      out.push(destNotes[i])
    }
    i = i + 1
  }
  let clipped = notesClippedToBar(srcNotes, srcBar)
  let j = 0
  while (j < clipped.length) {
    let n = clipped[j]
    let cn = clonePianoNote(n)
    cn.startBeat = n.startBeat + destBar * 4
    out.push(cn)
    j = j + 1
  }
  return out
}

fn tileStepsToBars(steps, bars) {
  let want = bars * 16
  let out = []
  let i = 0
  while (i < want) {
    let s = steps && steps.length > 0 ? steps[i % steps.length] : null
    out.push(cloneStep(s))
    i = i + 1
  }
  return out
}

export fn defaultMainClipId(ch) {
  return ch.id + "_main"
}

fn copySteps16FromChannel(ch) {
  let out = []
  let si = 0
  while (si < 16) {
    out.push(cloneStep(ch.steps[si]))
    si = si + 1
  }
  return out
}

/// bars*16 steps for a clip: copies the channel's steps directly when it already stores multiple bars
/// (per-bar edits), or tiles its single bar across `bars` otherwise.
export fn stepsForClip(ch, bars) {
  let want = Math.max(1, Math.floor(Number(bars))) * 16
  let src = ch.steps
  let n = src.length
  if (n < 1) {
    n = 1
  }
  let out = []
  let i = 0
  while (i < want) {
    out.push(cloneStep(src[i % n]))
    i = i + 1
  }
  return out
}

export fn tileStepsPattern(base16, bars) {
  let b = Math.floor(Number(bars))
  if (b < 1 || b !== b) {
    b = 1
  }
  let out = []
  let bi = 0
  while (bi < b) {
    let si = 0
    while (si < 16) {
      out.push(cloneStep(base16[si]))
      si = si + 1
    }
    bi = bi + 1
  }
  return out
}

export fn copyPianoNotes(arr) {
  if (!arr || arr.length === 0) {
    return []
  }
  let out = []
  let i = 0
  while (i < arr.length) {
    out.push(clonePianoNote(arr[i]))
    i = i + 1
  }
  return out
}

export fn copyStepPitchByBar(arr) {
  if (!arr || arr.length === 0) {
    return null
  }
  let out = []
  let i = 0
  while (i < arr.length) {
    out.push(arr[i])
    i = i + 1
  }
  return out
}

/// Pattern length (bars) for a channel's clips — drives the loop span. Uses patternBars; falls back to
/// tplLoopBars (legacy) then 1. NOTE: this is the loop LENGTH, not the finite play-count cap.
export fn clipBarsForChannel(ch) {
  if (ch.patternBars !== null && ch.patternBars !== undefined) {
    let tn = Math.floor(Number(ch.patternBars))
    if (tn >= 1 && tn === tn) {
      return tn
    }
  }
  if (ch.tplLoopBars !== null && ch.tplLoopBars !== undefined) {
    let tn2 = Math.floor(Number(ch.tplLoopBars))
    if (tn2 >= 1 && tn2 === tn2) {
      return tn2
    }
  }
  return 1
}

export fn ensureChannelSessionClips(ch) {
  if (!ch.sessionClips) {
    ch.sessionClips = []
  }
  if (ch.sessionClips.length > 0) {
    return
  }
  let bars = clipBarsForChannel(ch)
  ch.sessionClips.push({
    id: defaultMainClipId(ch),
    name: ch.name,
    bars: bars,
    steps: stepsForClip(ch, bars),
    pianoNotes: copyPianoNotes(ch.pianoNotes),
    tplLoopBars: ch.tplLoopBars !== null && ch.tplLoopBars !== undefined ? ch.tplLoopBars : null
  })
}

export fn findClipOnChannel(ch, clipId) {
  if (!ch.sessionClips) {
    return null
  }
  let i = 0
  while (i < ch.sessionClips.length) {
    if (ch.sessionClips[i].id === clipId) {
      return ch.sessionClips[i]
    }
    i = i + 1
  }
  return null
}

/** Keep first bar of main clip aligned with channel rack (multi-bar = tiled pattern). */
export fn mirrorStepToggleToMainClip(ch, stepIdx) {
  ensureChannelSessionClips(ch)
  let c0 = ch.sessionClips[0]
  if (!c0 || !c0.steps) {
    return
  }
  let on = ch.steps[stepIdx].on
  let vel = ch.steps[stepIdx].vel !== null && ch.steps[stepIdx].vel !== undefined ? ch.steps[stepIdx].vel : 100
  let pos = stepIdx
  while (pos < c0.steps.length) {
    c0.steps[pos].on = on
    c0.steps[pos].vel = vel
    pos = pos + 16
  }
}

export fn mirrorClearStepToMainClip(ch, stepIdx) {
  ensureChannelSessionClips(ch)
  let c0 = ch.sessionClips[0]
  if (!c0 || !c0.steps) {
    return
  }
  let pos = stepIdx
  while (pos < c0.steps.length) {
    c0.steps[pos].on = false
    pos = pos + 16
  }
}

/** Before emit / hub preview: main clip reflects rack + piano + tpl bar cap. */
export fn syncMainClipFromChannel(ch) {
  ensureChannelSessionClips(ch)
  let c0 = ch.sessionClips[0]
  let bars = clipBarsForChannel(ch)
  c0.bars = bars
  c0.steps = stepsForClip(ch, bars)
  c0.pianoNotes = copyPianoNotes(ch.pianoNotes)
  c0.tplLoopBars = ch.tplLoopBars !== null && ch.tplLoopBars !== undefined ? ch.tplLoopBars : null
}

export fn syncAllMainClipsFromChannels(project) {
  if (!project || !project.channels) {
    return
  }
  let i = 0
  while (i < project.channels.length) {
    syncMainClipFromChannel(project.channels[i])
    i = i + 1
  }
}

/// Append one more program (an extra scene / P-column) to the session grid and reconcile every track's
/// slot row to the new count. Returns the new program count. (Mirrors setRackBars for the rack.)
export fn addSessionProgram(project) {
  ensureProjectSession(project)
  let cur = Math.floor(Number(project.session.sceneCount))
  if (cur !== cur || cur < 1) {
    cur = 4
  }
  project.session.sceneCount = cur + 1
  ensureProjectSession(project)
  return cur + 1
}

/// Drop the last program (scene / P-column), clamped at a minimum of 1. Returns the new program count.
export fn removeSessionProgram(project) {
  ensureProjectSession(project)
  let cur = Math.floor(Number(project.session.sceneCount))
  if (cur !== cur || cur <= 1) {
    return cur
  }
  project.session.sceneCount = cur - 1
  let ti = 0
  while (project.session.slots && ti < project.session.slots.length) {
    let row = project.session.slots[ti]
    while (row.length > cur - 1) {
      row.pop()
    }
    ti = ti + 1
  }
  ensureProjectSession(project)
  return cur - 1
}

export fn ensureProjectSession(project) {
  if (!project.channels) {
    return
  }
  let ci = 0
  while (ci < project.channels.length) {
    ensureChannelSessionClips(project.channels[ci])
    ci = ci + 1
  }
  if (!project.session) {
    project.session = { sceneCount: 4, slots: [] }
  }
  let sc = Math.floor(Number(project.session.sceneCount))
  if (sc < 1 || sc !== sc) {
    sc = 4
  }
  project.session.sceneCount = sc
  if (!project.session.slots) {
    project.session.slots = []
  }
  while (project.session.slots.length < project.channels.length) {
    let row = []
    let sj = 0
    while (sj < sc) {
      row.push("")
      sj = sj + 1
    }
    project.session.slots.push(row)
  }
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    let row = project.session.slots[ti]
    while (row.length < sc) {
      row.push("")
    }
    let sj = 0
    while (sj < sc) {
      if (row[sj] === undefined || row[sj] === null || row[sj] === "") {
        row[sj] = defaultMainClipId(ch)
      }
      sj = sj + 1
    }
    ti = ti + 1
  }
  while (project.session.slots.length > project.channels.length) {
    project.session.slots.pop()
  }
  // Explicit song arrangement: [{ scene, repeat }]. Empty = derive the order from saved scenes (legacy).
  if (!project.session.song) {
    project.session.song = []
  }
  // Per-scene follow actions (Ableton-style): follow[scene] = { a, wa, b, wb } or null. When any are
  // set, they drive song progression (each scene decides what plays next), deterministically seeded.
  if (!project.session.follow) {
    project.session.follow = []
  }
}

/** True when the project carries an explicit (non-empty) song arrangement, vs. the derived grid order. */
export fn hasExplicitSong(project) {
  return (project !== null && project !== undefined) && (project.session !== null && project.session !== undefined) && (project.session.song !== null && project.session.song !== undefined) && project.session.song.length > 0
}

/** Clamp a song entry list to valid scene indices and repeat >= 1; drops entries pointing nowhere. */
export fn normalizeSongEntries(project, entries) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  let out = []
  if (!entries) {
    return out
  }
  let i = 0
  while (i < entries.length) {
    let e = entries[i]
    let scene = Math.floor(Number(e.scene))
    let rep = e.repeat !== null && e.repeat !== undefined ? Math.floor(Number(e.repeat)) : 1
    if (rep < 1 || rep !== rep) {
      rep = 1
    }
    if (scene >= 0 && scene < sc && scene === scene) {
      out.push({ scene: scene, repeat: rep })
    }
    i = i + 1
  }
  return out
}

// ---- Follow actions (per-scene progression, Ableton-style) -------------------------------------

// Valid follow-action verbs. `next`/`prev`/`first`/`last`/`any` walk SAVED scenes; `repeat` replays the
// same scene; `stop` ends the song. Default (no entry) behaves like `next`.
export fn isFollowAction(a) {
  return a === "next" || a === "repeat" || a === "prev" || a === "first" || a === "last" || a === "any" || a === "stop"
}

/** Deterministic pseudo-random in [0,1) from (seed, n) — no Math.random (banned in builds; would also
 *  desync collaborators). Same seed + same step index → same value for every player. Classic LCG, kept
 *  well under 2^53 so doubles stay exact. */
export fn detRand01(seed, n) {
  let s = (Math.floor(Math.abs(Number(seed))) % 100000) * 100003 + (Math.floor(Math.abs(Number(n))) % 100000)
  let x = s % 233280
  x = (x * 9301 + 49297) % 233280
  x = (x * 9301 + 49297) % 233280
  return x / 233280
}

/** The seed driving deterministic follow-action chance rolls (project scalar; default 1). */
export fn songSeedOf(project) {
  if ((project !== null && project !== undefined) && (project.songSeed !== null && project.songSeed !== undefined)) {
    let s = Math.floor(Number(project.songSeed))
    if (s === s) {
      return s
    }
  }
  return 1
}

/** True when ANY scene has a follow action — then follow actions own progression (song block ignored). */
export fn hasFollowActions(project) {
  if ((project === null || project === undefined) || (project.session === null || project.session === undefined) || !project.session.follow) {
    return false
  }
  let f = project.session.follow
  let i = 0
  while (i < f.length) {
    if (f[i] !== null && f[i] !== undefined) {
      return true
    }
    i = i + 1
  }
  return false
}

/** The follow action for a scene, or null. Shape: { a, wa, b, wb } (b may be null = single action). */
export fn sceneFollow(project, scene) {
  ensureProjectSession(project)
  let s = Math.floor(Number(scene))
  let f = project.session.follow
  if (s >= 0 && s < f.length && (f[s] !== null && f[s] !== undefined)) {
    return f[s]
  }
  return null
}

/** Set (or clear, when (a === null || a === undefined)) a scene's follow action. Weights clamp to >= 0. */
export fn setSceneFollow(project, scene, a, wa, b, wb) {
  ensureProjectSession(project)
  let s = Math.floor(Number(scene))
  if (s < 0 || s !== s) {
    return
  }
  while (project.session.follow.length <= s) {
    project.session.follow.push(null)
  }
  if ((a === null || a === undefined) || !isFollowAction(a)) {
    project.session.follow[s] = null
    return
  }
  let waN = wa !== null && wa !== undefined ? Number(wa) : 1
  if (waN < 0 || waN !== waN) {
    waN = 0
  }
  let bN = (b !== null && b !== undefined && isFollowAction(b)) ? b : null
  let wbN = wb !== null && wb !== undefined ? Number(wb) : 0
  if (wbN < 0 || wbN !== wbN) {
    wbN = 0
  }
  project.session.follow[s] = { a: a, wa: waN, b: bN, wb: bN !== null && bN !== undefined ? wbN : 0 }
}

/** Drop follow entries pointing at out-of-range scenes / invalid actions (used on deck apply). */
export fn normalizeFollow(project, entries) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  let out = []
  if (!entries) {
    return out
  }
  let i = 0
  while (i < entries.length) {
    let e = entries[i]
    if (e !== null && e !== undefined) {
      let scene = Math.floor(Number(e.scene))
      if (scene >= 0 && scene < sc && scene === scene && isFollowAction(e.a)) {
        while (out.length <= scene) {
          out.push(null)
        }
        let bN = (e.b !== null && e.b !== undefined && isFollowAction(e.b)) ? e.b : null
        out[scene] = {
          a: e.a,
          wa: e.wa !== null && e.wa !== undefined && Number(e.wa) >= 0 ? Number(e.wa) : 1,
          b: bN,
          wb: (bN !== null && bN !== undefined) && (e.wb !== null && e.wb !== undefined) && Number(e.wb) >= 0 ? Number(e.wb) : 0
        }
      }
    }
    i = i + 1
  }
  return out
}

/** Last saved scene index (or firstSongScene if none higher). */
export fn lastSongScene(project) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  let s = sc - 1
  while (s >= 0) {
    if (sceneHasSavedClip(project, s)) {
      return s
    }
    s = s - 1
  }
  return firstSongScene(project)
}

/** Previous saved scene before `fromIdx` (wrapping); mirrors nextSongScene. */
export fn prevSongScene(project, fromIdx) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  if (sc < 1) {
    return 0
  }
  let from = Math.floor(Number(fromIdx))
  let step = 1
  while (step <= sc) {
    let cand = (((from - step) % sc) + sc) % sc
    if (sceneHasSavedClip(project, cand)) {
      return cand
    }
    step = step + 1
  }
  return from
}

/** Deterministically pick any saved scene (for the `any` action) from the seeded sequence. */
fn anySongScene(project, rt, fromIdx) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  let saved = []
  let s = 0
  while (s < sc) {
    if (sceneHasSavedClip(project, s)) {
      saved.push(s)
    }
    s = s + 1
  }
  if (saved.length === 0) {
    return Math.floor(Number(fromIdx))
  }
  let n = rt && rt.followCount !== null && rt.followCount !== undefined ? Math.floor(Number(rt.followCount)) : 0
  let r = detRand01(songSeedOf(project) + 7, n)
  let pick = Math.floor(r * saved.length)
  if (pick >= saved.length) {
    pick = saved.length - 1
  }
  return saved[pick]
}

/** Resolve `fromScene`'s follow action to the next scene (or -1 = stop). Rolls the A/B chance ratio
 *  deterministically from the song seed + rt.followCount, then advances the counter. */
export fn resolveFollowAction(project, rt, fromScene) {
  ensureProjectSession(project)
  let fa = sceneFollow(project, fromScene)
  // A scene with NO follow entry loops (the default), even when OTHER scenes have follow actions set.
  // Setting "Next" on P2 must not make P1 (no entry) advance — only configured scenes follow their rule.
  if (fa === null || fa === undefined) {
    return Math.floor(Number(fromScene))
  }
  let n = rt && rt.followCount !== null && rt.followCount !== undefined ? Math.floor(Number(rt.followCount)) : 0
  if (rt) {
    rt.followCount = n + 1
  }
  let action = fa.a
  let wa = fa.wa !== null && fa.wa !== undefined ? Number(fa.wa) : 1
  let wb = (fa.b !== null && fa.b !== undefined) && (fa.wb !== null && fa.wb !== undefined) ? Number(fa.wb) : 0
  let total = wa + wb
  if ((fa.b !== null && fa.b !== undefined) && total > 0) {
    let r = detRand01(songSeedOf(project), n) * total
    if (r >= wa) {
      action = fa.b
    }
  }
  if (action === "repeat") {
    return Math.floor(Number(fromScene))
  }
  if (action === "stop") {
    return -1
  }
  if (action === "first") {
    return firstSongScene(project)
  }
  if (action === "last") {
    return lastSongScene(project)
  }
  if (action === "prev") {
    return prevSongScene(project, fromScene)
  }
  if (action === "any") {
    return anySongScene(project, rt, fromScene)
  }
  return nextSongScene(project, fromScene)
}

/** First scene of the song: explicit arrangement head if present, else the first saved scene. Sets the
 *  song cursor (rt.songPos = { idx, rep }) so songAdvance can walk repeats. */
export fn songStart(project, rt) {
  ensureProjectSession(project)
  // Reset the deterministic follow-action counter so each play rolls the same seeded sequence.
  if (rt) {
    rt.followCount = 0
  }
  // Follow actions own progression when present; they start at the first saved scene.
  if (hasFollowActions(project)) {
    if (rt) {
      rt.songPos = null
    }
    return firstSongScene(project)
  }
  if (hasExplicitSong(project)) {
    let scene = Math.floor(Number(project.session.song[0].scene))
    if (rt) {
      rt.songPos = { idx: 0, rep: 0 }
    }
    return scene
  }
  if (rt) {
    rt.songPos = null
  }
  return firstSongScene(project)
}

/** Advance the song by one play of the current scene. Order of precedence: per-scene follow actions
 *  (Ableton-style, seeded), then an explicit `song` arrangement (repeat-aware). With NEITHER, a launched
 *  scene LOOPS — like Ableton's Session view, progression is opt-in, not automatic. Returns the next
 *  scene (the same scene when looping), or -1 when a follow action says STOP. */
export fn songAdvance(project, rt, fromScene) {
  ensureProjectSession(project)
  if (hasFollowActions(project)) {
    return resolveFollowAction(project, rt, fromScene)
  }
  if (hasExplicitSong(project)) {
    let song = project.session.song
    let pos = rt && rt.songPos !== null && rt.songPos !== undefined ? rt.songPos : { idx: 0, rep: 0 }
    let idx = Math.floor(Number(pos.idx))
    let rep = Math.floor(Number(pos.rep))
    if (idx < 0 || idx >= song.length || idx !== idx) {
      idx = 0
      rep = 0
    }
    let entry = song[idx]
    let entryRep = entry.repeat !== null && entry.repeat !== undefined ? Math.floor(Number(entry.repeat)) : 1
    if (entryRep < 1) {
      entryRep = 1
    }
    if (rep + 1 < entryRep) {
      rep = rep + 1
    } else {
      idx = (idx + 1) % song.length
      rep = 0
    }
    if (rt) {
      rt.songPos = { idx: idx, rep: rep }
    }
    return Math.floor(Number(song[idx].scene))
  }
  // Ableton default: no follow action and no explicit arrangement → the launched scene loops. It does
  // NOT auto-advance to the next saved scene. To progress, set a follow action or build a song block.
  return Math.floor(Number(fromScene))
}

/**
 * Snapshot current rack + piano roll on every track into a dedicated clip and assign that clip to
 * session column sceneIdx (0 = SEQ 1). After this, that sequence plays this pattern until overwritten.
 */
export fn sessionWriteRackToSceneClip(project, sceneIdx) {
  if (!project || !project.channels) {
    return
  }
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let sc = Math.floor(Number(project.session.sceneCount))
  if (s < 0 || s >= sc || s !== s || sc < 1) {
    return
  }
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    ensureChannelSessionClips(ch)
    let clipId = String(ch.id) + "_sc" + String(s)
    let bars = clipBarsForChannel(ch)
    let baseSteps = stepsForClip(ch, bars)
    let spb = copyStepPitchByBar(ch.stepPitchByBar)
    let clip = findClipOnChannel(ch, clipId)
    let storeInstr = ch.clipInstrMode === "store"
    if (!clip) {
      let nm = String(ch.name) + " ·S" + String(s + 1)
      clip = {
        id: clipId,
        name: nm,
        bars: bars,
        steps: baseSteps,
        pianoNotes: copyPianoNotes(ch.pianoNotes),
        stepPitchByBar: spb,
        tplLoopBars: ch.tplLoopBars !== null && ch.tplLoopBars !== undefined ? ch.tplLoopBars : null
      }
      if (storeInstr) {
        clip.instrument = snapshotInstrument(ch)
      }
      ch.sessionClips.push(clip)
    } else {
      clip.bars = bars
      clip.steps = baseSteps
      clip.pianoNotes = copyPianoNotes(ch.pianoNotes)
      clip.stepPitchByBar = spb
      clip.tplLoopBars = ch.tplLoopBars !== null && ch.tplLoopBars !== undefined ? ch.tplLoopBars : null
      if (storeInstr) {
        clip.instrument = snapshotInstrument(ch)
      }
    }
    normalizeClipStepLength(clip)
    if (project.session.slots[ti] && project.session.slots[ti][s] !== undefined) {
      project.session.slots[ti][s] = clipId
    }
    ti = ti + 1
  }
}

/**
 * Load a saved scene's clips back INTO the editable rack — so selecting a pattern shows and lets you
 * edit it (not just arm a hidden clip). Each channel's steps / notes / bars / per-bar pitch are copied
 * from its slot clip; the main clips re-sync so playback follows the loaded pattern.
 */
export fn loadSceneIntoRack(project, sceneIdx) {
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let sc = Math.floor(Number(project.session.sceneCount))
  if (s < 0 || s >= sc || s !== s) {
    return
  }
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    let clipId = ""
    if (project.session.slots[ti] && (project.session.slots[ti][s] !== null && project.session.slots[ti][s] !== undefined)) {
      clipId = project.session.slots[ti][s]
    }
    let clip = (clipId !== "") ? findClipOnChannel(ch, clipId) : null
    if (clip && clip.steps) {
      let ns = []
      let si = 0
      while (si < clip.steps.length) {
        ns.push(cloneStep(clip.steps[si]))
        si = si + 1
      }
      ch.steps = ns
      ch.pianoNotes = copyPianoNotes(clip.pianoNotes)
      ch.patternBars = (clip.bars !== null && clip.bars !== undefined && Math.floor(clip.bars) >= 1) ? Math.floor(clip.bars) : 1
      ch.stepPitchByBar = copyStepPitchByBar(clip.stepPitchByBar)
      // Restore the instrument when this track is in "store" mode and the clip has one.
      if (ch.clipInstrMode === "store" && clip.instrument) {
        applyInstrument(ch, clip.instrument)
      }
    }
    ti = ti + 1
  }
  syncAllMainClipsFromChannels(project)
}

/** Load ONLY bar `barIdx` of a saved pattern into the rack's bar `barIdx` — leaving every other bar
 *  in the sequencer untouched. The rack channel is materialized up to that bar first. */
export fn loadSceneBarIntoRack(project, sceneIdx, barIdx) {
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let b = Math.floor(Number(barIdx))
  if (b < 0) {
    b = 0
  }
  let sc = Math.floor(Number(project.session.sceneCount))
  if (s < 0 || s >= sc || s !== s) {
    return
  }
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    let clipId = ""
    if (project.session.slots[ti] && (project.session.slots[ti][s] !== null && project.session.slots[ti][s] !== undefined)) {
      clipId = project.session.slots[ti][s]
    }
    let clip = clipId !== "" ? findClipOnChannel(ch, clipId) : null
    if (clip && clip.steps) {
      let clipBars = clip.bars !== null && clip.bars !== undefined && Math.floor(clip.bars) >= 1 ? Math.floor(clip.bars) : 1
      let srcBar = b % clipBars
      promoteChannelToBars(ch, b + 1)
      copyBarSteps(ch.steps, b, clip.steps, srcBar)
      ch.pianoNotes = spliceBarNotes(ch.pianoNotes ? ch.pianoNotes : [], b, clip.pianoNotes ? clip.pianoNotes : [], srcBar)
      if (clip.stepPitchByBar && srcBar < clip.stepPitchByBar.length) {
        if (!ch.stepPitchByBar) {
          ch.stepPitchByBar = []
        }
        while (ch.stepPitchByBar.length <= b) {
          ch.stepPitchByBar.push(36)
        }
        ch.stepPitchByBar[b] = clip.stepPitchByBar[srcBar]
      }
      // Also restore instrument on per-bar load when store mode is enabled.
      if (ch.clipInstrMode === "store" && clip.instrument) {
        applyInstrument(ch, clip.instrument)
      }
    }
    ti = ti + 1
  }
  syncAllMainClipsFromChannels(project)
}

/** Save ONLY the bar being viewed in the sequencer as a ONE-BAR pattern (clip.bars = 1). The pattern
 *  becomes exactly that single bar — not the whole rack, not a multi-bar clip. */
export fn sessionWriteRackBarToSceneClip(project, sceneIdx, barIdx) {
  if (!project || !project.channels) {
    return
  }
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let b = Math.floor(Number(barIdx))
  if (b < 0) {
    b = 0
  }
  let sc = Math.floor(Number(project.session.sceneCount))
  if (s < 0 || s >= sc || s !== s || sc < 1) {
    return
  }
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    ensureChannelSessionClips(ch)
    let clipId = String(ch.id) + "_sc" + String(s)
    let chCur = ch.patternBars !== null && ch.patternBars !== undefined && Math.floor(ch.patternBars) >= 1 ? Math.floor(ch.patternBars) : 1
    let srcBar = b % chCur
    // 16 steps of the viewed bar — wrap the index so a tiled (e.g. 16-step over 4 bars) pattern works.
    let stepsLen = ch.steps ? ch.steps.length : 0
    let oneSteps = []
    let i = 0
    while (i < 16) {
      let st = stepsLen > 0 ? ch.steps[(srcBar * 16 + i) % stepsLen] : null
      oneSteps.push(cloneStep(st))
      i = i + 1
    }
    // Notes the rack actually SHOWS in the viewed bar — those that START there (mirrors the piano roll),
    // not held-over notes from earlier bars. Save the bar you see, with no carry-in from the preset.
    let oneNotes = notesStartingInBar(ch.pianoNotes ? ch.pianoNotes : [], srcBar)
    let onePitch = null
    if (ch.stepPitchByBar && srcBar < ch.stepPitchByBar.length) {
      onePitch = [ch.stepPitchByBar[srcBar]]
    }
    let clip = findClipOnChannel(ch, clipId)
    let storeInstr = ch.clipInstrMode === "store"
    if (!clip) {
      clip = {
        id: clipId,
        name: String(ch.name) + " ·S" + String(s + 1),
        bars: 1,
        steps: oneSteps,
        pianoNotes: oneNotes,
        stepPitchByBar: onePitch,
        tplLoopBars: ch.tplLoopBars !== null && ch.tplLoopBars !== undefined ? ch.tplLoopBars : null
      }
      if (storeInstr) {
        clip.instrument = snapshotInstrument(ch)
      }
      ch.sessionClips.push(clip)
    } else {
      clip.bars = 1
      clip.steps = oneSteps
      clip.pianoNotes = oneNotes
      clip.stepPitchByBar = onePitch
      if (storeInstr) {
        clip.instrument = snapshotInstrument(ch)
      }
    }
    if (project.session.slots[ti] && project.session.slots[ti][s] !== undefined) {
      project.session.slots[ti][s] = clipId
    }
    ti = ti + 1
  }
}

/** Clip id string currently driving playback for one track (mirrors playbackClipForChannel arming rules). */
export fn sessionEffectiveArmedClipId(project, rt, trackIdx) {
  let ch = project.channels[trackIdx]
  if (!rt || !rt.sessionArmedClipIds) {
    return defaultMainClipId(ch)
  }
  let armed = rt.sessionArmedClipIds[trackIdx]
  if (armed === undefined || armed === null) {
    return defaultMainClipId(ch)
  }
  return armed
}

/** Scene column index whose slots match armed clip ids on every track, or null if no full-column match. */
export fn sessionPlayingSceneIndex(project, rt) {
  if (!project || !project.channels) {
    return null
  }
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  if (sc < 1 || sc !== sc) {
    return null
  }
  let prefer = null
  if (rt && rt.sessionActiveScene !== undefined && rt.sessionActiveScene !== null) {
    let ap = Math.floor(Number(rt.sessionActiveScene))
    if (ap >= 0 && ap < sc && ap === ap) {
      prefer = ap
    }
  }
  if (prefer !== null) {
    let matchPrefer = true
    let ti = 0
    while (ti < project.channels.length) {
      let slot = ""
      if (project.session.slots[ti] && project.session.slots[ti][prefer] !== undefined) {
        slot = project.session.slots[ti][prefer]
      }
      if (slot === undefined || slot === null) {
        slot = ""
      }
      let eff = sessionEffectiveArmedClipId(project, rt, ti)
      if (slot !== eff) {
        matchPrefer = false
      }
      ti = ti + 1
    }
    if (matchPrefer) {
      return prefer
    }
  }
  let si = 0
  while (si < sc) {
    let match = true
    let ti = 0
    while (ti < project.channels.length) {
      let slot = ""
      if (project.session.slots[ti] && project.session.slots[ti][si] !== undefined) {
        slot = project.session.slots[ti][si]
      }
      if (slot === undefined || slot === null) {
        slot = ""
      }
      let eff = sessionEffectiveArmedClipId(project, rt, ti)
      if (slot !== eff) {
        match = false
      }
      ti = ti + 1
    }
    if (match) {
      return si
    }
    si = si + 1
  }
  return null
}

/** True if any channel has a real SAVED clip (not the shared default rack clip) in this scene. */
export fn sceneHasSavedClip(project, sceneIdx) {
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    let slot = ""
    if (project.session.slots[ti] && (project.session.slots[ti][s] !== null && project.session.slots[ti][s] !== undefined)) {
      slot = project.session.slots[ti][s]
    }
    if ((slot !== null && slot !== undefined) && slot !== "" && slot !== defaultMainClipId(ch)) {
      return true
    }
    ti = ti + 1
  }
  return false
}

/** How many bars this scene plays in a song before advancing — the longest clip in the column. */
export fn sceneBarLength(project, sceneIdx) {
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let maxBars = 1
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    let slot = ""
    if (project.session.slots[ti] && (project.session.slots[ti][s] !== null && project.session.slots[ti][s] !== undefined)) {
      slot = project.session.slots[ti][s]
    }
    if ((slot !== null && slot !== undefined) && slot !== "") {
      let cl = findClipOnChannel(ch, slot)
      if (cl && (cl.bars !== null && cl.bars !== undefined)) {
        let b = Math.floor(Number(cl.bars))
        if (b > maxBars && b === b) {
          maxBars = b
        }
      }
    }
    ti = ti + 1
  }
  return maxBars
}

/** First scene with a saved clip (where a song should start); falls back to 0. */
export fn firstSongScene(project) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  let s = 0
  while (s < sc) {
    if (sceneHasSavedClip(project, s)) {
      return s
    }
    s = s + 1
  }
  return 0
}

/** Next saved scene after `fromIdx` (wrapping). If no other saved scene exists, returns fromIdx. */
export fn nextSongScene(project, fromIdx) {
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  if (sc < 1) {
    return 0
  }
  let from = Math.floor(Number(fromIdx))
  let step = 1
  while (step <= sc) {
    let cand = (from + step) % sc
    if (sceneHasSavedClip(project, cand)) {
      return cand
    }
    step = step + 1
  }
  return from
}

/** The clip id assigned to one track in one scene's column (or "" if none). */
export fn sceneSlotClipId(project, sceneIdx, trackIdx) {
  ensureProjectSession(project)
  let s = Math.floor(Number(sceneIdx))
  let t = Math.floor(Number(trackIdx))
  let slot = ""
  if (project.session.slots[t] && (project.session.slots[t][s] !== null && project.session.slots[t][s] !== undefined)) {
    slot = project.session.slots[t][s]
  }
  if (slot === null || slot === undefined) {
    slot = ""
  }
  return slot
}

/**
 * Arm a whole scene, then re-apply any per-track clip overrides on top. Per-track launches (clicking
 * a single clip cell) set rt.trackOverrides[t]; those tracks keep their chosen clip even as the song
 * auto-advances through scenes. A full pattern LAUNCH clears the overrides.
 */
export fn armSceneWithOverrides(project, rt, sceneIdx) {
  sessionArmScene(project, rt, sceneIdx)
  if (!rt.trackOverrides) {
    return
  }
  if (!rt.sessionArmedClipIds) {
    rt.sessionArmedClipIds = []
  }
  let t = 0
  while (t < project.channels.length) {
    if (rt.trackOverrides[t] !== null && rt.trackOverrides[t] !== undefined) {
      rt.sessionArmedClipIds[t] = rt.trackOverrides[t]
    }
    t = t + 1
  }
}

fn sessionEnsureQueuedArray(project, rt) {
  ensureProjectSession(project)
  if (!rt.sessionQueuedClipIds) {
    rt.sessionQueuedClipIds = []
  }
  let n = project.channels.length
  while (rt.sessionQueuedClipIds.length < n) {
    rt.sessionQueuedClipIds.push("")
  }
  while (rt.sessionQueuedClipIds.length > n) {
    rt.sessionQueuedClipIds.pop()
  }
}

/** Immediate arm (e.g. transport start): apply scene column to playback now. */
export fn sessionArmScene(project, rt, sceneIdx) {
  ensureProjectSession(project)
  let sc = project.session.sceneCount
  let s = Math.floor(Number(sceneIdx))
  if (s < 0 || s >= sc || s !== s) {
    s = 0
  }
  rt.sessionActiveScene = s
  if (!rt.sessionArmedClipIds) {
    rt.sessionArmedClipIds = []
  }
  let ti = 0
  while (ti < project.channels.length) {
    let slot = ""
    if (project.session.slots[ti] && project.session.slots[ti][s] !== undefined) {
      slot = project.session.slots[ti][s]
    }
    if (slot === undefined || slot === null) {
      slot = ""
    }
    rt.sessionArmedClipIds[ti] = slot
    ti = ti + 1
  }
}

/** Queue a full scene for the next bar boundary (16 sixteenths); does not change playback yet. */
export fn sessionQueueScene(project, rt, sceneIdx) {
  ensureProjectSession(project)
  let sc = project.session.sceneCount
  let s = Math.floor(Number(sceneIdx))
  if (s < 0 || s >= sc || s !== s) {
    s = 0
  }
  rt.sessionActiveScene = s
  sessionEnsureQueuedArray(project, rt)
  let ti = 0
  while (ti < project.channels.length) {
    let slot = ""
    if (project.session.slots[ti] && project.session.slots[ti][s] !== undefined) {
      slot = project.session.slots[ti][s]
    }
    if (slot === undefined || slot === null) {
      slot = ""
    }
    rt.sessionQueuedClipIds[ti] = slot
    ti = ti + 1
  }
  rt.sessionQueuePending = true
  rt.sessionQueuedScene = s
}

fn sessionArmTrackClip(project, rt, trackIdx, clipId) {
  ensureProjectSession(project)
  if (!rt.sessionArmedClipIds) {
    rt.sessionArmedClipIds = []
  }
  let cid = clipId
  if (cid === undefined || cid === null) {
    cid = ""
  }
  rt.sessionArmedClipIds[trackIdx] = cid
}

/** Queue one track’s clip for the next sequence boundary; other tracks keep current playback until then. */
fn sessionQueueTrackClip(project, rt, trackIdx, clipId) {
  ensureProjectSession(project)
  let tix = Math.floor(Number(trackIdx))
  if (tix < 0 || tix >= project.channels.length || tix !== tix) {
    return
  }
  sessionEnsureQueuedArray(project, rt)
  let ti = 0
  while (ti < project.channels.length) {
    rt.sessionQueuedClipIds[ti] = sessionEffectiveArmedClipId(project, rt, ti)
    ti = ti + 1
  }
  let cid = clipId
  if (cid === undefined || cid === null) {
    cid = ""
  }
  rt.sessionQueuedClipIds[tix] = cid
  rt.sessionQueuePending = true
  rt.sessionQueuedScene = null
}

/** Apply queued clips to playback. Returns true if a pending queue was committed. */
export fn sessionCommitQueued(project, rt) {
  if (!rt || !rt.sessionQueuePending) {
    return false
  }
  ensureProjectSession(project)
  let n = project.channels.length
  if (!rt.sessionQueuedClipIds) {
    rt.sessionQueuedClipIds = []
  }
  while (rt.sessionQueuedClipIds.length > n) {
    rt.sessionQueuedClipIds.pop()
  }
  let padI = rt.sessionQueuedClipIds.length
  while (padI < n) {
    rt.sessionQueuedClipIds.push(sessionEffectiveArmedClipId(project, rt, padI))
    padI = padI + 1
  }
  if (!rt.sessionArmedClipIds) {
    rt.sessionArmedClipIds = []
  }
  let ti = 0
  while (ti < n) {
    let q = rt.sessionQueuedClipIds[ti]
    if (q === undefined || q === null) {
      q = ""
    }
    rt.sessionArmedClipIds[ti] = q
    ti = ti + 1
  }
  rt.sessionQueuePending = false
  rt.sessionQueuedClipIds = []
  rt.sessionQueuedScene = null
  return true
}

export fn sessionStopAllTracks(project, rt) {
  ensureProjectSession(project)
  if (!rt.sessionArmedClipIds) {
    rt.sessionArmedClipIds = []
  }
  let ti = 0
  while (ti < project.channels.length) {
    rt.sessionArmedClipIds[ti] = ""
    ti = ti + 1
  }
  rt.sessionQueuePending = false
  if (rt.sessionQueuedClipIds) {
    rt.sessionQueuedClipIds = []
  }
  rt.sessionQueuedScene = null
}

/** Stop ONE track's clip immediately — it plays nothing until a clip / scene is launched again.
 *  Unlike releasing a per-track override (which falls back to following the song scene), a stop pins
 *  the track silent across song auto-advances via an empty ("") override. Effective right away. */
export fn sessionStopTrack(project, rt, trackIdx) {
  ensureProjectSession(project)
  let tix = Math.floor(Number(trackIdx))
  if (tix < 0 || tix >= project.channels.length || tix !== tix) {
    return
  }
  if (!rt.trackOverrides) {
    rt.trackOverrides = []
  }
  if (!rt.sessionArmedClipIds) {
    rt.sessionArmedClipIds = []
  }
  rt.trackOverrides[tix] = ""
  rt.sessionArmedClipIds[tix] = ""
  if (rt.sessionQueuedClipIds && rt.sessionQueuedClipIds[tix] !== undefined) {
    rt.sessionQueuedClipIds[tix] = ""
  }
  if (rt.trackPending) {
    let kept = []
    let i = 0
    while (i < rt.trackPending.length) {
      if (rt.trackPending[i].t !== tix) {
        kept.push(rt.trackPending[i])
      }
      i = i + 1
    }
    rt.trackPending = kept
  }
}

/** True when a track has been explicitly stopped (empty override) rather than following the song. */
export fn sessionTrackStopped(rt, trackIdx) {
  if (!rt || !rt.trackOverrides) {
    return false
  }
  let tix = Math.floor(Number(trackIdx))
  return rt.trackOverrides[tix] === ""
}

/** Clip used for audio + loop cap, or null to fall back to channel.steps / ch.pianoNotes (no session). */
export fn playbackClipForChannel(project, rt, chIdx) {
  if (!project || !project.channels || chIdx < 0 || chIdx >= project.channels.length) {
    return null
  }
  let ch = project.channels[chIdx]
  // Play Sequence mode: ignore session arming entirely and play the rack / edit buffer
  // (ch.steps / ch.pianoNotes) directly — this is the pattern you are editing, monitored live.
  if (rt && rt.playMode === "sequence") {
    return null
  }
  // Session mode: only an explicitly SAVED scene clip plays. An unsaved slot is the channel's default
  // "main" clip — shown as an empty cell in the session grid — so it is SILENT here too. Session does
  // NOT fall back to the rack (that's what Sequence mode is for). Empty session ⇒ silence.
  let armed = rt && rt.sessionArmedClipIds ? rt.sessionArmedClipIds[chIdx] : null
  if (armed === undefined || armed === null || armed === "" || armed === defaultMainClipId(ch)) {
    return { silent: true }
  }
  let cl = findClipOnChannel(ch, armed)
  if (!cl) {
    return { silent: true }
  }
  // Per-clip skip (right-click a session cell): the armed clip is disabled, so this track stays silent for
  // it until it's re-enabled (left-click / right-click again).
  if (rt && rt.sessionDisabledClips && rt.sessionDisabledClips[armed] === true) {
    return { silent: true }
  }
  return cl
}

/** Ensure clip.steps.length === clip.bars * 16 (tile first bar if needed). */
export fn normalizeClipStepLength(clip) {
  if (!clip) {
    return
  }
  let b = Math.max(1, Math.floor(clip.bars))
  clip.bars = b
  let want = b * 16
  if (!clip.steps) {
    clip.steps = []
  }
  if (clip.steps.length === want) {
    return
  }
  if (clip.steps.length > want) {
    clip.steps = clip.steps.slice(0, want)
    return
  }
  if (clip.steps.length === 0) {
    let i = 0
    while (i < want) {
      clip.steps.push(makeStep(false, 100))
      i = i + 1
    }
    return
  }
  let base = []
  let si = 0
  while (si < 16) {
    base.push(cloneStep(clip.steps[si]))
    si = si + 1
  }
  clip.steps = tileStepsPattern(base, b)
}

export fn clipPatternSpanSteps(clip) {
  if (!clip || clip.silent || !clip.steps) {
    return 16
  }
  let L = clip.steps.length
  if (L < 16) {
    return 16
  }
  return L
}

export fn clipLoopBarsCap(clip) {
  if (!clip || clip.silent) {
    return null
  }
  if (clip.tplLoopBars === undefined || clip.tplLoopBars === null) {
    return null
  }
  let n = Math.floor(Number(clip.tplLoopBars))
  if (n < 1 || n !== n) {
    return null
  }
  return n
}

/** Finite bar cap for loop exhaustion (active clip tplLoopBars, else channel header). */
export fn effectiveTplLoopCap(project, rt, chIdx) {
  if (!project || !project.channels || chIdx < 0 || chIdx >= project.channels.length) {
    return null
  }
  let ch = project.channels[chIdx]
  if (!rt) {
    if (ch.tplLoopBars === undefined || ch.tplLoopBars === null) {
      return null
    }
    let n0 = Math.floor(Number(ch.tplLoopBars))
    if (n0 >= 1 && n0 === n0) {
      return n0
    }
    return null
  }
  let cl = playbackClipForChannel(project, rt, chIdx)
  if (cl && cl.silent) {
    return null
  }
  if (cl && !cl.silent) {
    let c1 = clipLoopBarsCap(cl)
    if (c1 !== null) {
      return c1
    }
  }
  if (ch.tplLoopBars !== null && ch.tplLoopBars !== undefined) {
    let n2 = Math.floor(Number(ch.tplLoopBars))
    if (n2 >= 1 && n2 === n2) {
      return n2
    }
  }
  return null
}

export fn syncActiveClipsInstrumentsFromChannels(project, rt) {
  if (!project || !project.channels || !rt) {
    return
  }
  let editingScene = rt.editingScene !== null && rt.editingScene !== undefined ? Math.floor(Number(rt.editingScene)) : null
  if (editingScene === null || editingScene < 0) {
    return
  }
  ensureProjectSession(project)
  let sc = Math.floor(Number(project.session.sceneCount))
  if (editingScene >= sc) {
    return
  }
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    if (ch.clipInstrMode === "store") {
      let clipId = ""
      if (project.session.slots[ti] && (project.session.slots[ti][editingScene] !== null && project.session.slots[ti][editingScene] !== undefined)) {
        clipId = project.session.slots[ti][editingScene]
      }
      if (clipId !== "") {
        let clip = findClipOnChannel(ch, clipId)
        if (clip) {
          clip.instrument = snapshotInstrument(ch)
        }
      }
    }
    ti = ti + 1
  }
}
