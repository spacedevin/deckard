// Contextual presets for the in-project levels: sequence (a channel's pattern), rack (all channels),
// session (scenes/song/follow). Each preset is a named deck fragment (from emitLevel); loading routes its deck
// through the gated ingest, retargeted onto wherever you're editing. These are a personal LIBRARY of patterns
// — NOT document/deck content — so they live in localStorage (key below) and survive reloads, mirroring the
// StationPresets / SetLibrary / AudioDeviceSettings backend pattern. (They used to live on project.levelPresets,
// which was never serialized → silently lost on every reload.) Station presets remain separate (whole-workspace).
// The `project` arg is kept on every signature for call-site compatibility but is no longer the storage.

let KEY = "deckard.levelpresets.v1"
// "channel" = a whole TRACK (instrument + pattern), saved/loaded from each sequencer row's own icons.
let LEVELS = ["sequence", "rack", "session", "channel"]

fn backend() {
  // Gate via globalThis member access — `typeof localStorage` compiles to code that READS `localStorage`,
  // which throws ReferenceError under Node (tests import this module). `globalThis.localStorage` is a plain
  // property read → undefined off-browser, no throw. (See memory: lattish typeof-undeclared-global gotcha.)
  let ls = globalThis.localStorage
  if (ls !== null && ls !== undefined) {
    return {
      read: () => ls.getItem(KEY),
      write: (s) => {
        try {
          ls.setItem(KEY, s)
        } catch (e) {}
      }
    }
  }
  let mem = { v: null }
  return {
    read: () => mem.v,
    write: (s) => {
      mem.v = s
    }
  }
}

let be = backend()

fn readAll() {
  let raw = be.read()
  let obj = null
  if (raw !== null && raw !== undefined && String(raw).length > 0) {
    try {
      obj = JSON.parse(raw)
    } catch (e) {
      obj = null
    }
  }
  if ((obj === null || obj === undefined) || typeof obj !== "object") {
    obj = {}
  }
  let i = 0
  while (i < LEVELS.length) {
    if (!Array.isArray(obj[LEVELS[i]])) {
      obj[LEVELS[i]] = []
    }
    i = i + 1
  }
  return obj
}

fn writeAll(obj) {
  be.write(JSON.stringify(obj))
}

// Kept for call-site compatibility (storage is localStorage now; nothing to seed).
export fn ensureLevelPresets(project) {}

export fn levelPresetList(project, level) {
  let m = readAll()[level]
  return m ? m : []
}

export fn findLevelPreset(project, level, name) {
  let list = levelPresetList(project, level)
  let i = 0
  while (i < list.length) {
    if (list[i].name === name) {
      return list[i]
    }
    i = i + 1
  }
  return null
}

// Upsert by name (saving with an existing name overwrites it). Persists immediately.
export fn addLevelPreset(project, level, name, tpl) {
  let all = readAll()
  let list = all[level]
  let row = { name: name, tpl: tpl }
  let i = 0
  let found = false
  while (i < list.length) {
    if (list[i].name === name) {
      list[i] = row
      found = true
    }
    i = i + 1
  }
  if (!found) {
    list.push(row)
  }
  writeAll(all)
  return row
}

export fn removeLevelPreset(project, level, name) {
  let all = readAll()
  let list = all[level]
  let out = []
  let removed = false
  let i = 0
  while (i < list.length) {
    if (list[i].name === name) {
      removed = true
    } else {
      out.push(list[i])
    }
    i = i + 1
  }
  all[level] = out
  writeAll(all)
  return removed
}
