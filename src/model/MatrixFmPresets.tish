export fn matrixFmFactoryInstrumentPresets() {
  let data = matrixFmPatches()
  let out = []
  let i = 0
  while (i < data.length) {
    let d = data[i]
    out.push({
      presetId: d.id,
      name: "Matrix · " + d.name,
      generatorId: "matrixFm",
      params: {},
      generatorSpec: parseGenBlock("matrix_fm", d.lines)
    })
    i = i + 1
  }
  return out
}
