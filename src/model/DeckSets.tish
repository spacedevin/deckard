// Stem deck sets — a deck loads a whole rack (5-6 stems: kick / perc / bass / chord / arp-fx), each a
// full instrument + 16-step sequence, defined entirely in deck. You load a set onto a deck and DJ
// between two of them. Converted from the deck.tsx procedural TRACKS.
//
// The instrument timbres are NOT special-cased generators — every voice below is written in deck as a
// `gen_block patch` (modular: osc/noise/filter/shaper/gain + breakpoint envelopes). The voice library
// (vKickEdm, vBassAcid, vChordPad, …) is a faithful port of the deck.tsx AudioEngine synth routines,
// so e.g. the acid bass really is a sawtooth through a Q15 lowpass swept 3000→100Hz, etc.

import { emptyProjectShell } from './Project.tish'
import { applyTplSource } from '../tpl/Apply.tish'
import { channelDeck } from './DeckRouting.tish'
import { ensureProjectSession } from './Session.tish'
import { ensureCoDjMeta } from '../codj/CoDjMeta.tish'

fn L(arr) {
  return arr.join("\n")
}

/// Flatten a list whose entries are either single lines (strings) or arrays of lines.
fn flat(parts) {
  let out = []
  let i = 0
  while (i < parts.length) {
    let a = parts[i]
    if (typeof a === "string") {
      out.push(a)
    } else {
      let j = 0
      while (j < a.length) {
        out.push(a[j])
        j = j + 1
      }
    }
    i = i + 1
  }
  return out
}

// ---- Voice library (deck.tsx AudioEngine ports, as deck patch blocks) -----------------------------

// Kicks + basses now live as built-in macros (src/tpl/Macros.tish); referenced by name from the sets.

// Hats (noise → highpass → fast/slow decay)
fn vHatClosed() {
  return [
    "  gen_block patch",
    "    noise n",
    "    filter f highpass freq 8000",
    "    gain a",
    "    conn n f",
    "    conn f a",
    "    conn a out",
    "    env a.gain set 0 0.2 exp 0.05 0.01",
    "    dur 0.1",
    "  end gen_block"
  ]
}
fn vHatOpen() {
  return [
    "  gen_block patch",
    "    noise n",
    "    filter f highpass freq 5000",
    "    gain a",
    "    conn n f",
    "    conn f a",
    "    conn a out",
    "    env a.gain set 0 0.3 exp 0.3 0.01",
    "    dur 0.4",
    "  end gen_block"
  ]
}

// Snare (triangle body + bandpassed noise snap)
fn vSnare() {
  return [
    "  gen_block patch",
    "    osc o triangle",
    "    gain ag",
    "    noise n",
    "    filter nf bandpass freq 2500",
    "    gain ng",
    "    conn o ag",
    "    conn ag out",
    "    conn n nf",
    "    conn nf ng",
    "    conn ng out",
    "    env o.freq set 0 250 exp 0.2 0.01",
    "    env ag.gain set 0 0.5 exp 0.2 0.01",
    "    env ng.gain set 0 0.6 exp 0.25 0.01",
    "    dur 0.3",
    "  end gen_block"
  ]
}

// Chords (per chord-tone; pair with `voice chord minor|major`)
fn vChordPad() {
  return [
    "  gen_block patch",
    "    osc o1 sawtooth note detune -3",
    "    osc o2 sawtooth note detune 3",
    "    filter f lowpass",
    "    gain a",
    "    conn o1 f",
    "    conn o2 f",
    "    conn f a",
    "    conn a out",
    "    env f.freq set 0 400 lin dur*0.5 1500",
    "    env a.gain set 0 0.01 lin dur*0.3 0.18 set dur*0.8 0.18 lin dur 0.01",
    "  end gen_block"
  ]
}
fn vChordStab() {
  return [
    "  gen_block patch",
    "    osc o square note",
    "    gain a",
    "    conn o a",
    "    conn a out",
    "    env a.gain set 0 0.28 exp 0.3 0.01",
    "    dur 0.4",
    "  end gen_block"
  ]
}

// Leads / arps
fn vPluck() {
  return [
    "  gen_block patch",
    "    osc o square note",
    "    filter f lowpass",
    "    gain a",
    "    conn o f",
    "    conn f a",
    "    conn a out",
    "    env f.freq set 0 4000 exp 0.15 100",
    "    env a.gain set 0 0.3 exp 0.3 0.01",
    "    dur 0.4",
    "  end gen_block"
  ]
}
fn vFmPluck() {
  // sub-octave sine modulator FM'ing a sine carrier with an index sweep (metallic crunch)
  return [
    "  gen_block patch",
    "    osc c sine note",
    "    osc m sine note ratio 0.5",
    "    gain mg",
    "    gain a",
    "    conn m mg",
    "    conn mg c.freq",
    "    conn c a",
    "    conn a out",
    "    env mg.gain set 0 note*2 exp 0.3 10",
    "    env a.gain set 0 0.5 exp 0.3 0.01",
    "    dur 0.4",
    "  end gen_block"
  ]
}
fn vNoiseSweep() {
  // Vinyl/atmosphere texture: bandpassed noise swept top→bottom with a slow swell (deck.tsx playNoiseSweep).
  return [
    "  gen_block patch",
    "    noise n",
    "    filter f bandpass q 5 freq 6000",
    "    gain a",
    "    conn n f",
    "    conn f a",
    "    conn a out",
    "    env f.freq set 0 6000 exp 1.5 200",
    "    env a.gain set 0 0.01 lin 0.75 0.22 lin 1.5 0.01",
    "    dur 1.5",
    "  end gen_block"
  ]
}

/// Reverb send per stem role — drums and bass stay DRY (deck.tsx sent only chords/snare/leads to the
/// reverb); melodic/atmospheric stems get a tail. Derived from the stem name so every set is consistent.
fn reverbForStem(name) {
  if (name === "Chord" || name === "Stab" || name === "Pad") {
    return 0.3
  }
  if (name === "Pluck" || name === "Arp") {
    return 0.25
  }
  if (name === "Texture") {
    return 0.35
  }
  if (name === "Snare") {
    return 0.12
  }
  return 0
}

/// Build one stem track. `voice` is either an inline patch (array of gen_block lines) OR a macro
/// reference string ("kick_edm" or "bass_wobble lfo 2"). The reverbSend arg is kept for call-site
/// readability but the actual send is role-derived.
fn stem(name, id, reverbSend, voice, tail) {
  return stemB(name, id, 1, voice, tail)
}

/// Multi-bar stem: `bars` > 1 emits `* N` in the header so the channel loops over N bars.
fn stemB(name, id, bars, voice, tail) {
  let rv = reverbForStem(name)
  let fx = "  fx cutoff 20000 reverb_send " + String(rv)
  if (typeof voice === "string") {
    // Macro reference → `gen <macro> [* N] [params]`, no inline gen_block.
    let parts = voice.split(" ")
    let hdr = "track " + name + " id " + id + " gen " + parts[0]
    if (bars > 1) {
      hdr = hdr + " * " + String(bars)
    }
    let pi = 1
    while (pi < parts.length) {
      hdr = hdr + " " + parts[pi]
      pi = pi + 1
    }
    return flat([[hdr, fx], tail])
  }
  let hdr2 = "track " + name + " id " + id + " gen patch"
  if (bars > 1) {
    hdr2 = hdr2 + " * " + String(bars)
  }
  return flat([[hdr2, fx], voice, tail])
}

/// Emit `note` lines for a per-bar progression. entries = [[barSel, [pitch...]], ...]; one note per
/// (entry pitch × beat), tagged `bar <barSel>` so it repeats on the matching loop bars.
fn progNotes(entries, beats, dur, vel) {
  let out = []
  let ei = 0
  while (ei < entries.length) {
    let sel = entries[ei][0]
    let pitches = entries[ei][1]
    let bj = 0
    while (bj < beats.length) {
      let pi = 0
      while (pi < pitches.length) {
        out.push("  note " + String(pitches[pi]) + " " + String(beats[bj]) + " " + String(dur) + " v " + String(vel) + " bar " + sel)
        pi = pi + 1
      }
      bj = bj + 1
    }
    ei = ei + 1
  }
  return out
}

/// Aetherial's evolving pentatonic pluck (deck.tsx: ARPS[(step+bar)%6] on step%3===0, ~half firing).
/// Over the 16-bar loop the +bar term walks the C-minor-pentatonic arp; we keep a sparse 4/bar subset.
fn aetherialPluck() {
  let arps = [60, 63, 67, 70, 72, 75]
  let out = []
  let step = 0
  let cand = 0
  while (step < 256) {
    if (step % 3 === 0) {
      if (cand % 5 < 3) {
        let bar = Math.floor(step / 16)
        let idx = (((step + bar) % 6) + 6) % 6
        out.push("  note " + String(arps[idx]) + " " + String(step * 0.25) + " 0.25 v 75")
      }
      cand = cand + 1
    }
    step = step + 1
  }
  return out
}

/// Emit `step_pitch ... bar <sel>` lines for a per-bar root. prog = [[barSel, pitch], ...].
fn stepPitchProg(prog) {
  let out = []
  let i = 0
  while (i < prog.length) {
    out.push("  step_pitch " + String(prog[i][1]) + " bar " + prog[i][0])
    i = i + 1
  }
  return out
}

fn vLofiDust() {
  return [
    "  gen_block patch",
    "    noise n",
    "    filter f lowpass freq 1200 q 0",
    "    shaper s soft amount 1",
    "    gain a",
    "    conn n f",
    "    conn f s",
    "    conn s a",
    "    conn a out",
    "    env a.gain set 0 0.03 lin dur 0.03",
    "  end gen_block"
  ]
}

fn vLofiSnare() {
  return [
    "  gen_block patch",
    "    noise n",
    "    filter f bandpass freq 1200 q 2",
    "    gain a",
    "    conn n f",
    "    conn f a",
    "    conn a out",
    "    env a.gain set 0 0.4 exp 0.2 0.01",
    "    dur 0.3",
    "  end gen_block"
  ]
}

fn vWarmDetunedLead() {
  return [
    "  gen_block patch",
    "    osc o1 sawtooth note detune -8",
    "    osc o2 square note detune 6",
    "    filter f lowpass q 2",
    "    gain a",
    "    conn o1 f",
    "    conn o2 f",
    "    conn f a",
    "    conn a out",
    "    env f.freq set 0 600 exp dur*0.5 200",
    "    env a.gain set 0 0.01 lin 0.05 0.3 lin dur 0.01",
    "  end gen_block"
  ]
}

fn vSubRolling() {
  return [
    "  gen_block patch",
    "    osc o triangle note",
    "    filter f lowpass freq 300",
    "    gain a",
    "    conn o f",
    "    conn f a",
    "    conn a out",
    "    env a.gain set 0 0.01 lin 0.1 0.7 lin dur*0.8 0.7 lin dur 0.01",
    "  end gen_block"
  ]
}

fn vEtherealPad() {
  return [
    "  gen_block patch",
    "    osc o1 sawtooth note detune -5",
    "    osc o2 sawtooth note detune 5",
    "    filter f lowpass q 1",
    "    gain a",
    "    conn o1 f",
    "    conn o2 f",
    "    conn f a",
    "    conn a out",
    "    env f.freq set 0 200 lin dur*0.5 800 lin dur 200",
    "    env a.gain set 0 0.01 lin dur*0.3 0.25 lin dur 0.01",
    "  end gen_block"
  ]
}

