/** [{ id, name, genre, bpm }] for the deck-set picker. */
export fn deckSetCatalog() {
  let sets = deckSetTpls()
  let out = []
  let i = 0
  while (i < sets.length) {
    let s = sets[i]
    out.push({ id: s.id, name: s.name, genre: s.genre, bpm: s.bpm })
    i = i + 1
  }
  return out
}

export fn deckSetTplById(setId) {
  let sets = deckSetTpls()
  let i = 0
  while (i < sets.length) {
    if (sets[i].id === setId) {
      return sets[i]
    }
    i = i + 1
  }
  return null
}

/** Replace a deck's channels with the set's stems. deckId "A" = host (local), "B" = client. */
export fn loadDeckSet(project, deckId, setId) {
  let set = deckSetTplById(setId)
  if (!set) {
    return false
  }
  let want = deckId === "B" ? "B" : "A"
  let lane = deckId === "B" ? "client" : ""
  let deckField = deckId === "B" ? "live" : "local"
  // Drop the channels currently on this deck.
  let kept = []
  let j = 0
  while (j < project.channels.length) {
    if (channelDeck(project, project.channels[j]) !== want) {
      kept.push(project.channels[j])
    }
    j = j + 1
  }
  project.channels = kept
  // Parse the set into a throwaway project, then graft its channels onto this deck.
  let tmp = emptyProjectShell()
  applyTplSource(tmp, set.tpl)
  let prefix = (deckId === "B" ? "b_" : "a_")
  let k = 0
  while (k < tmp.channels.length) {
    let ch = tmp.channels[k]
    ch.id = prefix + ch.id
    ch.actorLane = lane
    ch.deck = deckField
    // Rebuild session clips under the new (prefixed) id so the main clip id matches the channel.
    ch.sessionClips = []
    project.channels.push(ch)
    k = k + 1
  }
  if (project.coDjMeta) {
    project.coDjMeta.tracks = {}
  }
  ensureCoDjMeta(project)
  ensureProjectSession(project)
  return true
}
