/** [{ id, name, genre, bpm }] for the deck-set picker. */
export fn deckSetCatalog() {
  let sets = deckSetTpls()
  let out = []
  let i = 0
  while (i < sets.length) {
    let s = sets[i]
    out.push({ id: s.id, name: s.name, genre: s.genre, bpm: s.bpm })
    i = i + 1
  }
  return out
}

export fn deckSetTplById(setId) {
  let sets = deckSetTpls()
  let i = 0
  while (i < sets.length) {
    if (sets[i].id === setId) {
      return sets[i]
    }
    i = i + 1
  }
  return null
}

/**
 * Graft a plain rack deck onto one deck, replacing whatever was there. The shared core behind both
 * loadDeckSet (catalog rack) and loadSet (a captured Set player). deckId "A"=host (local), B/C/D=others.
 * `keepClips` retains the rack's session clips (re-prefixed) — Set players carry clips, catalog racks don't.
 */
export fn graftRackOntoDeck(project, deckId, rackTpl, keepClips) {
  let idx = deckId === "B" ? 1 : deckId === "C" ? 2 : deckId === "D" ? 3 : 0
  let want = idx === 1 ? "B" : idx === 2 ? "C" : idx === 3 ? "D" : "A"
  let lane = idx === 0 ? "" : "client"
  let deckField = idx === 0 ? "local" : "live"
  let prefix = idx === 1 ? "b_" : idx === 2 ? "c_" : idx === 3 ? "d_" : "a_"
  // Swapping ONE deck must not wipe the rest of the session. Capture each existing channel's session
  // slot row (and ownership) by id, so channels that survive the swap keep their saved scenes/clips.
  let prevSlots = {}
  if (project.session && project.session.slots) {
    let pi = 0
    while (pi < project.channels.length && pi < project.session.slots.length) {
      prevSlots[project.channels[pi].id] = project.session.slots[pi]
      pi = pi + 1
    }
  }
  // Drop the channels currently on THIS deck (only) — never touch the other 3 decks.
  let kept = []
  let j = 0
  while (j < project.channels.length) {
    if (channelDeck(project, project.channels[j]) !== want) {
      kept.push(project.channels[j])
    }
    j = j + 1
  }
  project.channels = kept
  // Parse the rack into a throwaway project, then graft its channels onto this deck.
  let tmp = emptyProjectShell()
  applyTplSource(tmp, rackTpl)
  if (tmp.session && tmp.session.sceneCount > 0) {
    if (tmp.session.sceneCount > project.session.sceneCount) {
      project.session.sceneCount = tmp.session.sceneCount
    }
  }

  if (tmp.session && tmp.session.follow && tmp.session.follow.length > 0) {
    let fi = 0
    if (!project.session.follow) {
      project.session.follow = []
    }
    while (fi < tmp.session.follow.length) {
      let f = tmp.session.follow[fi]
      if (f) {
        while (project.session.follow.length <= f.scene) {
          project.session.follow.push(null)
        }
        project.session.follow[f.scene] = { action: f.action, target: f.target }
      }
      fi = fi + 1
    }
  }

  if (tmp.bpm > 0 && tmp.bpm !== 120) {
    project.bpm = tmp.bpm
  }
  if (tmp.swing > 0) {
    project.swing = tmp.swing
  }

  let loadedSlots = {}

  let k = 0
  while (k < tmp.channels.length) {
    let ch = tmp.channels[k]
    let origId = ch.id
    ch.id = prefix + ch.id
    ch.actorLane = lane
    ch.deck = deckField
    ch.deckSlot = idx
    if (keepClips && ch.sessionClips && ch.sessionClips.length > 0) {
      // Re-prefix clip ids so they stay unique across decks but ride with their (re-prefixed) channel.
      let ck = 0
      while (ck < ch.sessionClips.length) {
        ch.sessionClips[ck].id = prefix + ch.sessionClips[ck].id
        ck = ck + 1
      }
    } else {
      // Catalog racks have no clips; rebuild empty so the main clip id matches the channel.
      ch.sessionClips = []
    }
    
    let chSlots = tmp.session && tmp.session.slots && k < tmp.session.slots.length ? tmp.session.slots[k] : []
    let prefixChSlots = []
    let csi = 0
    while (csi < chSlots.length) {
      if (chSlots[csi] && chSlots[csi].length > 0) {
        prefixChSlots.push(prefix + chSlots[csi])
      } else {
        prefixChSlots.push("")
      }
      csi = csi + 1
    }
    loadedSlots[ch.id] = prefixChSlots

    project.channels.push(ch)
    k = k + 1
  }
  // Keep ownership for the surviving channels; drop only the swapped-out deck's (orphaned) entries.
  if (project.coDjMeta && project.coDjMeta.tracks) {
    let keptTracks = {}
    let mi = 0
    while (mi < project.channels.length) {
      let cid = project.channels[mi].id
      if (project.coDjMeta.tracks[cid] !== null && project.coDjMeta.tracks[cid] !== undefined) {
        keptTracks[cid] = project.coDjMeta.tracks[cid]
      }
      mi = mi + 1
    }
    project.coDjMeta.tracks = keptTracks
  }
  ensureCoDjMeta(project)
  // Rebuild the scene grid in the new channel order: surviving channels keep their saved slot row (so
  // other decks' queued sessions persist); the swapped-in channels get fresh rows. No stale slot ids.
  if (project.session) {
    let newSlots = []
    let ci = 0
    while (ci < project.channels.length) {
      let cid = project.channels[ci].id
      newSlots.push((prevSlots[cid] !== null && prevSlots[cid] !== undefined) ? prevSlots[cid] : ((loadedSlots[cid] !== null && loadedSlots[cid] !== undefined) ? loadedSlots[cid] : []))
      ci = ci + 1
    }
    project.session.slots = newSlots
  }
  ensureProjectSession(project)
  return true
}

/** Replace a deck's channels with the catalog set's stems. deckId "A" = host (local), "B" = client. */
export fn loadDeckSet(project, deckId, setId) {
  let set = deckSetTplById(setId)
  if (!set) {
    return false
  }
  return graftRackOntoDeck(project, deckId, set.tpl, false)
}
