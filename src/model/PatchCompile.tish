// Compile a fixed generator into the EQUIVALENT patch graph, so "switch to Patch" is a lossless
// reduction (the sound is preserved) rather than a reset to a default. This is what makes `patch` the
// universal substrate: every voice can be expressed as osc/noise/filter/shaper/gain + breakpoint
// envelopes. The macros already prove it; this extends the same idea to the built-in generators.
//
// Loudness match: the fixed engines scale velocity by vel/127, but playPatch uses vel/100 and applies
// the output `conn` vol × that. So a compiled output `conn ... <100/127>` reproduces the same level.
// FM depth + drum pitch-drop are note-relative, expressed with the `note*<k>` resolver tokens.

import { formatTplFloat } from '../tpl/Format.tish'
import { normalizeBasicOscWaveform } from '../generators/Registry.tish'
import { sortedStringKeys } from '../tpl/MatrixFmGraph.tish'

let VOL_COMP = 100 / 127

fn f(x) {
  return formatTplFloat(x)
}

/// Amp ADSR as normalized breakpoints (peak 1): 0 → 1 (attack) → sustain (decay) → hold to note-off → 0.
fn adsrAmpEnv(node, a, d, s, r) {
  let aPlusD = a + d
  return (
    "env " +
    node +
    ".gain set 0 0 lin " +
    f(a) +
    " 1 lin " +
    f(aPlusD) +
    " " +
    f(s) +
    " set dur " +
    f(s) +
    " lin dur+" +
    f(r) +
    " 0"
  )
}

fn basicOscLines(p) {
  let wave = normalizeBasicOscWaveform(p.waveform)
  let a = p.attack > 0 ? p.attack : 0.005
  let d = p.decay > 0 ? p.decay : 0.08
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.4
  let r = p.release > 0 ? p.release : 0.12
  return [
    "osc o1 " + wave + " note",
    "gain a1 0",
    "conn o1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    adsrAmpEnv("a1", a, d, s, r)
  ]
}

fn fmToneLines(p) {
  let ratio = p.ratio > 0 && p.ratio < 64 ? p.ratio : 2
  let modIndex = p.modIndex >= 0 && p.modIndex <= 48 ? p.modIndex : 4
  let carW = normalizeBasicOscWaveform(p.carrierWave ? p.carrierWave : "sine")
  let modW = normalizeBasicOscWaveform(p.modWave ? p.modWave : "sine")
  let a = p.attack > 0 ? p.attack : 0.005
  let d = p.decay > 0 ? p.decay : 0.08
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.4
  let r = p.release > 0 ? p.release : 0.12
  return [
    "osc m1 " + modW + " note ratio " + f(ratio),
    "gain md 1",
    "osc c1 " + carW + " note",
    "gain a1 0",
    "conn m1 md 1",
    "conn md c1.freq 1",
    "conn c1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env md.gain set 0 note*" + f(modIndex * 0.12),
    adsrAmpEnv("a1", a, d, s, r)
  ]
}

fn noiseBurstLines(p) {
  let decay = p.decay > 0 ? p.decay : 0.08
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let rise = p.attack > 0 ? p.attack : 0.002
  if (rise > 0.15) {
    rise = 0.15
  }
  // Engine center = (400 + tone*7000)*(1-pitchFollow) + note*pitchFollow. The note term isn't expressible
  // as a DC filter offset in the patch grammar, so we keep the (1-pitchFollow) scaling (the dominant term)
  // and drop the small note-tracking residual.
  let pf = p.pitchFollow >= 0 && p.pitchFollow <= 1 ? p.pitchFollow : 0.2
  let center = Math.round((400 + tone * 7000) * (1 - pf))
  let q = 0.7 + tone * 3
  let hitDur = decay * 3 + 0.02
  return [
    "noise n1",
    "filter f1 bandpass q " + f(q) + " freq " + f(center),
    "gain a1 0",
    "conn n1 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env a1.gain set 0 0 lin " + f(rise) + " 1 exp " + f(hitDur) + " 0.001"
  ]
}

fn padLines(p) {
  let w1 = normalizeBasicOscWaveform(p.wave1 ? p.wave1 : "sine")
  let w2 = normalizeBasicOscWaveform(p.wave2 ? p.wave2 : "triangle")
  let detune = p.detune != null ? p.detune : 9
  let cutoff = p.cutoff != null && p.cutoff > 0 ? p.cutoff : 2200
  let a = p.attack > 0 ? p.attack : 0.08
  let d = p.decay > 0 ? p.decay : 0.25
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.6
  let r = p.release > 0 ? p.release : 0.7
  return [
    "osc o1 " + w1 + " note",
    "osc o2 " + w2 + " note detune " + f(detune),
    "osc o3 sine note ratio 0.5 detune " + f(-detune),
    "filter f1 lowpass q 0.7 freq " + f(cutoff),
    "gain a1 0",
    "conn o1 f1 1",
    "conn o2 f1 1",
    "conn o3 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.5),
    adsrAmpEnv("a1", a, d, s, r)
  ]
}

fn bellLines(p) {
  let partial = p.partial > 0 ? p.partial : 2.01
  let hp = p.highpass > 0 ? p.highpass : 800
  let decay = p.decay > 0 ? p.decay : 1.0
  return [
    "osc o1 sine note",
    "osc o2 sine note ratio " + f(partial),
    "filter f1 highpass q 0.7 freq " + f(hp),
    "gain a1 0",
    "conn o1 f1 1",
    "conn o2 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.4),
    "env a1.gain set 0 0 lin 0.006 1 exp " + f(decay) + " 0.0008"
  ]
}

fn drumSynthLines(p) {
  let tone = normalizeBasicOscWaveform(p.tone ? p.tone : "sine")
  let pitchEnv = p.pitchEnv != null ? p.pitchEnv : 36
  let pitchDecay = p.pitchDecay > 0 ? p.pitchDecay : 0.06
  let decay = p.decay > 0 ? p.decay : 0.35
  let noise = p.noise != null ? p.noise : 0
  let noiseDecay = p.noiseDecay > 0 ? p.noiseDecay : 0.12
  let noiseHp = p.noiseHp > 0 ? p.noiseHp : 1500
  let drive = p.drive != null ? p.drive : 0
  let pitchMul = Math.pow(2, pitchEnv / 12)
  let lines = ["osc o1 " + tone + " note", "gain a1 0"]
  if (drive > 0) {
    lines.push("shaper sh1 amount " + f(drive * 120))
    lines.push("conn o1 sh1 1")
    lines.push("conn sh1 a1 1")
  } else {
    lines.push("conn o1 a1 1")
  }
  lines.push("conn a1 out " + f(VOL_COMP))
  lines.push("env o1.freq set 0 note*" + f(pitchMul) + " exp " + f(pitchDecay) + " note")
  lines.push("env a1.gain set 0 1 exp " + f(decay) + " 0.0008")
  if (noise > 0.001) {
    lines.push("noise n1")
    lines.push("filter nf highpass q 0.7 freq " + f(noiseHp))
    lines.push("gain ng 0")
    lines.push("conn n1 nf 1")
    lines.push("conn nf ng 1")
    lines.push("conn ng out " + f(VOL_COMP * noise))
    lines.push("env ng.gain set 0 1 exp " + f(noiseDecay) + " 0.0008")
  }
  return lines
}

fn clampHz(h) {
  if (h < 20) {
    return 20
  }
  if (h > 20000) {
    return 20000
  }
  return h
}

/// Op amplitude env, peaked at vel/127 (resolveExpr `vel` = vel/100, so `vel*0.7874` = vel/127) — matches
/// the Matrix FM engine's per-operator ADSR. The route's output conn supplies the second velocity factor.
fn opVelEnv(node, a, d, s, r) {
  let pk = "vel*" + f(VOL_COMP)
  let su = "vel*" + f(VOL_COMP * s)
  return (
    "env " + node + ".gain set 0 0 lin " + f(a) + " " + pk + " lin " + f(a + d) + " " + su +
    " set dur " + su + " lin dur+" + f(r) + " 0"
  )
}

fn cutoffEnvLine(node, c0, amount, a, d, s, r) {
  let peakF = clampHz(c0 + amount)
  let susF = clampHz(c0 + amount * s)
  let baseF = clampHz(c0)
  return (
    "env " + node + ".freq set 0 " + f(baseF) + " lin " + f(a) + " " + f(peakF) +
    " lin " + f(a + d) + " " + f(susF) + " set dur " + f(susF) + " lin dur+" + f(r) + " " + f(baseF)
  )
}

fn patchFilterType(t) {
  let s = String(t).toLowerCase()
  if (s.indexOf("hp") >= 0) {
    return "highpass"
  }
  return "lowpass"
}

/// Compile the Matrix FM operator/matrix/filter/route graph into an equivalent patch graph.
fn matrixFmLines(graph) {
  if (!graph || !graph.ops) {
    return null
  }
  let ops = graph.ops
  let opKeys = sortedStringKeys(ops)
  if (opKeys.length === 0) {
    return null
  }
  let opEnvs = graph.opEnvs ? graph.opEnvs : {}
  let mods = graph.mods ? graph.mods : []
  let filters = graph.filters ? graph.filters : {}
  let filterEnvs = graph.filterEnvs ? graph.filterEnvs : {}
  let routes = graph.routes ? graph.routes : []
  let lines = []
  let tail = {}

  // 1) operator source nodes (osc note*ratio, or noise)
  let i = 0
  while (i < opKeys.length) {
    let oid = opKeys[i]
    let od = ops[oid]
    let wave = od.wave ? od.wave : "sine"
    let ratio = od.ratio != null && od.ratio > 0 ? od.ratio : 1
    if (wave === "noise") {
      lines.push("noise op" + oid)
    } else {
      lines.push("osc op" + oid + " " + normalizeBasicOscWaveform(wave) + " note ratio " + f(ratio))
    }
    tail[oid] = "op" + oid
    i = i + 1
  }

  // 2) ring modulation: dst tail → rmG, src tail → rmG.gain (scaled). RM retargets the dst's tail.
  let rmIdx = 0
  let mi = 0
  while (mi < mods.length) {
    let md = mods[mi]
    if (md.type === "rm" && md.src !== md.dst && tail[md.dst] && tail[md.src]) {
      let rmId = "rm" + String(rmIdx)
      let amt = md.amount === md.amount ? md.amount : 1
      lines.push("gain " + rmId + " 0")
      lines.push("conn " + tail[md.dst] + " " + rmId + " 1")
      lines.push("conn " + tail[md.src] + " " + rmId + ".gain " + f(amt * 0.4))
      tail[md.dst] = rmId
      rmIdx = rmIdx + 1
    }
    mi = mi + 1
  }

  // 3) per-operator amp envelope gains
  let ei = 0
  while (ei < opKeys.length) {
    let oid = opKeys[ei]
    let e = opEnvs[oid]
    let a = e && e.a != null ? e.a : 0.005
    let d = e && e.d != null ? e.d : 0.1
    let s = e && e.s != null ? e.s : 0.35
    let r = e && e.r != null ? e.r : 0.12
    lines.push("gain eg" + oid + " 0")
    lines.push("conn " + tail[oid] + " eg" + oid + " 1")
    lines.push(opVelEnv("eg" + oid, a, d, s, r))
    ei = ei + 1
  }

  // 4) FM: modulator tail → depth gain (note-relative) → carrier osc frequency
  let fmIdx = 0
  let fi = 0
  while (fi < mods.length) {
    let md = mods[fi]
    if (md.type === "fm" && md.dst && ops[md.dst] && ops[md.dst].wave !== "noise" && tail[md.src]) {
      let ratioD = ops[md.dst].ratio != null && ops[md.dst].ratio > 0 ? ops[md.dst].ratio : 1
      let amt = md.amount === md.amount ? md.amount : 1
      let depthK = ratioD * amt * 0.12
      let fmgId = "fmg" + String(fmIdx)
      lines.push("gain " + fmgId + " 1")
      lines.push("conn " + tail[md.src] + " " + fmgId + " 1")
      lines.push("env " + fmgId + ".gain set 0 note*" + f(depthK))
      lines.push("conn " + fmgId + " op" + md.dst + ".freq 1")
      fmIdx = fmIdx + 1
    }
    fi = fi + 1
  }

  // 5) filters (24dB = two cascaded biquads) + cutoff envelope
  let filterFirst = {}
  let filterLast = {}
  let fkeys = sortedStringKeys(filters)
  let fk = 0
  while (fk < fkeys.length) {
    let fid = fkeys[fk]
    let fd = filters[fid]
    let ptype = patchFilterType(fd.type)
    let c0 = clampHz(fd.cutoff != null ? fd.cutoff : 8000)
    let qv = fd.res != null ? fd.res : 0.7
    let q = qv * 8
    if (q > 40) {
      q = 40
    }
    if (q < 0.0001) {
      q = 0.0001
    }
    let two = String(fd.type).toLowerCase().indexOf("24") >= 0
    let fe = filterEnvs[fid]
    let amt = fe && fe.amount != null ? fe.amount : 0
    let fa = fe && fe.a != null ? fe.a : 0.1
    let fdd = fe && fe.d != null ? fe.d : 0.2
    let fs = fe && fe.s != null ? fe.s : 0.3
    let fr = fe && fe.r != null ? fe.r : 0.15
    if (two) {
      lines.push("filter f" + fid + "a " + ptype + " q " + f(q) + " freq " + f(c0))
      lines.push("filter f" + fid + "b " + ptype + " q " + f(q) + " freq " + f(c0))
      lines.push("conn f" + fid + "a f" + fid + "b 1")
      filterFirst[fid] = "f" + fid + "a"
      filterLast[fid] = "f" + fid + "b"
      if (amt !== 0) {
        lines.push(cutoffEnvLine("f" + fid + "a", c0, amt, fa, fdd, fs, fr))
        lines.push(cutoffEnvLine("f" + fid + "b", c0, amt, fa, fdd, fs, fr))
      }
    } else {
      lines.push("filter f" + fid + " " + ptype + " q " + f(q) + " freq " + f(c0))
      filterFirst[fid] = "f" + fid
      filterLast[fid] = "f" + fid
      if (amt !== 0) {
        lines.push(cutoffEnvLine("f" + fid, c0, amt, fa, fdd, fs, fr))
      }
    }
    fk = fk + 1
  }

  // 6) routes: op/filter → filter/out. Output conn carries the second velocity factor (× 100/127).
  let routed = false
  let ri = 0
  while (ri < routes.length) {
    let rt = routes[ri]
    let vol = rt.volume === rt.volume ? rt.volume : 1
    let srcN = null
    if (rt.srcKind === "op") {
      srcN = "eg" + rt.srcId
    } else {
      if (rt.srcKind === "filter" && filterLast[rt.srcId]) {
        srcN = filterLast[rt.srcId]
      }
    }
    if (srcN) {
      if (rt.dstKind === "filter" && filterFirst[rt.dstId]) {
        lines.push("conn " + srcN + " " + filterFirst[rt.dstId] + " " + f(vol))
        routed = true
      } else {
        if (rt.dstKind === "out") {
          lines.push("conn " + srcN + " out " + f(vol * VOL_COMP))
          routed = true
        }
      }
    }
    ri = ri + 1
  }
  if (!routed) {
    lines.push("conn eg" + opKeys[0] + " out " + f(VOL_COMP))
  }
  return lines
}

// Guitar = the EXACT live Karplus-Strong plucked string, now expressible in TPL via the `string` primitive
// (the old subtractive saw approximation could never match the comb-rich plucked spectrum — it was the
// furthest-off patch voice). The `string` node renders the same KS buffer playGuitar does; the rest of the
// live chain (drive → body lowpass → flat-top amp) is plain patch nodes. The ring/decay lives INSIDE the
// string buffer, so the amp env is a FLAT-TOP gate (attack → hold at 1 → 60ms release), NOT an exp — an exp
// would DOUBLE the decay. `dur <ringSec>` sizes voiceDur so the ring isn't truncated.
fn guitarLines(p) {
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let decayP = p.decay >= 0 && p.decay <= 1 ? p.decay : 0.6
  let damping = p.damping >= 0 && p.damping <= 1 ? p.damping : 0.4
  let drive = p.drive != null ? p.drive : 0.25
  let mute = p.mute >= 0 && p.mute <= 1 ? p.mute : 0
  let body = p.body != null && p.body > 0 ? p.body : 3500
  let bodyHz = body * (1 - mute * 0.5)
  let ringSec = (0.4 + decayP * 2.1) * (1 - mute * 0.8)
  let relStart = ringSec - 0.06
  if (relStart < 0.005) {
    relStart = 0.005
  }
  // tone/damping/decay/mute shape the KS string itself (excitation brightness, loop damping, ring length);
  // the body lowpass at a CONSTANT bodyHz (Q 0.9) is the live cab/body rolloff — no tone sweep on it.
  let lines = [
    "string s1 note tone " + f(tone) + " damping " + f(damping) + " decay " + f(decayP) + " mute " + f(mute),
    "filter f1 lowpass q 0.9 freq " + f(bodyHz),
    "gain a1 0"
  ]
  if (drive > 0) {
    // The live pickup/amp grit: the `guitar` waveshaper curve (k = amount, = drive*100) at FULL input gain.
    lines.push("shaper sh1 amount " + f(drive * 100) + " curve guitar")
    lines.push("conn s1 sh1 1")
    lines.push("conn sh1 f1 1")
  } else {
    lines.push("conn s1 f1 1")
  }
  lines.push("conn f1 a1 1")
  // Live amp peaks at v*0.7; the out conn applies v once, so carry the 0.7 here (× VOL_COMP). The KS buffer
  // is rendered at unit amplitude, so no double-velocity.
  lines.push("conn a1 out " + f(VOL_COMP * 0.7))
  lines.push("env a1.gain set 0 0 lin 0.004 1 set " + f(relStart) + " 1 lin " + f(ringSec) + " 0")
  lines.push("dur " + f(ringSec))
  return lines
}

// Clap reduces (one voice can't do the multi-burst cluster) to a single bandpassed noise snap + tail —
// a plausible single clap. The cluster/hands behaviour only exists in the live generator.
fn clapLines(p) {
  let size = p.size >= 0 && p.size <= 1 ? p.size : 0.5
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let tail = p.tail >= 0 && p.tail <= 1 ? p.tail : 0.4
  let center = Math.round(900 + size * 1400)
  let q = 1.4 + tone * 4.5
  let hp = Math.round(500 + tone * 900)
  let decay = 0.02 + tail * 0.34
  return [
    "noise n1",
    "filter f1 bandpass q " + f(q) + " freq " + f(center),
    "filter f2 highpass q 0.7 freq " + f(hp),
    "gain a1 0",
    "conn n1 f1 1",
    "conn f1 f2 1",
    "conn f2 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env a1.gain set 0 0 lin 0.0006 1 exp " + f(decay) + " 0.001"
  ]
}

// Arco — a bowed string: TWO slightly-detuned saws (the bowed shimmer) → a brightness lowpass (opened by
// pressure) → an amp that SUSTAINS while the bow holds the note then releases (it is NOT a fixed 2s decay —
// that made it drone). Per-family detune/brightness keeps violin/viola/cello/bass/fiddle distinct. The body
// formants + rosin noise + vibrato LFO live only in the real generator (the grammar can't boost formants).
fn arcoLines(p) {
  let pressure = p.pressure >= 0 && p.pressure <= 1 ? p.pressure : 0.5
  let bow = p.bow >= 0 && p.bow <= 1 ? p.bow : 0.4
  let body = p.body >= 0 && p.body <= 1 ? p.body : 0.6
  let voice = p.voice ? p.voice : "violin"
  let bright = voice === "viola" ? 0.85 : (voice === "cello" ? 0.72 : (voice === "bass" ? 0.6 : (voice === "fiddle" ? 1.22 : 1.0)))
  let det = voice === "cello" ? 6 : (voice === "bass" ? 7 : (voice === "fiddle" ? 9 : 5))
  let cutoff = Math.round((700 + pressure * 5200) * bright)
  if (cutoff > 16000) {
    cutoff = 16000
  }
  let attack = 0.01 + bow * 0.22
  let release = 0.1 + body * 0.18
  // Live Arco clamps hold to max(durSec, attack+0.05) — short bowed notes still complete the bow "catch".
  let hold = attack + 0.05
  return [
    "osc o1 sawtooth note detune " + f(0 - det),
    "osc o2 sawtooth note detune " + f(det),
    "filter f1 lowpass q 0.7 freq " + f(cutoff),
    "gain a1 0",
    "conn o1 f1 1",
    "conn o2 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 1.47),
    "env a1.gain set 0 0 lin " + f(attack) + " 1 set max(dur," + f(hold) + ") 1 exp max(dur," + f(hold) + ")+" + f(release) + " 0.0008"
  ]
}

// The premium voices reduce to FAITHFUL, param-driven patch graphs (the patch engine supports FM via
// conn→.freq, ratio/detune oscillators, and note/dur envelope expressions) so switching to Patch keeps the
// instrument's character AND the user's current knob settings. What can't survive: the patch grammar has no
// per-partial decay or formant GAIN (filters have freq/Q but no boost), so the layered shimmer/breath/
// tremolo of the live engine is approximated, not reproduced — but the core voice carries over.

// Tine → real 1:1 FM: a sine modulator drives the carrier's frequency; `bark` scales the FM-index envelope
// (bright metallic attack settling to a near-sine bell), `decay` the body length.
fn tineLines(p) {
  let bark = p.bark >= 0 && p.bark <= 1 ? p.bark : 0.55
  let tine = p.tine >= 0 && p.tine <= 1 ? p.tine : 0.6
  let tremolo = p.tremolo >= 0 && p.tremolo <= 1 ? p.tremolo : 0.35
  let decay = p.decay >= 0 && p.decay <= 1 ? p.decay : 0.5
  let drive = p.drive != null ? p.drive : 0.2
  // Body decay is key-scaled on a real EP (mid-keyboard ~0.78 factor, note unknown at compile time).
  let bodyDecay = (1.1 + decay * 5.4) * 0.78
  let barkDecay = 0.12 + decay * 0.5
  let idxFloor = 0.6 + bark * 1.4
  let spikeCoef = 1.5 + bark * 7.5
  // FM bark = the live modDepth index env, decomposed BY VELOCITY into two SAME-PHASE modulator paths (both at
  // the note pitch, so they sum to one modulator). The grammar can't write `a + b*vel` in one breakpoint, so:
  //   mf = the velocity-INDEPENDENT index: peak idxFloor → floor idxFloor*0.25 (over barkDecay) → fade.
  //   ms = the velocity index:             peak spikeCoef*vel → floor idxFloor*0.35*vel (over barkDecay) → fade.
  // Summed at the carrier they equal the live depth at EVERY velocity AND time: peak note*(idxFloor+spikeCoef*v)
  // = note*idxPeak, floor note*idxFloor*(0.25+0.35v) = depthFloorHz. The OLD split let the spike collapse to ~0
  // by the attack's end (it decayed to the FLOOR's value 0.001, not the real floor), so the metallic "bark" was
  // ~0.6x too dull on hard hits — the EP's whole velocity-brightness magic. Now the spike decays to the floor.
  let idxFloorQ = idxFloor * 0.25
  // The velocity-scaled FM terms (the ms path) must use the LIVE's v=vel/127 scale, but the patch `vel` token is
  // vel/100 — so multiply the velocity coefficients by VOL_COMP (=100/127). Without it the bark ran ~1.27x hot on
  // soft hits (vel/100 > vel/127). The mf path is velocity-INDEPENDENT (note*idxFloor), so it needs no VOL_COMP.
  let spikeC = spikeCoef * VOL_COMP
  let idxFloorVc = idxFloor * 0.35 * VOL_COMP
  let lines = [
    "osc mf sine note",
    "gain mfd 1",
    "osc ms sine note",
    "gain msd 0",
    "osc c1 sine note",
    "gain c1g 0.85",
    "gain a1 0",
    "conn mf mfd 1",
    "conn mfd c1.freq 1",
    "conn ms msd 1",
    "conn msd c1.freq 1",
    "conn c1 c1g 1",
    "conn c1g a1 1",
    "env mfd.gain set 0 note*" + f(idxFloor) + " exp " + f(barkDecay) + " note*" + f(idxFloorQ) + " exp " + f(bodyDecay) + " 0.5",
    "env msd.gain set 0 note*vel*" + f(spikeC) + " exp " + f(barkDecay) + " note*vel*" + f(idxFloorVc) + " exp " + f(bodyDecay) + " 0.0001"
  ]
  // Tine PING: the inharmonic high-partial strike "tink", fast-decaying over the body. `tine` scales it. The
  // live ping is VELOCITY-scaled (and rides the amp env) → ~v²: soft hits read mellow/woody, hard hits bright.
  // Carry that velocity via `vel*K` in the env peak (K=(0.05+tine*0.16)/VOL_COMP so v=1 matches the live level);
  // the env's `vel` × the out conn's `v` gives ~v². Constant peak made the tink ~2.7×/5.4× too loud at v=.5/.3.
  let pingMul = 6.0 + tine * 8.0
  let pingK = (0.05 + tine * 0.16) / VOL_COMP
  let pingDecay = 0.04 + tine * 0.18
  lines.push("osc p1 sine note ratio " + f(pingMul))
  lines.push("filter php highpass q 1 freq 1500")
  lines.push("gain pg 0")
  lines.push("conn p1 php 1")
  lines.push("conn php pg 1")
  lines.push("conn pg a1 1")
  lines.push("env pg.gain set 0 0 lin 0.002 vel*" + f(pingK) + " exp " + f(pingDecay) + " 0.0008")
  lines.push("env a1.gain set 0 0 lin 0.004 1 exp 0.09 0.72 exp " + f(bodyDecay) + " 0.001")
  // ---- Suitcase STEREO TREMOLO: two anti-phase LFO-gated paths panned hard L/R (the iconic Rhodes wobble). The
  // two paths sum to ~2× the mono level — which ALSO restores the loudness the old single-path patch lost. With
  // drive, the source first runs through a SOFT (tube) shaper + make-up pad (matches the live tineDriveCurve).
  let tremRate = 4.6 + tremolo * 1.6
  let depth = tremolo * 0.42
  let baseG = 1 - depth
  let src = "a1"
  if (drive > 0.001) {
    // Feed the shaper at ~the live amp level (v*0.5 ≈ 0.5), NOT the normalized a1 peak (1.0): a waveshaper is
    // non-linear, so a 2× hot input over-saturates (dull + low makeup gain). The 0.5 in-gain + a 2.0 make-up
    // out-gain (after the curve's velocity-appropriate boost) restores the live brightness + level.
    lines.push("shaper sh1 amount " + f(drive * 60) + " curve soft")
    lines.push("gain pad " + f(2.0 / (1 + drive * 0.6)))
    lines.push("conn a1 sh1 0.5")
    lines.push("conn sh1 pad 1")
    src = "pad"
  }
  lines.push("osc tlfo sine " + f(tremRate))
  lines.push("gain tgL " + f(baseG))
  lines.push("gain tgR " + f(baseG))
  lines.push("pan pL -0.6")
  lines.push("pan pR 0.6")
  lines.push("conn " + src + " tgL 1")
  lines.push("conn " + src + " tgR 1")
  lines.push("conn tlfo tgL.gain " + f(depth))
  lines.push("conn tlfo tgR.gain " + f(0 - depth))
  lines.push("conn tgL pL 1")
  lines.push("conn tgR pR 1")
  lines.push("conn pL out " + f(VOL_COMP * 0.65))
  lines.push("conn pR out " + f(VOL_COMP * 0.65))
  return lines
}

// Aether → a single sine with the theremin PORTAMENTO: the freq envelope swoops up into pitch from a few
// semitones below (`glide`), through a tone-tilted lowpass, with a transient-free `swell` attack.
fn aetherLines(p) {
  let glide = p.glide >= 0 && p.glide <= 1 ? p.glide : 0.4
  let waver = p.waver >= 0 && p.waver <= 1 ? p.waver : 0.5
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.3
  let swell = p.swell >= 0 && p.swell <= 1 ? p.swell : 0.45
  let startFactor = Math.pow(2, (0 - (1.5 + glide * 4)) / 12)
  let glideTime = 0.02 + glide * 0.5
  let cutoff = Math.round(700 + tone * 8000)
  if (cutoff > 13000) {
    cutoff = 13000
  }
  // A theremin SUSTAINS while the note is held (the volume hand), then releases — `set dur 1 … exp dur+release`
  // holds at full until note-off then fades. Two sines a few cents apart give the heterodyne beat. The
  // theremin's CALLING CARD is the WAVER: a ~5.5 Hz vibrato LFO on the oscillators' detune + a matching
  // tremolo on the amp — WITHOUT it the patch was two dead static sines (the user heard it "completely
  // change"). The grammar does LFO modulation via `conn <osc> <node>.<param> <depth>`. Constant depth (the
  // live bloom-in needs a per-note-clamped envelope the static patch can't express monotonically). Reserve the
  // tremolo's headroom in the out level the way the live engine does (peak·(1+trem)=v·0.52). A faint 3rd
  // harmonic adds the throaty color; a band of breath noise the organic warmth.
  let attack = 0.05 + (1 - swell) * 0.4
  let release = 0.12 + (1 - swell) * 0.22
  // The live theremin clamps the hold to `max(durSec, attack+0.04)` so a sub-attack staccato note still COMPLETES
  // its swell instead of cutting off mid-rise (a truncated rise reads as a percussive pop). Express that exactly
  // in the patch via the `max()` grammar — `set max(dur,hold) 1 exp max(dur,hold)+release`.
  let hold = attack + 0.04
  let beat = 3 + waver * 10
  let air = p.air >= 0 && p.air <= 1 ? p.air : 0.25
  let vibHz = 5 + waver * 1.4
  let vibDepth = 5 + waver * 65
  let tremFactor = 0.05 + waver * 0.32
  let outLevel = (VOL_COMP * 0.52) / (1 + tremFactor)
  // The waver BLOOMS IN (a player settling into the note) and BREATHES (a slow irregularity LFO re-modulates
  // its depth) — pinning the detune at a constant depth from t=0 made the patch shake during the glide instead
  // of swooping clean then wavering. Route the vibrato LFO through a named depth-gain `vg`: env on vg.gain does
  // the bloom (vibDepth*0.12 → vibDepth over attack+0.12), and a slow `irreg` LFO summed into vg.gain breathes
  // it. vib also feeds the tremolo on a1.gain directly (constant — the amp ramp masks its bloom).
  let lines = [
    "osc o1 sine note detune " + f(0 - beat),
    "osc o2 sine note detune " + f(beat),
    "osc vib sine " + f(vibHz) + " rand 0.6",
    "osc irreg sine 0.45 rand 0.4",
    "filter f1 lowpass q 0.4 freq " + f(cutoff),
    "gain a1 0",
    "gain vg " + f(vibDepth * 0.12),
    "conn o1 f1 0.5",
    "conn o2 f1 0.5",
    "conn f1 a1 1",
    "conn a1 out " + f(outLevel),
    "conn vib vg 1",
    "conn irreg vg.gain " + f(waver * 9),
    "conn vg o1.detune 1",
    "conn vg o2.detune 1",
    "conn vib a1.gain " + f(tremFactor),
    "env vg.gain set 0 " + f(vibDepth * 0.12) + " lin " + f(attack + 0.12) + " " + f(vibDepth),
    "env o1.freq set 0 note*" + f(startFactor) + " exp " + f(glideTime) + " note",
    "env o2.freq set 0 note*" + f(startFactor) + " exp " + f(glideTime) + " note",
    "env a1.gain set 0 0 lin " + f(attack) + " 1 set max(dur," + f(hold) + ") 1 exp max(dur," + f(hold) + ")+" + f(release) + " 0.0008"
  ]
  // `tone` folds in ODD HARMONICS (3rd/5th/7th) for the throaty, reedy color — mirrors the live partial bank
  // [[3,0.6],[5,0.45],[7,0.28]], each ×0.5 for the coreGain the fundamentals pass through. They glide + waver
  // with the fundamental (vg → detune) so they fuse into one voice and the cutoff sweep above makes Tone bite.
  if (tone > 0.01) {
    let parts = [[3, 0.6], [5, 0.45], [7, 0.28]]
    let api = 0
    while (api < parts.length) {
      let mul = parts[api][0]
      let pa = parts[api][1]
      let oid = "oh" + String(mul)
      lines.push("osc " + oid + " sine note ratio " + f(mul))
      lines.push("conn " + oid + " f1 " + f(tone * pa * 0.5))
      lines.push("conn vg " + oid + ".detune 1")
      lines.push("env " + oid + ".freq set 0 note*" + f(startFactor * mul) + " exp " + f(glideTime) + " note*" + f(mul))
      api = api + 1
    }
  }
  if (air > 0.01) {
    lines.push("noise nz")
    lines.push("filter nbp bandpass q 0.45 freq 1200")
    lines.push("gain ng 0")
    lines.push("conn nz nbp 1")
    lines.push("conn nbp ng 1")
    // Route the breath INTO a1 (mirror the live ng.connect(amp)) so it ducks with the swell. Air is now a bold,
    // obviously-breathy layer (live nlevel = air*0.8, broadened band Q 0.45). The live breath is velocity-SQUARED
    // (nlevel has v AND it rides the amp env's v); the out conn supplies one v, so carry the other via `vel*`
    // (×VOL_COMP converts the patch vel/100 → the live vel/127), exactly like the aahs breath.
    lines.push("conn ng a1 1")
    lines.push("env nbp.freq set 0 note*2")
    lines.push("env ng.gain set 0 0 lin " + f(attack) + " vel*" + f(air * 0.8 * VOL_COMP) + " set max(dur," + f(hold) + ") vel*" + f(air * 0.8 * VOL_COMP) + " exp max(dur," + f(hold) + ")+" + f(release) + " 0.0008")
  }
  return lines
}

// Halo → the handpan partial triad: fundamental + octave (2×) + compound fifth (3×), `temper` detunes the
// upper partials via fractional ratios so they shimmer, `ring` sets the long decay. Upper partials sit lower.
fn haloLines(p) {
  let temper = p.temper >= 0 && p.temper <= 1 ? p.temper : 0.4
  let ring = p.ring >= 0 && p.ring <= 1 ? p.ring : 0.55
  let bloom = p.bloom >= 0 && p.bloom <= 1 ? p.bloom : 0.5
  let lows = p.lows >= 0 && p.lows <= 1 ? p.lows : 0.45
  // A handpan's soul is the inharmonic BEATING TRIAD: fundamental + octave + compound fifth, each a PAIR of
  // sines detuned ±cents so they throb (a single sine per partial sits dead). Upper partials BLOOM up then
  // decay sooner (energy moves down). `temper` spreads the beat; `ring` the tail; `lows` the warm body sub.
  let fundDecay = 1.2 + ring * 7.8
  let octDecay = fundDecay * 0.62
  let fifthDecay = fundDecay * 0.42
  let beatCents = 1.5 + temper * 8
  let octDrift = temper * 6
  let fifthDrift = 0 - temper * 7
  let octStart = 0.3 * (0.35 + (1 - bloom) * 0.4)
  let octPeak = 0.3 * (1.0 + bloom * 0.5)
  let octBloomT = 0.04 + bloom * 0.28
  let fiStart = 0.2 * (0.25 + (1 - bloom) * 0.45)
  let fiPeak = 0.2 * (1.0 + bloom * 0.6)
  let fiBloomT = 0.06 + bloom * 0.34
  let lines = [
    "osc f1a sine note detune " + f(0 - beatCents),
    "osc f1b sine note detune " + f(beatCents),
    "osc o2a sine note ratio 2 detune " + f(0 - (beatCents + octDrift)),
    "osc o2b sine note ratio 2 detune " + f(beatCents + octDrift),
    "osc o3a sine note ratio 3 detune " + f(0 - (beatCents + fifthDrift)),
    "osc o3b sine note ratio 3 detune " + f(beatCents + fifthDrift),
    "filter hp highpass q 0.5 freq 110",
    "gain gF 0",
    "gain gO 0",
    "gain gFi 0",
    "conn f1a gF 0.5",
    "conn f1b gF 0.5",
    "conn o2a gO 0.5",
    "conn o2b gO 0.5",
    "conn o3a gFi 0.5",
    "conn o3b gFi 0.5",
    "conn gF hp 1",
    "conn gO hp 1",
    "conn gFi hp 1",
    "conn hp out " + f(VOL_COMP * 0.745),
    "env gF.gain set 0 0 lin 0.006 0.5 exp " + f(fundDecay) + " 0.0008",
    "env gO.gain set 0 0 lin 0.006 " + f(octStart) + " lin " + f(octBloomT) + " " + f(octPeak) + " exp " + f(octDecay) + " 0.0008",
    "env gFi.gain set 0 0 lin 0.006 " + f(fiStart) + " lin " + f(fiBloomT) + " " + f(fiPeak) + " exp " + f(fifthDecay) + " 0.0008"
  ]
  if (lows > 0.02) {
    lines.push("osc ob sine note ratio 0.5")
    lines.push("filter bl lowpass q 0.6 freq " + f(220 + lows * 180))
    lines.push("gain gb 0")
    lines.push("conn ob bl 1")
    lines.push("conn bl gb 1")
    lines.push("conn gb out " + f(VOL_COMP * 1.49))
    lines.push("env gb.gain set 0 0 lin 0.006 " + f(lows * 0.34) + " exp " + f(0.4 + ring * 1.6) + " 0.0008")
  }
  return lines
}

// Aahs → a formant choir: a UNISON of detuned saws (2..7 singers, width/count from `ensemble`) → a brightness
// lowpass → THREE parallel PEAKING formants (F1/F2/F3, the vowel's identity) → a soft-legato amp. The grammar
// DOES express the per-formant dB boost via `env <filter>.gain` on a `peaking` biquad — so we use real peaking
// formants (full body + boosted bands), NOT bandpasses (which kept only the bands → thin & wrong). A ~5 Hz
// vibrato LFO on every singer's detune (the choir wobble) + a band of vowel-shaped breath noise complete it —
// without these it sounded "completely different". Matches the live Aahs voice (vowel profile + structure).
fn aahsLines(p) {
  let vowel = p.vowel ? p.vowel : "aah"
  let ensemble = p.ensemble >= 0 && p.ensemble <= 1 ? p.ensemble : 0.5
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let vibrato = p.vibrato >= 0 && p.vibrato <= 1 ? p.vibrato : 0.4
  let breath = p.breath >= 0 && p.breath <= 1 ? p.breath : 0.3
  // Full vowel formant triple (F1/F2/F3) + peak gains (dB) — mirrors Aahs.aahsVowelProfile exactly.
  let f1 = 730
  let f2 = 1200
  let f3 = 2800
  let g1 = 10
  let g2 = 9
  let g3 = 6
  let hpf = 0.5
  if (vowel === "eeh") { f1 = 290; f2 = 2300; f3 = 3000; g1 = 9; g2 = 11; g3 = 8; hpf = 0.62 }
  else if (vowel === "ooh") { f1 = 320; f2 = 800; f3 = 2600; g1 = 10; g2 = 7; g3 = 4; hpf = 0.32 }
  else if (vowel === "ohh") { f1 = 480; f2 = 900; f3 = 2700; g1 = 10; g2 = 8; g3 = 5; hpf = 0.40 }
  else if (vowel === "mmm") { f1 = 250; f2 = 700; f3 = 2400; g1 = 11; g2 = 6; g3 = 3; hpf = 0.28 }
  let tilt = 0.82 + tone * 0.36
  let ff1 = Math.round(f1 * tilt)
  let ff2 = Math.round(f2 * tilt)
  let ff3 = Math.round(f3 * tilt)
  let voices = 2 + Math.floor(ensemble * 5 + 0.5)
  if (voices > 7) { voices = 7 }
  if (voices < 2) { voices = 2 }
  let spread = 6 + ensemble * 22
  let cutoff = Math.round((1400 + tone * 5200) * (0.32 + hpf * 1.5))
  if (cutoff > 15000) { cutoff = 15000 }
  let attack = 0.14 + (1 - tone) * 0.12
  let release = 0.34 + (1 - tone) * 0.22
  // Live Aahs clamps hold to max(durSec, attack+0.06) so a sub-attack note completes its legato swell instead of
  // cutting mid-rise (the truncated rise is the pop/percussive blip). Express it exactly via the max() grammar.
  let hold = attack + 0.06
  let vibHz = 4.7 + vibrato * 1.4
  let vibDepth = vibrato * 42
  let lines = []
  let k = 0
  while (k < voices) {
    let frac = voices > 1 ? k / (voices - 1) : 0.5
    let det = (frac - 0.5) * spread
    // rand 2.5 = the live per-singer detune jitter ((random*2-1)*2.5 cents) — de-correlates the unison so the
    // choir reads as separate singers (a lush width), not one phasey saw stack.
    lines.push("osc o" + String(k) + " sawtooth note detune " + f(det) + " rand 2.5")
    k = k + 1
  }
  lines.push("osc vib sine " + f(vibHz))
  lines.push("filter lp lowpass q 0.6 freq " + f(cutoff))
  lines.push("filter bp1 peaking q 7.5 freq " + f(ff1))
  lines.push("filter bp2 peaking q 9.5 freq " + f(ff2))
  lines.push("filter bp3 peaking q 5 freq " + f(ff3))
  lines.push("gain a1 0")
  // The choir vibrato BLOOMS IN after the soft legato attack (and fades on release) — it doesn't wobble at full
  // depth from the click-free onset. Route the LFO through an enveloped depth-gain `gvib` (depth stays in the
  // per-voice conn weight); gvib.gain does the 0.12→1→0 swell so every singer's vibrato swells together.
  lines.push("gain gvib 0")
  lines.push("conn vib gvib 1")
  let j = 0
  while (j < voices) {
    lines.push("conn o" + String(j) + " lp 1")
    lines.push("conn gvib o" + String(j) + ".detune " + f(vibDepth))
    j = j + 1
  }
  // The vibrato swell peaks at min(attack+0.28, hold) (the live clamps vibPeakT ≤ hold on short notes) then holds
  // until note-off and releases — nested min/max keeps it monotonic for any note length.
  lines.push("env gvib.gain set 0 0.12 lin min(" + f(attack + 0.28) + ",max(dur," + f(hold) + ")) 1 set max(dur," + f(hold) + ") 1 exp max(dur," + f(hold) + ")+" + f(release) + " 0.0008")
  lines.push("conn lp bp1 1")
  lines.push("conn lp bp2 1")
  lines.push("conn lp bp3 1")
  lines.push("conn bp1 a1 0.5")
  lines.push("conn bp2 a1 0.5")
  lines.push("conn bp3 a1 0.5")
  // Amp env 0..1; the per-voice + mix level (live amp level v*0.5/voices, mix 0.5) folds into the out weight.
  lines.push("conn a1 out " + f((VOL_COMP * 0.5) / voices))
  lines.push("env bp1.gain set 0 " + f(g1))
  lines.push("env bp2.gain set 0 " + f(g2))
  lines.push("env bp3.gain set 0 " + f(g3))
  lines.push("env a1.gain set 0 0 lin " + f(attack) + " 1 set max(dur," + f(hold) + ") 1 exp max(dur," + f(hold) + ")+" + f(release) + " 0.0008")
  if (breath > 0.01) {
    lines.push("noise nz")
    lines.push("filter nbp bandpass q 0.7 freq " + f(Math.round((ff2 + ff3) * 0.5)))
    lines.push("filter nf1 peaking q 3 freq " + f(ff1))
    lines.push("gain ng 0")
    lines.push("conn nz nbp 1")
    lines.push("conn nbp nf1 1")
    lines.push("conn nf1 ng 1")
    // Route the breath INTO a1 (mirror the live ng.connect(amp)) so it inherits the amp env + the 0.5/voices
    // out attenuation — NOT straight to `out` (which bypassed it and made the breath ~8-11× too loud → hiss).
    // Carry the breath level in this env (peak breath*0.5, sustain 0.7× like the live bsus) — bold + obviously
    // airy now, matching the live nlevel = breath*0.5*v.
    lines.push("conn ng a1 1")
    lines.push("env nf1.gain set 0 8")
    // Breath scales as v² in the live voice (ng peak = breath*0.5*v AND the band re-passes through amp.gain
    // = v*0.5/voices). The out conn applies only ONE v, so carry the OTHER velocity factor here via the `vel`
    // token (×VOL_COMP converts the patch's vel/100 → the live vel/127). Without it the breath was ~4× too
    // loud/hissy at vel32, 2× at vel64 — the worst remaining aahs artifact.
    lines.push("env ng.gain set 0 0 lin " + f(attack) + " vel*" + f(breath * 0.5 * VOL_COMP) + " set max(dur," + f(hold) + ") vel*" + f(breath * 0.5 * 0.7 * VOL_COMP) + " exp max(dur," + f(hold) + ")+" + f(release) + " 0.0008")
  }
  return lines
}

fn syncLeadLines(p) {
  let wave = p.waveform ? p.waveform : "sawtooth"
  let hf = p.hfFilter > 0 ? p.hfFilter : 0.8
  let syncAmt = p.syncAmount >= 0 && p.syncAmount <= 1 ? p.syncAmount : 0.5
  let sweepRate = p.sweepRate >= 0 && p.sweepRate <= 1 ? p.sweepRate : 0.4
  let a = p.attack > 0 ? p.attack : 0.05
  let d = p.decay > 0 ? p.decay : 0.2
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.5
  let r = p.release > 0 ? p.release : 0.2
  let filterCutoff = Math.round(500 + hf * 5000)
  let sweepEnvRate = 0.05 + (1 - sweepRate) * 0.4
  let lines = [
    "syncosc s1",
    "filter f1 lowpass q 1 freq " + f(filterCutoff),
    "gain a1 0",
    "conn s1 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.8),
    "env s1.masterFreq set 0 note",
    "env s1.slaveFreq set 0 note*" + f(1 + syncAmt * 4) + " exp " + f(sweepEnvRate) + " note*" + f(1 + syncAmt),
    adsrAmpEnv("a1", a, d, s, r)
  ]
  return lines
}

fn syncChoirLines(p) {
  let morphRate = p.morphRate >= 0 && p.morphRate <= 1 ? p.morphRate : 0.5
  let morphAmt = p.morphAmt >= 0 && p.morphAmt <= 1 ? p.morphAmt : 0.6
  let width = p.width >= 0 && p.width <= 1 ? p.width : 0.6
  let vibRate = p.vibRate >= 0 && p.vibRate <= 1 ? p.vibRate : 0.5
  let vibAmt = p.vibAmt >= 0 && p.vibAmt <= 1 ? p.vibAmt : 0.4
  let hp = p.highpass > 0 ? p.highpass : 300
  let a = p.attack > 0 ? p.attack : 0.4
  let r = p.release > 0 ? p.release : 0.6
  let shift = p.shift != null ? p.shift : 12
  let shiftRatio = Math.pow(2, shift / 12)
  let detuneCents = width * 30
  let lfoRate = 0.2 + morphRate * 4
  let lfoDepth = morphAmt * 2.5
  let vHz = 3 + vibRate * 5
  let vDepth = vibAmt * 30
  let lines = [
    "syncosc s1 detune " + f(0 - detuneCents),
    "syncosc s2 detune " + f(detuneCents),
    "osc lfo sine " + f(lfoRate),
    "gain glfo 1",
    "osc vib sine " + f(vHz),
    "gain gvib 1",
    "filter f1 highpass q 0.7 freq " + f(hp),
    "gain a1 0",
    "pan p1 -0.5",
    "pan p2 0.5",
    "conn s1 f1 1",
    "conn s2 f1 1",
    "conn f1 a1 1",
    "conn a1 p1 1",
    "conn a1 p2 1",
    "conn p1 out " + f(VOL_COMP * 0.5),
    "conn p2 out " + f(VOL_COMP * 0.5),
    "env s1.masterFreq set 0 note",
    "env s2.masterFreq set 0 note",
    "env s1.slaveFreq set 0 note*" + f(shiftRatio),
    "env s2.slaveFreq set 0 note*" + f(shiftRatio),
    "conn vib gvib " + f(vDepth),
    "conn gvib s1.masterFreq 1",
    "conn gvib s2.masterFreq 1",
    "conn lfo glfo " + f(lfoDepth),
    "conn glfo s1.slaveFreq 1",
    "conn glfo s2.slaveFreq 1",
    "env glfo.gain set 0 0 lin " + f(a) + " " + f(lfoDepth) + " lin dur " + f(lfoDepth) + " lin dur+" + f(r) + " 0",
    "env a1.gain set 0 0 lin " + f(a) + " 1 lin dur 1 lin dur+" + f(r) + " 0"
  ]
  return lines
}

fn obSyncLines(p) {
  let detune = p.detune != null ? p.detune : 15 // cents
  let sweepRate = p.sweepRate != null ? p.sweepRate : 0.5
  let sweepAmt = p.sweepAmt != null ? p.sweepAmt : 24
  let cutoff = p.cutoff != null ? p.cutoff : 1200
  let res = p.resonance != null ? p.resonance : 2
  let filterEnv = p.filterEnv != null ? p.filterEnv : 2400
  let filterDecay = p.filterDecay != null ? p.filterDecay : 0.8
  let a = p.attack != null ? p.attack : 0.1
  let d = p.decay != null ? p.decay : 0.4
  let s = p.sustain != null ? p.sustain : 0.6
  let r = p.release != null ? p.release : 0.5

  let sweepDecay = 0.05 + (1 - sweepRate) * 1.5
  let cutoffPeak = cutoff + filterEnv

  let lines = [
    "syncosc sL detune " + f(0 - detune),
    "syncosc sR detune " + f(detune),
    "filter fL lowpass q " + f(res) + " freq " + f(cutoff),
    "filter fR lowpass q " + f(res) + " freq " + f(cutoff),
    "pan pL -0.6",
    "pan pR 0.6",
    "gain a1 0",
    "conn sL fL 1",
    "conn sR fR 1",
    "conn fL pL 1",
    "conn fR pR 1",
    "conn pL a1 1",
    "conn pR a1 1",
    "conn a1 out " + f(VOL_COMP * 0.6),
    "env sL.masterFreq set 0 note",
    "env sR.masterFreq set 0 note",
    "env sL.slaveFreq set 0 note*" + f(Math.pow(2, sweepAmt/12)) + " exp " + f(sweepDecay) + " note",
    "env sR.slaveFreq set 0 note*" + f(Math.pow(2, sweepAmt/12)) + " exp " + f(sweepDecay) + " note",
    "env fL.freq set 0 " + f(cutoffPeak) + " exp " + f(filterDecay) + " " + f(cutoff),
    "env fR.freq set 0 " + f(cutoffPeak) + " exp " + f(filterDecay) + " " + f(cutoff),
    adsrAmpEnv("a1", a, d, s, r)
  ]
  return lines
}

fn laserSyncLines(p) {
  let dropRate = p.dropRate != null ? p.dropRate : 0.8
  let dropAmt = p.dropAmt != null ? p.dropAmt : 36
  let slaveBase = p.slaveBase != null ? p.slaveBase : 18
  let a = p.attack != null ? p.attack : 0.01
  let d = p.decay != null ? p.decay : 0.3

  let dropDecay = 0.01 + (1 - dropRate) * 0.5
  let slaveRatio = Math.pow(2, slaveBase/12)
  let dropRatio = Math.pow(2, dropAmt/12)

  let lines = [
    "syncosc s1",
    "gain a1 0",
    "conn s1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.8),
    "env s1.masterFreq set 0 note*" + f(dropRatio) + " exp " + f(dropDecay) + " note",
    "env s1.slaveFreq set 0 note*" + f(slaveRatio),
    "env a1.gain set 0 0 lin " + f(a) + " 1 exp " + f(d) + " 0.0001 lin dur 0.0001 lin dur+0.1 0"
  ]
  return lines
}

/// True when this generator can be reduced to an equivalent patch graph (sound-preserving switch).
export fn canCompileToPatch(generatorId) {
  return (
    generatorId === "basicOsc" ||
    generatorId === "fmTone" ||
    generatorId === "noiseBurst" ||
    generatorId === "pad" ||
    generatorId === "bell" ||
    generatorId === "drumSynth" ||
    generatorId === "matrixFm" ||
    generatorId === "guitar" ||
    generatorId === "clap" ||
    generatorId === "arco" ||
    generatorId === "tine" ||
    generatorId === "aether" ||
    generatorId === "halo" ||
    generatorId === "aahs" ||
    generatorId === "syncLead" ||
    generatorId === "syncChoir" ||
    generatorId === "obSync" ||
    generatorId === "laserSync"
  )
}

/// Compile the current generator + params (+ spec, for graph voices) into patch gen_block lines,
/// or null if not compilable.
export fn compileGeneratorToPatchLines(generatorId, params, spec) {
  let p = params ? params : {}
  if (generatorId === "basicOsc") {
    return basicOscLines(p)
  }
  if (generatorId === "fmTone") {
    return fmToneLines(p)
  }
  if (generatorId === "noiseBurst") {
    return noiseBurstLines(p)
  }
  if (generatorId === "pad") {
    return padLines(p)
  }
  if (generatorId === "bell") {
    return bellLines(p)
  }
  if (generatorId === "drumSynth") {
    return drumSynthLines(p)
  }
  if (generatorId === "guitar") {
    return guitarLines(p)
  }
  if (generatorId === "clap") {
    return clapLines(p)
  }
  if (generatorId === "arco") {
    return arcoLines(p)
  }
  if (generatorId === "tine") {
    return tineLines(p)
  }
  if (generatorId === "aether") {
    return aetherLines(p)
  }
  if (generatorId === "halo") {
    return haloLines(p)
  }
  if (generatorId === "aahs") {
    return aahsLines(p)
  }
  if (generatorId === "syncLead") {
    return syncLeadLines(p)
  }
  if (generatorId === "syncChoir") {
    return syncChoirLines(p)
  }
  if (generatorId === "obSync") {
    return obSyncLines(p)
  }
  if (generatorId === "laserSync") {
    return laserSyncLines(p)
  }
  if (generatorId === "matrixFm") {
    return spec && spec.graph ? matrixFmLines(spec.graph) : null
  }
  return null
}
