// Compile a fixed generator into the EQUIVALENT patch graph, so "switch to Patch" is a lossless
// reduction (the sound is preserved) rather than a reset to a default. This is what makes `patch` the
// universal substrate: every voice can be expressed as osc/noise/filter/shaper/gain + breakpoint
// envelopes. The macros already prove it; this extends the same idea to the built-in generators.
//
// Loudness match: the fixed engines scale velocity by vel/127, but playPatch uses vel/100 and applies
// the output `conn` vol × that. So a compiled output `conn ... <100/127>` reproduces the same level.
// FM depth + drum pitch-drop are note-relative, expressed with the `note*<k>` resolver tokens.

import { formatTplFloat } from '../tpl/Format.tish'
import { normalizeBasicOscWaveform } from '../generators/Registry.tish'
import { sortedStringKeys } from '../tpl/MatrixFmGraph.tish'

let VOL_COMP = 100 / 127

fn f(x) {
  return formatTplFloat(x)
}

/// Amp ADSR as normalized breakpoints (peak 1): 0 → 1 (attack) → sustain (decay) → hold to note-off → 0.
fn adsrAmpEnv(node, a, d, s, r) {
  let aPlusD = a + d
  return (
    "env " +
    node +
    ".gain set 0 0 lin " +
    f(a) +
    " 1 lin " +
    f(aPlusD) +
    " " +
    f(s) +
    " set dur " +
    f(s) +
    " lin dur+" +
    f(r) +
    " 0"
  )
}

fn basicOscLines(p) {
  let wave = normalizeBasicOscWaveform(p.waveform)
  let a = p.attack > 0 ? p.attack : 0.005
  let d = p.decay > 0 ? p.decay : 0.08
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.4
  let r = p.release > 0 ? p.release : 0.12
  return [
    "osc o1 " + wave + " note",
    "gain a1 0",
    "conn o1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    adsrAmpEnv("a1", a, d, s, r)
  ]
}

fn fmToneLines(p) {
  let ratio = p.ratio > 0 && p.ratio < 64 ? p.ratio : 2
  let modIndex = p.modIndex >= 0 && p.modIndex <= 48 ? p.modIndex : 4
  let carW = normalizeBasicOscWaveform(p.carrierWave ? p.carrierWave : "sine")
  let modW = normalizeBasicOscWaveform(p.modWave ? p.modWave : "sine")
  let a = p.attack > 0 ? p.attack : 0.005
  let d = p.decay > 0 ? p.decay : 0.08
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.4
  let r = p.release > 0 ? p.release : 0.12
  return [
    "osc m1 " + modW + " note ratio " + f(ratio),
    "gain md 1",
    "osc c1 " + carW + " note",
    "gain a1 0",
    "conn m1 md 1",
    "conn md c1.freq 1",
    "conn c1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env md.gain set 0 note*" + f(modIndex * 0.12),
    adsrAmpEnv("a1", a, d, s, r)
  ]
}

fn noiseBurstLines(p) {
  let decay = p.decay > 0 ? p.decay : 0.08
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let rise = p.attack > 0 ? p.attack : 0.002
  if (rise > 0.15) {
    rise = 0.15
  }
  // Engine center = (400 + tone*7000)*(1-pitchFollow) + note*pitchFollow. The note term isn't expressible
  // as a DC filter offset in the patch grammar, so we keep the (1-pitchFollow) scaling (the dominant term)
  // and drop the small note-tracking residual.
  let pf = p.pitchFollow >= 0 && p.pitchFollow <= 1 ? p.pitchFollow : 0.2
  let center = Math.round((400 + tone * 7000) * (1 - pf))
  let q = 0.7 + tone * 3
  let hitDur = decay * 3 + 0.02
  return [
    "noise n1",
    "filter f1 bandpass q " + f(q) + " freq " + f(center),
    "gain a1 0",
    "conn n1 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env a1.gain set 0 0 lin " + f(rise) + " 1 exp " + f(hitDur) + " 0.001"
  ]
}

fn padLines(p) {
  let w1 = normalizeBasicOscWaveform(p.wave1 ? p.wave1 : "sine")
  let w2 = normalizeBasicOscWaveform(p.wave2 ? p.wave2 : "triangle")
  let detune = p.detune != null ? p.detune : 9
  let cutoff = p.cutoff != null && p.cutoff > 0 ? p.cutoff : 2200
  let a = p.attack > 0 ? p.attack : 0.08
  let d = p.decay > 0 ? p.decay : 0.25
  let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.6
  let r = p.release > 0 ? p.release : 0.7
  return [
    "osc o1 " + w1 + " note",
    "osc o2 " + w2 + " note detune " + f(detune),
    "osc o3 sine note ratio 0.5 detune " + f(-detune),
    "filter f1 lowpass q 0.7 freq " + f(cutoff),
    "gain a1 0",
    "conn o1 f1 1",
    "conn o2 f1 1",
    "conn o3 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.5),
    adsrAmpEnv("a1", a, d, s, r)
  ]
}

fn bellLines(p) {
  let partial = p.partial > 0 ? p.partial : 2.01
  let hp = p.highpass > 0 ? p.highpass : 800
  let decay = p.decay > 0 ? p.decay : 1.0
  return [
    "osc o1 sine note",
    "osc o2 sine note ratio " + f(partial),
    "filter f1 highpass q 0.7 freq " + f(hp),
    "gain a1 0",
    "conn o1 f1 1",
    "conn o2 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.4),
    "env a1.gain set 0 0 lin 0.006 1 exp " + f(decay) + " 0.0008"
  ]
}

fn drumSynthLines(p) {
  let tone = normalizeBasicOscWaveform(p.tone ? p.tone : "sine")
  let pitchEnv = p.pitchEnv != null ? p.pitchEnv : 36
  let pitchDecay = p.pitchDecay > 0 ? p.pitchDecay : 0.06
  let decay = p.decay > 0 ? p.decay : 0.35
  let noise = p.noise != null ? p.noise : 0
  let noiseDecay = p.noiseDecay > 0 ? p.noiseDecay : 0.12
  let noiseHp = p.noiseHp > 0 ? p.noiseHp : 1500
  let drive = p.drive != null ? p.drive : 0
  let pitchMul = Math.pow(2, pitchEnv / 12)
  let lines = ["osc o1 " + tone + " note", "gain a1 0"]
  if (drive > 0) {
    lines.push("shaper sh1 amount " + f(drive * 120))
    lines.push("conn o1 sh1 1")
    lines.push("conn sh1 a1 1")
  } else {
    lines.push("conn o1 a1 1")
  }
  lines.push("conn a1 out " + f(VOL_COMP))
  lines.push("env o1.freq set 0 note*" + f(pitchMul) + " exp " + f(pitchDecay) + " note")
  lines.push("env a1.gain set 0 1 exp " + f(decay) + " 0.0008")
  if (noise > 0.001) {
    lines.push("noise n1")
    lines.push("filter nf highpass q 0.7 freq " + f(noiseHp))
    lines.push("gain ng 0")
    lines.push("conn n1 nf 1")
    lines.push("conn nf ng 1")
    lines.push("conn ng out " + f(VOL_COMP * noise))
    lines.push("env ng.gain set 0 1 exp " + f(noiseDecay) + " 0.0008")
  }
  return lines
}

fn clampHz(h) {
  if (h < 20) {
    return 20
  }
  if (h > 20000) {
    return 20000
  }
  return h
}

/// Op amplitude env, peaked at vel/127 (resolveExpr `vel` = vel/100, so `vel*0.7874` = vel/127) — matches
/// the Matrix FM engine's per-operator ADSR. The route's output conn supplies the second velocity factor.
fn opVelEnv(node, a, d, s, r) {
  let pk = "vel*" + f(VOL_COMP)
  let su = "vel*" + f(VOL_COMP * s)
  return (
    "env " + node + ".gain set 0 0 lin " + f(a) + " " + pk + " lin " + f(a + d) + " " + su +
    " set dur " + su + " lin dur+" + f(r) + " 0"
  )
}

fn cutoffEnvLine(node, c0, amount, a, d, s, r) {
  let peakF = clampHz(c0 + amount)
  let susF = clampHz(c0 + amount * s)
  let baseF = clampHz(c0)
  return (
    "env " + node + ".freq set 0 " + f(baseF) + " lin " + f(a) + " " + f(peakF) +
    " lin " + f(a + d) + " " + f(susF) + " set dur " + f(susF) + " lin dur+" + f(r) + " " + f(baseF)
  )
}

fn patchFilterType(t) {
  let s = String(t).toLowerCase()
  if (s.indexOf("hp") >= 0) {
    return "highpass"
  }
  return "lowpass"
}

/// Compile the Matrix FM operator/matrix/filter/route graph into an equivalent patch graph.
fn matrixFmLines(graph) {
  if (!graph || !graph.ops) {
    return null
  }
  let ops = graph.ops
  let opKeys = sortedStringKeys(ops)
  if (opKeys.length === 0) {
    return null
  }
  let opEnvs = graph.opEnvs ? graph.opEnvs : {}
  let mods = graph.mods ? graph.mods : []
  let filters = graph.filters ? graph.filters : {}
  let filterEnvs = graph.filterEnvs ? graph.filterEnvs : {}
  let routes = graph.routes ? graph.routes : []
  let lines = []
  let tail = {}

  // 1) operator source nodes (osc note*ratio, or noise)
  let i = 0
  while (i < opKeys.length) {
    let oid = opKeys[i]
    let od = ops[oid]
    let wave = od.wave ? od.wave : "sine"
    let ratio = od.ratio != null && od.ratio > 0 ? od.ratio : 1
    if (wave === "noise") {
      lines.push("noise op" + oid)
    } else {
      lines.push("osc op" + oid + " " + normalizeBasicOscWaveform(wave) + " note ratio " + f(ratio))
    }
    tail[oid] = "op" + oid
    i = i + 1
  }

  // 2) ring modulation: dst tail → rmG, src tail → rmG.gain (scaled). RM retargets the dst's tail.
  let rmIdx = 0
  let mi = 0
  while (mi < mods.length) {
    let md = mods[mi]
    if (md.type === "rm" && md.src !== md.dst && tail[md.dst] && tail[md.src]) {
      let rmId = "rm" + String(rmIdx)
      let amt = md.amount === md.amount ? md.amount : 1
      lines.push("gain " + rmId + " 0")
      lines.push("conn " + tail[md.dst] + " " + rmId + " 1")
      lines.push("conn " + tail[md.src] + " " + rmId + ".gain " + f(amt * 0.4))
      tail[md.dst] = rmId
      rmIdx = rmIdx + 1
    }
    mi = mi + 1
  }

  // 3) per-operator amp envelope gains
  let ei = 0
  while (ei < opKeys.length) {
    let oid = opKeys[ei]
    let e = opEnvs[oid]
    let a = e && e.a != null ? e.a : 0.005
    let d = e && e.d != null ? e.d : 0.1
    let s = e && e.s != null ? e.s : 0.35
    let r = e && e.r != null ? e.r : 0.12
    lines.push("gain eg" + oid + " 0")
    lines.push("conn " + tail[oid] + " eg" + oid + " 1")
    lines.push(opVelEnv("eg" + oid, a, d, s, r))
    ei = ei + 1
  }

  // 4) FM: modulator tail → depth gain (note-relative) → carrier osc frequency
  let fmIdx = 0
  let fi = 0
  while (fi < mods.length) {
    let md = mods[fi]
    if (md.type === "fm" && md.dst && ops[md.dst] && ops[md.dst].wave !== "noise" && tail[md.src]) {
      let ratioD = ops[md.dst].ratio != null && ops[md.dst].ratio > 0 ? ops[md.dst].ratio : 1
      let amt = md.amount === md.amount ? md.amount : 1
      let depthK = ratioD * amt * 0.12
      let fmgId = "fmg" + String(fmIdx)
      lines.push("gain " + fmgId + " 1")
      lines.push("conn " + tail[md.src] + " " + fmgId + " 1")
      lines.push("env " + fmgId + ".gain set 0 note*" + f(depthK))
      lines.push("conn " + fmgId + " op" + md.dst + ".freq 1")
      fmIdx = fmIdx + 1
    }
    fi = fi + 1
  }

  // 5) filters (24dB = two cascaded biquads) + cutoff envelope
  let filterFirst = {}
  let filterLast = {}
  let fkeys = sortedStringKeys(filters)
  let fk = 0
  while (fk < fkeys.length) {
    let fid = fkeys[fk]
    let fd = filters[fid]
    let ptype = patchFilterType(fd.type)
    let c0 = clampHz(fd.cutoff != null ? fd.cutoff : 8000)
    let qv = fd.res != null ? fd.res : 0.7
    let q = qv * 8
    if (q > 40) {
      q = 40
    }
    if (q < 0.0001) {
      q = 0.0001
    }
    let two = String(fd.type).toLowerCase().indexOf("24") >= 0
    let fe = filterEnvs[fid]
    let amt = fe && fe.amount != null ? fe.amount : 0
    let fa = fe && fe.a != null ? fe.a : 0.1
    let fdd = fe && fe.d != null ? fe.d : 0.2
    let fs = fe && fe.s != null ? fe.s : 0.3
    let fr = fe && fe.r != null ? fe.r : 0.15
    if (two) {
      lines.push("filter f" + fid + "a " + ptype + " q " + f(q) + " freq " + f(c0))
      lines.push("filter f" + fid + "b " + ptype + " q " + f(q) + " freq " + f(c0))
      lines.push("conn f" + fid + "a f" + fid + "b 1")
      filterFirst[fid] = "f" + fid + "a"
      filterLast[fid] = "f" + fid + "b"
      if (amt !== 0) {
        lines.push(cutoffEnvLine("f" + fid + "a", c0, amt, fa, fdd, fs, fr))
        lines.push(cutoffEnvLine("f" + fid + "b", c0, amt, fa, fdd, fs, fr))
      }
    } else {
      lines.push("filter f" + fid + " " + ptype + " q " + f(q) + " freq " + f(c0))
      filterFirst[fid] = "f" + fid
      filterLast[fid] = "f" + fid
      if (amt !== 0) {
        lines.push(cutoffEnvLine("f" + fid, c0, amt, fa, fdd, fs, fr))
      }
    }
    fk = fk + 1
  }

  // 6) routes: op/filter → filter/out. Output conn carries the second velocity factor (× 100/127).
  let routed = false
  let ri = 0
  while (ri < routes.length) {
    let rt = routes[ri]
    let vol = rt.volume === rt.volume ? rt.volume : 1
    let srcN = null
    if (rt.srcKind === "op") {
      srcN = "eg" + rt.srcId
    } else {
      if (rt.srcKind === "filter" && filterLast[rt.srcId]) {
        srcN = filterLast[rt.srcId]
      }
    }
    if (srcN) {
      if (rt.dstKind === "filter" && filterFirst[rt.dstId]) {
        lines.push("conn " + srcN + " " + filterFirst[rt.dstId] + " " + f(vol))
        routed = true
      } else {
        if (rt.dstKind === "out") {
          lines.push("conn " + srcN + " out " + f(vol * VOL_COMP))
          routed = true
        }
      }
    }
    ri = ri + 1
  }
  if (!routed) {
    lines.push("conn eg" + opKeys[0] + " out " + f(VOL_COMP))
  }
  return lines
}

// Guitar is a Karplus-Strong physical model — a delay-line feedback that the patch node set CAN'T
// express. This is a plucky subtractive APPROXIMATION (saw → driven lowpass with a fast pluck envelope),
// so switching guitar→patch lands on something guitar-ish rather than a generic sustained saw.
fn guitarLines(p) {
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let decayP = p.decay >= 0 && p.decay <= 1 ? p.decay : 0.6
  let drive = p.drive != null ? p.drive : 0.25
  let mute = p.mute >= 0 && p.mute <= 1 ? p.mute : 0
  let body = p.body != null && p.body > 0 ? p.body : 3500
  let bodyHz = body * (1 - mute * 0.5)
  // `tone` shapes the live string EXCITATION (not the body filter); fold it into a mild cutoff lift so it
  // still does something. The live body filter is a gentle Q 0.9 rolloff at a CONSTANT cutoff — no sweep.
  let cut = bodyHz * (0.8 + tone * 0.6)
  if (cut > 16000) {
    cut = 16000
  }
  // The live Karplus-Strong string rings ~ringSec as a continuous decay; match that length, and the live
  // amp peaks at v*0.7 (so the output conn is VOL_COMP * 0.7, not full VOL_COMP — it was ~1.43x too loud).
  let ampDecay = (0.4 + decayP * 2.1) * (1 - mute * 0.8)
  if (ampDecay < 0.12) {
    ampDecay = 0.12
  }
  let lines = ["osc o1 sawtooth note", "filter f1 lowpass q 0.9 freq " + f(cut), "gain a1 0"]
  if (drive > 0) {
    lines.push("shaper sh1 amount " + f(drive * 120))
    lines.push("conn o1 sh1 1")
    lines.push("conn sh1 f1 1")
  } else {
    lines.push("conn o1 f1 1")
  }
  lines.push("conn f1 a1 1")
  lines.push("conn a1 out " + f(VOL_COMP * 0.7))
  lines.push("env a1.gain set 0 0 lin 0.004 1 exp " + f(ampDecay) + " 0.001")
  return lines
}

// Clap reduces (one voice can't do the multi-burst cluster) to a single bandpassed noise snap + tail —
// a plausible single clap. The cluster/hands behaviour only exists in the live generator.
fn clapLines(p) {
  let size = p.size >= 0 && p.size <= 1 ? p.size : 0.5
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  let tail = p.tail >= 0 && p.tail <= 1 ? p.tail : 0.4
  let center = Math.round(900 + size * 1400)
  let q = 1.4 + tone * 4.5
  let hp = Math.round(500 + tone * 900)
  let decay = 0.02 + tail * 0.34
  return [
    "noise n1",
    "filter f1 bandpass q " + f(q) + " freq " + f(center),
    "filter f2 highpass q 0.7 freq " + f(hp),
    "gain a1 0",
    "conn n1 f1 1",
    "conn f1 f2 1",
    "conn f2 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env a1.gain set 0 0 lin 0.0006 1 exp " + f(decay) + " 0.001"
  ]
}

// Arco — a bowed string: TWO slightly-detuned saws (the bowed shimmer) → a brightness lowpass (opened by
// pressure) → an amp that SUSTAINS while the bow holds the note then releases (it is NOT a fixed 2s decay —
// that made it drone). Per-family detune/brightness keeps violin/viola/cello/bass/fiddle distinct. The body
// formants + rosin noise + vibrato LFO live only in the real generator (the grammar can't boost formants).
fn arcoLines(p) {
  let pressure = p.pressure >= 0 && p.pressure <= 1 ? p.pressure : 0.5
  let bow = p.bow >= 0 && p.bow <= 1 ? p.bow : 0.4
  let body = p.body >= 0 && p.body <= 1 ? p.body : 0.6
  let voice = p.voice ? p.voice : "violin"
  let bright = voice === "viola" ? 0.85 : (voice === "cello" ? 0.72 : (voice === "bass" ? 0.6 : (voice === "fiddle" ? 1.22 : 1.0)))
  let det = voice === "cello" ? 6 : (voice === "bass" ? 7 : (voice === "fiddle" ? 9 : 5))
  let cutoff = Math.round((700 + pressure * 5200) * bright)
  if (cutoff > 16000) {
    cutoff = 16000
  }
  let attack = 0.01 + bow * 0.22
  let release = 0.1 + body * 0.18
  return [
    "osc o1 sawtooth note detune " + f(0 - det),
    "osc o2 sawtooth note detune " + f(det),
    "filter f1 lowpass q 0.7 freq " + f(cutoff),
    "gain a1 0",
    "conn o1 f1 1",
    "conn o2 f1 1",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP),
    "env a1.gain set 0 0 lin " + f(attack) + " 1 set dur 1 exp dur+" + f(release) + " 0.0008"
  ]
}

// The premium voices reduce to FAITHFUL, param-driven patch graphs (the patch engine supports FM via
// conn→.freq, ratio/detune oscillators, and note/dur envelope expressions) so switching to Patch keeps the
// instrument's character AND the user's current knob settings. What can't survive: the patch grammar has no
// per-partial decay or formant GAIN (filters have freq/Q but no boost), so the layered shimmer/breath/
// tremolo of the live engine is approximated, not reproduced — but the core voice carries over.

// Tine → real 1:1 FM: a sine modulator drives the carrier's frequency; `bark` scales the FM-index envelope
// (bright metallic attack settling to a near-sine bell), `decay` the body length.
fn tineLines(p) {
  let bark = p.bark >= 0 && p.bark <= 1 ? p.bark : 0.55
  let tine = p.tine >= 0 && p.tine <= 1 ? p.tine : 0.6
  let decay = p.decay >= 0 && p.decay <= 1 ? p.decay : 0.5
  let drive = p.drive != null ? p.drive : 0.2
  // Body decay is key-scaled on a real EP (high notes ring shorter); the note isn't known at compile time,
  // so use the mid-keyboard ~0.78 factor. The live amp peaks at v*0.5 → output conn is VOL_COMP*0.5 (it was
  // ~2x too loud at full VOL_COMP) and the carrier runs through a 0.85 gain before the amp (as in the live).
  let bodyDecay = (1.1 + decay * 5.4) * 0.78
  // FM bark: a velocity spike that settles to a floor. Velocity can't scale the FM depth here (the output
  // conn owns the single velocity factor), so tune the spike to a medium-hard hit.
  let idxFloor = 0.6 + bark * 1.4
  let idxPeak = idxFloor + (1.5 + bark * 7.5) * 0.5
  let floorVal = idxFloor * 0.425
  let lines = [
    "osc m1 sine note",
    "gain md 1",
    "osc c1 sine note",
    "gain c1g 0.85",
    "gain a1 0",
    "conn m1 md 1",
    "conn md c1.freq 1",
    "conn c1 c1g 1",
    "conn c1g a1 1"
  ]
  // Tine PING: the inharmonic high-partial strike "tink", fast-decaying over the body. `tine` scales it.
  let pingMul = 6.0 + tine * 8.0
  let pingPeak = 0.06 + tine * 0.22
  let pingDecay = 0.04 + tine * 0.18
  lines.push("osc p1 sine note ratio " + f(pingMul))
  lines.push("filter php highpass q 0.7 freq 1500")
  lines.push("gain pg 0")
  lines.push("conn p1 php 1")
  lines.push("conn php pg 1")
  lines.push("conn pg a1 1")
  lines.push("env pg.gain set 0 0 lin 0.002 " + f(pingPeak) + " exp " + f(pingDecay) + " 0.0008")
  if (drive > 0.001) {
    lines.push("shaper sh1 amount " + f(drive * 120))
    lines.push("conn a1 sh1 1")
    lines.push("conn sh1 out " + f(VOL_COMP * 0.5))
  } else {
    lines.push("conn a1 out " + f(VOL_COMP * 0.5))
  }
  lines.push("env md.gain set 0 note*" + f(idxPeak) + " exp 0.12 note*" + f(floorVal))
  lines.push("env a1.gain set 0 0 lin 0.004 1 exp 0.09 0.72 exp " + f(bodyDecay) + " 0.001")
  return lines
}

// Aether → a single sine with the theremin PORTAMENTO: the freq envelope swoops up into pitch from a few
// semitones below (`glide`), through a tone-tilted lowpass, with a transient-free `swell` attack.
fn aetherLines(p) {
  let glide = p.glide >= 0 && p.glide <= 1 ? p.glide : 0.4
  let waver = p.waver >= 0 && p.waver <= 1 ? p.waver : 0.5
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.3
  let swell = p.swell >= 0 && p.swell <= 1 ? p.swell : 0.45
  let startFactor = Math.pow(2, (0 - (1.5 + glide * 4)) / 12)
  let glideTime = 0.02 + glide * 0.5
  let cutoff = Math.round(1400 + tone * 4200)
  if (cutoff > 9000) {
    cutoff = 9000
  }
  // A theremin SUSTAINS while the note is held (the volume hand), then releases — it is NOT a fixed 2.5s
  // decay (which made it drone like a pad regardless of note length). `set dur 1 … exp dur+release` holds
  // at full until note-off then fades. Two sines a few cents apart give the heterodyne beat (its calling
  // card); a faint 3rd harmonic adds the throaty color. Live peaks ~v*0.52 → output conn VOL_COMP*0.52.
  let attack = 0.05 + (1 - swell) * 0.4
  let release = 0.12 + (1 - swell) * 0.22
  let beat = 4 + waver * 5
  let lines = [
    "osc o1 sine note detune " + f(0 - beat),
    "osc o2 sine note detune " + f(beat),
    "filter f1 lowpass q 0.4 freq " + f(cutoff),
    "gain a1 0",
    "conn o1 f1 0.5",
    "conn o2 f1 0.5",
    "conn f1 a1 1",
    "conn a1 out " + f(VOL_COMP * 0.52),
    "env o1.freq set 0 note*" + f(startFactor) + " exp " + f(glideTime) + " note",
    "env o2.freq set 0 note*" + f(startFactor) + " exp " + f(glideTime) + " note",
    "env a1.gain set 0 0 lin " + f(attack) + " 1 set dur 1 exp dur+" + f(release) + " 0.0008"
  ]
  if (tone > 0.01) {
    lines.push("osc o3 sine note ratio 3")
    lines.push("conn o3 f1 " + f(tone * 0.16))
    lines.push("env o3.freq set 0 note*" + f(startFactor * 3) + " exp " + f(glideTime) + " note*3")
  }
  return lines
}

// Halo → the handpan partial triad: fundamental + octave (2×) + compound fifth (3×), `temper` detunes the
// upper partials via fractional ratios so they shimmer, `ring` sets the long decay. Upper partials sit lower.
fn haloLines(p) {
  let temper = p.temper >= 0 && p.temper <= 1 ? p.temper : 0.4
  let ring = p.ring >= 0 && p.ring <= 1 ? p.ring : 0.55
  let bloom = p.bloom >= 0 && p.bloom <= 1 ? p.bloom : 0.5
  let lows = p.lows >= 0 && p.lows <= 1 ? p.lows : 0.45
  // A handpan's soul is the inharmonic BEATING TRIAD: fundamental + octave + compound fifth, each a PAIR of
  // sines detuned ±cents so they throb (a single sine per partial sits dead). Upper partials BLOOM up then
  // decay sooner (energy moves down). `temper` spreads the beat; `ring` the tail; `lows` the warm body sub.
  let fundDecay = 1.2 + ring * 7.8
  let octDecay = fundDecay * 0.62
  let fifthDecay = fundDecay * 0.42
  let beatCents = 1.5 + temper * 8
  let octDrift = temper * 6
  let fifthDrift = 0 - temper * 7
  let octStart = 0.3 * (0.35 + (1 - bloom) * 0.4)
  let octPeak = 0.3 * (1.0 + bloom * 0.5)
  let octBloomT = 0.04 + bloom * 0.28
  let fiStart = 0.2 * (0.25 + (1 - bloom) * 0.45)
  let fiPeak = 0.2 * (1.0 + bloom * 0.6)
  let fiBloomT = 0.06 + bloom * 0.34
  let lines = [
    "osc f1a sine note detune " + f(0 - beatCents),
    "osc f1b sine note detune " + f(beatCents),
    "osc o2a sine note ratio 2 detune " + f(0 - (beatCents + octDrift)),
    "osc o2b sine note ratio 2 detune " + f(beatCents + octDrift),
    "osc o3a sine note ratio 3 detune " + f(0 - (beatCents + fifthDrift)),
    "osc o3b sine note ratio 3 detune " + f(beatCents + fifthDrift),
    "filter hp highpass q 0.5 freq 110",
    "gain gF 0",
    "gain gO 0",
    "gain gFi 0",
    "conn f1a gF 0.5",
    "conn f1b gF 0.5",
    "conn o2a gO 0.5",
    "conn o2b gO 0.5",
    "conn o3a gFi 0.5",
    "conn o3b gFi 0.5",
    "conn gF hp 1",
    "conn gO hp 1",
    "conn gFi hp 1",
    "conn hp out " + f(VOL_COMP * 0.5),
    "env gF.gain set 0 0 lin 0.006 0.5 exp " + f(fundDecay) + " 0.0008",
    "env gO.gain set 0 0 lin 0.006 " + f(octStart) + " lin " + f(octBloomT) + " " + f(octPeak) + " exp " + f(octDecay) + " 0.0008",
    "env gFi.gain set 0 0 lin 0.006 " + f(fiStart) + " lin " + f(fiBloomT) + " " + f(fiPeak) + " exp " + f(fifthDecay) + " 0.0008"
  ]
  if (lows > 0.02) {
    lines.push("osc ob sine note ratio 0.5")
    lines.push("filter bl lowpass q 0.6 freq " + f(220 + lows * 180))
    lines.push("gain gb 0")
    lines.push("conn ob bl 1")
    lines.push("conn bl gb 1")
    lines.push("conn gb out " + f(VOL_COMP))
    lines.push("env gb.gain set 0 0 lin 0.006 " + f(lows * 0.34) + " exp " + f(0.4 + ring * 1.6) + " 0.0008")
  }
  return lines
}

// Aahs → a choir: a UNISON of detuned saws (2..7 singers, width/count from `ensemble`) through a tone
// lowpass and the vowel's two dominant FORMANT bandpasses (F1/F2, tilted by tone). A sung note SUSTAINS
// while held then releases gently (legato) — not a fixed 2s decay. The grammar has no per-formant dB boost
// (X5), so bandpasses stand in for the peaking formants; vibrato/breath layers stay in the live engine.
fn aahsLines(p) {
  let vowel = p.vowel ? p.vowel : "aah"
  let ensemble = p.ensemble >= 0 && p.ensemble <= 1 ? p.ensemble : 0.5
  let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
  // Vowel formant pair (F1/F2 carry the vowel identity) + brightness factor.
  let f1 = 730
  let f2 = 1200
  let hpf = 0.5
  if (vowel === "eeh") { f1 = 290; f2 = 2300; hpf = 0.62 }
  else if (vowel === "ooh") { f1 = 320; f2 = 800; hpf = 0.32 }
  else if (vowel === "ohh") { f1 = 480; f2 = 900; hpf = 0.40 }
  else if (vowel === "mmm") { f1 = 250; f2 = 700; hpf = 0.28 }
  let tilt = 0.82 + tone * 0.36
  let fb1 = Math.round(f1 * tilt)
  let fb2 = Math.round(f2 * tilt)
  let voices = 2 + Math.floor(ensemble * 5 + 0.5)
  if (voices > 7) { voices = 7 }
  if (voices < 2) { voices = 2 }
  let spread = 6 + ensemble * 22
  let cutoff = Math.round((1400 + tone * 5200) * (0.55 + hpf * 0.9))
  if (cutoff > 15000) { cutoff = 15000 }
  let attack = 0.14 + (1 - tone) * 0.12
  let release = 0.34 + (1 - tone) * 0.22
  let lines = []
  let k = 0
  while (k < voices) {
    let frac = voices > 1 ? k / (voices - 1) : 0.5
    let det = (frac - 0.5) * spread
    lines.push("osc o" + String(k) + " sawtooth note detune " + f(det))
    k = k + 1
  }
  lines.push("filter lp lowpass q 0.6 freq " + f(cutoff))
  lines.push("filter bp1 bandpass q 4 freq " + f(fb1))
  lines.push("filter bp2 bandpass q 6 freq " + f(fb2))
  lines.push("gain a1 0")
  let j = 0
  while (j < voices) {
    lines.push("conn o" + String(j) + " lp 1")
    j = j + 1
  }
  lines.push("conn lp bp1 1")
  lines.push("conn lp bp2 1")
  lines.push("conn bp1 a1 1")
  lines.push("conn bp2 a1 0.8")
  // Normalize by the unison width (detuned voices beat rather than sum in phase, so ~sqrt) so a 7-singer
  // wall doesn't slam the master.
  lines.push("conn a1 out " + f((VOL_COMP * 0.6) / Math.sqrt(voices)))
  lines.push("env a1.gain set 0 0 lin " + f(attack) + " 1 set dur 1 exp dur+" + f(release) + " 0.0008")
  return lines
}

/// True when this generator can be reduced to an equivalent patch graph (sound-preserving switch).
export fn canCompileToPatch(generatorId) {
  return (
    generatorId === "basicOsc" ||
    generatorId === "fmTone" ||
    generatorId === "noiseBurst" ||
    generatorId === "pad" ||
    generatorId === "bell" ||
    generatorId === "drumSynth" ||
    generatorId === "matrixFm" ||
    generatorId === "guitar" ||
    generatorId === "clap" ||
    generatorId === "arco" ||
    generatorId === "tine" ||
    generatorId === "aether" ||
    generatorId === "halo" ||
    generatorId === "aahs"
  )
}

/// Compile the current generator + params (+ spec, for graph voices) into patch gen_block lines,
/// or null if not compilable.
export fn compileGeneratorToPatchLines(generatorId, params, spec) {
  let p = params ? params : {}
  if (generatorId === "basicOsc") {
    return basicOscLines(p)
  }
  if (generatorId === "fmTone") {
    return fmToneLines(p)
  }
  if (generatorId === "noiseBurst") {
    return noiseBurstLines(p)
  }
  if (generatorId === "pad") {
    return padLines(p)
  }
  if (generatorId === "bell") {
    return bellLines(p)
  }
  if (generatorId === "drumSynth") {
    return drumSynthLines(p)
  }
  if (generatorId === "guitar") {
    return guitarLines(p)
  }
  if (generatorId === "clap") {
    return clapLines(p)
  }
  if (generatorId === "arco") {
    return arcoLines(p)
  }
  if (generatorId === "tine") {
    return tineLines(p)
  }
  if (generatorId === "aether") {
    return aetherLines(p)
  }
  if (generatorId === "halo") {
    return haloLines(p)
  }
  if (generatorId === "aahs") {
    return aahsLines(p)
  }
  if (generatorId === "matrixFm") {
    return spec && spec.graph ? matrixFmLines(spec.graph) : null
  }
  return null
}
