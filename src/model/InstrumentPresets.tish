// Per-track instrument state is isolated: always clone params when assigning or loading presets.

import { parseGenBlock, defaultMatrixFmRawLines } from '../tpl/TplExtension.tish'

export fn deepCloneParams(obj) {
  return JSON.parse(JSON.stringify(obj))
}

export fn ensureInstrumentPresets(project) {
  if (!project.instrumentPresets) {
    project.instrumentPresets = []
  }
}

// User-saved instrument presets persist in localStorage (factory presets are re-seeded at boot, so only the
// `userSaved` ones are written). Mirrors the LevelPresets / StationPresets / SetLibrary persistence pattern —
// without this, a saved instrument preset lived only on the in-memory project and vanished on reload.
let INSTR_PRESET_KEY = "deckard.instrumentpresets.v1"

fn instrPresetBackend() {
  // globalThis.localStorage is a plain property read (undefined off-browser, no throw — see typeof gotcha).
  let ls = globalThis.localStorage
  if (ls !== null && ls !== undefined) {
    return {
      read: () => ls.getItem(INSTR_PRESET_KEY),
      write: (s) => {
        try {
          ls.setItem(INSTR_PRESET_KEY, s)
        } catch (e) {}
      }
    }
  }
  return { read: () => null, write: (s) => {} }
}

export fn persistUserInstrumentPresets(project) {
  ensureInstrumentPresets(project)
  let users = []
  let i = 0
  while (i < project.instrumentPresets.length) {
    if (project.instrumentPresets[i].userSaved === true) {
      users.push(project.instrumentPresets[i])
    }
    i = i + 1
  }
  instrPresetBackend().write(JSON.stringify(users))
}

// Merge the persisted user presets into the project's (factory-seeded) list, de-duped by presetId. Call once
// after a project boots / loads so saved instruments survive a reload.
export fn loadUserInstrumentPresets(project) {
  ensureInstrumentPresets(project)
  let raw = instrPresetBackend().read()
  if (raw === null || raw === undefined || String(raw).length === 0) {
    return
  }
  let users = null
  try {
    users = JSON.parse(raw)
  } catch (e) {
    users = null
  }
  if (!Array.isArray(users)) {
    return
  }
  let i = 0
  while (i < users.length) {
    let u = users[i]
    if (u !== null && u !== undefined) {
      let exists = false
      let j = 0
      while (j < project.instrumentPresets.length) {
        if (project.instrumentPresets[j].presetId === u.presetId) {
          exists = true
        }
        j = j + 1
      }
      if (!exists) {
        u.userSaved = true
        project.instrumentPresets.push(u)
      }
    }
    i = i + 1
  }
}

export fn addInstrumentPreset(project, displayName, ch) {
  ensureInstrumentPresets(project)
  let pid = "p_" + String(project.instrumentPresets.length) + "_" + String(Math.floor(Math.random() * 99999))
  // A preset is the whole SOUND (every instrument panel), not just the generator: macro identity, the
  // generator graph, the FX insert, and the voice/pitch behaviour. (Mixer gain/pan/eq stays per-channel.)
  let row = {
    presetId: pid,
    name: displayName,
    userSaved: true,
    generatorId: ch.generatorId,
    params: deepCloneParams(ch.generatorParams),
    macroName: ch.macroName !== null && ch.macroName !== undefined ? ch.macroName : null,
    macroParams: ch.macroParams ? deepCloneParams(ch.macroParams) : null,
    fx: {
      reverbSend: ch.reverbSend,
      drive: ch.drive,
      filterCutoff: ch.filterCutoff,
      filterQ: ch.filterQ,
      lfoRate: ch.lfoRate,
      lfoDepth: ch.lfoDepth
    },
    voice: {
      octave: ch.octave,
      arp: ch.arp,
      chord: ch.chord
    }
  }
  if (ch.generatorSpec) {
    row.generatorSpec = deepCloneParams(ch.generatorSpec)
  }
  project.instrumentPresets.push(row)
  persistUserInstrumentPresets(project)
}

export fn removeInstrumentPreset(project, name) {
  ensureInstrumentPresets(project)
  let out = []
  let i = 0
  let removed = false
  while (i < project.instrumentPresets.length) {
    if (project.instrumentPresets[i].name === name) {
      removed = true
    } else {
      out.push(project.instrumentPresets[i])
    }
    i = i + 1
  }
  project.instrumentPresets = out
  if (removed) {
    persistUserInstrumentPresets(project)
  }
  return removed
}

export fn applyInstrumentPresetToChannel(ch, preset) {
  ch.generatorId = preset.generatorId
  ch.generatorParams = deepCloneParams(preset.params)
  if (preset.generatorSpec) {
    ch.generatorSpec = deepCloneParams(preset.generatorSpec)
  } else {
    ch.generatorSpec = null
  }
  if (ch.generatorId === "matrixFm" && !ch.generatorSpec) {
    ch.generatorSpec = parseGenBlock("matrix_fm", defaultMatrixFmRawLines())
  }
  // Macro identity (so the Sound box shows the macro designer + the voice picker highlights it).
  ch.macroName = preset.macroName !== null && preset.macroName !== undefined ? preset.macroName : null
  ch.macroParams = preset.macroParams ? deepCloneParams(preset.macroParams) : null
  // Filter / FX box (older presets without `fx` reset to neutral so nothing stale lingers).
  let fx = preset.fx ? preset.fx : {}
  ch.reverbSend = fx.reverbSend !== null && fx.reverbSend !== undefined ? fx.reverbSend : 0
  ch.drive = fx.drive !== null && fx.drive !== undefined ? fx.drive : 0
  ch.filterCutoff = fx.filterCutoff !== null && fx.filterCutoff !== undefined ? fx.filterCutoff : 20000
  ch.filterQ = fx.filterQ !== null && fx.filterQ !== undefined ? fx.filterQ : 0.7
  ch.lfoRate = fx.lfoRate !== null && fx.lfoRate !== undefined ? fx.lfoRate : 0
  ch.lfoDepth = fx.lfoDepth !== null && fx.lfoDepth !== undefined ? fx.lfoDepth : 0
  // Pitch box.
  let voice = preset.voice ? preset.voice : {}
  ch.octave = voice.octave !== null && voice.octave !== undefined ? voice.octave : 0
  ch.arp = voice.arp !== null && voice.arp !== undefined ? voice.arp : "off"
  ch.chord = voice.chord !== null && voice.chord !== undefined ? voice.chord : "off"
}
