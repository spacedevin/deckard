// MIDI input — Web MIDI keyboard + controller, ported clean (no app-specific deps) from the patterns in
// ~/Projects/tish-audio. Two jobs: (1) keyboard NOTES audition the selected instrument live; (2) a CC/knob,
// once MIDI-learned to a target, drives that control via `rt.emit` — the SAME gated, broadcast, round-tripping
// deck a UI drag emits, so a hardware move is multiplayer-native. Device + mappings persist locally (per
// machine); the actions they trigger are deck.

/// Pure MIDI byte parser → a normalized event, or null. Status: 0x90 noteOn (vel 0 = noteOff), 0x80 noteOff,
/// 0xB0 control change, 0xE0 pitch bend (14-bit). System messages (0xF0+) are ignored.
export fn parseMidiBytes(bytes) {
  if (!bytes || bytes.length < 1) {
    return null
  }
  let b0 = bytes[0]
  if ((b0 & 240) === 240) {
    return null
  }
  let channel = b0 & 15
  let cmd = b0 & 240
  if (cmd === 144) {
    if (bytes.length < 3) {
      return null
    }
    let note = bytes[1]
    let vel = bytes[2]
    if (vel === 0) {
      return { kind: "noteOff", channel: channel, note: note, velocity: 0 }
    }
    return { kind: "noteOn", channel: channel, note: note, velocity: vel }
  }
  if (cmd === 128) {
    if (bytes.length < 3) {
      return null
    }
    return { kind: "noteOff", channel: channel, note: bytes[1], velocity: bytes[2] }
  }
  if (cmd === 176) {
    if (bytes.length < 3) {
      return null
    }
    return { kind: "cc", channel: channel, controller: bytes[1], value: bytes[2] }
  }
  if (cmd === 224) {
    if (bytes.length < 3) {
      return null
    }
    return { kind: "pitchBend", channel: channel, value14: bytes[1] | (bytes[2] << 7) }
  }
  return null
}

/// Stable key for a CC source (channel + controller) — the mapping table is keyed by this.
export fn ccKey(ev) {
  return "cc:" + String(ev.channel) + ":" + String(ev.controller)
}

/// 0..127 → 0..1.
export fn normalize01(value) {
  let v = Number(value) / 127
  if (v < 0) {
    return 0
  }
  if (v > 1) {
    return 1
  }
  return v
}

/// The curated set of MIDI-mappable targets (id → label). Each id is resolved by the App's midiControl.
/// EVERY target here drives a control that is VISIBLE on screen and updates when the hardware moves —
/// that is the rule (a knob you can hear but not see is a bug). So the per-deck booth EQ/filter/volume
/// knobs are the targets, NOT the master EQ (which has no on-screen control). Per-track stem gains are
/// appended dynamically. `group` lets the panel cluster them (deck A / deck B / global / tracks).
export fn midiTargetList(project) {
  let out = [
    { id: "bpm", label: "BPM", group: "Transport" },
    { id: "xfade_x", label: "Crossfade ◀ ▶", group: "Transport" },
    { id: "xfade_y", label: "Crossfade ▲ ▼", group: "Transport" },
    { id: "scratch", label: "Scratch (Deck A jog)", group: "Transport" }
  ]
  // Per-deck DJ-booth controls — these are the HI/MID/LO/FILTER knobs + volume fader in each deck's
  // centre channel strip (DeckChannelStrip). They exist for all four decks even before a deck is loaded.
  let decks = ["A", "B", "C", "D"]
  let di = 0
  while (di < decks.length) {
    let dk = decks[di]
    let g = "Deck " + dk
    out.push({ id: "deck:" + dk + ":hi", label: "Deck " + dk + " · EQ Hi", group: g })
    out.push({ id: "deck:" + dk + ":mid", label: "Deck " + dk + " · EQ Mid", group: g })
    out.push({ id: "deck:" + dk + ":lo", label: "Deck " + dk + " · EQ Lo", group: g })
    out.push({ id: "deck:" + dk + ":flt", label: "Deck " + dk + " · Filter", group: g })
    out.push({ id: "deck:" + dk + ":vol", label: "Deck " + dk + " · Volume", group: g })
    di = di + 1
  }
  if (project && project.channels) {
    let i = 0
    while (i < project.channels.length) {
      let ch = project.channels[i]
      out.push({ id: "track:" + ch.id, label: String(ch.name) + " gain", group: "Tracks" })
      i = i + 1
    }
  }
  return out
}

/// A sensible out-of-the-box mapping (CC → target) for a generic knob/fader controller, seeded ONCE on a
/// machine that has never saved any mappings. Channel 0 is assumed (the common default). The layout follows
/// a typical 8-knob + 8-fader bank: knobs 16–23 = deck A/B EQ, faders 0–1 = deck volumes, plus crossfade +
/// BPM. Controllers aren't standard, so this is just a starting point — any learned mapping overrides it,
/// and once a user clears all mappings the empty set is respected (no re-seed).
export fn defaultMidiMappings() {
  return {
    "cc:0:16": "deck:A:hi",
    "cc:0:17": "deck:A:mid",
    "cc:0:18": "deck:A:lo",
    "cc:0:19": "deck:A:flt",
    "cc:0:20": "deck:B:hi",
    "cc:0:21": "deck:B:mid",
    "cc:0:22": "deck:B:lo",
    "cc:0:23": "deck:B:flt",
    "cc:0:0": "deck:A:vol",
    "cc:0:1": "deck:B:vol",
    "cc:0:8": "xfade_x",
    "cc:0:9": "bpm"
  }
}

/// Resolve a mapped target's label (for the panel's mapping list). Falls back to the raw id.
export fn midiTargetLabel(project, targetId) {
  let list = midiTargetList(project)
  let i = 0
  while (i < list.length) {
    if (list[i].id === targetId) {
      return list[i].label
    }
    i = i + 1
  }
  return String(targetId)
}

let MIDI_MAP_KEY = "deckard.midi.mappings.v1"

fn defaultBackend() {
  if (typeof localStorage === "undefined") {
    return { read: () => null, write: (s) => {} }
  }
  return {
    read: () => {
      try {
        return localStorage.getItem(MIDI_MAP_KEY)
      } catch (e) {
        return null
      }
    },
    write: (s) => {
      try {
        localStorage.setItem(MIDI_MAP_KEY, s)
      } catch (e) {}
    }
  }
}

/// The MIDI controller store. deps:
///   onNote(note, velocity)         — a keyboard note-on (play the selected instrument)
///   onControl(targetId, value01)   — a mapped CC moved (drive the target via rt.emit)
///   onChange()                     — state changed (re-render the panel)
///   backend                        — { read, write } for mapping persistence (defaults to localStorage)
export fn createMidiController(deps) {
  let d = deps ? deps : {}
  let backend = d.backend ? d.backend : defaultBackend()
  let state = {
    supported: false,
    inputs: [],
    connectedId: "",
    learn: false,
    pending: null,
    mappings: {},
    panelOpen: false
  }
  // restore persisted mappings, or seed defaults on a machine that has never saved any
  let raw = backend.read()
  if (raw !== null && String(raw).length > 0) {
    try {
      let m = JSON.parse(raw)
      if (m && typeof m === "object") {
        state.mappings = m
      }
    } catch (e) {}
  } else if (d.seedDefaults !== false) {
    // First run here — seed + persist a working default layout (deck A/B EQ + volumes + crossfade + BPM)
    // so a hardware controller does something immediately. Re-learning overrides; clearing all stays cleared.
    state.mappings = defaultMidiMappings()
    backend.write(JSON.stringify(state.mappings))
  }
  let access = null
  let connectedInput = null

  fn notify() {
    if (d.onChange) {
      d.onChange()
    }
  }
  fn persist() {
    backend.write(JSON.stringify(state.mappings))
  }

  // A raw message from the connected input.
  fn onMessage(e) {
    let ev = parseMidiBytes(e.data)
    if (!ev) {
      return
    }
    if (ev.kind === "noteOn") {
      if (d.onNote) {
        d.onNote(ev.note, ev.velocity)
      }
      return
    }
    if (ev.kind === "cc") {
      let key = ccKey(ev)
      if (state.learn) {
        // Capture this CC as the pending source; the panel then assigns it to a target.
        state.pending = { key: key, channel: ev.channel, controller: ev.controller }
        notify()
        return
      }
      let target = state.mappings[key]
      if (target !== null && d.onControl) {
        d.onControl(target, normalize01(ev.value))
      }
    }
  }

  fn refreshInputs() {
    if (!access) {
      return
    }
    let list = []
    let it = access.inputs.values()
    let step = it.next()
    while (!step.done) {
      let inp = step.value
      list.push({ id: inp.id, name: inp.name ? inp.name : "MIDI input" })
      step = it.next()
    }
    state.inputs = list
    notify()
  }

  fn selectInput(id) {
    if (connectedInput) {
      connectedInput.onmidimessage = null
      connectedInput = null
    }
    state.connectedId = id ? id : ""
    if (!access || !id) {
      notify()
      return
    }
    let inp = access.inputs.get(id)
    if (inp) {
      inp.onmidimessage = onMessage
      connectedInput = inp
    }
    notify()
  }

  fn requestAccess() {
    if (typeof navigator === "undefined" || !navigator.requestMIDIAccess) {
      state.supported = false
      notify()
      return
    }
    navigator.requestMIDIAccess({ sysex: false }).then((acc) => {
      access = acc
      state.supported = true
      acc.onstatechange = () => {
        refreshInputs()
      }
      refreshInputs()
      // Auto-connect the first input if none chosen yet.
      if ((!state.connectedId || state.connectedId === "") && state.inputs.length > 0) {
        selectInput(state.inputs[0].id)
      }
    }, (err) => {
      state.supported = false
      notify()
    })
  }

  fn setLearn(on) {
    state.learn = on === true
    if (!state.learn) {
      state.pending = null
    }
    notify()
  }
  // Assign the pending (just-moved) CC to a target id. Stays in learn mode for the next binding.
  fn bindPending(targetId) {
    if (!state.pending || !targetId) {
      return
    }
    state.mappings[state.pending.key] = targetId
    state.pending = null
    persist()
    notify()
  }
  fn removeMapping(key) {
    if (state.mappings[key] !== null) {
      delete state.mappings[key]
      persist()
      notify()
    }
  }
  // Open/close the footer MIDI popover (input picker + LEARN + mappings live there so the footer is one button).
  fn togglePanel() {
    state.panelOpen = !state.panelOpen
    if (!state.panelOpen) {
      state.learn = false
      state.pending = null
    }
    notify()
  }

  return {
    state: () => state,
    requestAccess: requestAccess,
    selectInput: selectInput,
    setLearn: setLearn,
    bindPending: bindPending,
    removeMapping: removeMapping,
    togglePanel: togglePanel,
    // Test hook: feed a raw message as if from the device.
    feed: (data) => onMessage({ data: data })
  }
}
