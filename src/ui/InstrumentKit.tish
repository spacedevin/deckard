// Shared instrument UI kit — the polished visual language for every designer: rotary Knobs (arc + value),
// wave-shape icon pickers (vendored Lucide icons, defined here), and an ADSR/curve display. Inspired
// by modern VST rack editors: knobs over sliders, generous cards, per-instrument color accents.

import { h } from '@tishlang/lattish'

/// One <option> with `selected` set ONLY on the matching one. REQUIRED because the Lattish vdom mounts element
/// props BEFORE appending children, so `<select value=X>` runs `el.value=X` while the select has zero options →
/// the assignment is dropped and the select shows its FIRST option on initial mount. Marking the chosen option
/// `selected` makes the browser pick it regardless of order. The attribute must be CONDITIONALLY present (only
/// when matching) — a boolean `selected={false}` would still `setAttribute("selected","false")` (present ⇒
/// selected) at mount. Used by every patch / matrix dropdown whose value can differ from its first option.
export fn selOpt(value, label, cur, key) {
  if (String(value) === String(cur)) {
    return (
      <option value={value} selected="selected" key={key}>
        {label}
      </option>
    )
  }
  return (
    <option value={value} key={key}>
      {label}
    </option>
  )
}

/// Encode an SVG markup string as a data: URL (img src / CSS background). Lives here (the shared kit)
/// so both WaveIconPicker and MatrixFmPanel use one copy — keeping the import graph acyclic.
export fn matrixFmSvgDataUrl(svgMarkup) {
  if (typeof encodeURIComponent !== "undefined") {
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgMarkup)
  }
  return ""
}

/** Lucide v0.469.0 geometry (ISC): Waves, Square, Zap, Triangle, AudioWaveform — vendored as strings
 *  because the Tish bundle does not import npm; inline svg/path also fails (wrong DOM namespace).
 *  Source: lucide npm package, dist/esm/icons. */
export fn matrixFmLucideIconSvg(shape, strokeHex) {
  let st =
    " fill=\"none\" stroke=\"" +
    strokeHex +
    "\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\""
  if (shape === "sine") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1\"" +
      st +
      "/>" +
      "<path d=\"M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1\"" +
      st +
      "/>" +
      "<path d=\"M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "square") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "sawtooth") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "triangle") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M13.73 4a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "noise") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "pulse") {
    // Pulse / variable-width square wave icon
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M2 18h3V6h5v12h5V6h5v12h2\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "strings") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M2 12 C 5 2, 8 20, 12 12 C 16 4, 19 22, 22 12\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "brass") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M2 16 L 6 6 L 9 14 L 14 4 L 18 16 L 22 8\"" +
      st +
      "/></svg>"
    )
  }
  if (shape === "bass") {
    return (
      "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">" +
      "<path d=\"M2 14 Q 7 4, 12 14 T 22 14\"" +
      st +
      "/></svg>"
    )
  }
  return (
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 12h18\"" + st + "/></svg>"
  )
}

export fn LucideIcon(shape) {
  let strokeHex = "currentColor"
  if (shape === "download") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" x2="12" y1="15" y2="3" />
      </svg>
    )
  }
  if (shape === "save") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
        <path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7" />
        <path d="M7 3v4a1 1 0 0 0 1 1h7" />
      </svg>
    )
  }
  if (shape === "square") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <rect width="18" height="18" x="3" y="3" rx="2" />
      </svg>
    )
  }
  if (shape === "layout-grid") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <rect width="7" height="7" x="3" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="14" rx="1" />
        <rect width="7" height="7" x="3" y="14" rx="1" />
      </svg>
    )
  }
  if (shape === "sliders") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <line x1="21" x2="14" y1="4" y2="4" /><line x1="10" x2="3" y1="4" y2="4" />
        <line x1="21" x2="12" y1="12" y2="12" /><line x1="8" x2="3" y1="12" y2="12" />
        <line x1="21" x2="16" y1="20" y2="20" /><line x1="12" x2="3" y1="20" y2="20" />
        <line x1="14" x2="14" y1="2" y2="6" /><line x1="8" x2="8" y1="10" y2="14" /><line x1="16" x2="16" y1="18" y2="22" />
      </svg>
    )
  }
  if (shape === "code") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
      </svg>
    )
  }
  if (shape === "volume-x") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><line x1="22" x2="16" y1="9" y2="15" /><line x1="16" x2="22" y1="9" y2="15" />
      </svg>
    )
  }
  if (shape === "headphones") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
      </svg>
    )
  }
  if (shape === "lock") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
    )
  }
  // Folder-open — "load / recall a saved pattern" (clearer than a download arrow).
  if (shape === "folder-open") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H21a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2" />
      </svg>
    )
  }
  // Die face (5 pips) — reads as "random / generate" for the Euclid & Generate overlay toggle.
  if (shape === "dice") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <rect x="3" y="3" width="18" height="18" rx="3.5" />
        <circle cx="8" cy="8" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="16" cy="8" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="12" cy="12" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="8" cy="16" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="16" cy="16" r="1.15" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  // Piano keys: a key-bed rect, two white-key separators (visible only below the black keys), and two solid
  // black keys hanging from the top — instantly reads as a piano/keyboard even at ~12px.
  if (shape === "piano") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="lucide-icon session-ui-icon" width="16" height="16" style={{ display: "inline-block", verticalAlign: "middle" }}>
        <rect x="3" y="5" width="18" height="14" rx="1.6" />
        <line x1="9" y1="12" x2="9" y2="19" /><line x1="15" y1="12" x2="15" y2="19" />
        <rect x="7.4" y="5" width="3.2" height="7" rx="0.6" fill="currentColor" stroke="none" />
        <rect x="13.4" y="5" width="3.2" height="7" rx="0.6" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  return null
}

/// Per-instrument color accent — each voice gets its own tint (like the reference rack's color-coding).
export fn accentForGenerator(gid) {
  if (gid === "basicOsc") {
    return "#54d1c4"
  }
  if (gid === "fmTone") {
    return "#e8945c"
  }
  if (gid === "noiseBurst") {
    return "#b7b7c2"
  }
  if (gid === "pad") {
    return "#8f86e6"
  }
  if (gid === "bell") {
    return "#e6c34a"
  }
  if (gid === "drumSynth") {
    return "#e2557e"
  }
  if (gid === "guitar") {
    return "#e0863a"
  }
  if (gid === "clap") {
    return "#ec6a6a"
  }
  if (gid === "arco") {
    return "#c47a4e"
  }
  if (gid === "tine") {
    return "#d6a24e"
  }
  if (gid === "aether") {
    return "#6fd3c7"
  }
  if (gid === "halo") {
    return "#86b8cc"
  }
  if (gid === "formantVocal") {
    return "#c9a6e0"
  }
  if (gid === "ttsVocal") {
    return "#b8a6e0"
  }
  if (gid === "matrixFm") {
    return "#5aa9e8"
  }
  if (gid === "patch") {
    return "#5fd06f"
  }
  if (gid === "acid303") {
    return "#b6e84a"
  }
  if (gid === "sub808") {
    return "#6a4ad6"
  }
  if (gid === "chiptune") {
    return "#59c46b"
  }
  if (gid === "nes2a03") {
    return "#d65a5a"
  }
  if (gid === "c64sid") {
    return "#5a7fd6"
  }
  if (gid === "gameBoyDmg") {
    return "#9bbc0f"
  }
  if (gid === "ym2612") {
    return "#4aa3c4"
  }
  if (gid === "sn76489") {
    return "#c47ad6"
  }
  if (gid === "spc700") {
    return "#c4a24a"
  }
  if (gid === "gbaDirectSound") {
    return "#7a86e0"
  }
  if (gid === "cymbal") {
    return "#cfd14a"
  }
  if (gid === "reeseBass") {
    return "#5a6ad6"
  }
  if (gid === "syncLead") {
    return "#e85ca6"
  }
  if (gid === "syncChoir") {
    return "#a6c4e8"
  }
  if (gid === "obSync") {
    return "#4ac9b0"
  }
  if (gid === "laserSync") {
    return "#e8c44a"
  }
  if (gid === "meSpeakVocal") {
    return "#9a86d6"
  }
  return "#8a8a94"
}

/// Point on a dial: angle measured clockwise from 12 o'clock (0 = top, 90 = right).
fn dialPoint(cx, cy, r, deg) {
  let a = (deg * Math.PI) / 180
  return [cx + r * Math.sin(a), cy - r * Math.cos(a)]
}

/// SVG arc path from deg1 to deg2 (clockwise). Knob sweep is -135°..+135° (270° total).
fn dialArc(cx, cy, r, deg1, deg2) {
  let s = dialPoint(cx, cy, r, deg1)
  let e = dialPoint(cx, cy, r, deg2)
  let large = (deg2 - deg1) > 180 ? 1 : 0
  return "M " + String(s[0]) + " " + String(s[1]) + " A " + String(r) + " " + String(r) + " 0 " + String(large) + " 1 " + String(e[0]) + " " + String(e[1])
}

fn knobClamp(v, min, max) {
  if (v < min) {
    return min
  }
  if (v > max) {
    return max
  }
  return v
}

// Global "is any knob being dragged" flag — set on pointer/touch down, cleared on up. Consumers (the patch /
// matrix editors) use it to FREEZE their per-channel undo snapshot during a drag (so the captured "before"
// state is the pre-drag value, not a mid-drag one) without wiring a per-knob gesture hook.
let knobDragging = false
export fn isKnobDragging() {
  return knobDragging
}

/**
 * Rotary knob. opts: { label, value, min, max, step?, fmt?, onInput, onCommit?, accent?, detents? }.
 * Vertical drag = change (up increases). onInput(newValue) fires continuously during the drag.
 * onCommit(finalValue) fires ONCE at the end of a gesture (mouseup/touchend, or per wheel tick) — the
 * "this edit is final" signal for consumers that persist/broadcast on settle rather than per pixel.
 * detents: when >= 2, draws that many evenly-spaced position dots around the dial (the current
 * one lit in the accent colour) instead of the plain moving indicator — used for stepped selectors
 * (octave / arp / chord). Scroll-wheel steps one detent at a time (only when detents is set).
 */
export fn Knob(opts) {
  let min = opts.min
  let max = opts.max
  let v = knobClamp(opts.value, min, max)
  let t = (max - min) !== 0 ? (v - min) / (max - min) : 0
  let accent = opts.accent ? opts.accent : "var(--accent-warm, #e8945c)"
  let cx = 24
  let cy = 23
  let r = 17
  let trackD = dialArc(cx, cy, r, -135, 135)
  let curAngle = -135 + t * 270
  let valD = ""
  if (min < 0 && max > 0) {
    let zeroT = (0 - min) / (max - min)
    let zeroAngle = -135 + zeroT * 270
    if (curAngle < zeroAngle) {
      valD = dialArc(cx, cy, r, curAngle, zeroAngle)
    } else {
      valD = dialArc(cx, cy, r, zeroAngle, curAngle)
    }
  } else {
    valD = dialArc(cx, cy, r, -135, curAngle)
  }
  let dot = dialPoint(cx, cy, r, curAngle)
  let detents = opts.detents !== null && opts.detents !== undefined && opts.detents >= 2 ? Math.round(opts.detents) : 0
  let detentDots = []
  if (detents > 0) {
    let curIdx = Math.round(t * (detents - 1))
    let di = 0
    while (di < detents) {
      let ddt = di / (detents - 1)
      let dpt = dialPoint(cx, cy, r, -135 + ddt * 270)
      let lit = di === curIdx
      detentDots.push(
        <circle
          class={lit ? "ik-knob-detent ik-knob-detent-on" : "ik-knob-detent"}
          cx={String(dpt[0])}
          cy={String(dpt[1])}
          r={lit ? "2.6" : "1.6"}
          style={lit ? { fill: accent } : {}}
          key={"det" + String(di)}
        />
      )
      di = di + 1
    }
  }
  let label = opts.label ? opts.label : ""
  let valText = opts.fmt ? opts.fmt(v) : String(Math.round(v))
  let rootCls = "ik-knob"
  if (opts.size === "sm") {
    rootCls = "ik-knob ik-knob-sm"
  }
  if (opts.size === "xs") {
    rootCls = "ik-knob ik-knob-xs"
  }
  if (opts.disabled) {
    rootCls = rootCls + " ik-knob-disabled"
  }

  // Shared drag from a starting Y. Mouse and touch both funnel through here so the value math + the
  // emit-coalescing are identical; each binds its own move/up pair on document (touch needs the
  // `.ik-knob-dial { touch-action: none }` rule so the drag doesn't scroll the page).
  fn startDrag(startY) {
    knobDragging = true
    let startV = v
    let range = max - min
    let lastEmit = startV
    let didChange = false
    fn onMove(ev) {
      let cy2 = ev.clientY !== null && ev.clientY !== undefined ? ev.clientY : (ev.touches !== null && ev.touches !== undefined && ev.touches.length > 0 ? ev.touches[0].clientY : startY)
      let dy = startY - cy2
      let dragRange = Math.max(range, 4) // Make discrete 2-option knobs more sensitive
      let nv = knobClamp(startV + (dy / 150) * dragRange, min, max)
      if (opts.step !== null && opts.step !== undefined && opts.step > 0) {
        nv = Math.round(nv / opts.step) * opts.step
      }
      // Skip identical consecutive values — within one detent a stepped knob would otherwise
      // re-emit (and re-broadcast) the same value every move.
      if (nv !== lastEmit) {
        lastEmit = nv
        didChange = true
        if (opts.onInput) {
          opts.onInput(nv)
        }
      }
    }
    fn onUp() {
      knobDragging = false
      document.removeEventListener("mousemove", onMove)
      document.removeEventListener("mouseup", onUp)
      document.removeEventListener("touchmove", onMove)
      document.removeEventListener("touchend", onUp)
      // touchcancel/pointercancel fire INSTEAD of touchend when the OS interrupts a gesture — without these the
      // global knobDragging flag would stick true and stall the patch/matrix deferred broadcasts + snapshot.
      document.removeEventListener("touchcancel", onUp)
      document.removeEventListener("pointercancel", onUp)
      // Fire onCommit ONCE at the end of the gesture (not per move) — the "this edit is final" signal a
      // consumer uses to persist/broadcast without doing it per pixel. Only when the value actually moved.
      if (didChange && opts.onCommit) {
        opts.onCommit(lastEmit)
      }
    }
    document.addEventListener("mousemove", onMove)
    document.addEventListener("mouseup", onUp)
    document.addEventListener("touchmove", onMove)
    document.addEventListener("touchend", onUp)
    document.addEventListener("touchcancel", onUp)
    document.addEventListener("pointercancel", onUp)
  }

  fn onDown(e) {
    if (e.preventDefault) {
      e.preventDefault()
    }
    if (e.stopPropagation) {
      e.stopPropagation()
    }
    startDrag(e.clientY)
  }

  fn onTouchStart(e) {
    if ((e.touches === null || e.touches === undefined) || e.touches.length === 0) {
      return
    }
    // preventDefault suppresses the ghost mouse/click events that follow a touch tap.
    if (e.preventDefault) {
      e.preventDefault()
    }
    if (e.stopPropagation) {
      e.stopPropagation()
    }
    startDrag(e.touches[0].clientY)
  }

  fn onWheel(e) {
    if (detents <= 0) {
      return
    }
    // Ignore horizontal / zero-Y wheel (e.g. a two-finger horizontal trackpad swipe carries deltaX
    // with deltaY 0) so it neither steps the knob nor swallows the page scroll.
    if (e.deltaY === 0) {
      return
    }
    if (e.preventDefault) {
      e.preventDefault()
    }
    let stepV = opts.step !== null && opts.step !== undefined && opts.step > 0 ? opts.step : 1
    let dir = e.deltaY < 0 ? 1 : -1
    let nv = knobClamp(v + dir * stepV, min, max)
    // At a boundary the clamp pins nv to the current value — skip the redundant gated emit/broadcast.
    if (nv !== v) {
      if (opts.onInput) {
        opts.onInput(nv)
      }
      // A wheel tick is a discrete, self-contained edit → commit it immediately.
      if (opts.onCommit) {
        opts.onCommit(nv)
      }
    }
  }

  return (
    <div class={rootCls} style={opts.disabled ? { opacity: "0.4", pointerEvents: "none" } : {}}>
      <svg class="ik-knob-dial" viewBox="0 0 48 48" onmousedown={opts.disabled ? null : onDown} ontouchstart={opts.disabled ? null : onTouchStart} onwheel={opts.disabled ? null : onWheel}>
        <path class="ik-knob-track" d={trackD} fill="none" />
        <path class="ik-knob-val" d={valD} fill="none" style={{ stroke: accent }} />
        {detents > 0 ? detentDots : (
          <circle class="ik-knob-dot" cx={String(dot[0])} cy={String(dot[1])} r="2.6" style={{ fill: accent }} />
        )}
        {opts.valueInside && valText !== "" ? (
          <text x="24" y="23.5" class="ik-knob-value-inside" style={{ fill: accent, pointerEvents: "none" }}>{valText}</text>
        ) : null}
      </svg>
      {label !== "" ? <div class="ik-knob-label">{label}</div> : null}
      {!opts.valueInside && valText !== "" ? <div class="ik-knob-value">{valText}</div> : null}
    </div>
  )
}

/// Wave-shape icon picker. Default: sine/square/sawtooth/triangle (+ noise when allowNoise).
/// Pass opts.choices = ["pulse", "triangle", ...] to override the wave list entirely.
export fn WaveIconPicker(current, onPick, opts) {
  let allowNoise = opts && opts.allowNoise === true
  let accent = opts && opts.accent ? opts.accent : "var(--accent-warm, #e8945c)"
  let choices = null
  if (opts && opts.choices) {
    choices = opts.choices
  } else {
    choices = ["sine", "square", "sawtooth", "triangle"]
    if (allowNoise) {
      choices = ["sine", "square", "sawtooth", "triangle", "noise"]
    }
  }
  let titles = { sine: "Sine", square: "Square", sawtooth: "Saw", triangle: "Triangle", noise: "Noise", pulse: "Pulse" }
  let btns = []
  let i = 0
  while (i < choices.length) {
    let w = choices[i]
    let wCopy = w
    let active = current === w
    let stroke = active ? accent : "#777782"
    let cls = active ? "ik-wave-btn ik-wave-btn-on" : "ik-wave-btn"
    btns.push(
      <button
        type="button"
        class={cls}
        key={"ikw" + w}
        title={titles[w]}
        onmousedown={(e) => e.stopPropagation()}
        onclick={() => onPick(wCopy)}
      >
        <img class="ik-wave-img" src={matrixFmSvgDataUrl(matrixFmLucideIconSvg(w, stroke))} alt="" draggable={false} />
      </button>
    )
    i = i + 1
  }
  return <div class="ik-wave-row">{btns}</div>
}

/// ADSR envelope curve as a filled area (reference-style). a/d/s/r in seconds / 0..1.
fn adsrPathD(a, d, s, r, w, hgt) {
  let hold = 0.16
  let aa = a > 0 ? a : 0
  let dd = d > 0 ? d : 0
  let rr = r > 0 ? r : 0
  let ss = s >= 0 && s <= 1 ? s : 0.5
  let total = aa + dd + hold + rr
  if (total < 0.0005) {
    total = 0.0005
  }
  let xA = (aa / total) * w
  let xAD = ((aa + dd) / total) * w
  let xADS = ((aa + dd + hold) / total) * w
  let yS = hgt * (1 - ss)
  return "M 0 " + String(hgt) + " L " + String(xA) + " 0 L " + String(xAD) + " " + String(yS) + " L " + String(xADS) + " " + String(yS) + " L " + String(w) + " " + String(hgt)
}

/// Filled envelope display (reference-style: line + translucent area fill under it).
export fn EnvDisplay(a, d, s, r, opts) {
  let accent = opts && opts.accent ? opts.accent : "var(--accent-warm, #e8945c)"
  let line = adsrPathD(a, d, s, r, 100, 40)
  let area = line + " Z"
  return (
    <svg class="ik-env" viewBox="0 0 100 44" preserveAspectRatio="none">
      <path d={area} style={{ fill: accent, fillOpacity: "0.14", stroke: "none" }} />
      <path d={line} style={{ fill: "none", stroke: accent, strokeWidth: "1.6", strokeLinejoin: "round", strokeLinecap: "round" }} />
    </svg>
  )
}

/**
 * Infinitely spinning rotary knob. opts: { label, value, step?, fmt?, onInput, onCommit?, accent? }.
 * Vertical drag = change (up increases). No bounds.
 */
export fn InfiniteKnob(opts) {
  let v = opts.value !== null && opts.value !== undefined ? opts.value : 0
  let accent = opts.accent ? opts.accent : "var(--accent-warm, #e8945c)"
  let cx = 24
  let cy = 23
  let r = 17
  
  let trackD = "M 24 6 A 17 17 0 1 1 23.99 6"
  let deg = (v * 15) % 360
  if (deg < 0) {
    deg = deg + 360
  }
  let dot = dialPoint(cx, cy, r, deg)

  let label = opts.label ? opts.label : ""
  let valText = opts.fmt ? opts.fmt(v) : String(Math.round(v))
  let rootCls = "ik-knob"
  if (opts.size === "sm") {
    rootCls = "ik-knob ik-knob-sm"
  }
  if (opts.size === "xs") {
    rootCls = "ik-knob ik-knob-xs"
  }

  fn startDrag(startY) {
    knobDragging = true
    let startV = v
    let lastEmit = startV
    let didChange = false
    fn onMove(ev) {
      let cy2 = ev.clientY !== null && ev.clientY !== undefined ? ev.clientY : (ev.touches !== null && ev.touches !== undefined && ev.touches.length > 0 ? ev.touches[0].clientY : startY)
      let dy = startY - cy2
      let nv = startV + (dy / 20)
      if (opts.step !== null && opts.step !== undefined && opts.step > 0) {
        nv = Math.round(nv / opts.step) * opts.step
      }
      if (nv !== lastEmit) {
        lastEmit = nv
        didChange = true
        if (opts.onInput) {
          opts.onInput(nv)
        }
      }
    }
    fn onUp() {
      knobDragging = false
      document.removeEventListener("mousemove", onMove)
      document.removeEventListener("mouseup", onUp)
      document.removeEventListener("touchmove", onMove)
      document.removeEventListener("touchend", onUp)
      document.removeEventListener("touchcancel", onUp)
      document.removeEventListener("pointercancel", onUp)
      if (didChange && opts.onCommit) {
        opts.onCommit(lastEmit)
      }
    }
    document.addEventListener("mousemove", onMove)
    document.addEventListener("mouseup", onUp)
    document.addEventListener("touchmove", onMove)
    document.addEventListener("touchend", onUp)
    document.addEventListener("touchcancel", onUp)
    document.addEventListener("pointercancel", onUp)
  }

  fn onDown(e) {
    if (e.preventDefault) {
      e.preventDefault()
    }
    if (e.stopPropagation) {
      e.stopPropagation()
    }
    startDrag(e.clientY)
  }

  fn onTouchStart(e) {
    if ((e.touches === null || e.touches === undefined) || e.touches.length === 0) {
      return
    }
    if (e.preventDefault) {
      e.preventDefault()
    }
    if (e.stopPropagation) {
      e.stopPropagation()
    }
    startDrag(e.touches[0].clientY)
  }

  fn onWheel(e) {
    if (e.deltaY === 0) {
      return
    }
    if (e.preventDefault) {
      e.preventDefault()
    }
    let stepV = opts.step !== null && opts.step !== undefined && opts.step > 0 ? opts.step : 1
    let dir = e.deltaY < 0 ? 1 : -1
    let nv = v + dir * stepV
    if (nv !== v) {
      if (opts.onInput) {
        opts.onInput(nv)
      }
      if (opts.onCommit) {
        opts.onCommit(nv)
      }
    }
  }

  return (
    <div class={rootCls}>
      <svg class="ik-knob-dial" viewBox="0 0 48 48" onmousedown={onDown} ontouchstart={onTouchStart} onwheel={onWheel}>
        <path class="ik-knob-track" d={trackD} fill="none" />
        <circle class="ik-knob-dot" cx={String(dot[0])} cy={String(dot[1])} r="2.6" style={{ fill: accent }} />
      </svg>
      <div class="ik-knob-label">{label}</div>
      <div class="ik-knob-value">{valText}</div>
    </div>
  )
}

export fn Switch(opts) {
  let v = opts.value === true
  let accent = opts.accent ? opts.accent : "var(--accent-warm, #e8945c)"
  let label = opts.label ? opts.label : ""
  
  let rootCls = "ik-switch"
  if (opts.disabled) {
    rootCls = rootCls + " ik-switch-disabled"
  }
  
  let onCls = v ? "ik-switch-btn ik-switch-btn-on" : "ik-switch-btn"
  
  fn toggle(e) {
    if (e.stopPropagation) e.stopPropagation()
    if (opts.disabled) return
    if (opts.onInput) opts.onInput(!v)
    if (opts.onCommit) opts.onCommit(!v)
  }
  
  return (
    <div class={rootCls} style={opts.disabled ? { opacity: "0.4", pointerEvents: "none" } : { display: "flex", flexDirection: "column", alignItems: "center", gap: "6px" }}>
      <div class={onCls} onmousedown={toggle} ontouchstart={toggle}>
        <div class="ik-switch-handle" style={v ? { backgroundColor: accent, boxShadow: "0 0 6px " + accent } : {}}></div>
      </div>
      <div class="ik-switch-lbl" style={{ textAlign: "center", fontSize: "0.55rem", fontWeight: "700", letterSpacing: "0.08em", color: "var(--muted)", textTransform: "uppercase", marginTop: "2px" }}>{label}</div>
    </div>
  )
}

/**
 * Custom software dropdown — replaces native OS `<select>`.
 * opts: { value, options: [{value, label}], onChange, class?, accent?, placeholder? }
 * Renders a styled trigger button; clicking opens a positioned option list.
 */
export fn IkSelect(opts) {
  let curVal = opts.value !== null && opts.value !== undefined ? String(opts.value) : ""
  let items = opts.options ? opts.options : []
  let accent = opts.accent ? opts.accent : "var(--accent-warm, #e8945c)"
  let cls = "ik-sel"
  if (opts.class) {
    cls = cls + " " + opts.class
  }
  // Find current label
  let curLabel = opts.placeholder ? opts.placeholder : ""
  let ii = 0
  while (ii < items.length) {
    if (String(items[ii].value) === curVal) {
      curLabel = items[ii].label
    }
    ii = ii + 1
  }

  fn toggle(e) {
    if (e.stopPropagation) e.stopPropagation()
    if (e.preventDefault) e.preventDefault()
    let trigger = e.currentTarget
    let existing = document.getElementById("ik-active-sel-list")
    if (existing) {
      let wasThisOne = existing._trigger === trigger
      if (existing._cleanup) {
        existing._cleanup()
      }
      existing.remove()
      if (wasThisOne) {
        return
      }
    }

    // Find initial highlighted index
    let highlightedIdx = -1
    let oi = 0
    while (oi < items.length) {
      let item = items[oi]
      if (!item.isHeader && String(item.value) === curVal) {
        highlightedIdx = oi
        break
      }
      oi = oi + 1
    }
    if (highlightedIdx === -1) {
      let k = 0
      while (k < items.length) {
        if (!items[k].isHeader) {
          highlightedIdx = k
          break
        }
        k = k + 1
      }
    }

    // Build option list
    let list = document.createElement("div")
    list.className = "ik-sel-list"
    let oi2 = 0
    while (oi2 < items.length) {
      let item = items[oi2]
      let row = document.createElement("div")
      if (item.isHeader) {
        row.className = "ik-sel-opt-header"
        row.textContent = item.label
        row.onmousedown = (ev) => {
          ev.stopPropagation()
          ev.preventDefault()
        }
      } else {
        let itemVal = item.value
        // When the caller supplies onDelete, each row carries a ✕ to remove that preset. The ✕ swallows the
        // mousedown so it deletes instead of selecting; after delete we close the list (the re-render reopens fresh).
        if (opts.onDelete && item.deletable !== false) {
          row.className = "ik-sel-opt ik-sel-opt-del-row"
          let txt = document.createElement("span")
          txt.className = "ik-sel-opt-text"
          txt.textContent = item.label
          row.appendChild(txt)
          let del = document.createElement("button")
          del.type = "button"
          del.className = "ik-sel-opt-del"
          del.textContent = "✕"
          del.title = "Delete \"" + String(item.label) + "\""
          del.onmousedown = (ev) => {
            ev.stopPropagation()
            ev.preventDefault()
            list.remove()
            cleanup()
            opts.onDelete(itemVal)
          }
          row.appendChild(del)
        } else {
          row.className = "ik-sel-opt"
          row.textContent = item.label
        }
        row.onmousedown = (ev) => {
          ev.stopPropagation()
          ev.preventDefault()
          if (opts.onChange) {
            opts.onChange(itemVal)
          }
          list.remove()
          cleanup()
        }
      }
      list.appendChild(row)
      oi2 = oi2 + 1
    }

    fn updateHighlight(hlIdx) {
      let idx = 0
      while (idx < items.length) {
        let child = list.childNodes[idx]
        if (child) {
          let item = items[idx]
          if (!item.isHeader) {
            if (idx === hlIdx) {
              child.className = "ik-sel-opt ik-sel-opt-on"
              child.style.color = accent
              if (child.scrollIntoView) {
                child.scrollIntoView({ block: "nearest" })
              }
            } else {
              child.className = "ik-sel-opt"
              child.style.color = ""
            }
          }
        }
        idx = idx + 1
      }
    }

    let searchBuffer = ""
    let searchTimeout = null
    fn onKeyDown(ev) {
      if (ev.ctrlKey || ev.metaKey || ev.altKey) {
        return
      }
      if (ev.key === "Escape") {
        list.remove()
        cleanup()
        return
      }
      if (ev.key === "Enter") {
        ev.preventDefault()
        ev.stopPropagation()
        if (highlightedIdx >= 0 && highlightedIdx < items.length) {
          let item = items[highlightedIdx]
          if (!item.isHeader) {
            if (opts.onChange) {
              opts.onChange(item.value)
            }
            list.remove()
            cleanup()
          }
        }
        return
      }
      if (ev.key === "ArrowDown" || ev.key === "ArrowUp") {
        ev.preventDefault()
        ev.stopPropagation()
        let dir = ev.key === "ArrowDown" ? 1 : -1
        let idx = highlightedIdx
        let steps = 0
        while (steps < items.length) {
          idx = (idx + dir + items.length) % items.length
          if (!items[idx].isHeader) {
            highlightedIdx = idx
            updateHighlight(highlightedIdx)
            break
          }
          steps = steps + 1
        }
        return
      }
      if (ev.key.length === 1) {
        ev.preventDefault()
        ev.stopPropagation()
        searchBuffer = searchBuffer + ev.key
        if (searchTimeout !== null && searchTimeout !== undefined) {
          clearTimeout(searchTimeout)
        }
        searchTimeout = setTimeout(() => {
          searchBuffer = ""
        }, 1000)
        
        let query = searchBuffer.toLowerCase()
        let foundIdx = -1
        let idx = 0
        while (idx < items.length) {
          let item = items[idx]
          if (!item.isHeader && item.value && item.label) {
            let valStr = String(item.value).toLowerCase()
            let labStr = String(item.label).toLowerCase()
            if (valStr.indexOf(query) === 0 || labStr.indexOf(query) === 0) {
              foundIdx = idx
              break
            }
          }
          idx = idx + 1
        }
        if (foundIdx !== -1) {
          highlightedIdx = foundIdx
          updateHighlight(highlightedIdx)
        }
      }
    }

    fn cleanup() {
      document.removeEventListener("mousedown", closeList, true)
      document.removeEventListener("keydown", onKeyDown, true)
    }

    list.id = "ik-active-sel-list"
    list._trigger = trigger
    list._cleanup = cleanup

    let rect = trigger.getBoundingClientRect()
    list.style.position = "fixed"
    list.style.zIndex = "1000"
    list.style.minWidth = String(rect.width) + "px"
    document.body.appendChild(list)

    let listW = list.offsetWidth
    let listH = list.offsetHeight

    let top = rect.bottom + 4
    if (rect.bottom + listH + 4 > window.innerHeight && rect.top - listH - 4 >= 0) {
      top = rect.top - listH - 4
    }
    if (top < 4) {
      top = 4
    } else if (top + listH > window.innerHeight) {
      top = window.innerHeight - listH - 4
    }

    let left = rect.left
    if (left + listW > window.innerWidth) {
      left = rect.right - listW
    }
    if (left < 4) {
      left = 4
    }

    list.style.top = String(top) + "px"
    list.style.left = String(left) + "px"

    if (highlightedIdx !== -1) {
      updateHighlight(highlightedIdx)
    }

    // Close on any outside click
    fn closeList(ev) {
      if (!trigger.contains(ev.target) && !list.contains(ev.target)) {
        list.remove()
        cleanup()
      }
    }
    setTimeout(() => {
      document.addEventListener("mousedown", closeList, true)
      document.addEventListener("keydown", onKeyDown, true)
    }, 0)
  }

  return (
    <div class={cls} style={opts.style} onmousedown={toggle}>
      <span class="ik-sel-label">{curLabel}</span>
      <span class="ik-sel-arrow">{"▾"}</span>
    </div>
  )
}
