// Modular patch editor — DECOMPOSED into per-module cards. Each node (osc / noise / string / filter /
// shaper / gain / pan) is its own card with a header, body knobs, and INLINE output routing (each module
// owns where its signal goes), plus envelope cards. The universal counterpart to MatrixFmPanel, editing the
// free-form graph that Patch.tish plays.
//
// Edit model (two verbs):
//   edit.live()   — mutate is already applied; sync graph→raw + setProject for INSTANT local feedback. No
//                   broadcast, no ingest, so the live graph object is never swapped. Used during a knob drag.
//   edit.commit() — live() + broadcast the whole gen_block through the gated `gen` ingest door
//                   (rt.directive(emitInstrumentModuleTpl)). Used at a settle point: knob onCommit
//                   (drag end / wheel tick) and every discrete edit (select / add / remove).
// Why split: ingest re-parses the gen_block and REPLACES ch.generatorSpec.graph; doing that mid-drag would
// orphan the knob's closed-over graph (a paused drag would lose its resumed edits). Committing only at the
// gesture's end keeps the swap out of any in-flight drag. The broadcast reaches peers + round-trips and
// MERGES (the gen-only fragment preserves the channel's steps/mix). NOTE: a patch-module edit is broadcast
// but is NOT on the undo stack (the undo stack covers rt.emit addresses, not directives) — unlike a fader.

import { h } from '@tishlang/lattish'
import { normalizeBasicOscWaveform } from '../generators/Registry.tish'
import { parseGenBlock } from '../tpl/TplExtension.tish'
import { emitInstrumentModuleTpl } from '../core/Levels.tish'
import { Knob, accentForGenerator, WaveIconPicker, isKnobDragging, selOpt } from './InstrumentKit.tish'
import {
  syncPatchSpecFromGraph,
  defaultPatchRawLines,
  addPatchNode,
  removePatchNode,
  addPatchConnFrom,
  addPatchConnTo,
  removePatchConnAt,
  addPatchEnv,
  removePatchEnvAt,
  addPatchEnvSeg,
  removePatchEnvSegAt,
  patchSignalStages
} from '../tpl/PatchGraph.tish'

fn numOr(x, def) {
  if (typeof x === "number" && x === x) {
    return x
  }
  return def
}

fn levelKnob(nd, edit, accent) {
  let value = numOr(nd.gain, 1)
  return Knob({
    label: "Level",
    value: Math.round(value * 100),
    min: 0,
    max: 200,
    step: 1,
    accent: accent,
    fmt: (v) => Number(Math.round(v) / 100).toFixed(2),
    onInput: (v) => {
      nd.gain = v / 100
      edit.live()
    },
    onCommit: () => edit.commit()
  })
}

fn freqToSlider(hz) {
  let lo = Math.log(20)
  let hi = Math.log(18000)
  let h0 = hz
  if (h0 < 20) {
    h0 = 20
  }
  if (h0 > 18000) {
    h0 = 18000
  }
  return Math.round(((Math.log(h0) - lo) / (hi - lo)) * 1000)
}

fn sliderToFreq(sl) {
  let lo = Math.log(20)
  let hi = Math.log(18000)
  return Math.round(Math.exp(lo + (sl / 1000) * (hi - lo)))
}

fn nodeIdList(g) {
  let ids = []
  let i = 0
  while (i < g.nodes.length) {
    ids.push(g.nodes[i].id)
    i = i + 1
  }
  return ids
}

fn hasNode(g, id) {
  let i = 0
  while (i < g.nodes.length) {
    if (g.nodes[i].id === id) {
      return true
    }
    i = i + 1
  }
  return false
}

// Destination options for a route FROM `selfId`: every OTHER node + the fixed sinks out / reverb. `curDst`
// is kept as an option even if it equals selfId, so an existing self-loop value still matches (no blank).
fn destOptions(ids, selfId, curDst, keyPrefix) {
  let opts = []
  let i = 0
  while (i < ids.length) {
    let id = ids[i]
    if (id !== selfId || id === curDst) {
      opts.push(selOpt(id, id === selfId ? id + " (self)" : id, curDst, keyPrefix + id))
    }
    i = i + 1
  }
  opts.push(selOpt("out", "out", curDst, keyPrefix + "out"))
  opts.push(selOpt("reverb", "reverb", curDst, keyPrefix + "reverb"))
  return opts
}

fn paramOptions(keyPrefix, includeBlank, cur) {
  let opts = []
  if (includeBlank) {
    opts.push(selOpt("", "signal", cur, keyPrefix + "none"))
  }
  let choices = ["gain", "freq", "detune", "q", "pan"]
  let i = 0
  while (i < choices.length) {
    opts.push(selOpt(choices[i], choices[i], cur, keyPrefix + choices[i]))
    i = i + 1
  }
  return opts
}

fn nodeOptions(ids, keyPrefix, cur) {
  let opts = []
  let i = 0
  while (i < ids.length) {
    let id = ids[i]
    opts.push(selOpt(id, id, cur, keyPrefix + id))
    i = i + 1
  }
  return opts
}

// Oscillator wave shape — the same vendored Lucide wave-shape icons the Matrix FM designer uses.
fn patchWaveTiles(nd, edit, accent) {
  let cur = normalizeBasicOscWaveform(nd.wave)
  return WaveIconPicker(cur, (w) => {
    nd.wave = w
    edit.commit()
  }, { accent: accent })
}

fn oscCard(nd, edit, accent) {
  let mode = nd.freqMode === "fixed" ? "fixed" : "note"
  let ratio = numOr(nd.ratio, 1)
  let fixedHz = numOr(nd.fixedHz, 220)
  let detune = numOr(nd.detune, 0)
  let freqCtrl = null
  if (mode === "fixed") {
    freqCtrl = Knob({
      label: "Hz",
      value: freqToSlider(fixedHz),
      min: 0,
      max: 1000,
      step: 1,
      accent: accent,
      fmt: (sl) => String(sliderToFreq(sl)) + " Hz",
      onInput: (sl) => {
        nd.fixedHz = sliderToFreq(sl)
        edit.live()
      },
      onCommit: () => edit.commit()
    })
  } else {
    freqCtrl = Knob({
      label: "Ratio",
      value: Math.round(ratio * 100),
      min: 25,
      max: 1600,
      step: 1,
      accent: accent,
      fmt: (v) => "×" + Number(Math.round(v) / 100).toFixed(2),
      onInput: (v) => {
        nd.ratio = v / 100
        edit.live()
      },
      onCommit: () => edit.commit()
    })
  }
  let modeKnob = Knob({
    label: "Pitch",
    value: mode === "fixed" ? 1 : 0,
    min: 0,
    max: 1,
    step: 1,
    detents: 2,
    accent: accent,
    fmt: (v) => Math.round(v) === 1 ? "Fixed" : "Note",
    onInput: (v) => {
      nd.freqMode = Math.round(v) === 1 ? "fixed" : "note"
      edit.live()
    },
    onCommit: () => edit.commit()
  })

  return (
    <div class="patch-node-body">
      {patchWaveTiles(nd, edit, accent)}
      <div class="ik-knob-grid">
        {modeKnob}
        {freqCtrl}
        {Knob({
          label: "Detune",
          value: Math.round(detune),
          min: -1200,
          max: 1200,
          step: 1,
          accent: accent,
          fmt: (v) => String(Math.round(v)) + "¢",
          onInput: (v) => {
            nd.detune = v
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
        {levelKnob(nd, edit, accent)}
      </div>
    </div>
  )
}

fn filterCard(nd, edit, accent) {
  let q = numOr(nd.q, 0.7)
  let freq = numOr(nd.freq, 1200)
  let ftypeOpts = ["lowpass", "highpass", "bandpass", "notch", "peaking", "lowshelf", "highshelf", "allpass"]
  let ftypeLabels = ["LP", "HP", "BP", "Notch", "Peak", "LoSh", "HiSh", "AP"]
  let curFtype = nd.ftype ? nd.ftype : "lowpass"
  let ftypeIdx = 0
  let fi = 0
  while (fi < ftypeOpts.length) {
    if (ftypeOpts[fi] === curFtype) {
      ftypeIdx = fi
    }
    fi = fi + 1
  }
  return (
    <div class="patch-node-body">
      <div class="ik-knob-grid">
        {Knob({
          label: "Type",
          value: ftypeIdx,
          min: 0,
          max: ftypeOpts.length - 1,
          step: 1,
          detents: ftypeOpts.length,
          accent: accent,
          fmt: (v) => {
            let k = Math.round(v)
            if (k < 0) k = 0
            if (k > ftypeOpts.length - 1) k = ftypeOpts.length - 1
            return ftypeLabels[k]
          },
          onInput: (v) => {
            let k = Math.round(v)
            if (k < 0) k = 0
            if (k > ftypeOpts.length - 1) k = ftypeOpts.length - 1
            nd.ftype = ftypeOpts[k]
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
        {Knob({
          label: "Freq",
          value: freqToSlider(freq),
          min: 0,
          max: 1000,
          step: 1,
          accent: accent,
          fmt: (sl) => String(sliderToFreq(sl)) + " Hz",
          onInput: (sl) => {
            nd.freq = sliderToFreq(sl)
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
        {Knob({
          label: "Q",
          value: Math.round(q * 100),
          min: 1,
          max: 2000,
          step: 1,
          accent: accent,
          fmt: (v) => Number(Math.round(v) / 100).toFixed(2),
          onInput: (v) => {
            nd.q = v / 100
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
        {levelKnob(nd, edit, accent)}
      </div>
    </div>
  )
}

fn shaperCard(nd, edit, accent) {
  let amount = numOr(nd.amount, 50)
  return (
    <div class="patch-node-body">
      <div class="ik-knob-grid">
        {Knob({
          label: "Drive",
          value: Math.round(amount),
          min: 0,
          max: 800,
          step: 1,
          accent: accent,
          fmt: (v) => String(Math.round(v)),
          onInput: (v) => {
            nd.amount = v
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
        {levelKnob(nd, edit, accent)}
      </div>
    </div>
  )
}

fn gainCard(nd, edit, accent) {
  let value = numOr(nd.value, 1)
  return (
    <div class="patch-node-body">
      <div class="ik-knob-grid">
        {Knob({
          label: "Level",
          value: Math.round(value * 100),
          min: 0,
          max: 200,
          step: 1,
          accent: accent,
          fmt: (v) => Number(Math.round(v) / 100).toFixed(2),
          onInput: (v) => {
            nd.value = v / 100
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
      </div>
    </div>
  )
}

fn panCard(nd, edit, accent) {
  let pos = numOr(nd.pos, 0)
  return (
    <div class="patch-node-body">
      <div class="ik-knob-grid">
        {Knob({
          label: "Pan",
          value: Math.round(pos * 100),
          min: -100,
          max: 100,
          step: 1,
          accent: accent,
          fmt: (v) => {
            let p = Math.round(v)
            if (p === 0) {
              return "C"
            }
            return p < 0 ? "L" + String(-p) : "R" + String(p)
          },
          onInput: (v) => {
            nd.pos = v / 100
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
        {levelKnob(nd, edit, accent)}
      </div>
    </div>
  )
}

fn noiseCard(nd, edit, accent) {
  return (
    <div class="patch-node-body">
      <div class="ik-knob-grid">
        {levelKnob(nd, edit, accent)}
      </div>
    </div>
  )
}

// Generic 0..1 knob for a string-node field. Bracket-key assignment (nd[key]=) is intentional — keeps the
// patch-graph param edit out of the anti-spaghetti ratchet's channel-field write pattern and dedups the knobs.
fn stringKnob(nd, key, label, dflt, accent, edit) {
  let val = numOr(nd[key], dflt)
  return Knob({
    label: label,
    value: Math.round(val * 100),
    min: 0,
    max: 100,
    step: 1,
    accent: accent,
    fmt: (v) => String(Math.round(v)),
    onInput: (v) => {
      nd[key] = v / 100
      edit.live()
    },
    onCommit: () => edit.commit()
  })
}

fn stringCard(nd, edit, accent) {
  return (
    <div class="patch-node-body">
      <div class="ik-knob-grid">
        {stringKnob(nd, "tone", "Tone", 0.5, accent, edit)}
        {stringKnob(nd, "damping", "Damping", 0.4, accent, edit)}
        {stringKnob(nd, "decay", "Decay", 0.6, accent, edit)}
        {stringKnob(nd, "mute", "Mute", 0, accent, edit)}
        {levelKnob(nd, edit, accent)}
      </div>
    </div>
  )
}

fn nodeCardBody(nd, edit, accent) {
  if (nd.kind === "osc") {
    return oscCard(nd, edit, accent)
  }
  if (nd.kind === "string") {
    return stringCard(nd, edit, accent)
  }
  if (nd.kind === "filter") {
    return filterCard(nd, edit, accent)
  }
  if (nd.kind === "shaper") {
    return shaperCard(nd, edit, accent)
  }
  if (nd.kind === "gain") {
    return gainCard(nd, edit, accent)
  }
  if (nd.kind === "pan") {
    return panCard(nd, edit, accent)
  }
  return noiseCard(nd, edit, accent)
}

fn kindLabel(kind) {
  if (kind === "osc") {
    return "OSC"
  }
  if (kind === "noise") {
    return "NOISE"
  }
  if (kind === "string") {
    return "STRING"
  }
  if (kind === "filter") {
    return "FILTER"
  }
  if (kind === "shaper") {
    return "SHAPER"
  }
  if (kind === "pan") {
    return "PAN"
  }
  return "GAIN"
}

// One outgoing route (dest · optional param · vol · remove). `dstOpts` lets a self-loop value still match.
fn routeRow(g, cidx, ids, accent, edit) {
  let cn = g.conns[cidx]
  let isNodeDst = cn.dst !== "out" && cn.dst !== "reverb"

  // Build flat destination list: other node ids + out + reverb
  let dstList = []
  let di = 0
  while (di < ids.length) {
    if (ids[di] !== cn.src || ids[di] === cn.dst) {
      dstList.push(ids[di])
    }
    di = di + 1
  }
  dstList.push("out")
  dstList.push("reverb")
  let curDstIdx = 0
  let dfi = 0
  while (dfi < dstList.length) {
    if (dstList[dfi] === cn.dst) {
      curDstIdx = dfi
    }
    dfi = dfi + 1
  }

  let paramList = ["", "gain", "freq", "detune", "q", "pan"]
  let paramLabels = ["sig", "gain", "freq", "det", "Q", "pan"]
  let curParamIdx = 0
  let pfi = 0
  while (pfi < paramList.length) {
    if (paramList[pfi] === (cn.dstParam ? cn.dstParam : "")) {
      curParamIdx = pfi
    }
    pfi = pfi + 1
  }

  let dstKnob = Knob({
    label: "Dst",
    value: curDstIdx,
    min: 0,
    max: dstList.length - 1,
    step: 1,
    detents: dstList.length,
    size: "xs",
    accent: accent,
    fmt: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > dstList.length - 1) k = dstList.length - 1
      return dstList[k]
    },
    onInput: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > dstList.length - 1) k = dstList.length - 1
      let nv = dstList[k]
      g.conns[cidx].dst = nv
      if (nv === "out" || nv === "reverb") {
        g.conns[cidx].dstParam = null
      }
      edit.live()
    },
    onCommit: () => edit.commit()
  })

  let curDstIsNode = cn.dst !== "out" && cn.dst !== "reverb"
  let paramKnob = curDstIsNode ? Knob({
    label: "Param",
    value: curParamIdx,
    min: 0,
    max: paramList.length - 1,
    step: 1,
    detents: paramList.length,
    size: "xs",
    accent: accent,
    fmt: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > paramList.length - 1) k = paramList.length - 1
      return paramLabels[k]
    },
    onInput: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > paramList.length - 1) k = paramList.length - 1
      g.conns[cidx].dstParam = paramList[k] === "" ? null : paramList[k]
      edit.live()
    },
    onCommit: () => edit.commit()
  }) : null

  return (
    <div class="patch-route" id={"pmroute-" + String(cidx)} key={"rt" + String(cidx)}>
      <span class="patch-route-arrow">{"→"}</span>
      {dstKnob}
      {paramKnob}
      <span class="patch-route-vol">
        {Knob({
          label: "Vol",
          value: Math.round(numOr(cn.vol, 1) * 100),
          min: 0,
          max: 200,
          step: 1,
          accent: accent,
          size: "xs",
          fmt: (v) => Number(Math.round(v) / 100).toFixed(2),
          onInput: (v) => {
            g.conns[cidx].vol = v / 100
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
      </span>
      <button
        type="button"
        class="sytrus-icon-btn"
        title={"Remove route"}
        onmousedown={(e) => e.stopPropagation()}
        onclick={() => {
          removePatchConnAt(g, cidx)
          edit.commit()
        }}
      >
        {"×"}
      </button>
    </div>
  )
}

fn inRouteRow(g, cidx, ids, accent, edit) {
  let cn = g.conns[cidx]
  // Build flat source list: other node ids
  let srcList = []
  let di = 0
  while (di < ids.length) {
    if (ids[di] !== cn.dst || ids[di] === cn.src) {
      srcList.push(ids[di])
    }
    di = di + 1
  }
  let curSrcIdx = 0
  let sfi = 0
  while (sfi < srcList.length) {
    if (srcList[sfi] === cn.src) {
      curSrcIdx = sfi
    }
    sfi = sfi + 1
  }

  let srcKnob = Knob({
    label: "Src",
    value: curSrcIdx,
    min: 0,
    max: srcList.length - 1,
    step: 1,
    detents: srcList.length,
    size: "xs",
    accent: accent,
    fmt: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > srcList.length - 1) k = srcList.length - 1
      return srcList[k]
    },
    onInput: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > srcList.length - 1) k = srcList.length - 1
      let nv = srcList[k]
      g.conns[cidx].src = nv
      edit.live()
    },
    onCommit: () => edit.commit()
  })

  return (
    <div class="patch-route" id={"pminroute-" + String(cidx)} key={"inrt" + String(cidx)}>
      {srcKnob}
      <span class="patch-route-arrow">{"→"}</span>
      <span class="patch-route-vol">
        {Knob({
          label: "Vol",
          value: Math.round(numOr(cn.vol, 1) * 100),
          min: 0,
          max: 200,
          step: 1,
          accent: accent,
          size: "xs",
          fmt: (v) => Number(Math.round(v) / 100).toFixed(2),
          onInput: (v) => {
            g.conns[cidx].vol = v / 100
            edit.live()
          },
          onCommit: () => edit.commit()
        })}
      </span>
      <button
        type="button"
        class="sytrus-icon-btn"
        title={"Remove route"}
        onmousedown={(e) => e.stopPropagation()}
        onclick={() => {
          removePatchConnAt(g, cidx)
          edit.commit()
        }}
      >
        {"×"}
      </button>
    </div>
  )
}

// Indices of every conn whose source is this node — its outgoing routes.
fn routeIndicesForSrc(g, srcId) {
  let out = []
  let i = 0
  while (i < g.conns.length) {
    if (g.conns[i].src === srcId) {
      out.push(i)
    }
    i = i + 1
  }
  return out
}

fn routeIndicesForDst(g, dstId) {
  let ins = []
  let i = 0
  while (i < g.conns.length) {
    if (g.conns[i].dst === dstId) {
      ins.push(i)
    }
    i = i + 1
  }
  return ins
}

fn nodeCard(g, nd, ids, accent, edit) {
  let rIdx = routeIndicesForSrc(g, nd.id)
  let routes = []
  let ri = 0
  while (ri < rIdx.length) {
    routes.push(routeRow(g, rIdx[ri], ids, accent, edit))
    ri = ri + 1
  }
  let inIdx = routeIndicesForDst(g, nd.id)
  let inRoutes = []
  let iri = 0
  while (iri < inIdx.length) {
    inRoutes.push(inRouteRow(g, inIdx[iri], ids, accent, edit))
    iri = iri + 1
  }
  let nodeId = nd.id
  return (
    <div class="patch-mod sytrus-op-card" id={"pmnode-" + nd.id} key={"nd" + nd.id}
      onmouseenter={() => setCableHover("node:" + nd.id)}
      onmouseleave={() => setCableHover(null)}>
      <div class="patch-mod-head">
        <span class="patch-mod-badge">{kindLabel(nd.kind)}</span>
        <span class="patch-mod-id">{nd.id}</span>
        <button
          type="button"
          class="sytrus-icon-btn patch-mod-x"
          title={"Remove module"}
          onmousedown={(e) => e.stopPropagation()}
          onclick={() => {
            removePatchNode(g, nodeId)
            edit.commit()
          }}
        >
          {"×"}
        </button>
      </div>
      {nodeCardBody(nd, edit, accent)}
      <div class="patch-mod-routes patch-mod-in-routes">
        {inRoutes.length === 0 ? null : inRoutes}
        <button
          type="button"
          class="patch-route-add"
          title={"Add an input route to this module"}
          onmousedown={(e) => e.stopPropagation()}
          onclick={() => {
            addPatchConnTo(g, nodeId)
            edit.commit()
          }}
        >
          {"+ In"}
        </button>
      </div>
      <div class="patch-mod-routes">
        {routes.length === 0 ? <span class="patch-route-empty">{"not routed"}</span> : routes}
        <button
          type="button"
          class="patch-route-add"
          title={"Add an output route from this module"}
          onmousedown={(e) => e.stopPropagation()}
          onclick={() => {
            addPatchConnFrom(g, nodeId)
            edit.commit()
          }}
        >
          {"Out +"}
        </button>
      </div>
    </div>
  )
}

fn envCard(g, en, eidx, ids, edit) {
  let segRows = []
  let si = 0
  let segTypeOpts = ["set", "lin", "exp"]
  while (si < en.segs.length) {
    let sg = en.segs[si]
    let sidx = si
    let curSegIdx = 0
    let sti = 0
    while (sti < segTypeOpts.length) {
      if (segTypeOpts[sti] === sg.type) {
        curSegIdx = sti
      }
      sti = sti + 1
    }
    let segTypeLabels = ["Set", "Lin", "Exp"]
    segRows.push(
      <div class="patch-seg-row" key={"sg" + eidx + "_" + si}>
        <span class="patch-seg-knob">
          {Knob({
            label: "Seg",
            value: curSegIdx,
            min: 0,
            max: 2,
            step: 1,
            detents: 3,
            size: "xs",
            accent: "#a78bfa",
            fmt: (v) => {
              let k = Math.round(v)
              if (k < 0) k = 0
              if (k > 2) k = 2
              return segTypeLabels[k]
            },
            onInput: (v) => {
              let k = Math.round(v)
              if (k < 0) k = 0
              if (k > 2) k = 2
              g.envs[eidx].segs[sidx].type = segTypeOpts[k]
              edit.live()
            },
            onCommit: () => edit.commit()
          })}
        </span>
        <input
          class="patch-expr"
          type="text"
          value={String(sg.tExpr)}
          title={"time (s) — expr ok: dur, dur-0.1, note"}
          onmousedown={(e) => e.stopPropagation()}
          onchange={(e) => {
            g.envs[eidx].segs[sidx].tExpr = e.target.value
            edit.commit()
          }}
        />
        <input
          class="patch-expr"
          type="text"
          value={String(sg.vExpr)}
          title={"value — expr ok: note, note*2, vel, numbers"}
          onmousedown={(e) => e.stopPropagation()}
          onchange={(e) => {
            g.envs[eidx].segs[sidx].vExpr = e.target.value
            edit.commit()
          }}
        />
        <button
          type="button"
          class="sytrus-icon-btn"
          title={"Remove segment"}
          onmousedown={(e) => e.stopPropagation()}
          onclick={() => {
            removePatchEnvSegAt(g, eidx, sidx)
            edit.commit()
          }}
        >
          {"×"}
        </button>
      </div>
    )
    si = si + 1
  }

  // --- ENV header: node target knob + param knob ---
  let nodeIdx = 0
  let ni = 0
  while (ni < ids.length) {
    if (ids[ni] === en.node) {
      nodeIdx = ni
    }
    ni = ni + 1
  }
  let paramOpts = ["gain", "freq", "detune", "q", "pan"]
  let paramLabels = ["gain", "freq", "det", "Q", "pan"]
  let paramIdx = 0
  let pi = 0
  while (pi < paramOpts.length) {
    if (paramOpts[pi] === (en.param ? en.param : "gain")) {
      paramIdx = pi
    }
    pi = pi + 1
  }
  let nodeKnob = ids.length > 0 ? Knob({
    label: "Node",
    value: nodeIdx,
    min: 0,
    max: ids.length - 1,
    step: 1,
    detents: ids.length,
    size: "xs",
    accent: "#a78bfa",
    fmt: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > ids.length - 1) k = ids.length - 1
      return ids[k]
    },
    onInput: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > ids.length - 1) k = ids.length - 1
      g.envs[eidx].node = ids[k]
      edit.live()
    },
    onCommit: () => edit.commit()
  }) : null
  let paramKnob = Knob({
    label: "Param",
    value: paramIdx,
    min: 0,
    max: paramOpts.length - 1,
    step: 1,
    detents: paramOpts.length,
    size: "xs",
    accent: "#a78bfa",
    fmt: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > paramOpts.length - 1) k = paramOpts.length - 1
      return paramLabels[k]
    },
    onInput: (v) => {
      let k = Math.round(v)
      if (k < 0) k = 0
      if (k > paramOpts.length - 1) k = paramOpts.length - 1
      g.envs[eidx].param = paramOpts[k]
      edit.live()
    },
    onCommit: () => edit.commit()
  })

  return (
    <div class="patch-mod patch-env sytrus-op-card" id={"pmenv-" + String(eidx)} key={"env" + String(eidx)}
      onmouseenter={() => setCableHover("env:" + String(eidx))}
      onmouseleave={() => setCableHover(null)}>
      <div class="patch-mod-head">
        <span class="patch-mod-badge patch-env-badge">{"ENV"}</span>
        <span class="patch-env-target" style={{ display: "flex", alignItems: "center", gap: "2px" }}>
          {nodeKnob}
          <span class="patch-dot">{"."}</span>
          {paramKnob}
        </span>
        <button
          type="button"
          class="sytrus-icon-btn patch-mod-x"
          title={"Remove envelope"}
          onmousedown={(e) => e.stopPropagation()}
          onclick={() => {
            removePatchEnvAt(g, eidx)
            edit.commit()
          }}
        >
          {"×"}
        </button>
      </div>
      <div class="patch-seg-head">
        <span>{"seg"}</span>
        <span>{"t"}</span>
        <span>{"value"}</span>
        <span />
      </div>
      {segRows}
      <button
        type="button"
        class="sytrus-add-btn"
        onmousedown={(e) => e.stopPropagation()}
        onclick={() => {
          addPatchEnvSeg(g, eidx)
          edit.commit()
        }}
      >
        {"+ Seg"}
      </button>
    </div>
  )
}

// Conns whose src is NOT a live node (e.g. hand-written TPL, or a node deleted in the Raw view). Per-card
// routing can't show them, so surface them here so they stay visible + removable (they still emit/play-as-noop).
fn orphanConnRows(g, edit) {
  let rows = []
  let i = 0
  while (i < g.conns.length) {
    let cn = g.conns[i]
    if (!hasNode(g, cn.src)) {
      let cidx = i
      rows.push(
        <div class="patch-route patch-orphan-route" key={"orph" + String(cidx)}>
          <span class="patch-orphan-src">{cn.src}</span>
          <span class="patch-route-arrow">{"→"}</span>
          <span class="patch-orphan-dst">{cn.dst + (cn.dstParam ? "." + cn.dstParam : "")}</span>
          <button
            type="button"
            class="sytrus-icon-btn"
            title={"Remove orphan route"}
            onmousedown={(e) => e.stopPropagation()}
            onclick={() => {
              removePatchConnAt(g, cidx)
              edit.commit()
            }}
          >
            {"×"}
          </button>
        </div>
      )
    }
    i = i + 1
  }
  return rows
}

// ---- Read-only signal-flow cables ----
// An SVG overlay draws a line from each route (a card's output) to its destination card / the OUT sink, so
// the topology is legible at a glance — no drag, purely visual. Paths are computed IMPERATIVELY from measured
// card positions after layout (the vdom can't know pixel positions), re-measured on each render (rAF) + on
// resize/scroll. Colour by kind: green = audio (signal), amber-dashed = modulation (freq/gain/…), blue =
// reaches the OUTPUT. The connectivity for the current panel is stashed in cableState (only one patch panel
// is visible at a time); drawPatchCables no-ops when the host isn't mounted.
let cableState = { conns: [], envs: [], editMode: false }
let cableListenersWired = false
let cableDrawPending = false
// Hover focus for the cable layer — EDIT MODE ONLY (legibility while wiring): null, or "node:<id>" /
// "env:<index>". When set, cables NOT touching the hovered card dim away and the touched ones light up. In View
// mode the cable layer is STATIC (no hover dim/highlight, env cables simply not drawn) — so View reads as a clean
// signal-flow snapshot. Lives outside `project` (pure view state) → no re-render, just a cable repaint.
let cableHover = null

fn setCableHover(h) {
  // Hover focus only applies in Edit mode; in View the cables are static, so don't repaint on hover.
  if (!cableState.editMode) {
    return
  }
  if (cableHover === h) {
    return
  }
  cableHover = h
  scheduleCableDraw()
}

// Pure: a horizontal-biased cubic bezier from (x1,y1) to (x2,y2). Exported for tests.
export fn cablePathD(x1, y1, x2, y2) {
  let dx = Math.abs(x2 - x1) * 0.45
  if (dx < 24) {
    dx = 24
  }
  if (dx > 90) {
    dx = 90
  }
  return "M " + String(Math.round(x1)) + " " + String(Math.round(y1)) +
    " C " + String(Math.round(x1 + dx)) + " " + String(Math.round(y1)) + ", " +
    String(Math.round(x2 - dx)) + " " + String(Math.round(y2)) + ", " +
    String(Math.round(x2)) + " " + String(Math.round(y2))
}

// Pure: classify a connection for colouring. Exported for tests.
export fn cableKindFor(conn) {
  if (conn.dst === "out" || conn.dst === "reverb") {
    return "out"
  }
  if (conn.dstParam) {
    return "mod"
  }
  return "audio"
}

// opacity attr for a cable given the hover focus: full when hovered-and-touched, dim when hovered-and-not, and
// no override (use the class' base opacity) when nothing is hovered.
fn cableOpacityAttr(hovering, touched) {
  if (!hovering) {
    return ""
  }
  if (touched) {
    return " style=\"opacity:1\""
  }
  return " style=\"opacity:0.08\""
}

fn drawPatchCables() {
  cableDrawPending = false
  if (typeof globalThis === "undefined" || globalThis.document == null || typeof globalThis.document.getElementById !== "function") {
    return
  }
  let doc = globalThis.document
  let host = doc.getElementById("patch-cable-host")
  let svg = doc.getElementById("patch-cables")
  if (host == null || svg == null) {
    return
  }
  let hr = host.getBoundingClientRect()
  let editMode = cableState.editMode === true
  // Decode the hover focus once. Hover dim/highlight is EDIT-MODE ONLY — in View the cables are static.
  let hovering = editMode && cableHover != null
  let hoverKind = null
  let hoverId = null
  if (hovering) {
    let sep = cableHover.indexOf(":")
    if (sep >= 0) {
      hoverKind = cableHover.substring(0, sep)
      hoverId = cableHover.substring(sep + 1)
    }
  }
  let conns = cableState.conns
  let parts = ""
  let i = 0
  while (i < conns.length) {
    let cn = conns[i]
    let srcEl = doc.getElementById("pmroute-" + String(i))
    let dstEl = null
    if (cn.dst === "out") {
      dstEl = doc.getElementById("pmsink-out")
    } else if (cn.dst === "reverb") {
      dstEl = doc.getElementById("pmsink-reverb")
    } else {
      dstEl = doc.getElementById("pmnode-" + String(cn.dst))
    }
    if (srcEl != null && dstEl != null) {
      let sr = srcEl.getBoundingClientRect()
      let dr = dstEl.getBoundingClientRect()
      let x1 = sr.right - hr.left
      let y1 = sr.top - hr.top + sr.height / 2
      let x2 = dr.left - hr.left
      let y2 = dr.top - hr.top + dr.height / 2
      let touched = hoverKind === "node" && (cn.src === hoverId || String(cn.dst) === hoverId)
      parts = parts + "<path class=\"patch-cable patch-cable-" + cableKindFor(cn) + "\"" +
        cableOpacityAttr(hovering, touched) + " d=\"" + cablePathD(x1, y1, x2, y2) + "\" />"
    }
    i = i + 1
  }
  // Envelope cables: each ENV card modulates its target node's param. They're the bulk of the clutter, so they
  // are ONLY drawn in EDIT mode (where you're wiring) — never in View. In Edit they're dimmed/lit by hover like
  // any cable. Source RIGHT edge → target LEFT edge (the conn convention).
  let envs = cableState.envs
  let ei = 0
  while (ei < envs.length) {
    let en = envs[ei]
    let touchedByEnv = hoverKind === "env" && String(ei) === hoverId
    let touchedByNode = hoverKind === "node" && String(en.node) === hoverId
    let touched = touchedByEnv || touchedByNode
    if (editMode) {
      let envEl = doc.getElementById("pmenv-" + String(ei))
      let tgtEl = doc.getElementById("pmnode-" + String(en.node))
      if (envEl != null && tgtEl != null) {
        let er = envEl.getBoundingClientRect()
        let tr = tgtEl.getBoundingClientRect()
        let ex1 = er.right - hr.left
        let ey1 = er.top - hr.top + er.height / 2
        let ex2 = tr.left - hr.left
        let ey2 = tr.top - hr.top + tr.height / 2
        parts = parts + "<path class=\"patch-cable patch-cable-mod\"" +
          cableOpacityAttr(hovering, touched) + " d=\"" + cablePathD(ex1, ey1, ex2, ey2) + "\" />"
      }
    }
    ei = ei + 1
  }
  svg.setAttribute("width", String(Math.round(hr.width)))
  svg.setAttribute("height", String(Math.round(hr.height)))
  svg.innerHTML = parts
}

fn scheduleCableDraw() {
  if (cableDrawPending) {
    return
  }
  // Gate via globalThis (always declared) — NOT bare `typeof requestAnimationFrame`: lattish compiles `typeof X`
  // to a form that EVALUATES X, so a bare undeclared global throws ReferenceError under node (headless render).
  if (typeof globalThis === "undefined" || typeof globalThis.requestAnimationFrame !== "function") {
    return
  }
  cableDrawPending = true
  globalThis.requestAnimationFrame(drawPatchCables)
}

fn wirePatchCableListeners() {
  if (cableListenersWired) {
    return
  }
  if (typeof globalThis === "undefined" || typeof globalThis.addEventListener !== "function") {
    return
  }
  cableListenersWired = true
  globalThis.addEventListener("resize", scheduleCableDraw)
  globalThis.addEventListener("scroll", scheduleCableDraw, true)
  // rAF is paused while the tab is hidden, so a panel rendered in the background hasn't drawn yet — redraw
  // when it becomes visible.
  if (globalThis.document != null && typeof globalThis.document.addEventListener === "function") {
    globalThis.document.addEventListener("visibilitychange", scheduleCableDraw)
  }
}

// Owner display name for the read-only banner.
fn trackOwnerName(project, channelId) {
  if (project.coDjMeta && project.coDjMeta.tracks && project.coDjMeta.tracks[channelId]) {
    let o = project.coDjMeta.tracks[channelId].ownerActorId
    if (o != null && String(o).length > 0) {
      return String(o)
    }
  }
  return "another player"
}

// mayEdit gates authoring: when false (a co-DJ track you don't own / a master-locked track) the editor is
// read-only — liveEdit/commitEdit no-op (no local mutation persisted, no broadcast), the palette is inert,
// and the cards get `instr-readonly` (pointer-events:none) so no control can fire. Prevents the optimistic-
// local-vs-rejected-broadcast divergence (the gated ingest door would reject a non-owner's edit anyway).
export fn PatchGraphPanel(ch, project, setProject, rt, mayEdit) {
  let canEdit = mayEdit !== false
  if (
    !ch.generatorSpec ||
    ch.generatorSpec.kind !== "patch" ||
    !ch.generatorSpec.raw ||
    ch.generatorSpec.raw.length === 0
  ) {
    ch.generatorSpec = parseGenBlock("patch", defaultPatchRawLines())
    setProject(project)
  }
  let spec = ch.generatorSpec
  let g = spec.graph
  if (!g.nodes) {
    g.nodes = []
  }
  if (!g.conns) {
    g.conns = []
  }
  if (!g.envs) {
    g.envs = []
  }

  // Undo snapshot of the gen_block as it stood BEFORE the current edit. Re-synced to the live state on every
  // AT-REST render (so it tracks undo/redo/peer changes), but FROZEN while a knob is dragging (so the captured
  // "before" is the pre-drag value, not a mid-drag one). commitEdit reads it as the undo inverse.
  if (rt && canEdit) {
    if (!rt._genSnap) {
      rt._genSnap = {}
    }
    if (!isKnobDragging()) {
      rt._genSnap[ch.id] = emitInstrumentModuleTpl(project, ch.id, "gen")
    }
  }

  fn liveEdit() {
    if (!canEdit) {
      return
    }
    syncPatchSpecFromGraph(spec)
    setProject(project)
  }
  fn commitEdit() {
    if (!canEdit) {
      return
    }
    // Capture the inverse (pre-edit gen_block) BEFORE setProject re-renders + re-syncs the snapshot.
    let inv = (rt && rt._genSnap) ? rt._genSnap[ch.id] : null
    syncPatchSpecFromGraph(spec)
    setProject(project)
    // Broadcast the whole gen_block through the gated `gen` ingest door — reaches peers + round-trips +
    // MERGES (preserves steps/mix) + is UNDOABLE (inverse = the pre-edit block). Immediate (no debounce):
    // commit only fires at a settle point (knob onCommit / discrete edit), so the generatorSpec swap never
    // lands inside an in-flight knob drag.
    let fwd = emitInstrumentModuleTpl(project, ch.id, "gen")
    if (rt && rt.directiveUndoable) {
      // Unique per-gesture token → each edit is its own undo step (not one coarse per-channel step).
      if (rt._genTokenSeq == null) {
        rt._genTokenSeq = 0
      }
      rt._genTokenSeq = rt._genTokenSeq + 1
      rt.directiveUndoable(fwd, inv, "genblock:" + ch.id + ":" + String(rt._genTokenSeq))
    } else if (rt && rt.directive) {
      rt.directive(fwd)
    }
  }
  fn addMod(kind) {
    if (!canEdit) {
      return
    }
    let newId = addPatchNode(g, kind)
    let isProcessor = kind === "filter" || kind === "shaper" || kind === "gain" || kind === "pan"
    if (isProcessor) {
      // Splice into chain: find the last audio conn → out and reroute through the new node
      let spliced = false
      let ci = g.conns.length - 1
      while (ci >= 0 && !spliced) {
        let cn = g.conns[ci]
        if (cn.dst === "out" && (cn.dstParam == null || cn.dstParam === "")) {
          // Reroute: source → newNode instead of source → out
          cn.dst = newId
          cn.dstParam = null
          spliced = true
        }
        ci = ci - 1
      }
      // New node → out
      g.conns.push({ src: newId, dst: "out", dstParam: null, vol: 1 })
    } else {
      // Source nodes (osc/noise/string) just route to out
      g.conns.push({ src: newId, dst: "out", dstParam: null, vol: 1 })
    }
    commitEdit()
  }
  fn addEnvMod() {
    if (!canEdit) {
      return
    }
    addPatchEnv(g)
    commitEdit()
  }
  let edit = { live: liveEdit, commit: commitEdit }

  // View ↔ Edit: default to a clean read-only flow (cards + cables, no route dropdowns/× / palette); Edit
  // reveals the wiring chrome. A non-owner is always in View (canEdit gates it). The mode is a transient view
  // pref on rt (not the document). The chrome is hidden via the root `patch-view`/`patch-edit` class in CSS.
  let editMode = canEdit && rt != null && rt.patchEditMode === true
  fn setPatchEditMode(on) {
    if (rt != null) {
      rt.patchEditMode = on
    }
    setProject(project)
  }

  let ids = nodeIdList(g)
  let accent = accentForGenerator(ch.generatorId)

  // Order nodes by signal-flow stage (sources → … → out), then masonry-pack them: CSS multi-column lays the
  // cards out IN ORDER (filling columns left→right), so we keep the rough left-to-right signal flow AND fill the
  // vertical whitespace that rigid stage-columns left under shorter cards. Envelopes get their own wider row.
  let stages = patchSignalStages(g)
  let orderedNodeCards = []
  let sci = 0
  while (sci < stages.length) {
    let colNodes = stages[sci]
    let cni = 0
    while (cni < colNodes.length) {
      orderedNodeCards.push(nodeCard(g, colNodes[cni], ids, accent, edit))
      cni = cni + 1
    }
    sci = sci + 1
  }

  let envCards = []
  let ei = 0
  while (ei < g.envs.length) {
    envCards.push(envCard(g, g.envs[ei], ei, ids, edit))
    ei = ei + 1
  }

  let orphans = orphanConnRows(g, edit)

  let durIsSet = g.dur != null
  let durVal = durIsSet ? Number(g.dur) : 0.5
  let ownerName = trackOwnerName(project, ch.id)

  let usesReverb = false
  let urc = 0
  while (urc < g.conns.length) {
    if (g.conns[urc].dst === "reverb") {
      usesReverb = true
    }
    urc = urc + 1
  }
  // Hand the current connectivity to the imperative cable layer + schedule a re-measure after this paint.
  cableState.conns = g.conns
  cableState.envs = g.envs
  cableState.editMode = editMode
  scheduleCableDraw()
  wirePatchCableListeners()

  return (
    <div class={editMode ? "sytrus-panel patch-panel patch-edit" : "sytrus-panel patch-panel patch-view"}>
      <div class="sytrus-panel-head">
        <span class="sytrus-panel-title">{"PATCH"}</span>
        <span class="sytrus-panel-sub">{editMode ? "modules · wire each output" : "modules · signal flow"}</span>
        {canEdit ? (
          <span class="patch-mode-toggle">
            <button type="button" class={editMode ? "imt-btn" : "imt-btn imt-on"} onmousedown={(e) => e.stopPropagation()} onclick={() => setPatchEditMode(false)}>{"View"}</button>
            <button type="button" class={editMode ? "imt-btn imt-on" : "imt-btn"} onmousedown={(e) => e.stopPropagation()} onclick={() => setPatchEditMode(true)}>{"Edit"}</button>
          </span>
        ) : null}
        {canEdit ? null : <span class="instr-lock-tag">{"read only"}</span>}
      </div>

      {canEdit ? null : (
        <div class="instr-locked-hint">{"🔒 owned by " + ownerName + " — read only"}</div>
      )}

      <div class={canEdit ? "patch-edit-region" : "patch-edit-region instr-readonly"}>
      <div class="patch-palette">
        <span class="patch-palette-label">{"Add module"}</span>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("osc")}>{"Osc"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("noise")}>{"Noise"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("string")}>{"String"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("filter")}>{"Filter"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("shaper")}>{"Shaper"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("gain")}>{"Gain"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addMod("pan")}>{"Pan"}</button>
        <button type="button" class="sytrus-add-btn" onmousedown={(e) => e.stopPropagation()} onclick={() => addEnvMod()}>{"Env"}</button>
      </div>

      {g.nodes.length === 0 && g.envs.length === 0 ? (
        <p class="sytrus-empty">{"Add a module to start the patch. Wire each module's output to the next, ending at out."}</p>
      ) : (
        <div class="patch-mod-grid" id="patch-cable-host">
          <svg id="patch-cables" class="patch-cables" />
          <div class="patch-node-masonry">
            {orderedNodeCards}
            {envCards}
            <div class="patch-mod sytrus-op-card" key="voicelen">
              <div class="patch-mod-head">
                <span class="patch-mod-badge">{"VOICE"}</span>
                <span class="patch-mod-id">{"length"}</span>
              </div>
              <div class="patch-node-body">
                <div class="ik-knob-grid">
                  {Knob({
                    label: "Length",
                    value: durIsSet ? Math.round(durVal * 1000) : 0,
                    min: 0,
                    max: 2000,
                    step: 1,
                    accent: accent,
                    fmt: (v) => Math.round(v) === 0 ? "Auto" : String(Math.round(v)) + " ms",
                    onInput: (v) => {
                      if (Math.round(v) === 0) {
                        g.dur = null
                      } else {
                        g.dur = v / 1000
                      }
                      liveEdit()
                    },
                    onCommit: () => commitEdit()
                  })}
                </div>
              </div>
            </div>
            <div class="patch-sink patch-sink-out" id="pmsink-out" key="pmsink-out">
              <span class="patch-sink-label">{"▶ OUT"}</span>
            </div>
            {usesReverb ? (
              <div class="patch-sink patch-sink-rev" id="pmsink-reverb" key="pmsink-reverb">
                <span class="patch-sink-label">{"REVERB"}</span>
              </div>
            ) : null}
          </div>
        </div>
      )}

      {orphans.length > 0 ? (
        <section class="sytrus-section patch-orphans">
          <div class="sytrus-section-h">
            <span>{"Unrouted connections"}</span>
          </div>
          <p class="sytrus-hint">{"These route from a module that no longer exists. Remove them or re-add the module."}</p>
          <div class="sytrus-routes">{orphans}</div>
        </section>
      ) : null}
      </div>
    </div>
  )
}
