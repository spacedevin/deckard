import { h, Fragment } from '@tishlang/lattish'
import {
  ensureProjectSession,
  findClipOnChannel,
  defaultMainClipId,
  sceneSlotClipId,
  sessionQueueScene,
  sessionStopAllTracks,
  sessionStopTrack,
  sessionTrackStopped,
  sceneFollow,
  setSceneFollow,
  addSessionProgram,
  removeSessionProgram
} from '../model/Session.tish'
import { IkSelect, LucideIcon } from './InstrumentKit.tish'
import { channelDeck, channelDeckColor } from '../model/DeckRouting.tish'
import { coDjOwnDeckLetter } from '../codj/Transport.tish'
import { launchClipDirective, launchClipStopDirective, cueDirective } from '../codj/Launch.tish'
import { singleNotePitch } from './grid/StepGrid.tish'
import { pitchWindow } from './grid/PianoGrid.tish'

// Broadcast a session-control directive to collaborators, if connected (no-op offline).
fn pushControl(rt, line) {
  if (rt && rt.coDjPushControl) {
    let step = rt.nextLaunchStep ? rt.nextLaunchStep() : 0
    rt.coDjPushControl([line], step)
  }
}

// Session clips follow the deck colour of their channel — same scheme as the sequencer / deck
// (Deck A = cyan, Deck B = magenta) so the whole app reads as one colour system.
fn deckSuffix(project, ch) {
  return channelDeckColor(project, ch)
}

// Deterministic amplitude envelope (0..1 per column) computed from a clip's content — drum steps
// become decaying transients, piano notes become sustained blocks. Drives the clip waveform preview.
fn clipEnvelope(clip) {
  let N = 60
  let env = []
  let z = 0
  while (z < N) {
    env.push(0)
    z = z + 1
  }
  if (!clip) {
    return env
  }
  let steps = clip.steps
  let span = steps && steps.length >= 16 ? steps.length : 16
  let notes = clip.pianoNotes
  if (notes && notes.length > 0) {
    let i = 0
    while (i < notes.length) {
      let n = notes[i]
      let vel = n.vel !== null && n.vel !== undefined ? n.vel / 127 : 0.8
      let startCol = (n.startBeat * 4 / span) * N
      let lenCol = (n.durBeats * 4 / span) * N
      if (lenCol < 1) {
        lenCol = 1
      }
      let k = Math.floor(startCol)
      if (k < 0) {
        k = 0
      }
      while (k < N) {
        let rel = k - startCol
        if (rel > lenCol) {
          break
        }
        if (rel >= 0) {
          let frac = rel / lenCol
          let a = vel * (0.6 + 0.4 * (1 - frac))
          if (a > env[k]) {
            env[k] = a
          }
        }
        k = k + 1
      }
      i = i + 1
    }
  } else if (steps) {
    let tail = N / 7
    if (tail < 3) {
      tail = 3
    }
    let i = 0
    while (i < steps.length) {
      let st = steps[i]
      if (st && st.on) {
        let vel = st.vel !== null && st.vel !== undefined ? st.vel / 127 : 0.85
        let center = (i / span) * N
        let k = Math.floor(center)
        if (k < 0) {
          k = 0
        }
        while (k < N) {
          let d = k - center
          if (d >= -0.5) {
            let a = vel * (1 - d / tail)
            if (a <= 0) {
              break
            }
            if (a > env[k]) {
              env[k] = a
            }
          }
          k = k + 1
        }
      }
      i = i + 1
    }
  }
  return env
}

// Mirror the envelope into a closed SVG path (viewBox 0 0 120 24, baseline at y=12).
fn clipWavePath(env) {
  let N = env.length
  let W = 120
  let mid = 12
  let amp = 10.5
  let d = "M0 " + String(mid)
  let i = 0
  while (i < N) {
    let x = Math.round((i / (N - 1)) * W)
    let y = Math.round(mid - env[i] * amp)
    d = d + " L" + String(x) + " " + String(y)
    i = i + 1
  }
  let j = N - 1
  while (j >= 0) {
    let x = Math.round((j / (N - 1)) * W)
    let y = Math.round(mid + env[j] * amp)
    d = d + " L" + String(x) + " " + String(y)
    j = j - 1
  }
  return d + " Z"
}

export fn SessionTrackRow(project, ch, tix, activeDeck, rt, sc, playing, bumpSessionUi, setProjectFromUI, armCell, toggleClipDisabled, queueMute, stopTrack, canLaunchDeck, canEditDeck) {
  if (activeDeck !== null && activeDeck !== undefined && channelDeck(project, ch) !== activeDeck) {
    return []
  }
  // Multiplayer per-deck control: clip launch/stop needs launch rights (own deck or host); only the deck owner
  // may edit. Default true (solo) when the flags aren't supplied.
  let mayLaunch = canLaunchDeck === null || canLaunchDeck === undefined || canLaunchDeck === true
  let mayEdit = canEditDeck === null || canEditDeck === undefined || canEditDeck === true
  let muted = ch.mute === true
  let stopped = sessionTrackStopped(rt, tix)
  let cells = []
  let sj = 0
  while (sj < sc) {
    let slotClipId = ""
    if (project.session.slots[tix] && project.session.slots[tix][sj] !== undefined) {
      slotClipId = project.session.slots[tix][sj]
    }
    let isDefaultClip = slotClipId === defaultMainClipId(ch)
    let clip = null
    if (slotClipId && slotClipId.length > 0 && !isDefaultClip) {
      clip = findClipOnChannel(ch, slotClipId)
    }
    let armed = ""
    if (rt.sessionArmedClipIds && rt.sessionArmedClipIds[tix] !== undefined) {
      armed = rt.sessionArmedClipIds[tix]
    }
    let queued = ""
    if (rt.sessionQueuePending && rt.sessionQueuedClipIds && rt.sessionQueuedClipIds[tix] !== undefined) {
      queued = rt.sessionQueuedClipIds[tix]
    }
    let isTrackPending = false
    if (rt.trackPending && slotClipId.length > 0) {
      let qp = 0
      while (qp < rt.trackPending.length) {
        if (rt.trackPending[qp].t === tix && rt.trackPending[qp].clip === slotClipId) {
          isTrackPending = true
        }
        qp = qp + 1
      }
    }
    let isQueued = (rt.sessionQueuePending && slotClipId.length > 0 && queued === slotClipId) || isTrackPending
    let isPlaying = playing && !muted && armed === slotClipId && slotClipId.length > 0
    let sjCopy = sj
    let clipIdCopy = slotClipId
    if (!clip) {
      cells.push(
        <div class="session-cell session-cell-empty" key={"c-" + String(tix) + "-" + String(sj)}>
          <span class="session-cell-dash">{"—"}</span>
        </div>
      )
    } else {
      let bars = clip.bars !== null && clip.bars !== undefined ? Math.floor(Number(clip.bars)) : 1
      if (bars < 1 || bars !== bars) { bars = 1 }
      let dsuf = deckSuffix(project, ch)
      let isDisabled = rt.sessionDisabledClips && rt.sessionDisabledClips[slotClipId] === true
      let cellCls = "session-cell session-cell-deck-" + dsuf
      if (isPlaying) { cellCls = cellCls + " session-cell-playing" }
      if (isQueued) { cellCls = cellCls + " session-cell-queued" }
      if (isDisabled) { cellCls = cellCls + " session-cell-disabled" }
      if (!mayLaunch) { cellCls = cellCls + " session-cell-locked" }
      let wavePath = clipWavePath(clipEnvelope(clip))
      let cellTitle = isDisabled ? "SKIPPED — this clip won't play. Left-click (or right-click again) to re-enable." : "Launch this clip — drops on the next launch-quantize boundary (Q in the transport). Right-click to skip just this clip."
      if (!mayLaunch) {
        cellTitle = "This deck belongs to another player — you can't launch their clips."
      }
      cells.push(
        <button
          type="button"
          class={cellCls}
          key={"c-" + String(tix) + "-" + String(sj)}
          disabled={!mayLaunch}
          onclick={() => armCell(tix, clipIdCopy)}
          oncontextmenu={(e) => { e.preventDefault(); if (mayEdit) { toggleClipDisabled(clipIdCopy) } }}
          title={cellTitle}
        >
          <svg class="session-wave" viewBox="0 0 120 24" preserveAspectRatio="none">
            <path class={"session-wave-fill session-wave-" + dsuf} d={wavePath} />
          </svg>
          <span class="session-cell-meta">
            {isPlaying ? "■" : "▶"}{" · "}{String(bars)}{" bar"}{bars === 1 ? "" : "s"}
          </span>
        </button>
      )
    }
    sj = sj + 1
  }
  // Play/pause (mute) and the SYNC/STORE link live in the instrument UI — the session row is just a clip
  // launcher: a name label (shown only when stacked; the aligned SEQ labels the row side-by-side) + a clip
  // stop + the clip cells.
  let stopCls = stopped ? "session-track-stop session-track-stop-on" : "session-track-stop"
  let outRows = []
  outRows.push(
    <div class="session-track-row" key={"row-" + String(tix)}>
      <span class="session-track-name session-track-label" title={ch.name}>
        <span class="session-track-txt">{ch.name}</span>
      </span>
      <button
        type="button"
        class={stopCls}
        disabled={!mayLaunch}
        title={mayLaunch ? (ch.name + ": stop this track's clip (instant) — silent until you launch a clip") : "Another player's deck — you can't control their clips."}
        onclick={() => stopTrack(tix)}
      >
        {"■"}
      </button>
      <div class="session-cells">{cells}</div>
    </div>
  )

  // The piano roll, per-step locks, per-note locks, automation lane AND lyrics are ALL full-panel TAKEOVERS in
  // the sequencer now — none push inline rows there, so the sequencer never grows and the session needs NO
  // matching spacer rows (a spacer here would push the clip rows DOWN and misalign them). The vocal-lyric lane
  // used to expand inline + keep a spacer here; it's now its own LYRICS takeover, so that spacer is gone too.

  return outRows
}

export fn SessionView(project, rt, setProjectFromUI, playing, bumpSessionUi, patternBank, headerRight, activeDeck) {
  ensureProjectSession(project)
  let sc = project.session.sceneCount
  let activeScene = 0
  if (rt.sessionActiveScene !== undefined && rt.sessionActiveScene !== null) {
    activeScene = Math.floor(Number(rt.sessionActiveScene))
  }
  if (activeScene < 0 || activeScene >= sc) {
    activeScene = 0
  }

  // ---- Per-deck session control (multiplayer). The grid is deck-filtered to `activeDeck`, so we gate by the
  // deck currently in view. myDeck = my own deck letter (null when solo / not connected → unrestricted).
  //   EDIT (add/remove program, save clip, skip clip, mute, follow rules) → only on MY OWN deck.
  //   PLAY/LAUNCH (launch clip/scene, stop, cue)                          → my own deck, OR the HOST on ANY deck.
  // "Each player controls their deck; the host can only PLAY the clients' sessions."
  let myDeck = coDjOwnDeckLetter(rt)
  let amHost = rt && rt.coDjIsHost === true
  let canEditDeck = myDeck === null || activeDeck === null || activeDeck === undefined || activeDeck === myDeck
  let canLaunchDeck = canEditDeck || amHost

  fn bumpSeqIfPlaying() {
    if (playing && rt.bumpSeqPromoteUi) {
      rt.bumpSeqPromoteUi()
    }
  }

  // CUE this scene to the private preview (audition; peers hear nothing until a THROW). Toggles: clicking the
  // already-cued scene un-cues it. Routes @ cue / @ cue off through ingest → applyLaunchDirective.
  fn onCueScene(si) {
    if (!canLaunchDeck) {
      return
    }
    if (rt && rt.directive) {
      if (rt.cueScene !== null && rt.cueScene !== undefined && Math.floor(Number(rt.cueScene)) === si) {
        rt.directive(cueDirective("off"))
      } else {
        rt.directive(cueDirective(si))
      }
    }
  }

  fn armScene(si) {
    if (!canLaunchDeck) {
      return
    }
    sessionQueueScene(project, rt, si)
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    bumpSeqIfPlaying()
    setProjectFromUI(project)
  }

  // Per-track clip launch — click a clip to play just that track's clip, holding it across the song's
  // auto-advance. Click the same clip again to release that track back to following the song.
  // Right-click a session cell to SKIP just that clip item (reddish border): it won't play when its scene/
  // clip is launched, until it's re-enabled. Per ITEM (clip id), not per track. Toggle.
  fn toggleClipDisabled(clipId) {
    if (!canEditDeck) {
      return
    }
    if (!clipId || clipId.length === 0) {
      return
    }
    if (!rt.sessionDisabledClips) {
      rt.sessionDisabledClips = {}
    }
    if (rt.sessionDisabledClips[clipId] === true) {
      rt.sessionDisabledClips[clipId] = false
    } else {
      rt.sessionDisabledClips[clipId] = true
    }
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    bumpSeqIfPlaying()
    setProjectFromUI(project)
  }

  fn armCell(trackIdx, clipId) {
    if (!canLaunchDeck) {
      return
    }
    // Launching a clip re-enables it ("won't play unless clicked again").
    if (clipId && clipId.length > 0 && rt.sessionDisabledClips && rt.sessionDisabledClips[clipId] === true) {
      rt.sessionDisabledClips[clipId] = false
    }
    if (!rt.trackOverrides) {
      rt.trackOverrides = []
    }
    let cur = rt.trackOverrides[trackIdx] !== null && rt.trackOverrides[trackIdx] !== undefined ? rt.trackOverrides[trackIdx] : null
    let next = cur === clipId ? null : clipId
    rt.trackOverrides[trackIdx] = next
    // The clip this track should land on: the override, or (on release) the current song scene's clip.
    let scene = rt.songScene !== null && rt.songScene !== undefined ? rt.songScene : (rt.sessionActiveScene !== null && rt.sessionActiveScene !== undefined ? rt.sessionActiveScene : 0)
    let target = next !== null && next !== undefined ? next : sceneSlotClipId(project, scene, trackIdx)
    if (rt.playing && rt.playMode === "song") {
      // Already live — land on the next bar without restarting the song chain.
      if (!rt.trackPending) {
        rt.trackPending = []
      }
      rt.trackPending.push({ t: trackIdx, clip: target })
    } else if (rt.sessionArmedClipIds) {
      rt.sessionArmedClipIds[trackIdx] = target
    }
    // Collaborators follow this per-track launch (owner-scoped on their side). next == null = release.
    pushControl(rt, launchClipDirective(project.channels[trackIdx].id, next !== null && next !== undefined ? next : ""))
    // Launching a clip when nothing is live goes LIVE — the override is applied on start, so you hear it.
    if (next !== null && next !== undefined && !rt.playing && rt.onPlaySong) {
      rt.onPlaySong()
    }
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    bumpSeqIfPlaying()
    setProjectFromUI(project)
  }

  // Tapping a track name toggles its mute — instantly, whether playing or stopped (no queued state).
  fn queueMute(trackIdx) {
    if (!canEditDeck) {
      return
    }
    let ch = project.channels[trackIdx]
    ch.mute = !(ch.mute === true)
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    bumpSeqIfPlaying()
    setProjectFromUI(project)
  }

  // The ■ button stops just this track's clip — silent until a clip / scene is launched again. Instant.
  fn stopTrack(trackIdx) {
    if (!canLaunchDeck) {
      return
    }
    sessionStopTrack(project, rt, trackIdx)
    pushControl(rt, launchClipStopDirective(project.channels[trackIdx].id))
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    bumpSeqIfPlaying()
    setProjectFromUI(project)
  }

  // ---- Follow actions: per-scene "then →" rule with a deterministic A/B chance ratio. Writing it is
  // master/project state, so it streams to collaborators via the normal project sync.
  fn applyFollow(si, a, wa, b, wb) {
    if (!canEditDeck) {
      return
    }
    setSceneFollow(project, si, a, wa, b, wb)
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    setProjectFromUI(project)
  }
  fn onFollowA(si, val) {
    let f = sceneFollow(project, si)
    applyFollow(si, val, f ? f.wa : 1, f ? f.b : null, f ? f.wb : 0)
  }
  fn onFollowB(si, val) {
    let f = sceneFollow(project, si)
    let a = f ? f.a : "repeat"
    let wa = f && f.wa !== null && f.wa !== undefined && f.b !== null && f.b !== undefined ? f.wa : 50
    let wb = f && f.b !== null && f.b !== undefined ? f.wb : 50
    applyFollow(si, a, wa, val, wb)
  }
  // Toggle the weighted second action on/off (progressive disclosure of the chance ratio).
  fn toggleFollowB(si) {
    let f = sceneFollow(project, si)
    if (f !== null && f !== undefined && f.b !== null && f.b !== undefined) {
      applyFollow(si, f.a, 1, null, 0)
    } else {
      applyFollow(si, f ? f.a : "repeat", 50, "next", 50)
    }
  }
  fn onFollowChance(si, pct) {
    let f = sceneFollow(project, si)
    if (!f || f.b === null || f.b === undefined) {
      return
    }
    let p = Math.floor(Number(pct))
    if (p < 0) { p = 0 }
    if (p > 100) { p = 100 }
    applyFollow(si, f.a, p, f.b, 100 - p)
  }
  // Short, readable labels (full text fits a full-width select; glyphs alone were illegible when tiny).
  fn followOptions() {
    let list = [["repeat", "↻ Loop"], ["next", "→ Next"], ["prev", "← Prev"], ["first", "⏮ First"], ["last", "⏭ Last"], ["any", "✦ Any"], ["stop", "■ Stop"]]
    let opts = []
    let i = 0
    while (i < list.length) {
      opts.push({ value: list[i][0], label: list[i][1] })
      i = i + 1
    }
    return opts
  }
  fn followRow(si) {
    let f = sceneFollow(project, si)
    // No entry → the scene loops (the Ableton default), shown as "Loop".
    let aVal = f ? f.a : "repeat"
    let hasB = f !== null && f !== undefined && f.b !== null && f.b !== undefined
    let total = f ? (Number(f.wa) + Number(f.wb)) : 1
    let pctA = hasB && total > 0 ? Math.round(Number(f.wa) / total * 100) : 100
    let bVal = hasB ? f.b : "next"
    let mixCls = hasB ? "follow-mix follow-mix-on" : "follow-mix"
    let line2 = null
    if (hasB) {
      line2 = (
        <div class="follow-line2" title={"The rest of the time, do this instead (weighted chance)"}>
          <span class="follow-else">{"↳"}</span>
          {IkSelect({
            class: "follow-sel follow-sel-b",
            value: bVal,
            options: followOptions(),
            onChange: (v) => onFollowB(si, v)
          })}
          <input type="number" class="follow-pct" min="0" max="100" value={String(100 - pctA)} oninput={(e) => onFollowChance(si, 100 - Number(e.target.value))} title={"Chance of this second action"} />
          <span class="follow-pct-sign">{"%"}</span>
        </div>
      )
    }
    return (
      <div class="session-scene-follow" title={"After this pattern plays, do this. Add a weighted second action (⚖) for a deterministic chance (seeded — same for every player)."}>
        <div class="follow-line1">
          {IkSelect({
            class: "follow-sel",
            value: aVal,
            options: followOptions(),
            onChange: (v) => onFollowA(si, v)
          })}
          <button type="button" class={mixCls} title={hasB ? "Remove the weighted second action" : "Add a weighted second action (chance ratio)"} onclick={() => toggleFollowB(si)}>
            {"⚖"}
          </button>
        </div>
        {line2}
      </div>
    )
  }

  fn stopAll() {
    if (!canLaunchDeck) {
      return
    }
    sessionStopAllTracks(project, rt)
    rt.trackOverrides = []
    rt.trackPending = []
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    bumpSeqIfPlaying()
    setProjectFromUI(project)
  }

  // Add / remove a PROGRAM (a scene = a P-column). Mirrors the rack's BARS stepper.
  fn addProgram() {
    if (!canEditDeck) {
      return
    }
    addSessionProgram(project)
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    setProjectFromUI(project)
  }
  fn removeProgram() {
    if (!canEditDeck) {
      return
    }
    removeSessionProgram(project)
    if (bumpSessionUi) {
      bumpSessionUi()
    }
    setProjectFromUI(project)
  }

  let sceneHeaders = []
  let sh = 0
  while (sh < sc) {
    let si = sh
    let hdrCls = "session-scene-head"
    if (si === activeScene) {
      hdrCls = hdrCls + " session-scene-head-active"
    }
    if (
      rt.sessionQueuePending &&
      rt.sessionQueuedScene !== undefined &&
      rt.sessionQueuedScene !== null &&
      Math.floor(Number(rt.sessionQueuedScene)) === si
    ) {
      hdrCls = hdrCls + " session-scene-head-queued"
    }
    // Scene header carries the merged pattern controls: LOAD (edit) · SAVE (rack → pattern) · LAUNCH.
    // LAUNCH sits inline in the top row (P[X] · LAUNCH · CUE); the load/save ops stay below in headOps.
    let pb = patternBank
    let headOps = null
    let launchBtn = null
    if (pb && pb.onLaunch) {
      let isEditing = pb.editingScene !== null && pb.editingScene !== undefined && Math.floor(Number(pb.editingScene)) === si
      let isLive = pb.liveScene !== null && pb.liveScene !== undefined && Math.floor(Number(pb.liveScene)) === si
      let isQueuedLaunch =
        pb.queuePending && pb.queuedScene !== null && pb.queuedScene !== undefined && Math.floor(Number(pb.queuedScene)) === si
      let launchLabel = "LAUNCH"
      if (isQueuedLaunch) {
        if (pb.dropSteps !== null && pb.dropSteps !== undefined) {
          launchLabel = pb.dropSteps === 0 ? "● NOW" : "◷ " + String(pb.dropSteps)
        } else {
          launchLabel = "◷ QUEUED"
        }
      }
      let loadOn = isEditing ? " btn-scene-on" : ""
      let launchCls = isLive ? "btn-scene-op btn-scene-launch btn-scene-on" : "btn-scene-op btn-scene-launch"
      let loadCls = "btn-scene-op btn-scene-load" + loadOn
      let sceneI = si
      let barN = pb.viewBar !== null && pb.viewBar !== undefined ? Math.floor(Number(pb.viewBar)) + 1 : 1
      let totalBars = pb.bars !== null && pb.bars !== undefined && Math.floor(Number(pb.bars)) >= 1 ? Math.floor(Number(pb.bars)) : 1
      launchBtn = (
        <button type="button" class={launchCls} disabled={!canLaunchDeck} onclick={() => { if (canLaunchDeck) { pb.onLaunch(sceneI) } }} title={canLaunchDeck ? "Launch this pattern live (queues to the next bar while a song plays)" : "Another player's deck — only its owner (or the host) can play it."}>
          {launchLabel}
        </button>
      )
      headOps = (
        <div class="session-scene-ops">
          <div class="session-scene-oprow">
            <button type="button" class={loadCls + " btn-scene-op-icon"} onclick={() => pb.onLoadBar(sceneI)} title={"Load only bar " + String(barN) + " (the bar you're viewing) — other bars untouched"}>
              {LucideIcon("folder-open")}<span class="op-barnum">{"1"}</span>
            </button>
            <button type="button" class={loadCls + " btn-scene-op-icon"} onclick={() => pb.onLoad(sceneI)} title={"Load all " + String(totalBars) + " bars of this pattern into the rack"}>
              {LucideIcon("folder-open")}<span class="op-barnum">{String(totalBars)}</span>
            </button>
          </div>
          <div class="session-scene-oprow">
            <button type="button" class="btn-scene-op btn-scene-save btn-scene-op-icon" disabled={!canEditDeck} onclick={() => { if (canEditDeck) { pb.onSaveBar(sceneI) } }} title={canEditDeck ? ("Save only bar " + String(barN) + " (the bar you're viewing) into this pattern") : "Another player's deck — only its owner can save clips to it."}>
              {LucideIcon("save")}<span class="op-barnum">{"1"}</span>
            </button>
            <button type="button" class="btn-scene-op btn-scene-save btn-scene-op-icon" disabled={!canEditDeck} onclick={() => { if (canEditDeck) { pb.onSave(sceneI) } }} title={canEditDeck ? ("Save the whole rack (all " + String(totalBars) + " bars) into this pattern") : "Another player's deck — only its owner can save clips to it."}>
              {LucideIcon("save")}<span class="op-barnum">{String(totalBars)}</span>
            </button>
          </div>
          {followRow(sceneI)}
        </div>
      )
    } else {
      launchBtn = (
        <button type="button" class="btn-session-launch" disabled={!canLaunchDeck} onclick={() => armScene(si)} title={canLaunchDeck ? "Queue scene for next bar (16 steps)" : "Another player's deck — only its owner (or the host) can play it."}>
          {"Launch"}
        </button>
      )
    }
    let isCued = rt && rt.cueScene !== null && rt.cueScene !== undefined && Math.floor(Number(rt.cueScene)) === si
    let cueHdrCls = isCued ? hdrCls + " session-scene-head-cued" : hdrCls
    sceneHeaders.push(
      <div class={cueHdrCls} key={"sc-h-" + String(si)}>
        <div class="session-scene-toprow">
          <span class="session-scene-label">{"P"}{String(si + 1)}</span>
          {launchBtn}
          <button
            type="button"
            class={isCued ? "btn-scene-cue btn-scene-cue-on" : "btn-scene-cue"}
            disabled={!canLaunchDeck}
            onclick={() => onCueScene(si)}
            title={!canLaunchDeck ? "Another player's deck — only its owner (or the host) can play it." : (isCued ? "CUED — click to un-cue. Auditions in sync with the main beat; THROW to go live." : "CUE — audition this scene privately, in time with the main beat (peers hear nothing). Click again to un-cue; THROW to go live.")}
          >
            {isCued ? "♪ CUE" : "CUE"}
          </button>
        </div>
        {headOps}
      </div>
    )
    sh = sh + 1
  }

  let rows = []
  let ti = 0
  while (ti < project.channels.length) {
    let ch = project.channels[ti]
    let trackRows = SessionTrackRow(project, ch, ti, activeDeck, rt, sc, playing, bumpSessionUi, setProjectFromUI, armCell, toggleClipDisabled, queueMute, stopTrack, canLaunchDeck, canEditDeck)
    if (trackRows !== null && trackRows !== undefined) {
      let tri = 0
      while (tri < trackRows.length) {
        rows.push(trackRows[tri])
        tri = tri + 1
      }
    }
    ti = ti + 1
  }

  let sessionLive = playing && rt.playMode === "song"
  return (
    <section class="panel session-panel">
      <div class="session-panel-head">
        <div class={sessionLive ? "session-brand session-brand-live" : "session-brand"}>
          <span class="session-title">{"session"}</span>
        </div>
        <div class="session-head-right">
          {headerRight}
          <div class="sg-barpager session-prog-pager" title="Programs — the P columns (scenes). Add or remove a program slot, like BARS on the rack.">
            <button type="button" class="sg-barbtn sg-barbtn-mod" title={canEditDeck ? "Remove the last program" : "Another player's deck — only its owner can edit its session."} disabled={sc <= 1 || !canEditDeck} onclick={() => removeProgram()}>
              {"−"}
            </button>
            <span class="sg-barpager-count">{String(sc)}</span>
            <button type="button" class="sg-barbtn sg-barbtn-mod" title={canEditDeck ? "Add a program (a new P column / scene)" : "Another player's deck — only its owner can edit its session."} disabled={!canEditDeck} onclick={() => addProgram()}>
              {"+"}
            </button>
          </div>
          <button type="button" class="btn-session-stop-all" disabled={!canLaunchDeck} title={canLaunchDeck ? "Stop all clips" : "Another player's deck — only its owner (or the host) can play it."} onclick={stopAll}>
            {"■"}
          </button>
        </div>
      </div>
      <div class="session-grid-wrap">
        <div class="session-corner" />
        <div class="session-scene-row">{sceneHeaders}</div>
        {rows}
      </div>
    </section>
  )
}
