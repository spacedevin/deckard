// Chromatrack-style instrument editor: categorised one-click pill selectors for the selected track.
// Every control is "pick one from a row" — fast and obvious, no fiddly sliders. Each category maps to
// the channel's existing model fields (generator/waveform, envelope, octave, reverb send, filter, etc.).

import { h, Fragment } from '@tishlang/lattish'
import { defaultParamsForGeneratorId, normalizeBasicOscWaveform } from '../generators/Registry.tish'
import { applyStepsEuclid } from '../tpl/Apply.tish'
import { setChannelMute, setChannelSolo } from '../model/Edits.tish'

let DECAY_PRESETS = {
  Pluck: { attack: 0.002, decay: 0.08, sustain: 0.0, release: 0.06 },
  Short: { attack: 0.005, decay: 0.12, sustain: 0.2, release: 0.1 },
  Medium: { attack: 0.01, decay: 0.25, sustain: 0.5, release: 0.2 },
  Long: { attack: 0.05, decay: 0.5, sustain: 0.7, release: 0.5 },
  Pad: { attack: 0.3, decay: 0.6, sustain: 0.85, release: 1.5 }
}

fn currentVoice(ch) {
  let g = ch.generatorId ? ch.generatorId : "basicOsc"
  if (g === "noiseBurst") {
    return "noise"
  }
  if (g === "fmTone") {
    return "fm"
  }
  if (g === "pad") {
    return "pad"
  }
  if (g === "bell") {
    return "bell"
  }
  if (g === "matrixFm") {
    return "matrix"
  }
  let w = normalizeBasicOscWaveform(ch.generatorParams ? ch.generatorParams.waveform : "sine")
  if (w === "sawtooth") {
    return "saw"
  }
  return w
}

fn setVoice(ch, voice) {
  if (voice === "sine" || voice === "square" || voice === "triangle" || voice === "saw") {
    if (ch.generatorId !== "basicOsc") {
      ch.generatorId = "basicOsc"
      ch.generatorParams = defaultParamsForGeneratorId("basicOsc")
    }
    if (!ch.generatorParams) {
      ch.generatorParams = defaultParamsForGeneratorId("basicOsc")
    }
    ch.generatorParams.waveform = voice === "saw" ? "sawtooth" : voice
  } else {
    let gid = voice
    if (voice === "noise") {
      gid = "noiseBurst"
    }
    if (voice === "fm") {
      gid = "fmTone"
    }
    if (ch.generatorId !== gid) {
      ch.generatorId = gid
      ch.generatorParams = defaultParamsForGeneratorId(gid)
    }
  }
}

fn approxEq(a, b) {
  let x = a != null ? a : 0
  let d = x - b
  if (d < 0) {
    d = -d
  }
  return d < 0.012
}

/** label + a row of pill buttons; opts = [{ text, on, click }]. */
fn PillGroup(label, opts) {
  let pills = []
  let i = 0
  while (i < opts.length) {
    let o = opts[i]
    pills.push(
      <button type="button" class={o.on ? "ie-pill ie-pill-on" : "ie-pill"} onclick={o.click}>
        {o.text}
      </button>
    )
    i = i + 1
  }
  return (
    <div class="ie-group">
      <div class="ie-group-label">{label}</div>
      <div class="ie-pills">{pills}</div>
    </div>
  )
}

fn voiceOpts(ch, commit) {
  let cur = currentVoice(ch)
  let defs = [
    { text: "Sine", v: "sine" },
    { text: "Triangle", v: "triangle" },
    { text: "Saw", v: "saw" },
    { text: "Square", v: "square" },
    { text: "Noise", v: "noise" },
    { text: "FM", v: "fm" },
    { text: "Pad", v: "pad" },
    { text: "Bell", v: "bell" }
  ]
  let out = []
  let i = 0
  while (i < defs.length) {
    let d = defs[i]
    out.push({
      text: d.text,
      on: cur === d.v,
      click: () => {
        setVoice(ch, d.v)
        commit()
      }
    })
    i = i + 1
  }
  return out
}

fn decayOpts(ch, commit) {
  let names = ["Pluck", "Short", "Medium", "Long", "Pad"]
  let out = []
  let i = 0
  while (i < names.length) {
    let nm = names[i]
    out.push({
      text: nm,
      on: ch.decayPreset === nm,
      click: () => {
        let d = DECAY_PRESETS[nm]
        if (!ch.generatorParams) {
          ch.generatorParams = {}
        }
        ch.generatorParams.attack = d.attack
        ch.generatorParams.decay = d.decay
        ch.generatorParams.sustain = d.sustain
        ch.generatorParams.release = d.release
        ch.decayPreset = nm
        commit()
      }
    })
    i = i + 1
  }
  return out
}

fn octaveOpts(ch, commit) {
  let vals = [-2, -1, 0, 1, 2]
  let cur = ch.octave != null ? ch.octave : 0
  let out = []
  let i = 0
  while (i < vals.length) {
    let n = vals[i]
    out.push({
      text: n > 0 ? "+" + String(n) : String(n),
      on: cur === n,
      click: () => {
        ch.octave = n
        commit()
      }
    })
    i = i + 1
  }
  return out
}

fn selectOpts(ch, field, defs, commit) {
  let cur = ch[field] != null ? ch[field] : defs[0][1]
  let out = []
  let i = 0
  while (i < defs.length) {
    let d = defs[i]
    out.push({
      text: d[0],
      on: cur === d[1],
      click: () => {
        ch[field] = d[1]
        commit()
      }
    })
    i = i + 1
  }
  return out
}

fn pairOpts(ch, field, defs, commit) {
  let cur = ch[field]
  let out = []
  let i = 0
  while (i < defs.length) {
    let d = defs[i]
    out.push({
      text: d[0],
      on: approxEq(cur, d[1]),
      click: () => {
        ch[field] = d[1]
        commit()
      }
    })
    i = i + 1
  }
  return out
}

fn euclidOpts(ch, commit) {
  let out = []
  out.push({
    text: "Off",
    on: !ch.euclid || ch.euclid === 0,
    click: () => {
      let si = 0
      while (si < 16) {
        ch.steps[si].on = false
        si = si + 1
      }
      ch.euclid = 0
      commit()
    }
  })
  let k = 1
  while (k <= 8) {
    let hits = k
    out.push({
      text: String(k),
      on: ch.euclid === k,
      click: () => {
        applyStepsEuclid(ch, hits, 16)
        ch.euclid = hits
        commit()
      }
    })
    k = k + 1
  }
  return out
}

export fn InstrumentEditor(project, selectedCh, setProjectFromUI, tplMirrorFlush) {
  let ch = project.channels[selectedCh]
  if (!ch) {
    return (
      <section class="panel ie-panel">
        <h2>{"INSTRUMENT"}</h2>
      </section>
    )
  }
  fn commit() {
    setProjectFromUI(project)
    if (tplMirrorFlush) {
      tplMirrorFlush()
    }
  }
  let cutoffDefs = [
    ["200", 200],
    ["400", 400],
    ["800", 800],
    ["1.2k", 1200],
    ["2k", 2000],
    ["4k", 4000],
    ["8k", 8000],
    ["12k", 12000],
    ["OFF", 20000]
  ]
  let resDefs = [["·", 0.5], ["Q1", 1], ["Q2", 2], ["Q4", 4], ["Q8", 8], ["Q14", 14], ["Q20", 20]]
  let reverbDefs = [["Off", 0], ["25", 0.25], ["50", 0.5], ["75", 0.75], ["100", 1.0]]
  return (
    <section class="panel ie-panel">
      <div class="ie-head">
        <h2>{"INSTRUMENT // " + ch.name}</h2>
        <span class="ie-sub">{"ROW " + String(selectedCh + 1) + " CONTROLS"}</span>
      </div>

      <div class="ie-section">{"VOICE"}</div>
      {PillGroup("WAVEFORM", voiceOpts(ch, commit))}
      {PillGroup("DECAY", decayOpts(ch, commit))}
      {PillGroup("OCTAVE", octaveOpts(ch, commit))}
      {PillGroup("ARPEGGIATOR", selectOpts(ch, "arp", [["Off", "off"], ["Up", "up"], ["Down", "down"], ["Up-Down", "updown"], ["Random", "random"]], commit))}
      {PillGroup("CHORD", selectOpts(ch, "chord", [["Off", "off"], ["Major", "major"], ["Minor", "minor"], ["Dom7", "dom7"], ["Maj7", "maj7"], ["Min7", "min7"], ["Dim", "dim"], ["Aug", "aug"], ["Sus4", "sus4"], ["Add9", "add9"]], commit))}

      <div class="ie-section">{"FX"}</div>
      {PillGroup("REVERB SEND", pairOpts(ch, "reverbSend", reverbDefs, commit))}
      {PillGroup("FILTER CUTOFF", pairOpts(ch, "filterCutoff", cutoffDefs, commit))}
      {PillGroup("FILTER RESONANCE", pairOpts(ch, "filterQ", resDefs, commit))}

      <div class="ie-section">{"SEQUENCER"}</div>
      {PillGroup("EUCLIDEAN", euclidOpts(ch, commit))}

      <div class="ie-section">{"UTILITIES"}</div>
      {PillGroup("MUTE / SOLO", [
        { text: "Mute", on: ch.mute === true, click: () => { setChannelMute(ch, !ch.mute); commit() } },
        { text: "Solo", on: ch.solo === true, click: () => { setChannelSolo(ch, !ch.solo); commit() } }
      ])}
    </section>
  )
}
