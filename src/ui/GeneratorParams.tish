import {
  parseGenBlock
} from '@spacedevin/deck'
import {
  defaultMatrixFmRawLines
} from '../model/MatrixFmDefaults.tish'
import {
  defaultPatchRawLines
} from '../model/PatchGraphEdit.tish'
import { h } from '@tishlang/lattish'
import { defaultParamsForGeneratorId, normalizeBasicOscWaveform } from '../generators/Registry.tish'
import { Knob, InfiniteKnob, WaveIconPicker, EnvDisplay, accentForGenerator, Switch } from './InstrumentKit.tish'

// Every instrument edit routes one param through the single gated write door (rt.emit → `gen <snake> <v>`,
// merged into generatorParams). The deck key is snake_case so apply's snakeToCamel lands the right field;
// the dedicated osc/fm/noise emit branches read the same camelCase keys, so the round-trip is preserved.
/// Options for the DMG Wave selector: the three built-in shapes, plus every named `wave` table the
/// song defines. Without this a table could be loaded and played but never chosen by hand — the
/// selector was hardcoded to the built-ins, so picking anything else meant editing the file.
fn waveShapeOptions(project, current) {
  let opts = [["saw", "Saw"], ["square", "Square"], ["sine", "Sine"]]
  let tables = project ? project.waveTables : null
  if (tables) {
    let names = Object.keys(tables)
    let i = 0
    while (i < names.length) {
      opts.push([names[i], names[i]])
      i = i + 1
    }
  }
  // A shape the song names but has no table for (a typo, or a table not loaded yet) still has to be
  // selectable, or turning the knob would silently rewrite it.
  let cur = String(current)
  let seen = false
  let k = 0
  while (k < opts.length) {
    if (String(opts[k][0]) === cur) { seen = true }
    k = k + 1
  }
  if (!seen && cur.length > 0) {
    opts.push([cur, cur])
  }
  return opts
}

fn genEmit(rt, ch, tplKey, value) {
  if (rt && rt.emit) {
    rt.emit("track/" + ch.id + "/gen/" + tplKey, value)
  }
}

fn genFreqToSlider(hz) {
  let lo = Math.log(20)
  let hi = Math.log(18000)
  let h0 = hz
  if (h0 < 20) {
    h0 = 20
  }
  if (h0 > 18000) {
    h0 = 18000
  }
  return Math.round(((Math.log(h0) - lo) / (hi - lo)) * 1000)
}

fn genSliderToFreq(sl) {
  let lo = Math.log(20)
  let hi = Math.log(18000)
  return Math.round(Math.exp(lo + (sl / 1000) * (hi - lo)))
}

// ---- knob shorthands (all emit via genEmit) ----

fn msKnob(label, sec, maxSec, rt, ch, key, accent, disabled) {
  return Knob({
    label: label,
    value: sec,
    min: 0,
    max: maxSec,
    step: 0.001,
    fmt: (x) => String(Math.round(x * 1000)),
    accent: accent,
    disabled: disabled,
    valueInside: true,
    size: "sm",
    onInput: (x) => genEmit(rt, ch, key, x)
  })
}

fn pctKnob(label, frac, rt, ch, key, accent, disabled) {
  return Knob({
    label: label,
    value: frac,
    min: 0,
    max: 1,
    step: 0.01,
    fmt: (x) => String(Math.round(x * 100)) + "%",
    accent: accent,
    disabled: disabled,
    valueInside: true,
    size: "sm",
    onInput: (x) => genEmit(rt, ch, key, x)
  })
}

fn numKnob(label, val, min, max, step, suffix, rt, ch, key, accent, disabled) {
  return Knob({
    label: label,
    value: val,
    min: min,
    max: max,
    step: step,
    fmt: (x) => {
      let decs = 0
      if (step !== null && step % 1 !== 0) {
        let strStep = String(step)
        let parts = strStep.split(".")
        if (parts.length > 1) {
          decs = parts[1].length
        }
      }
      return Number(Math.round(x * 100) / 100).toFixed(decs) + suffix
    },
    accent: accent,
    disabled: disabled,
    valueInside: true,
    size: "sm",
    onInput: (x) => genEmit(rt, ch, key, x)
  })
}

fn freqKnob(label, hz, rt, ch, key, accent, disabled) {
  return Knob({
    label: label,
    value: genFreqToSlider(hz),
    min: 0,
    max: 1000,
    step: 1,
    fmt: (sl) => String(genSliderToFreq(sl)) + " Hz",
    accent: accent,
    disabled: disabled,
    valueInside: true,
    size: "sm",
    onInput: (sl) => genEmit(rt, ch, key, genSliderToFreq(sl))
  })
}

fn waveCard(title, current, tplKey, rt, ch, accent, extra, pickerOpts) {
  let popts = pickerOpts ? pickerOpts : {}
  popts.accent = accent
  return (
    <div class="ik-card">
      <div class="ik-card-h">{title}</div>
      {WaveIconPicker(current, (w) => genEmit(rt, ch, tplKey, w), popts)}
      {extra}
    </div>
  )
}

// Generic discrete-choice pill row (accent-tinted active state). For string-only pickers like the Aahs
// vowel or any voice family — emits the chosen value through the one gated write door.
fn pickPills(current, opts, rt, ch, key, accent) {
  let pills = []
  let i = 0
  while (i < opts.length) {
    let val = opts[i][0]
    let lab = opts[i][1]
    let valCopy = val
    let on = String(current) === String(val)
    let style = on ? { borderColor: accent, color: accent, background: accent + "22" } : {}
    pills.push(
      <button
        type="button"
        class={on ? "gen-pick-pill gen-pick-pill-on" : "gen-pick-pill"}
        key={"pk" + key + val}
        style={style}
        onmousedown={(e) => e.stopPropagation()}
        onclick={() => genEmit(rt, ch, key, valCopy)}
      >
        {lab}
      </button>
    )
    i = i + 1
  }
  return <div class="gen-pick-row">{pills}</div>
}

fn genSelectorKnob(label, current, opts, rt, ch, key, accent, disabled) {
  let n = opts.length
  let curIdx = 0
  let i = 0
  while (i < n) {
    if (String(opts[i][0]) === String(current)) {
      curIdx = i
    }
    i = i + 1
  }
  fn clampIdx(x) {
    let k = Math.round(x)
    if (k < 0) k = 0
    if (k > n - 1) k = n - 1
    return k
  }
  return Knob({
    label: label,
    value: curIdx,
    min: 0,
    max: n - 1,
    step: 1,
    detents: n,
    accent: accent,
    disabled: disabled,
    valueInside: true,
    size: "sm",
    fmt: (x) => opts[clampIdx(x)][1],
    onInput: (x) => {
      genEmit(rt, ch, key, opts[clampIdx(x)][0])
    }
  })
}

// Shared performance-macro row (pitch drop / vibrato / arpeggio) — identical across every chip voice, so it
// lives here ONCE instead of being copy-pasted into all 7. Always visible; a dense, de-duplicated knob grid.
fn perfMacrosSection(rt, ch, project, setProject, p, accent, vibDisabled) {
  let pitchDrop = p.pitchDrop !== null ? Math.round(p.pitchDrop) : 0
  let pitchDec = p.pitchDec !== null ? p.pitchDec : 0.05
  let vibRate = p.vibRate !== null ? p.vibRate : 0
  let vibAmt = p.vibAmt !== null ? p.vibAmt : 0
  let arpRate = p.arpRate !== null ? p.arpRate : 0
  let arpSemis = p.arpSemis !== null ? Math.round(p.arpSemis) : 0
  return (
    <div class="ik-card">
      <div class="ik-knob-grid">
        {numKnob("Drop.st", pitchDrop, -48, 48, 1, "st", rt, ch, "pitchDrop", accent)}
        {msKnob("Drop.ms", pitchDec, 1, rt, ch, "pitchDec", accent)}
        {numKnob("Vib.Hz", vibRate, 0, 20, 0.5, "Hz", rt, ch, "vibRate", accent, vibDisabled)}
        {numKnob("Vib.¢", vibAmt, 0, 200, 1, "ct", rt, ch, "vibAmt", accent, vibDisabled)}
        {numKnob("Arp.Hz", arpRate, 0, 40, 1, "Hz", rt, ch, "arpRate", accent)}
        {numKnob("Arp.st", arpSemis, -24, 24, 1, "st", rt, ch, "arpSemis", accent)}
      </div>
    </div>
  )
}

export fn GeneratorParamPanel(ch, project, setProject, tplMirrorFlush, rt) {
  let id = ch.generatorId
  if (!id) {
    id = "basicOsc"
  }
  let p = ch.generatorParams
  if (!p) {
    p = defaultParamsForGeneratorId(id)
    if (!p) p = {}
    ch.generatorParams = p
  }
  let accent = accentForGenerator(id)

  if (id === "basicOsc") {
    let w = normalizeBasicOscWaveform(p.waveform)
    let a = p.attack > 0 ? p.attack : 0.005
    let d = p.decay > 0 ? p.decay : 0.08
    let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.4
    let r = p.release > 0 ? p.release : 0.12
    return (
      <article class="gen-params ik-cols">
        {waveCard("Oscillator", w, "waveform", rt, ch, accent, EnvDisplay(a, d, s, r, { accent: accent }))}
        <div class="ik-card">
          <div class="ik-card-h">{"Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", a, 2, rt, ch, "attack", accent)}
            {msKnob("Decay", d, 2, rt, ch, "decay", accent)}
            {pctKnob("Sustain", s, rt, ch, "sustain", accent)}
            {msKnob("Release", r, 4, rt, ch, "release", accent)}
          </div>
        </div>
      </article>
    )
  }

  if (id === "noiseBurst") {
    let rise = p.attack > 0 ? p.attack : 0.002
    let dec = p.decay > 0 ? p.decay : 0.07
    let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.45
    let pf = p.pitchFollow >= 0 && p.pitchFollow <= 1 ? p.pitchFollow : 0.25
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Shape"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", rise, 0.15, rt, ch, "attack", accent)}
            {msKnob("Decay", dec, 0.4, rt, ch, "decay", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Tone"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Color", tone, rt, ch, "tone", accent)}
            {pctKnob("Pitch→flt", pf, rt, ch, "pitch_follow", accent)}
          </div>
        </div>
      </article>
    )
  }

  if (id === "fmTone") {
    let ratio = p.ratio > 0 ? p.ratio : 2
    let idx = p.modIndex >= 0 ? p.modIndex : 4
    let cw = normalizeBasicOscWaveform(p.carrierWave ? p.carrierWave : "sine")
    let a = p.attack > 0 ? p.attack : 0.005
    let d = p.decay > 0 ? p.decay : 0.08
    let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.4
    let r = p.release > 0 ? p.release : 0.12
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"FM"}</div>
          <div class="ik-knob-grid">
            {numKnob("Ratio", ratio, 0.25, 16, 0.01, "×", rt, ch, "ratio", accent)}
            {numKnob("Index", idx, 0, 48, 0.1, "", rt, ch, "mod_index", accent)}
          </div>
          <div class="ik-wave-pair">
            <span class="ik-wave-lbl">{"Wave"}</span>
            {WaveIconPicker(cw, (x) => genEmit(rt, ch, "carrier_wave", x), { accent: accent })}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", a, 2, rt, ch, "attack", accent)}
            {msKnob("Decay", d, 2, rt, ch, "decay", accent)}
            {pctKnob("Sustain", s, rt, ch, "sustain", accent)}
            {msKnob("Release", r, 4, rt, ch, "release", accent)}
          </div>
          {EnvDisplay(a, d, s, r, { accent: accent })}
        </div>
      </article>
    )
  }

  if (id === "pad") {
    let w1 = normalizeBasicOscWaveform(p.wave1 ? p.wave1 : "sine")
    let w2 = normalizeBasicOscWaveform(p.wave2 ? p.wave2 : "triangle")
    let detune = p.detune !== null ? p.detune : 9
    let cutoff = p.cutoff !== null && p.cutoff > 0 ? p.cutoff : 2200
    let a = p.attack > 0 ? p.attack : 0.08
    let d = p.decay > 0 ? p.decay : 0.25
    let s = p.sustain >= 0 && p.sustain <= 1 ? p.sustain : 0.6
    let r = p.release > 0 ? p.release : 0.7
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Oscillators"}</div>
          <div class="ik-wave-pair">
            <span class="ik-wave-lbl">{"Osc 1"}</span>
            {WaveIconPicker(w1, (x) => genEmit(rt, ch, "wave1", x), { accent: accent })}
          </div>
          <div class="ik-wave-pair">
            <span class="ik-wave-lbl">{"Osc 2"}</span>
            {WaveIconPicker(w2, (x) => genEmit(rt, ch, "wave2", x), { accent: accent })}
          </div>
          <div class="ik-knob-grid">
            {numKnob("Detune", detune, 0, 50, 1, "¢", rt, ch, "detune", accent)}
            {freqKnob("Cutoff", cutoff, rt, ch, "cutoff", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", a, 2, rt, ch, "attack", accent)}
            {msKnob("Decay", d, 2, rt, ch, "decay", accent)}
            {pctKnob("Sustain", s, rt, ch, "sustain", accent)}
            {msKnob("Release", r, 4, rt, ch, "release", accent)}
          </div>
          {EnvDisplay(a, d, s, r, { accent: accent })}
        </div>
      </article>
    )
  }

  if (id === "bell") {
    let partial = p.partial > 0 ? p.partial : 2.01
    let hp = p.highpass > 0 ? p.highpass : 800
    let dec = p.decay > 0 ? p.decay : 1.0
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Partial"}</div>
          <div class="ik-knob-grid">
            {numKnob("Ratio", partial, 1, 12, 0.01, "×", rt, ch, "partial", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Tone & decay"}</div>
          <div class="ik-knob-grid">
            {freqKnob("Highpass", hp, rt, ch, "highpass", accent)}
            {numKnob("Decay", dec, 0.1, 6, 0.01, "s", rt, ch, "decay", accent)}
          </div>
        </div>
      </article>
    )
  }

  if (id === "drumSynth") {
    let tone = normalizeBasicOscWaveform(p.tone ? p.tone : "sine")
    let pitchEnv = p.pitchEnv !== null ? p.pitchEnv : 36
    let pitchDecay = p.pitchDecay > 0 ? p.pitchDecay : 0.06
    let dec = p.decay > 0 ? p.decay : 0.35
    let noise = p.noise !== null ? p.noise : 0
    let noiseDecay = p.noiseDecay > 0 ? p.noiseDecay : 0.12
    let noiseHp = p.noiseHp > 0 ? p.noiseHp : 1500
    let drive = p.drive !== null ? p.drive : 0
    return (
      <article class="gen-params ik-cols">
        {waveCard(
          "Body",
          tone,
          "tone",
          rt,
          ch,
          accent,
          <div class="ik-knob-grid">
            {numKnob("Pitch", pitchEnv, 0, 60, 1, "st", rt, ch, "pitch_env", accent)}
            {msKnob("P.decay", pitchDecay, 0.3, rt, ch, "pitch_decay", accent)}
            {msKnob("Decay", dec, 1.5, rt, ch, "decay", accent)}
          </div>
        )}
        <div class="ik-card">
          <div class="ik-card-h">{"Noise + drive"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Noise", noise, rt, ch, "noise", accent)}
            {msKnob("N.decay", noiseDecay, 0.6, rt, ch, "noise_decay", accent)}
            {freqKnob("N.HP", noiseHp, rt, ch, "noise_hp", accent)}
            {pctKnob("Drive", drive, rt, ch, "drive", accent)}
          </div>
        </div>
      </article>
    )
  }

  if (id === "guitar") {
    let tone = p.tone >= 0 && p.tone <= 1 ? p.tone : 0.5
    let dec = p.decay >= 0 && p.decay <= 1 ? p.decay : 0.6
    let damping = p.damping >= 0 && p.damping <= 1 ? p.damping : 0.4
    let drive = p.drive !== null ? p.drive : 0.25
    let body = p.body !== null && p.body > 0 ? p.body : 3500
    let mute = p.mute >= 0 && p.mute <= 1 ? p.mute : 0
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"String"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Tone", tone, rt, ch, "tone", accent)}
            {pctKnob("Sustain", dec, rt, ch, "decay", accent)}
            {pctKnob("Damping", damping, rt, ch, "damping", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Amp & body"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Drive", drive, rt, ch, "drive", accent)}
            {freqKnob("Body", body, rt, ch, "body", accent)}
            {pctKnob("Palm mute", mute, rt, ch, "mute", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "clap") {
    let hands = p.hands !== null ? p.hands : 3
    let spread = p.spread !== null ? p.spread : 0.4
    let size = p.size !== null ? p.size : 0.5
    let tone = p.tone !== null ? p.tone : 0.5
    let claps = p.claps !== null ? p.claps : 1
    let gap = p.gap !== null ? p.gap : 0.35
    let tail = p.tail !== null ? p.tail : 0.4
    let body = p.body !== null ? p.body : 0.2
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Hands"}</div>
          <div class="ik-knob-grid">
            {numKnob("Hands", hands, 1, 12, 1, "", rt, ch, "hands", accent)}
            {pctKnob("Spread", spread, rt, ch, "spread", accent)}
            {pctKnob("Size", size, rt, ch, "size", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Claps & character"}</div>
          <div class="ik-knob-grid">
            {numKnob("Claps", claps, 1, 4, 1, "", rt, ch, "claps", accent)}
            {pctKnob("Gap", gap, rt, ch, "gap", accent)}
            {pctKnob("Tone", tone, rt, ch, "tone", accent)}
            {pctKnob("Tail", tail, rt, ch, "tail", accent)}
            {pctKnob("Body", body, rt, ch, "body", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "tine") {
    let bark = p.bark !== null ? p.bark : 0.55
    let tineP = p.tine !== null ? p.tine : 0.6
    let tremolo = p.tremolo !== null ? p.tremolo : 0.35
    let decay = p.decay !== null ? p.decay : 0.5
    let drive = p.drive !== null ? p.drive : 0.2
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Tine & Bark"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Bark", bark, rt, ch, "bark", accent)}
            {pctKnob("Tine", tineP, rt, ch, "tine", accent)}
            {pctKnob("Decay", decay, rt, ch, "decay", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Suitcase amp"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Tremolo", tremolo, rt, ch, "tremolo", accent)}
            {pctKnob("Drive", drive, rt, ch, "drive", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "aether") {
    let glide = p.glide !== null ? p.glide : 0.4
    let waver = p.waver !== null ? p.waver : 0.5
    let toneA = p.tone !== null ? p.tone : 0.3
    let swell = p.swell !== null ? p.swell : 0.45
    let air = p.air !== null ? p.air : 0.25
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Hands"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Glide", glide, rt, ch, "glide", accent)}
            {pctKnob("Swell", swell, rt, ch, "swell", accent)}
            {pctKnob("Waver", waver, rt, ch, "waver", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Voice"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Tone", toneA, rt, ch, "tone", accent)}
            {pctKnob("Air", air, rt, ch, "air", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "halo") {
    let temper = p.temper !== null ? p.temper : 0.4
    let ring = p.ring !== null ? p.ring : 0.55
    let mallet = p.mallet !== null ? p.mallet : 0.35
    let bloom = p.bloom !== null ? p.bloom : 0.5
    let lows = p.lows !== null ? p.lows : 0.45
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Tone field"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Temper", temper, rt, ch, "temper", accent)}
            {pctKnob("Bloom", bloom, rt, ch, "bloom", accent)}
            {pctKnob("Lows", lows, rt, ch, "lows", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Strike & ring"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Mallet", mallet, rt, ch, "mallet", accent)}
            {pctKnob("Ring", ring, rt, ch, "ring", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "formantVocal" || id === "ttsVocal" || id === "meSpeakVocal") {
    let applyLyrics = (str) => {
      let words = str.trim().split(" ")
      let validWords = []
      let wIdx = 0
      while (wIdx < words.length) {
        if (words[wIdx] !== "") {
          validWords.push(words[wIdx])
        }
        wIdx = wIdx + 1
      }
      if (validWords.length === 0) return
      
      let wi = 0
      let emitted = false

      if (ch.pianoNotes && ch.pianoNotes.length > 0) {
        let arr = []
        let i = 0
        while (i < ch.pianoNotes.length) {
          let n = ch.pianoNotes[i]
          let nlyr = validWords[wi % validWords.length]
          wi = wi + 1
          arr.push({
            startBeat: n.startBeat,
            durBeats: n.durBeats,
            pitch: n.pitch,
            vel: n.vel !== null ? n.vel : 100,
            prob: n.prob !== null ? n.prob : 1,
            ratchet: n.ratchet !== null ? n.ratchet : 1,
            nudge: n.nudge !== null ? n.nudge : 0,
            lyric: nlyr
          })
          i = i + 1
        }
        if (rt && rt.emit) {
          rt.emit("track/" + ch.id + "/notes", arr)
        }
      } else if (ch.steps) {
        let arr = []
        let i = 0
        while (i < ch.steps.length) {
          let s = ch.steps[i]
          arr.push({
            on: s.on === true,
            vel: s.vel !== null ? s.vel : 100,
            prob: s.prob !== null ? s.prob : 1,
            ratchet: s.ratchet !== null ? s.ratchet : 1,
            nudge: s.nudge !== null ? s.nudge : 0,
            lyric: s.lyric !== null ? s.lyric : ""
          })
          i = i + 1
        }
        i = 0
        while (i < 16) {
          if (arr[i].on) {
            arr[i].lyric = validWords[wi % validWords.length]
            wi = wi + 1
            emitted = true
          }
          i = i + 1
        }
        if (emitted && rt && rt.emit) {
          rt.emit("track/" + ch.id + "/pattern", arr)
        }
      }
    }

    let genSpecific = null
    if (id === "formantVocal") {
      let glide = p.glide !== null ? p.glide : 0.1
      let vibDepth = p.vibDepth !== null ? p.vibDepth : 0.02
      let vibRate = p.vibRate !== null ? p.vibRate : 5.0
      let humanize = p.humanize !== null ? p.humanize : 0.5
      let release = p.release !== null ? p.release : 0.2
      genSpecific = (
        <div class="ik-card">
          <div class="ik-card-h">{"Formant"}</div>
          <div style={{ padding: "0 8px 8px" }}>
            <div style={{ fontSize: "10px", color: "var(--ik-text-dim, #94a3b8)", marginBottom: "4px" }}>Front vowels</div>
            <div style={{ display: "flex", gap: "3px", marginBottom: "4px" }}>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("I")} title="heed / see">/i/ Ee</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("IH")} title="hid / bit">/ɪ/ Ih</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("EY")} title="bait / hey">/e/ Ay</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("E")} title="bed / said">/ɛ/ Eh</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("AE")} title="cat / bat">/æ/ Ae</button>
            </div>
            <div style={{ fontSize: "10px", color: "var(--ik-text-dim, #94a3b8)", marginBottom: "4px" }}>Open & back vowels</div>
            <div style={{ display: "flex", gap: "3px", marginBottom: "4px" }}>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("A")} title="father / palm">/ɑ/ Ah</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("O")} title="law / caught">/ɔ/ Aw</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("OH")} title="boat / go">/o/ Oh</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("OO")} title="book / put">/ʊ/ Uu</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("U")} title="boot / who">/u/ Oo</button>
            </div>
            <div style={{ fontSize: "10px", color: "var(--ik-text-dim, #94a3b8)", marginBottom: "4px" }}>Central vowels</div>
            <div style={{ display: "flex", gap: "3px" }}>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("UH")} title="cup / bus">/ʌ/ Uh</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("ER")} title="bird / her">/ɝ/ Er</button>
              <button class="ik-btn" style={{ flex: 1, padding: "4px", minHeight: "24px", fontSize: "10px" }} onclick={() => applyLyrics("UX")} title="about / sofa">/ə/ Ux</button>
            </div>
          </div>
          <div class="ik-knob-grid">
            {pctKnob("Glide", glide, rt, ch, "glide", accent)}
            {msKnob("Release", release, 2.0, rt, ch, "release", accent)}
            {pctKnob("Vib.Dpt", vibDepth, rt, ch, "vib_depth", accent)}
            {numKnob("Vib.Rt", vibRate, 0, 10, 0.1, "Hz", rt, ch, "vib_rate", accent)}
            {pctKnob("Human", humanize, rt, ch, "humanize", accent)}
          </div>
        </div>
      )
    } else if (id === "meSpeakVocal") {
      let pitch = p.pitch !== null ? p.pitch : 50
      let speed = p.speed !== null ? p.speed : 175
      let wordgap = p.wordgap !== null ? p.wordgap : 0
      let variant = p.variant !== null ? p.variant : "m1"
      let voice = p.voice !== null ? p.voice : "en/en-us"
      
      let voiceOpts = [
        ["en/en-us", "US Eng"], ["en/en-sc", "Scottish"], ["en/en-rp", "British"],
        ["en/en-wm", "Welsh"], ["fr", "French"], ["de", "German"], ["es", "Spanish"], ["it", "Italian"]
      ]
      let varOpts = [
        ["m1", "M1"], ["m2", "M2"], ["m3", "M3"], ["m4", "M4"], ["m5", "M5"], ["m6", "M6"], ["m7", "M7"],
        ["f1", "F1"], ["f2", "F2"], ["f3", "F3"], ["f4", "F4"], ["f5", "F5"], 
        ["croak", "Croak"], ["whisper", "Whisper"], ["whisperf", "Whisper F"]
      ]

      let vIdx = 0
      let i = 0
      while (i < voiceOpts.length) {
        if (voiceOpts[i][0] === voice) vIdx = i
        i = i + 1
      }

      let varIdx = 0
      let j = 0
      while (j < varOpts.length) {
        if (varOpts[j][0] === variant) varIdx = j
        j = j + 1
      }

      let voiceKnob = Knob({
        label: "Voice",
        value: vIdx,
        min: 0,
        max: voiceOpts.length - 1,
        step: 1,
        detents: voiceOpts.length,
        accent: accent,
        fmt: (x) => {
          let k = Math.round(x)
          if (k < 0) k = 0
          if (k > voiceOpts.length - 1) k = voiceOpts.length - 1
          return voiceOpts[k][1]
        },
        onInput: (x) => {
          let k = Math.round(x)
          if (k < 0) k = 0
          if (k > voiceOpts.length - 1) k = voiceOpts.length - 1
          if (rt && rt.emit) {
            rt.emit("track/" + ch.id + "/gen/voice", voiceOpts[k][0])
          }
        }
      })

      let variantKnob = Knob({
        label: "Variant",
        value: varIdx,
        min: 0,
        max: varOpts.length - 1,
        step: 1,
        detents: varOpts.length,
        accent: accent,
        fmt: (x) => {
          let k = Math.round(x)
          if (k < 0) k = 0
          if (k > varOpts.length - 1) k = varOpts.length - 1
          return varOpts[k][1]
        },
        onInput: (x) => {
          let k = Math.round(x)
          if (k < 0) k = 0
          if (k > varOpts.length - 1) k = varOpts.length - 1
          if (rt && rt.emit) {
            rt.emit("track/" + ch.id + "/gen/variant", varOpts[k][0])
          }
        }
      })
      
      genSpecific = (
        <div class="ik-card">
          <div class="ik-card-h">{"meSpeak Vocal"}</div>
          <div style={{ textAlign: "center", fontSize: "11px", color: accent, marginBottom: "8px", fontWeight: "bold" }}>
            {voiceOpts[vIdx][1]} / {varOpts[varIdx][1]}
          </div>
          <div class="ik-knob-grid">
            {voiceKnob}
            {variantKnob}
            {numKnob("Pitch", pitch, 0, 100, 1, "", rt, ch, "pitch", accent)}
            {numKnob("Speed", speed, 50, 400, 1, "wpm", rt, ch, "speed", accent)}
            {numKnob("Gap", wordgap, 0, 10, 1, "", rt, ch, "wordgap", accent)}
          </div>
        </div>
      )
    } else {
      let voice = p.voice !== null ? p.voice : 0
      let rate = p.rate !== null ? p.rate : 1.5
      
      let voiceList = []
      if (typeof window !== "undefined" && window.speechSynthesis) {
        let all = window.speechSynthesis.getVoices()
        let i = 0
        while (i < all.length) {
          if (all[i].lang.indexOf("en-") === 0) {
            voiceList.push(all[i])
          }
          i = i + 1
        }
        if (voiceList.length === 0) {
          voiceList = all
        }
      }

      let voiceFullName = "Voice " + Math.round(voice)
      let voiceShortName = String(Math.round(voice))
      if (voiceList.length > 0) {
        let vidx = Math.round(voice) % voiceList.length
        if (vidx < 0) {
          vidx = vidx + voiceList.length
        }
        let nm = voiceList[vidx].name
        voiceFullName = String(vidx) + ". " + nm
        let shortNm = nm.length > 6 ? nm.substring(0, 5) + ".." : nm
        voiceShortName = String(vidx) + ". " + shortNm
      }

      genSpecific = (
        <div class="ik-card">
          <div class="ik-card-h">{"TTS Voice"}</div>
          <div style={{ padding: "0 8px", fontSize: "11px", color: accent, marginBottom: "8px", textAlign: "center", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }} title={voiceFullName}>
            {voiceFullName}
          </div>
          <div class="ik-knob-grid">
            {InfiniteKnob({
              label: "Voice",
              value: voice,
              step: 1,
              accent: accent,
              fmt: (v) => voiceShortName,
              valueInside: true,
              onInput: (x) => genEmit(rt, ch, "voice", x)
            })}
            {numKnob("Rate", rate, 0.5, 3.0, 0.1, "x", rt, ch, "rate", accent)}
          </div>
        </div>
      )
    }

    let lyricsUi = (
      <div class="ik-card">
        <div class="ik-card-h">{"Quick Lyrics"}</div>
        <div style={{ padding: "0 8px 8px" }}>
          <input
            type="text"
            placeholder="Type words separated by spaces..."
            class="ik-lyrics-input"
            style={{ width: "100%", background: "var(--ik-card-bg)", border: "1px solid " + accent, color: "inherit", padding: "6px", borderRadius: "4px", fontSize: "11px", fontFamily: "monospace", boxSizing: "border-box" }}
            onkeydown={(e) => { e.stopPropagation() }}
            onchange={(e) => applyLyrics(e.target.value)}
          />
          <div style={{ marginTop: "4px", fontSize: "10px", color: "var(--ik-text-dim, #94a3b8)", textAlign: "center" }}>
            Press Enter to map words to active notes
          </div>
        </div>
      </div>
    )

    return (
      <article class="gen-params ik-cols">
        {genSpecific}
        {lyricsUi}
      </article>
    )
  }
  if (id === "arco") {
    let voice = p.voice ? p.voice : "violin"
    let pressure = p.pressure !== null ? p.pressure : 0.5
    let bow = p.bow !== null ? p.bow : 0.4
    let vibrato = p.vibrato !== null ? p.vibrato : 0.35
    let rosin = p.rosin !== null ? p.rosin : 0.3
    let bodyAmt = p.body !== null ? p.body : 0.6
    let voiceOpts = [["violin", "Violin"], ["fiddle", "Fiddle"], ["viola", "Viola"], ["cello", "Cello"], ["bass", "Bass"]]
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Instrument"}</div>
          <div class="ik-knob-grid">
            {genSelectorKnob("Type", voice, voiceOpts, rt, ch, "voice", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Bow"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Pressure", pressure, rt, ch, "pressure", accent)}
            {pctKnob("Articul.", bow, rt, ch, "bow", accent)}
            {pctKnob("Rosin", rosin, rt, ch, "rosin", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Expression"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Vibrato", vibrato, rt, ch, "vibrato", accent)}
            {pctKnob("Body", bodyAmt, rt, ch, "body", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "acid303") {
    let wave = p.waveform !== null ? p.waveform : "sawtooth"
    let cutoff = p.cutoff !== null ? p.cutoff : 800
    let res = p.resonance !== null ? p.resonance : 15
    let envMod = p.envMod !== null ? p.envMod : 4000
    let decay = p.decay !== null ? p.decay : 0.4
    return (
      <article class="gen-params ik-cols">
        {waveCard("Wave", wave, "waveform", rt, ch, accent)}
        <div class="ik-card">
          <div class="ik-card-h">{"Filter & Env"}</div>
          <div class="ik-knob-grid">
            {freqKnob("Cutoff", cutoff, rt, ch, "cutoff", accent)}
            {numKnob("Resonance", res, 1, 30, 0.5, "", rt, ch, "resonance", accent)}
            {freqKnob("Env Mod", envMod, rt, ch, "envMod", accent)}
            {msKnob("Decay", decay, 1.5, rt, ch, "decay", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "sub808") {
    let punch = p.punch !== null ? p.punch : 60
    let decay = p.decay !== null ? p.decay : 1.2
    let drive = p.drive !== null ? p.drive : 0
    let glide = p.glide !== null ? p.glide : 0.05
    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Sub Bass"}</div>
          <div class="ik-knob-grid">
            {numKnob("Punch", punch, 0, 300, 1, "Hz", rt, ch, "punch", accent)}
            {msKnob("Decay", decay, 3.0, rt, ch, "decay", accent)}
            {numKnob("Drive", drive, 0, 100, 1, "%", rt, ch, "drive", accent)}
            {msKnob("Glide", glide, 0.5, rt, ch, "glide", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "chiptune") {
    let wf = p.waveform ? p.waveform : "pulse"
    let pw = p.pulseWidth !== null ? p.pulseWidth : 0.5
    let pwmSpeed = p.pwmSpeed !== null ? p.pwmSpeed : 0
    let crush = p.bitcrush !== null ? p.bitcrush : 0
    let lpAmt = p.lowpass !== null ? p.lowpass : 0
    let arpRate = p.arpRate !== null ? p.arpRate : 0
    let arpSemis = p.arpSemis !== null ? p.arpSemis : 0
    let att = p.attack !== null ? p.attack : 0.005
    let dec = p.decay !== null ? p.decay : 0.3
    let sus = p.sustain !== null ? p.sustain : 0
    let rel = p.release !== null ? p.release : 0.05
    let isPulse = wf === "pulse"
    let pulseKnobs = null
    if (isPulse) {
      pulseKnobs = (
        <div class="ik-knob-grid">
          {pctKnob("Width", pw, rt, ch, "pulseWidth", accent)}
          {numKnob("PWM", pwmSpeed, 0, 10, 0.1, "Hz", rt, ch, "pwmSpeed", accent)}
        </div>
      )
    }
    return (
      <article class="gen-params ik-cols">
        {waveCard("Waveform", wf, "waveform", rt, ch, accent, pulseKnobs, { choices: ["pulse", "triangle", "sawtooth", "noise"] })}
        <div class="ik-card">
          <div class="ik-card-h">{"Character"}</div>
          <div class="ik-knob-grid">
            {pctKnob("Crush", crush, rt, ch, "bitcrush", accent)}
            {pctKnob("Lowpass", lpAmt, rt, ch, "lowpass", accent)}
            {numKnob("Arp Rate", arpRate, 0, 30, 0.5, "Hz", rt, ch, "arpRate", accent)}
            {numKnob("Arp Semi", arpSemis, -12, 12, 1, "st", rt, ch, "arpSemis", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", att, 0.5, rt, ch, "attack", accent)}
            {msKnob("Decay", dec, 1.5, rt, ch, "decay", accent)}
            {pctKnob("Sustain", sus, rt, ch, "sustain", accent)}
            {msKnob("Release", rel, 1.0, rt, ch, "release", accent)}
          </div>
          {EnvDisplay(att, dec, sus, rel, { accent: accent })}
        </div>
      </article>
    )
  }
  if (id === "sn76489") {
    let type = p.type ? p.type : "square"
    let vol = p.vol !== null ? Math.round(p.vol) : 15
    let noiseMode = p.noiseMode ? p.noiseMode : "white"
    let attack = p.attack !== null ? p.attack : 0
    let decay = p.decay !== null ? p.decay : 0.1
    let sustain = p.sustain !== null ? Math.round(p.sustain) : 15
    let release = p.release !== null ? p.release : 0
    
    let pitchDrop = p.pitchDrop !== null ? Math.round(p.pitchDrop) : 0
    let pitchDec = p.pitchDec !== null ? p.pitchDec : 0.05
    let vibRate = p.vibRate !== null ? p.vibRate : 0
    let vibAmt = p.vibAmt !== null ? p.vibAmt : 0
    let arpRate = p.arpRate !== null ? p.arpRate : 0
    let arpSemis = p.arpSemis !== null ? Math.round(p.arpSemis) : 0
    
    let isNoise = type === "noise"

    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"PSG Channel"}</div>
          <div class="ik-knob-grid">
            {genSelectorKnob("Type", type, [["square", "Square"], ["noise", "Noise"]], rt, ch, "type", accent)}
            {genSelectorKnob("Mode", noiseMode, [["white", "White"], ["periodic", "Periodic"]], rt, ch, "noiseMode", accent, !isNoise)}
            {numKnob("Volume", vol, 0, 15, 1, "", rt, ch, "vol", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Att", attack, 2, rt, ch, "attack", accent)}
            {msKnob("Dec", decay, 2, rt, ch, "decay", accent)}
            {numKnob("Sus", sustain, 0, 15, 1, "", rt, ch, "sustain", accent)}
            {msKnob("Rel", release, 5, rt, ch, "release", accent)}
          </div>
        </div>
        {perfMacrosSection(rt, ch, project, setProject, p, accent, isNoise)}
      </article>
    )
  }
  if (id === "spc700") {
    let wf = p.waveform ? p.waveform : "strings"
    let att = p.attack !== null ? Math.round(p.attack) : 0
    let dec = p.decay !== null ? Math.round(p.decay) : 3
    let sus = p.sustainLevel !== null ? Math.round(p.sustainLevel) : 7
    let sr = p.sustainRate !== null ? Math.round(p.sustainRate) : 0
    let echoEn = p.echoEnable === true
    let echoDelay = p.echoDelay !== null ? Math.round(p.echoDelay) : 4
    let echoFb = p.echoFeedback !== null ? Math.round(p.echoFeedback) : 0
    
    let pitchDrop = p.pitchDrop !== null ? Math.round(p.pitchDrop) : 0
    let pitchDec = p.pitchDec !== null ? p.pitchDec : 0.05
    let vibRate = p.vibRate !== null ? p.vibRate : 0
    let vibAmt = p.vibAmt !== null ? p.vibAmt : 0
    let arpRate = p.arpRate !== null ? p.arpRate : 0
    let arpSemis = p.arpSemis !== null ? Math.round(p.arpSemis) : 0

    return (
      <article class="gen-params ik-cols">
        {waveCard("BRR Sample", wf, "waveform", rt, ch, accent, null, { choices: ["strings", "brass", "bass", "sine"] })}
        <div class="ik-card">
          <div class="ik-card-h">{"S-DSP ADSR"}</div>
          <div class="ik-knob-grid">
            {numKnob("Att.R", att, 0, 15, 1, "", rt, ch, "attack", accent)}
            {numKnob("Dec.R", dec, 0, 7, 1, "", rt, ch, "decay", accent)}
            {numKnob("Sus.L", sus, 0, 7, 1, "", rt, ch, "sustainLevel", accent)}
            {numKnob("Sus.R", sr, 0, 31, 1, "", rt, ch, "sustainRate", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Global Echo"}</div>
          <div style={{ marginBottom: "12px", display: "flex", justifyContent: "center" }}>
            {Switch({ label: "Echo", value: echoEn, accent: accent, onInput: (v) => genEmit(rt, ch, "echoEnable", v) })}
          </div>
          <div class="ik-knob-grid">
            {numKnob("EDL", echoDelay, 0, 15, 1, "", rt, ch, "echoDelay", accent, !echoEn)}
            {numKnob("EFB", echoFb, -128, 127, 1, "", rt, ch, "echoFeedback", accent, !echoEn)}
          </div>
        </div>
        {perfMacrosSection(rt, ch, project, setProject, p, accent, false)}
      </article>
    )
  }
  if (id === "gbaDirectSound") {
    let wf = p.waveform ? p.waveform : "pulse"
    let duty = p.duty ? p.duty : "50"
    let att = p.attack !== null ? p.attack : 0
    let dec = p.decay !== null ? p.decay : 2
    let sus = p.sustain !== null ? Math.round(p.sustain) : 15
    let rel = p.release !== null ? p.release : 0
    
    let bitcrush = p.bitcrush !== false && p.bitcrush !== "16bit"
    
    let pitchDrop = p.pitchDrop !== null ? Math.round(p.pitchDrop) : 0
    let pitchDec = p.pitchDec !== null ? p.pitchDec : 0.05
    let vibRate = p.vibRate !== null ? p.vibRate : 0
    let vibAmt = p.vibAmt !== null ? p.vibAmt : 0
    let arpRate = p.arpRate !== null ? p.arpRate : 0
    let arpSemis = p.arpSemis !== null ? Math.round(p.arpSemis) : 0

    return (
      <article class="gen-params ik-cols">
        {waveCard("Software Osc", wf, "waveform", rt, ch, accent, null, { choices: ["pulse", "sawtooth", "triangle", "sine"] })}
        <div class="ik-card">
          <div class="ik-card-h">{"GBA Envelope"}</div>
          <div class="ik-knob-grid">
            {numKnob("Att.s", att, 0, 2, 0.01, "s", rt, ch, "attack", accent)}
            {numKnob("Dec.s", dec, 0, 5, 0.01, "s", rt, ch, "decay", accent)}
            {numKnob("Sus", sus, 0, 15, 1, "", rt, ch, "sustain", accent)}
