          <div class="ik-knob-grid">
            {freqKnob("Cutoff", cut, rt, ch, "cutoff", accent)}
            {numKnob("Resonance", res, 0, 10, 0.1, "", rt, ch, "resonance", accent)}
            {numKnob("Env Amt", fenv, -5000, 5000, 10, "Hz", rt, ch, "filterEnv", accent)}
            {msKnob("Env Decay", fdec, 5.0, rt, ch, "filterDecay", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Amp Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", att, 2.0, rt, ch, "attack", accent)}
            {msKnob("Decay", dec, 2.0, rt, ch, "decay", accent)}
            {numKnob("Sustain", sus, 0, 1, 0.01, "", rt, ch, "sustain", accent)}
            {msKnob("Release", rel, 5.0, rt, ch, "release", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "laserSync") {
    let dr = p.dropRate !== null ? p.dropRate : 0.8
    let da = p.dropAmt !== null ? p.dropAmt : 36
    let sb = p.slaveBase !== null ? p.slaveBase : 18
    let att = p.attack !== null ? p.attack : 0.01
    let dec = p.decay !== null ? p.decay : 0.3

    return (
      <article class="gen-params ik-cols">
        <div class="ik-card">
          <div class="ik-card-h">{"Laser Pitch"}</div>
          <div class="ik-knob-grid">
            {numKnob("Drop Speed", dr, 0, 1, 0.01, "", rt, ch, "dropRate", accent)}
            {numKnob("Drop Range", da, 0, 60, 1, "st", rt, ch, "dropAmt", accent)}
            {numKnob("Slave Pitch", sb, 0, 48, 1, "st", rt, ch, "slaveBase", accent)}
          </div>
        </div>
        <div class="ik-card">
          <div class="ik-card-h">{"Amp Envelope"}</div>
          <div class="ik-knob-grid">
            {msKnob("Attack", att, 1.0, rt, ch, "attack", accent)}
            {msKnob("Decay", dec, 2.0, rt, ch, "decay", accent)}
          </div>
        </div>
      </article>
    )
  }
  if (id === "matrixFm") {
    if (
      !ch.generatorSpec ||
      ch.generatorSpec.kind !== "matrixFm" ||
      !ch.generatorSpec.raw ||
      ch.generatorSpec.raw.length === 0
    ) {
      ch.generatorSpec = parseGenBlock("matrix_fm", defaultMatrixFmRawLines())
      setProject(project)
      if (tplMirrorFlush) {
        tplMirrorFlush()
      }
    }
    return <div class="gen-params" />
  }
  if (id === "patch") {
    if (ch.macroName !== null) {
      return <div class="gen-params" />
    }
    if (
      !ch.generatorSpec ||
      ch.generatorSpec.kind !== "patch" ||
      !ch.generatorSpec.raw ||
      ch.generatorSpec.raw.length === 0
    ) {
      ch.generatorSpec = parseGenBlock("patch", defaultPatchRawLines())
      setProject(project)
      if (tplMirrorFlush) {
        tplMirrorFlush()
      }
    }
    return <div class="gen-params" />
  }
  return <div class="gen-params" />
}
