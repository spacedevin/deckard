import { useState, useRef, useEffect, h, Fragment } from '@tishlang/lattish'
import { projectToJson, projectFromJson } from '../model/Project.tish'
import { loadDefaultDeckardProject } from '../model/ProjectLoad.tish'
import { emitProject, emitLivePlayback } from '../tpl/Emit.tish'
import { CodeDebugView } from './CodeDebugView.tish'
import { migrateProjectGenerators } from '../model/Migrate.tish'
import { ensureAudio, updateMixerFromProject, resyncAllChannelBuses } from '../audio/Engine.tish'
import { transportTick } from '../audio/Playback.tish'
import { secondsPerStep } from '../audio/Scheduler.tish'
import { createIngest } from '../core/Ingest.tish'
import { createEditor } from '../core/Edit.tish'
import { tplLoopResetAll } from '../tpl/LoopState.tish'
import { TransportBar } from './Transport.tish'
import { MasterMixerStrip, ActorMixerStrip, TrackMixerStrip } from './Mixer.tish'
import { collectActorLanes, channelActorLane, ensureActorMixerEntries } from '../model/MixerRouting.tish'
import { ChannelRow } from './ChannelRack.tish'
import { InstrumentPanel } from './InstrumentPanel.tish'
import { InstrumentEditor } from './InstrumentEditor.tish'
import { PatchBayPanel } from './PatchBayPanel.tish'
import { CoDjPanel } from './CoDjPanel.tish'
import { launchSceneDirective, transportDirective } from '../codj/Launch.tish'
import { coDjClockPayload, coDjShouldFollow, coDjClockAlign } from '../codj/Transport.tish'
import {
  PianoRollCanvas,
  PianoRollZoomBar,
  attachPianoRoll,
  drawRackPianoPreview,
  pianoRollVisualSig,
  rackPianoPreviewSig,
  updatePianoRollCtx
} from './PianoRoll.tish'
import { drawScopeCanvas, drawSpectrumCanvas, drawMiniWave } from './Scope.tish'
import { StepGridPanel } from './grid/StepGrid.tish'
import { DeckMixer } from './deck/DeckMixer.tish'
import { PatternBank } from './PatternBank.tish'
import { coDjInitWebMidi } from '../codj/MidiProfiles.tish'
import {
  coDjFlushScheduledForStep,
  coDjStepsPerBar,
  coDjStepsUntilBarBoundary
} from '../codj/Schedule.tish'
import { pruneStaleTracks, coDjTrackExpirySequences } from '../codj/Prune.tish'
import { createDeckardRuntime } from './DeckardRuntime.tish'
import { setChannelGain, setChannelPan, setChannelEq } from '../model/Edits.tish'
import {
  ensureProjectSession,
  sessionArmScene,
  sessionCommitQueued,
  sessionQueueScene,
  sessionPlayingSceneIndex,
  sessionWriteRackToSceneClip,
  sessionWriteRackBarToSceneClip,
  loadSceneIntoRack,
  loadSceneBarIntoRack,
  firstSongScene,
  nextSongScene,
  songStart,
  songAdvance,
  sceneBarLength,
  armSceneWithOverrides,
  mirrorStepToggleToMainClip,
  mirrorClearStepToMainClip
} from '../model/Session.tish'
import { SessionView } from './SessionView.tish'

let initialDeckardBoot = loadDefaultDeckardProject()
if (initialDeckardBoot.errors.length > 0 && typeof console !== "undefined" && console.warn) {
  let ei = 0
  while (ei < initialDeckardBoot.errors.length) {
    console.warn("default TPL L" + String(initialDeckardBoot.errors[ei].line) + ": " + initialDeckardBoot.errors[ei].msg)
    ei = ei + 1
  }
}

let audioStore = {}
let playbackTimer = null
let globalTick = 0
// Lookahead scheduler ("two clocks"): notes are scheduled ahead on the audio clock so timer jitter
// can't drift the audio. nextStepSec = audio-clock time of the step at globalTick; drawQueue feeds the
// rAF visual loop so the playhead lands when the audio actually sounds.
let nextStepSec = 0
let drawQueue = []
let schedRafId = 0
let LOOKAHEAD_SEC = 0.1
// Preview runs on its OWN clock, fully independent of the live (Sequence/Session) transport.
let previewTimer = null
let previewTick = 0
export fn App() {
  let [project, setProject] = useState(initialDeckardBoot.project)
  migrateProjectGenerators(project)
  let tplInit = emitProject(project)
  let [tplText, setTplText] = useState(tplInit)
  let [selectedCh, setSelectedCh] = useState(3)
  let [playing, setPlaying] = useState(false)
  let [previewing, setPreviewing] = useState(false)
  // The live transport's source — "sequence" (FL rack as the live song) or "song" (the session clips).
  // Sequence and Session share ONE clock; toggling between them while playing never restarts it.
  let [playMode, setPlayMode] = useState("song")
  let [workspaceTab, setWorkspaceTab] = useState("sequencer")
  let [sessionUiGen, setSessionUiGen] = useState(0)
  let [seqPromoteUi, setSeqPromoteUi] = useState(0)
  let [gridGen, setGridGen] = useState(0)

  fn bumpSessionUi() {
    setSessionUiGen(sessionUiGen + 1)
  }

  fn touchMixer() {
    updateMixerFromProject(project, audioStore)
  }

  let rtRef = useRef(null)
  if (!rtRef.current) {
    rtRef.current = createDeckardRuntime()
  }
  let rt = rtRef.current
  rt.bumpSeqPromoteUi = () => {
    setSeqPromoteUi((x) => x + 1)
  }
  rt.bumpGrid = () => {
    setGridGen((x) => x + 1)
  }
  rt.touchMixer = touchMixer
  rt.mirrorStepToSessionClip = (ch, si) => {
    mirrorStepToggleToMainClip(ch, si)
  }
  rt.mirrorClearStepToSessionClip = (ch, si) => {
    mirrorClearStepToMainClip(ch, si)
  }
  rt.project = project
  rt.setProject = setProject
  rt.setTplText = setTplText
  rt.selectedCh = selectedCh
  rt.setSelectedCh = setSelectedCh
  rt.playing = playing
  rt.playMode = playMode
  // Launch quantize lives on the project (source of truth) so it round-trips in TPL and syncs to every
  // player via the host snapshot / stream — same value, same UI everywhere. 16 steps = 1 bar default.
  let launchQuant = project.launchQuant != null && Math.floor(Number(project.launchQuant)) >= 1
    ? Math.floor(Number(project.launchQuant))
    : 16
  rt.launchQuantSteps = launchQuant

  // ---- The ONE write door (rearch): ingest + editor. Every UI edit emits a TPL fragment through here
  // instead of mutating `project` directly. Local, co-DJ, and agent all share this gated path. ----
  let storeRef = useRef(null)
  if (!storeRef.current) {
    storeRef.current = { project: project, runtime: rt }
  }
  storeRef.current.project = project
  // Local actor ctx: single-player = "human" (the default-project owner) with master rights; co-DJ
  // overrides coDjActorId / coDjLocalSkillIds when a session assigns a narrower role.
  fn localCtx() {
    let r = rtRef.current
    return {
      actorId: r.coDjActorId ? r.coDjActorId : "human",
      skillIds: r.coDjLocalSkillIds ? r.coDjLocalSkillIds : ["master_mixer"],
      perfStep: r.perfStep != null ? r.perfStep : 0
    }
  }
  let ingestRef = useRef(null)
  if (!ingestRef.current) {
    ingestRef.current = createIngest(storeRef.current)
    // On stream-advance: reconcile audio, re-render, mirror to the TPL editor. (One trigger replaces the
    // scattered setProjectFromUI / gen-counter calls as handlers migrate onto emit.)
    ingestRef.current.onAdvance((v) => {
      let r = rtRef.current
      if (r.project) {
        if (audioStore.ctx) {
          updateMixerFromProject(r.project, audioStore)
        }
        setProject(r.project)
        syncProjectToTplEditor(r.project)
      }
    })
  }
  let editorRef = useRef(null)
  if (!editorRef.current) {
    editorRef.current = createEditor(storeRef.current, ingestRef.current.ingest, localCtx)
  }
  rt.emit = (addr, val) => editorRef.current.emit(addr, val)
  rt.directive = (line) => editorRef.current.directive(line)

  fn setLaunchQuant(q) {
    let v = Math.floor(Number(q))
    if (v < 1 || v !== v) {
      v = 16
    }
    rt.emit("launch_quant", v)
  }

  // Transport hotkeys: Space = Play/Stop Sequence (monitor the rack), Enter = Play/Stop Song (live
  // arrangement). Ignored while typing in an input / textarea / contenteditable.
  useEffect(() => {
    if (typeof window === "undefined") {
      return () => {}
    }
    fn onKey(e) {
      let r = rtRef.current
      if (!r) {
        return
      }
      let tgt = e.target
      let tag = tgt && tgt.tagName ? String(tgt.tagName).toLowerCase() : ""
      if (tag === "input" || tag === "textarea" || tag === "select" || (tgt && tgt.isContentEditable)) {
        return
      }
      if (e.code === "Space" || e.key === " ") {
        // Space = Preview: audition the rack on its own clock (separate from the live transport).
        e.preventDefault()
        if (r.onPreview) {
          r.onPreview()
        }
      } else if (e.key === "Enter") {
        // Enter = live Play / Stop (in the current Sequence/Session mode).
        e.preventDefault()
        if (r.onPlayStop) {
          r.onPlayStop()
        }
      }
    }
    window.addEventListener("keydown", onKey)
    return () => {
      window.removeEventListener("keydown", onKey)
    }
  }, [])

  rt.ensureStreamSeeded = () => {
    if (!rt.coDjWs || rt.coDjWs.readyState !== 1 || !Array.isArray(rt.tplSessionStream) || rt.tplSessionStream.length > 0) {
      return
    }
    let cur = ""
    if (rt.getSongText) {
      cur = rt.getSongText()
    }
    if (!cur || cur.trim().length === 0) {
      return
    }
    let lineArr = cur.split("\n")
    let step = typeof rt.perfStep === "number" ? rt.perfStep : 0
    rt.tplSessionStream.push({ lines: lineArr, effectivePerfStep: step })
  }
  rt.appendStreamedBlock = (lineArray, effectivePerfStep) => {
    if (!lineArray || lineArray.length === 0) {
      return
    }
    rt.tplLastAppliedLineCount = lineArray.length
    rt.tplLastAppliedAt = typeof Date !== "undefined" && Date.now ? Date.now() : 0
    let step = effectivePerfStep
    if (step === undefined || step === null) {
      step = typeof rt.perfStep === "number" ? rt.perfStep : 0
    }
    let streamMode = rt.coDjWs && rt.coDjWs.readyState === 1 && Array.isArray(rt.tplSessionStream)
    if (streamMode) {
      if (!rt.tplSessionStream) {
        rt.tplSessionStream = []
      }
      if (rt.ensureStreamSeeded) {
        rt.ensureStreamSeeded()
      }
      rt.tplSessionStream.push({ lines: lineArray, effectivePerfStep: step })
      let parts = []
      let pi = 0
      while (pi < rt.tplSessionStream.length) {
        parts.push(rt.tplSessionStream[pi].lines.join("\n"))
        pi = pi + 1
      }
      let next = parts.join("\n\n") + "\n"
      setTplText(next)
      if (rt.setSongText) {
        rt.setSongText(next)
      }
    } else {
      setTplText((prev) => {
        let s = prev.trimEnd()
        let sep = s.length > 0 && !s.endsWith("\n") ? "\n\n" : "\n"
        let next = s + sep + lineArray.join("\n") + "\n"
        if (rt.setSongText) {
          rt.setSongText(next)
        }
        return next
      })
    }
  }
  rt.consumePlayedBlocks = (perfStep) => {
    if (!rt.coDjWs || rt.coDjWs.readyState !== 1 || !Array.isArray(rt.tplSessionStream)) {
      return
    }
    let seq = 64
    let arr = rt.tplSessionStream
    let keep = []
    let j = 0
    while (j < arr.length) {
      if (arr[j].effectivePerfStep + seq > perfStep) {
        keep.push(arr[j])
      }
      j = j + 1
    }
    rt.tplSessionStream = keep
    if (keep.length === 0) {
      return
    }
    let parts = []
    let pi = 0
    while (pi < keep.length) {
      parts.push(keep[pi].lines.join("\n"))
      pi = pi + 1
    }
    let next = parts.join("\n\n") + "\n"
    setTplText(next)
    if (rt.setSongText) {
      rt.setSongText(next)
    }
  }

  fn tplMirrorFlush() {
    try {
      let r = rtRef.current
      let p = r.project
      if (!p) {
        return
      }
      let e = emitProject(p)
      setTplText(e)
      setTimeout(() => {
        try {
          let r2 = rtRef.current
          let p2 = r2.project
          if (!p2) {
            return
          }
          let e2 = emitProject(p2)
          if (r2.setSongText) {
            r2.setSongText(e2)
          }
          setTplText(e2)
        } catch (err2) {
          if (typeof console !== "undefined" && console.warn) {
            console.warn("tplMirrorFlush (deferred)", err2)
          }
        }
      }, 0)
    } catch (err) {
      if (typeof console !== "undefined" && console.warn) {
        console.warn("tplMirrorFlush", err)
      }
    }
  }

  fn syncProjectToTplEditor(p) {
    try {
      let e = emitProject(p)
      setTplText(e)
      let r = rtRef.current
      if (r.setSongText) {
        r.setSongText(e)
      }
      r.tplLastHighlightSource = null
    } catch (err) {
      if (typeof console !== "undefined" && console.warn) {
        console.warn("syncProjectToTplEditor", err)
      }
    }
  }

  fn setProjectFromUI(p) {
    setProject(p)
    setTimeout(() => {
      let r = rtRef.current
      let proj = r.project
      if (proj) {
        syncProjectToTplEditor(proj)
      }
    }, 0)
  }
  setTimeout(() => {
    coDjInitWebMidi(project, setProject, rtRef.current)
  }, 100)
  setTimeout(() => {
    let r = rtRef.current
    let pr = document.querySelector(".piano-roll")
    if (pr) {
      let sig = pianoRollVisualSig(project, selectedCh)
      if (r.prSkipRedrawSig !== sig || r.prSkipRedrawEl !== pr) {
        r.prSkipRedrawSig = sig
        r.prSkipRedrawEl = pr
        attachPianoRoll(pr, project, selectedCh, setProjectFromUI)
      } else {
        updatePianoRollCtx(pr, project, selectedCh, setProjectFromUI)
      }
    }
    if (!r.rackPrSigCache) {
      r.rackPrSigCache = []
    }
    if (!r.rackPrNode) {
      r.rackPrNode = []
    }
    let rpi = 0
    while (rpi < project.channels.length) {
      let rackCv = document.getElementById("rack-pr-" + String(rpi))
      if (rackCv) {
        let rsig = rackPianoPreviewSig(project.channels[rpi])
        if (r.rackPrSigCache[rpi] !== rsig || r.rackPrNode[rpi] !== rackCv) {
          r.rackPrSigCache[rpi] = rsig
          r.rackPrNode[rpi] = rackCv
          drawRackPianoPreview(rackCv, project.channels[rpi])
        }
      }
      rpi = rpi + 1
    }
  }, 0)

  if (!rt.dawScopeStarted) {
    rt.dawScopeStarted = true
    fn scopeFrame() {
      if (audioStore.analyser) {
        let spec = document.querySelector(".dk-spectrum")
        if (spec) {
          drawSpectrumCanvas(spec, audioStore.analyser, "#f97316")
        }
      }
      if (audioStore.buses) {
        let wi = 0
        while (wi < audioStore.buses.length) {
          let cv = document.querySelector(".dk-wave-" + String(wi))
          let bus = audioStore.buses[wi]
          if (cv && bus && bus.analyser) {
            let col = cv.closest && cv.closest(".dk-deck-b") ? "#e879f9" : "#22d3ee"
            drawMiniWave(cv, bus.analyser, col)
          }
          wi = wi + 1
        }
      }
      requestAnimationFrame(scopeFrame)
    }
    requestAnimationFrame(scopeFrame)
  }

  // mode: "sequence" = play the rack / pattern you are editing (monitor); "song" = play the live
  // arrangement of launched patterns (session arming). Space → sequence, Enter → song.
  fn onPlay(mode, startTick, songScene) {
    let pm = mode === "song" ? "song" : "sequence"
    rt.playMode = pm
    setPlayMode(pm)
    ensureAudio(project, audioStore)
    updateMixerFromProject(project, audioStore)
    let ctx = audioStore.ctx
    if (playbackTimer) {
      clearTimeout(playbackTimer)
    }
    // A follower joining a song mid-flight starts at the host's playhead so it lands on the same bar.
    globalTick = startTick != null && Math.floor(Number(startTick)) >= 0 ? Math.floor(Number(startTick)) : 0
    tplLoopResetAll()
    if (pm === "song") {
      // A song starts at the head of the explicit arrangement (or the first saved pattern when none is
      // set) and auto-advances through it (see playbackTick). Per-track clip overrides are honoured on
      // top of each scene. songStart seeds the song cursor (rt.songPos) for repeat-aware advancing.
      rt.songStopRequested = false
      // Launching a specific scene (LAUNCH / clip click) goes live on THAT scene; a plain Play Song
      // starts at the head of the arrangement. Either way the song cursor resets.
      let scn = songStart(project, rt)
      if (songScene != null && Math.floor(Number(songScene)) >= 0) {
        scn = Math.floor(Number(songScene))
        rt.followCount = 0
        rt.songPos = null
        rt.sessionActiveScene = scn
      }
      armSceneWithOverrides(project, rt, scn)
      rt.songScene = scn
      rt.songSceneEndTick = globalTick + sceneBarLength(project, scn) * coDjStepsPerBar()
      // Tell collaborators which pattern this deck starts on, and align the shared song position.
      coDjPushLive(project, rt, globalTick)
      coDjPushControl([transportDirective("song", scn)], 0)
    } else {
      rt.songScene = null
      rt.songSceneEndTick = null
    }
    rt.playing = true
    rt.transportNextTick = globalTick
    // Seed the lookahead cursor a hair ahead of the audio clock; reset perf + visual state.
    nextStepSec = ctx.currentTime + 0.06
    drawQueue = []
    rt.trueBpm = null
    rt.lastPlayedSec = null
    rt.schedUnderruns = 0
    rt.schedMarginMs = LOOKAHEAD_SEC * 1000

    // All the non-audio per-step bookkeeping (session/song advance, co-DJ flush, prune), for ONE step.
    // Pure of timing: `when` is the exact audio-clock time the step sounds; visuals are deferred to the
    // draw loop so they land with the audio, not ~lookahead early.
    fn scheduleStep(p, r, step, when) {
      let barSteps = coDjStepsPerBar()
      let qSteps = typeof r.launchQuantSteps === "number" && r.launchQuantSteps >= 1
        ? Math.floor(r.launchQuantSteps)
        : barSteps
      let onQuant = qSteps > 0 && step % qSteps === 0
      let onBar = barSteps > 0 && step % barSteps === 0
      if ((onQuant || onBar) && p) {
        if (r.playMode === "song") {
          let armedChanged = false
          if (r.sessionQueuePending) {
            if (onQuant && sessionCommitQueued(p, r)) {
              r.trackOverrides = []
              r.trackPending = []
              r.songScene = r.sessionActiveScene
              r.songSceneEndTick = step + sceneBarLength(p, r.songScene) * barSteps
              armedChanged = true
            }
          } else {
            if (onQuant && r.trackPending && r.trackPending.length > 0) {
              if (!r.sessionArmedClipIds) {
                r.sessionArmedClipIds = []
              }
              let pi = 0
              while (pi < r.trackPending.length) {
                let it = r.trackPending[pi]
                r.sessionArmedClipIds[it.t] = it.clip
                pi = pi + 1
              }
              r.trackPending = []
              armedChanged = true
            }
            if (onBar && r.songSceneEndTick != null && step >= r.songSceneEndTick) {
              let cur = r.songScene != null ? r.songScene : 0
              let nxt = songAdvance(p, r, cur)
              if (nxt < 0) {
                r.songStopRequested = true
              } else {
                if (nxt !== cur) {
                  armSceneWithOverrides(p, r, nxt)
                  r.songScene = nxt
                  armedChanged = true
                }
                r.songSceneEndTick = step + sceneBarLength(p, nxt) * barSteps
              }
            }
          }
          if (armedChanged) {
            bumpSessionUi()
            coDjPushLive(p, r, step + barSteps)
          }
        } else if (onQuant) {
          if (sessionCommitQueued(p, r)) {
            bumpSessionUi()
          }
        }
        if (onBar && r.coDjPushClock) {
          r.coDjPushClock(step, r.songScene != null ? r.songScene : null)
        }
      }
      if (step % 64 === 0) {
        if (p && audioStore.buses) {
          let res = pruneStaleTracks(p, audioStore, step, coDjTrackExpirySequences())
          if (res.removedCount > 0 && r.setProject) {
            r.setProject(p)
          }
          if (res.removedCount > 0 && r.setSelectedCh && typeof r.selectedCh === "number" && r.selectedCh >= p.channels.length) {
            r.setSelectedCh(p.channels.length > 0 ? p.channels.length - 1 : 0)
          }
        }
        if (r.consumePlayedBlocks) {
          r.consumePlayedBlocks(step)
        }
      }
      r.perfStep = step
      coDjFlushScheduledForStep(step, r)
      // THE audio: schedule this step's notes at the EXACT audio time `when` (jitter-immune).
      transportTick(r.project, audioStore, step, r, when)
      if (r.sessionQueuePending && r.bumpSeqPromoteUi) {
        r.bumpSeqPromoteUi()
      }
    }

    // The scheduler: on each clock pump, schedule every step whose audio-time is within the lookahead
    // window. nextStepSec advances by secondsPerStep on the AUDIO clock → self-correcting, no drift.
    fn runScheduler() {
      let r = rtRef.current
      if (!r.playing) {
        return
      }
      let ctx2 = audioStore.ctx
      if (!ctx2) {
        return
      }
      let p = r.project
      let now = ctx2.currentTime
      let horizon = now + LOOKAHEAD_SEC
      let safety = 0
      while (nextStepSec < horizon && safety < 256) {
        if (nextStepSec < now) {
          r.schedUnderruns = (r.schedUnderruns != null ? r.schedUnderruns : 0) + 1
        }
        scheduleStep(p, r, globalTick, nextStepSec)
        drawQueue.push({ step: globalTick, when: nextStepSec })
        globalTick = globalTick + 1
        r.transportNextTick = globalTick
        nextStepSec = nextStepSec + secondsPerStep(p && typeof p.bpm === "number" ? p.bpm : 120)
        safety = safety + 1
        if (r.songStopRequested) {
          r.songStopRequested = false
          onStop()
          return
        }
      }
      r.schedMarginMs = (nextStepSec - now) * 1000
      // setTimeout fallback pump only while the worklet clock isn't driving us.
      if (!audioStore.clockNode) {
        if (playbackTimer) {
          clearTimeout(playbackTimer)
        }
        playbackTimer = setTimeout(runScheduler, 25)
      }
    }

    // Visual draw loop (rAF): fire playhead/grid highlights + the perf readout when the audio clock
    // reaches each scheduled step, so visuals track the sound rather than the ~lookahead-early schedule.
    fn drawLoop() {
      let r = rtRef.current
      if (!r.playing) {
        schedRafId = 0
        return
      }
      let ctx2 = audioStore.ctx
      if (ctx2) {
        let now = ctx2.currentTime
        let lastFired = -1
        let keep = []
        let i = 0
        while (i < drawQueue.length) {
          let item = drawQueue[i]
          if (item.when <= now) {
            lastFired = item.step
            if (r.lastPlayedSec != null) {
              let dt = item.when - r.lastPlayedSec
              if (dt > 0.0001) {
                let inst = 60 / (dt * 4)
                r.trueBpm = r.trueBpm != null ? (r.trueBpm * 0.85 + inst * 0.15) : inst
              }
            }
            r.lastPlayedSec = item.when
          } else {
            keep.push(item)
          }
          i = i + 1
        }
        drawQueue = keep
        if (lastFired >= 0) {
          if (r.setPlaybackHighlight) {
            r.setPlaybackHighlight(lastFired % 16, true)
          }
          if (r.updateGridPlayhead) {
            r.updateGridPlayhead(lastFired, true)
          }
        }
        r.drawFrame = (r.drawFrame != null ? r.drawFrame : 0) + 1
        if (r.setBpmReadout && r.drawFrame % 10 === 0) {
          let tgt = r.project && typeof r.project.bpm === "number" ? r.project.bpm : 120
          r.setBpmReadout(tgt, r.trueBpm, r.schedMarginMs, r.schedUnderruns)
        }
      }
      schedRafId = requestAnimationFrame(drawLoop)
    }

    // Pump source: the audio-thread worklet clock if available, else a 25ms setTimeout. The worklet may
    // finish loading mid-play — onClockReady re-binds the pump to it then.
    fn startPump() {
      if (audioStore.clockNode && audioStore.clockNode.port) {
        audioStore.clockNode.port.onmessage = () => {
          runScheduler()
        }
      } else {
        if (playbackTimer) {
          clearTimeout(playbackTimer)
        }
        playbackTimer = setTimeout(runScheduler, 25)
      }
    }
    audioStore.onClockReady = () => {
      if (rtRef.current && rtRef.current.playing) {
        startPump()
      }
    }
    runScheduler()
    startPump()
    if (schedRafId) {
      cancelAnimationFrame(schedRafId)
    }
    schedRafId = requestAnimationFrame(drawLoop)
    setPlaying(true)
    if (rt.coDjNotifyPlaying) {
      rt.coDjNotifyPlaying(true)
    }
    ctx.resume()
  }

  fn onDeckMain(mode) {
    rt.emit("main_deck", mode === "local" ? "local" : "live")
  }

  // Broadcast what is ACTUALLY PLAYING (armed pattern + per-track overrides) to the co-DJ hub, so
  // collaborators hear your launches on your deck lane — not your edit buffer. effStep = the perf step
  // the receiver should apply it from. (Multiplayer model A; see the "shared session" issue for B.)
  fn coDjPushLive(proj, rtObj, effStep) {
    if (!(rtObj && rtObj.coDjWs && rtObj.coDjWs.readyState === 1)) {
      return
    }
    let aid = rtObj.coDjActorId ? rtObj.coDjActorId : (rtObj.coDjClientId ? rtObj.coDjClientId : "actor")
    let text = emitLivePlayback(proj, rtObj)
    let lines = text.split("\n")
    let payload = JSON.stringify({
      type: "tpl.block",
      lines: lines,
      effectivePerfStep: effStep,
      actorId: aid,
      authorId: aid
    })
    rtObj.coDjWs.send(payload)
  }

  // The perf step a launch should land on: the next launch-quantize boundary while playing (so a
  // follower commits the host's launch on the same boundary), else 0 (apply on receipt).
  fn nextLaunchStep() {
    if (!rt.playing) {
      return 0
    }
    let ps = typeof rt.perfStep === "number" ? Math.floor(rt.perfStep) : 0
    let q = rt.launchQuantSteps != null && Math.floor(rt.launchQuantSteps) >= 1 ? Math.floor(rt.launchQuantSteps) : 16
    return (Math.floor(ps / q) + 1) * q
  }

  // Broadcast session-control directives (@ launch / @ transport) to the hub at a quantized step, so
  // every player applies the same launch to their shared arming — same UI, same sound (issue #1, B).
  fn coDjPushControl(directiveLines, effStep) {
    if (!(rt && rt.coDjWs && rt.coDjWs.readyState === 1)) {
      return
    }
    if (!directiveLines || directiveLines.length === 0) {
      return
    }
    let aid = rt.coDjActorId ? rt.coDjActorId : (rt.coDjClientId ? rt.coDjClientId : "actor")
    rt.coDjWs.send(JSON.stringify({
      type: "tpl.block",
      lines: directiveLines,
      effectivePerfStep: effStep,
      actorId: aid,
      authorId: aid
    }))
  }
  rt.coDjPushControl = coDjPushControl
  rt.nextLaunchStep = nextLaunchStep

  // Host clock heartbeat: while the host plays, broadcast the playhead (step + scene) once per bar so
  // followers can lock to it. Only the host emits — followers slave.
  fn coDjPushClock(perfStep, scene) {
    if (!(rt && rt.coDjWs && rt.coDjWs.readyState === 1 && rt.coDjIsHost === true)) {
      return
    }
    let aid = rt.coDjActorId ? rt.coDjActorId : (rt.coDjClientId ? rt.coDjClientId : "actor")
    let bpm = project && typeof project.bpm === "number" ? project.bpm : null
    rt.coDjWs.send(JSON.stringify(coDjClockPayload(aid, perfStep, scene, bpm)))
  }
  rt.coDjPushClock = coDjPushClock

  // Followers call these (from the co-DJ receive path) to slave their transport to the host.
  rt.setTransportTick = (n) => {
    let v = Math.floor(Number(n))
    if (v >= 0 && v === v) {
      globalTick = v
      rt.transportNextTick = v
    }
  }
  rt.getTransportTick = () => {
    return globalTick
  }
  // Start following the host's song at `hostStep`: if stopped, begin playback there; if already playing,
  // just realign the tick. Audio may stay silent until the user interacts (browser gesture policy), but
  // the transport position stays locked so it's in phase the moment audio resumes.
  rt.coDjFollowStart = (hostStep) => {
    if (!coDjShouldFollow(rt)) {
      return
    }
    let step = Math.floor(Number(hostStep))
    if (step < 0 || step !== step) {
      step = 0
    }
    if (!rt.playing) {
      onPlay("song", step)
    } else {
      globalTick = step
      rt.transportNextTick = step
    }
  }
  rt.coDjFollowStop = () => {
    if (coDjShouldFollow(rt) && rt.playing) {
      onStop()
    }
  }
  // Apply a host clock tick: realign the local tick toward the host (snap on large drift).
  rt.coDjApplyClock = (hostStep) => {
    if (!coDjShouldFollow(rt) || !rt.playing) {
      return
    }
    globalTick = coDjClockAlign(globalTick, hostStep, 1)
    rt.transportNextTick = globalTick
  }

  fn curViewBar() {
    return rt.gridViewBar != null ? Math.floor(Number(rt.gridViewBar)) : 0
  }

  // SAVE — copy the current rack (steps / piano / per-bar) into pattern `si`. Edit-only; never plays.
  fn onPatternSave(si) {
    ensureProjectSession(project)
    sessionWriteRackToSceneClip(project, si)
    bumpSessionUi()
    if (rt.playing && rt.bumpSeqPromoteUi) {
      rt.bumpSeqPromoteUi()
    }
    setProjectFromUI(project)
  }

  // SAVE 1 — copy only the bar you're viewing into pattern `si`'s matching bar (others untouched).
  fn onPatternSaveBar(si) {
    ensureProjectSession(project)
    sessionWriteRackBarToSceneClip(project, si, curViewBar())
    bumpSessionUi()
    if (rt.playing && rt.bumpSeqPromoteUi) {
      rt.bumpSeqPromoteUi()
    }
    setProjectFromUI(project)
  }

  // LOAD — pull pattern `si` into the rack so you can see / edit it. Does not arm anything live;
  // in Play Sequence mode this is also what you hear (the rack is the monitored buffer).
  fn onPatternLoad(si) {
    ensureProjectSession(project)
    loadSceneIntoRack(project, si)
    rt.editingScene = si
    if (rt.bumpGrid) {
      rt.bumpGrid()
    }
    bumpSessionUi()
    setProjectFromUI(project)
  }

  // LOAD 1 — pull only pattern `si`'s viewed bar into the rack's current bar (other bars untouched).
  fn onPatternLoadBar(si) {
    ensureProjectSession(project)
    loadSceneBarIntoRack(project, si, curViewBar())
    if (rt.bumpGrid) {
      rt.bumpGrid()
    }
    bumpSessionUi()
    setProjectFromUI(project)
  }

  // LAUNCH — go LIVE on pattern `si`. If a song is already live, queue the swap for the next quantize
  // boundary (no restart). If nothing live is running (stopped, or just previewing the rack), launching
  // STARTS the session live on this scene immediately — launching is a live act, so you hear it.
  fn onPatternLaunch(si) {
    ensureProjectSession(project)
    // A full pattern LAUNCH resets the per-track mix — every track follows this pattern again.
    rt.trackOverrides = []
    rt.trackPending = []
    if (rt.playing && rt.playMode === "song") {
      // Already live — queue the swap (and the co-DJ broadcast) for the next bar.
      sessionQueueScene(project, rt, si)
      coDjPushControl([launchSceneDirective(si)], nextLaunchStep())
    } else {
      // Not live (stopped or previewing) — start the session live on this scene now.
      onPlay("song", 0, si)
    }
    bumpSessionUi()
    if (rt.playing && rt.bumpSeqPromoteUi) {
      rt.bumpSeqPromoteUi()
    }
    setProjectFromUI(project)
  }

  fn onStop() {
    if (rt.coDjNotifyPlaying) {
      rt.coDjNotifyPlaying(false)
    }
    // A master stopping the transport stops the shared session for followers too (apply on receipt).
    coDjPushControl([transportDirective("stop", 0)], 0)
    if (playbackTimer) {
      clearTimeout(playbackTimer)
      playbackTimer = null
    }
    // Tear down the lookahead scheduler's pump + draw loop.
    if (schedRafId) {
      cancelAnimationFrame(schedRafId)
      schedRafId = 0
    }
    if (audioStore.clockNode && audioStore.clockNode.port) {
      audioStore.clockNode.port.onmessage = null
    }
    drawQueue = []
    rt.playing = false
    rt.transportNextTick = null
    if (rt.setPlaybackHighlight) {
      rt.setPlaybackHighlight(0, false)
    }
    if (rt.updateGridPlayhead) {
      rt.updateGridPlayhead(0, false)
    }
    setPlaying(false)
  }
  rt.stopPlayback = onStop
  rt.onPlaySequence = () => onPlay("sequence")
  rt.onPlaySong = () => onPlay("song")

  // Perf debug readout (direct-DOM, no React churn): target vs measured BPM, the scheduler's lookahead
  // buffer margin (headroom before audio underruns), and an underrun count. Colour = health.
  rt.setBpmReadout = (target, trueBpm, marginMs, underruns) => {
    if (typeof document === "undefined") {
      return
    }
    let el = document.querySelector(".bpm-debug")
    if (!el) {
      return
    }
    let tb = trueBpm != null ? Math.round(Number(trueBpm) * 10) / 10 : null
    let mm = marginMs != null ? Math.round(Number(marginMs)) : null
    let ur = underruns != null ? Math.floor(Number(underruns)) : 0
    let txt = "TGT " + String(Math.round(Number(target)))
    txt = txt + " · TRUE " + (tb != null ? String(tb) : "—")
    txt = txt + " · BUF " + (mm != null ? String(mm) + "ms" : "—")
    if (ur > 0) {
      txt = txt + " · ✕" + String(ur)
    }
    el.textContent = txt
    let cls = "bpm-debug ok"
    if (ur > 0) {
      cls = "bpm-debug bad"
    } else if (mm != null && mm < 25) {
      cls = "bpm-debug warn"
    } else if (tb != null && Number(target) - tb > 2) {
      cls = "bpm-debug warn"
    }
    el.className = cls
  }

  // ---- Live transport: Sequence ⟷ Session on ONE shared clock ----------------------------------
  // Toggle the live source. Stopped → just selects what Play uses. Playing → flips the source LIVE on
  // the same running clock (no restart) — the whole point of "Sequence and Session share a clock".
  fn selectPlayMode(pm) {
    let m = pm === "song" ? "song" : "sequence"
    if (m === rt.playMode) {
      return
    }
    rt.playMode = m
    setPlayMode(m)
    if (!rt.playing) {
      return
    }
    if (m === "song") {
      rt.songStopRequested = false
      let scn = songStart(project, rt)
      armSceneWithOverrides(project, rt, scn)
      rt.songScene = scn
      rt.songSceneEndTick = globalTick + sceneBarLength(project, scn) * coDjStepsPerBar()
      coDjPushLive(project, rt, globalTick + coDjStepsPerBar())
      coDjPushControl([transportDirective("song", scn)], 0)
    } else {
      rt.songScene = null
      rt.songSceneEndTick = null
    }
    bumpSessionUi()
  }
  rt.selectPlayMode = selectPlayMode
  // The live Play / Stop button: start in the current mode when stopped, stop when playing.
  fn onPlayStop() {
    if (rt.playing) {
      onStop()
    } else {
      onPlay(rt.playMode)
    }
  }
  rt.onPlayStop = onPlayStop

  // ---- Preview transport: its OWN independent clock, NOT bundled with the live transport ----------
  // Auditions the rack pattern (always sequence rendering) on a separate timer + tick. Starting/stopping
  // it never touches the live Sequence/Session clock, and vice versa.
  fn previewStepMs() {
    let b = project && typeof project.bpm === "number" ? project.bpm : 120
    if (b < 40) { b = 40 }
    if (b > 300) { b = 300 }
    return (60 / b / 4) * 1000
  }
  fn onStopPreview() {
    if (previewTimer) {
      clearTimeout(previewTimer)
      previewTimer = null
    }
    setPreviewing(false)
  }
  fn onPreview() {
    if (previewing) {
      onStopPreview()
      return
    }
    ensureAudio(project, audioStore)
    updateMixerFromProject(project, audioStore)
    if (previewTimer) {
      clearTimeout(previewTimer)
    }
    previewTick = 0
    // A throwaway runtime forced to sequence mode so transportTick renders the rack (ch.steps/pianoNotes).
    let pRt = { playMode: "sequence", playing: true }
    fn previewStep() {
      let r = rtRef.current
      if (!r || !audioStore.ctx) {
        return
      }
      pRt.project = r.project
      transportTick(r.project, audioStore, previewTick, pRt)
      previewTick = previewTick + 1
      previewTimer = setTimeout(previewStep, previewStepMs())
    }
    previewStep()
    setPreviewing(true)
  }
  rt.onPreview = onPreview
  rt.onStopPreview = onStopPreview
  // Deck-set hot-swap: rebuild channel buses on the LIVE audio context so playback continues
  // seamlessly through a set load (no stop / no manual re-Play). No-op until audio has started.
  rt.resyncAudio = () => {
    let p = rtRef.current.project
    resyncAllChannelBuses(p, audioStore)
    updateMixerFromProject(p, audioStore)
  }

  fn onBpmInput(e) {
    let v = Number(e.target.value)
    if (v >= 40 && v <= 240) {
      // UI-as-TPL-client: emit `bpm <v>` through the one write door (no direct project mutation).
      editorRef.current.emit("bpm", v)
    }
  }

  fn onExport() {
    let blob = projectToJson(project)
    let a = document.createElement("a")
    a.setAttribute("href", "data:application/json;charset=utf-8," + encodeURIComponent(blob))
    a.setAttribute("download", "decbard-project.json")
    a.click()
  }

  fn onImport() {
    let s = prompt("Paste full project JSON", "")
    if (s && s.length > 2) {
      try {
        let p = projectFromJson(s)
        migrateProjectGenerators(p)
        setProject(p)
        let r = rtRef.current
        r.prSkipRedrawSig = null
        r.rackPrSigCache = []
        r.rackPrNode = []
        let em = emitProject(p)
        setTplText(em)
        setTimeout(() => {
          let r2 = rtRef.current
          let e2 = emitProject(r2.project)
          if (r2.setSongText) {
            r2.setSongText(e2)
          }
          setTplText(e2)
        }, 0)
      } catch (e) {
        alert("Invalid JSON")
      }
    }
  }

  // Channel mixer edits — emit one `mix` statement through the write door (audio + render follow on
  // stream-advance). No direct project mutation, no manual updateMixerFromProject.
  fn onTrim(idx, e) {
    rt.emit("track/" + project.channels[idx].id + "/mix/gain", Number(e.target.value) / 100)
  }

  fn onTrimCommit() {}

  fn onEq(idx, key, e) {
    rt.emit("track/" + project.channels[idx].id + "/mix/eq_" + key, Number(e.target.value))
  }

  fn onEqCommit() {}

  fn onPan(idx, e) {
    rt.emit("track/" + project.channels[idx].id + "/mix/pan", Number(e.target.value) / 100)
  }

  fn onPanCommit() {}

  ensureActorMixerEntries(project)
  ensureProjectSession(project)

  let seqBarCount = Math.floor(Number(project.session.sceneCount))
  if (seqBarCount < 1 || seqBarCount !== seqBarCount) {
    seqBarCount = 4
  }
  // editingScene = pattern loaded in the rack (LOAD highlight). liveScene = pattern currently armed
  // as the live output / P0 (LAUNCH highlight). queuedScene = a launch waiting for the next bar.
  let editingScene = rt.editingScene != null ? Math.floor(Number(rt.editingScene)) : null
  // While a song plays, the live pattern is the song's current scene (per-track overrides can make the
  // armed clips a hybrid that wouldn't match any single scene); otherwise infer it from the armed clips.
  let liveScene = playing && playMode === "song" && rt.songScene != null
    ? Math.floor(Number(rt.songScene))
    : sessionPlayingSceneIndex(project, rt)
  let queuedScene = rt.sessionQueuedScene
  let queuePending = rt.sessionQueuePending === true && queuedScene != null
  let seqBarPx = launchQuant >= 1 ? Math.floor(launchQuant) : coDjStepsPerBar()
  let seqDropSteps = null
  if (playing && playMode === "song") {
    let nt = rt.transportNextTick
    if (nt !== undefined && nt !== null) {
      seqDropSteps = coDjStepsUntilBarBoundary(nt, seqBarPx)
    }
  }
  let patternBank = {
    count: seqBarCount,
    editingScene: editingScene,
    liveScene: liveScene,
    queuedScene: queuedScene,
    queuePending: queuePending,
    dropSteps: seqDropSteps,
    rev: seqPromoteUi,
    playing: playing,
    playMode: playMode,
    onLoad: onPatternLoad,
    onLoadBar: onPatternLoadBar,
    onSave: onPatternSave,
    onSaveBar: onPatternSaveBar,
    onLaunch: onPatternLaunch,
    viewBar: rt.gridViewBar != null ? Math.floor(Number(rt.gridViewBar)) : 0
  }

  let mainWorkspace = null
  if (workspaceTab === "sequencer") {
    // Sequencer (edit bench) and the session panel side by side. (Patterns side nav hidden for now —
    // its LOAD/SAVE/LAUNCH live on the session scene headers.)
    mainWorkspace = (
      <div class="seq-session-split">
        <div class="seq-split-main">
          {StepGridPanel(project, selectedCh, setProjectFromUI, setSelectedCh, rt)}
        </div>
        <div class="seq-split-session" key={"sv-" + String(sessionUiGen) + "-" + String(seqPromoteUi)}>
          {SessionView(project, rt, setProjectFromUI, playing, bumpSessionUi, patternBank)}
        </div>
      </div>
    )
  } else if (workspaceTab === "patch") {
    mainWorkspace = PatchBayPanel()
  } else {
    mainWorkspace = (
      <Fragment>
        {InstrumentEditor(project, selectedCh, setProjectFromUI, tplMirrorFlush)}
        {InstrumentPanel(project, selectedCh, setProjectFromUI, tplMirrorFlush)}
      </Fragment>
    )
  }

  let tabSeq = workspaceTab === "sequencer" ? "deck-tab deck-tab-active" : "deck-tab"
  let tabPatch = workspaceTab === "patch" ? "deck-tab deck-tab-active" : "deck-tab"
  let tabInstr = workspaceTab === "instrument" ? "deck-tab deck-tab-active" : "deck-tab"

  return <div class="daw-root">
    <header class="daw-header">
      <h1 class="logo">{"Deckard"}</h1>
      {TransportBar(
        project.bpm,
        playing,
        playMode,
        previewing,
        onPreview,
        onPlayStop,
        (m) => selectPlayMode(m),
        onBpmInput,
        onExport,
        onImport,
        project.transportMainDeck !== "local" ? "live" : "local",
        onDeckMain,
        launchQuant,
        (q) => setLaunchQuant(q)
      )}
      <nav class="daw-workspace-tabs">
        <button type="button" class={tabSeq} onclick={() => setWorkspaceTab("sequencer")}>
          {"Sequencer"}
        </button>
        <button type="button" class={tabPatch} onclick={() => setWorkspaceTab("patch")}>
          {"Patch"}
        </button>
        <button type="button" class={tabInstr} onclick={() => setWorkspaceTab("instrument")}>
          {"Instrument"}
        </button>
      </nav>
    </header>
    <div class="daw-body daw-body-stack">
      <div class="daw-main-stack">{mainWorkspace}</div>
      {DeckMixer(project, setProjectFromUI, touchMixer, rt)}
      <div class="daw-bottom-split">
        <div class="daw-bottom-col daw-bottom-codj">{CoDjPanel(project, setProject, tplMirrorFlush, rt)}</div>
        <div class="daw-bottom-col daw-tpl-dock">{CodeDebugView(project, setProject, tplText, setTplText, rt, true)}</div>
      </div>
    </div>
    <footer class="daw-foot">{"TPL: docs/TPL_GRAMMAR.md · ARCH: docs/ARCHITECTURE.md · DEV_NODE: AETHER_LABS"}</footer>
  </div>
}
