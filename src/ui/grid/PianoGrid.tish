// Inline piano rows for a channel — rendered INSIDE the channel rack, directly under the track's
// step row, reusing the step-grid's gutter + 16-cell layout so the step columns line up exactly.
// One cell = a note at (pitch, step) lasting one step; multiple pitches per step = a chord.

import { h } from '@tishlang/lattish'
import { addPianoNote, removePianoNoteAt, promoteChannelToBars } from '../../model/Edits.tish'
import { syncMainClipFromChannel } from '../../model/Session.tish'
import { channelDeck, channelDeckColor } from '../../model/DeckRouting.tish'

let NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]

fn noteName(midi) {
  let n = Math.floor(midi)
  let pc = ((n % 12) + 12) % 12
  let oct = Math.floor(n / 12) - 1
  return NOTE_NAMES[pc] + String(oct)
}

fn isBlackKey(midi) {
  let m = ((Math.floor(midi) % 12) + 12) % 12
  return m === 1 || m === 3 || m === 6 || m === 8 || m === 10
}

fn noteIdxAt(ch, pitch, step) {
  let pn = ch.pianoNotes
  if (!pn) {
    return -1
  }
  let i = 0
  while (i < pn.length) {
    let s = Math.floor(pn[i].startBeat * 4 + 0.0001)
    if (s === step && Math.floor(pn[i].pitch) === pitch) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Fixed ~2-octave window anchored to a STABLE reference pitch so adding/removing notes never shifts
// the grid under the cursor (the old min/max-recenter made every click appear to land on a new row).
// Anchor = the channel's step pitch, or the first piano note if present (stable across edits).
fn pitchWindow(ch) {
  let center = 60
  if (ch.stepPitch != null) {
    center = Math.floor(ch.stepPitch)
  }
  let pn = ch.pianoNotes
  if (pn && pn.length > 0) {
    center = Math.floor(pn[0].pitch)
  }
  let lo = center - 12
  let hi = center + 13
  if (lo < 12) {
    lo = 12
    hi = lo + 25
  }
  if (hi > 108) {
    hi = 108
    lo = hi - 25
  }
  return { lo: lo, hi: hi }
}

fn pianoCell(ch, pitch, col, viewBar, gridBars, project, setProjectFromUI) {
  // col is the on-screen column (0..15) of the viewed bar; map to the channel's own (tiled) pattern.
  let chBars = (ch.patternBars != null && Math.floor(ch.patternBars) >= 1) ? Math.floor(ch.patternBars) : 1
  let local = (viewBar * 16 + col) % (chBars * 16)
  let on = noteIdxAt(ch, pitch, local) >= 0
  let cls = "sg-cell sg-pcell sg-col-" + String(col)
  if (on) {
    cls = cls + " sg-on"
  }
  if (col % 4 === 0) {
    cls = cls + " sg-beat"
  }
  return (
    <button
      type="button"
      class={cls}
      onclick={(e) => {
        e.stopPropagation()
        // Promote to multi-bar so each bar is independent, then edit at the absolute beat.
        promoteChannelToBars(ch, gridBars)
        let cb = (ch.patternBars != null && Math.floor(ch.patternBars) >= 1) ? Math.floor(ch.patternBars) : 1
        let abs = (viewBar * 16 + col) % (cb * 16)
        let idx = noteIdxAt(ch, pitch, abs)
        if (idx >= 0) {
          removePianoNoteAt(ch, idx)
        } else {
          addPianoNote(ch, abs * 0.25, 0.25, pitch, 100)
        }
        syncMainClipFromChannel(ch)
        setProjectFromUI(project)
      }}
    />
  )
}

/** Array of inline piano rows (sg-row variants) for one channel — appended under its step row,
 *  showing the currently-viewed bar (16 columns). */
export fn pianoRowsForChannel(project, ch, setProjectFromUI, viewBar, gridBars) {
  let vb = (viewBar != null && viewBar >= 0) ? Math.floor(viewBar) : 0
  let gb = (gridBars != null && gridBars >= 1) ? Math.floor(gridBars) : 1
  let win = pitchWindow(ch)
  let deckCls = "sg-deck-" + channelDeckColor(project, ch)
  let rows = []
  let p = win.hi
  while (p >= win.lo) {
    let pitch = p
    let cells = []
    let i = 0
    while (i < 16) {
      cells.push(pianoCell(ch, pitch, i, vb, gb, project, setProjectFromUI))
      i = i + 1
    }
    let rowCls = "sg-row sg-prow " + deckCls
    if (isBlackKey(pitch)) {
      rowCls = rowCls + " sg-prow-black"
    }
    let isC = ((pitch % 12) + 12) % 12 === 0
    let gutCls = isC ? "sg-gutter sg-pgut sg-pgut-c" : "sg-gutter sg-pgut"
    rows.push(
      <div class={rowCls}>
        <div class={gutCls}><span class="sg-pkey">{noteName(pitch)}</span></div>
        <div class="sg-cells">{cells}</div>
      </div>
    )
    p = p - 1
  }
  return rows
}
