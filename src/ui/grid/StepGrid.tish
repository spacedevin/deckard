// FL-style channel-rack grid: one row per channel, 16 glowing step cells, a moving playhead column.
// Drum channels (no piano notes) toggle steps directly; melodic channels show a note-density preview
// and click-to-focus. Any track can expand (▸) into an aligned piano roll beneath its step row.
// Deck colour (A = cyan / host, B = magenta / client) ties each row to the deck mixer.

import { h, Fragment } from '@tishlang/lattish'
import { toggleStep, clearStep, setChannelMute, setChannelSolo } from '../../model/Edits.tish'
import { generatorLabelById } from '../../generators/Registry.tish'
import { tplLoopSkipsChannel } from '../../tpl/LoopState.tish'
import { channelDeck } from '../../model/DeckRouting.tish'
import { ensureCoDjMeta, setMasterLock } from '../../codj/CoDjMeta.tish'
import { pianoRowsForChannel } from './PianoGrid.tish'

fn stepHasNote(ch, i) {
  let pn = ch.pianoNotes
  if (!pn || pn.length === 0) {
    return false
  }
  let k = 0
  while (k < pn.length) {
    let s = Math.floor(pn[k].startBeat * 4 + 0.0001)
    if (s === i) {
      return true
    }
    k = k + 1
  }
  return false
}

let SG_NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
fn sgNoteName(midi) {
  let n = Math.floor(midi)
  let pc = ((n % 12) + 12) % 12
  return SG_NOTE_NAMES[pc] + String(Math.floor(n / 12) - 1)
}

/// Number of bars the rack spans = the widest channel pattern (so the bar pager can step through them).
fn gridBarsForProject(project) {
  let mx = 1
  let i = 0
  while (i < project.channels.length) {
    let pb = project.channels[i].patternBars
    if (pb != null && Math.floor(pb) > mx) {
      mx = Math.floor(pb)
    }
    i = i + 1
  }
  if (mx > 16) {
    mx = 16
  }
  return mx
}

/// Is cell i (within the viewed bar) lit for this channel — tiling shorter patterns across the bars.
fn cellOnAtView(ch, i, melodic, viewBar) {
  let chBars = (ch.patternBars != null && Math.floor(ch.patternBars) >= 1) ? Math.floor(ch.patternBars) : 1
  let local = (viewBar * 16 + i) % (chBars * 16)
  if (melodic) {
    return stepHasNote(ch, local)
  }
  return ch.steps[local % 16].on
}

fn deckClass(project, ch) {
  if (channelDeck(project, ch) === "B") {
    return "sg-deck-b"
  }
  return "sg-deck-a"
}

fn StepCell(ch, chIdx, i, melodic, on, project, setProjectFromUI, setSelectedCh, rt) {
  let cls = "sg-cell sg-col-" + String(i)
  if (on) {
    cls = cls + " sg-on"
  }
  if (melodic) {
    cls = cls + " sg-melodic"
  }
  if (i % 4 === 0) {
    cls = cls + " sg-beat"
  }
  if (i % 16 === 0 && i > 0) {
    cls = cls + " sg-barline"
  }
  let stepIdx = i % 16
  return (
    <button
      type="button"
      class={cls}
      title={melodic ? "Melodic — click to edit in piano roll" : "Left: toggle · Right: clear"}
      onclick={(e) => {
        e.stopPropagation()
        if (melodic) {
          if (setSelectedCh) {
            setSelectedCh(chIdx)
          }
          return
        }
        toggleStep(project.channels[chIdx], stepIdx)
        if (rt && rt.mirrorStepToSessionClip) {
          rt.mirrorStepToSessionClip(project.channels[chIdx], stepIdx)
        }
        setProjectFromUI(project)
      }}
      oncontextmenu={(e) => {
        e.preventDefault()
        e.stopPropagation()
        if (melodic) {
          return
        }
        clearStep(project.channels[chIdx], stepIdx)
        if (rt && rt.mirrorClearStepToSessionClip) {
          rt.mirrorClearStepToSessionClip(project.channels[chIdx], stepIdx)
        }
        setProjectFromUI(project)
      }}
    />
  )
}

fn ChannelRowGrid(ch, chIdx, project, setProjectFromUI, selected, setSelectedCh, rt, viewBar) {
  let melodic = ch.pianoNotes && ch.pianoNotes.length > 0
  let cells = []
  let i = 0
  while (i < 16) {
    let on = cellOnAtView(ch, i, melodic, viewBar)
    cells.push(StepCell(ch, chIdx, i, melodic, on, project, setProjectFromUI, setSelectedCh, rt))
    i = i + 1
  }
  // Per-bar root for stepped pitched channels (bass rolls) — shows the note changing as you page bars.
  let barPitch = null
  if (ch.stepPitchByBar && viewBar < ch.stepPitchByBar.length) {
    barPitch = sgNoteName(ch.stepPitchByBar[viewBar])
  }
  let gid = ch.generatorId ? ch.generatorId : "basicOsc"
  ensureCoDjMeta(project)
  let meta = project.coDjMeta.tracks[ch.id]
  let locked = meta != null && meta.masterLock === true
  let rowCls = "sg-row " + deckClass(project, ch)
  if (selected) {
    rowCls = rowCls + " sg-row-sel"
  }
  if (tplLoopSkipsChannel(project, chIdx, rt)) {
    rowCls = rowCls + " sg-row-exhausted"
  }
  let deckBadge = channelDeck(project, ch)
  let expanded = rt != null && rt.gridExpanded != null && rt.gridExpanded[ch.id] === true
  return (
    <div class={rowCls}>
      <div class="sg-gutter">
        <button
          type="button"
          class={expanded ? "sg-exp sg-exp-on" : "sg-exp"}
          title="Expand the piano roll for this track (aligned under its step row)"
          onclick={(e) => {
            e.stopPropagation()
            if (rt) {
              if (!rt.gridExpanded) {
                rt.gridExpanded = {}
              }
              rt.gridExpanded[ch.id] = !(rt.gridExpanded[ch.id] === true)
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          {expanded ? "▾" : "▸"}
        </button>
        <div class="sg-gutter-main" onclick={() => setSelectedCh(chIdx)} title="Select channel">
          <span class="sg-ch-name">{ch.name}{barPitch !== null ? <span class="sg-ch-rootpitch">{barPitch}</span> : null}</span>
          <span class="sg-ch-instr">{generatorLabelById(gid)}</span>
        </div>
        <div class="sg-gutter-ctl">
          <button
            type="button"
            class="sg-deck-chip"
            title="Deck A = host · Deck B = client. Click to hand this channel to the other deck."
            onclick={(e) => {
              e.stopPropagation()
              ch.actorLane = channelDeck(project, ch) === "B" ? "" : "client"
              setProjectFromUI(project)
              if (rt && rt.touchMixer) {
                rt.touchMixer()
              }
            }}
          >
            {deckBadge}
          </button>
          <button
            type="button"
            class={ch.mute ? "sg-tog sg-tog-on" : "sg-tog"}
            title="Mute"
            onclick={(e) => {
              e.stopPropagation()
              setChannelMute(ch, !ch.mute)
              setProjectFromUI(project)
            }}
          >
            {"M"}
          </button>
          <button
            type="button"
            class={ch.solo ? "sg-tog sg-tog-solo" : "sg-tog"}
            title="Solo"
            onclick={(e) => {
              e.stopPropagation()
              setChannelSolo(ch, !ch.solo)
              setProjectFromUI(project)
            }}
          >
            {"S"}
          </button>
          <button
            type="button"
            class={locked ? "sg-tog sg-tog-lock" : "sg-tog"}
            title="Master-lock (agents can't overwrite)"
            onclick={(e) => {
              e.stopPropagation()
              setMasterLock(project, ch.id, !locked)
              setProjectFromUI(project)
            }}
          >
            {"L"}
          </button>
        </div>
      </div>
      <div class="sg-cells">{cells}</div>
    </div>
  )
}

/** Direct-DOM playhead: highlight the active step column only when the VIEWED bar is the one playing,
 *  and mark which bar-pager button is currently sounding — all without a React re-render. */
fn applyGridPlayhead(step, playing, gridBars, viewBar) {
  if (typeof document === "undefined") {
    return
  }
  let prev = document.querySelectorAll(".sg-col-active")
  let i = 0
  while (i < prev.length) {
    prev[i].classList.remove("sg-col-active")
    i = i + 1
  }
  let pbPrev = document.querySelectorAll(".sg-barbtn-playing")
  let pi = 0
  while (pi < pbPrev.length) {
    pbPrev[pi].classList.remove("sg-barbtn-playing")
    pi = pi + 1
  }
  if (!playing) {
    return
  }
  let nbars = (gridBars != null && gridBars >= 1) ? gridBars : 1
  let vb = (viewBar != null && viewBar >= 0) ? viewBar : 0
  let playingBar = Math.floor(Math.floor(step) / 16) % nbars
  let colInBar = Math.floor(step) % 16
  // Mark the pager button for the sounding bar (so you see the progression move even off-screen).
  let btn = document.querySelectorAll(".sg-barbtn-" + String(playingBar))
  let bj = 0
  while (bj < btn.length) {
    btn[bj].classList.add("sg-barbtn-playing")
    bj = bj + 1
  }
  if (playingBar !== vb) {
    return
  }
  let cur = document.querySelectorAll(".sg-col-" + String(colInBar))
  let j = 0
  while (j < cur.length) {
    cur[j].classList.add("sg-col-active")
    j = j + 1
  }
}

export fn StepGridPanel(project, selectedCh, setProjectFromUI, setSelectedCh, rt) {
  let gridBars = gridBarsForProject(project)
  let viewBar = 0
  if (rt != null && rt.gridViewBar != null) {
    viewBar = Math.floor(rt.gridViewBar)
  }
  if (viewBar >= gridBars) {
    viewBar = gridBars - 1
  }
  if (viewBar < 0) {
    viewBar = 0
  }
  if (rt) {
    rt.gridViewBar = viewBar
    rt.gridBars = gridBars
    rt.updateGridPlayhead = (step, playing) => {
      applyGridPlayhead(step, playing, gridBars, viewBar)
    }
  }
  let rows = []
  let ci = 0
  while (ci < project.channels.length) {
    let ch = project.channels[ci]
    rows.push(ChannelRowGrid(ch, ci, project, setProjectFromUI, ci === selectedCh, setSelectedCh, rt, viewBar))
    let expanded = rt != null && rt.gridExpanded != null && rt.gridExpanded[ch.id] === true
    if (expanded) {
      let prows = pianoRowsForChannel(project, ch, setProjectFromUI, viewBar)
      let k = 0
      while (k < prows.length) {
        rows.push(prows[k])
        k = k + 1
      }
    }
    ci = ci + 1
  }
  // Bar pager — view one bar at a time, page through a multi-bar progression.
  let pager = []
  if (gridBars > 1) {
    let b = 0
    while (b < gridBars) {
      let bb = b
      let pcls = "sg-barbtn sg-barbtn-" + String(b)
      if (b === viewBar) {
        pcls = pcls + " sg-barbtn-active"
      }
      pager.push(
        <button
          type="button"
          class={pcls}
          key={"bar-" + String(b)}
          title={"View bar " + String(b + 1)}
          onclick={() => {
            if (rt) {
              rt.gridViewBar = bb
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          {String(b + 1)}
        </button>
      )
      b = b + 1
    }
  }
  let ruler = []
  let r = 0
  while (r < 16) {
    let rc = r % 4 === 0 ? "sg-tick sg-tick-beat" : "sg-tick"
    ruler.push(<div class={rc}>{String(r + 1)}</div>)
    r = r + 1
  }
  // Re-apply the playhead after this (re)render.
  if (rt && typeof setTimeout !== "undefined") {
    setTimeout(() => {
      let st = typeof rt.playbackUiStep === "number" ? rt.playbackUiStep : 0
      applyGridPlayhead(st, rt.playing === true, gridBars, viewBar)
    }, 0)
  }
  return (
    <section class="panel sg-panel">
      <div class="sg-head">
        <h2>{"SEQUENCER // CHANNEL RACK"}</h2>
        <span class="sg-head-hint">{"Left: toggle · Right: clear · ▸ expand any track into its piano roll"}</span>
      </div>
      {gridBars > 1 ? (
        <div
          class="sg-barpager"
          title="Shift + scroll to page through bars"
          onwheel={(e) => {
            if (!e.shiftKey || !rt) {
              return
            }
            e.preventDefault()
            let amt = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX
            if (amt === 0) {
              return
            }
            let cur = rt.gridViewBar != null ? Math.floor(rt.gridViewBar) : 0
            let next = cur + (amt > 0 ? 1 : -1)
            if (next < 0) {
              next = 0
            }
            if (next > gridBars - 1) {
              next = gridBars - 1
            }
            if (next !== cur) {
              rt.gridViewBar = next
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          <span class="sg-barpager-label">{"BAR"}</span>
          {pager}
        </div>
      ) : null}
      <div class="sg-grid">{rows}</div>
      <div class="sg-ruler">
        <div class="sg-ruler-pad" />
        <div class="sg-ruler-ticks">{ruler}</div>
      </div>
    </section>
  )
}
