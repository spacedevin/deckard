// FL-style channel-rack grid: one row per channel, 16 glowing step cells, a moving playhead column.
// Drum channels (no piano notes) toggle steps directly; melodic channels show a note-density preview
// and click-to-focus. Any track can expand (▸) into an aligned piano roll beneath its step row.
// Deck colour (A = cyan / host, B = magenta / client) ties each row to the deck mixer.

import { h, Fragment } from '@tishlang/lattish'
import { toggleStep, clearStep, setChannelMute, setChannelSolo, promoteChannelToBars, addPianoNote, removePianoNoteAt } from '../../model/Edits.tish'
import { syncMainClipFromChannel } from '../../model/Session.tish'
import { generatorLabelById } from '../../generators/Registry.tish'
import { tplLoopSkipsChannel } from '../../tpl/LoopState.tish'
import { setRackBars } from '../../model/RackBars.tish'
import { channelDeck, channelDeckColor } from '../../model/DeckRouting.tish'
import { scaleRootNames, scaleModeNames } from '../../model/Scale.tish'
import { euclidSteps, reseedSteps, mutateSteps, humanizeSteps, sprinkleProbability } from '../../model/Generative.tish'
import { euclidNotes, reseedNotes, mutateNotes, humanizeNotes, sprinkleNoteProbability, notePitchForChannel, notesAfterFirstBar } from '../../model/Generative.tish'
import { defaultAutoParam, autoLaneValues, autoNorm, autoDenorm } from '../../model/AutoParams.tish'
import { ensureCoDjMeta, setMasterLock } from '../../codj/CoDjMeta.tish'
import { pianoRowsForChannel } from './PianoGrid.tish'
import { PanelHeader } from '../PresetBar.tish'

fn stepHasNote(ch, i) {
  let pn = ch.pianoNotes
  if (!pn || pn.length === 0) {
    return false
  }
  let k = 0
  while (k < pn.length) {
    let s = Math.floor(pn[k].startBeat * 4 + 0.0001)
    if (s === i) {
      return true
    }
    k = k + 1
  }
  return false
}

let SG_NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
fn sgNoteName(midi) {
  let n = Math.floor(midi)
  let pc = ((n % 12) + 12) % 12
  return SG_NOTE_NAMES[pc] + String(Math.floor(n / 12) - 1)
}

/// Number of bars the rack spans = the widest channel pattern (so the bar pager can step through them).
fn gridBarsForProject(project) {
  let mx = 1
  let i = 0
  while (i < project.channels.length) {
    let pb = project.channels[i].patternBars
    if (pb != null && Math.floor(pb) > mx) {
      mx = Math.floor(pb)
    }
    i = i + 1
  }
  if (mx > 16) {
    mx = 16
  }
  return mx
}

/// Is cell i (within the viewed bar) lit for this channel — tiling shorter patterns across the bars.
fn cellOnAtView(ch, i, melodic, viewBar) {
  let chBars = (ch.patternBars != null && Math.floor(ch.patternBars) >= 1) ? Math.floor(ch.patternBars) : 1
  let local = (viewBar * 16 + i) % (chBars * 16)
  if (melodic) {
    return stepHasNote(ch, local)
  }
  if (local < ch.steps.length) {
    return ch.steps[local].on
  }
  return ch.steps[local % 16].on
}

fn deckClass(project, ch) {
  return "sg-deck-" + channelDeckColor(project, ch)
}

// Compact label for the SCALE mode dropdown (the grammar tokens are verbose).
fn scaleModeLabel(m) {
  if (m === "major") {
    return "major"
  }
  if (m === "minor") {
    return "minor"
  }
  if (m === "harmonic_minor") {
    return "harm min"
  }
  if (m === "melodic_minor") {
    return "mel min"
  }
  if (m === "pentatonic_major") {
    return "penta maj"
  }
  if (m === "pentatonic_minor") {
    return "penta min"
  }
  return m
}

// A melodic channel whose notes all share ONE pitch plays like a normal step sequencer locked to that
// note. Returns the pitch (remembered on ch.soloNotePitch so it survives emptying), or null when the
// channel carries a real (multi-pitch) melody — those still open the piano roll for editing.
fn singleNotePitch(ch) {
  let pn = ch.pianoNotes
  if (pn && pn.length > 0) {
    let p0 = pn[0].pitch
    let i = 1
    while (i < pn.length) {
      if (pn[i].pitch !== p0) {
        return null
      }
      i = i + 1
    }
    ch.soloNotePitch = p0
    return p0
  }
  if (ch.soloNotePitch != null) {
    return ch.soloNotePitch
  }
  return null
}

fn noteIdxAtStep(ch, pitch, step) {
  let pn = ch.pianoNotes
  if (!pn) {
    return -1
  }
  let i = 0
  while (i < pn.length) {
    let s = Math.floor(pn[i].startBeat * 4 + 0.0001)
    if (s === step && pn[i].pitch === pitch) {
      return i
    }
    i = i + 1
  }
  return -1
}

// ---- Per-step PARAMETER LOCKS (velocity / probability / ratchet / nudge) --------------------------------
// Live + multiplayer-safe: every lock edit re-emits the WHOLE pattern as ONE TPL statement through
// rt.emit("track/<id>/pattern", stepsArray) — the same gated, broadcast, round-trip door a fader uses. No
// direct model mutation (the grid stays a pure TPL client; the anti-spaghetti ratchet stays clean).
fn lockLaneCfg(field) {
  if (field === "vel") {
    return { label: "VEL", lo: 1, hi: 127, dflt: 100, bip: false }
  }
  if (field === "prob") {
    return { label: "PRB", lo: 0, hi: 1, dflt: 1, bip: false }
  }
  if (field === "ratchet") {
    return { label: "RCH", lo: 1, hi: 8, dflt: 1, bip: false }
  }
  if (field === "lyric") {
    return { label: "LYR", lo: 0, hi: 1, dflt: "", bip: false }
  }
  return { label: "NDG", lo: -0.5, hi: 0.5, dflt: 0, bip: true }
}

fn quantizeLock(field, v) {
  if (field === "vel") {
    let n = Math.round(v)
    return n < 1 ? 1 : (n > 127 ? 127 : n)
  }
  if (field === "ratchet") {
    let n = Math.round(v)
    return n < 1 ? 1 : (n > 8 ? 8 : n)
  }
  if (field === "prob") {
    let n = Math.round(v * 20) / 20
    return n < 0 ? 0 : (n > 1 ? 1 : n)
  }
  let n = Math.round(v * 20) / 20
  return n < -0.5 ? -0.5 : (n > 0.5 ? 0.5 : n)
}

fn stepLockVal(st, field) {
  if (!st || st[field] == null) {
    return lockLaneCfg(field).dflt
  }
  return st[field]
}

// Clone the channel's steps (NEVER mutate the project) with one cell's field replaced, then emit the pattern.
fn emitStepLock(rt, project, chIdx, stepIdx, field, value) {
  if (!rt || !rt.emit) {
    return
  }
  let ch = project.channels[chIdx]
  if (!ch || !ch.steps) {
    return
  }
  let arr = []
  let i = 0
  while (i < ch.steps.length) {
    let s = ch.steps[i]
    arr.push({
      on: s.on === true,
      vel: s.vel != null ? s.vel : 100,
      prob: s.prob != null ? s.prob : 1,
      ratchet: s.ratchet != null ? s.ratchet : 1,
      nudge: s.nudge != null ? s.nudge : 0,
      lyric: s.lyric != null ? s.lyric : ""
    })
    i = i + 1
  }
  if (stepIdx >= 0 && stepIdx < arr.length) {
    arr[stepIdx][field] = value
  }
  rt.emit("track/" + ch.id + "/pattern", arr)
}

// Projectional step toggle: flip (or force-off) one step and emit the WHOLE pattern through the gated door,
// so a grid click becomes a real TPL statement that round-trips to the editor AND broadcasts to co-DJ peers
// (the old toggleStep path mutated locally + never reached ingest, so peers never saw step edits). Returns
// false when it can't take the projectional path (multi-bar pattern — the `steps` emit is bar-1 only — so the
// caller falls back to the legacy direct edit).
fn emitStepToggle(rt, project, chIdx, stepIdx, forceOff) {
  if (!rt || !rt.emit) {
    return false
  }
  let ch = project.channels[chIdx]
  if (!ch || !ch.steps || stepIdx < 0 || stepIdx >= 16) {
    return false
  }
  let arr = []
  let i = 0
  while (i < ch.steps.length) {
    let s = ch.steps[i]
    arr.push({
      on: s.on === true,
      vel: s.vel != null ? s.vel : 100,
      prob: s.prob != null ? s.prob : 1,
      ratchet: s.ratchet != null ? s.ratchet : 1,
      nudge: s.nudge != null ? s.nudge : 0,
      lyric: s.lyric != null ? s.lyric : ""
    })
    i = i + 1
  }
  arr[stepIdx].on = forceOff ? false : !(arr[stepIdx].on === true)
  rt.emit("track/" + ch.id + "/pattern", arr)
  return true
}

// Set one step to an explicit on/off value (for click-drag PAINT) through the gated pattern door. Coalesced:
// no-ops when the step is already at that value, so a fast drag is a few statements, not one per pointer pixel.
// 1-bar only (the pattern door is bar-1); painting bars 2+ is a no-op (view bar 1 to paint a tiled pattern).
fn paintStep(rt, project, chIdx, absStep, value) {
  if (absStep < 0 || absStep >= 16) {
    return
  }
  let ch = project.channels[chIdx]
  if (!ch || !ch.steps || absStep >= ch.steps.length) {
    return
  }
  if (ch.steps[absStep].on === value) {
    return
  }
  let arr = []
  let i = 0
  while (i < ch.steps.length) {
    let s = ch.steps[i]
    arr.push({
      on: s.on === true,
      vel: s.vel != null ? s.vel : 100,
      prob: s.prob != null ? s.prob : 1,
      ratchet: s.ratchet != null ? s.ratchet : 1,
      nudge: s.nudge != null ? s.nudge : 0,
      lyric: s.lyric != null ? s.lyric : ""
    })
    i = i + 1
  }
  arr[absStep].on = value
  if (rt && rt.emit) {
    rt.emit("track/" + ch.id + "/pattern", arr)
  }
}

// Click-drag paint: mousedown picks the target value (toggle the first cell), then every boolean step cell the
// pointer enters IN THE SAME CHANNEL gets painted that value. Cells carry data-pch / data-pstep so the
// document-level move handler can resolve which step is under the cursor.
fn stepPaintDown(e, rt, project, chIdx, absStep, curOn) {
  e.stopPropagation()
  if (e.preventDefault) {
    e.preventDefault()
  }
  let value = !curOn
  paintStep(rt, project, chIdx, absStep, value)
  fn onMove(ev) {
    let el = document.elementFromPoint(ev.clientX, ev.clientY)
    if (!el) {
      return
    }
    let cell = el.closest ? el.closest(".sg-cell") : null
    if (!cell || !cell.id || cell.id.indexOf("sgc-") !== 0) {
      return
    }
    let parts = cell.id.substring(4).split("-")
    if (parts.length < 2) {
      return
    }
    if (Math.floor(Number(parts[0])) !== chIdx) {
      return
    }
    paintStep(rt, project, chIdx, Math.floor(Number(parts[1])), value)
  }
  fn onUp() {
    document.removeEventListener("mousemove", onMove)
    document.removeEventListener("mouseup", onUp)
  }
  document.addEventListener("mousemove", onMove)
  document.addEventListener("mouseup", onUp)
}

// Generative row mode: a whole-pattern transform (euclid / reseed / mutate / humanize / sprinkle) emitted
// through the SAME gated pattern door, so the generated pattern broadcasts to peers + round-trips. Generation
// runs once here (Math.random) and peers receive the realized steps — no per-client divergence.
fn emitGenerated(rt, project, chIdx, arr) {
  if (!rt || !rt.emit || arr == null) {
    return
  }
  let ch = project.channels[chIdx]
  if (!ch) {
    return
  }
  rt.emit("track/" + ch.id + "/pattern", arr)
  if (rt.bumpGrid) {
    rt.bumpGrid()
  }
}

// The same generative actions, but for MELODIC channels they author NOTES (emitted through the notes door)
// instead of steps — so EUCLID/RESEED/MUTATE/HUMAN/PROB work everywhere, not just on drum/step rows.
fn emitGeneratedNotes(rt, project, chIdx, arr) {
  if (!rt || !rt.emit || arr == null) {
    return
  }
  let ch = project.channels[chIdx]
  if (!ch) {
    return
  }
  rt.emit("track/" + ch.id + "/notes", arr)
  if (rt.bumpGrid) {
    rt.bumpGrid()
  }
}

fn isMelodicCh(ch) {
  return (ch.pianoNotes && ch.pianoNotes.length > 0) || singleNotePitch(ch) != null
}

// Append the channel's bars-2+ notes to a freshly-generated bar-1 array (so a rhythm regen keeps later bars).
fn withLaterBars(arr, ch) {
  let later = notesAfterFirstBar(ch.pianoNotes)
  let li = 0
  while (li < later.length) {
    arr.push(later[li])
    li = li + 1
  }
  return arr
}

// Each generative action dispatches: step channel → step transform via the pattern door; melodic/single-note
// channel → note transform via the notes door.
fn genClear(rt, project, chIdx, ch) {
  if (isMelodicCh(ch)) {
    emitGeneratedNotes(rt, project, chIdx, notesAfterFirstBar(ch.pianoNotes))
  } else {
    emitGenerated(rt, project, chIdx, euclidSteps(0, 0, ch.steps))
  }
}

fn genEuclid(rt, project, chIdx, ch, hits) {
  if (isMelodicCh(ch)) {
    emitGeneratedNotes(rt, project, chIdx, withLaterBars(euclidNotes(hits, 0, notePitchForChannel(ch)), ch))
  } else {
    emitGenerated(rt, project, chIdx, euclidSteps(hits, 0, ch.steps))
  }
}

fn genReseed(rt, project, chIdx, ch) {
  if (isMelodicCh(ch)) {
    emitGeneratedNotes(rt, project, chIdx, withLaterBars(reseedNotes(Math.random, notePitchForChannel(ch)), ch))
  } else {
    emitGenerated(rt, project, chIdx, reseedSteps(Math.random, ch.steps))
  }
}

fn genMutate(rt, project, chIdx, ch) {
  if (isMelodicCh(ch)) {
    emitGeneratedNotes(rt, project, chIdx, mutateNotes(ch.pianoNotes, Math.random, 0.18, notePitchForChannel(ch)))
  } else {
    emitGenerated(rt, project, chIdx, mutateSteps(ch.steps, Math.random, 0.18))
  }
}

fn genHumanize(rt, project, chIdx, ch) {
  if (isMelodicCh(ch)) {
    emitGeneratedNotes(rt, project, chIdx, humanizeNotes(ch.pianoNotes, Math.random, 22))
  } else {
    emitGenerated(rt, project, chIdx, humanizeSteps(ch.steps, Math.random, 22))
  }
}

fn genProb(rt, project, chIdx, ch) {
  if (isMelodicCh(ch)) {
    emitGeneratedNotes(rt, project, chIdx, sprinkleNoteProbability(ch.pianoNotes, Math.random, 0.5))
  } else {
    emitGenerated(rt, project, chIdx, sprinkleProbability(ch.steps, Math.random, 0.5))
  }
}

// Vertical drag on a lock-lane cell: top = max, bottom = min. Coalesced (only emits when the quantized value
// changes) so a drag is a handful of pattern statements, not one per pixel.
// Generic "DRAW ACROSS A LANE" gesture: press on any lane cell and sweep — every cell the pointer enters that
// shares the lane's id `prefix` gets `applyAt(stepNum, py)` called (py = pointer height over THAT cell, 0=top).
// So you draw a velocity ramp / probability shape / automation curve in one stroke. Same-lane only (the prefix
// gate keeps a VEL sweep from bleeding into the PRB row). Cells carry id `<prefix><stepNum>`.
fn runLaneDraw(e, prefix, applyAt) {
  e.stopPropagation()
  if (e.preventDefault) {
    e.preventDefault()
  }
  fn fire(cell, clientY) {
    if (!cell || !cell.id || cell.id.indexOf(prefix) !== 0) {
      return
    }
    let stepNum = Math.floor(Number(cell.id.substring(prefix.length)))
    if (stepNum !== stepNum) {
      return
    }
    let r = cell.getBoundingClientRect()
    let py = r.height > 0 ? (clientY - r.top) / r.height : 0
    if (py < 0) {
      py = 0
    }
    if (py > 1) {
      py = 1
    }
    applyAt(stepNum, py)
  }
  fire(e.currentTarget, e.clientY)
  fn onMove(ev) {
    let el = document.elementFromPoint(ev.clientX, ev.clientY)
    let cell = (el && el.closest) ? el.closest(".sg-lk-cell") : null
    fire(cell, ev.clientY)
  }
  fn onUp() {
    document.removeEventListener("mousemove", onMove)
    document.removeEventListener("mouseup", onUp)
  }
  document.addEventListener("mousemove", onMove)
  document.addEventListener("mouseup", onUp)
}

fn lockCellDown(e, rt, project, chIdx, field) {
  let cfg = lockLaneCfg(field)
  let lastByStep = {}
  runLaneDraw(e, "lk-" + String(chIdx) + "-" + field + "-", (stepIdx, py) => {
    let v = quantizeLock(field, cfg.lo + (1 - py) * (cfg.hi - cfg.lo))
    if (lastByStep[stepIdx] !== v) {
      lastByStep[stepIdx] = v
      emitStepLock(rt, project, chIdx, stepIdx, field, v)
    }
  })
}

fn LockLaneCell(project, chIdx, i, field, rt, st) {
  let cfg = lockLaneCfg(field)
  let v = stepLockVal(st, field)
  let frac = (v - cfg.lo) / (cfg.hi - cfg.lo)
  if (frac < 0) {
    frac = 0
  }
  if (frac > 1) {
    frac = 1
  }
  let on = st && st.on === true
  let cls = "sg-lk-cell sg-col-" + String(i)
  if (i % 4 === 0) {
    cls = cls + " sg-beat"
  }
  if (!on) {
    cls = cls + " sg-lk-dim"
  }

  if (field === "lyric") {
    let txt = st && st.lyric ? st.lyric : ""
    return (
      <div class={cls} title={"LYR · step " + String(i + 1)}>
        <input
          type="text"
          value={txt}
          placeholder="..."
          style={{ width: "100%", height: "100%", background: "transparent", border: "none", color: "#e2e8f0", fontSize: "10px", textAlign: "center", padding: "0" }}
          onkeydown={(e) => { e.stopPropagation() }}
          oninput={(e) => {
            emitStepLock(rt, project, chIdx, i, "lyric", e.target.value.trim().split(" ")[0])
          }}
        />
      </div>
    )
  }

  let pct = Math.round(frac * 100)
  let fill = null
  if (cfg.bip) {
    let top = pct >= 50 ? (100 - pct) : 50
    let barH = pct >= 50 ? (pct - 50) : (50 - pct)
    fill = <div class="sg-lk-fill sg-lk-bip" style={{ top: String(top) + "%", height: String(barH) + "%" }} />
  } else {
    fill = <div class="sg-lk-fill" style={{ height: String(pct) + "%" }} />
  }
  return (
    <div
      class={cls}
      id={"lk-" + String(chIdx) + "-" + field + "-" + String(i)}
      title={cfg.label + " · step " + String(i + 1) + " — drag across to draw, double-click resets"}
      onmousedown={(e) => lockCellDown(e, rt, project, chIdx, field)}
      ondblclick={() => emitStepLock(rt, project, chIdx, i, field, cfg.dflt)}
    >
      {cfg.bip ? <div class="sg-lk-mid" /> : null}
      {fill}
    </div>
  )
}

fn lockLaneRow(project, ch, chIdx, field, rt) {
  let cells = []
  let i = 0
  while (i < 16) {
    cells.push(LockLaneCell(project, chIdx, i, field, rt, ch.steps[i]))
    i = i + 1
  }
  let cfg = lockLaneCfg(field)
  return (
    <div class={"sg-row sg-lk-row " + deckClass(project, ch)} key={"lk-" + ch.id + "-" + field}>
      <div class="sg-gutter sg-lk-gutter">
        <span class="sg-lk-label">{cfg.label}</span>
      </div>
      <div class="sg-cells sg-lk-cells">{cells}</div>
    </div>
  )
}

fn lockLanesForChannel(project, ch, chIdx, rt) {
  return [
    lockLaneRow(project, ch, chIdx, "vel", rt),
    lockLaneRow(project, ch, chIdx, "prob", rt),
    lockLaneRow(project, ch, chIdx, "ratchet", rt),
    lockLaneRow(project, ch, chIdx, "nudge", rt),
    lockLaneRow(project, ch, chIdx, "lyric", rt)
  ]
}

// ---- Drawable param AUTOMATION lane (step-aligned, like the lock lanes) ---------------------------------
// 16 columns = beats 0,0.25,…,3.75 of bar 1; vertical drag sets the param value at that beat. Re-emits the
// whole 16-point curve as an `auto <id> gen <param>` block (master-gated). Playback applies it beat-accurately
// via generatorChannelAtBeat. bumpGrid is called explicitly (an `auto` edit doesn't touch the channel slice).
fn autoCellDown(e, rt, project, ch, spec, curValues) {
  // The automation lane (unlike the lock lanes) doesn't read the live project per-emit, so a sweep must
  // ACCUMULATE into a working copy and re-emit the whole curve, or only the last cell would survive.
  let working = []
  let wi = 0
  while (wi < 16) {
    working.push(wi < curValues.length ? Number(curValues[wi]) : spec.min)
    wi = wi + 1
  }
  let lastByStep = {}
  runLaneDraw(e, "au-" + String(ch.id) + "-", (stepIdx, py) => {
    let val = autoDenorm(1 - py, spec.min, spec.max, spec.log)
    let rounded = Math.round(val * 1000)
    if (lastByStep[stepIdx] !== rounded) {
      lastByStep[stepIdx] = rounded
      working[stepIdx] = val
      if (rt && rt.emit) {
        rt.emit("auto/" + ch.id + "/" + spec.key, working)
        if (rt.bumpGrid) {
          rt.bumpGrid()
        }
      }
    }
  })
}

fn autoLaneCell(project, ch, i, spec, rt, curValues) {
  let v = i < curValues.length ? curValues[i] : spec.min
  let frac = autoNorm(v, spec.min, spec.max, spec.log)
  let pct = Math.round(frac * 100)
  let cls = "sg-lk-cell sg-auto-cell sg-col-" + String(i)
  if (i % 4 === 0) {
    cls = cls + " sg-beat"
  }
  return (
    <div
      class={cls}
      id={"au-" + String(ch.id) + "-" + String(i)}
      title={spec.label + " · step " + String(i + 1) + " — drag across to draw the curve"}
      onmousedown={(e) => autoCellDown(e, rt, project, ch, spec, curValues)}
    >
      <div class="sg-lk-fill sg-auto-fill" style={{ height: String(pct) + "%" }} />
    </div>
  )
}

fn autoLaneRow(project, ch, chIdx, rt) {
  let gid = ch.generatorId ? ch.generatorId : "basicOsc"
  let spec = defaultAutoParam(gid)
  if (!spec) {
    return null
  }
  let vals = autoLaneValues(project, ch, spec.key)
  let cells = []
  let i = 0
  while (i < 16) {
    cells.push(autoLaneCell(project, ch, i, spec, rt, vals))
    i = i + 1
  }
  return (
    <div class={"sg-row sg-lk-row sg-auto-row " + deckClass(project, ch)} key={"auto-" + ch.id}>
      <div class="sg-gutter sg-lk-gutter">
        <span class="sg-lk-label sg-auto-label">{"∿ " + spec.label}</span>
      </div>
      <div class="sg-cells sg-lk-cells">{cells}</div>
    </div>
  )
}

// ---- Piano-note lock lanes (column-indexed; each column edits the notes STARTING at that step) ----------
// The inline piano grid is itself 16 step-columns, so the step lock-lane UX ports over: VEL/PRB/RCH/NDG lanes
// where column i edits every note whose startBeat lands on step (viewBar*16+i). Edits clone the whole
// pianoNotes array and emit through the gated track/<id>/notes door (broadcasts + round-trips like steps).
fn pianoNotesAtStep(ch, absStep) {
  let out = []
  if (!ch.pianoNotes) {
    return out
  }
  let i = 0
  while (i < ch.pianoNotes.length) {
    if (Math.floor(ch.pianoNotes[i].startBeat * 4 + 0.0001) === absStep) {
      out.push(i)
    }
    i = i + 1
  }
  return out
}

fn emitNoteLock(rt, project, chIdx, absStep, field, value) {
  if (!rt || !rt.emit) {
    return
  }
  let ch = project.channels[chIdx]
  if (!ch || !ch.pianoNotes) {
    return
  }
  let arr = []
  let i = 0
  while (i < ch.pianoNotes.length) {
    let n = ch.pianoNotes[i]
    let c = {
      startBeat: n.startBeat,
      durBeats: n.durBeats,
      pitch: n.pitch,
      vel: n.vel != null ? n.vel : 100,
      prob: n.prob != null ? n.prob : 1,
      ratchet: n.ratchet != null ? n.ratchet : 1,
      nudge: n.nudge != null ? n.nudge : 0,
      lyric: n.lyric != null ? n.lyric : ""
    }
    if (Math.floor(n.startBeat * 4 + 0.0001) === absStep) {
      c[field] = value
    }
    arr.push(c)
    i = i + 1
  }
  rt.emit("track/" + ch.id + "/notes", arr)
}

fn noteLockCellDown(e, rt, project, chIdx, field) {
  let cfg = lockLaneCfg(field)
  let lastByStep = {}
  runLaneDraw(e, "pl-" + String(chIdx) + "-" + field + "-", (absStep, py) => {
    let v = quantizeLock(field, cfg.lo + (1 - py) * (cfg.hi - cfg.lo))
    if (lastByStep[absStep] !== v) {
      lastByStep[absStep] = v
      emitNoteLock(rt, project, chIdx, absStep, field, v)
    }
  })
}

fn PianoLockLaneCell(project, chIdx, i, field, rt, ch, viewBar) {
  let cfg = lockLaneCfg(field)
  let absStep = viewBar * 16 + i
  let idxs = pianoNotesAtStep(ch, absStep)
  let cls = "sg-lk-cell sg-pnote-lk-cell sg-col-" + String(i)
  if (i % 4 === 0) {
    cls = cls + " sg-beat"
  }
  if (idxs.length === 0) {
    if (field === "lyric") {
      return (
        <div class={cls + " sg-lk-dim"} title={"LYR · step " + String(i + 1) + " (no note here)"}>
          <input
            type="text"
            value=""
            disabled={true}
            placeholder="..."
            style={{ width: "100%", height: "100%", background: "transparent", border: "none", color: "#94a3b8", fontSize: "10px", textAlign: "center", padding: "0" }}
          />
        </div>
      )
    }
    return <div class={cls + " sg-lk-dim"} title={cfg.label + " · step " + String(i + 1) + " (no note here)"} />
  }
  let v = stepLockVal(ch.pianoNotes[idxs[0]], field)
  let frac = (v - cfg.lo) / (cfg.hi - cfg.lo)
  if (frac < 0) {
    frac = 0
  }
  if (frac > 1) {
    frac = 1
  }
  if (field === "lyric") {
    let txt = ch.pianoNotes[idxs[0]].lyric ? ch.pianoNotes[idxs[0]].lyric : ""
    return (
      <div class={cls} title={"LYR · step " + String(i + 1) + " (" + String(idxs.length) + " note)"}>
        <input
          type="text"
          value={txt}
          placeholder="..."
          style={{ width: "100%", height: "100%", background: "transparent", border: "none", color: "#e2e8f0", fontSize: "10px", textAlign: "center", padding: "0" }}
          onkeydown={(e) => { e.stopPropagation() }}
          oninput={(e) => {
            emitNoteLock(rt, project, chIdx, absStep, "lyric", e.target.value.trim().split(" ")[0])
          }}
        />
      </div>
    )
  }

  let pct = Math.round(frac * 100)
  let fill = null
  if (cfg.bip) {
    let top = pct >= 50 ? (100 - pct) : 50
    let barH = pct >= 50 ? (pct - 50) : (50 - pct)
    fill = <div class="sg-lk-fill sg-lk-bip" style={{ top: String(top) + "%", height: String(barH) + "%" }} />
  } else {
    fill = <div class="sg-lk-fill" style={{ height: String(pct) + "%" }} />
  }
  return (
    <div
      class={cls}
      id={"pl-" + String(chIdx) + "-" + field + "-" + String(absStep)}
      title={cfg.label + " · step " + String(i + 1) + " — drag across to draw (" + String(idxs.length) + " note)"}
      onmousedown={(e) => noteLockCellDown(e, rt, project, chIdx, field)}
      ondblclick={() => emitNoteLock(rt, project, chIdx, absStep, field, cfg.dflt)}
    >
      {cfg.bip ? <div class="sg-lk-mid" /> : null}
      {fill}
    </div>
  )
}

fn pianoLockLaneRow(project, ch, chIdx, field, rt, viewBar) {
  let cells = []
  let i = 0
  while (i < 16) {
    cells.push(PianoLockLaneCell(project, chIdx, i, field, rt, ch, viewBar))
    i = i + 1
  }
  let cfg = lockLaneCfg(field)
  return (
    <div class={"sg-row sg-lk-row sg-pnote-lk-row " + deckClass(project, ch)} key={"pnlk-" + ch.id + "-" + field}>
      <div class="sg-gutter sg-lk-gutter">
        <span class="sg-lk-label">{cfg.label}</span>
      </div>
      <div class="sg-cells sg-lk-cells">{cells}</div>
    </div>
  )
}

fn pianoLockLanesForChannel(project, ch, chIdx, rt, viewBar) {
  return [
    pianoLockLaneRow(project, ch, chIdx, "vel", rt, viewBar),
    pianoLockLaneRow(project, ch, chIdx, "prob", rt, viewBar),
    pianoLockLaneRow(project, ch, chIdx, "ratchet", rt, viewBar),
    pianoLockLaneRow(project, ch, chIdx, "nudge", rt, viewBar),
    pianoLockLaneRow(project, ch, chIdx, "lyric", rt, viewBar)
  ]
}

// Velocity bar + lock markers drawn INSIDE a lit boolean step (so the pattern reads its dynamics at a glance).
fn stepLockOverlay(st) {
  if (!st) {
    return null
  }
  let vel = st.vel != null ? st.vel : 100
  let velPct = Math.round((vel / 127) * 100)
  if (velPct < 8) {
    velPct = 8
  }
  let prob = st.prob != null ? st.prob : 1
  let ratchet = st.ratchet != null ? Math.floor(st.ratchet) : 1
  let nudge = st.nudge != null ? st.nudge : 0
  let marks = []
  marks.push(<div class="sg-vel-fill" style={{ height: String(velPct) + "%" }} key="vf" />)
  if (prob < 0.999) {
    marks.push(<div class="sg-mk sg-mk-prob" style={{ opacity: String(0.25 + prob * 0.75) }} key="pb" />)
  }
  if (ratchet > 1) {
    marks.push(<div class="sg-mk sg-mk-rch" key="rc">{String(ratchet)}</div>)
  }
  if (nudge > 0.001 || nudge < -0.001) {
    marks.push(<div class={nudge < 0 ? "sg-mk sg-mk-ndg sg-mk-ndg-l" : "sg-mk sg-mk-ndg sg-mk-ndg-r"} key="nd" />)
  }
  return marks
}

// soloPitch != null → single-note channel: toggle a note of that pitch (plays like a step sequencer).
// melodic (and no soloPitch) → real melody: click opens the piano roll. else → drum step toggle.
fn StepCell(ch, chIdx, i, melodic, on, project, setProjectFromUI, setSelectedCh, rt, viewBar, soloPitch) {
  let single = soloPitch != null
  let cls = "sg-cell sg-col-" + String(i)
  if (on) {
    cls = cls + " sg-on"
  }
  if (melodic && !single) {
    cls = cls + " sg-melodic"
  }
  if (on && !melodic && !single) {
    cls = cls + " sg-velcell"
  }
  if (i % 4 === 0) {
    cls = cls + " sg-beat"
  }
  // Absolute step index in the (possibly multi-bar) pattern for the bar being viewed.
  let nbars = (rt != null && rt.gridBars != null) ? Math.floor(rt.gridBars) : 1
  let absStep = viewBar * 16 + i
  // The velocity/lock overlay must read the SAME (wrapped) step `cellOnAtView` uses — a 1-bar pattern tiled
  // across N bars has only 16 steps, so bars 2+ wrap; reading the raw absStep ran off the end and dropped the
  // fill (lit cells looked solid on bar 1, hollow on bars 2+).
  let ovChBars = (ch.patternBars != null && Math.floor(ch.patternBars) >= 1) ? Math.floor(ch.patternBars) : 1
  let ovLocal = (viewBar * 16 + i) % (ovChBars * 16)
  let ovStep = (ch.steps && ovLocal < ch.steps.length) ? ch.steps[ovLocal] : (ch.steps ? ch.steps[ovLocal % 16] : null)
  return (
    <button
      type="button"
      class={cls}
      id={"sgc-" + String(chIdx) + "-" + String(absStep)}
      title={single ? "Left: place note · Right: clear" : (melodic ? "Melodic — click to edit in piano roll" : "Left: toggle · Drag: paint · Right: clear")}
      onmousedown={(e) => {
        // Boolean steps: click-drag PAINTS (mousedown owns the toggle so onclick is a no-op). The pattern door
        // handles BAR 1 (absStep < 16) for ANY channel — incl. multi-bar (a bar-1 edit preserves bars 2+) and
        // after a deck load bumps gridBars; only bars 2+ (the pager) fall to the legacy direct toggle.
        if (single || melodic) {
          return
        }
        if (absStep < 16) {
          stepPaintDown(e, rt, project, chIdx, absStep, on === true)
          return
        }
        e.stopPropagation()
        let c = project.channels[chIdx]
        promoteChannelToBars(c, nbars)
        toggleStep(c, absStep)
        syncMainClipFromChannel(c)
        setProjectFromUI(project)
      }}
      onclick={(e) => {
        e.stopPropagation()
        let c = project.channels[chIdx]
        if (single) {
          promoteChannelToBars(c, nbars)
          let cb = (c.patternBars != null && Math.floor(c.patternBars) >= 1) ? Math.floor(c.patternBars) : 1
          let abs = absStep % (cb * 16)
          let idx = noteIdxAtStep(c, soloPitch, abs)
          if (idx >= 0) {
            removePianoNoteAt(c, idx)
          } else {
            addPianoNote(c, abs * 0.25, 0.25, soloPitch, 100)
          }
          syncMainClipFromChannel(c)
          setProjectFromUI(project)
          return
        }
        if (melodic) {
          if (setSelectedCh) {
            setSelectedCh(chIdx)
          }
          return
        }
        // Boolean step: the onmousedown paint handler already toggled/painted — nothing to do on click.
      }}
      oncontextmenu={(e) => {
        e.preventDefault()
        e.stopPropagation()
        let c = project.channels[chIdx]
        if (single) {
          promoteChannelToBars(c, nbars)
          let cb = (c.patternBars != null && Math.floor(c.patternBars) >= 1) ? Math.floor(c.patternBars) : 1
          let abs = absStep % (cb * 16)
          let idx = noteIdxAtStep(c, soloPitch, abs)
          if (idx >= 0) {
            removePianoNoteAt(c, idx)
            syncMainClipFromChannel(c)
            setProjectFromUI(project)
          }
          return
        }
        if (melodic) {
          return
        }
        if (absStep < 16 && emitStepToggle(rt, project, chIdx, absStep, true)) {
          return
        }
        promoteChannelToBars(c, nbars)
        clearStep(c, absStep)
        syncMainClipFromChannel(c)
        setProjectFromUI(project)
      }}
    >
      {(on && !melodic && !single) ? stepLockOverlay(ovStep) : null}
    </button>
  )
}

fn ChannelRowGrid(ch, chIdx, project, setProjectFromUI, selected, setSelectedCh, rt, viewBar) {
  let hasNotes = ch.pianoNotes && ch.pianoNotes.length > 0
  // A single-pitch channel sequences that one note inline; a multi-pitch melody opens the piano roll.
  let solo = singleNotePitch(ch)
  let melodic = hasNotes && solo == null
  // For the lit-cell check, single-note channels read note presence too (melodic logic).
  let cellMelodic = hasNotes || solo != null
  let cells = []
  let i = 0
  while (i < 16) {
    let on = cellOnAtView(ch, i, cellMelodic, viewBar)
    cells.push(StepCell(ch, chIdx, i, melodic, on, project, setProjectFromUI, setSelectedCh, rt, viewBar, solo))
    i = i + 1
  }
  // Per-bar root for stepped pitched channels (bass rolls) — shows the note changing as you page bars.
  // For a single-note channel, show that note in the gutter so you know what you're sequencing.
  let barPitch = null
  if (solo != null) {
    barPitch = sgNoteName(solo)
  } else if (ch.stepPitchByBar && viewBar < ch.stepPitchByBar.length) {
    barPitch = sgNoteName(ch.stepPitchByBar[viewBar])
  }
  let gid = ch.generatorId ? ch.generatorId : "basicOsc"
  ensureCoDjMeta(project)
  let meta = project.coDjMeta.tracks[ch.id]
  let locked = meta != null && meta.masterLock === true
  let rowCls = "sg-row " + deckClass(project, ch)
  if (selected) {
    rowCls = rowCls + " sg-row-sel"
  }
  if (tplLoopSkipsChannel(project, chIdx, rt)) {
    rowCls = rowCls + " sg-row-exhausted"
  }
  let deckBadge = channelDeck(project, ch)
  let expanded = rt != null && rt.gridExpanded != null && rt.gridExpanded[ch.id] === true
  // Per-step locks only apply to pure boolean-STEP channels (single-note/melodic tracks play via the note
  // path, which carries its own velocity and ignores ch.steps locks) — so only offer the toggle there.
  let stepChannel = !hasNotes && solo == null
  let locksOpen = rt != null && rt.gridLocks != null && rt.gridLocks[ch.id] === true
  // Melodic / single-note channels (pianoNotes) get the SAME four locks via column-indexed piano lanes.
  let pianoLocksOpen = rt != null && rt.gridPianoLocks != null && rt.gridPianoLocks[ch.id] === true
  // Automation lane is offered for any channel whose (simple) generator exposes a sweepable param.
  let autoCapable = defaultAutoParam(ch.generatorId ? ch.generatorId : "basicOsc") != null
  let autoOpen = rt != null && rt.gridAuto != null && rt.gridAuto[ch.id] === true
  return (
    <div class={rowCls}>
      <div class="sg-gutter">
        <button
          type="button"
          class={expanded ? "sg-exp sg-exp-on" : "sg-exp"}
          title="Expand the piano roll for this track (aligned under its step row)"
          onclick={(e) => {
            e.stopPropagation()
            if (rt) {
              if (!rt.gridExpanded) {
                rt.gridExpanded = {}
              }
              rt.gridExpanded[ch.id] = !(rt.gridExpanded[ch.id] === true)
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          {expanded ? "▾" : "▸"}
        </button>
        <div class="sg-gutter-main" onclick={() => setSelectedCh(chIdx)} title="Select channel">
          <span class="sg-ch-name">{ch.name}{barPitch !== null ? <span class="sg-ch-rootpitch">{barPitch}</span> : null}</span>
          <span class="sg-ch-instr">{generatorLabelById(gid)}</span>
        </div>
        <div class="sg-gutter-ctl">
          <button
            type="button"
            class="sg-deck-chip"
            title="Click to cycle this channel through the 4 decks (A → B → C → D)."
            onclick={(e) => {
              e.stopPropagation()
              let cur = channelDeck(project, ch)
              let curIdx = cur === "B" ? 1 : cur === "C" ? 2 : cur === "D" ? 3 : 0
              ch.deckSlot = (curIdx + 1) % 4
              ch.actorLane = ch.deckSlot === 0 ? "" : "client"
              setProjectFromUI(project)
              if (rt && rt.touchMixer) {
                rt.touchMixer()
              }
            }}
          >
            {deckBadge}
          </button>
          <button
            type="button"
            class={ch.mute ? "sg-tog sg-tog-on" : "sg-tog"}
            title="Mute"
            onclick={(e) => {
              e.stopPropagation()
              if (rt && rt.emit) {
                rt.emit("track/" + ch.id + "/mix/mute", !ch.mute)
              }
            }}
          >
            {"M"}
          </button>
          <button
            type="button"
            class={ch.solo ? "sg-tog sg-tog-solo" : "sg-tog"}
            title="Solo"
            onclick={(e) => {
              e.stopPropagation()
              if (rt && rt.emit) {
                rt.emit("track/" + ch.id + "/mix/solo", !ch.solo)
              }
            }}
          >
            {"S"}
          </button>
          <button
            type="button"
            class={locked ? "sg-tog sg-tog-lock" : "sg-tog"}
            title="Master-lock (agents can't overwrite)"
            onclick={(e) => {
              e.stopPropagation()
              setMasterLock(project, ch.id, !locked)
              setProjectFromUI(project)
            }}
          >
            {"L"}
          </button>
          {stepChannel ? (
            <button
              type="button"
              class={locksOpen ? "sg-tog sg-tog-lck sg-tog-lck-on" : "sg-tog sg-tog-lck"}
              title="Per-step locks — velocity · probability · ratchet · nudge (drag the lanes below)"
              onclick={(e) => {
                e.stopPropagation()
                if (rt) {
                  if (!rt.gridLocks) {
                    rt.gridLocks = {}
                  }
                  rt.gridLocks[ch.id] = !(rt.gridLocks[ch.id] === true)
                  if (rt.bumpGrid) {
                    rt.bumpGrid()
                  }
                }
              }}
            >
              {"⇅"}
            </button>
          ) : (
            <button
              type="button"
              class={pianoLocksOpen ? "sg-tog sg-tog-lck sg-tog-lck-on" : "sg-tog sg-tog-lck"}
              title="Per-note locks — velocity · probability · ratchet · nudge (drag the lanes below the notes)"
              onclick={(e) => {
                e.stopPropagation()
                if (rt) {
                  if (!rt.gridPianoLocks) {
                    rt.gridPianoLocks = {}
                  }
                  rt.gridPianoLocks[ch.id] = !(rt.gridPianoLocks[ch.id] === true)
                  if (rt.bumpGrid) {
                    rt.bumpGrid()
                  }
                }
              }}
            >
              {"⇅"}
            </button>
          )}
          {autoCapable ? (
            <button
              type="button"
              class={autoOpen ? "sg-tog sg-tog-auto sg-tog-auto-on" : "sg-tog sg-tog-auto"}
              title="Automation lane — draw a parameter curve over the bar (master only)"
              onclick={(e) => {
                e.stopPropagation()
                if (rt) {
                  if (!rt.gridAuto) {
                    rt.gridAuto = {}
                  }
                  rt.gridAuto[ch.id] = !(rt.gridAuto[ch.id] === true)
                  if (rt.bumpGrid) {
                    rt.bumpGrid()
                  }
                }
              }}
            >
              {"∿"}
            </button>
          ) : null}
        </div>
      </div>
      <div class="sg-cells">{cells}</div>
    </div>
  )
}

/** Direct-DOM playhead: highlight the active step column only when the VIEWED bar is the one playing,
 *  and mark which bar-pager button is currently sounding — all without a React re-render. */
fn applyGridPlayhead(step, playing, gridBars, viewBar) {
  if (typeof document === "undefined") {
    return
  }
  let prev = document.querySelectorAll(".sg-col-active")
  let i = 0
  while (i < prev.length) {
    prev[i].classList.remove("sg-col-active")
    i = i + 1
  }
  let pbPrev = document.querySelectorAll(".sg-barbtn-playing")
  let pi = 0
  while (pi < pbPrev.length) {
    pbPrev[pi].classList.remove("sg-barbtn-playing")
    pi = pi + 1
  }
  if (!playing) {
    return
  }
  let nbars = (gridBars != null && gridBars >= 1) ? gridBars : 1
  let vb = (viewBar != null && viewBar >= 0) ? viewBar : 0
  let playingBar = Math.floor(Math.floor(step) / 16) % nbars
  let colInBar = Math.floor(step) % 16
  // Mark the pager button for the sounding bar (so you see the progression move even off-screen).
  let btn = document.querySelectorAll(".sg-barbtn-" + String(playingBar))
  let bj = 0
  while (bj < btn.length) {
    btn[bj].classList.add("sg-barbtn-playing")
    bj = bj + 1
  }
  if (playingBar !== vb) {
    return
  }
  let cur = document.querySelectorAll(".sg-col-" + String(colInBar))
  let j = 0
  while (j < cur.length) {
    cur[j].classList.add("sg-col-active")
    j = j + 1
  }
}

/// Add a bar to the whole rack (duplicates the last bar so it's immediately editable) and jump to it.
/// Reads the live bar count from the project (not a render-time closure) so rapid clicks don't race.
fn rackAddBar(project, rt, setProjectFromUI) {
  let cur = gridBarsForProject(project)
  setRackBars(project, cur + 1, true)
  if (rt) {
    rt.gridViewBar = cur
  }
  setProjectFromUI(project)
  if (rt && rt.bumpGrid) {
    rt.bumpGrid()
  }
}

/// Remove the last bar from the whole rack (drops its content), clamping the viewed bar.
fn rackRemoveBar(project, rt, setProjectFromUI) {
  let cur = gridBarsForProject(project)
  if (cur <= 1) {
    return
  }
  setRackBars(project, cur - 1, false)
  if (rt && rt.gridViewBar != null && rt.gridViewBar > cur - 2) {
    rt.gridViewBar = cur - 2
  }
  if (rt && rt.gridViewBar != null && rt.gridViewBar < 0) {
    rt.gridViewBar = 0
  }
  setProjectFromUI(project)
  if (rt && rt.bumpGrid) {
    rt.bumpGrid()
  }
}

/// Shift + scroll pages through bars, clamped at both ends (no wrap).
fn handleBarWheel(e, rt, gridBars) {
  if (!e.shiftKey || !rt) {
    return
  }
  e.preventDefault()
  let amt = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX
  if (amt === 0) {
    return
  }
  let cur = rt.gridViewBar != null ? Math.floor(rt.gridViewBar) : 0
  let next = cur + (amt > 0 ? 1 : -1)
  if (next < 0) {
    next = 0
  }
  if (next > gridBars - 1) {
    next = gridBars - 1
  }
  if (next !== cur) {
    rt.gridViewBar = next
    if (rt.bumpGrid) {
      rt.bumpGrid()
    }
  }
}

export fn StepGridPanel(project, selectedCh, setProjectFromUI, setSelectedCh, rt, headerRight) {
  let gridBars = gridBarsForProject(project)
  // Swing groove: a 0..60% shuffle on the off-beat 16ths. Edits via rt.emit("swing", v) → the `swing`
  // address round-trips + broadcasts; the scheduler (swingOffsetSec) delays odd steps by it.
  let swingVal = (project && typeof project.swing === "number") ? project.swing : 0
  let swingPct = Math.round(swingVal * 100)
  let swingDown = Math.round(Math.max(0, swingVal - 0.05) * 100) / 100
  let swingUp = Math.round(Math.min(0.6, swingVal + 0.05) * 100) / 100
  // Scale lock — a global key constraint that folds every triggered melodic pitch onto the chosen scale at
  // play time (live: change it and the whole session conforms next step). Edits via rt.emit("scale", …).
  let scaleActive = project != null && project.scaleRoot != null && project.scaleMode != null && project.scaleMode !== "" && project.scaleMode !== "off"
  let scaleCurRoot = scaleActive ? Math.floor(project.scaleRoot) : 0
  let scaleCurMode = scaleActive ? project.scaleMode : "off"
  let scRootNames = scaleRootNames()
  let scModeNames = scaleModeNames()
  let scaleRootOpts = []
  let sri = 0
  while (sri < scRootNames.length) {
    scaleRootOpts.push(<option value={String(sri)} selected={scaleCurRoot === sri}>{scRootNames[sri]}</option>)
    sri = sri + 1
  }
  let scaleModeOpts = []
  scaleModeOpts.push(<option value="off" selected={!scaleActive}>{"off"}</option>)
  let smi = 0
  while (smi < scModeNames.length) {
    let smn = scModeNames[smi]
    scaleModeOpts.push(<option value={smn} selected={scaleActive && scaleCurMode === smn}>{scaleModeLabel(smn)}</option>)
    smi = smi + 1
  }
  let viewBar = 0
  if (rt != null && rt.gridViewBar != null) {
    viewBar = Math.floor(rt.gridViewBar)
  }
  if (viewBar >= gridBars) {
    viewBar = gridBars - 1
  }
  if (viewBar < 0) {
    viewBar = 0
  }
  if (rt) {
    rt.gridViewBar = viewBar
    rt.gridBars = gridBars
    rt.updateGridPlayhead = (step, playing) => {
      applyGridPlayhead(step, playing, gridBars, viewBar)
      // FOLLOW: keep the viewed bar locked to the bar that's currently sounding, paging at each bar
      // boundary (one re-render per bar, not per step). New render rebuilds this closure with the new bar.
      // ONLY in Sequence mode — there the rack IS what's playing. In Session ("song") mode the launched
      // clips play, NOT this rack, so paging the rack bars would jump the view to bars that aren't sounding.
      if (playing && rt.seqFollow === true && gridBars > 1 && rt.playMode !== "song") {
        let pb = Math.floor(Math.floor(step) / 16) % gridBars
        if (pb !== viewBar) {
          rt.gridViewBar = pb
          if (rt.bumpGrid) {
            rt.bumpGrid()
          }
        }
      }
    }
  }
  let rows = []
  let ci = 0
  while (ci < project.channels.length) {
    let ch = project.channels[ci]
    rows.push(ChannelRowGrid(ch, ci, project, setProjectFromUI, ci === selectedCh, setSelectedCh, rt, viewBar))
    let expanded = rt != null && rt.gridExpanded != null && rt.gridExpanded[ch.id] === true
    if (expanded) {
      let prows = pianoRowsForChannel(project, ch, ci, rt, setProjectFromUI, viewBar, gridBars)
      let k = 0
      while (k < prows.length) {
        rows.push(prows[k])
        k = k + 1
      }
    }
    // Per-step lock lanes (velocity / probability / ratchet / nudge) under boolean-step channels.
    let locksOpen = rt != null && rt.gridLocks != null && rt.gridLocks[ch.id] === true
    let isStepCh = (!ch.pianoNotes || ch.pianoNotes.length === 0) && singleNotePitch(ch) == null
    if (locksOpen && isStepCh) {
      let lrows = lockLanesForChannel(project, ch, ci, rt)
      let lk = 0
      while (lk < lrows.length) {
        rows.push(lrows[lk])
        lk = lk + 1
      }
    }
    // Per-note lock lanes for melodic / single-note channels (column-indexed; each column edits the notes
    // starting at that step). Mirrors the step lock lanes but writes through the track/<id>/notes door.
    let pianoLocksOpen = rt != null && rt.gridPianoLocks != null && rt.gridPianoLocks[ch.id] === true
    let isMelodic = (ch.pianoNotes && ch.pianoNotes.length > 0) || singleNotePitch(ch) != null
    if (pianoLocksOpen && isMelodic) {
      let plrows = pianoLockLanesForChannel(project, ch, ci, rt, viewBar)
      let plk = 0
      while (plk < plrows.length) {
        rows.push(plrows[plk])
        plk = plk + 1
      }
    }
    // Drawable automation lane (any channel whose generator exposes a sweepable param).
    let autoOpen = rt != null && rt.gridAuto != null && rt.gridAuto[ch.id] === true
    if (autoOpen) {
      let arow = autoLaneRow(project, ch, ci, rt)
      if (arow != null) {
        rows.push(arow)
      }
    }
    // Automatically render the LYRIC row at the bottom for vocal generators, always.
    let isVocal = ch.generatorId === "formantVocal" || ch.generatorId === "ttsVocal" || ch.generatorId === "meSpeakVocal"
    if (isVocal) {
      if (expanded) {
        rows.push(pianoLockLaneRow(project, ch, ci, "lyric", rt, viewBar))
      } else if (isStepCh) {
        rows.push(lockLaneRow(project, ch, ci, "lyric", rt))
      }
    }
    ci = ci + 1
  }
  // Bar pager — view one bar at a time, page through a multi-bar progression.
  let pager = []
  if (gridBars > 1) {
    let b = 0
    while (b < gridBars) {
      let bb = b
      let pcls = "sg-barbtn sg-barbtn-" + String(b)
      if (b === viewBar) {
        pcls = pcls + " sg-barbtn-active"
      }
      pager.push(
        <button
          type="button"
          class={pcls}
          key={"bar-" + String(b)}
          title={"View bar " + String(b + 1)}
          onclick={() => {
            if (rt) {
              rt.gridViewBar = bb
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          {String(b + 1)}
        </button>
      )
      b = b + 1
    }
  }
  let ruler = []
  let r = 0
  while (r < 16) {
    let rc = r % 4 === 0 ? "sg-tick sg-tick-beat" : "sg-tick"
    ruler.push(<div class={rc}>{String(r + 1)}</div>)
    r = r + 1
  }
  // Re-apply the playhead after this (re)render.
  if (rt && typeof setTimeout !== "undefined") {
    setTimeout(() => {
      let st = typeof rt.playbackUiStep === "number" ? rt.playbackUiStep : 0
      applyGridPlayhead(st, rt.playing === true, gridBars, viewBar)
    }, 0)
  }
  // Euclidean fill for the selected channel — moved here from the instrument (it edits `steps`,
  // which is the rack's pattern, not the sound).
  let selCh = (selectedCh >= 0 && selectedCh < project.channels.length) ? project.channels[selectedCh] : null
  // EUCLID + generative toolbar shows for ANY selected channel (it edits the step pattern). NOTE: melodic
  // channels play their `note`s, so generating a step pattern on them is currently a no-op for playback —
  // generating into NOTES for melodic tracks is a follow-up; this restores the toolbar's visibility.
  let euclidRow = null
  if (selCh) {
    let pills = []
    // OFF clears the row (emit an all-off pattern, keeping the locks structure).
    pills.push(
      <button
        type="button"
        class={(!selCh.euclid || selCh.euclid === 0) ? "sg-euclid-pill sg-euclid-on" : "sg-euclid-pill"}
        title="Clear the pattern"
        onclick={() => {
          selCh.euclid = 0
          genClear(rt, project, selectedCh, selCh)
        }}
      >
        {"Off"}
      </button>
    )
    let ek = 1
    while (ek <= 8) {
      let hits = ek
      pills.push(
        <button
          type="button"
          class={selCh.euclid === ek ? "sg-euclid-pill sg-euclid-on" : "sg-euclid-pill"}
          title={"Euclidean " + String(ek) + " hits across 16"}
          onclick={() => {
            selCh.euclid = hits
            genEuclid(rt, project, selectedCh, selCh, hits)
          }}
        >
          {String(ek)}
        </button>
      )
      ek = ek + 1
    }
    euclidRow = (
      <div class="sg-euclid">
        <span class="sg-euclid-label">{"EUCLID"}</span>
        <span class="sg-euclid-target">{selCh.name}</span>
        <div class="sg-euclid-pills">{pills}</div>
        <span class="sg-euclid-sep">{"·"}</span>
        <span class="sg-euclid-label sg-gen-label">{"GEN"}</span>
        <div class="sg-euclid-pills">
          <button
            type="button"
            class="sg-gen-btn sg-gen-reseed"
            title="RESEED — a fresh random pattern (new density + rotation, humanized). Broadcasts to peers."
            onclick={() => {
              selCh.euclid = 0
              genReseed(rt, project, selectedCh, selCh)
            }}
          >
            {"⟳ RESEED"}
          </button>
          <button
            type="button"
            class="sg-gen-btn"
            title="MUTATE — flip a few steps/notes + jitter velocities (evolve the current pattern)."
            onclick={() => {
              genMutate(rt, project, selectedCh, selCh)
            }}
          >
            {"MUTATE"}
          </button>
          <button
            type="button"
            class="sg-gen-btn"
            title="HUMANIZE — jitter the velocity of every hit/note so it breathes."
            onclick={() => {
              genHumanize(rt, project, selectedCh, selCh)
            }}
          >
            {"HUMAN"}
          </button>
          <button
            type="button"
            class="sg-gen-btn"
            title="PROB — sprinkle probability onto off-beat hits/notes so the pattern varies every loop (seeded, peers agree)."
            onclick={() => {
              genProb(rt, project, selectedCh, selCh)
            }}
          >
            {"PROB"}
          </button>
        </div>
      </div>
    )
  }
  return (
    <section class="panel sg-panel">
      {PanelHeader(
        <Fragment>
          <h2 class="sg-head-h2">{"SEQUENCER // CHANNEL RACK"}</h2>
          <span class="sg-head-hint">{"Left: toggle · Right: clear · ▸ expand a track"}</span>
        </Fragment>,
        headerRight
      )}
      {euclidRow}
      <div class="sg-barpager" title="Shift + scroll to page through bars" onwheel={(e) => handleBarWheel(e, rt, gridBars)}>
        <span class="sg-barpager-label">{"BARS"}</span>
        <button
          type="button"
          class="sg-barbtn sg-barbtn-mod"
          title="Remove the last bar"
          disabled={gridBars <= 1}
          onclick={() => rackRemoveBar(project, rt, setProjectFromUI)}
        >
          {"−"}
        </button>
        <span class="sg-barpager-count">{String(gridBars)}</span>
        <button
          type="button"
          class="sg-barbtn sg-barbtn-mod"
          title="Add a bar (duplicates the last bar so you can tweak it)"
          onclick={() => rackAddBar(project, rt, setProjectFromUI)}
        >
          {"+"}
        </button>
        {gridBars > 1 ? <span class="sg-barpager-sep">{"·"}</span> : null}
        {gridBars > 1 ? <span class="sg-barpager-label">{"VIEW"}</span> : null}
        {gridBars > 1 ? pager : null}
        {gridBars > 1 ? <span class="sg-barpager-sep">{"·"}</span> : null}
        {gridBars > 1 ? (
          <button
            type="button"
            class={rt && rt.seqFollow === true ? "sg-barbtn sg-follow sg-follow-on" : "sg-barbtn sg-follow"}
            title="Follow playback — auto-page the view to the bar that's currently playing"
            onclick={() => {
              if (rt) {
                rt.seqFollow = rt.seqFollow !== true
                if (rt.bumpGrid) {
                  rt.bumpGrid()
                }
              }
            }}
          >
            {"FOLLOW"}
          </button>
        ) : null}
        <span class="sg-barpager-sep">{"·"}</span>
        <span class="sg-barpager-label" title="Swing — shuffle the off-beat 16ths (groove). 0% = straight.">{"SWING"}</span>
        <button
          type="button"
          class="sg-barbtn sg-barbtn-mod"
          title="Less swing"
          disabled={swingPct <= 0}
          onclick={() => { if (rt && rt.emit) { rt.emit("swing", swingDown); if (rt.bumpGrid) { rt.bumpGrid() } } }}
        >
          {"−"}
        </button>
        <span class="sg-barpager-count">{String(swingPct) + "%"}</span>
        <button
          type="button"
          class="sg-barbtn sg-barbtn-mod"
          title="More swing (shuffle the off-beats)"
          disabled={swingPct >= 60}
          onclick={() => { if (rt && rt.emit) { rt.emit("swing", swingUp); if (rt.bumpGrid) { rt.bumpGrid() } } }}
        >
          {"+"}
        </button>
        <span class="sg-barpager-sep">{"·"}</span>
        <span class={scaleActive ? "sg-barpager-label sg-scale-lit" : "sg-barpager-label"} title="Scale lock — constrain every melodic note to a key/scale, live. 'off' = chromatic.">{"SCALE"}</span>
        <select
          class="sg-scale-sel"
          title="Root note"
          disabled={!scaleActive}
          onchange={(e) => {
            if (rt && rt.emit) {
              let v = { root: Number(e.target.value), mode: scaleCurMode }
              rt.emit("scale", v)
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          {scaleRootOpts}
        </select>
        <select
          class={scaleActive ? "sg-scale-sel sg-scale-sel-lit" : "sg-scale-sel"}
          title="Scale / mode ('off' = no constraint)"
          onchange={(e) => {
            if (rt && rt.emit) {
              let m = e.target.value
              if (m === "off") {
                rt.emit("scale", "off")
              } else {
                let v = { root: scaleCurRoot, mode: m }
                rt.emit("scale", v)
              }
              if (rt.bumpGrid) {
                rt.bumpGrid()
              }
            }
          }}
        >
          {scaleModeOpts}
        </select>
      </div>
      <div class="sg-grid" onwheel={(e) => handleBarWheel(e, rt, gridBars)}>{rows}</div>
      <div class="sg-ruler">
        <div class="sg-ruler-pad" />
        <div class="sg-ruler-ticks">{ruler}</div>
      </div>
    </section>
  )
}
