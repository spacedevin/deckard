// Mutable bag owned by App via useRef — transport, Co-DJ, TPL editor, and WS state live here (no window.__*).

export fn createDeckardRuntime() {
  return {
    project: null,
    setProject: null,
    setTplText: null,
    tplSessionStream: [],
    // TPL-stream tape: the recorder/replay state for the Playlist ("TPL playback"). tplTape is the live
    // recording (or a loaded recording shown on the timeline); replaying re-fires it through the scheduler.
    tplTape: [],
    tplRecording: true,
    tplReplaying: false,
    tplStartState: null,
    tplTapeStartStep: 0,
    tplRecMode: "song",
    updateTimelinePlayhead: null,
    selectedCh: 0,
    setSelectedCh: null,
    playing: false,
    perfStep: 0,
    /** Next transport step index (after last tick); null when stopped. */
    transportNextTick: null,
    bumpSeqPromoteUi: null,
    playbackUiStep: 0,
    coDjScheduled: [],
    getSongText: null,
    setSongText: null,
    dispatchPlaybackHighlight: null,
    tplSongMirrorTa: null,
    tplSongMirrorWrap: null,
    tplTextarea: null,
    tplSongEditorEcho: "",
    tplLastHighlightSource: null,
    tplLastHighlightPlaybackStep: null,
    tplLastAppliedLineCount: 0,
    tplLastAppliedAt: 0,
    ensureStreamSeeded: null,
    appendStreamedBlock: null,
    consumePlayedBlocks: null,
    tplMirrorFlush: null,
    setPlaybackHighlight: null,
    streamAppendLine: null,
    coDjWs: null,
    coDjPushLog: null,
    coDjApplyScheduledTpl: null,
    coDjAfterScheduled: null,
    coDjTplMirrorFlush: null,
    coDjNotifyPlaying: null,
    coDjBumpUi: null,
    coDjPlayResyncIv: null,
    coDjLastStreamHash: "",
    coDjLog: [],
    coDjLogDirty: false,
    coDjStreamDirty: false,
    coDjLocalStreamDirty: false,
    coDjPairingDirty: false,
    coDjLogSeeded: false,
    coDjStreamPreview: "",
    coDjStreamLane: "",
    coDjLocalStreamPreview: "",
    coDjLocalStreamLane: "",
    coDjRemoteTplStream: "",
    coDjRemoteTplStreamLane: "",
    /** Per-actor incremental TPL line decoders (keyed by actorId) — see tpl/Stream.tish. */
    coDjLineStreams: {},
    coDjActors: [],
    coDjActorId: "",
    coDjClientId: "",
    coDjMidiInitialized: false,
    coDjWsUrl: "",
    coDjSessionId: "default",
    coDjDirectTarget: "",
    coDjDirectText: "",
    coDjCodjPollIv: null,
    rackPrSigCache: [],
    rackPrNode: [],
    prSkipRedrawSig: null,
    prSkipRedrawEl: null,
    dawScopeStarted: false,
    sessionArmedClipIds: [],
    sessionActiveScene: 0,
    sessionQueuedClipIds: [],
    sessionQueuePending: false,
    sessionQueuedScene: null,
    // I/O Rack: which decks are CUED to the headphones bus (live monitor choice, transient — not in TPL).
    cuedDecks: { A: false, B: false, C: false, D: false }
  }
}
