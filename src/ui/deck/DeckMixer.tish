// Traditional DJ desk: Deck A | center (per-deck EQ + FILTER + crossfader) | Deck B.
// Deck A = host channels (cyan), Deck B = client channels (magenta). Stem faders are per-channel gains
// grouped by deck. The crossfader equal-power blends the decks (transportCrossfade). Per-deck EQ/filter
// writes through to that deck's channels (a deck-wide macro until dedicated buses land).

import { h, Fragment } from '@tishlang/lattish'
import { channelDeck, channelDeckRow, crossfadeValue, crossfadeValueY } from '../../model/DeckRouting.tish'
import { ensureMasterMixer, channelActorLane } from '../../model/MixerRouting.tish'
import { setChannelGain } from '../../model/Edits.tish'
import { Knob, IkSelect } from '../InstrumentKit.tish'

export fn ensureDeckEq(project) {
  if (!project.deckEq) {
    project.deckEq = {}
  }
  let ks = ["A", "B", "C", "D"]
  let i = 0
  while (i < ks.length) {
    let d = project.deckEq[ks[i]]
    if (!d) {
      project.deckEq[ks[i]] = { hi: 0, mid: 0, lo: 0, flt: 0, vol: 1 }
    } else {
      if (typeof d.hi !== "number") { d.hi = 0 }
      if (typeof d.mid !== "number") { d.mid = 0 }
      if (typeof d.lo !== "number") { d.lo = 0 }
      if (typeof d.flt !== "number") { d.flt = 0 }
      if (typeof d.vol !== "number") { d.vol = 1 }
    }
    i = i + 1
  }
}

export fn deckEntries(project, deck) {
  let out = []
  let i = 0
  while (i < project.channels.length) {
    if (channelDeck(project, project.channels[i]) === deck) {
      out.push({ ch: project.channels[i], idx: i })
    }
    i = i + 1
  }
  return out
}

fn deckRowEntries(project, deck, row) {
  let out = []
  let i = 0
  while (i < project.channels.length) {
    let ch = project.channels[i]
    if (channelDeck(project, ch) === deck && channelDeckRow(project, ch) === row) {
      out.push({ ch: ch, idx: i })
    }
    i = i + 1
  }
  return out
}

/** Client lane name shown on Deck B (or null when no client is connected / owns channels). */
fn deckBClientLabel(project) {
  let i = 0
  while (i < project.channels.length) {
    let ch = project.channels[i]
    if (channelDeck(project, ch) === "B") {
      let lane = channelActorLane(ch, project)
      return String(lane).toUpperCase()
    }
    i = i + 1
  }
  return null
}

export fn applyDeckEq(project, deck) {
  ensureDeckEq(project)
  let de = project.deckEq[deck]
  let cut = 8000
  if (de.flt < 0) {
    cut = 8000 + (200 - 8000) * (-de.flt)
  }
  let i = 0
  while (i < project.channels.length) {
    let ch = project.channels[i]
    if (channelDeck(project, ch) === deck) {
      ch["eqLo"] = de.lo
      ch["eqMid"] = de.mid
      ch["eqHi"] = de.hi
      ch["filterCutoff"] = cut
    }
    i = i + 1
  }
}

// Linear 0..1 gain → dB string for the fader readout. Floors near-silence at -60 so we never print -Infinity.
export fn gainToDb(g) {
  if (g == null || g <= 0.001) {
    return "-60 dB"
  }
  let db = 20 * (Math.log(g) / Math.log(10))
  let r = Math.round(db * 10) / 10
  return (r > 0 ? "+" : "") + String(r) + " dB"
}

// Shared vertical lever: groove + coloured fill + rounded handle. Absolute-position drag (click/drag
// anywhere on the track sets the value); onSet(p01) fires per move (coalesced by the onAdvance rAF). Used
// by both the per-track stem fader and the per-deck volume fader.
export fn vertLeverEl(g, acc, onSet) {
  let gg = g < 0 ? 0 : (g > 1 ? 1 : g)
  let pctStr = Number(Math.round(gg * 1000) / 10).toFixed(1) + "%"
  fn onLeverDown(e) {
    if (e.preventDefault) {
      e.preventDefault()
    }
    if (e.stopPropagation) {
      e.stopPropagation()
    }
    let track = e.currentTarget
    fn setFromY(clientY) {
      let r = track.getBoundingClientRect()
      let p = r.height > 0 ? 1 - (clientY - r.top) / r.height : 0
      if (p < 0) {
        p = 0
      }
      if (p > 1) {
        p = 1
      }
      onSet(p)
    }
    setFromY(e.clientY)
    fn onMove(ev) {
      setFromY(ev.clientY)
    }
    fn onUp() {
      document.removeEventListener("mousemove", onMove)
      document.removeEventListener("mouseup", onUp)
    }
    document.addEventListener("mousemove", onMove)
    document.addEventListener("mouseup", onUp)
  }
  return (
    <div class="dk-lever-track" onmousedown={onLeverDown}>
      <div class="dk-lever-fill" style={{ height: pctStr, background: acc }} />
      <div class="dk-lever-handle" style={{ bottom: pctStr, borderColor: acc }}>
        <div class="dk-lever-handle-line" style={{ background: acc }} />
      </div>
    </div>
  )
}

fn StemFader(entry, setProjectFromUI, touchMixer, project, rt, accentColor) {
  let ch = entry.ch
  let g = ch.gain != null ? ch.gain : 0.85
  let acc = accentColor ? accentColor : "var(--deck-a)"
  fn onSet(p) {
    if (rt && rt.emit) {
      rt.emit("track/" + ch.id + "/mix/gain", p)
    }
  }
  // Key the canvas + meter by the CHANNEL ID (stable), not the bus index (volatile across deck loads). The scope
  // worker maps each canvas to an offscreen-canvas keyed by this id; an index-based id let a reused/re-indexed
  // canvas keep a STALE registration after a deck load → the wrong deck's colour/data (e.g. deck-A blue showing
  // on a deck-C stem). A per-channel key keeps the canvas↔channel↔worker-id binding 1:1 forever.
  return (
    <div class="dk-fader" key={"sf-" + ch.id}>
      <div class="dk-fader-name" title={ch.name}>{ch.name}</div>
      <div class="dk-fader-wave">
        <canvas class={"dk-stem-wave dk-wave-" + ch.id} width="64" height="34" />
      </div>
      <div class="dk-lever">
        {vertLeverEl(g, acc, onSet)}
        <div class={"dk-lever-meter dk-lvl-" + ch.id}>
          <div class="dk-lever-meter-fill" style={{ background: acc }} />
        </div>
      </div>
      <div class="dk-fader-db">{gainToDb(g)}</div>
    </div>
  )
}


// Per-deck JOG PLATTER (CDJ-style). Grabbing the wheel scratches THIS deck's rendered loop (lazy-loaded on
// first grab, cached) and DUCKS this deck's live channels so the scratch replaces it; releasing restores the
// deck. Hook-free (pure props + direct-DOM marker rotation) so it's safe inside the direct-call DeckSlot. All
// audio goes through rt.scratch* hooks — no audio-node access here. ⟳ re-grabs the loop after a pattern edit.
export fn DeckJog(deck, rt) {
  let suf = deck === "B" ? "b" : deck === "C" ? "c" : deck === "D" ? "d" : "a"
  let acc = "dk-acc-" + suf
  let currentRot = (rt && rt.deckRot && typeof rt.deckRot[deck] === "number") ? rt.deckRot[deck] : 0

  fn angleOf(e, el) {
    let r = el.getBoundingClientRect()
    let cx = r.left + r.width / 2
    let cy = r.top + r.height / 2
    return Math.atan2(e.clientY - cy, e.clientX - cx)
  }
  // POINTER-CAPTURE based so a release OUTSIDE the window still tears down — otherwise the deck stays ducked
  // (hard mute) and the rAF loop leaks forever. Teardown routes through ONE idempotent up() reachable from
  // pointerup / pointercancel / lostpointercapture / window blur; a per-element guard stops a second grab from
  // stacking another loop.
  fn onWheelDown(e) {
    if (e.preventDefault) {
      e.preventDefault()
    }
    let el = e.currentTarget
    if (el.__jogGrabbing) {
      return
    }
    el.__jogGrabbing = true
    let marker = el.querySelector ? el.querySelector(".dk-jog-marker") : null
    let done = false
    let lastAngle = angleOf(e, el)
    let accum = 0
    let rot = currentRot
    let GAIN = 7
    let pid = e.pointerId
    if (el.setPointerCapture && pid != null) {
      try {
        el.setPointerCapture(pid)
      } catch (errc) {}
    }
    // Engage the platter as the "jog" grab (loads the loop lazily + ducks + phase-locks on the FIRST grab of any
    // kind). Sharing the engage/release refcount with CUT/REV/BRAKE lets you jog with one hand and cut with the
    // other without the cut's release un-ducking the still-held jog.
    if (rt && rt.scratchEngage) {
      rt.scratchEngage(deck, "jog")
    }
    fn frame() {
      if (done) {
        return
      }
      let rate = accum * GAIN
      accum = 0
      if (rt && rt.scratchRate) {
        rt.scratchRate(deck, rate)
      }
      requestAnimationFrame(frame)
    }
    requestAnimationFrame(frame)
    fn move(ev) {
      let a = angleOf(ev, el)
      let d = a - lastAngle
      if (d > Math.PI) {
        d = d - 2 * Math.PI
      }
      if (d < 0 - Math.PI) {
        d = d + 2 * Math.PI
      }
      accum = accum + d
      lastAngle = a
      rot = rot + d
      if (marker) {
        marker.style.transform = "translateX(-50%) rotate(" + String(rot) + "rad)"
      }
    }
    fn up() {
      if (done) {
        return
      }
      done = true
      el.__jogGrabbing = false
      // Release the "jog" grab — the platter stops + un-ducks only if no CUT/REV/BRAKE is still held.
      if (rt && rt.scratchRelease) {
        rt.scratchRelease(deck, "jog")
      }
      if (rt && rt.deckRot) {
        rt.deckRot[deck] = rot
      }
      el.removeEventListener("pointermove", move)
      el.removeEventListener("pointerup", up)
      el.removeEventListener("pointercancel", up)
      el.removeEventListener("lostpointercapture", up)
      if (typeof window !== "undefined") {
        window.removeEventListener("blur", up)
      }
      if (el.releasePointerCapture && pid != null) {
        try {
          el.releasePointerCapture(pid)
        } catch (errr) {}
      }
    }
    el.addEventListener("pointermove", move)
    el.addEventListener("pointerup", up)
    el.addEventListener("pointercancel", up)
    el.addEventListener("lostpointercapture", up)
    if (typeof window !== "undefined") {
      window.addEventListener("blur", up)
    }
  }
  return (
    <div class="dk-jog">
      <div class={"dk-jog-wheel " + acc} onpointerdown={onWheelDown} title={"Scratch deck " + deck + " — grab + rub (forward, back, reverse). No movement = silence; the deck ducks while you hold it."}>
        <div class={"dk-jog-marker dk-marker-" + deck} style={{ transform: "translateX(-50%) rotate(" + String(currentRot) + "rad)" }} />
        <div class="dk-jog-hub" />
      </div>
      <button
        type="button"
        class={"dk-jog-reload " + acc}
        title={"Re-grab deck " + deck + "'s current loop (do this after you change its pattern)"}
        onmousedown={(e) => e.stopPropagation()}
        onclick={() => { if (rt && rt.scratchLoadDeckLoop) { rt.scratchLoadDeckLoop(deck) } }}
      >
        {"⟳"}
      </button>
    </div>
  )
}

// A momentary HOLD button (pointer-capture so a release outside still fires): onDown on press, onUp on release;
// lights via a CSS class while held. Used for the vinyl CUT / REVERSE / BRAKE moves.
fn holdBtn(label, cls, title, onDown, onUp) {
  fn down(e) {
    if (e.preventDefault) {
      e.preventDefault()
    }
    if (e.stopPropagation) {
      e.stopPropagation()
    }
    let el = e.currentTarget
    let pid = e.pointerId
    if (el.setPointerCapture && pid != null) {
      try {
        el.setPointerCapture(pid)
      } catch (errc) {}
    }
    el.classList.add("dk-vinyl-on")
    let released = false
    fn up() {
      if (released) {
        return
      }
      released = true
      el.classList.remove("dk-vinyl-on")
      onUp()
      el.removeEventListener("pointerup", up)
      el.removeEventListener("pointercancel", up)
      el.removeEventListener("lostpointercapture", up)
    }
    el.addEventListener("pointerup", up)
    el.addEventListener("pointercancel", up)
    el.addEventListener("lostpointercapture", up)
    onDown()
  }
  return (
    <button type="button" class={cls} title={title} onpointerdown={down}>
      {label}
    </button>
  )
}

// VINYL performance row — turntablist moves on this deck's scratch platter. CUT (hold to mute, the fader-cut
// for transformer/chirp/stab — jog with one hand, cut with the other), REV (hold to play backward / censor),
// BRK (hold = the vinyl power-down to a stop), SPIN (tap = the rewind spinback zip). All route through rt hooks.
export fn VinylRow(deck, rt) {
  let suf = deck === "B" ? "b" : deck === "C" ? "c" : deck === "D" ? "d" : "a"
  let acc = "dk-acc-" + suf
  // Each move emits an `@ deck <X> …` directive (applied locally through ingest + broadcast to peers), so it is
  // multiplayer-safe and recordable — NOT a direct engine call. (See rt.onDeckMove.)
  return (
    <div class={"dk-vinyl " + acc}>
      {holdBtn("CUT", "dk-vinyl-btn", "Cut deck " + deck + " — hold to mute sharply (tap rhythmically while jogging = transformer)", () => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "cut", true) } }, () => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "cut", false) } })}
      {holdBtn("REV", "dk-vinyl-btn", "Reverse deck " + deck + " — hold to play backward (censor)", () => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "rev", true) } }, () => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "rev", false) } })}
      {holdBtn("BRK", "dk-vinyl-btn", "Brake deck " + deck + " — hold to slow the record to a stop (release to bring it back)", () => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "brake", true) } }, () => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "brake", false) } })}
      <button type="button" class="dk-vinyl-btn" title={"Spinback deck " + deck + " — the rewind zip"} onpointerdown={(e) => { if (e.stopPropagation) { e.stopPropagation() } }} onclick={() => { if (rt && rt.onDeckMove) { rt.onDeckMove(deck, "spin", true) } }}>
        {"SPIN"}
      </button>
    </div>
  )
}


// Centre DJ-mixer channel strip for one deck: per-deck EQ knobs (HI/MID/LO/FLT) + CUE + per-deck volume
// fader. This is the "booth" — like a Pioneer DJM channel. The per-track stem faders stay in the deck slot.
export fn DeckChannelStrip(project, deck, setProjectFromUI, touchMixer, rt) {
  ensureDeckEq(project)
  let suf = deck === "B" ? "b" : deck === "C" ? "c" : deck === "D" ? "d" : "a"
  let acc = "dk-acc-" + suf
  let accentColor = "var(--deck-" + suf + ")"
  let de = project.deckEq[deck]
  let active = deckEntries(project, deck).length > 0
  // EQ/volume are continuous drags: mutate in place, then ask App for ONE rAF-coalesced audio-reconcile +
  // DeckMixer-only re-render (rt.scheduleDeckMix). Do NOT call updateMixerFromProject/setProjectFromUI per
  // mousemove — that ran the full mixer + a whole-app re-render on every pixel and starved the audio clock.
  fn applyDeckMix() {
    if (rt && rt.scheduleDeckMix) {
      rt.scheduleDeckMix()
    } else {
      if (touchMixer) {
        touchMixer()
      }
      setProjectFromUI(project)
    }
  }
  fn setEq(band, v) {
    de[band] = v
    applyDeckEq(project, deck)
    applyDeckMix()
  }
  fn setVol(p) {
    de.vol = p
    // Deck volume composes with the crossfader in deckMainOutGainMultiplier — reconciled in updateMixerFromProject.
    applyDeckMix()
  }
  let vol = typeof de.vol === "number" ? de.vol : 1
  let cued = rt && rt.cuedDecks && rt.cuedDecks[deck] === true
  return (
    <div class={active ? "dk-ch-strip dk-deck-" + suf : "dk-ch-strip dk-deck-" + suf + " dk-ch-strip-empty"}>
      <div class="dk-ch-left-col">
        <button
          type="button"
          class={cued ? "dk-cue dk-cue-on" : "dk-cue"}
          title={"CUE — pre-listen this deck on your headphones (independent of the crossfader)"}
          onmousedown={(e) => e.stopPropagation()}
          onclick={() => { if (rt && rt.onCueToggle) { rt.onCueToggle(deck) } }}
        >
          {"CUE"}
        </button>
        <div class="dk-ch-vol">
          <div class="dk-lever">
            {vertLeverEl(vol, accentColor, setVol)}
            <div class={"dk-lever-meter dk-deck-lvl-" + deck}>
              <div class="dk-lever-meter-fill" style={{ background: accentColor }} />
            </div>
          </div>
        </div>
        <div class="dk-ch-db">{gainToDb(vol)}</div>
      </div>
      <div class="dk-ch-right-col">
        {EqSlider("HI", de.hi, (v) => setEq("hi", v), acc)}
        {EqSlider("MID", de.mid, (v) => setEq("mid", v), acc)}
        {EqSlider("LO", de.lo, (v) => setEq("lo", v), acc)}
        {EqSlider("FLT", de.flt, (v) => setEq("flt", v), acc)}
      </div>
    </div>
  )
}

// Memoize each centre channel strip on its scalar state (eq/vol/cue/active) so a re-render of the deck
// mixer (crossfade move, another deck's fader, etc.) does NOT rebuild all 16 SVG knobs — only the strip
// whose values actually changed re-runs. Volatile props (project ref, callbacks) are ignored by the cmp.
fn deckStripEq(a, b) {
  return a.deck === b.deck && a.hi === b.hi && a.mid === b.mid && a.lo === b.lo && a.flt === b.flt &&
    a.vol === b.vol && a.cued === b.cued && a.active === b.active
}
let DeckChannelStripMemo = memo((p) => DeckChannelStrip(p.project, p.deck, p.setProjectFromUI, p.touchMixer, p.rt), deckStripEq)


// Map the deck accent CLASS ("dk-acc-a".."dk-acc-d") to its themed colour for the knob arc.
fn eqAccentColor(a) {
  if (a && a.indexOf("dk-acc-") === 0) {
    return "var(--deck-" + a.substring(a.length - 1) + ")"
  }
  return a ? a : "var(--deck-a)"
}

// HI/MID/LO/FLT are now rotary knobs (the shared Knob component). HI/MID/LO = ±12 dB; FLT = LPF/OFF/HPF
// over -1..1. onInput keeps the existing per-band setter — only the widget changed.
fn EqSlider(label, val, onInput, accentCls) {
  let isFlt = label === "FLT"
  fn fmt(v) {
    if (isFlt) {
      return v === 0 ? "OFF" : (v < 0 ? "LPF" : "HPF")
    }
    let r = Math.round(v)
    return r > 0 ? "+" + String(r) : String(r)
  }
  return Knob({
    label: label,
    value: val,
    min: isFlt ? -1 : -12,
    max: isFlt ? 1 : 12,
    step: isFlt ? 0.02 : 1,
    fmt: fmt,
    onInput: onInput,
    accent: eqAccentColor(accentCls),
    size: "sm",
    valueInside: true
  })
}

export fn DeckMixer(project, setProjectFromUI, touchMixer, rt) {
  ensureMasterMixer(project)
  ensureDeckEq(project)
  let x = crossfadeValue(project)
  let y = crossfadeValueY(project)
  fn emitXY(pad, clientX, clientY) {
    let r = pad.getBoundingClientRect()
    let px = r.width > 0 ? (clientX - r.left) / r.width : 0
    let py = r.height > 0 ? (clientY - r.top) / r.height : 0
    if (px < 0) {
      px = 0
    }
    if (px > 1) {
      px = 1
    }
    if (py < 0) {
      py = 0
    }
    if (py > 1) {
      py = 1
    }
    // Crossfader is a global — emit one `xfade` statement through the write door.
    if (rt && rt.emit) {
      rt.emit("xfade", [px, py])
    }
  }
  // Drag continues on document listeners until mouseup, so leaving the pad mid-drag keeps updating (clamped)
  // instead of stalling — no more getting stuck in the corners.
  fn onPadDown(e) {
    e.stopPropagation()
    if (e.preventDefault) {
      e.preventDefault()
    }
    let pad = e.currentTarget
    emitXY(pad, e.clientX, e.clientY)
    fn onMove(ev) {
      emitXY(pad, ev.clientX, ev.clientY)
    }
    fn onUp() {
      document.removeEventListener("mousemove", onMove)
      document.removeEventListener("mouseup", onUp)
    }
    document.addEventListener("mousemove", onMove)
    document.addEventListener("mouseup", onUp)
  }
  // Build the scalar prop bag for a memoized centre strip — these deps gate whether that strip re-renders.
  fn stripProps(deck) {
    let de = project.deckEq[deck]
    return {
      project: project,
      deck: deck,
      setProjectFromUI: setProjectFromUI,
      touchMixer: touchMixer,
      rt: rt,
      hi: de.hi,
      mid: de.mid,
      lo: de.lo,
      flt: de.flt,
      vol: typeof de.vol === "number" ? de.vol : 1,
      cued: rt != null && rt.cuedDecks != null && rt.cuedDecks[deck] === true,
      active: deckEntries(project, deck).length > 0
    }
  }
  return (
    <div class="dk-center" style={{ margin: "0 auto" }}>
      <div class="dk-xfade">
        <div class="dk-fx-row">
          <span class="dk-fx-label">{"FX"}</span>
          {IkSelect({
            class: "dk-fx-div",
            value: rt && rt.fxBeatDiv ? String(rt.fxBeatDiv) : "0.75",
            options: [
              { value: "0.5", label: "1/8" },
              { value: "0.75", label: "3/16" },
              { value: "1", label: "1/4" },
              { value: "2", label: "1/2" }
            ],
            onChange: (v) => { if (rt) { rt.fxBeatDiv = Number(v) } }
          })}
          <button
            type="button"
            class="dk-fx-throw"
            title="ECHO throw — HOLD to punch a tempo-synced master echo into the mix, release to let it ring out (hotkey: hold E). Master only."
            onmousedown={(e) => { if (e.preventDefault) { e.preventDefault() } if (rt && rt.onFxThrow) { rt.onFxThrow("echo", true) } }}
            onmouseup={() => { if (rt && rt.onFxThrow) { rt.onFxThrow("echo", false) } }}
            onmouseleave={() => { if (rt && rt.onFxThrow) { rt.onFxThrow("echo", false) } }}
          >
            {"ECHO"}
          </button>
          <button
            type="button"
            class="dk-fx-throw"
            title="FILTER throw — HOLD to sweep a master lowpass down over the mix, release to open it back up (hotkey: hold F). Master only."
            onmousedown={(e) => { if (e.preventDefault) { e.preventDefault() } if (rt && rt.onFxThrow) { rt.onFxThrow("filter", true) } }}
            onmouseup={() => { if (rt && rt.onFxThrow) { rt.onFxThrow("filter", false) } }}
            onmouseleave={() => { if (rt && rt.onFxThrow) { rt.onFxThrow("filter", false) } }}
          >
            {"FILTER"}
          </button>
        </div>
        <div class="dk-xfade-labels">
          <span class="dk-xfade-mid">{"4-WAY FADER"}</span>
        </div>
        <div
          class="dk-xypad"
          onmousedown={onPadDown}
        >
          <span class="dk-xypad-corner dk-xy-tl dk-acc-a">{"A"}</span>
          <span class="dk-xypad-corner dk-xy-tr dk-acc-b">{"B"}</span>
          <span class="dk-xypad-corner dk-xy-bl dk-acc-c">{"C"}</span>
          <span class="dk-xypad-corner dk-xy-br dk-acc-d">{"D"}</span>
          <span
            class="dk-xypad-knob"
            style={{ left: String(Math.round(x * 100)) + "%", top: String(Math.round(y * 100)) + "%" }}
          />
        </div>
      </div>
    </div>
  )
}
