// Master scope: HiDPI canvas + neon / gradient “eye candy” (not a technical meter).

/** Frequency-bar spectrum (the orange MASTER_OUT strip). */
export fn drawSpectrumCanvas(canvas, analyser, hexColor) {
  if (!canvas || !analyser) {
    return
  }
  let dpr = 1
  if (typeof window !== "undefined" && window.devicePixelRatio) {
    dpr = window.devicePixelRatio
  }
  if (dpr > 2.5) {
    dpr = 2.5
  }
  let cssW = canvas.offsetWidth
  let cssH = canvas.offsetHeight
  if (cssW < 8 || cssH < 8) {
    let r = canvas.getBoundingClientRect()
    cssW = Math.max(8, Math.floor(r.width))
    cssH = Math.max(8, Math.floor(r.height))
  }
  if (cssW < 8 || cssH < 8) {
    return
  }
  let bw = Math.max(1, Math.floor(cssW * dpr))
  let bh = Math.max(1, Math.floor(cssH * dpr))
  if (canvas.width !== bw || canvas.height !== bh) {
    canvas.width = bw
    canvas.height = bh
  }
  let ctx2 = canvas.getContext("2d")
  if (!ctx2) {
    return
  }
  ctx2.setTransform(dpr, 0, 0, dpr, 0, 0)
  let w = cssW
  let h = cssH
  ctx2.clearRect(0, 0, w, h)
  let n = analyser.frequencyBinCount
  let buf = new Uint8Array(n)
  analyser.getByteFrequencyData(buf)
  let col = hexColor ? hexColor : "#f97316"
  let bars = 72
  if (bars > n) {
    bars = n
  }
  let gap = 2
  let bwid = (w - (bars - 1) * gap) / bars
  if (bwid < 1) {
    bwid = 1
  }
  let bi = 0
  while (bi < bars) {
    let src = Math.floor((bi / bars) * (n * 0.7))
    let v = buf[src] / 255
    let bh2 = Math.max(1, v * h)
    let x = bi * (bwid + gap)
    let y = h - bh2
    ctx2.fillStyle = col
    ctx2.globalAlpha = 0.35 + v * 0.6
    ctx2.fillRect(x, y, bwid, bh2)
    bi = bi + 1
  }
  ctx2.globalAlpha = 1
}

/** Small per-stem time-domain waveform line (the fader thumbnails). */
export fn drawMiniWave(canvas, analyser, hexColor) {
  if (!canvas || !analyser) {
    return
  }
  let dpr = 1
  if (typeof window !== "undefined" && window.devicePixelRatio) {
    dpr = window.devicePixelRatio
  }
  if (dpr > 2.5) {
    dpr = 2.5
  }
  let cssW = canvas.offsetWidth
  let cssH = canvas.offsetHeight
  if (cssW < 4 || cssH < 4) {
    let r = canvas.getBoundingClientRect()
    cssW = Math.max(8, Math.floor(r.width))
    cssH = Math.max(8, Math.floor(r.height))
  }
  if (cssW < 4 || cssH < 4) {
    return
  }
  let bw = Math.max(1, Math.floor(cssW * dpr))
  let bh = Math.max(1, Math.floor(cssH * dpr))
  if (canvas.width !== bw || canvas.height !== bh) {
    canvas.width = bw
    canvas.height = bh
  }
  let ctx2 = canvas.getContext("2d")
  if (!ctx2) {
    return
  }
  ctx2.setTransform(dpr, 0, 0, dpr, 0, 0)
  let w = cssW
  let h = cssH
  ctx2.clearRect(0, 0, w, h)
  let N = analyser.fftSize
  let buf = new Uint8Array(N)
  analyser.getByteTimeDomainData(buf)
  let col = hexColor ? hexColor : "#22d3ee"
  ctx2.beginPath()
  // Sensitivity: raw playback samples rarely approach full-scale (0 dBFS), so the unscaled trace sits as a
  // near-flat line. Amplify the deflection ~3.5x so quiet signals are clearly visible, and clamp to ±0.48h
  // so loud transients flatten at the rails instead of flying off-canvas (and vanishing).
  let waveGain = 3.5
  let maxDev = h * 0.48
  let i = 0
  while (i < N) {
    let v = buf[i] / 128
    let x = (i / (N - 1)) * w
    let dev = (v - 1) * waveGain * h * 0.46
    if (dev > maxDev) {
      dev = maxDev
    } else if (dev < 0 - maxDev) {
      dev = 0 - maxDev
    }
    let y = h * 0.5 - dev
    if (i === 0) {
      ctx2.moveTo(x, y)
    } else {
      ctx2.lineTo(x, y)
    }
    i = i + 1
  }
  ctx2.strokeStyle = col
  ctx2.lineWidth = 1.3
  ctx2.lineJoin = "round"
  ctx2.lineCap = "round"
  ctx2.shadowColor = col
  ctx2.shadowBlur = 4
  ctx2.stroke()
  ctx2.shadowBlur = 0
}

// Peak output level (0..1) for a bus's segmented fader meter. Same ~3.5x sensitivity as drawMiniWave so a
// quiet stem still lights some segments. Reads the same byte time-domain data (cheap).
export fn busPeakLevel(analyser) {
  if (!analyser) {
    return 0
  }
  let N = analyser.fftSize
  let buf = new Uint8Array(N)
  analyser.getByteTimeDomainData(buf)
  let peak = 0
  let i = 0
  while (i < N) {
    let d = Math.abs(buf[i] - 128) / 128
    if (d > peak) {
      peak = d
    }
    i = i + 1
  }
  let lvl = peak * 3.5
  if (lvl > 1) {
    lvl = 1
  }
  return lvl
}

// Deck colour for the Set Recorder lanes (kept in sync with PlaylistView.deckColorHex).
fn setLaneColorHex(deck) {
  if (deck === "B") {
    return "#e879f9"
  }
  if (deck === "C") {
    return "#f59e0b"
  }
  if (deck === "D") {
    return "#4ade80"
  }
  return "#22d3ee"
}

/** Set Recorder lane: one deck's per-step energy (summed velocity, keyed by take-relative step in `energy[deck]`)
 *  drawn as a filled mirror-envelope in the deck colour. A FULL repaint from `energy` every call — the canvas
 *  width grows with the take so its bitmap is cleared on resize anyway, making incremental append pointless; but
 *  this is cheap 2D line drawing called at most ~30fps from scopeFrame (never on the audio scheduler path). The
 *  canvas is sized imperatively here (CSS + HiDPI bitmap) so vdom re-renders never touch its size or content.
 *  `laneH` matches PlaylistView.DECK_WAVE_H (42); barPx/stepsPerBar match BAR_PX/STEPS_PER_BAR (26/16). */
export fn drawSetWaveLane(canvas, energy, deck, barPx, stepsPerBar) {
  if (!canvas || !energy || typeof window === "undefined") {
    return
  }
  let dpr = 1
  if (window.devicePixelRatio) {
    dpr = window.devicePixelRatio
  }
  if (dpr > 2.5) {
    dpr = 2.5
  }
  // Lane height follows the CSS-sized track (height:100%), not a hardcoded value — else a taller canvas is
  // clipped by the footer's overflow:hidden and the waveform peaks read as "cut off". Width stays imperative.
  let laneH = canvas.offsetHeight
  if (!(laneH > 0)) {
    laneH = 28
  }
  let maxStep = energy.maxStep !== null ? energy.maxStep : 0
  // Defence-in-depth: this runs every dirty frame, so a bad maxStep (NaN, or an absurd value from a corrupt
  // loaded Set) would loop millions of times / size a giant canvas. Clamp to a sane bound.
  if (!(maxStep >= 0)) {
    maxStep = 0
  }
  if (maxStep > 131072) {
    maxStep = 131072
  }
  let cssW = Math.max(8, Math.ceil(((maxStep + 1) / stepsPerBar) * barPx))
  // Own the layout WIDTH (CSS px) AND the backing bitmap (CSS px * dpr) imperatively. Setting canvas.width/height
  // clears the bitmap, so only touch them when they actually changed (the Scope.tish convention).
  let bw = Math.max(1, Math.floor(cssW * dpr))
  let bh = Math.max(1, Math.floor(laneH * dpr))
  if (canvas.width !== bw || canvas.height !== bh) {
    canvas.width = bw
    canvas.height = bh
  }
  let wantW = String(cssW) + "px"
  if (canvas.style.width !== wantW) {
    canvas.style.width = wantW
  }
  let ctx2 = canvas.getContext("2d")
  if (!ctx2) {
    return
  }
  ctx2.setTransform(dpr, 0, 0, dpr, 0, 0)
  let w = cssW
  let h = laneH
  ctx2.clearRect(0, 0, w, h)
  let cy = h / 2
  // Faint centre line (drawn here rather than CSS so it sits under the fill at the exact bitmap centre).
  ctx2.strokeStyle = "rgba(255,255,255,0.07)"
  ctx2.lineWidth = 1
  ctx2.beginPath()
  ctx2.moveTo(0, cy)
  ctx2.lineTo(w, cy)
  ctx2.stroke()
  let en = energy[deck]
  if (!en) {
    return
  }
  let maxE = energy.maxE !== null && energy.maxE > 0 ? energy.maxE : 1
  let half = (h - 6) / 2
  // One closed path: top edge L->R, bottom edge R->L = a filled mirror envelope. Silent steps floor at 1px so
  // the recording reads as one continuous always-on line, not separated bursts.
  ctx2.beginPath()
  let s = 0
  while (s <= maxStep) {
    let e = en[String(s)] !== null ? en[String(s)] : 0
    let hh = (e / maxE) * half
    if (hh < 1) {
      hh = 1
    }
    let x = (s / stepsPerBar) * barPx
    let yT = cy - hh
    if (s === 0) {
      ctx2.moveTo(x, yT)
    } else {
      ctx2.lineTo(x, yT)
    }
    s = s + 1
  }
  let s2 = maxStep
  while (s2 >= 0) {
    let e2 = en[String(s2)] !== null ? en[String(s2)] : 0
    let hh2 = (e2 / maxE) * half
    if (hh2 < 1) {
      hh2 = 1
    }
    let x2 = (s2 / stepsPerBar) * barPx
    ctx2.lineTo(x2, cy + hh2)
    s2 = s2 - 1
  }
  ctx2.closePath()
  let col = setLaneColorHex(deck)
  ctx2.fillStyle = col + "80"
  ctx2.fill()
  ctx2.strokeStyle = col
  ctx2.lineWidth = 0.75
  ctx2.lineJoin = "round"
  ctx2.stroke()
}

export fn drawSetWaveOverlay(canvas, energy, activeDecks, barPx, stepsPerBar) {
  if (!canvas || !energy || typeof window === "undefined") {
    return
  }
  let dpr = 1
  if (window.devicePixelRatio) {
    dpr = window.devicePixelRatio
  }
  if (dpr > 2.5) {
    dpr = 2.5
  }
  // Lane height follows the CSS-sized track (.pl-wave-track / .pl-wave-cv height:100%), NOT a hardcoded value:
  // a canvas taller than its container is clipped by the footer's overflow:hidden, so the waveform peaks read
  // as "cut off". Only the WIDTH is imperative (the full timeline can be wider than the visible track).
  let laneH = canvas.offsetHeight
  if (!(laneH > 0)) {
    laneH = 28
  }
  let maxStep = energy.maxStep !== null ? energy.maxStep : 0
  if (!(maxStep >= 0)) {
    maxStep = 0
  }
  if (maxStep > 131072) {
    maxStep = 131072
  }
  let cssW = Math.max(8, Math.ceil(((maxStep + 1) / stepsPerBar) * barPx))
  let bw = Math.max(1, Math.floor(cssW * dpr))
  let bh = Math.max(1, Math.floor(laneH * dpr))
  if (canvas.width !== bw || canvas.height !== bh) {
    canvas.width = bw
    canvas.height = bh
  }
  let wantW = String(cssW) + "px"
  if (canvas.style.width !== wantW) {
    canvas.style.width = wantW
  }
  let ctx2 = canvas.getContext("2d")
  if (!ctx2) {
    return
  }
  ctx2.setTransform(dpr, 0, 0, dpr, 0, 0)
  let w = cssW
  let h = laneH
  ctx2.clearRect(0, 0, w, h)
  let cy = h / 2
  ctx2.strokeStyle = "rgba(255,255,255,0.07)"
  ctx2.lineWidth = 1
  ctx2.beginPath()
  ctx2.moveTo(0, cy)
  ctx2.lineTo(w, cy)
  ctx2.stroke()

  let decks = ["A", "B", "C", "D"]
  let maxE = energy.maxE !== null && energy.maxE > 0 ? energy.maxE : 1
  let half = (h - 6) / 2

  let di = 0
  while (di < decks.length) {
    let deck = decks[di]
    if (activeDecks && activeDecks[deck] === true) {
      let en = energy[deck]
      if (en) {
        ctx2.beginPath()
        let s = 0
        while (s <= maxStep) {
          let e = en[String(s)] !== null ? en[String(s)] : 0
          let hh = (e / maxE) * half
          if (hh < 1) {
            hh = 1
          }
          let x = (s / stepsPerBar) * barPx
          let yT = cy - hh
          if (s === 0) {
            ctx2.moveTo(x, yT)
          } else {
            ctx2.lineTo(x, yT)
          }
          s = s + 1
        }
        let s2 = maxStep
        while (s2 >= 0) {
          let e2 = en[String(s2)] !== null ? en[String(s2)] : 0
          let hh2 = (e2 / maxE) * half
          if (hh2 < 1) {
            hh2 = 1
          }
          let x2 = (s2 / stepsPerBar) * barPx
          ctx2.lineTo(x2, cy + hh2)
          s2 = s2 - 1
        }
        ctx2.closePath()
        let col = setLaneColorHex(deck)
        ctx2.fillStyle = col + "55"
        ctx2.fill()
        ctx2.strokeStyle = col
        ctx2.lineWidth = 0.75
        ctx2.lineJoin = "round"
        ctx2.stroke()
      }
    }
    di = di + 1
  }
}


export fn drawScopeCanvas(canvas, analyser) {
  if (!canvas || !analyser) {
    return
  }
  let dpr = 1
  if (typeof window !== "undefined" && window.devicePixelRatio) {
    dpr = window.devicePixelRatio
  }
  if (dpr > 2.5) {
    dpr = 2.5
  }
  let cssW = canvas.offsetWidth
  let cssH = canvas.offsetHeight
  if (cssW < 8 || cssH < 8) {
    let r = canvas.getBoundingClientRect()
    cssW = Math.max(8, Math.floor(r.width))
    cssH = Math.max(8, Math.floor(r.height))
  }
  if (cssW < 8 || cssH < 8) {
    return
  }
  let bw = Math.max(1, Math.floor(cssW * dpr))
  let bh = Math.max(1, Math.floor(cssH * dpr))
  if (canvas.width !== bw || canvas.height !== bh) {
    canvas.width = bw
    canvas.height = bh
  }
  let ctx2 = canvas.getContext("2d")
  if (!ctx2) {
    return
  }
  ctx2.setTransform(dpr, 0, 0, dpr, 0, 0)
  let w = cssW
  let h = cssH
  let n = analyser.frequencyBinCount
  let buf = new Uint8Array(n)
  analyser.getByteTimeDomainData(buf)
  let t = 0
  if (typeof Date !== "undefined" && Date.now) {
    t = Date.now() / 1000
  }
  let cx = w * 0.5
  let cy = h * 0.52
  let amp = h * 0.38
  let hue0 = (t * 38) % 360
  let bg = ctx2.createRadialGradient(cx, cy, 0, cx, cy, Math.max(w, h) * 0.85)
  bg.addColorStop(0, "rgba(45, 12, 62, 0.95)")
  bg.addColorStop(0.45, "rgba(8, 14, 32, 1)")
  bg.addColorStop(1, "rgba(4, 6, 14, 1)")
  ctx2.fillStyle = bg
  ctx2.fillRect(0, 0, w, h)
  let gi = 0
  while (gi < 5) {
    let gy = (gi + 1) * (h / 6)
    ctx2.strokeStyle = "rgba(120, 200, 255, 0.04)"
    ctx2.lineWidth = 1
    ctx2.beginPath()
    ctx2.moveTo(0, gy)
    ctx2.lineTo(w, gy)
    ctx2.stroke()
    gi = gi + 1
  }
  let peak = 0
  let pi = 0
  while (pi < n) {
    let d = buf[pi] - 128
    if (d < 0) {
      d = -d
    }
    if (d > peak) {
      peak = d
    }
    pi = pi + 1
  }
  let breathe = Math.sin(t * 2.4) * 0.04 + 0.96
  let pulse = 1 + (peak / 128) * 0.35
  let xs = []
  let ys = []
  let i = 0
  while (i < n) {
    let v = buf[i] / 128
    let jm = peak / 100
    if (jm > 1) {
      jm = 1
    }
    let jitter = Math.sin(i * 0.08 + t * 6) * jm * 1.2
    let y = cy + (v - 1) * amp * breathe + jitter
    let x = (i / (n - 1)) * w
    xs.push(x)
    ys.push(y)
    i = i + 1
  }
  let waveG = ctx2.createLinearGradient(0, 0, w, 0)
  waveG.addColorStop(0, "hsla(" + String(Math.floor(hue0)) + ", 95%, 58%, 0.55)")
  waveG.addColorStop(0.28, "hsla(" + String(Math.floor((hue0 + 110) % 360)) + ", 90%, 62%, 0.5)")
  waveG.addColorStop(0.55, "hsla(" + String(Math.floor((hue0 + 220) % 360)) + ", 92%, 55%, 0.5)")
  waveG.addColorStop(1, "hsla(" + String(Math.floor((hue0 + 300) % 360)) + ", 88%, 60%, 0.5)")
  ctx2.beginPath()
  ctx2.moveTo(0, h)
  ctx2.lineTo(0, ys[0])
  let si = 0
  while (si < n) {
    ctx2.lineTo(xs[si], ys[si])
    si = si + 1
  }
  ctx2.lineTo(w, h)
  ctx2.closePath()
  ctx2.fillStyle = waveG
  ctx2.fill()
  ctx2.beginPath()
  ctx2.moveTo(xs[0], ys[0])
  let li = 1
  while (li < n) {
    ctx2.lineTo(xs[li], ys[li])
    li = li + 1
  }
  let glow = 10 + peak * 0.15
  ctx2.strokeStyle = "hsla(" + String(Math.floor((hue0 + 140) % 360)) + ", 100%, 78%, 0.9)"
  ctx2.lineWidth = 2.2 * pulse
  ctx2.lineCap = "round"
  ctx2.lineJoin = "round"
  ctx2.shadowColor = "hsla(" + String(Math.floor((hue0 + 180) % 360)) + ", 100%, 65%, 1)"
  ctx2.shadowBlur = glow
  ctx2.stroke()
  ctx2.shadowBlur = 0
  ctx2.strokeStyle = "rgba(255, 250, 255, 0.85)"
  ctx2.lineWidth = 0.85
  ctx2.stroke()
  let rim = ctx2.createLinearGradient(0, 0, w, h)
  rim.addColorStop(0, "rgba(255, 100, 200, 0.12)")
  rim.addColorStop(0.5, "rgba(80, 220, 255, 0.08)")
  rim.addColorStop(1, "rgba(180, 80, 255, 0.1)")
  ctx2.strokeStyle = rim
  ctx2.lineWidth = 1
  ctx2.strokeRect(0.5, 0.5, w - 1, h - 1)
}
