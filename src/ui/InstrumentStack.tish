// The instrument as a chain of hardware-style modules. Top→bottom is the signal path, and each module
// maps to exactly one TPL block (shown as a badge on its header):
//   Generator (voice picker + per-voice designer + amp envelope) → `gen` / `gen_block`
//   Pitch     (octave · arp · chord)                             → `voice`
//   Filter/FX (cutoff · res · drive · lfo · reverb)              → `fx`
// The sequencer/euclidean lives in the channel rack (it edits `steps`), not here. Picking a voice and
// every pill is a ch.* edit or rt.emit that re-folds to TPL — the UI stays a pure TPL client.

import { h, Fragment } from '@tishlang/lattish'
import { defaultParamsForGeneratorId, generatorDescriptionById, generatorLabelById } from '../generators/Registry.tish'
import {
  deepCloneParams,
  addInstrumentPreset,
  applyInstrumentPresetToChannel,
  ensureInstrumentPresets
} from '../model/InstrumentPresets.tish'
import { parseGenBlock, defaultMatrixFmRawLines } from '../tpl/TplExtension.tish'
import { defaultPatchRawLines } from '../tpl/PatchGraph.tish'
import { macroCatalog, assignMacroToChannel } from '../model/MacroVoice.tish'
import { compileGeneratorToPatchLines } from '../model/PatchCompile.tish'
import { emitInstrumentModuleTpl } from '../core/Levels.tish'
import { GeneratorParamPanel } from './GeneratorParams.tish'
import { accentForGenerator } from './InstrumentKit.tish'
import { MatrixFmPanel } from './MatrixFmPanel.tish'
import { PatchGraphPanel } from './PatchGraphPanel.tish'
import { MacroDesignerPanel } from './MacroDesignerPanel.tish'

let VOICE_GROUPS = [
  { title: "Oscillators", voices: [["basicOsc", "Osc"], ["fmTone", "FM"]] },
  { title: "Texture", voices: [["noiseBurst", "Noise"], ["pad", "Pad"], ["bell", "Bell"]] },
  { title: "Strings", voices: [["guitar", "Guitar"]] },
  { title: "Percussion", voices: [["drumSynth", "Drum"]] },
  { title: "Modular", voices: [["matrixFm", "Matrix FM"], ["patch", "Patch"]] },
  { title: "Kick designer", voices: [["kick_edm", "EDM"], ["kick_deep", "Deep"], ["kick_distorted", "Distort"]] },
  {
    title: "Bass designer",
    voices: [
      ["bass_acid", "Acid"],
      ["bass_reese", "Reese"],
      ["bass_reese_punch", "Punch"],
      ["bass_reese_sc", "Reese SC"],
      ["bass_wobble", "Wobble"]
    ]
  }
]

let DECAY_PRESETS = {
  Pluck: { attack: 0.002, decay: 0.08, sustain: 0.0, release: 0.06 },
  Short: { attack: 0.005, decay: 0.12, sustain: 0.2, release: 0.1 },
  Medium: { attack: 0.01, decay: 0.25, sustain: 0.5, release: 0.2 },
  Long: { attack: 0.05, decay: 0.5, sustain: 0.7, release: 0.5 },
  Pad: { attack: 0.3, decay: 0.6, sustain: 0.85, release: 1.5 }
}

fn isMacroVoice(key) {
  let mc = macroCatalog()
  let i = 0
  while (i < mc.length) {
    if (mc[i].name === key) {
      return true
    }
    i = i + 1
  }
  return false
}

fn activeVoiceKey(ch) {
  if (ch.macroName != null) {
    return ch.macroName
  }
  return ch.generatorId ? ch.generatorId : "basicOsc"
}

/// The canonical voice switch (engines reset params + seed graph specs; macros expand to a patch).
fn pickVoice(project, ch, key, setProject, tplMirrorFlush) {
  if (isMacroVoice(key)) {
    assignMacroToChannel(ch, key, project.userMacros)
  } else {
    // Capture the OUTGOING sound before we overwrite it, so "switch to Patch" can reduce it losslessly.
    let prevId = ch.generatorId
    let prevParams = ch.generatorParams
    let prevSpec = ch.generatorSpec
    let keptPatchSpec = null
    if (
      key === "patch" &&
      prevId === "patch" &&
      ch.generatorSpec &&
      ch.generatorSpec.graph &&
      ch.generatorSpec.raw &&
      ch.generatorSpec.raw.length > 0
    ) {
      keptPatchSpec = ch.generatorSpec
    }
    ch.macroName = null
    ch.macroParams = null
    ch.generatorId = key
    ch.generatorParams = deepCloneParams(defaultParamsForGeneratorId(key))
    if (key === "matrixFm") {
      if (
        !ch.generatorSpec ||
        ch.generatorSpec.kind !== "matrixFm" ||
        !ch.generatorSpec.raw ||
        ch.generatorSpec.raw.length === 0
      ) {
        ch.generatorSpec = parseGenBlock("matrix_fm", defaultMatrixFmRawLines())
      }
    } else {
      if (key === "patch") {
        // Patch is the universal substrate: compile the previous voice into an equivalent graph so the
        // sound is preserved. An already-patch (incl. an expanded macro) keeps its graph.
        if (keptPatchSpec != null) {
          ch.generatorSpec = keptPatchSpec
        } else {
          let compiled = compileGeneratorToPatchLines(prevId, prevParams, prevSpec)
          let lines = compiled != null ? compiled : defaultPatchRawLines()
          ch.generatorSpec = parseGenBlock("patch", lines)
        }
      } else {
        // A fixed generator reads generatorParams, not a graph — drop any stale spec so emit doesn't
        // write an orphan gen_block.
        ch.generatorSpec = null
      }
    }
  }
  setProject(project)
  if (tplMirrorFlush) {
    setTimeout(() => {
      tplMirrorFlush()
    }, 0)
  }
}

fn VoicePicker(project, ch, setProject, tplMirrorFlush) {
  let active = activeVoiceKey(ch)
  let groups = []
  let gi = 0
  while (gi < VOICE_GROUPS.length) {
    let grp = VOICE_GROUPS[gi]
    let tiles = []
    let vi = 0
    while (vi < grp.voices.length) {
      let key = grp.voices[vi][0]
      let label = grp.voices[vi][1]
      let keyCopy = key
      let cls = active === key ? "voice-tile voice-tile-active" : "voice-tile"
      tiles.push(
        <button
          type="button"
          class={cls}
          key={"vt" + key}
          onclick={() => pickVoice(project, ch, keyCopy, setProject, tplMirrorFlush)}
        >
          {label}
        </button>
      )
      vi = vi + 1
    }
    groups.push(
      <div class="voice-group" key={"vg" + grp.title}>
        <div class="voice-group-label">{grp.title}</div>
        <div class="voice-tiles">{tiles}</div>
      </div>
    )
    gi = gi + 1
  }
  return <div class="voice-picker-groups">{groups}</div>
}

// ---- pill helpers (moved from the old InstrumentEditor; every click is one rt.emit) ----

fn approxEq(a, b) {
  let x = a != null ? a : 0
  let d = x - b
  if (d < 0) {
    d = -d
  }
  return d < 0.012
}

fn fieldAddress(field) {
  if (field === "arp") {
    return "voice/arp"
  }
  if (field === "chord") {
    return "voice/chord"
  }
  if (field === "reverbSend") {
    return "fx/reverb"
  }
  if (field === "drive") {
    return "fx/drive"
  }
  if (field === "filterCutoff") {
    return "fx/cutoff"
  }
  if (field === "filterQ") {
    return "fx/res"
  }
  if (field === "lfoRate") {
    return "fx/lfo_rate"
  }
  if (field === "lfoDepth") {
    return "fx/lfo_depth"
  }
  return "gen/" + field
}

fn PillGroup(label, opts) {
  let pills = []
  let i = 0
  while (i < opts.length) {
    let o = opts[i]
    pills.push(
      <button type="button" class={o.on ? "ie-pill ie-pill-on" : "ie-pill"} onclick={o.click}>
        {o.text}
      </button>
    )
    i = i + 1
  }
  return (
    <div class="ie-group">
      <div class="ie-group-label">{label}</div>
      <div class="ie-pills">{pills}</div>
    </div>
  )
}

fn decayOpts(ch, rt) {
  let names = ["Pluck", "Short", "Medium", "Long", "Pad"]
  let gp = ch.generatorParams ? ch.generatorParams : {}
  let out = []
  let i = 0
  while (i < names.length) {
    let nm = names[i]
    let d = DECAY_PRESETS[nm]
    let active = approxEq(gp.attack, d.attack) && approxEq(gp.decay, d.decay) && approxEq(gp.sustain, d.sustain) && approxEq(gp.release, d.release)
    out.push({
      text: nm,
      on: active,
      click: () => {
        if (rt && rt.emit) {
          rt.emit("track/" + ch.id + "/adsr", { a: d.attack, d: d.decay, s: d.sustain, r: d.release })
        }
      }
    })
    i = i + 1
  }
  return out
}

fn octaveOpts(ch, rt) {
  let vals = [-2, -1, 0, 1, 2]
  let cur = ch.octave != null ? ch.octave : 0
  let out = []
  let i = 0
  while (i < vals.length) {
    let n = vals[i]
    out.push({
      text: n > 0 ? "+" + String(n) : String(n),
      on: cur === n,
      click: () => {
        if (rt && rt.emit) {
          rt.emit("track/" + ch.id + "/voice/octave", n)
        }
      }
    })
    i = i + 1
  }
  return out
}

fn selectOpts(ch, field, defs, rt) {
  let cur = ch[field] != null ? ch[field] : defs[0][1]
  let out = []
  let i = 0
  while (i < defs.length) {
    let d = defs[i]
    out.push({
      text: d[0],
      on: cur === d[1],
      click: () => {
        if (rt && rt.emit) {
          rt.emit("track/" + ch.id + "/" + fieldAddress(field), d[1])
        }
      }
    })
    i = i + 1
  }
  return out
}

fn pairOpts(ch, field, defs, rt) {
  let cur = ch[field]
  let out = []
  let i = 0
  while (i < defs.length) {
    let d = defs[i]
    out.push({
      text: d[0],
      on: approxEq(cur, d[1]),
      click: () => {
        if (rt && rt.emit) {
          rt.emit("track/" + ch.id + "/" + fieldAddress(field), d[1])
        }
      }
    })
    i = i + 1
  }
  return out
}

// ---- module card chrome + per-module Designer⇄Raw reduction ----

fn moduleRawActive(ctx, module) {
  let rt = ctx.rt
  return rt != null && rt.moduleRaw != null && rt.moduleRaw[ctx.ch.id + "/" + module] === true
}

fn setModuleRaw(ctx, module, on) {
  let rt = ctx.rt
  if (!rt) {
    return
  }
  if (!rt.moduleRaw) {
    rt.moduleRaw = {}
  }
  rt.moduleRaw[ctx.ch.id + "/" + module] = on
  ctx.setProject(ctx.project)
}

fn ModuleCard(title, tplBlock, module, ctx, children, wide) {
  let hasRaw = module != null && module !== ""
  let raw = hasRaw && moduleRawActive(ctx, module)
  let cardClass = wide ? "instr-module instr-module-wide" : "instr-module"
  let body = children
  if (raw) {
    body = (
      <textarea
        class="instr-module-raw"
        spellcheck={false}
        value={emitInstrumentModuleTpl(ctx.project, ctx.ch.id, module)}
        onmousedown={(e) => e.stopPropagation()}
        onchange={(e) => {
          if (ctx.rt && ctx.rt.directive) {
            ctx.rt.directive(e.target.value)
          }
        }}
      />
    )
  }
  return (
    <section class={cardClass}>
      <div class="instr-module-head">
        <span class="instr-module-title">{title}</span>
        {hasRaw ? (
          <span class="instr-module-toggle">
            <button type="button" class={raw ? "imt-btn" : "imt-btn imt-on"} onclick={() => setModuleRaw(ctx, module, false)}>{"Designer"}</button>
            <button type="button" class={raw ? "imt-btn imt-on" : "imt-btn"} onclick={() => setModuleRaw(ctx, module, true)}>{"Raw"}</button>
          </span>
        ) : null}
        {tplBlock !== "" ? <span class="instr-module-tpl">{tplBlock}</span> : null}
      </div>
      <div class="instr-module-body">{body}</div>
    </section>
  )
}

fn voiceDesigner(project, ch, gid, setProject, tplMirrorFlush, rt) {
  let isMacro = ch.macroName != null
  return (
    <Fragment>
      <div class="instr-params-wrap">{GeneratorParamPanel(ch, project, setProject, tplMirrorFlush, rt)}</div>
      {gid === "matrixFm" ? (
        <div class="matrixfm-panel-wrap">{MatrixFmPanel(ch, project, setProject, tplMirrorFlush)}</div>
      ) : null}
      {isMacro ? (
        <div class="macro-panel-wrap">{MacroDesignerPanel(ch, project, setProject, tplMirrorFlush)}</div>
      ) : null}
      {gid === "patch" && !isMacro ? (
        <div class="patch-panel-wrap">{PatchGraphPanel(ch, project, setProject, tplMirrorFlush)}</div>
      ) : null}
    </Fragment>
  )
}

fn presetBlock(project, ch, setProject, tplMirrorFlush) {
  let presetOpts = []
  presetOpts.push(<option value="-1">{"— Load preset —"}</option>)
  let pi = 0
  while (pi < project.instrumentPresets.length) {
    let pr = project.instrumentPresets[pi]
    presetOpts.push(<option value={String(pi)}>{pr.name + " (" + generatorLabelById(pr.generatorId) + ")"}</option>)
    pi = pi + 1
  }
  return (
    <div class="preset-block">
      <div class="preset-row">
        <select
          class="preset-select"
          value="-1"
          onmousedown={(e) => e.stopPropagation()}
          onclick={(e) => e.stopPropagation()}
          onchange={(e) => {
            let idx = Number(e.target.value)
            e.target.value = "-1"
            if (idx >= 0 && idx < project.instrumentPresets.length) {
              applyInstrumentPresetToChannel(ch, project.instrumentPresets[idx])
              setProject(project)
              if (tplMirrorFlush) {
                tplMirrorFlush()
              }
            }
          }}
        >
          {presetOpts}
        </select>
        <button
          type="button"
          class="btn-preset-save"
          onclick={() => {
            let nm = prompt("Preset name", ch.name + " sound")
            if (nm && nm.length > 0) {
              addInstrumentPreset(project, nm, ch)
              setProject(project)
            }
          }}
        >
          {"Save preset"}
        </button>
      </div>
    </div>
  )
}

fn VoiceModule(ctx) {
  return ModuleCard("Voice", "", "", ctx, VoicePicker(ctx.project, ctx.ch, ctx.setProject, ctx.tplMirrorFlush))
}

fn SoundModule(ctx, gid) {
  // Modular designers (Matrix FM / Patch / a frozen macro graph) need more room than a small box.
  let wide = gid === "matrixFm" || gid === "patch" || ctx.ch.macroName != null
  return ModuleCard(
    "Sound",
    "→ gen",
    "gen",
    ctx,
    <Fragment>
      <p class="instr-desc">{generatorDescriptionById(gid)}</p>
      {voiceDesigner(ctx.project, ctx.ch, gid, ctx.setProject, ctx.tplMirrorFlush, ctx.rt)}
    </Fragment>,
    wide
  )
}

fn PresetModule(ctx) {
  return ModuleCard("Preset", "", "", ctx, presetBlock(ctx.project, ctx.ch, ctx.setProject, ctx.tplMirrorFlush))
}

fn PitchModule(ctx) {
  let ch = ctx.ch
  let rt = ctx.rt
  return ModuleCard(
    "Pitch",
    "→ voice",
    "voice",
    ctx,
    <Fragment>
      {PillGroup("Octave", octaveOpts(ch, rt))}
      {PillGroup("Arpeggiator", selectOpts(ch, "arp", [["Off", "off"], ["Up", "up"], ["Down", "down"], ["Up-Down", "updown"], ["Random", "random"]], rt))}
      {PillGroup("Chord", selectOpts(ch, "chord", [["Off", "off"], ["Major", "major"], ["Minor", "minor"], ["Dom7", "dom7"], ["Maj7", "maj7"], ["Min7", "min7"], ["Dim", "dim"], ["Aug", "aug"], ["Sus4", "sus4"], ["Add9", "add9"]], rt))}
    </Fragment>
  )
}

export fn InstrumentStack(project, selectedCh, setProjectFromUI, tplMirrorFlush, rt) {
  ensureInstrumentPresets(project)
  let ch = null
  if (selectedCh >= 0 && selectedCh < project.channels.length) {
    ch = project.channels[selectedCh]
  }
  if (!ch) {
    return (
      <section class="panel instr-stack-panel">
        <h2>{"INSTRUMENT"}</h2>
        <p class="instr-panel-hint">{"Select a channel in the rack."}</p>
      </section>
    )
  }
  let gid = ch.generatorId ? ch.generatorId : "basicOsc"
  let ctx = { project: project, ch: ch, rt: rt, setProject: setProjectFromUI, tplMirrorFlush: tplMirrorFlush, accent: accentForGenerator(gid) }
  return (
    <section class="panel instr-stack-panel">
      <div class="instr-stack-head">
        <h2>{"INSTRUMENT // " + ch.name}</h2>
        <span class="instr-stack-sub">{"rack boxes · pick a track in the sequencer · flip any box to Raw"}</span>
      </div>
      <div class="instr-modules-row">
        {VoiceModule(ctx)}
        {SoundModule(ctx, gid)}
        {PitchModule(ctx)}
        {PresetModule(ctx)}
      </div>
    </section>
  )
}
