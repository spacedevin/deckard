// MIDI strip (footer, right of the I/O Rack). Enable Web MIDI, pick an input, MIDI-learn a knob to a target.
// A connected keyboard plays the SELECTED instrument; a learned CC drives its target via rt.emit (deck → the
// move broadcasts + round-trips like a UI drag). Mappings persist locally. `controller` = createMidiController.

import { h, Fragment } from '@tishlang/lattish'
import { IkSelect } from './InstrumentKit.tish'
import { midiTargetList, midiTargetLabel } from '../midi/Midi.tish'

export fn MidiPanel(controller, project, midiGen) {
  if (!controller) {
    return null
  }
  let st = controller.state()
  let enabled = st.supported === true || st.inputs.length > 0
  let connected = st.connectedId !== null && st.connectedId !== undefined && st.connectedId !== ""

  // The footer is just a single MIDI button. Not enabled → click requests Web MIDI. Enabled → click toggles a
  // popover (above the button) that holds the input picker + LEARN + the current mappings.
  let midiBtn = (
    <button
      type="button"
      class={connected ? "midi-btn midi-btn-on" : (st.panelOpen ? "midi-btn midi-btn-open" : "midi-btn")}
      title={enabled ? "MIDI — pick input, learn knobs, manage mappings" : "Enable MIDI — connect a hardware controller (Chrome / Edge)"}
      onmousedown={(e) => e.stopPropagation()}
      onclick={() => {
        if (!enabled) {
          controller.requestAccess()
        } else if (controller.togglePanel) {
          controller.togglePanel()
        }
      }}
    >
      <span class={connected ? "midi-dot midi-dot-on" : "midi-dot"} />
      {"MIDI"}
    </button>
  )

  if (!enabled || !st.panelOpen) {
    return <div class="midi-rack">{midiBtn}</div>
  }

  let inputOpts = [{ value: "", label: "— no input —" }]
  let i = 0
  while (i < st.inputs.length) {
    let inp = st.inputs[i]
    inputOpts.push({ value: inp.id, label: inp.name })
    i = i + 1
  }

  let targets = midiTargetList(project)
  let targetOpts = [{ value: "", label: "— assign to… —" }]
  let ti = 0
  while (ti < targets.length) {
    targetOpts.push({ value: targets[ti].id, label: targets[ti].label })
    ti = ti + 1
  }

  // Mapping chips (key → target label) with a ✕ to remove.
  let mapKeys = Object.keys(st.mappings)
  let chips = []
  let mi = 0
  while (mi < mapKeys.length) {
    let k = mapKeys[mi]
    let label = midiTargetLabel(project, st.mappings[k])
    let kk = k
    chips.push(
      <span class="midi-map-chip" title={String(k) + " → " + label}>
        {label}
        <button type="button" class="midi-map-x" title="Remove mapping" onclick={() => controller.removeMapping(kk)}>{"×"}</button>
      </span>
    )
    mi = mi + 1
  }

  let popover = (
    <div class="midi-popover" onmousedown={(e) => e.stopPropagation()}>
      <div class="midi-popover-top">
        {IkSelect({
          class: "midi-select",
          value: st.connectedId,
          options: inputOpts,
          onChange: (v) => controller.selectInput(v)
        })}
        <button
          type="button"
          class={st.learn ? "midi-learn midi-learn-on" : "midi-learn"}
          title="MIDI-LEARN — turn on, move a knob/fader on your controller, then pick what it should control."
          onclick={() => controller.setLearn(!st.learn)}
        >
          {st.learn ? "LEARN: ON" : "LEARN"}
        </button>
      </div>
      {st.learn && st.pending ? IkSelect({
        class: "midi-select midi-assign",
        value: "",
        placeholder: "Got CC " + String(st.pending.controller) + " — assign it",
        options: targetOpts,
        onChange: (v) => { if (v) { controller.bindPending(v) } }
      }) : null}
      {st.learn && !st.pending ? <span class="midi-hint">{"move a knob on your controller…"}</span> : null}
      {chips.length > 0 ? <div class="midi-popover-chips">{chips}</div> : null}
      <span class="midi-kbd-hint" title="A connected keyboard plays the instrument selected in the INSTRUMENT panel">{"⌨ keyboard → plays the selected instrument"}</span>
    </div>
  )
  return <div class="midi-rack midi-rack-open">{midiBtn}{popover}</div>
}
