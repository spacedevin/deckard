// PlaylistView — the FL-Studio "Playlist" / arrangement timeline. The `song` (project.session.song =
// [{scene, repeat}]) is the TIME axis: an ordered, gapless sequence of scene-plays, each spanning its
// scene's bar length × repeat. We render it as a horizontal BAR timeline with one ROW per scene (P1..Pn);
// each song entry is a block placed at its cumulative bar offset on its scene's row (an FL-style
// staircase). Editing rebuilds the `song` and re-emits it as TPL through the one ingest door
// (rt.applyTpl), so a playlist edit is just another streamed statement — no side-channel, multiplayer-safe.

import { h, Fragment } from '@tishlang/lattish'
import { sceneBarLength } from '../model/Session.tish'

let BAR_PX = 26
let MIN_BARS = 16

// Distinct hue per scene so blocks read at a glance (mirrors the session scene columns).
fn sceneHue(scene) {
  return (Math.floor(Number(scene)) * 47 + 190) % 360
}

fn repOf(e) {
  let r = e && e.repeat != null ? Math.floor(Number(e.repeat)) : 1
  return r < 1 ? 1 : r
}

// Rebuild the `song` block as a standalone TPL fragment (P1 = scene 0). Empty list → an empty `song` block.
fn songToTpl(entries) {
  let body = "tpl 1\nsong\n"
  let i = 0
  while (i < entries.length) {
    let e = entries[i]
    let rep = repOf(e)
    body = body + "  P" + String(Math.floor(Number(e.scene)) + 1) + (rep > 1 ? " x" + String(rep) : "") + "\n"
    i = i + 1
  }
  return body
}

fn cloneSong(song) {
  let out = []
  let i = 0
  while (i < song.length) {
    out.push({ scene: Math.floor(Number(song[i].scene)), repeat: repOf(song[i]) })
    i = i + 1
  }
  return out
}

export fn PlaylistView(project, rt, setProjectFromUI) {
  let session = project.session ? project.session : { song: [], sceneCount: 4 }
  let song = Array.isArray(session.song) ? session.song : []
  let sceneCount = Math.floor(Number(session.sceneCount))
  if (sceneCount < 1 || sceneCount !== sceneCount) {
    sceneCount = 4
  }
  let selIdx = rt && rt.plSelectedIdx != null ? Math.floor(Number(rt.plSelectedIdx)) : -1
  if (selIdx >= song.length) {
    selIdx = -1
  }

  // Commit a new arrangement through the ingest door, then clear any now-invalid selection.
  fn commit(newSong, keepSel) {
    if (rt) {
      rt.plSelectedIdx = keepSel != null ? keepSel : -1
    }
    if (rt && rt.applyTpl) {
      rt.applyTpl(songToTpl(newSong))
    } else if (project.session) {
      project.session.song = newSong
    }
    if (setProjectFromUI) {
      setProjectFromUI(project)
    }
  }
  fn appendScene(s) {
    let ns = cloneSong(song)
    ns.push({ scene: s, repeat: 1 })
    commit(ns, ns.length - 1)
  }
  fn removeAt(i) {
    let ns = cloneSong(song)
    ns.splice(i, 1)
    commit(ns, -1)
  }
  fn bumpRepeat(i, d) {
    let ns = cloneSong(song)
    let r = repOf(ns[i]) + d
    if (r < 1) {
      r = 1
    }
    ns[i].repeat = r
    commit(ns, i)
  }
  fn moveBy(i, dir) {
    let j = i + dir
    if (j < 0 || j >= song.length) {
      return
    }
    let ns = cloneSong(song)
    let tmp = ns[i]
    ns[i] = ns[j]
    ns[j] = tmp
    commit(ns, j)
  }
  fn reorderTo(from, to) {
    if (from === to || from < 0 || to < 0 || from >= song.length || to > song.length) {
      return
    }
    let ns = cloneSong(song)
    let moved = ns.splice(from, 1)[0]
    let dest = to > from ? to - 1 : to
    ns.splice(dest, 0, moved)
    commit(ns, dest)
  }
  fn select(i) {
    if (rt) {
      rt.plSelectedIdx = i
    }
    if (setProjectFromUI) {
      setProjectFromUI(project)
    }
  }

  // Lay out blocks: cumulative bar offset + per-entry bar span (sceneBarLength × repeat).
  let layout = []
  let off = 0
  let li = 0
  while (li < song.length) {
    let e = song[li]
    let rep = repOf(e)
    let span = sceneBarLength(project, e.scene) * rep
    if (span < 1 || span !== span) {
      span = rep
    }
    layout.push({ idx: li, scene: Math.floor(Number(e.scene)), repeat: rep, barOffset: off, barSpan: span })
    off = off + span
    li = li + 1
  }
  let totalBars = off
  let gridBars = totalBars + 4 > MIN_BARS ? totalBars + 4 : MIN_BARS
  let laneWidth = gridBars * BAR_PX

  // playhead: the song entry currently playing (rt.songPos.idx), only while a song is live.
  let playIdx = -1
  if (rt && rt.playing && rt.playMode === "song" && rt.songPos != null && rt.songPos.idx != null) {
    playIdx = Math.floor(Number(rt.songPos.idx))
  }

  // ---- bar ruler ----
  let ruler = []
  let b = 0
  while (b < gridBars) {
    ruler.push(
      <div class={(b % 4 === 0) ? "pl-tick pl-tick-major" : "pl-tick"} style={{ left: String(b * BAR_PX) + "px" }}>
        {b % 4 === 0 ? <span class="pl-tick-num">{String(b + 1)}</span> : null}
      </div>
    )
    b = b + 1
  }

  // ---- scene rows (P1..Pn), each with its blocks ----
  let rows = []
  let s = 0
  while (s < sceneCount) {
    let hue = sceneHue(s)
    let rowBlocks = []
    let k = 0
    while (k < layout.length) {
      let bl = layout[k]
      if (bl.scene === s) {
        let isSel = bl.idx === selIdx
        let cls = "pl-block"
        if (isSel) {
          cls = cls + " pl-block-sel"
        }
        if (bl.idx === playIdx) {
          cls = cls + " pl-block-playing"
        }
        let theBl = bl
        rowBlocks.push(
          <div
            class={cls}
            draggable="true"
            title={"P" + String(s + 1) + " ×" + String(bl.repeat) + " — " + String(bl.barSpan) + " bar" + (bl.barSpan === 1 ? "" : "s") + ". Drag to reorder."}
            style={{ left: String(bl.barOffset * BAR_PX) + "px", width: String(bl.barSpan * BAR_PX - 2) + "px", background: "hsl(" + String(hue) + ", 70%, 42%)", borderColor: "hsl(" + String(hue) + ", 80%, 62%)" }}
            onclick={(e) => { e.stopPropagation(); select(theBl.idx) }}
            ondragstart={(e) => { if (rt) { rt.plDragFrom = theBl.idx } }}
            ondragover={(e) => e.preventDefault()}
            ondrop={(e) => { e.preventDefault(); if (rt && rt.plDragFrom != null) { reorderTo(rt.plDragFrom, theBl.idx); rt.plDragFrom = null } }}
          >
            <span class="pl-block-name">{"P" + String(s + 1)}</span>
            {bl.repeat > 1 ? <span class="pl-block-rep">{"×" + String(bl.repeat)}</span> : null}
          </div>
        )
      }
      k = k + 1
    }
    let scn = s
    rows.push(
      <div class="pl-row">
        <button
          class="pl-row-label"
          style={{ color: "hsl(" + String(hue) + ", 75%, 68%)", borderColor: "hsl(" + String(hue) + ", 60%, 38%)" }}
          title={"Append scene P" + String(s + 1) + " to the arrangement"}
          onclick={() => appendScene(scn)}
        >
          {"P" + String(s + 1)}<span class="pl-row-add">{"＋"}</span>
        </button>
        <div
          class="pl-row-lane"
          style={{ width: String(laneWidth) + "px" }}
          ondragover={(e) => e.preventDefault()}
          ondrop={(e) => { e.preventDefault(); if (rt && rt.plDragFrom != null) { reorderTo(rt.plDragFrom, song.length); rt.plDragFrom = null } }}
        >
          {rowBlocks}
        </div>
      </div>
    )
    s = s + 1
  }

  // ---- selected-block control bar ----
  let ctlBar = null
  if (selIdx >= 0 && selIdx < song.length) {
    let se = song[selIdx]
    ctlBar = (
      <div class="pl-ctl">
        <span class="pl-ctl-label">{"P" + String(Math.floor(Number(se.scene)) + 1) + " · block " + String(selIdx + 1) + "/" + String(song.length)}</span>
        <button class="pl-ctl-btn" title="Earlier" onclick={() => moveBy(selIdx, -1)}>{"◀"}</button>
        <button class="pl-ctl-btn" title="Later" onclick={() => moveBy(selIdx, 1)}>{"▶"}</button>
        <span class="pl-ctl-sep">{"repeat"}</span>
        <button class="pl-ctl-btn" title="Fewer repeats" onclick={() => bumpRepeat(selIdx, -1)}>{"−"}</button>
        <span class="pl-ctl-rep">{"×" + String(repOf(se))}</span>
        <button class="pl-ctl-btn" title="More repeats" onclick={() => bumpRepeat(selIdx, 1)}>{"＋"}</button>
        <button class="pl-ctl-btn pl-ctl-del" title="Remove block" onclick={() => removeAt(selIdx)}>{"✕"}</button>
      </div>
    )
  }

  let empty = song.length === 0
  return (
    <div class="pl-view">
      <div class="pl-head">
        <span class="pl-title">{"ARRANGEMENT"}</span>
        <span class="pl-sub">{empty ? "click a P-row to add a block" : String(song.length) + " block" + (song.length === 1 ? "" : "s") + " · " + String(totalBars) + " bars"}</span>
        {ctlBar}
      </div>
      <div class="pl-scroll">
        <div class="pl-ruler" style={{ width: String(laneWidth) + "px" }}>{ruler}</div>
        <div class="pl-rows" onclick={() => select(-1)}>{rows}</div>
      </div>
    </div>
  )
}
