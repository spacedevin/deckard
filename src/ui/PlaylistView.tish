// PlaylistView — the Set timeline: a recording of WHAT PLAYED. While the transport runs, every step's note
// triggers (stepTriggers' output) are taped; this view draws them as a per-channel grid of the actual
// performance — one lane per channel, a block at every step that channel fired. Save it as a Set and it
// replays note-for-note (the ghost). Recording is always on; hitting Play starts a fresh take.

import { h, Fragment } from '@tishlang/lattish'

let BAR_PX = 26
let STEPS_PER_BAR = 16
let LABEL_W = 76
let MIN_BARS = 16

fn channelLabel(project, bus) {
  if (project && project.channels && bus >= 0 && bus < project.channels.length) {
    let ch = project.channels[bus]
    return ch && ch.name ? String(ch.name) : ("ch " + String(bus))
  }
  return "ch " + String(bus)
}

fn laneHue(idx) {
  return (idx * 47 + 190) % 360
}

export fn PlaylistView(project, rt, props) {
  let p = props ? props : {}
  let tape = rt && Array.isArray(rt.tplTape) ? rt.tplTape : []
  let recordings = Array.isArray(p.recordings) ? p.recordings : []

  // Direct-DOM playhead mover (re-asserted every rAF by the transport.position subscriber in App).
  if (rt) {
    rt.updateTimelinePlayhead = (step, playing) => {
      if (typeof document === "undefined") {
        return
      }
      let el = document.querySelector(".pl-playhead")
      if (!el) {
        return
      }
      if (!playing || step < 0) {
        el.style.opacity = "0"
        return
      }
      el.style.opacity = "1"
      el.style.left = String(LABEL_W + (step / STEPS_PER_BAR) * BAR_PX) + "px"
    }
  }

  // Bucket played triggers into per-channel lanes; each lane records which steps it fired on.
  let laneOrder = []
  let laneMap = {}
  let maxStep = 0
  let totalNotes = 0
  let ti = 0
  while (ti < tape.length) {
    let e = tape[ti]
    if (e.step > maxStep) {
      maxStep = e.step
    }
    let trs = e.triggers != null ? e.triggers : []
    let k = 0
    while (k < trs.length) {
      let bus = Math.floor(Number(trs[k].busIndex))
      let key = String(bus)
      if (!laneMap[key]) {
        laneMap[key] = { bus: bus, label: channelLabel(project, bus), steps: {} }
        laneOrder.push(key)
      }
      laneMap[key].steps[e.step] = true
      totalNotes = totalNotes + 1
      k = k + 1
    }
    ti = ti + 1
  }
  // Stable order: by channel index.
  laneOrder.sort((a, b) => laneMap[a].bus - laneMap[b].bus)

  let gridBars = Math.ceil((maxStep + 1) / STEPS_PER_BAR) + 2
  if (gridBars < MIN_BARS) {
    gridBars = MIN_BARS
  }
  let laneWidth = gridBars * BAR_PX

  // ---- bar ruler ----
  let ruler = []
  let b = 0
  while (b < gridBars) {
    ruler.push(
      <div class={(b % 4 === 0) ? "pl-tick pl-tick-major" : "pl-tick"} style={{ left: String(b * BAR_PX) + "px" }}>
        {b % 4 === 0 ? <span class="pl-tick-num">{String(b + 1)}</span> : null}
      </div>
    )
    b = b + 1
  }

  // ---- lanes (one per channel that played) ----
  let rows = []
  let li = 0
  while (li < laneOrder.length) {
    let lane = laneMap[laneOrder[li]]
    let hue = laneHue(li)
    let blocks = []
    let stepKeys = Object.keys(lane.steps)
    let si = 0
    while (si < stepKeys.length) {
      let s = Math.floor(Number(stepKeys[si]))
      let left = (s / STEPS_PER_BAR) * BAR_PX
      blocks.push(
        <div
          class="pl-evt"
          style={{ left: String(left) + "px", background: "hsl(" + String(hue) + ", 68%, 50%)", borderColor: "hsl(" + String(hue) + ", 80%, 68%)" }}
          title={lane.label + " · step " + String(s)}
        ></div>
      )
      si = si + 1
    }
    rows.push(
      <div class="pl-lane">
        <div class="pl-lane-label" style={{ color: "hsl(" + String(hue) + ", 75%, 70%)" }} title={lane.label}>
          {lane.label}
        </div>
        <div class="pl-lane-track" style={{ width: String(laneWidth) + "px" }}>{blocks}</div>
      </div>
    )
    li = li + 1
  }
  if (laneOrder.length === 0) {
    rows.push(
      <div class="pl-empty-hint">{"hit Play (Sequence or Session) — whatever plays is captured here, then Save it as a replayable Set"}</div>
    )
  }

  // ---- recordings dropdown ----
  let recOpts = [<option value="">{"— replay a Set —"}</option>]
  let ri = 0
  while (ri < recordings.length) {
    recOpts.push(<option value={recordings[ri].name}>{recordings[ri].name}</option>)
    ri = ri + 1
  }

  let steps = tape.length
  let bars = Math.ceil((maxStep + 1) / STEPS_PER_BAR)
  let status = steps === 0
    ? "nothing recorded yet"
    : String(totalNotes) + " note" + (totalNotes === 1 ? "" : "s") + " · " + String(steps) + " step" + (steps === 1 ? "" : "s") + " · " + String(bars) + " bar" + (bars === 1 ? "" : "s")

  return (
    <div class="pl-view pl-tpl">
      <div class="pl-head">
        <span class="pl-title">{"SET RECORDER"}</span>
        <span class="pl-rec pl-rec-on" title="Always recording — hit Play and whatever the sequencer fires is captured here">
          <span class="pl-rec-dot"></span>{"REC"}
        </span>
        <button
          type="button"
          class="pl-btn"
          title="Clear the timeline — the next Play records a fresh take"
          onclick={() => { if (p.onNewTake) { p.onNewTake() } }}
        >
          {"New"}
        </button>
        <button
          type="button"
          class="pl-btn"
          title="Save this take as a replayable Set"
          disabled={steps === 0}
          onclick={() => { if (p.onSaveRecording) { p.onSaveRecording() } }}
        >
          {"Save"}
        </button>
        <select
          class="pl-replay-select"
          value=""
          title="Load a recorded Set and replay exactly what played (the ghost)"
          onchange={(e) => {
            let n = e.target.value
            e.target.value = ""
            if (n && n.length > 0 && p.onLoadReplay) {
              p.onLoadReplay(n)
            }
          }}
        >
          {recOpts}
        </select>
        <span class="pl-status">{status}</span>
      </div>
      <div class="pl-scroll">
        <div class="pl-grid">
          <div class="pl-ruler" style={{ width: String(laneWidth) + "px" }}>{ruler}</div>
          <div class="pl-rows">{rows}</div>
          <div class="pl-playhead"></div>
        </div>
      </div>
    </div>
  )
}
