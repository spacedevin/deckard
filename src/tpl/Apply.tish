import { makeChannel, defaultParamsForGeneratorId, makeStep, makeSteps16 } from '../model/Project.tish'
import {
  findClipOnChannel,
  ensureChannelSessionClips,
  ensureProjectSession,
  tileStepsPattern,
  normalizeClipStepLength,
  normalizeSongEntries,
  normalizeFollow
} from '../model/Session.tish'
import { paramKeyToCamel, snakeToCamel } from './RegistryMap.tish'
import { parseBarSelector, barSelectorMatches } from './BarSelector.tish'
import { lookupMacro, expandMacroBody } from './Macros.tish'
import {
  mixParamFromTpl,
  isChannelMixParam,
  isMasterMixParam,
  isActorMixParam
} from '../audio/MixerAutomation.tish'
import { euclideanPattern } from './Euclidean.tish'
import { parseGenBlock } from './TplExtension.tish'
import { parseProgram } from './Parser.tish'
import { tplLoopResetChannel } from './LoopState.tish'
import { ensureMasterMixer, ensureActorMixerEntries } from '../model/MixerRouting.tish'

export fn findChannelById(project, id) {
  let i = 0
  while (i < project.channels.length) {
    if (project.channels[i].id === id) {
      return project.channels[i]
    }
    i = i + 1
  }
  return null
}

export fn sortPointsByBeat(points) {
  let arr = []
  let pi = 0
  while (pi < points.length) {
    arr.push(points[pi])
    pi = pi + 1
  }
  let i = 0
  while (i < arr.length) {
    let j = i + 1
    while (j < arr.length) {
      if (arr[j].beat < arr[i].beat) {
        let t = arr[i]
        arr[i] = arr[j]
        arr[j] = t
      }
      j = j + 1
    }
    i = i + 1
  }
  return arr
}

export fn applyStepsLiteral(ch, toks, startIdx) {
  let si = 0
  while (si < 16) {
    let ti = startIdx + si
    let on = false
    let vel = 100
    if (ti < toks.length) {
      let t = toks[ti]
      if (t === "x" || t === "X" || t === "1") {
        on = true
      }
    }
    ch.steps[si].on = on
    ch.steps[si].vel = vel
    // A bare `steps` line resets the p-locks to defaults; the parallel step_vel/prob/ratchet/nudge lines
    // (emitted right after) restore any deviations. Keeps round-trip + re-apply-over-existing predictable.
    ch.steps[si].prob = 1
    ch.steps[si].ratchet = 1
    ch.steps[si].nudge = 0
    si = si + 1
  }
}

export fn applyStepsEuclid(ch, hits, len) {
  let n = Math.floor(len)
  let k = Math.floor(hits)
  if (n <= 0) {
    n = 16
  }
  let pat = euclideanPattern(k, n)
  let full = []
  while (full.length < 16) {
    let pj = 0
    while (pj < pat.length && full.length < 16) {
      full.push(pat[pj])
      pj = pj + 1
    }
    if (pj === 0) {
      break
    }
  }
  let fi = 0
  while (fi < 16) {
    ch.steps[fi].on = full[fi]
    ch.steps[fi].vel = 100
    ch.steps[fi].prob = 1
    ch.steps[fi].ratchet = 1
    ch.steps[fi].nudge = 0
    fi = fi + 1
  }
}

// A per-step LANE: `step_vel 100 90 …` / `step_prob 1 .5 …` / `step_ratchet 1 2 …` / `step_nudge 0 .1 …` —
// up to 16 numeric values aligned to the step grid, each written to steps[i][field], clamped to [lo,hi] (and
// floored if isInt). Missing/short tokens fall back to dflt. Parallel to `steps`, emitted right after it.
export fn applyStepLane(ch, toks, field, dflt, lo, hi, isInt) {
  if (!ch.steps) {
    return
  }
  let si = 0
  while (si < 16) {
    let ti = 1 + si
    let v = dflt
    if (ti < toks.length) {
      let n = Number(toks[ti])
      if (n === n) {
        v = n
      }
    }
    if (isInt) {
      v = Math.floor(v)
    }
    if (v < lo) {
      v = lo
    }
    if (v > hi) {
      v = hi
    }
    if (ch.steps[si]) {
      ch.steps[si][field] = v
    }
    si = si + 1
  }
}

export fn parseBoolish(s) {
  if (s === "1" || s === "true" || s === "on" || s === "yes") {
    return true
  }
  return false
}

export fn applyTrackBody(project, ch, body, genBlocks, errors, headerLoopBars) {
  let hl = headerLoopBars
  if (hl === undefined) {
    hl = null
  }
  // `* N` header = PATTERN LENGTH in bars (the loop repeats forever). The finite loop CAP (play N bars
  // then go silent) is separate and comes only from a `loops N` body line.
  let nbars = (hl != null && hl >= 1) ? Math.floor(hl) : 1
  ch.patternBars = nbars
  ch.tplLoopBars = null
  let noteLines = []
  let stepPitchEntries = []
  let hadSteps = false
  // `notes_clear` is the explicit "remove every note" marker — needed because an empty note set is
  // indistinguishable from a mix/fx-only edit (which must NOT wipe notes). Deleting the last piano note emits it.
  let sawNotesClear = false
  let transposeSemi = 0
  let sawTranspose = false
  let bi = 0
  while (bi < body.length) {
    let row = body[bi]
    let t = row.tokens
    if (t.length === 0) {
      bi = bi + 1
      continue
    }
    let h = t[0]
    if (h === "loops") {
      if (t.length >= 2) {
        let v = t[1]
        if (v === "inf" || v === "infinite") {
          ch.tplLoopBars = null
        } else {
          let n = Math.floor(Number(v))
          if (n >= 1 && n === n) {
            ch.tplLoopBars = n
          } else {
            errors.push({ line: row.lineNo, msg: "loops: expected positive integer or inf/infinite" })
          }
        }
      }
    } else {
    if (h === "step_pitch" && t.length >= 2) {
      let sp = Math.floor(Number(t[1]))
      if (sp === sp && sp >= 0 && sp <= 127) {
        let sel = null
        if (t.length >= 4 && t[2] === "bar") {
          sel = parseBarSelector(t[3])
        }
        stepPitchEntries.push({ pitch: sp, sel: sel })
        if (sel === null) {
          ch.stepPitch = sp
        }
      }
    } else if (h === "gen") {
      if (!ch.generatorParams) {
        ch.generatorParams = {}
      }
      let gi = 1
      while (gi + 1 < t.length) {
        let key = snakeToCamel(t[gi])
        let raw = t[gi + 1]
        let num = Number(raw)
        if (num === num && raw.length > 0) {
          ch.generatorParams[key] = num
        } else {
          ch.generatorParams[key] = raw
        }
        gi = gi + 2
      }
    } else if (h === "fx") {
      let fi = 1
      while (fi + 1 < t.length) {
        let k = t[fi]
        let v = Number(t[fi + 1])
        if (v === v) {
          if (k === "reverb_send" || k === "reverb") {
            ch.reverbSend = v
          } else if (k === "drive") {
            ch.drive = v
          } else if (k === "lfo_rate") {
            ch.lfoRate = v
          } else if (k === "lfo_depth") {
            ch.lfoDepth = v
          } else if (k === "cutoff") {
            ch.filterCutoff = v
          } else if (k === "res") {
            ch.filterQ = v
          }
        }
        fi = fi + 2
      }
    } else if (h === "voice") {
      let vi = 1
      while (vi + 1 < t.length) {
        let k = t[vi]
        let raw = t[vi + 1]
        if (k === "octave") {
          let o = Math.floor(Number(raw))
          if (o === o) {
            ch.octave = o
          }
        } else if (k === "arp") {
          ch.arp = raw
        } else if (k === "chord") {
          ch.chord = raw
        }
        vi = vi + 2
      }
    } else if (h === "deck") {
      // `deck <A|B|C|D|live> [slot <n>]` — which deck/player corner this channel routes to.
      if (t.length >= 2) {
        let dl = t[1]
        if (dl === "A" || dl === "B" || dl === "C" || dl === "D" || dl === "live") {
          ch.deck = dl
        }
      }
      let dki = 2
      while (dki + 1 < t.length) {
        if (t[dki] === "slot") {
          let sn = Math.floor(Number(t[dki + 1]))
          if (sn === sn) {
            ch.deckSlot = sn
          }
        }
        dki = dki + 1
      }
    } else if (h === "mix") {
      let mi = 1
      while (mi < t.length) {
        if (t[mi] === "gain" && mi + 1 < t.length) {
          ch.gain = Number(t[mi + 1])
          mi = mi + 2
          continue
        }
        if (t[mi] === "pan" && mi + 1 < t.length) {
          ch.pan = Number(t[mi + 1])
          mi = mi + 2
          continue
        }
        if (t[mi] === "mute" && mi + 1 < t.length) {
          ch.mute = parseBoolish(t[mi + 1])
          mi = mi + 2
          continue
        }
        if (t[mi] === "solo" && mi + 1 < t.length) {
          ch.solo = parseBoolish(t[mi + 1])
          mi = mi + 2
          continue
        }
        if (t[mi] === "eq_lo" && mi + 1 < t.length) {
          ch.eqLo = Number(t[mi + 1])
          mi = mi + 2
          continue
        }
        if (t[mi] === "eq_mid" && mi + 1 < t.length) {
          ch.eqMid = Number(t[mi + 1])
          mi = mi + 2
          continue
        }
        if (t[mi] === "eq_hi" && mi + 1 < t.length) {
          ch.eqHi = Number(t[mi + 1])
          mi = mi + 2
          continue
        }
        mi = mi + 1
      }
    } else {
      if (h === "steps") {
        hadSteps = true
        if (t.length >= 4 && t[1] === "euclid") {
          applyStepsEuclid(ch, Number(t[2]), Number(t[3]))
        } else {
          applyStepsLiteral(ch, t, 1)
        }
      } else if (h === "notes_clear") {
        sawNotesClear = true
      } else if (h === "step_vel") {
        applyStepLane(ch, t, "vel", 100, 1, 127, true)
      } else if (h === "step_prob") {
        applyStepLane(ch, t, "prob", 1, 0, 1, false)
      } else if (h === "step_ratchet") {
        applyStepLane(ch, t, "ratchet", 1, 1, 8, true)
      } else if (h === "step_nudge") {
        applyStepLane(ch, t, "nudge", 0, -0.5, 0.5, false)
      } else {
        if (h === "note") {
          if (t.length >= 6 && t[4] === "v") {
            let sb = Number(t[2])
            let db = Number(t[3])
            let barMax = nbars * 4
            // After `v <vel>`, scan keyword PAIRS (any order): `p <prob>` `r <ratchet>` `n <nudge>` (per-note
            // locks) and `bar <sel>` (repeat on matching loop bars). Locks default 1/1/0 when absent.
            let sel = null
            let nprob = 1
            let nratchet = 1
            let nnudge = 0
            let ti = 6
            while (ti + 1 < t.length) {
              let key = t[ti]
              let val = t[ti + 1]
              if (key === "bar") {
                sel = parseBarSelector(val)
              } else if (key === "p") {
                let pv = Number(val)
                if (pv === pv) {
                  nprob = pv < 0 ? 0 : (pv > 1 ? 1 : pv)
                }
              } else if (key === "r") {
                let rv = Math.floor(Number(val))
                if (rv === rv) {
                  nratchet = rv < 1 ? 1 : (rv > 8 ? 8 : rv)
                }
              } else if (key === "n") {
                let nv = Number(val)
                if (nv === nv) {
                  nnudge = nv < -0.5 ? -0.5 : (nv > 0.5 ? 0.5 : nv)
                }
              }
              ti = ti + 2
            }
            if (sb < 0 || sb >= barMax || sb + db > barMax + 0.0001 || (sel !== null && sb >= 4)) {
              errors.push({
                line: row.lineNo,
                msg: "note: out of range (0<=start, start+dur<=bars*4; with `bar`, start<4)"
              })
            } else {
              let pitch = Math.floor(Number(t[1]))
              let vel = Math.floor(Number(t[5]))
              if (sel === null) {
                noteLines.push({ pitch: pitch, startBeat: sb, durBeats: db, vel: vel, prob: nprob, ratchet: nratchet, nudge: nnudge })
              } else {
                let b = 0
                while (b < nbars) {
                  if (barSelectorMatches(sel, b)) {
                    noteLines.push({ pitch: pitch, startBeat: sb + b * 4, durBeats: db, vel: vel, prob: nprob, ratchet: nratchet, nudge: nnudge })
                  }
                  b = b + 1
                }
              }
            }
          }
        } else {
          if (h === "transpose") {
            if (t.length >= 2) {
              transposeSemi = Math.floor(Number(t[1]))
              sawTranspose = true
            }
          } else {
            if (h === "noise" || h === "fm" || h === "osc") {
              let ki = 1
              while (ki + 1 < t.length) {
                let key = paramKeyToCamel(t[ki])
                let val = t[ki + 1]
                let num = Number(val)
                if (num === num && val.length > 0) {
                  ch.generatorParams[key] = num
                } else {
                  ch.generatorParams[key] = val
                }
                ki = ki + 2
              }
            } else {
              if (h === "adsr") {
                let ai = 1
                while (ai + 1 < t.length) {
                  if (t[ai] === "a") {
                    ch.generatorParams.attack = Number(t[ai + 1])
                  }
                  if (t[ai] === "d") {
                    ch.generatorParams.decay = Number(t[ai + 1])
                  }
                  if (t[ai] === "s") {
                    ch.generatorParams.sustain = Number(t[ai + 1])
                  }
                  if (t[ai] === "r") {
                    ch.generatorParams.release = Number(t[ai + 1])
                  }
                  ai = ai + 2
                }
              }
            }
          }
        }
      }
    }
    }
    bi = bi + 1
  }

  if (noteLines.length === 0 && sawNotesClear) {
    ch.pianoNotes = []
  }
  if (noteLines.length > 0) {
    ch.pianoNotes = []
    let ni = 0
    while (ni < noteLines.length) {
      ch.pianoNotes.push({
        startBeat: noteLines[ni].startBeat,
        durBeats: noteLines[ni].durBeats,
        pitch: noteLines[ni].pitch,
        vel: noteLines[ni].vel,
        prob: noteLines[ni].prob != null ? noteLines[ni].prob : 1,
        ratchet: noteLines[ni].ratchet != null ? noteLines[ni].ratchet : 1,
        nudge: noteLines[ni].nudge != null ? noteLines[ni].nudge : 0
      })
      ni = ni + 1
    }
  }

  // Per-bar step pitch: resolve each loop bar to the last `step_pitch ... bar <sel>` that matches it.
  if (stepPitchEntries.length > 0 && nbars > 1) {
    let hasSel = false
    let ei0 = 0
    while (ei0 < stepPitchEntries.length) {
      if (stepPitchEntries[ei0].sel !== null) {
        hasSel = true
      }
      ei0 = ei0 + 1
    }
    if (hasSel) {
      let byBar = []
      let b = 0
      while (b < nbars) {
        let pitch = ch.stepPitch
        let ei = 0
        while (ei < stepPitchEntries.length) {
          let e = stepPitchEntries[ei]
          if (e.sel === null || barSelectorMatches(e.sel, b)) {
            pitch = e.pitch
          }
          ei = ei + 1
        }
        byBar.push(pitch)
        b = b + 1
      }
      ch.stepPitchByBar = byBar
    } else {
      ch.stepPitchByBar = null
    }
  } else {
    ch.stepPitchByBar = null
  }

  if (sawTranspose) {
    let pi = 0
    while (pi < ch.pianoNotes.length) {
      ch.pianoNotes[pi].pitch = ch.pianoNotes[pi].pitch + transposeSemi
      pi = pi + 1
    }
  }

  if (ch.pianoNotes.length > 0) {
    let si = 0
    while (si < 16) {
      ch.steps[si].on = false
      si = si + 1
    }
  } else {
    if (hadSteps) {
      ch.pianoNotes = []
    }
  }

  if (genBlocks.length > 0) {
    let last = genBlocks[genBlocks.length - 1]
    ch.generatorSpec = parseGenBlock(last.generatorId, last.lines)
  }
}

export fn applyClipStepsLiteral(clip, toks, startIdx) {
  let bars = Math.max(1, Math.floor(clip.bars))
  let want = bars * 16
  let avail = toks.length - startIdx
  let base = []
  let si = 0
  while (si < 16) {
    let on = false
    let vel = 100
    if (startIdx + si < toks.length) {
      let t = toks[startIdx + si]
      if (t === "x" || t === "X" || t === "1") {
        on = true
      }
    }
    base.push(makeStep(on, vel))
    si = si + 1
  }
  if (avail >= want) {
    let out = []
    let j = 0
    while (j < want) {
      let t2 = toks[startIdx + j]
      let on2 = t2 === "x" || t2 === "X" || t2 === "1"
      out.push(makeStep(on2, 100))
      j = j + 1
    }
    clip.steps = out
  } else {
    clip.steps = tileStepsPattern(base, bars)
  }
}

export fn applyClipPatternBody(ch, clip, body, errors) {
  clip.tplLoopBars = null
  let noteLines = []
  let hadSteps = false
  let transposeSemi = 0
  let sawTranspose = false
  let maxBeat = Math.max(4, clip.bars * 4)
  let bi = 0
  while (bi < body.length) {
    let row = body[bi]
    let t = row.tokens
    if (t.length === 0) {
      bi = bi + 1
      continue
    }
    let h = t[0]
    if (h === "loops") {
      if (t.length >= 2) {
        let v = t[1]
        if (v === "inf" || v === "infinite") {
          clip.tplLoopBars = null
        } else {
          let n = Math.floor(Number(v))
          if (n >= 1 && n === n) {
            clip.tplLoopBars = n
          } else {
            errors.push({ line: row.lineNo, msg: "clip loops: expected positive integer or inf" })
          }
        }
      }
    } else {
      if (h === "steps") {
        hadSteps = true
        if (t.length >= 4 && t[1] === "euclid") {
          let tmp = { steps: makeSteps16() }
          applyStepsEuclid(tmp, Number(t[2]), Number(t[3]))
          clip.steps = tileStepsPattern(tmp.steps, Math.max(1, Math.floor(clip.bars)))
        } else {
          applyClipStepsLiteral(clip, t, 1)
        }
      } else {
        if (h === "note") {
          if (t.length >= 6 && t[4] === "v") {
            let sb = Number(t[2])
            let db = Number(t[3])
            // Per-note locks (p/r/n) after `v <vel>` — same keyword-pair scan as track notes (no `bar` in clips).
            let cprob = 1
            let cratchet = 1
            let cnudge = 0
            let cti = 6
            while (cti + 1 < t.length) {
              let ckey = t[cti]
              let cval = t[cti + 1]
              if (ckey === "p") {
                let pv = Number(cval)
                if (pv === pv) {
                  cprob = pv < 0 ? 0 : (pv > 1 ? 1 : pv)
                }
              } else if (ckey === "r") {
                let rv = Math.floor(Number(cval))
                if (rv === rv) {
                  cratchet = rv < 1 ? 1 : (rv > 8 ? 8 : rv)
                }
              } else if (ckey === "n") {
                let nv = Number(cval)
                if (nv === nv) {
                  cnudge = nv < -0.5 ? -0.5 : (nv > 0.5 ? 0.5 : nv)
                }
              }
              cti = cti + 2
            }
            if (sb < 0 || sb + db > maxBeat + 0.0001) {
              errors.push({
                line: row.lineNo,
                msg: "clip note: must fit in clip (0 .. bars*4 beats)"
              })
            } else {
              noteLines.push({
                pitch: Math.floor(Number(t[1])),
                startBeat: sb,
                durBeats: db,
                vel: Math.floor(Number(t[5])),
                prob: cprob,
                ratchet: cratchet,
                nudge: cnudge
              })
            }
          }
        } else {
          if (h === "transpose") {
            if (t.length >= 2) {
              transposeSemi = Math.floor(Number(t[1]))
              sawTranspose = true
            }
          }
        }
      }
    }
    bi = bi + 1
  }

  if (noteLines.length > 0) {
    clip.pianoNotes = []
    let ni = 0
    while (ni < noteLines.length) {
      clip.pianoNotes.push({
        startBeat: noteLines[ni].startBeat,
        durBeats: noteLines[ni].durBeats,
        pitch: noteLines[ni].pitch,
        vel: noteLines[ni].vel,
        prob: noteLines[ni].prob != null ? noteLines[ni].prob : 1,
        ratchet: noteLines[ni].ratchet != null ? noteLines[ni].ratchet : 1,
        nudge: noteLines[ni].nudge != null ? noteLines[ni].nudge : 0
      })
      ni = ni + 1
    }
  } else {
    if (hadSteps) {
      clip.pianoNotes = []
    }
  }

  if (sawTranspose) {
    let pi = 0
    while (pi < clip.pianoNotes.length) {
      clip.pianoNotes[pi].pitch = clip.pianoNotes[pi].pitch + transposeSemi
      pi = pi + 1
    }
  }

  if (clip.pianoNotes.length > 0) {
    let zi = 0
    while (zi < clip.steps.length) {
      clip.steps[zi].on = false
      zi = zi + 1
    }
  }

  normalizeClipStepLength(clip)
}

export fn applySessionClipBlocks(project, clipBlocks, errors) {
  if (!clipBlocks || clipBlocks.length === 0) {
    return
  }
  let bi = 0
  while (bi < clipBlocks.length) {
    let blk = clipBlocks[bi]
    let ch = findChannelById(project, blk.channelId)
    if (!ch) {
      errors.push({ line: 0, msg: "clip " + blk.clipId + ": unknown channel " + blk.channelId })
      bi = bi + 1
      continue
    }
    ensureChannelSessionClips(ch)
    let clip = findClipOnChannel(ch, blk.clipId)
    if (!clip) {
      clip = {
        id: blk.clipId,
        name: blk.displayName && blk.displayName.length > 0 ? blk.displayName : blk.clipId,
        bars: blk.bars,
        steps: [],
        pianoNotes: [],
        tplLoopBars: null
      }
      let j = 0
      let want = Math.max(1, Math.floor(blk.bars)) * 16
      while (j < want) {
        clip.steps.push(makeStep(false, 100))
        j = j + 1
      }
      ch.sessionClips.push(clip)
    }
    clip.bars = blk.bars
    if (blk.displayName && blk.displayName.length > 0) {
      clip.name = blk.displayName
    }
    applyClipPatternBody(ch, clip, blk.body, errors)
    tplLoopResetChannel(ch.id)
    bi = bi + 1
  }
}

export fn applySessionGrid(project, sceneCount, slots) {
  ensureProjectSession(project)
  if (sceneCount !== null && sceneCount !== undefined) {
    let sc = Math.floor(Number(sceneCount))
    if (sc >= 1 && sc === sc) {
      project.session.sceneCount = sc
    }
  }
  if (!slots || slots.length === 0) {
    return
  }
  let si = 0
  while (si < slots.length) {
    let s = slots[si]
    let tidx = 0
    while (tidx < project.channels.length) {
      if (project.channels[tidx].id === s.channelId) {
        break
      }
      tidx = tidx + 1
    }
    if (tidx >= project.channels.length) {
      si = si + 1
      continue
    }
    ensureProjectSession(project)
    let scn = project.session.sceneCount
    while (project.session.slots[tidx].length < scn) {
      project.session.slots[tidx].push("")
    }
    let scIdx = Math.floor(Number(s.scene))
    if (scIdx >= 0 && scIdx < scn) {
      project.session.slots[tidx][scIdx] = s.clipId
    }
    si = si + 1
  }
}

export fn applyAutos(project, autos) {
  if (!project.automation) {
    project.automation = { pitchBend: [], masterGain: [] }
  }
  if (!project.paramAutomations) {
    project.paramAutomations = []
  }
  if (!project.mixerAutomations) {
    project.mixerAutomations = []
  }
  let fromTpl = []
  let touched = {}
  let mixFromTpl = []
  let mixTouched = {}
  let ai = 0
  while (ai < autos.length) {
    let au = autos[ai]
    let hdr = au.header
    if (hdr.length >= 1 && hdr[0] === "master_gain") {
      project.automation.masterGain = sortPointsByBeat(au.points)
    } else {
      if (hdr.length >= 4 && hdr[0] === "actor" && hdr[2] === "mix") {
        let lane = hdr[1]
        let prm = mixParamFromTpl(hdr[3])
        if (isActorMixParam(prm)) {
          let mtk = "actor\t" + lane + "\t" + prm
          mixTouched[mtk] = true
          mixFromTpl.push({
            target: "actor",
            lane: lane,
            param: prm,
            points: sortPointsByBeat(au.points)
          })
        }
      } else {
        if (hdr.length >= 3 && hdr[0] === "master" && hdr[1] === "mix") {
          let prm2 = mixParamFromTpl(hdr[2])
          if (isMasterMixParam(prm2)) {
            let mtk2 = "master\t" + prm2
            mixTouched[mtk2] = true
            mixFromTpl.push({
              target: "master",
              param: prm2,
              points: sortPointsByBeat(au.points)
            })
          }
        } else {
          if (hdr.length >= 3 && hdr[1] === "mix") {
            let cid = hdr[0]
            let prm3 = mixParamFromTpl(hdr[2])
            if (isChannelMixParam(prm3)) {
              let mtk3 = "channel\t" + cid + "\t" + prm3
              mixTouched[mtk3] = true
              mixFromTpl.push({
                target: "channel",
                channelId: cid,
                param: prm3,
                points: sortPointsByBeat(au.points)
              })
            }
          } else {
            if (hdr.length >= 3 && hdr[1] === "gen") {
              let cid4 = hdr[0]
              let prm4 = paramKeyToCamel(hdr[2])
              let tk = cid4 + "\t" + prm4
              touched[tk] = true
              fromTpl.push({
                channelId: cid4,
                param: prm4,
                points: sortPointsByBeat(au.points)
              })
            }
          }
        }
      }
    }
    ai = ai + 1
  }
  let merged = []
  let pi = 0
  while (pi < project.paramAutomations.length) {
    let pa = project.paramAutomations[pi]
    let tk2 = pa.channelId + "\t" + pa.param
    if (!touched[tk2]) {
      merged.push(pa)
    }
    pi = pi + 1
  }
  let fi = 0
  while (fi < fromTpl.length) {
    merged.push(fromTpl[fi])
    fi = fi + 1
  }
  project.paramAutomations = merged
  let mixMerged = []
  let mj = 0
  while (mj < project.mixerAutomations.length) {
    let mx = project.mixerAutomations[mj]
    let mk = ""
    if (mx.target === "master") {
      mk = "master\t" + mx.param
    } else {
      if (mx.target === "actor") {
        mk = "actor\t" + mx.lane + "\t" + mx.param
      } else {
        mk = "channel\t" + mx.channelId + "\t" + mx.param
      }
    }
    if (!mixTouched[mk]) {
      mixMerged.push(mx)
    }
    mj = mj + 1
  }
  let fk = 0
  while (fk < mixFromTpl.length) {
    mixMerged.push(mixFromTpl[fk])
    fk = fk + 1
  }
  project.mixerAutomations = mixMerged
}

export fn applyMasterMixFromTokens(project, tokens) {
  if (!tokens || tokens.length === 0) {
    return
  }
  ensureMasterMixer(project)
  let m = project.masterMixer
  let mi = 0
  while (mi + 1 < tokens.length) {
    let k = tokens[mi]
    let v = Number(tokens[mi + 1])
    if (v === v) {
      if (k === "eq_lo") {
        m.eqLo = v
      } else {
        if (k === "eq_mid") {
          m.eqMid = v
        } else {
          if (k === "eq_hi") {
            m.eqHi = v
          } else {
            if (k === "comp") {
              m.compEnabled = v !== 0
            } else {
              if (k === "reverb") {
                m.reverbEnabled = v !== 0
              }
            }
          }
        }
      }
    }
    mi = mi + 2
  }
}

export fn applyActorMixRows(project, rows) {
  if (!rows || rows.length === 0) {
    return
  }
  ensureActorMixerEntries(project)
  let ri = 0
  while (ri < rows.length) {
    let row = rows[ri]
    let lane = row.lane
    if (!project.actorMixer[lane]) {
      project.actorMixer[lane] = { gain: 1, mute: false, solo: false, eqLo: 0, eqMid: 0, eqHi: 0 }
    }
    let a = project.actorMixer[lane]
    let t = row.tokens
    let mi = 0
    while (mi + 1 < t.length) {
      let k = t[mi]
      let raw = t[mi + 1]
      if (k === "gain" || k === "trim") {
        let gv = Number(raw)
        if (gv === gv) {
          a.gain = gv
        }
      } else {
        if (k === "eq_lo") {
          let n = Number(raw)
          if (n === n) {
            a.eqLo = n
          }
        } else {
          if (k === "eq_mid") {
            let n2 = Number(raw)
            if (n2 === n2) {
              a.eqMid = n2
            }
          } else {
            if (k === "eq_hi") {
              let n3 = Number(raw)
              if (n3 === n3) {
                a.eqHi = n3
              }
            } else {
              if (k === "mute") {
                a.mute = parseBoolish(raw)
              } else {
                if (k === "solo") {
                  a.solo = parseBoolish(raw)
                }
              }
            }
          }
        }
      }
      mi = mi + 2
    }
    ri = ri + 1
  }
}

export fn applyParsed(project, parsed) {
  let errs = parsed.errors
  if (parsed.bpm !== null && parsed.bpm >= 40 && parsed.bpm <= 300) {
    project.bpm = parsed.bpm
  }
  if (parsed.launchQuant !== null && parsed.launchQuant !== undefined) {
    let lq = Math.floor(Number(parsed.launchQuant))
    if (lq >= 1 && lq <= 256 && lq === lq) {
      project.launchQuant = lq
    }
  }
  if (parsed.songSeed !== null && parsed.songSeed !== undefined) {
    let ss = Math.floor(Number(parsed.songSeed))
    if (ss === ss) {
      project.songSeed = ss
    }
  }
  if (parsed.xfade !== null && parsed.xfade !== undefined) {
    let cx = Number(parsed.xfade.x)
    let cy = Number(parsed.xfade.y)
    if (cx === cx) {
      project.transportCrossfade = cx < 0 ? 0 : (cx > 1 ? 1 : cx)
    }
    if (cy === cy) {
      project.transportCrossfadeY = cy < 0 ? 0 : (cy > 1 ? 1 : cy)
    }
  }
  if (parsed.mainDeck !== null && parsed.mainDeck !== undefined) {
    project.transportMainDeck = parsed.mainDeck === "local" ? "local" : "live"
  }
  if (parsed.swing !== null && parsed.swing !== undefined) {
    let sw = Number(parsed.swing)
    if (sw === sw) {
      project.swing = sw < 0 ? 0 : (sw > 1 ? 1 : sw)
    }
  }
  if (parsed.scaleRoot !== null && parsed.scaleRoot !== undefined) {
    if (parsed.scaleRoot < 0 || parsed.scaleMode === "off") {
      project.scaleRoot = null
      project.scaleMode = null
    } else {
      project.scaleRoot = Math.floor(parsed.scaleRoot)
      project.scaleMode = parsed.scaleMode
    }
  }
  let userMacros = parsed.macros ? parsed.macros : {}
  let ti = 0
  while (ti < parsed.tracks.length) {
    let tb = parsed.tracks[ti]
    // Macro reference (`gen <name> [overrides]`): expand into a patch gen_block before building.
    let macroName = null
    let mac = lookupMacro(tb.rawGenId, userMacros)
    if (mac) {
      let body = expandMacroBody(mac, tb.genParams)
      tb.genBlocks.push({ generatorId: "patch", lines: body })
      tb.generatorId = "patch"
      macroName = tb.rawGenId
    }
    let ch = findChannelById(project, tb.id)
    if (!ch) {
      ch = makeChannel(tb.id, tb.name, 36, tb.generatorId)
      project.channels.push(ch)
    }
    ch.name = tb.name
    ch.macroName = macroName
    ch.macroParams = mac ? tb.genParams : null
    if (ch.generatorId !== tb.generatorId) {
      ch.generatorId = tb.generatorId
      ch.generatorParams = defaultParamsForGeneratorId(tb.generatorId)
    }
    let hdrLoop = tb.loopBars
    if (hdrLoop === undefined) {
      hdrLoop = null
    }
    applyTrackBody(project, ch, tb.body, tb.genBlocks, errs, hdrLoop)
    tplLoopResetChannel(tb.id)
    ti = ti + 1
  }
  applySessionClipBlocks(project, parsed.clipBlocks ? parsed.clipBlocks : [], errs)
  applySessionGrid(project, parsed.sessionSceneCount, parsed.sessionSlots ? parsed.sessionSlots : [])
  ensureProjectSession(project)
  if (parsed.song !== null && parsed.song !== undefined) {
    project.session.song = normalizeSongEntries(project, parsed.song)
  }
  if (parsed.follow !== null && parsed.follow !== undefined) {
    project.session.follow = normalizeFollow(project, parsed.follow)
  }
  if (parsed.masterMixTokens !== null && parsed.masterMixTokens !== undefined) {
    applyMasterMixFromTokens(project, parsed.masterMixTokens)
  }
  if (parsed.actorMixRows && parsed.actorMixRows.length > 0) {
    applyActorMixRows(project, parsed.actorMixRows)
  }
  applyAutos(project, parsed.autos)
  return { errors: errs }
}

export fn applyTplSource(project, source) {
  let parsed = parseProgram(source)
  return applyParsed(project, parsed)
}
