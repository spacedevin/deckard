// Line-level classification for deck syntax and step highlighting (no full parse).

import { tokenize } from './Parser.tish'

let TOP_KEYS = {}
TOP_KEYS["deck"] = true
TOP_KEYS["tpl"] = true
TOP_KEYS["bpm"] = true
TOP_KEYS["launch_quant"] = true
TOP_KEYS["song_seed"] = true
TOP_KEYS["track"] = true
TOP_KEYS["auto"] = true
TOP_KEYS["macro"] = true
TOP_KEYS["song"] = true
TOP_KEYS["follow"] = true
TOP_KEYS["xfade"] = true
TOP_KEYS["main_deck"] = true
TOP_KEYS["swing"] = true

let BODY_KEYS = {}
BODY_KEYS["mix"] = true
BODY_KEYS["steps"] = true
BODY_KEYS["note"] = true
BODY_KEYS["noise"] = true
BODY_KEYS["fm"] = true
BODY_KEYS["osc"] = true
BODY_KEYS["adsr"] = true
BODY_KEYS["transpose"] = true
BODY_KEYS["loops"] = true
BODY_KEYS["gen_block"] = true
BODY_KEYS["end"] = true
BODY_KEYS["step_pitch"] = true
BODY_KEYS["voice"] = true
BODY_KEYS["fx"] = true
BODY_KEYS["deck"] = true
BODY_KEYS["gen"] = true
// Patch (gen_block patch) node + wiring + envelope keywords.
BODY_KEYS["conn"] = true
BODY_KEYS["env"] = true
BODY_KEYS["filter"] = true
BODY_KEYS["shaper"] = true
BODY_KEYS["gain"] = true
BODY_KEYS["dur"] = true

// Mid-line modifier keywords (not line-leading): highlighted wherever they appear.
let INLINE_KEYS = {}
INLINE_KEYS["bar"] = true
INLINE_KEYS["v"] = true

export fn isKeyword(s) {
  return TOP_KEYS[s] === true || BODY_KEYS[s] === true
}

export fn isInlineKeyword(s) {
  return INLINE_KEYS[s] === true
}

export fn isStepToken(s) {
  return s === "x" || s === "X" || s === "." || s === "1" || s === "0"
}

// Returns { kind: "steps" | "note" | "keyword" | "plain", tokens: [...], stepIndices: [0..15] for steps lines }.
export fn classifyLine(line) {
  if ((line === null || line === undefined)) {
    return { kind: "plain", tokens: [], stepIndices: [] }
  }
  let t = line.trim()
  if (t.length === 0) {
    return { kind: "plain", tokens: [], stepIndices: [] }
  }
  let toks = tokenize(t)
  if (toks.length === 0) {
    return { kind: "plain", tokens: [], stepIndices: [] }
  }
  let first = toks[0]
  if (first === "steps") {
    let stepIndices = []
    let i = 1
    while (i < toks.length && stepIndices.length < 16) {
      if (isStepToken(toks[i])) {
        stepIndices.push(i)
      }
      i = i + 1
    }
    return { kind: "steps", tokens: toks, stepIndices: stepIndices }
  }
  if (first === "note") {
    return { kind: "note", tokens: toks, stepIndices: [] }
  }
  if (isKeyword(first)) {
    return { kind: "keyword", tokens: toks, stepIndices: [] }
  }
  return { kind: "plain", tokens: toks, stepIndices: [] }
}
