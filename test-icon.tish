import { h } from '@tishlang/lattish'

export fn SessionIcon(shape) {
  let strokeHex = "currentColor"
  if (shape === "download") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon session-ui-icon">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" x2="12" y1="15" y2="3" />
      </svg>
    )
  }
  if (shape === "save") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon session-ui-icon">
        <path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
        <path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7" />
        <path d="M7 3v4a1 1 0 0 0 1 1h7" />
      </svg>
    )
  }
  if (shape === "square") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon session-ui-icon">
        <rect width="18" height="18" x="3" y="3" rx="2" />
      </svg>
    )
  }
  if (shape === "layout-grid") {
    return (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke={strokeHex} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-icon session-ui-icon">
        <rect width="7" height="7" x="3" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="14" rx="1" />
        <rect width="7" height="7" x="3" y="14" rx="1" />
      </svg>
    )
  }
  return null
}
