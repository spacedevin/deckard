// Headless co-DJ HOST that LOGS every deck frame it receives. Used to verify, against the REAL browser client,
// whether a connecting client's INITIAL DECK actually reaches the host. Joins "default" first (wins host),
// answers snapshot requests with a tiny project, then prints every deck.line / deck.block it receives and from
// whom. Run: tish run test/hostlog.tish   (gateway must be on 35987; then connect a browser as the client).
import { WebSocket } from "tish:ws"
import { process } from "tish:process"

let undefined = null

let URL = "ws://127.0.0.1:35987"
let SESSION = "default"
let SKILLS = ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix", "master_mixer"]
let ME = "actor-hostlog"
let SNAP = ["deck 1", "bpm 120", "", "track HostKick id h0 gen noise_burst", "  steps x . . . x . . . x . . . x . . ."]

let ws = null
let tries = 0
while (tries < 20) {
  ws = WebSocket(URL)
  if (ws !== null) { tries = 20 } else { tries = tries + 1 }
}
if (ws === null) { console.log("HOSTLOG-FAIL no gateway"); process.exit(1) }
ws.send(JSON.stringify({ type: "join", sessionId: SESSION, actorId: ME, channelIds: ["default"], skillIds: SKILLS }))

fn snap() { ws.send(JSON.stringify({ type: "state.snapshot", sessionId: SESSION, lines: SNAP, owners: {} })) }

let deckLines = 0
let tplBlocks = 0
let trackLines = 0
let polls = 0
while (polls < 300) {
  let m = null
  try { m = ws.receiveTimeout(200) } catch (e) { m = null }
  if (m !== null) {
    let raw = (m.data !== null && m.data !== undefined) ? m.data : null
    if (raw !== null) {
      let msg = null
      try { msg = JSON.parse(raw) } catch (e) { msg = null }
      if (msg !== null && msg !== undefined) {
        let t = msg.type
        if (t === "joined") {
          console.log("HOSTLOG joined as " + (msg.hostActorId === ME ? "HOST" : "follower"))
          snap()
        } else if (t === "request.snapshot") {
          console.log("HOSTLOG request.snapshot -> answering")
          snap()
        } else if (t === "presence") {
          console.log("HOSTLOG presence actors=" + (msg.actors ? msg.actors.join(",") : "?"))
        } else if (t === "deck.line") {
          deckLines = deckLines + 1
          let from = msg.actorId !== null && msg.actorId !== undefined ? msg.actorId : (msg.authorId || "?")
          let ln = msg.line !== null && msg.line !== undefined ? String(msg.line) : ""
          if (ln.indexOf("track ") === 0) { trackLines = trackLines + 1 }
          console.log("HOSTLOG <- deck.line from=" + from + " : " + ln)
        } else if (t === "deck.block") {
          tplBlocks = tplBlocks + 1
          let from = msg.actorId !== null && msg.actorId !== undefined ? msg.actorId : (msg.authorId || "?")
          let n = msg.lines ? msg.lines.length : 0
          console.log("HOSTLOG <- deck.block from=" + from + " (" + String(n) + " lines)")
          let j = 0
          while (j < n) { console.log("HOSTLOG    | " + String(msg.lines[j])); j = j + 1 }
        }
      }
    }
  }
  polls = polls + 1
}
console.log("HOSTLOG-DONE deck.line=" + String(deckLines) + " (track lines=" + String(trackLines) + ") deck.block=" + String(tplBlocks))
process.exit(0)
