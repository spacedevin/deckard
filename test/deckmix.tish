// Round-trip guard for the deck_mix TPL directive (per-deck booth EQ + volume). Proves the centre DJ-mixer
// strip — which had NO wire representation before — now serializes, parses, and re-applies identically, so it
// can ride the host state.snapshot and a follower deck.put. Run: tish build --target js test/deckmix.tish ...
import { loadDefaultDeckardProject } from '../src/model/ProjectLoad.tish'
import { emitProject, deckMixLine } from '../src/tpl/Emit.tish'
import { parseProgram } from '../src/tpl/Parser.tish'
import { applyCoDjTplSource } from '../src/codj/Merge.tish'
import { ensureDeckEq } from '../src/ui/deck/DeckMixer.tish'

let pass = 0
let fail = 0
fn check(name, cond) {
  if (cond) { pass = pass + 1; console.log("  ok   " + name) }
  else { fail = fail + 1; console.log("  FAIL " + name) }
}

fn approx(a, b) {
  let d = a - b
  if (d < 0) { d = -d }
  return d < 0.001
}

let def = loadDefaultDeckardProject()
let p = def && def.project ? def.project : def
ensureDeckEq(p)

// ---- emit: default decks emit NO deck_mix line (minimal round-trip) ----
check("default deck A emits no deck_mix line", deckMixLine(p, "A") === "")

// ---- set a non-default booth on deck A, emit, assert the line shape ----
p.deckEq["A"] = { hi: 6, mid: 0, lo: -3, flt: -0.5, vol: 0.3 }
let lineA = deckMixLine(p, "A")
check("deck A off-default emits a deck_mix line", lineA.indexOf("deck_mix A ") === 0)
check("deck_mix A carries vol 0.3", lineA.indexOf("vol 0.3") >= 0)
check("deck_mix A carries hi 6", lineA.indexOf("hi 6") >= 0)

let full = emitProject(p)
check("emitProject includes the deck_mix A line", full.indexOf("deck_mix A ") >= 0)

// ---- parse it back ----
let parsed = parseProgram(full)
check("parser produced a deckMix map", parsed.deckMix !== null && parsed.deckMix !== undefined)
check("parser deckMix.A.vol === 0.3", parsed.deckMix !== null && parsed.deckMix.A !== null && parsed.deckMix.A !== undefined && approx(Number(parsed.deckMix.A.vol), 0.3))
check("parser deckMix.A.lo === -3", parsed.deckMix !== null && parsed.deckMix.A !== undefined && approx(Number(parsed.deckMix.A.lo), -3))
check("parser deckMix.A.flt === -0.5", parsed.deckMix !== null && parsed.deckMix.A !== undefined && approx(Number(parsed.deckMix.A.flt), -0.5))

// ---- apply onto a FRESH project (master lane) and assert deckEq reconstructs ----
let def2 = loadDefaultDeckardProject()
let q = def2 && def2.project ? def2.project : def2
ensureDeckEq(q)
applyCoDjTplSource(q, full, "host-actor", "host-actor", 0, ["master_mixer"])
check("applied deckEq.A.vol reconstructs 0.3", q.deckEq && q.deckEq.A && approx(Number(q.deckEq.A.vol), 0.3))
check("applied deckEq.A.hi reconstructs 6", q.deckEq && q.deckEq.A && approx(Number(q.deckEq.A.hi), 6))
check("applied deckEq.A.lo reconstructs -3", q.deckEq && q.deckEq.A && approx(Number(q.deckEq.A.lo), -3))

// ---- a NON-master lane must NOT apply deck_mix (it's master-gated, like the crossfader) ----
let def3 = loadDefaultDeckardProject()
let r = def3 && def3.project ? def3.project : def3
ensureDeckEq(r)
applyCoDjTplSource(r, full, "guest-actor", "guest-actor", 0, ["add_track"])
check("non-master lane does NOT apply deck_mix (vol stays 1)", r.deckEq && r.deckEq.A && approx(Number(r.deckEq.A.vol), 1))

console.log("")
console.log("PASS=" + String(pass) + " FAIL=" + String(fail))
if (fail > 0) { throw new Error("deckmix round-trip failed") }
