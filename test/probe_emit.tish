import { loadDefaultDeckardProject } from '../src/model/ProjectLoad.tish'
import { findChannelById } from '../src/deckfile/Apply.tish'
import { applyCoDjTplSource } from '../src/codj/Merge.tish'
import { matrixFmFactoryInstrumentPresets } from '../src/model/MatrixFmPresets.tish'
import { emitProject } from '../src/deckfile/Emit.tish'
import { emitInstrumentModuleTpl } from '../src/core/Levels.tish'

let p = loadDefaultDeckardProject().project
let presets = matrixFmFactoryInstrumentPresets()
console.log("PRESET0 generatorId=" + String(presets[0].generatorId))
// Apply preset to channel 0 by copying spec.
let ch = p.channels[0]
ch.generatorId = presets[0].generatorId
ch.generatorSpec = presets[0].generatorSpec
ch.generatorParams = presets[0].generatorParams
let full = emitProject(p)
// Print just the first track block.
let lines = full.split("\n")
let i = 0
let printing = false
let shown = 0
while (i < lines.length && shown < 30) {
  let ln = lines[i]
  if (ln.indexOf("track ") === 0 && ln.indexOf("id " + ch.id) >= 0) {
    printing = true
  } else if (ln.length > 0 && ln.charAt(0) !== " " && printing) {
    printing = false
  }
  if (printing) {
    console.log("TRACK| " + ln)
    shown = shown + 1
  }
  i = i + 1
}
console.log("=== gen slice ===")
console.log(emitInstrumentModuleTpl(p, ch.id, "gen"))
