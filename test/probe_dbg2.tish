import { loadDefaultDeckardProject } from '../src/model/ProjectLoad.tish'
import { findChannelById } from '../src/tpl/Apply.tish'
import { applyCoDjTplSource } from '../src/codj/Merge.tish'
import { createEditor } from '../src/core/Edit.tish'
import { emitInstrumentModuleTpl } from '../src/core/Levels.tish'
import { matrixFmFactoryInstrumentPresets } from '../src/model/MatrixFmPresets.tish'
import { syncMatrixFmSpecFromGraph, sortedStringKeys } from '../src/tpl/MatrixFmGraph.tish'

let proj = loadDefaultDeckardProject().project
let store = { project: proj }
fn ingest(src, c) { applyCoDjTplSource(store.project, src, "me", "me", 0, []); return true }
let ed = createEditor(store, ingest, () => { return { actorId: "me", authorId: "me", skillIds: [] } })
let ch = store.project.channels[0]
let T = ch.id
let preset = matrixFmFactoryInstrumentPresets()[0]
ch.generatorId = preset.generatorId
ch.generatorSpec = preset.generatorSpec
ch.generatorParams = preset.generatorParams

let before = emitInstrumentModuleTpl(store.project, T, "gen")
console.log("=== BEFORE (inverse to record) ===")
console.log(before)
let g0 = findChannelById(store.project, T).generatorSpec.graph
let op0 = sortedStringKeys(g0.ops)[0]
console.log("orig ratio of op " + op0 + " = " + String(g0.ops[op0].ratio))
g0.ops[op0].ratio = 7.77
syncMatrixFmSpecFromGraph(findChannelById(store.project, T).generatorSpec)
let fwd = emitInstrumentModuleTpl(store.project, T, "gen")
ed.directiveUndoable(fwd, before, "genblock:" + T)
console.log("=== AFTER EDIT slice ===")
console.log(emitInstrumentModuleTpl(store.project, T, "gen"))
ed.undo()
console.log("=== AFTER UNDO slice ===")
console.log(emitInstrumentModuleTpl(store.project, T, "gen"))
let gU = findChannelById(store.project, T).generatorSpec.graph
console.log("post-undo ratio of op " + op0 + " = " + String(gU.ops[op0] !== null && gU.ops[op0] !== undefined ? gU.ops[op0].ratio : "??"))
