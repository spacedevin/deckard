// Headless review probe for the patch/matrix undoable change.
import { loadDefaultDeckardProject } from '../src/model/ProjectLoad.tish'
import { findChannelById } from '../src/tpl/Apply.tish'
import { applyCoDjTplSource } from '../src/codj/Merge.tish'
import { createEditor } from '../src/core/Edit.tish'
import { emitInstrumentModuleTpl } from '../src/core/Levels.tish'
import { emitProject } from '../src/tpl/Emit.tish'
import { matrixFmFactoryInstrumentPresets } from '../src/model/MatrixFmPresets.tish'
import { syncMatrixFmSpecFromGraph, sortedStringKeys } from '../src/tpl/MatrixFmGraph.tish'

let pass = 0
let fail = 0
fn check(label, cond) {
  if (cond) {
    pass = pass + 1
    console.log("  ok   " + label)
  } else {
    fail = fail + 1
    console.log("  FAIL " + label)
  }
}

// ---- Build a real editor wired to the real ingest door ----
let proj = loadDefaultDeckardProject().project
let store = { project: proj }
let ctx = () => { return { actorId: "me", authorId: "me", skillIds: [] } }
fn ingest(src, c) {
  let actorId = c !== null && c !== undefined ? c.actorId : "me"
  let authorId = c !== null && c !== undefined ? c.authorId : "me"
  let skillIds = c !== null && c !== undefined ? c.skillIds : []
  applyCoDjTplSource(store.project, src, actorId, authorId, 0, skillIds)
  return true
}
let ed = createEditor(store, ingest, ctx)

// Pick first channel and seed it with a real matrixFm preset (proven path), then add steps.
let ch = store.project.channels[0]
let T = ch.id
let preset = matrixFmFactoryInstrumentPresets()[0]
ch.generatorId = preset.generatorId
ch.generatorSpec = preset.generatorSpec
ch.generatorParams = preset.generatorParams
let chM = findChannelById(store.project, T)
check("[setup] channel is matrixFm", chM.generatorSpec !== null && chM.generatorSpec !== undefined && chM.generatorSpec.kind === "matrixFm")

// gen-slice round-trips op/mod/route (the Levels.tish change).
let slice = emitInstrumentModuleTpl(store.project, T, "gen")
check("[gen-slice] keeps op", slice.indexOf("op id 1") >= 0 || slice.indexOf("op ") >= 0)
check("[gen-slice] keeps mod", slice.indexOf("mod ") >= 0)
check("[gen-slice] keeps route", slice.indexOf("route ") >= 0)
check("[gen-slice] keeps steps OUT (gen-only)", slice.indexOf("steps ") < 0)

// Add steps so we can confirm the gen broadcast MERGES (preserves steps).
ed.directive("deck 1\ntrack " + ch.name + " id " + T + "\n  steps x . . . x . . . x . . . x . . .\n")

// ---- directiveUndoable: edit the gen_block via the REAL panel path, then undo/redo ----
// Panel: capture inverse (current gen slice), mutate the graph op ratio, sync spec, re-emit, broadcast undoable.
let before = emitInstrumentModuleTpl(store.project, T, "gen")
let chM2 = findChannelById(store.project, T)
let g0 = chM2.generatorSpec.graph
let opk = sortedStringKeys(g0.ops)
let firstOp = opk[0]
let origRatio = g0.ops[firstOp].ratio
g0.ops[firstOp].ratio = 7.77
syncMatrixFmSpecFromGraph(chM2.generatorSpec)
let fwd = emitInstrumentModuleTpl(store.project, T, "gen")
ed.directiveUndoable(fwd, before, "genblock:" + T)
let afterEdit = emitInstrumentModuleTpl(store.project, T, "gen")
check("[undoable] forward applied (ratio 7.77 present)", afterEdit.indexOf("7.77") >= 0)
check("[undoable] steps preserved after gen broadcast (merge)", emitProject(store.project).indexOf("steps x . . . x") >= 0)
check("[undoable] canUndo true", ed.canUndo() === true)

ed.undo()
let afterUndo = emitInstrumentModuleTpl(store.project, T, "gen")
check("[undoable] undo reverts the ratio (no 7.77)", afterUndo.indexOf("7.77") < 0)
check("[undoable] undo restores original ratio", afterUndo.indexOf("ratio " + String(origRatio)) >= 0)
check("[undoable] undo kept steps", emitProject(store.project).indexOf("steps x . . . x") >= 0)

ed.redo()
let afterRedo = emitInstrumentModuleTpl(store.project, T, "gen")
check("[undoable] redo re-applies ratio 7.77", afterRedo.indexOf("7.77") >= 0)

// ---- coalescing: two consecutive directiveUndoable to same addr => one undo step ----
let ed2store = { project: loadDefaultDeckardProject().project }
fn ingest2(src, c) { applyCoDjTplSource(ed2store.project, src, "me", "me", 0, []); return true }
let ed2 = createEditor(ed2store, ingest2, ctx)
let c2 = ed2store.project.channels[0]
let T2 = c2.id
let preset2 = matrixFmFactoryInstrumentPresets()[0]
c2.generatorId = preset2.generatorId
c2.generatorSpec = preset2.generatorSpec
c2.generatorParams = preset2.generatorParams
let g2 = c2.generatorSpec.graph
let opk2 = sortedStringKeys(g2.ops)
let op2first = opk2[0]
g2.ops[op2first].ratio = 1
syncMatrixFmSpecFromGraph(c2.generatorSpec)
let base2 = emitInstrumentModuleTpl(ed2store.project, T2, "gen")
// first drag commit: ratio 1 -> 2 (inverse = base2)
g2.ops[op2first].ratio = 2
syncMatrixFmSpecFromGraph(c2.generatorSpec)
ed2.directiveUndoable(emitInstrumentModuleTpl(ed2store.project, T2, "gen"), base2, "genblock:" + T2)
let mid2 = emitInstrumentModuleTpl(ed2store.project, T2, "gen")
// second drag commit (same coalesce addr): ratio 2 -> 5 (inverse = mid2)
g2.ops[op2first].ratio = 5
syncMatrixFmSpecFromGraph(c2.generatorSpec)
ed2.directiveUndoable(emitInstrumentModuleTpl(ed2store.project, T2, "gen"), mid2, "genblock:" + T2)
// One undo should jump all the way back to base (coalesced inverse = first inverse = base2 = ratio 1).
ed2.undo()
let coa = emitInstrumentModuleTpl(ed2store.project, T2, "gen")
check("[coalesce] single undo returns to pre-drag (ratio 1)", coa.indexOf("ratio 1") >= 0 && coa.indexOf("ratio 5") < 0)
check("[coalesce] no second undo step", ed2.canUndo() === false)

// ---- emit guard: a boolean(false) / zero / empty edit IS recorded (not skipped by != null) ----
let ed3store = { project: loadDefaultDeckardProject().project }
fn ingest3(src, c) { applyCoDjTplSource(ed3store.project, src, "me", "me", 0, []); return true }
let ed3 = createEditor(ed3store, ingest3, ctx)
let c3 = ed3store.project.channels[0]
let T3 = c3.id
// ensure mute currently false, gain set
applyCoDjTplSource(ed3store.project, "deck 1\ntrack " + c3.name + " id " + T3 + "\n  mix gain 0.85 pan 0 mute 0 solo 0\n", "me", "me", 0, [])
// Toggle mute on -> inverse must encode mute 0 (current false), so it's recorded.
ed3.emit("track/" + T3 + "/mix/mute", true)
check("[guard] toggling mute from false records an undo step", ed3.canUndo() === true)
ed3.undo()
let afterMuteUndo = findChannelById(ed3store.project, T3)
check("[guard] undo restores mute=false", afterMuteUndo.mute !== true)
// gain to 0 (a zero value) then undo restores 0.85
ed3.emit("track/" + T3 + "/mix/gain", 0)
check("[guard] gain->0 records (zero is reversible)", ed3.canUndo() === true)
ed3.undo()
let afterGainUndo = findChannelById(ed3store.project, T3)
check("[guard] undo restores gain 0.85", Math.abs((afterGainUndo.gain !== null && afterGainUndo.gain !== undefined ? afterGainUndo.gain : 0.85) - 0.85) < 1e-6)

console.log("PASS=" + String(pass) + " FAIL=" + String(fail))
