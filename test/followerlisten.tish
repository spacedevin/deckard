// Headless co-DJ FOLLOWER listener for live verification. Joins the "default" room (as a follower, since a
// browser host has already claimed it) and prints every transport control frame it receives, so we can prove
// a real BROWSER host's Play/Stop actually reaches the wire. Runs ~30s then exits.
//   Run: tish run test/followerlisten.tish
import { WebSocket } from "tish:ws"
import { process } from "tish:process"

let undefined = null

let URL = "ws://127.0.0.1:35987"
let SESSION = "default"
let SKILLS = ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix", "master_mixer"]

let ws = null
let tries = 0
while (tries < 20) {
  ws = WebSocket(URL)
  if (ws !== null) { tries = 20 } else { tries = tries + 1 }
}
if (ws === null) { console.log("LISTEN-FAIL no gateway"); process.exit(1) }

ws.send(JSON.stringify({ type: "join", sessionId: SESSION, actorId: "actor-listener", channelIds: ["default"], skillIds: SKILLS }))
console.log("LISTEN-READY joined default as actor-listener")

let polls = 0
let starts = 0
let stops = 0
while (polls < 200) {
  let m = null
  try { m = ws.receiveTimeout(200) } catch (e) { m = null }
  if (m !== null) {
    let raw = (m.data !== null && m.data !== undefined) ? m.data : null
    if (raw !== null) {
      let msg = null
      try { msg = JSON.parse(raw) } catch (e) { msg = null }
      if (msg !== null && msg !== undefined && msg.type === "control") {
        let op = msg.op !== null && msg.op !== undefined ? msg.op : ""
        if (op === "playing_start") {
          starts = starts + 1
          console.log("LISTEN-GOT playing_start from=" + (msg.actorId || "?") + " mode=" + (msg.playMode || "?") + " step=" + String(msg.perfStep))
        } else if (op === "playing_stop") {
          stops = stops + 1
          console.log("LISTEN-GOT playing_stop from=" + (msg.actorId || "?"))
        } else if (op === "clock") {
          console.log("LISTEN-GOT clock step=" + String(msg.perfStep))
        }
      } else if (msg !== null && msg !== undefined && msg.type === "joined") {
        console.log("LISTEN joined hostActorId=" + (msg.hostActorId || "?") + " (I am " + (msg.hostActorId === "actor-listener" ? "HOST" : "follower") + ")")
      }
    }
  }
  polls = polls + 1
}
console.log("LISTEN-DONE starts=" + String(starts) + " stops=" + String(stops))
process.exit(0)
