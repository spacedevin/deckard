// Headless co-DJ CLIENT that faithfully reproduces broadcastSelfLines: joins AFTER a host, waits for the
// host snapshot, then streams its OWN re-homed deck as tpl.line frames (exactly the shape the browser client
// sends: {type:"tpl.line", line, authorId}). Distinct track name CLIENTLEAD so we can spot it on the host.
// Run against a BROWSER host: tish run test/clientsend.tish  → then inspect the browser host's Deck B / log.
import { WebSocket } from "tish:ws"
import { process } from "tish:process"

let undefined = null

let URL = "ws://127.0.0.1:35987"
let SESSION = "default"
let SKILLS = ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix", "master_mixer"]
let ME = "actor-clientsend"

// A re-homed initial deck (ids id-prefixed with my actorId, as rehomeJoinerChannels would produce).
let MY_LINES = [
  "tpl 1",
  "bpm 120",
  "",
  "track CLIENTLEAD id actor-clientsend_c0 gen noise_burst",
  "  mix gain 0.85 pan 0 eq_lo 0 eq_mid 0 eq_hi 0",
  "  noise attack 0.002 decay 0.12 tone 0.5 pitch_follow 0.2",
  "  steps x . x . x . x . x . x . x . x .",
  "",
  "track CLIENTBASS id actor-clientsend_c1 gen noise_burst",
  "  mix gain 0.8 pan 0 eq_lo 0 eq_mid 0 eq_hi 0",
  "  steps x . . . x . . . x . . . x . . ."
]

let ws = null
let tries = 0
while (tries < 20) {
  ws = WebSocket(URL)
  if (ws !== null) { tries = 20 } else { tries = tries + 1 }
}
if (ws === null) { console.log("CLIENT-FAIL no gateway"); process.exit(1) }
ws.send(JSON.stringify({ type: "join", sessionId: SESSION, actorId: ME, channelIds: ["default"], skillIds: SKILLS }))

fn sendMyLines() {
  let i = 0
  while (i < MY_LINES.length) {
    ws.send(JSON.stringify({ type: "tpl.line", line: MY_LINES[i], authorId: ME }))
    i = i + 1
  }
  console.log("CLIENT sent " + String(MY_LINES.length) + " tpl.line frames (CLIENTLEAD + CLIENTBASS)")
}

let sentOnce = false
let polls = 0
while (polls < 200) {
  let m = null
  try { m = ws.receiveTimeout(200) } catch (e) { m = null }
  if (m !== null) {
    let raw = (m.data !== null && m.data !== undefined) ? m.data : null
    if (raw !== null) {
      let msg = null
      try { msg = JSON.parse(raw) } catch (e) { msg = null }
      if (msg !== null && msg !== undefined) {
        let t = msg.type
        if (t === "joined") {
          console.log("CLIENT joined as " + (msg.hostActorId === ME ? "HOST(!)" : "follower") + " host=" + (msg.hostActorId || "?"))
        } else if (t === "state.snapshot") {
          console.log("CLIENT got host snapshot (" + String(msg.lines ? msg.lines.length : 0) + " lines) -> sending my deck")
          if (!sentOnce) { sentOnce = true; sendMyLines() }
        } else if (t === "presence") {
          console.log("CLIENT presence actors=" + (msg.actors ? msg.actors.join(",") : "?"))
        }
      }
    }
  }
  polls = polls + 1
  // Fallback: if no snapshot arrived but we are joined, still send after ~3s so the test isn't snapshot-gated.
  if (!sentOnce && polls === 18) {
    console.log("CLIENT no snapshot yet -> sending my deck anyway (fallback)")
    sentOnce = true
    sendMyLines()
  }
}
console.log("CLIENT-DONE")
process.exit(0)
