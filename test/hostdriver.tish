// Headless co-DJ HOST driver for live follower-apply verification. Joins "default" FIRST (so it wins host),
// answers snapshot requests with a minimal project, then repeatedly broadcasts playing_start / playing_stop so
// a BROWSER joining as a follower can be observed entering / leaving the playing state (coDjFollowStart path).
//   Run: tish run test/hostdriver.tish
import { WebSocket } from "tish:ws"
import { process } from "tish:process"

let undefined = null

let URL = "ws://127.0.0.1:35987"
let SESSION = "default"
let SKILLS = ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix", "master_mixer"]
let ME = "actor-hostdriver"

let SNAP_LINES = ["tpl 1", "bpm 120", "", "track Kick id c0 gen noise_burst", "  steps x . . . x . . . x . . . x . . ."]

let ws = null
let tries = 0
while (tries < 20) {
  ws = WebSocket(URL)
  if (ws !== null) { tries = 20 } else { tries = tries + 1 }
}
if (ws === null) { console.log("HOST-FAIL no gateway"); process.exit(1) }

ws.send(JSON.stringify({ type: "join", sessionId: SESSION, actorId: ME, channelIds: ["default"], skillIds: SKILLS }))

fn sendSnapshot() {
  ws.send(JSON.stringify({ type: "state.snapshot", sessionId: SESSION, lines: SNAP_LINES, owners: {} }))
}

// Drain a few frames; if we see request.snapshot, answer it.
fn pump(rounds) {
  let i = 0
  while (i < rounds) {
    let m = null
    try { m = ws.receiveTimeout(150) } catch (e) { m = null }
    if (m !== null) {
      let raw = (m.data !== null && m.data !== undefined) ? m.data : null
      if (raw !== null) {
        let msg = null
        try { msg = JSON.parse(raw) } catch (e) { msg = null }
        if (msg !== null && msg !== undefined) {
          if (msg.type === "joined") {
            console.log("HOST joined hostActorId=" + (msg.hostActorId || "?") + " (I am " + (msg.hostActorId === ME ? "HOST" : "follower") + ")")
            sendSnapshot()
          } else if (msg.type === "request.snapshot") {
            console.log("HOST got request.snapshot -> answering")
            sendSnapshot()
          } else if (msg.type === "presence") {
            console.log("HOST presence actors=" + (msg.actors ? msg.actors.join(",") : "?"))
          }
        }
      }
    }
    i = i + 1
  }
}

pump(20)

// Broadcast play/stop cycles so a browser follower can be observed following. step climbs each cycle.
let cycle = 0
let step = 0
while (cycle < 10) {
  console.log("HOST -> playing_start step=" + String(step))
  ws.send(JSON.stringify({ type: "control", op: "playing_start", actorId: ME, authorId: ME, perfStep: step, playMode: "song" }))
  pump(20)
  console.log("HOST -> playing_stop")
  ws.send(JSON.stringify({ type: "control", op: "playing_stop", actorId: ME, authorId: ME }))
  pump(14)
  step = step + 16
  cycle = cycle + 1
}
console.log("HOST-DONE")
process.exit(0)
