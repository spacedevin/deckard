// Headless wire test for co-DJ TRANSPORT over WebSocket.
// Boots two real WS clients against a running gateway (ws://localhost:35987):
//   A = first joiner with master_mixer  -> becomes HOST
//   B = second joiner with master_mixer -> becomes FOLLOWER
// Then exercises the host-only transport: host sends playing_start / playing_stop and we assert the
// FOLLOWER receives each control frame across the wire. This isolates the WIRE (host send -> gateway
// relay -> follower receive) from the browser-only apply logic (coDjFollowStart -> onPlay).
//
// Run: gateway must already be listening on 35987, then `tish run test/transportwire.tish`.
import { WebSocket } from "tish:ws"
import { process } from "tish:process"

// Native `tish run` has no `undefined` global — define it so `x !== undefined` never crashes.
let undefined = null

let URL = "ws://localhost:35987"
let SESSION = "wiretest"
let SKILLS = ["add_track", "adjust_instrument", "pattern_steps", "pattern_piano", "channel_mix", "master_mixer"]

let pass = 0
let fail = 0
fn check(name, cond) {
  if (cond) {
    pass = pass + 1
    console.log("  ok   " + name)
  } else {
    fail = fail + 1
    console.log("  FAIL " + name)
  }
}

fn connect() {
  let ws = null
  let tries = 0
  while (tries < 20) {
    ws = WebSocket(URL)
    if (ws !== null) { return ws }
    tries = tries + 1
    let w = 0
    while (w < 1500000) { w = w + 1 }
  }
  return null
}

fn sendJoin(ws, actorId) {
  ws.send(JSON.stringify({ type: "join", sessionId: SESSION, actorId: actorId, channelIds: ["default"], skillIds: SKILLS }))
}

// Read frames until we find one matching (type, op) or we exhaust `rounds` idle polls. op==="" matches any
// op for that type. Returns the matched parsed msg, or null. Non-matching frames are drained (and logged).
fn waitFor(ws, wantType, wantOp, rounds) {
  let i = 0
  while (i < rounds) {
    let m = null
    try { m = ws.receiveTimeout(300) } catch (e) { m = null }
    if (m === null) {
      i = i + 1
    } else {
      let raw = (m !== null && m.data !== null && m.data !== undefined) ? m.data : null
      if (raw !== null) {
        let msg = null
        try { msg = JSON.parse(raw) } catch (e) { msg = null }
        if (msg !== null && msg !== undefined) {
          if (msg.type === "ping") {
            // keep polling, doesn't count as progress
          } else {
            let op = msg.op !== null && msg.op !== undefined ? msg.op : ""
            if (msg.type === wantType && (wantOp === "" || op === wantOp)) {
              return msg
            }
            // drain unrelated frame, keep looking (don't burn a round on a real frame)
          }
        }
      }
    }
  }
  return null
}

// Drain whatever is queued (joined/presence/request.snapshot) for `rounds` idle polls.
fn drain(ws, rounds) {
  let i = 0
  while (i < rounds) {
    let m = null
    try { m = ws.receiveTimeout(150) } catch (e) { m = null }
    if (m === null) { i = i + 1 }
  }
}

console.log("[wiretest] connecting A (host)")
let A = connect()
if (A === null) { console.log("FAIL could not connect A — is the gateway on 35987?"); process.exit(1) }
sendJoin(A, "actor-A")
let aJoined = waitFor(A, "joined", "", 12)
check("A receives joined", aJoined !== null)
let aIsHost = aJoined !== null && aJoined.hostActorId === "actor-A"
check("A elected HOST (hostActorId===actor-A)", aIsHost)

console.log("[wiretest] connecting B (follower)")
let B = connect()
if (B === null) { console.log("FAIL could not connect B"); process.exit(1) }
sendJoin(B, "actor-B")
let bJoined = waitFor(B, "joined", "", 12)
check("B receives joined", bJoined !== null)
check("B sees host = actor-A (B is follower)", bJoined !== null && bJoined.hostActorId === "actor-A")

// Let presence / request.snapshot settle on both sides.
drain(A, 4)
drain(B, 4)

// ---- PLAY: host sends playing_start, follower must receive it ----
console.log("[wiretest] HOST -> playing_start")
A.send(JSON.stringify({ type: "control", op: "playing_start", actorId: "actor-A", authorId: "actor-A", perfStep: 0, playMode: "song" }))
let gotStart = waitFor(B, "control", "playing_start", 16)
check("FOLLOWER receives playing_start over the wire", gotStart !== null)
check("playing_start carries playMode", gotStart !== null && (gotStart.playMode === "song" || gotStart.playMode === "sequence"))
check("playing_start stamped with host actorId", gotStart !== null && gotStart.actorId === "actor-A")

// ---- STOP: host sends playing_stop, follower must receive it ----
console.log("[wiretest] HOST -> playing_stop")
A.send(JSON.stringify({ type: "control", op: "playing_stop", actorId: "actor-A", authorId: "actor-A" }))
let gotStop = waitFor(B, "control", "playing_stop", 16)
check("FOLLOWER receives playing_stop over the wire", gotStop !== null)

// ---- ECHO GUARD: the host must NOT receive its own control frames back ----
console.log("[wiretest] HOST -> playing_start (echo guard)")
A.send(JSON.stringify({ type: "control", op: "playing_start", actorId: "actor-A", authorId: "actor-A", perfStep: 4, playMode: "sequence" }))
let echo = waitFor(A, "control", "playing_start", 6)
check("HOST does NOT receive its own playing_start (no echo)", echo === null)
// and the follower still gets this second one
let gotStart2 = waitFor(B, "control", "playing_start", 12)
check("FOLLOWER receives the 2nd playing_start (sequence mode)", gotStart2 !== null && gotStart2.playMode === "sequence")

console.log("")
console.log("[wiretest] PASS=" + String(pass) + " FAIL=" + String(fail))
if (fail > 0) { process.exit(1) }
process.exit(0)
