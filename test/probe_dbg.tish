import { loadDefaultDeckardProject } from '../src/model/ProjectLoad.tish'
import { findChannelById } from '../src/tpl/Apply.tish'
import { applyCoDjTplSource } from '../src/codj/Merge.tish'
import { emitProject } from '../src/tpl/Emit.tish'

let p = loadDefaultDeckardProject().project
let ch = p.channels[0]
let T = ch.id
console.log("channel name=" + String(ch.name) + " id=" + String(T))
let mtx = "deck 1\ntrack " + ch.name + " id " + T + " gen matrixFm\n" +
  "  gen_block matrix_fm\n" +
  "    op 1 wave sine ratio 1\n" +
  "    op 2 wave sine ratio 2\n" +
  "    mod fm 2 1 0.4\n" +
  "    route op 1 out 1\n" +
  "  end gen_block\n"
applyCoDjTplSource(p, mtx, "me", "me", 0, [])
let chM = findChannelById(p, T)
console.log("after: generatorId=" + String(chM.generatorId))
console.log("after: spec=" + String(chM.generatorSpec !== null && chM.generatorSpec !== undefined))
if (chM.generatorSpec !== null && chM.generatorSpec !== undefined) {
  console.log("after: kind=" + String(chM.generatorSpec.kind))
}
// owner?
if (p.coDjMeta && p.coDjMeta.tracks && p.coDjMeta.tracks[T]) {
  console.log("owner=" + String(p.coDjMeta.tracks[T].ownerActorId))
} else {
  console.log("no coDjMeta owner entry")
}
