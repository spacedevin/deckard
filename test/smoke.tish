// ---- Modular patch: gen-block emit fidelity + pan node + decomposed-card render ----
// (1) The `gen` module slice must keep EVERY patch line — string/pan/dur were silently dropped before,
// which would corrupt a multiplayer broadcast (the new patch cards emit through this exact door).
let pgP = loadDefaultDeckardProject().project
let pgCh = pgP.channels[0]
pgCh.generatorId = "patch"
pgCh.generatorSpec = parseGenBlock("patch", ["osc o1 sine note", "string st1 note tone 0.5 damping 0.4 decay 0.6", "pan p1 0.3", "gain a1 1", "conn o1 a1 1", "conn a1 p1 1", "conn p1 out 1", "dur 0.5"])
