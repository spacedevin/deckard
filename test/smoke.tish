// (4) The patch broadcast emits a gen-ONLY fragment through the ingest door on every edit — it MUST merge
// (preserve the channel's steps + mix), not replace the whole track. This is the data-loss guard.
let pgMP = loadDefaultDeckardProject().project
let pgMch = pgMP.channels[0]
pgMch.generatorId = "patch"
pgMch.generatorSpec = parseGenBlock("patch", ["osc o1 sine note", "gain a1 1", "conn o1 a1 1", "conn a1 out 1"])
let pgFreshSteps = []
let pgsi = 0
while (pgsi < 16) {
  pgFreshSteps.push({ on: pgsi === 0 || pgsi === 8, vel: 100 })
  pgsi = pgsi + 1
}
pgMch.steps = pgFreshSteps
pgMch.gain = 0.42
let pgGenFrag = emitInstrumentModuleTpl(pgMP, pgMch.id, "gen")
applyCoDjTplSource(pgMP, "deck 1\n" + pgGenFrag + "\n", "host", "host", 0, ["add_track", "pattern_steps", "master"])
let pgMch2 = pgMP.channels[0]
check("patch broadcast MERGES: steps preserved (not wiped by a gen edit)", pgMch2.steps.filter(s => s.on).length === 2)
check("patch broadcast MERGES: mix gain preserved", Math.abs(pgMch2.gain - 0.42) < 0.001)
check("patch broadcast MERGES: gen still patch with the osc node", pgMch2.generatorId === "patch" && pgMch2.generatorSpec.raw.join(" ").indexOf("osc o1") >= 0)

// (5) Review fixes: broadcast fires on COMMIT (discrete edit / drag-end), not on render; orphan conns are
// visible + removable; Knob onCommit fires on a wheel tick.
fn pgFindClass(node, cls) {
  if (node === null || node === undefined || typeof node !== "object") {
    return null
  }
  if (Array.isArray(node)) {
    let pfci = 0
    while (pfci < node.length) {
      let pfcr = pgFindClass(node[pfci], cls)
      if (pfcr !== null && pfcr !== undefined) {
        return pfcr
      }
      pfci = pfci + 1
    }
    return null
  }
  if (pkClass(node).split(" ").indexOf(cls) >= 0) {
    return node
  }
  if (node.children !== null && node.children !== undefined) {
    return pgFindClass(node.children, cls)
  }
  return null
}
