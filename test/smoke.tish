// (12) Patch ENV dropdowns + envelope cables (matrixFm→patch). The Lattish vdom mounts a <select value=X>
// before its <option> children, so without a `selected` attribute the select falls back to its FIRST option on
// mount — the "every ENV dropdown shows op1" bug. selOpt marks the matching option selected. (This asserts the
// fix is WIRED in the vnode; the DOM mount artifact itself is verified in the browser.)
fn pgSelectedOptionValues(node, acc) {
  if (node === null || node === undefined || typeof node !== "object") {
    return acc
  }
  if (Array.isArray(node)) {
    let psi = 0
    while (psi < node.length) {
      pgSelectedOptionValues(node[psi], acc)
      psi = psi + 1
    }
    return acc
  }
  if (node.tag === "option" && node.props !== null && node.props !== undefined && node.props.selected === "selected") {
    acc.push(String(node.props.value))
  }
  if (node.children !== null && node.children !== undefined) {
    pgSelectedOptionValues(node.children, acc)
  }
  return acc
}
