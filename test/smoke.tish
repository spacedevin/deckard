// 7. Lookahead scheduler helpers: self-correcting step advance, no accumulated drift.
check("secondsPerStep: 120bpm = 0.125s per 16th", Math.abs(secondsPerStep(120) - 0.125) < 1e-9)
check("secondsPerStep: clamps low bpm to 40", secondsPerStep(10) === secondsPerStep(40))
check("secondsPerStep: clamps high bpm to 300", secondsPerStep(999) === secondsPerStep(300))
// Normal cadence: scheduler just past a step, window 0.1s, 0.125s/step → schedules ~1 step ahead.
let sp = secondsPerStep(120)
// Swing: even (on-beat) steps unshifted; odd (off-beat) steps delayed by swing*sp*0.5; 0/clamped edge cases.
check("swing: 0 swing = no offset on any step", swingOffsetSec(0, sp, 0) === 0 && swingOffsetSec(1, sp, 0) === 0)
check("swing: even steps never shift", swingOffsetSec(0, sp, 0.5) === 0 && swingOffsetSec(2, sp, 0.5) === 0 && swingOffsetSec(4, sp, 1) === 0)
check("swing: odd step delayed by swing*sp*0.5", Math.abs(swingOffsetSec(1, sp, 0.5) - (0.5 * sp * 0.5)) < 1e-12 && Math.abs(swingOffsetSec(3, sp, 0.6) - (0.6 * sp * 0.5)) < 1e-12)
check("swing: clamps swing > 1 to a half-step max", Math.abs(swingOffsetSec(1, sp, 5) - (sp * 0.5)) < 1e-12)
check("swing: negative swing clamps to 0", swingOffsetSec(1, sp, -1) === 0)
let r1 = stepsToScheduleInWindow(0, 0.06, 0.0, 0.1, sp, 256)
check("window: schedules the steps within lookahead", r1.items.length === 1 && r1.items[0].step === 0)
check("window: advances cursor by one step", r1.nextStep === 1 && Math.abs(r1.nextSec - (0.06 + sp)) < 1e-9)
check("window: nothing scheduled in the past under normal cadence", underrunsInBatch(r1.items, 0.0) === 0)
// Self-correcting: 100 consecutive windows must land step N at exactly start + N*sp (no drift).
let stepC = 0
let secC = 0.0
let now = 0.0
let lastWhen = -1
let drift = 0
let iter = 0
while (iter < 100) {
  now = now + 0.05                                  // advance the (jittery) clock ~half a step
  let rr = stepsToScheduleInWindow(stepC, secC, now, 0.1, sp, 256)
  let k = 0
  while (k < rr.items.length) {
    let expected = rr.items[k].step * sp            // step N must be at exactly N * sp
    if (Math.abs(rr.items[k].when - expected) > 1e-9) { drift = drift + 1 }
    lastWhen = rr.items[k].when
    k = k + 1
  }
  stepC = rr.nextStep
  secC = rr.nextSec
  iter = iter + 1
}
check("window: 100-iter run has ZERO accumulated drift", drift === 0)
check("window: reached ~step 100 over 100 half-step ticks", stepC >= 38 && stepC <= 42)
// Catch-up burst is capped by maxBatch (clock jumped far ahead, e.g. tab resume).
let rb = stepsToScheduleInWindow(0, 0.0, 100.0, 0.1, sp, 8)
check("window: maxBatch caps a runaway catch-up", rb.items.length === 8)

// ---- Set Recorder waveform accumulator (the de-jank: incremental per-deck energy fold, replaces the
// per-render re-bucket + giant SVG path) -------------------------------------------------------------------
console.log("=== Set Recorder energy accumulator ===")
let seEn = freshSetEnergy()
let seAct = freshActiveDecks()
// busIndex -> deck: bus 0,1 on A; bus 2 on B; bus 3 on C.
let seDob = ["A", "A", "B", "C"]
// step 0: two A hits (vel 100 + 80) + one B hit (vel 64). A is new → newLane true.
let nl0 = foldSetEnergyStep(seEn, seAct, seDob, 0, [
  { busIndex: 0, vel: 100 }, { busIndex: 1, vel: 80 }, { busIndex: 2, vel: 64 }
])
check("setEnergy: first fold flags a new lane", nl0 === true)
check("setEnergy: deck A step0 = summed velocity (100+80)", seEn.A["0"] === 180)
check("setEnergy: deck B step0 = 64", seEn.B["0"] === 64)
check("setEnergy: maxStep tracks the step", seEn.maxStep === 0)
check("setEnergy: maxE is the running max bucket (180)", seEn.maxE === 180)
check("setEnergy: totalNotes counts every trigger (3)", seEn.totalNotes === 3)
check("setEnergy: only fired decks are active", seAct.A === true && seAct.B === true && seAct.C === false && seAct.D === false)
// step 4: another A hit, same deck → NOT a new lane; vel NaN/0 sanitizes to 100.
let nl1 = foldSetEnergyStep(seEn, seAct, seDob, 4, [{ busIndex: 0, vel: 0 }])
check("setEnergy: re-firing an active deck is not a new lane", nl1 === false)
check("setEnergy: vel<=0 sanitizes to 100", seEn.A["4"] === 100)
check("setEnergy: maxStep advanced to 4", seEn.maxStep === 4)
// step 4 deck C first sound → new lane; an off-roster bus (99) falls back to deck A (nothing dropped).
let nl2 = foldSetEnergyStep(seEn, seAct, seDob, 4, [{ busIndex: 3, vel: 90 }, { busIndex: 99, vel: 50 }])
check("setEnergy: a deck's first sound on a later step is a new lane", nl2 === true)
check("setEnergy: deck C now active", seAct.C === true)
check("setEnergy: off-roster bus falls back to deck A (not dropped)", seEn.A["4"] === 150)
// fresh reset clears everything.
let seEn2 = freshSetEnergy()
let seAct2 = freshActiveDecks()
check("setEnergy: freshSetEnergy resets buckets + aggregates", Object.keys(seEn2.A).length === 0 && seEn2.maxStep === 0 && seEn2.maxE === 1 && seEn2.totalNotes === 0)
check("setEnergy: freshActiveDecks resets all flags", seAct2.A === false && seAct2.B === false && seAct2.C === false && seAct2.D === false)
// rebuild-from-tape parity: folding the same tape twice into fresh maps yields identical energy.
let tape2 = [
  { step: 0, triggers: [{ busIndex: 0, vel: 100 }, { busIndex: 2, vel: 64 }] },
  { step: 8, triggers: [{ busIndex: 1, vel: 70 }] }
]
let rA = freshSetEnergy()
let rAact = freshActiveDecks()
let rB = freshSetEnergy()
let rBact = freshActiveDecks()
let rIdx = 0
while (rIdx < tape2.length) {
  foldSetEnergyStep(rA, rAact, seDob, tape2[rIdx].step, tape2[rIdx].triggers)
  foldSetEnergyStep(rB, rBact, seDob, tape2[rIdx].step, tape2[rIdx].triggers)
  rIdx = rIdx + 1
}
check("setEnergy: rebuild is deterministic (same tape → same energy)", JSON.stringify(rA) === JSON.stringify(rB) && rA.maxStep === 8 && rA.totalNotes === 3)

// ---- UI render smoke: build the sequencer vnode with EVERY per-row expansion open (lock lanes, automation
// lane, generative toolbar) so a render-time crash is caught here, not in the browser. (lattish `h` builds
// plain vnodes headlessly; the post-render setTimeout playhead poke is a no-op with document stubbed.) This
// guards against JSX-runtime shadowing — e.g. a local `let h` clobbering the hyperscript fn ("h is not a fn").
if (typeof globalThis.document === "undefined") {
  globalThis.document = { querySelectorAll: () => [], getElementById: () => null, querySelector: () => null }
}
let uiP = loadDefaultDeckardProject().project
let uiRt = { gridLocks: {}, gridAuto: {}, gridExpanded: {}, gridPianoLocks: {}, gridBars: 1, gridViewBar: 0, emit: () => {}, bumpGrid: () => {}, directive: () => {} }
let uci = 0
while (uci < uiP.channels.length) {
  uiRt.gridLocks[uiP.channels[uci].id] = true
  uiRt.gridAuto[uiP.channels[uci].id] = true
  uiRt.gridExpanded[uiP.channels[uci].id] = true
  uiRt.gridPianoLocks[uiP.channels[uci].id] = true
  uci = uci + 1
}
// Give one channel piano notes so the piano grid + per-note lock lanes actually render in the smoke.
uiP.channels[0].pianoNotes = [{ startBeat: 0, durBeats: 0.25, pitch: 60, vel: 100, prob: 0.5, ratchet: 2, nudge: 0.1 }]
let uiRendered = false
try {
  let uiVnode = StepGridPanel(uiP, 0, () => {}, () => {}, uiRt, null)
  uiRendered = uiVnode !== null && uiVnode !== undefined
} catch (uiErr) {
  console.log("  (render threw: " + String(uiErr) + ")")
  uiRendered = false
}
check("UI: StepGridPanel renders with all lanes/expansions open (no h-shadow / render crash)", uiRendered)

// ---- Pitch selector knobs: detent-dot rendering on the shared Knob + the octave/arp/chord index<->value
// mapping. Catches a knob-render crash (h-shadow) and locks the new stepped-selector behaviour. ----
fn pkCircles(node, acc) {
  if (node === null || node === undefined) {
    return acc
  }
  if (Array.isArray(node)) {
    let pci = 0
    while (pci < node.length) {
      pkCircles(node[pci], acc)
      pci = pci + 1
    }
    return acc
  }
  if (typeof node !== "object") {
    return acc
  }
  if (node.tag === "circle") {
    acc.push(node)
  }
  if (node.children !== null && node.children !== undefined) {
    pkCircles(node.children, acc)
  }
  return acc
}
fn pkClass(n) {
  return n.props !== null && n.props !== undefined && n.props.class !== null && n.props.class !== undefined ? n.props.class : ""
}
fn pkFindTag(node, tagName) {
  if (node === null || node === undefined || typeof node !== "object") {
    return null
  }
  if (Array.isArray(node)) {
    let pfi = 0
    while (pfi < node.length) {
      let pfr = pkFindTag(node[pfi], tagName)
      if (pfr !== null && pfr !== undefined) {
        return pfr
      }
      pfi = pfi + 1
    }
    return null
  }
  if (node.tag === tagName) {
    return node
  }
  if (node.children !== null && node.children !== undefined) {
    return pkFindTag(node.children, tagName)
  }
  return null
}
fn pkClassText(node, cls) {
  if (node === null || node === undefined || typeof node !== "object") {
    return null
  }
  if (Array.isArray(node)) {
    let pti = 0
    while (pti < node.length) {
      let ptr = pkClassText(node[pti], cls)
      if (ptr !== null && ptr !== undefined) {
        return ptr
      }
      pti = pti + 1
    }
    return null
  }
  if (pkClass(node) === cls && node.children !== null && node.children !== undefined && node.children.length > 0) {
    return node.children[0]
  }
  if (node.children !== null && node.children !== undefined) {
    return pkClassText(node.children, cls)
  }
  return null
}
fn pkDetents(vn) {
  return pkCircles(vn, []).filter(c => pkClass(c).indexOf("ik-knob-detent") >= 0)
}
fn pkLit(vn) {
  return pkCircles(vn, []).filter(c => pkClass(c).indexOf("ik-knob-detent-on") >= 0)
}

let pkK = Knob({ label: "T", value: 1, min: 0, max: 4, step: 1, detents: 5, onInput: () => {} })
check("knob detents: 5 position dots for detents:5", pkDetents(pkK).length === 5)
check("knob detents: exactly one dot lit", pkLit(pkK).length === 1)
let pkMin = Knob({ value: 0, min: 0, max: 4, step: 1, detents: 5, onInput: () => {} })
let pkMax = Knob({ value: 4, min: 0, max: 4, step: 1, detents: 5, onInput: () => {} })
check("knob detents: lit dot tracks the value (min cx < max cx)", Number(pkLit(pkMin)[0].props.cx) < Number(pkLit(pkMax)[0].props.cx))

let pkPlain = Knob({ value: 0.5, min: 0, max: 1, step: 0.01, onInput: () => {} })
check("knob: no detents → one moving dot, zero detent dots", pkDetents(pkPlain).length === 0 && pkCircles(pkPlain, []).filter(c => pkClass(c) === "ik-knob-dot").length === 1)

let pkWheel = []
let pkW = Knob({ value: 1, min: 0, max: 4, step: 1, detents: 5, onInput: (v) => pkWheel.push(v) })
let pkWsvg = pkFindTag(pkW, "svg")
pkWsvg.props.onwheel({ deltaY: -1, preventDefault: () => {} })
pkWsvg.props.onwheel({ deltaY: 8, preventDefault: () => {} })
check("knob wheel: up steps +1 (1→2), down steps -1 (1→0)", pkWheel.length === 2 && pkWheel[0] === 2 && pkWheel[1] === 0)
let pkNoWheel = []
let pkNW = Knob({ value: 0.5, min: 0, max: 1, step: 0.01, onInput: (v) => pkNoWheel.push(v) })
pkFindTag(pkNW, "svg").props.onwheel({ deltaY: -1, preventDefault: () => {} })
check("knob wheel: ignored when no detents (continuous knobs unaffected)", pkNoWheel.length === 0)
// Boundary: wheel up at max is a no-op (no redundant gated emit/broadcast).
let pkMaxEmit = []
let pkMaxPrevented = false
let pkMaxK = Knob({ value: 4, min: 0, max: 4, step: 1, detents: 5, onInput: (v) => pkMaxEmit.push(v) })
pkFindTag(pkMaxK, "svg").props.onwheel({ deltaY: -1, preventDefault: () => { pkMaxPrevented = true } })
check("knob wheel: at max, wheel-up emits nothing (no redundant broadcast)", pkMaxEmit.length === 0)
check("knob wheel: at max, still consumes the vertical scroll (preventDefault)", pkMaxPrevented === true)
// Horizontal swipe (deltaY 0): no step, and the page scroll is NOT swallowed.
let pkHEmit = []
let pkHPrevented = false
let pkHK = Knob({ value: 2, min: 0, max: 4, step: 1, detents: 5, onInput: (v) => pkHEmit.push(v) })
pkFindTag(pkHK, "svg").props.onwheel({ deltaY: 0, deltaX: 30, preventDefault: () => { pkHPrevented = true } })
