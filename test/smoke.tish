// Headless smoke test: TPL round-trip, incremental decode, skill-gating, co-DJ permissions.
// Run: npm test  (builds to JS and runs under node — the same target the browser app uses).
import { loadDefaultDeckardProject } from '../src/model/ProjectLoad.tish'
import { emitProject, emitLivePlayback } from '../src/tpl/Emit.tish'
import { applyTplSource, findChannelById } from '../src/tpl/Apply.tish'
import { applyCoDjTplSource } from '../src/codj/Merge.tish'
import { applyLaunchDirective, isLaunchDirective, launchSceneDirective, launchClipDirective, transportDirective, applyLaunchLinesFromSource, transportPlayDirective, transportPreviewDirective, cueDirective, throwDirective, isPrivateDirective } from '../src/codj/Launch.tish'
import { setTrackOwner } from '../src/codj/CoDjMeta.tish'
import { coDjClockAlign, coDjShouldFollow, coDjClockPayload } from '../src/codj/Transport.tish'
import { createTplLineStream, tplLineStreamPush } from '../src/tpl/Stream.tish'
import { coDjLineAllowedForSkills } from '../src/codj/Skills.tish'
import { deckSetCatalog, deckSetTplById, loadDeckSet } from '../src/model/DeckSets.tish'
import { emptyProjectShell } from '../src/model/Project.tish'
import { parseBarSelector, barSelectorMatches } from '../src/tpl/BarSelector.tish'
import { lookupMacro, expandMacroBody } from '../src/tpl/Macros.tish'
import { resizeChannelBars, setRackBars, rackBars } from '../src/model/RackBars.tish'
import { ensureProjectSession, sessionWriteRackToSceneClip, loadSceneIntoRack, sessionArmScene, playbackClipForChannel, firstSongScene, nextSongScene, sceneHasSavedClip, sceneBarLength, armSceneWithOverrides, sceneSlotClipId, findClipOnChannel, loadSceneBarIntoRack, sessionWriteRackBarToSceneClip, sessionStopTrack, sessionTrackStopped, sessionEffectiveArmedClipId, songStart, songAdvance, hasExplicitSong, normalizeSongEntries, setSceneFollow, sceneFollow, hasFollowActions, resolveFollowAction, detRand01 } from '../src/model/Session.tish'
import { toggleStep, clearAllSteps } from '../src/model/Edits.tish'
import { secondsPerStep, stepsToScheduleInWindow, underrunsInBatch } from '../src/audio/Scheduler.tish'
import { createSignals } from '../src/core/Signals.tish'
import { createIngest } from '../src/core/Ingest.tish'
import { fragmentForEdit, createEditor } from '../src/core/Edit.tish'

let pass = 0
let fail = 0
fn check(name, cond) {
  if (cond) {
    pass = pass + 1
    console.log("  ok   " + name)
  } else {
    fail = fail + 1
    console.log("  FAIL " + name)
  }
}

fn stepsSig(ch) {
  let s = ""
  let i = 0
  while (i < ch.steps.length) {
    s = s + (ch.steps[i].on ? "x" : ".")
    i = i + 1
  }
  return s
}

// 1. Default load + emit round-trip (incl. now-documented step_pitch / master_mix / actor_mix)
let boot = loadDefaultDeckardProject()
check("default project loads without errors", boot.errors.length === 0)
let proj = boot.project
check("default has >= 4 channels", proj.channels.length >= 4)
let emitted = emitProject(proj)
check("emit starts with tpl header", emitted.indexOf("tpl 1") === 0)
check("emit includes step_pitch", emitted.indexOf("step_pitch") >= 0)
check("emit includes master_mix line", emitted.indexOf("master_mix ") >= 0)
check("emit includes actor_mix line", emitted.indexOf("actor_mix ") >= 0)
let boot2 = loadDefaultDeckardProject()
applyTplSource(boot2.project, emitted)
check("round-trip preserves channel count", boot2.project.channels.length === proj.channels.length)
check("round-trip preserves bpm", boot2.project.bpm === proj.bpm)

// 2. Incremental streaming decode == atomic block apply (progressive)
let blockSrc = "tpl 1\ntrack Hat id s_hat gen noise_burst\n  noise attack 0.001 decay 0.04 tone 0.9 pitch_follow 0.1\n  steps x . x . x . x . x . x . x . x ."
let viaBlock = loadDefaultDeckardProject().project
applyCoDjTplSource(viaBlock, blockSrc, "agent-1", "agent-1", 0, ["add_track", "pattern_steps"])
let hb = findChannelById(viaBlock, "s_hat")
check("block apply created track", hb !== null)

let viaStream = loadDefaultDeckardProject().project
let strm = createTplLineStream("agent-1", "agent-1", ["add_track", "pattern_steps"])
let streamLines = blockSrc.split("\n")
let headerOnly = null
let li = 0
while (li < streamLines.length) {
  tplLineStreamPush(strm, streamLines[li], viaStream, 0)
  if (li === 1) {
    headerOnly = findChannelById(viaStream, "s_hat")
  }
  li = li + 1
}
check("incremental: track appears right after its header line", headerOnly !== null)
let hs = findChannelById(viaStream, "s_hat")
check("incremental: final state matches block apply (steps)", hs !== null && hb !== null && stepsSig(hs) === stepsSig(hb))

// 3. Skill gating (now the canonical Skills.tish)
check("non-master denied bpm", coDjLineAllowedForSkills("bpm 200", ["pattern_steps"]) === false)
check("master allowed bpm", coDjLineAllowedForSkills("bpm 200", ["master_mixer"]) === true)
check("anyone allowed steps", coDjLineAllowedForSkills("  steps x . x .", ["pattern_steps"]) === true)
check("non-master denied auto", coDjLineAllowedForSkills("auto master_gain", ["pattern_steps"]) === false)
check("non-master denied master_mix", coDjLineAllowedForSkills("master_mix eq_lo 2", ["channel_mix"]) === false)

// 4. Permission model via applyCoDjTplSource (skillIds-driven, with legacy fallback)
let permProj = loadDefaultDeckardProject().project
let origBpm = permProj.bpm
applyCoDjTplSource(permProj, "tpl 1\nbpm 200\ntrack X id px gen basic_osc\n  steps x . . .", "agent-1", "agent-1", 0, ["add_track", "pattern_steps"])
check("agent (no master_mixer) cannot change bpm", permProj.bpm === origBpm)
check("agent (no master_mixer) can still add a track", findChannelById(permProj, "px") !== null)

let permProj2 = loadDefaultDeckardProject().project
applyCoDjTplSource(permProj2, "tpl 1\nbpm 200", "anon-7", "anon-7", 0, ["master_mixer"])
check("actor WITH master_mixer skill can change bpm", permProj2.bpm === 200)

let permProj3 = loadDefaultDeckardProject().project
applyCoDjTplSource(permProj3, "tpl 1\nbpm 175", "human-xyz", "human-xyz", 0)
check("legacy fallback: human-* actorId masters when skillIds absent", permProj3.bpm === 175)

let permProj4 = loadDefaultDeckardProject().project
let b4 = permProj4.bpm
applyCoDjTplSource(permProj4, "tpl 1\nbpm 175", "agent-1", "agent-1", 0)
check("legacy fallback: agent-* actorId cannot master when skillIds absent", permProj4.bpm === b4)

// 5. New-synth TPL round-trip: gen / fx / voice lines (drum, drive, lfo, octave, arp, chord)
let synProj = loadDefaultDeckardProject().project
let synTpl = "tpl 1\ntrack DrumK id dk gen drum\n  gen tone sine pitch_env 40 pitch_decay 0.05 decay 0.4\n  fx reverb_send 0.3 drive 0.5 lfo_rate 4 lfo_depth 1200\n  voice octave 1 arp up chord minor\n  steps x . . . x . . . x . . . x . . ."
applyTplSource(synProj, synTpl)
let dk = findChannelById(synProj, "dk")
check("gen line: generatorId resolves to drumSynth", dk !== null && dk.generatorId === "drumSynth")
check("gen line: pitchEnv (snake->camel) parsed", dk !== null && dk.generatorParams.pitchEnv === 40)
check("fx line: drive parsed", dk !== null && dk.drive === 0.5)
check("fx line: lfoRate parsed", dk !== null && dk.lfoRate === 4)
check("voice line: octave parsed", dk !== null && dk.octave === 1)
check("voice line: chord parsed", dk !== null && dk.chord === "minor")
let synEmit = emitProject(synProj)
check("emit round-trips drum gen params", synEmit.indexOf("pitch_env") >= 0)
check("emit round-trips fx drive", synEmit.indexOf("drive 0.5") >= 0)
check("emit round-trips voice chord", synEmit.indexOf("chord minor") >= 0)

// 5b. Modular patch DSL: parse → graph → emit → re-parse round-trip
let patchSrc = "tpl 1\ntrack Kick id pk gen patch\n  fx cutoff 20000 reverb_send 0.05\n  gen_block patch\n    osc o sine\n    gain a\n    conn o a\n    conn a out\n    env o.freq set 0 150 exp 0.5 0.01\n    env a.gain set 0 1 exp 0.5 0.01\n    dur 0.6\n  end gen_block\n  step_pitch 36\n  steps x . . . x . . . x . . . x . . ."
let patchProj = loadDefaultDeckardProject().project
applyTplSource(patchProj, patchSrc)
let pk = findChannelById(patchProj, "pk")
check("patch: generatorId resolves to patch", pk !== null && pk.generatorId === "patch")
check("patch: graph has 2 nodes (osc + gain)", pk !== null && pk.generatorSpec && pk.generatorSpec.graph && pk.generatorSpec.graph.nodes.length === 2)
check("patch: graph has 2 envelopes", pk !== null && pk.generatorSpec.graph.envs.length === 2)
check("patch: fixed dur parsed", pk !== null && pk.generatorSpec.graph.dur === 0.6)
let patchEmit = emitProject(patchProj)
check("patch: emit round-trips the patch block", patchEmit.indexOf("gen_block patch") >= 0 && patchEmit.indexOf("env o.freq set 0 150 exp 0.5 0.01") >= 0)
let patchProj2 = loadDefaultDeckardProject().project
applyTplSource(patchProj2, patchEmit)
let pk2 = findChannelById(patchProj2, "pk")
check("patch: re-parse preserves node count", pk2 !== null && pk2.generatorSpec.graph.nodes.length === 2)

// 5c. Bar selectors: per-bar note expansion + per-bar step_pitch + multi-bar round-trip
let barSrc = "tpl 1\ntrack Ch id ch gen patch * 4\n  gen_block patch\n    osc o sine\n    gain a\n    conn o a\n    conn a out\n    env a.gain set 0 0.3 exp 0.4 0.01\n    dur 0.4\n  end gen_block\n  note 48 0 4 v 90 bar 0\n  note 43 0 4 v 90 bar 1,3\n  note 44 0 4 v 90 bar 2\ntrack Bs id bs gen patch * 4\n  gen_block patch\n    osc o sawtooth note\n    gain a\n    conn o a\n    conn a out\n    env a.gain set 0 0.3 exp 0.3 0.01\n    dur 0.3\n  end gen_block\n  step_pitch 36 bar 0\n  step_pitch 31 bar 1\n  step_pitch 34 bar 2,3\n  steps x . x . x . x . x . x . x . x ."
let barProj = loadDefaultDeckardProject().project
applyTplSource(barProj, barSrc)
let chCh = findChannelById(barProj, "ch")
check("bar sel: note expands across loop bars (3 sel -> 4 notes)", chCh !== null && chCh.pianoNotes.length === 4)
check("bar sel: 'bar 1,3' note lands at beats 4 and 12", chCh !== null && chCh.pianoNotes.some(n => n.pitch === 43 && n.startBeat === 4) && chCh.pianoNotes.some(n => n.pitch === 43 && n.startBeat === 12))
let bsCh = findChannelById(barProj, "bs")
check("bar sel: per-bar step_pitch builds [36,31,34,34]", bsCh !== null && bsCh.stepPitchByBar != null && bsCh.stepPitchByBar.length === 4 && bsCh.stepPitchByBar[0] === 36 && bsCh.stepPitchByBar[1] === 31 && bsCh.stepPitchByBar[3] === 34)
let barEmit = emitProject(barProj)
check("bar sel: emit keeps the * 4 loop header", barEmit.indexOf("gen patch * 4") >= 0)
let barProj2 = loadDefaultDeckardProject().project
let barRT = applyTplSource(barProj2, barEmit)
check("bar sel: multi-bar emit re-parses clean", barRT.errors.length === 0)
let bs2 = findChannelById(barProj2, "bs")
check("bar sel: round-trip preserves per-bar step_pitch", bs2 !== null && bs2.stepPitchByBar != null && bs2.stepPitchByBar[1] === 31)

// 5d. Macros: built-in reference, param override, user-defined macro, concise emit + round-trip
let macSrc = "tpl 1\nmacro my_zap top=4000 q=18\n  osc o sawtooth note\n  filter f lowpass q $q\n  gain a\n  conn o f\n  conn f a\n  conn a out\n  env f.freq set 0 $top exp 0.2 100\n  env a.gain set 0 0.3 lin dur 0.01\nend macro\ntrack Kick id mk gen kick_edm\n  step_pitch 36\n  steps x . . . x . . . x . . . x . . .\ntrack Bass id mb gen bass_acid q 9\n  step_pitch 36\n  steps x . x . x . x . x . x . x . x .\ntrack Lead id ml gen my_zap top 5000\n  note 60 0 0.5 v 90"
let macProj = loadDefaultDeckardProject().project
applyTplSource(macProj, macSrc)
let mk = findChannelById(macProj, "mk")
check("macro: built-in kick_edm expands to a patch graph", mk !== null && mk.generatorId === "patch" && mk.macroName === "kick_edm" && mk.generatorSpec.graph.nodes.length === 2)
let mb = findChannelById(macProj, "mb")
check("macro: param override applies (bass_acid q 9 -> filter Q 9)", mb !== null && mb.macroName === "bass_acid" && mb.macroParams.q === 9 && mb.generatorSpec.graph.nodes[1].q === 9)
let ml = findChannelById(macProj, "ml")
check("macro: user-defined macro expands with substituted param", ml !== null && ml.macroName === "my_zap" && ml.generatorSpec.graph.envs[0].segs[0].vExpr === "5000")
let macEmit = emitProject(macProj)
check("macro: emit is concise (gen kick_edm, no gen_block for it)", macEmit.indexOf("gen kick_edm") >= 0 && macEmit.indexOf("gen bass_acid q 9") >= 0)
let macProj2 = loadDefaultDeckardProject().project
let macRT = applyTplSource(macProj2, macEmit)
check("macro: round-trip re-parses clean and keeps the macro ref", macRT.errors.length === 0 && findChannelById(macProj2, "mk").macroName === "kick_edm")

// 5e. Bar selector grammar (parse + match) — every supported form
fn barMatch(sel, bar) {
  return barSelectorMatches(parseBarSelector(sel), bar)
}
check("bar sel: even", barMatch("even", 0) && barMatch("even", 2) && !barMatch("even", 1))
check("bar sel: odd", barMatch("odd", 1) && barMatch("odd", 3) && !barMatch("odd", 0))
check("bar sel: single integer", barMatch("2", 2) && !barMatch("2", 1) && !barMatch("2", 3))
check("bar sel: An+B modulo (3n+1)", barMatch("3n+1", 1) && barMatch("3n+1", 4) && !barMatch("3n+1", 0) && !barMatch("3n+1", 2))
check("bar sel: An (2n == even)", barMatch("2n", 0) && barMatch("2n", 2) && !barMatch("2n", 1))
check("bar sel: -n+B first B bars", barMatch("-n+3", 0) && barMatch("-n+3", 2) && !barMatch("-n+3", 3))
check("bar sel: explicit list", barMatch("0,2,5", 0) && barMatch("0,2,5", 5) && !barMatch("0,2,5", 1))
check("bar sel: all (n / *)", barMatch("n", 7) && barMatch("*", 99))

// 5f. Macro helpers (registry + expansion) at the unit level
let m = lookupMacro("bass_acid", {})
check("macro lookup: built-in resolves", m !== null && m.body.length > 0)
check("macro lookup: unknown returns null", lookupMacro("definitely_not_a_macro", {}) === null)
let exp = expandMacroBody(m, { q: 7, top: 1234 })
let joined = exp.join("\n")
check("macro expand: overrides substitute $params", joined.indexOf("filter f lowpass q 7") >= 0 && joined.indexOf("set 0 1234 exp") >= 0)
let expDef = expandMacroBody(m, {})
check("macro expand: defaults apply when no override", expDef.join("\n").indexOf("q 15") >= 0)

// 5g. Pattern length (`* N`, loops forever) vs finite loop cap (`loops N`) are separate
let lenProj = loadDefaultDeckardProject().project
applyTplSource(lenProj, "tpl 1\ntrack A id la gen basic_osc * 4\n  steps x . . . x . . . x . . . x . . .\ntrack B id lb gen basic_osc\n  loops 2\n  steps x . . . x . . . x . . . x . . .")
let la = findChannelById(lenProj, "la")
check("pattern len: `* 4` sets patternBars=4, no loop cap", la !== null && la.patternBars === 4 && la.tplLoopBars == null)
let lb = findChannelById(lenProj, "lb")
check("loop cap: `loops 2` sets tplLoopBars cap, patternBars stays 1", lb !== null && lb.tplLoopBars === 2 && lb.patternBars === 1)

// 5h. Rack bar add/remove (duplicate-last on grow, truncate on shrink)
let rbProj = loadDefaultDeckardProject().project
let rbCh = rbProj.channels[0]
applyTplSource(rbProj, "tpl 1\ntrack RB id rbx gen patch\n  step_pitch 36\n  steps x . . . x . . . . . . . . . . .")
let rbx = findChannelById(rbProj, "rbx")
resizeChannelBars(rbx, 3, true)
check("rack bars: grow duplicates last bar (3 bars, steps 0/4 per bar)", rbx.steps.length === 48 && rbx.patternBars === 3 && rbx.steps[0].on && rbx.steps[16].on && rbx.steps[32].on)
resizeChannelBars(rbx, 1, false)
check("rack bars: shrink truncates to 1 bar (16 steps)", rbx.steps.length === 16 && rbx.patternBars === 1)
let rbMel = loadDefaultDeckardProject().project
applyTplSource(rbMel, "tpl 1\ntrack M id mmx gen patch\n  note 60 1 0.5 v 100")
let mmx = findChannelById(rbMel, "mmx")
resizeChannelBars(mmx, 2, true)
check("rack bars: grow duplicates piano notes into the new bar", mmx.pianoNotes.length === 2 && mmx.pianoNotes.some(n => n.startBeat === 1) && mmx.pianoNotes.some(n => n.startBeat === 5))
setRackBars(rbMel, 4, true)
check("rack bars: setRackBars sets every channel + rebuilds (patternBars=4, rackBars=4)", mmx.patternBars === 4 && rackBars(rbMel) === 4)

// 5i. Pattern bank — capture rack into a slot, then load it back into the editable rack
let pbProj = loadDefaultDeckardProject().project
ensureProjectSession(pbProj)
let pbCh = pbProj.channels[0]
clearAllSteps(pbCh)
toggleStep(pbCh, 0)
toggleStep(pbCh, 4)
sessionWriteRackToSceneClip(pbProj, 0)
clearAllSteps(pbCh)
toggleStep(pbCh, 2)
toggleStep(pbCh, 6)
sessionWriteRackToSceneClip(pbProj, 1)
loadSceneIntoRack(pbProj, 0)
check("pattern bank: load P1 restores its steps into the rack", pbCh.steps[0].on && pbCh.steps[4].on && !pbCh.steps[2].on)
loadSceneIntoRack(pbProj, 1)
check("pattern bank: load P2 restores a different pattern", pbCh.steps[2].on && pbCh.steps[6].on && !pbCh.steps[0].on)

// 5j. Play modes — Play Sequence plays the rack (ignores arming); Play Song plays the launched pattern.
// Set up two distinct saved patterns, launch P1 (arm scene 0) but leave the rack showing P2.
let pmProj = loadDefaultDeckardProject().project
ensureProjectSession(pmProj)
let pmCh = pmProj.channels[0]
clearAllSteps(pmCh)
toggleStep(pmCh, 0)
sessionWriteRackToSceneClip(pmProj, 0)
clearAllSteps(pmCh)
toggleStep(pmCh, 8)
sessionWriteRackToSceneClip(pmProj, 1)
// rack currently shows P2 (step 8). Launch P1 (scene 0, step 0) as the live output.
let pmRt = { sessionArmedClipIds: [] }
sessionArmScene(pmProj, pmRt, 0)
pmRt.playMode = "song"
let songClip = playbackClipForChannel(pmProj, pmRt, 0)
check("play song: armed pattern (P1) drives audio, not the rack", songClip != null && !songClip.silent && songClip.steps[0].on && !songClip.steps[8].on)
pmRt.playMode = "sequence"
let seqClip = playbackClipForChannel(pmProj, pmRt, 0)
check("play sequence: ignores arming, returns null so the rack is monitored", seqClip == null)
// Session mode with an UNSAVED slot (default main clip) is silent — it must NOT fall back to the rack.
let emptyProj2 = loadDefaultDeckardProject().project
ensureProjectSession(emptyProj2)
let emptyRt = { sessionArmedClipIds: [], playMode: "song" }
sessionArmScene(emptyProj2, emptyRt, 0)   // fresh session → slots are default main clips
let emptyClip = playbackClipForChannel(emptyProj2, emptyRt, 0)
check("play session: unsaved slot is SILENT, not the rack", emptyClip != null && emptyClip.silent === true)

// 5k. Song chain — Play Song advances through SAVED patterns, skipping empty ones, wrapping.
let songProj = loadDefaultDeckardProject().project
ensureProjectSession(songProj)
let songCh = songProj.channels[0]
clearAllSteps(songCh); toggleStep(songCh, 0); sessionWriteRackToSceneClip(songProj, 0)   // P1 saved
clearAllSteps(songCh); toggleStep(songCh, 4); sessionWriteRackToSceneClip(songProj, 2)   // P3 saved (P2/P4 empty)
check("song chain: scene 0 has a saved clip", sceneHasSavedClip(songProj, 0))
check("song chain: scene 1 is empty (no saved clip)", !sceneHasSavedClip(songProj, 1))
check("song chain: starts at first saved scene (0)", firstSongScene(songProj) === 0)
check("song chain: next after 0 skips empty 1 → 2", nextSongScene(songProj, 0) === 2)
check("song chain: next after 2 wraps + skips 3 → 0", nextSongScene(songProj, 2) === 0)
check("song chain: 1-bar scene length", sceneBarLength(songProj, 0) === 1)

// 5l. Per-track clip override — a launched track clip holds across song scene advances.
let ovProj = loadDefaultDeckardProject().project
ensureProjectSession(ovProj)
let ovCh0 = ovProj.channels[0]
clearAllSteps(ovCh0); toggleStep(ovCh0, 0); sessionWriteRackToSceneClip(ovProj, 0)
clearAllSteps(ovCh0); toggleStep(ovCh0, 8); sessionWriteRackToSceneClip(ovProj, 1)
let ovP2clip = sceneSlotClipId(ovProj, 1, 0)   // track 0's clip in pattern 2
let ovRt = { sessionArmedClipIds: [], trackOverrides: [] }
ovRt.trackOverrides[0] = ovP2clip              // override track 0 to pattern 2's clip
armSceneWithOverrides(ovProj, ovRt, 0)          // arm scene 0, but track 0 keeps the override
check("override: track 0 uses its override clip, not scene 0's", ovRt.sessionArmedClipIds[0] === ovP2clip)
check("override: track 1 still follows scene 0", ovRt.sessionArmedClipIds[1] === sceneSlotClipId(ovProj, 0, 1))
armSceneWithOverrides(ovProj, ovRt, 1)          // song advances to scene 1
check("override: holds through a scene advance", ovRt.sessionArmedClipIds[0] === ovP2clip)
ovRt.trackOverrides[0] = null                   // release the override
armSceneWithOverrides(ovProj, ovRt, 0)
check("override: released track returns to following the scene", ovRt.sessionArmedClipIds[0] === sceneSlotClipId(ovProj, 0, 0))

// 5m. Multiplayer A — co-DJ stream reflects the ARMED pattern, not the edit rack.
let lpProj = loadDefaultDeckardProject().project
ensureProjectSession(lpProj)
let lpCh = lpProj.channels[0]
clearAllSteps(lpCh); toggleStep(lpCh, 0); sessionWriteRackToSceneClip(lpProj, 0)   // P1: step 0
clearAllSteps(lpCh); toggleStep(lpCh, 8); sessionWriteRackToSceneClip(lpProj, 1)   // P2: step 8 (rack now shows P2)
let lpRt = { playMode: "song", sessionArmedClipIds: [], trackOverrides: [] }
sessionArmScene(lpProj, lpRt, 0)                                                   // arm P1 live
let liveTpl = emitLivePlayback(lpProj, lpRt)
let lpOut = emptyProjectShell(); applyTplSource(lpOut, liveTpl)
check("mp A: stream carries the armed pattern (P1 step0), not the rack (P2 step8)", lpOut.channels[0].steps[0].on && !lpOut.channels[0].steps[8].on)
check("mp A: emitting the live view leaves the rack untouched", lpCh.steps[8].on && !lpCh.steps[0].on)
lpRt.playMode = "sequence"
let seqTpl = emitLivePlayback(lpProj, lpRt)
let lpOut2 = emptyProjectShell(); applyTplSource(lpOut2, seqTpl)
check("mp A: sequence mode streams the rack (P2 step8)", lpOut2.channels[0].steps[8].on && !lpOut2.channels[0].steps[0].on)

// 5n. SAVE 1 BAR saves the viewed bar as a ONE-BAR pattern; LOAD 1 BAR drops it into the viewed bar.
let pbBar = loadDefaultDeckardProject().project
ensureProjectSession(pbBar)
setRackBars(pbBar, 2, false)
let pbc = pbBar.channels[0]
let z = 0
while (z < pbc.steps.length) { pbc.steps[z].on = false; z = z + 1 }
pbc.steps[0].on = true     // bar 0, step 0
pbc.steps[28].on = true    // bar 1, step 12 (abs index 16 + 12)
sessionWriteRackBarToSceneClip(pbBar, 0, 1)        // SAVE 1 BAR while viewing bar 1 (index 1)
let pbClip = findClipOnChannel(pbc, pbc.id + "_sc0")
check("save 1 bar: pattern is exactly ONE bar", pbClip.bars === 1 && pbClip.steps.length === 16)
check("save 1 bar: holds only the viewed bar (step 12, not bar 0's step 0)", pbClip.steps[12].on === true && pbClip.steps[0].on === false)
pbc.steps[28].on = false                            // wipe the rack's bar 1
loadSceneBarIntoRack(pbBar, 0, 1)                   // LOAD 1 BAR into the viewed bar (bar 1)
let pbc2 = pbBar.channels[0]
check("load 1 bar: drops the bar into the viewed bar, leaves bar 0", pbc2.steps[28].on === true && pbc2.steps[0].on === true)

// 5o. SAVE 1 BAR captures exactly the bar the rack SHOWS: notes that START in the viewed bar, NOT a
// held note carried over from an earlier bar. The piano roll only draws a note where it begins, so a
// chord held from bar 0 must be EMPTY on view 2 — saving view 2 must match what's on screen.
let hnProj = loadDefaultDeckardProject().project
ensureProjectSession(hnProj)
setRackBars(hnProj, 2, false)
let hnc = hnProj.channels[3]
hnc.patternBars = 2
hnc.pianoNotes = [
  { startBeat: 0, durBeats: 8, pitch: 36, vel: 100 },                   // held across both bars (starts bar 0)
  { startBeat: 5, durBeats: 1, pitch: 48, vel: 100 }                    // starts IN bar 1 (beat 5 = bar 1, beat 1)
]
sessionWriteRackBarToSceneClip(hnProj, 1, 1)                            // SAVE 1 BAR from bar 1 (view 2) → P2
let hnClip = findClipOnChannel(hnc, hnc.id + "_sc1")
check("save 1 bar: held note from bar 0 is NOT carried into bar 1's save", !hnClip.pianoNotes.some(n => n.pitch === 36))
check("save 1 bar: a note that STARTS in the viewed bar is captured, bar-relative", hnClip.pianoNotes.length === 1 && hnClip.pianoNotes[0].pitch === 48 && Math.abs(hnClip.pianoNotes[0].startBeat - 1) < 0.01)
// And saving VIEW 1 (bar 0) captures the held chord, since that's where it begins / is drawn.
sessionWriteRackBarToSceneClip(hnProj, 0, 0)
let hnClip0 = findClipOnChannel(hnc, hnc.id + "_sc0")
check("save 1 bar: the held note IS captured from the bar it starts in (view 1)", hnClip0.pianoNotes.some(n => n.pitch === 36 && n.startBeat === 0))

// 5p. SAVE 1 BAR of a TILED stepped pattern (patternBars=4 but only 16 steps) — the nebula bass bug:
// reading bar 1 must wrap to the tiled steps, not run off the end → empty.
let tlProj = loadDefaultDeckardProject().project
ensureProjectSession(tlProj)
let tlc = tlProj.channels[0]
tlc.patternBars = 4
tlc.steps = []
let qq = 0
while (qq < 16) { tlc.steps.push({ on: qq % 2 === 0, vel: 100 }); qq = qq + 1 }   // x . x . … tiled across 4 bars
tlc.stepPitchByBar = [36, 34, 32, 34]
sessionWriteRackBarToSceneClip(tlProj, 1, 1)                                       // SAVE 1 BAR from bar 1
let tlClip = findClipOnChannel(tlc, tlc.id + "_sc1")
check("save 1 bar: tiled stepped pattern captured (not empty)", tlClip.steps.length === 16 && tlClip.steps[0].on === true)
check("save 1 bar: per-bar pitch of the viewed bar captured", tlClip.stepPitchByBar != null && tlClip.stepPitchByBar[0] === 34)

// 5q. Per-track STOP silences just that track, persists across song scene advances, and is distinct
// from following the song (an empty "" override that armSceneWithOverrides re-applies each scene).
let stProj = loadDefaultDeckardProject().project
ensureProjectSession(stProj)
let stRt = { trackOverrides: [], sessionArmedClipIds: [] }
sessionArmScene(stProj, stRt, 0)
let stBefore = sessionEffectiveArmedClipId(stProj, stRt, 1)
sessionStopTrack(stProj, stRt, 1)
check("stop track: that track is armed silent immediately", stRt.sessionArmedClipIds[1] === "")
check("stop track: marked stopped (empty override)", sessionTrackStopped(stRt, 1) === true)
check("stop track: other tracks untouched", stRt.sessionArmedClipIds[0] !== "" || stBefore === "")
// Advancing to another scene must KEEP the stopped track silent (override re-applied), not resurrect it.
armSceneWithOverrides(stProj, stRt, 0)
check("stop track: stays silent across scene (re)arm", stRt.sessionArmedClipIds[1] === "")
check("stop track: not stopped for a track that was never stopped", sessionTrackStopped(stRt, 0) === false)

// 5r. Explicit `song` arrangement + `launch_quant` scalar round-trip through TPL.
let sgProj = loadDefaultDeckardProject().project
ensureProjectSession(sgProj)
sgProj.launchQuant = 8
sgProj.session.song = [{ scene: 0, repeat: 2 }, { scene: 2, repeat: 1 }, { scene: 1, repeat: 4 }]
let sgEmit = emitProject(sgProj)
check("emit: launch_quant scalar present", sgEmit.indexOf("launch_quant 8") >= 0)
check("emit: song block header present", sgEmit.indexOf("\nsong\n") >= 0)
check("emit: song entry with repeat (P1 x2)", sgEmit.indexOf("  P1 x2") >= 0)
check("emit: song entry without repeat omits xN (P3)", sgEmit.indexOf("  P3\n") >= 0)
check("emit: song entry P2 x4", sgEmit.indexOf("  P2 x4") >= 0)
let sgBack = loadDefaultDeckardProject().project
applyTplSource(sgBack, sgEmit)
check("round-trip: launch_quant preserved", sgBack.launchQuant === 8)
check("round-trip: song length preserved", sgBack.session.song != null && sgBack.session.song.length === 3)
check("round-trip: song entry 0 = scene 0 x2", sgBack.session.song[0].scene === 0 && sgBack.session.song[0].repeat === 2)
check("round-trip: song entry 1 = scene 2 x1", sgBack.session.song[1].scene === 2 && sgBack.session.song[1].repeat === 1)
check("round-trip: song entry 2 = scene 1 x4", sgBack.session.song[2].scene === 1 && sgBack.session.song[2].repeat === 4)

// 5s. songStart / songAdvance walk the explicit arrangement repeat-aware, wrapping at the end.
let sgRt = {}
let s0 = songStart(sgBack, sgRt)
check("songStart: head of arrangement (scene 0)", s0 === 0 && sgRt.songPos.idx === 0 && sgRt.songPos.rep === 0)
let s1 = songAdvance(sgBack, sgRt, s0)
check("songAdvance: repeat keeps same scene (P1 x2, play 2)", s1 === 0 && sgRt.songPos.rep === 1)
let s2 = songAdvance(sgBack, sgRt, s1)
check("songAdvance: next entry (scene 2)", s2 === 2 && sgRt.songPos.idx === 1)
let s3 = songAdvance(sgBack, sgRt, s2)
check("songAdvance: third entry (scene 1, first of x4)", s3 === 1 && sgRt.songPos.idx === 2 && sgRt.songPos.rep === 0)
let s4 = songAdvance(sgBack, sgRt, s3)
let s5 = songAdvance(sgBack, sgRt, s4)
let s6 = songAdvance(sgBack, sgRt, s5)
check("songAdvance: scene 1 repeats x4 then wraps to head", s4 === 1 && s5 === 1 && s6 === 1)
let s7 = songAdvance(sgBack, sgRt, s6)
check("songAdvance: wraps back to scene 0", s7 === 0 && sgRt.songPos.idx === 0)

// 5t2. Follow actions: per-scene progression + deterministic chance ratio, round-tripped in TPL.
let faProj = loadDefaultDeckardProject().project
ensureProjectSession(faProj)
let q = 0
while (q < 4) { sessionWriteRackToSceneClip(faProj, q); q = q + 1 }   // save scenes 0..3 so they exist
faProj.songSeed = 42
setSceneFollow(faProj, 0, "next", 1, null, 0)
setSceneFollow(faProj, 1, "next", 0.7, "repeat", 0.3)
setSceneFollow(faProj, 3, "stop", 1, null, 0)
check("follow: hasFollowActions true", hasFollowActions(faProj) === true)
let faEmit = emitProject(faProj)
check("follow: emit song_seed", faEmit.indexOf("song_seed 42") >= 0)
check("follow: emit follow header", faEmit.indexOf("\nfollow\n") >= 0)
check("follow: emit single action (P1 next)", faEmit.indexOf("  P1 next") >= 0)
check("follow: emit chance ratio (P2 next .. repeat)", faEmit.indexOf("  P2 next 0.7 repeat 0.3") >= 0)
check("follow: emit stop (P4)", faEmit.indexOf("  P4 stop") >= 0)
let faBack = loadDefaultDeckardProject().project
applyTplSource(faBack, faEmit)
check("follow round-trip: seed", faBack.songSeed === 42)
let faF1 = sceneFollow(faBack, 1)
check("follow round-trip: scene 1 A=next wA=0.7 B=repeat wB=0.3", faF1 != null && faF1.a === "next" && Math.abs(faF1.wa - 0.7) < 0.001 && faF1.b === "repeat" && Math.abs(faF1.wb - 0.3) < 0.001)
let faF3 = sceneFollow(faBack, 3)
check("follow round-trip: scene 3 = stop", faF3 != null && faF3.a === "stop")

// detRand01 determinism: same (seed,n) → same value; different n → varies.
check("detRand01: deterministic", detRand01(42, 5) === detRand01(42, 5))
check("detRand01: in [0,1)", detRand01(42, 5) >= 0 && detRand01(42, 5) < 1)
check("detRand01: varies with n", detRand01(42, 1) !== detRand01(42, 2))

// resolveFollowAction maps verbs; STOP returns -1; repeat returns same scene.
let frRt = { followCount: 0 }
check("resolve: next from 0 → 1 (saved)", resolveFollowAction(faBack, frRt, 0) === 1)
let frRt2 = { followCount: 0 }
check("resolve: stop from 3 → -1", resolveFollowAction(faBack, frRt2, 3) === -1)
let rpProj = loadDefaultDeckardProject().project
ensureProjectSession(rpProj)
let q2 = 0
while (q2 < 2) { sessionWriteRackToSceneClip(rpProj, q2); q2 = q2 + 1 }
setSceneFollow(rpProj, 0, "repeat", 1, null, 0)
let rpRt = { followCount: 0 }
check("resolve: repeat stays on same scene", resolveFollowAction(rpProj, rpRt, 0) === 0)

// Chance ratio honoured deterministically: over a fixed seeded sequence, ~70% land on A(next=1), the
// rest on B(repeat=stay). Count must be identical on every run (no Math.random).
let cnt = { stay: 0, adv: 0 }
let crRt = { followCount: 0 }
let trial = 0
while (trial < 200) {
  let res = resolveFollowAction(faBack, crRt, 1)   // scene 1 = next 0.7 / repeat 0.3
  if (res === 1) { cnt.stay = cnt.stay + 1 } else { cnt.adv = cnt.adv + 1 }
  trial = trial + 1
}
check("follow chance: A (next) is the majority ~70%", cnt.adv > cnt.stay && cnt.adv >= 110 && cnt.adv <= 170)
// Re-run identical → identical counts (determinism, the whole point of seeding).
let cnt2 = { stay: 0, adv: 0 }
let crRt2 = { followCount: 0 }
let t2 = 0
while (t2 < 200) {
  let res2 = resolveFollowAction(faBack, crRt2, 1)
  if (res2 === 1) { cnt2.stay = cnt2.stay + 1 } else { cnt2.adv = cnt2.adv + 1 }
  t2 = t2 + 1
}
check("follow chance: re-run is byte-identical (deterministic)", cnt2.adv === cnt.adv && cnt2.stay === cnt.stay)

// A follow action on ONE scene must not change scenes WITHOUT an entry: P2=next, P1 still loops.
let oneProj = loadDefaultDeckardProject().project
ensureProjectSession(oneProj)
let oq = 0
while (oq < 3) { sessionWriteRackToSceneClip(oneProj, oq); oq = oq + 1 }
setSceneFollow(oneProj, 1, "next", 1, null, 0)   // only P2 (index 1) follows → Next
let oneRt = { followCount: 0 }
check("follow scoping: scene 0 (no entry) still LOOPS", songAdvance(oneProj, oneRt, 0) === 0)
check("follow scoping: scene 2 (no entry) still LOOPS", songAdvance(oneProj, oneRt, 2) === 2)
check("follow scoping: scene 1 (entry=next) advances", songAdvance(oneProj, oneRt, 1) === 2)

// songAdvance honours follow actions over an explicit song block when both present.
let bothProj = loadDefaultDeckardProject().project
ensureProjectSession(bothProj)
let q3 = 0
while (q3 < 3) { sessionWriteRackToSceneClip(bothProj, q3); q3 = q3 + 1 }
bothProj.session.song = [{ scene: 2, repeat: 1 }]
setSceneFollow(bothProj, 0, "next", 1, null, 0)
let baRt = { followCount: 0 }
check("songAdvance prefers follow actions over song block", songAdvance(bothProj, baRt, 0) === 1)

// 5t. No song block → derived order (legacy); emit omits the song block.
let dvProj = loadDefaultDeckardProject().project
ensureProjectSession(dvProj)
check("no song block: emit omits song header", emitProject(dvProj).indexOf("\nsong\n") < 0)
let dvRt = {}
check("no song block: songStart falls back to firstSongScene", songStart(dvProj, dvRt) === firstSongScene(dvProj) && dvRt.songPos === null)
// Ableton default: with no follow action and no song block, a launched scene LOOPS — songAdvance must
// return the SAME scene, never auto-jump to the next saved one.
let loopProj = loadDefaultDeckardProject().project
ensureProjectSession(loopProj)
let lq = 0
while (lq < 3) { sessionWriteRackToSceneClip(loopProj, lq); lq = lq + 1 }   // 3 saved scenes
let loopRt = {}
check("default progression: scene loops, does NOT auto-advance", songAdvance(loopProj, loopRt, 0) === 0)
check("default progression: another saved scene also loops", songAdvance(loopProj, loopRt, 2) === 2)

// 5u. Synchronized launches: a host's `@ launch` / `@ transport` directives applied against a
// FOLLOWER's runtime move the follower's shared arming — the heart of issue #1 (model B).
let MASTER = ["master_mixer", "pattern_steps"]
let GUEST = ["pattern_steps"]
check("directive detect: launch scene", isLaunchDirective("@ launch scene 2") === true)
check("directive detect: transport", isLaunchDirective("@ transport song 1") === true)
check("directive detect: plain TPL is not a directive", isLaunchDirective("  steps x . x .") === false)
check("directive emit: scene", launchSceneDirective(2) === "@ launch scene 2")
check("directive emit: clip release", launchClipDirective("kick", "") === "@ launch clip kick -")

// Follower project: save scene 0 + scene 1 so they hold distinct clips to arm.
let fwProj = loadDefaultDeckardProject().project
ensureProjectSession(fwProj)
sessionWriteRackToSceneClip(fwProj, 0)
sessionWriteRackToSceneClip(fwProj, 1)
let fwRt = { sessionArmedClipIds: [], trackOverrides: [] }
// Host (master) launches scene 1 → follower arms every track to scene 1's slots + songScene=1.
let handled = applyLaunchDirective(fwProj, fwRt, launchSceneDirective(1), "actor-host", MASTER)
check("launch scene: directive handled", handled === true)
check("launch scene: follower armed to scene 1 slot (track 0)", fwRt.sessionArmedClipIds[0] === sceneSlotClipId(fwProj, 1, 0))
check("launch scene: follower songScene = 1", fwRt.songScene === 1)

// A NON-master guest cannot launch a scene (gated) — arming unchanged from the master's launch.
applyLaunchDirective(fwProj, fwRt, launchSceneDirective(0), "actor-guest", GUEST)
check("launch scene: non-master rejected (still scene 1)", fwRt.songScene === 1 && fwRt.sessionArmedClipIds[0] === sceneSlotClipId(fwProj, 1, 0))

// Per-track clip override: only the track OWNER may set it. Give the guest ownership of track 2.
setTrackOwner(fwProj, fwProj.channels[2].id, "actor-guest", "actor-guest")
let ovClip = fwProj.channels[2].id + "_sc0"
applyLaunchDirective(fwProj, fwRt, launchClipDirective(fwProj.channels[2].id, ovClip), "actor-guest", GUEST)
check("launch clip: owner override applied", fwRt.sessionArmedClipIds[2] === ovClip && fwRt.trackOverrides[2] === ovClip)
// A different actor (not owner, not master) cannot override that track.
applyLaunchDirective(fwProj, fwRt, launchClipDirective(fwProj.channels[2].id, fwProj.channels[2].id + "_sc1"), "actor-other", GUEST)
check("launch clip: non-owner rejected", fwRt.sessionArmedClipIds[2] === ovClip)

// transport stop (master) silences every track.
applyLaunchDirective(fwProj, fwRt, transportDirective("stop", 0), "actor-host", MASTER)
check("transport stop: all tracks silenced", fwRt.sessionArmedClipIds[0] === "" && fwRt.sessionArmedClipIds[2] === "")

// 5v. Receive-routing splitter: a mixed block (control directive + project line) applies the directive
// to rt and returns ONLY the project lines for the master-gated merge (mirrors the co-DJ apply path).
let mxProj = loadDefaultDeckardProject().project
ensureProjectSession(mxProj)
sessionWriteRackToSceneClip(mxProj, 1)
let mxRt = { sessionArmedClipIds: [], trackOverrides: [] }
let mxRest = applyLaunchLinesFromSource(mxProj, mxRt, "tpl 1\n@ launch scene 1\nbpm 145\n", "actor-host", MASTER)
check("splitter: directive applied to rt (songScene 1)", mxRt.songScene === 1)
check("splitter: directive line stripped from remainder", mxRest.indexOf("@ launch") < 0)
check("splitter: project line kept in remainder", mxRest.indexOf("bpm 145") >= 0)

// 5w. Shared transport clock: a follower slaves its playhead to the host. coDjClockAlign snaps on
// large drift, holds on small (no jitter); coDjShouldFollow gates host/independent.
check("clock: small drift held (no snap)", coDjClockAlign(100, 100, 1) === 100)
check("clock: 1-step drift held (within threshold)", coDjClockAlign(101, 100, 1) === 101)
check("clock: large drift snaps to host (+1 latency nudge)", coDjClockAlign(40, 100, 1) === 101)
check("clock: behind host snaps forward", coDjClockAlign(200, 100, 1) === 101)
check("follow gate: host does NOT follow", coDjShouldFollow({ coDjIsHost: true }) === false)
check("follow gate: follower follows by default", coDjShouldFollow({ coDjIsHost: false }) === true)
check("follow gate: independent mode off", coDjShouldFollow({ coDjIsHost: false, coDjFollowTransport: false }) === false)
let clkMsg = coDjClockPayload("actor-host", 48, 2, 130)
check("clock payload: control/clock with step+scene", clkMsg.type === "control" && clkMsg.op === "clock" && clkMsg.perfStep === 48 && clkMsg.scene === 2)

// Simulate host advancing across bars, follower starting cold + locking on each clock heartbeat.
let hostTick = 0
let followTick = 999            // follower starts wildly out of phase
let bars = 0
while (bars < 8) {
  hostTick = hostTick + 16      // host advances one bar (16 steps)
  // follower drifts a little each bar (simulated setTimeout jitter), then receives the host clock:
  followTick = followTick + 17
  followTick = coDjClockAlign(followTick, hostTick, 2)
  bars = bars + 1
}
check("clock sim: follower converges to within a bar of host", Math.abs(followTick - hostTick) <= 16)
check("clock sim: follower not stuck at its wild start", followTick < 200)

// 5x. Switching a deck preset must NOT wipe the rest of the session — other decks' queued scenes
// persist (everything is in TPL; swapping one deck only replaces that deck's channels).
let dsProj = loadDefaultDeckardProject().project
ensureProjectSession(dsProj)
sessionWriteRackToSceneClip(dsProj, 0)                 // save all current (deck A) channels into scene 0
let aId = dsProj.channels[0].id
check("deck swap setup: scene 0 saved on deck A", dsProj.session.slots[0][0] === aId + "_sc0")
loadDeckSet(dsProj, "B", "nebula_pulse")               // load a preset onto deck B — deck A must survive
let aIdx = -1
let dz = 0
while (dz < dsProj.channels.length) {
  if (dsProj.channels[dz].id === aId) { aIdx = dz }
  dz = dz + 1
}
check("deck swap: deck A channel survives the swap", aIdx >= 0)
check("deck swap: deck A's saved scene 0 PERSISTS (not cleared)", aIdx >= 0 && dsProj.session.slots[aIdx][0] === aId + "_sc0")
check("deck swap: deck A channel keeps its saved clip object", findClipOnChannel(dsProj.channels[aIdx], aId + "_sc0") != null)
let bChan = null
let bz = 0
while (bz < dsProj.channels.length) {
  if (String(dsProj.channels[bz].id).indexOf("b_") === 0) { bChan = dsProj.channels[bz] }
  bz = bz + 1
}
check("deck swap: deck B preset loaded its stems", bChan != null)

// 6. Every stem deck set parses cleanly into >= 5 stems (the deck.tsx conversions)
let cat = deckSetCatalog()
check("15 stem deck sets in catalog", cat.length === 15)
let badSet = ""
let si = 0
while (si < cat.length) {
  let set = deckSetTplById(cat[si].id)
  let tp = emptyProjectShell()
  let rr = applyTplSource(tp, set.tpl)
  if (rr.errors.length > 0) {
    badSet = cat[si].id + " parse:" + String(rr.errors.length)
  } else if (tp.channels.length < 5) {
    badSet = cat[si].id + " stems:" + String(tp.channels.length)
  }
  si = si + 1
}
check("all 15 deck sets parse clean with >=5 stems", badSet === "")
if (badSet !== "") {
  console.log("  -> offending set: " + badSet)
}

// 6b. Transport routing grammar (rearch step 1): xfade / main_deck / swing / track deck round-trip.
let rtp = loadDefaultDeckardProject().project
rtp.transportCrossfade = 0.3
rtp.transportCrossfadeY = 0.7
rtp.transportMainDeck = "local"
rtp.swing = 0.25
rtp.channels[0].deck = "B"
rtp.channels[0].deckSlot = 1
let rtpEmit = emitProject(rtp)
check("emit: xfade line present", rtpEmit.indexOf("xfade 0.3 0.7") >= 0)
check("emit: main_deck local present", rtpEmit.indexOf("main_deck local") >= 0)
check("emit: swing present", rtpEmit.indexOf("swing 0.25") >= 0)
check("emit: track deck line present", rtpEmit.indexOf("deck B slot 1") >= 0)
let rtp2 = emptyProjectShell()
applyTplSource(rtp2, rtpEmit)
check("round-trip: crossfade X survives", Math.abs(rtp2.transportCrossfade - 0.3) < 1e-6)
check("round-trip: crossfade Y survives", Math.abs(rtp2.transportCrossfadeY - 0.7) < 1e-6)
check("round-trip: main_deck survives", rtp2.transportMainDeck === "local")
check("round-trip: swing survives", Math.abs(rtp2.swing - 0.25) < 1e-6)
let rtpCh0 = findChannelById(rtp2, rtp.channels[0].id)
check("round-trip: channel deck survives", rtpCh0 != null && rtpCh0.deck === "B")
check("round-trip: channel deckSlot survives", rtpCh0 != null && rtpCh0.deckSlot === 1)
// Defaults must NOT emit (keeps round-trip minimal/stable).
let rtpDef = loadDefaultDeckardProject().project
let rtpDefEmit = emitProject(rtpDef)
check("emit: no xfade at default 0.5/0.5", rtpDefEmit.indexOf("\nxfade ") < 0)
check("emit: no main_deck at default live", rtpDefEmit.indexOf("main_deck") < 0)
check("emit: no swing at 0", rtpDefEmit.indexOf("\nswing ") < 0)

// 6c. New control directives (rearch step 1): builders + detection (cue/throw are PRIVATE-aware).
check("directive: play song", transportPlayDirective("song") === "@ transport play song")
check("directive: play seq", transportPlayDirective("sequence") === "@ transport play seq")
check("directive: preview", transportPreviewDirective() === "@ transport preview")
check("directive: cue scene", cueDirective(3) === "@ cue 3")
check("directive: throw with scene", throwDirective(2) === "@ throw 2")
check("directive: throw no scene", throwDirective(null) === "@ throw")
check("detect: cue is a control directive", isLaunchDirective("@ cue 3") === true)
check("detect: throw is a control directive", isLaunchDirective("@ throw") === true)
check("detect: play is a control directive", isLaunchDirective("@ transport play song") === true)
check("private: cue is private (never broadcast)", isPrivateDirective("@ cue 3") === true)
check("private: preview is private", isPrivateDirective("@ transport preview") === true)
check("private: throw is NOT private (goes to main)", isPrivateDirective("@ throw 2") === false)
check("private: transport play is NOT private (shared)", isPrivateDirective("@ transport play song") === false)
check("private: scene launch is NOT private", isPrivateDirective("@ launch scene 0") === false)

// 6d. Signal bus (rearch step 2): publish/subscribe, last-value replay, unsubscribe.
let sig = createSignals()
let sgot = []
sig.publish("transport.position", 1)
let unsub = sig.subscribe("transport.position", (v) => { sgot.push(v) })
check("signals: late subscriber replays last value", sgot.length === 1 && sgot[0] === 1)
sig.publish("transport.position", 2)
check("signals: subscriber gets new value", sgot.length === 2 && sgot[1] === 2)
check("signals: peek returns latest", sig.peek("transport.position") === 2)
unsub()
sig.publish("transport.position", 3)
check("signals: unsubscribe stops delivery", sgot.length === 2)

// 6e. Ingest (rearch step 2): the ONE writer — two-actor convergence + ownership/host gate + private.
let projA = loadDefaultDeckardProject().project
let wire = []
let ingA = createIngest({ project: projA, runtime: {} })
ingA.onOut((frag, kind) => { wire.push(frag) })
let ctxMaster = { actorId: "humanA", skillIds: ["master_mixer"] }
ingA.ingest("bpm 128", ctxMaster)
check("ingest: master sets global bpm", projA.bpm === 128)
ingA.ingest("track New id tnew gen drum\n  mix gain 0.42 pan 0 mute 0 solo 0 eq_lo 0 eq_mid 0 eq_hi 0", ctxMaster)
let tnewA = findChannelById(projA, "tnew")
check("ingest: new track folded (gain)", tnewA != null && Math.abs(tnewA.gain - 0.42) < 1e-6)
check("ingest: doc fragments echoed to out-stream", wire.length === 2)
// Convergence: a second machine replays A's authored stream → identical fold.
let projB = loadDefaultDeckardProject().project
let ingB = createIngest({ project: projB, runtime: {} })
let wi = 0
while (wi < wire.length) {
  ingB.ingest(wire[wi], ctxMaster)
  wi = wi + 1
}
let tnewB = findChannelById(projB, "tnew")
check("converge: peer B bpm matches A", projB.bpm === 128)
check("converge: peer B track gain matches A", tnewB != null && Math.abs(tnewB.gain - 0.42) < 1e-6)
// Gate: a non-master, non-owner actor cannot change globals or someone else's track.
let ctxGuest = { actorId: "agentB", skillIds: [] }
ingB.ingest("bpm 200", ctxGuest)
check("gate: non-master cannot change bpm", projB.bpm === 128)
let gBefore = findChannelById(projB, "tnew").gain
ingB.ingest("track New id tnew gen drum\n  mix gain 0.99 pan 0 mute 0 solo 0 eq_lo 0 eq_mid 0 eq_hi 0", ctxGuest)
check("gate: non-owner cannot edit another's track", Math.abs(findChannelById(projB, "tnew").gain - gBefore) < 1e-6)
// Private: cue/preview never echo; throw does.
let wireP = []
ingA.onOut((frag, kind) => { wireP.push(frag) })
ingA.ingest("@ cue 2", ctxMaster)
check("private: @ cue not broadcast", wireP.length === 0)
ingA.ingest("@ throw 2", ctxMaster)
check("private: @ throw broadcast", wireP.length === 1)

// 6f. emit/edit helper (rearch step 2/3): addressed edit -> minimal TPL fragment -> ingest -> fold.
let projE = loadDefaultDeckardProject().project
let chE = projE.channels[0].id
// fragmentForEdit shapes
check("frag: bpm scalar", fragmentForEdit(projE, "bpm", 132) === "bpm 132")
check("frag: xfade pair", fragmentForEdit(projE, "xfade", [0.25, 0.75]) === "xfade 0.25 0.75")
check("frag: main_deck", fragmentForEdit(projE, "main_deck", "local") === "main_deck local")
check("frag: master eq line", fragmentForEdit(projE, "master/eq_lo", 2).indexOf("master_mix eq_lo 2") >= 0)
let mixFrag = fragmentForEdit(projE, "track/" + chE + "/mix/gain", 0.5)
check("frag: track mix re-emits full mix line", mixFrag.indexOf("mix gain 0.5 pan ") >= 0 && mixFrag.indexOf("id " + chE) >= 0)
check("frag: unknown track is no-op", fragmentForEdit(projE, "track/nope/mix/gain", 1) === "")
// Full loop: createEditor.emit -> ingest -> fold reflects the change (UI-as-client in miniature).
// Local ctx: the solo user is actor "human" (which ensureCoDjMeta makes the default-project owner) with
// master skills — so they may edit their own tracks AND globals. This is the single-player identity.
let ctxLocal = { actorId: "human", skillIds: ["master_mixer"] }
let edStore = { project: projE, runtime: {} }
let edIng = createIngest(edStore)
let editor = createEditor(edStore, edIng.ingest, () => ctxLocal)
editor.emit("bpm", 140)
check("edit-loop: bpm folded via emit", projE.bpm === 140)
editor.emit("track/" + chE + "/mix/gain", 0.33)
check("edit-loop: track gain folded via emit", Math.abs(findChannelById(projE, chE).gain - 0.33) < 1e-6)
editor.emit("track/" + chE + "/fx/cutoff", 3000)
check("edit-loop: track fx cutoff folded via emit", Math.abs(findChannelById(projE, chE).filterCutoff - 3000) < 1e-6)
editor.emit("xfade", [0.2, 0.8])
check("edit-loop: xfade X folded", Math.abs(projE.transportCrossfade - 0.2) < 1e-6)
check("edit-loop: xfade Y folded", Math.abs(projE.transportCrossfadeY - 0.8) < 1e-6)
editor.directive("@ throw 1")
check("edit-loop: directive routes through ingest", true)
// gen_type (changes generator + resets params) and adsr (object value) — the instrument-editor paths.
let chId0 = projE.channels[0].id
editor.emit("track/" + chId0 + "/gen_type", "basicOsc")
check("edit-loop: gen_type switches generator", findChannelById(projE, chId0).generatorId === "basicOsc")
editor.emit("track/" + chId0 + "/gen/waveform", "square")
check("edit-loop: gen/waveform param folds", findChannelById(projE, chId0).generatorParams.waveform === "square")
editor.emit("track/" + chId0 + "/adsr", { a: 0.02, d: 0.6, s: 0.3, r: 0.9 })
let gp0 = findChannelById(projE, chId0).generatorParams
check("edit-loop: adsr folds attack", gp0.attack != null && Math.abs(gp0.attack - 0.02) < 1e-6)
check("edit-loop: adsr folds release", gp0.release != null && Math.abs(gp0.release - 0.9) < 1e-6)

// 7. Lookahead scheduler helpers: self-correcting step advance, no accumulated drift.
check("secondsPerStep: 120bpm = 0.125s per 16th", Math.abs(secondsPerStep(120) - 0.125) < 1e-9)
check("secondsPerStep: clamps low bpm to 40", secondsPerStep(10) === secondsPerStep(40))
check("secondsPerStep: clamps high bpm to 300", secondsPerStep(999) === secondsPerStep(300))
// Normal cadence: scheduler just past a step, window 0.1s, 0.125s/step → schedules ~1 step ahead.
let sp = secondsPerStep(120)
let r1 = stepsToScheduleInWindow(0, 0.06, 0.0, 0.1, sp, 256)
check("window: schedules the steps within lookahead", r1.items.length === 1 && r1.items[0].step === 0)
check("window: advances cursor by one step", r1.nextStep === 1 && Math.abs(r1.nextSec - (0.06 + sp)) < 1e-9)
check("window: nothing scheduled in the past under normal cadence", underrunsInBatch(r1.items, 0.0) === 0)
// Self-correcting: 100 consecutive windows must land step N at exactly start + N*sp (no drift).
let stepC = 0
let secC = 0.0
let now = 0.0
let lastWhen = -1
let drift = 0
let iter = 0
while (iter < 100) {
  now = now + 0.05                                  // advance the (jittery) clock ~half a step
  let rr = stepsToScheduleInWindow(stepC, secC, now, 0.1, sp, 256)
  let k = 0
  while (k < rr.items.length) {
    let expected = rr.items[k].step * sp            // step N must be at exactly N * sp
    if (Math.abs(rr.items[k].when - expected) > 1e-9) { drift = drift + 1 }
    lastWhen = rr.items[k].when
    k = k + 1
  }
  stepC = rr.nextStep
  secC = rr.nextSec
  iter = iter + 1
}
check("window: 100-iter run has ZERO accumulated drift", drift === 0)
check("window: reached ~step 100 over 100 half-step ticks", stepC >= 38 && stepC <= 42)
// Catch-up burst is capped by maxBatch (clock jumped far ahead, e.g. tab resume).
let rb = stepsToScheduleInWindow(0, 0.0, 100.0, 0.1, sp, 8)
check("window: maxBatch caps a runaway catch-up", rb.items.length === 8)

console.log("")
console.log("PASS=" + String(pass) + " FAIL=" + String(fail))
if (typeof process !== "undefined" && process.exit && fail > 0) {
  process.exit(1)
}
