fn pgFindId(node, id) {
  if (node === null || node === undefined || typeof node !== "object") {
    return null
  }
  if (Array.isArray(node)) {
    let pii = 0
    while (pii < node.length) {
      let pir = pgFindId(node[pii], id)
      if (pir !== null && pir !== undefined) {
        return pir
      }
      pii = pii + 1
    }
    return null
  }
  if (node.props !== null && node.props !== undefined && node.props.id === id) {
    return node
  }
  if (node.children !== null && node.children !== undefined) {
    return pgFindId(node.children, id)
  }
  return null
}
