check("patch gen emit: keeps the pan node (was dropped)", pgEmit.indexOf("pan p1") >= 0)
check("patch gen emit: keeps the dur line (was dropped)", pgEmit.indexOf("dur 0.5") >= 0)

// (2) addPatchNode("pan") creates a real pan node (it used to fall through to gain) + round-trips.
let pgG = parsePatchGraph(defaultPatchRawLines())
let pgPanId = addPatchNode(pgG, "pan")
let pgPanNode = pgG.nodes.filter(n => n.id === pgPanId)[0]
check("addPatchNode pan: creates a pan node (not gain)", pgPanNode !== null && pgPanNode !== undefined && pgPanNode.kind === "pan")
let pgLines = patchGraphToLines(pgG)
check("pan node round-trips through a `pan` line", pgLines.some(l => l.indexOf("pan " + pgPanId) >= 0))
check("pan node re-parses as kind pan", parsePatchGraph(pgLines).nodes.filter(n => n.id === pgPanId)[0].kind === "pan")

// (3) PatchGraphPanel renders one card PER MODULE (decomposed), no h-shadow / render crash.
fn pgCountClass(node, cls, acc) {
  if (node === null || node === undefined) {
    return acc
  }
  if (Array.isArray(node)) {
    let pgi = 0
    while (pgi < node.length) {
      pgCountClass(node[pgi], cls, acc)
      pgi = pgi + 1
    }
    return acc
  }
  if (typeof node !== "object") {
    return acc
  }
  if (pkClass(node).split(" ").indexOf(cls) >= 0) {
    acc.count = acc.count + 1
  }
  if (node.children !== null && node.children !== undefined) {
    pgCountClass(node.children, cls, acc)
  }
  return acc
}
