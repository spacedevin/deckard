{
  "name": "deckard",
  "version": "0.1.0",
  "private": true,
  "description": "Token-streamed live-coding DAW in Tish — LLM + human co-DJ over TPL",
  "scripts": {
    "dev": "vite",
    "build": "tish build --target js src/main.tish -o dist/bundle.js",
    "test": "tish build --target js test/smoke.tish -o /tmp/deckard-smoke.js && node /tmp/deckard-smoke.js",
    "serve": "npx --yes serve . -p 3456",
    "clean": "rm -rf dist target *.log",
    "gateway": "tish run services/gateway/main.tish",
    "agent": "tish run services/agent-worker/main.tish",
    "token-demo": "tish run services/token-stream-demo/main.tish"
  },
  "dependencies": {
    "@tishlang/lattish": "^2.0.0",
    "@tishlang/tish": "^2.2.5"
  },
  "devDependencies": {
    "lucide": "^0.469.0",
    "vite": "^8.0.14"
  }
}